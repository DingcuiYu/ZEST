+//zest-vra: ZEST-private VMA readahead front-end. When ZEST owns readahead for
+//@fentry's swapfile (zest_swap_ra_win() > 0), this REPLACES the kernel's
+//vma/cluster readahead: collect the VMA-neighbor swap slots around the fault
+//(the same lockless PTE walk swap_vma_readahead does, clamped to the VMA and
+//the fault's PMD so one pte_offset_map covers it), hand them to the ZEST
+//prefetch engine (async, off the critical path), and read ONLY the faulting
+//page here. Returns NULL when not active -> caller falls through to the
+//kernel readahead. NOTE: read_swap_cache_async() can return NULL under
+//memory pressure; we also return NULL then and the kernel path below retries
+//the read -- a rare, harmless double attempt (the prefetch hint stands).
+//
+//M3 adaptive window: this is swap_ra_info()'s algorithm verbatim -- the same
+//vma->swap_readahead_info <addr, win, hits> triple and the same
+//__swapin_nr_pages() slope -- with two substitutions:
+//  - max_win comes from the vra_win knob, NOT page_cluster (the test baseline
+//    runs page-cluster=0, which must kill the KERNEL's readahead, not ours);
+//  - hit attribution: the kernel credits `hits` when a fault finds a
+//    PG_readahead page in the swap cache; our prefetched pages live in the
+//    ZEST-private read cache instead, so we probe it (zest_swap_ra_peek). A
+//    peek hit means prefetch predicted this fault: credit it, KEEP the
+//    current window, and skip re-collection -- exactly like the kernel, a new
+//    round is only issued by the fault that falls OUT of the prefetched
+//    window. (Bonus: no re-enqueue of the overlapping window = no fill_dups
+//    flood.) The probe also returns true for an in-flight fill: prediction
+//    was right, merely late -- lateness is judged separately (rc_late_fills).
+static struct page *zest_swapin_readahead(swp_entry_t fentry, gfp_t gfp_mask,
+					  struct vm_fault *vmf)
+{
+	struct vm_area_struct *vma = vmf->vma;
+	struct swap_info_struct *sis = swp_swap_info(fentry);
+	u32 slots[ZEST_SWAP_RA_WIN_MAX];
+	unsigned int max_win, win, hits, prev_win, n = 0, i, nr;
+	unsigned long ra_val, faddr, fpfn, pfn, lpfn, rpfn, start, end;
+	pte_t *pte, pentry;
+	swp_entry_t entry;
+
+	max_win = zest_swap_ra_win(sis);
+	if (!max_win)
+		return NULL;
+	if (!vma || !vmf->pmd)
+		return NULL;
+
+	faddr = vmf->address;
+	fpfn  = PFN_DOWN(faddr);
+	ra_val   = GET_SWAP_RA_VAL(vma);
+	pfn      = PFN_DOWN(SWAP_RA_ADDR(ra_val));
+	prev_win = SWAP_RA_WIN(ra_val);
+	hits     = SWAP_RA_HITS(ra_val);
+
+	if (zest_swap_ra_peek(sis, (u32)swp_offset(fentry))) {
+		hits = min_t(unsigned int, hits + 1, SWAP_RA_HITS_MAX);
+		atomic_long_set(&vma->swap_readahead_info,
+				SWAP_RA_VAL(faddr, prev_win, hits));
+		goto fault_read;
+	}
+
+	win = __swapin_nr_pages(pfn, fpfn, hits, max_win, prev_win);
+	//zest-vra (M3.6): asymmetric aggression on top of the Linux slope.
+	//jump: this round ended a CONFIRMED streak (>= vra_jump peek hits) --
+	//skip the doubling ladder and open the next window at the cap; rounds
+	//with hits==0 (the singleton majority) never trigger it. min: blunt
+	//floor for sweeping the precision<->coverage curve. Applied before the
+	//ra_val/stat writeback so prev_win and the histogram see the real
+	//window (the don't-shrink-fast rule then decays from the boosted
+	//value, as intended).
+	{
+		unsigned int knob = zest_swap_ra_jump();
+
+		if (knob && hits >= knob)
+			win = max_win;
+		knob = zest_swap_ra_min();
+		if (knob && win < knob)
+			win = min_t(unsigned int, knob, max_win);
+	}
+	atomic_long_set(&vma->swap_readahead_info,
+			SWAP_RA_VAL(faddr, win, 0));
+	zest_swap_ra_stat_win(sis, win);
+	if (win == 1)
+		goto fault_read;
+
+	//Window placement: swap_ra_info()'s forward / backward / centered
+	//split, clamped to the VMA and to faddr's PMD. The explicit underflow
+	//guards matter for tiny fault addresses: fpfn - x would wrap and max3()
+	//would then pick the wrapped huge value. rpfn stays relative to fpfn
+	//(not to the clamped lpfn) so the window never silently shifts right.
+	if (fpfn == pfn + 1) {			/* sequential forward */
+		lpfn = fpfn;
+		rpfn = fpfn + win;
+	} else if (pfn == fpfn + 1) {		/* sequential backward */
+		lpfn = fpfn >= win - 1 ? fpfn - (win - 1) : 0;
+		rpfn = fpfn + 1;
+	} else {				/* no direction: centered */
+		unsigned int left = (win - 1) / 2;
+
+		lpfn = fpfn > left ? fpfn - left : 0;
+		rpfn = fpfn + (win - left);
+	}
+	start = max3(lpfn, PFN_DOWN(vma->vm_start),
+		     PFN_DOWN(faddr & PMD_MASK));
+	end   = min3(rpfn, PFN_DOWN(vma->vm_end),
+		     PFN_DOWN((faddr & PMD_MASK) + PMD_SIZE));
+
+	if (end > start) {
+		nr = end - start;
+		pte = pte_offset_map(vmf->pmd, start << PAGE_SHIFT);
+		if (pte) {
+			for (i = 0; i < nr; i++) {
+				pentry = ptep_get_lockless(pte + i);
+				if (!is_swap_pte(pentry))
+					continue;
+				entry = pte_to_swp_entry(pentry);
+				if (unlikely(non_swap_entry(entry)))
+					continue;
+				//Same swapfile only (the engine is per-device)
+				//and never the faulting page itself (its read
+				//is issued below, not prefetched).
+				if (swp_type(entry) != swp_type(fentry))
+					continue;
+				if (swp_offset(entry) == swp_offset(fentry))
+					continue;
+				slots[n++] = (u32)swp_offset(entry);
+			}
+			pte_unmap(pte);
+		}
+	}
+	if (n)
+		zest_swap_ra_submit(sis, slots, n);
+
+fault_read:
+	/* The faulting page itself: plain swap-cache read, no kernel RA. */
+	return read_swap_cache_async(fentry, gfp_mask, vma, vmf->address,
+				     NULL);
+}
