+}
+
+static struct kobj_attribute wbuf_sort_attr = __ATTR_RW(wbuf_sort);
+
+/* -------------------------------------------------------------- */
+/* read_cache (rw) -- ZEST private swap-in read cache (v3)         */
+/* -------------------------------------------------------------- */
+
+//zest-rc: 0 = off (default), 1 = on. Turning on allocates the per-swapfile
+//set-associative read cache (read_cache_slots pages) if a swapfile is
+//registered and arms the lookup/fill path. Turning off just disarms (the cache
+//is freed at swapoff, not at runtime). Run with vm.page-cluster=0: ZEST owns
+//prefetch; the kernel's own swap readahead must be off. See zest_rc_enable_set().
+static ssize_t read_cache_show(struct kobject *kobj,
+			       struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%d\n", atomic_read(&zest_rc_enable));
+}
+
+static ssize_t read_cache_store(struct kobject *kobj,
+				struct kobj_attribute *attr,
+				const char *buf, size_t count)
+{
+	bool on;
+	int ret;
+
+	ret = kstrtobool(buf, &on);
+	if (ret)
+		return ret;
+	ret = zest_rc_enable_set(on);
+	if (ret)
+		return ret;
+	return count;
+}
+
+static struct kobj_attribute read_cache_attr = __ATTR_RW(read_cache);
+
+//zest-rc (v3): cache size in total pages (= ways). Read at ALLOC time only --
+//takes effect at the next swapon (or the next runtime enable that finds no
+//cache yet), NOT on a live cache. Rounded up so the set count is a power of
+//two. Bounds: one set (8 pages) .. 32768 pages (128 MiB) -- the cache is also
+//the natural inflight cap for prefetch fills, so size it from the FIO QD
+//ceiling measurement.
+static ssize_t read_cache_slots_show(struct kobject *kobj,
+				     struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", READ_ONCE(zest_rc_slots));
+}
+
+static ssize_t read_cache_slots_store(struct kobject *kobj,
+				      struct kobj_attribute *attr,
+				      const char *buf, size_t count)
+{
+	unsigned int val;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &val);
+	if (ret)
+		return ret;
+	if (val < ZEST_RC_WAYS || val > 32768)
+		return -EINVAL;
+	WRITE_ONCE(zest_rc_slots, val);
+	return count;
+}
+
+static struct kobj_attribute read_cache_slots_attr =
+	__ATTR_RW(read_cache_slots);
+
+/* -------------------------------------------------------------- */
+/* vra_win / vra_inline (rw) -- ZEST VMA readahead engine          */
+/* -------------------------------------------------------------- */
+
+//zest-vra: readahead window MAX in pages. 0 = engine off (default; kernel
+//readahead applies). >0 = ZEST takes over readahead for its swapfile, and the
+//ADAPTIVE policy (M3: __swapin_nr_pages, hits-driven grow/shrink per VMA)
+//picks the actual per-round window in [1, vra_win]. Set it to the QD the
+//device needs for full read bandwidth (FIO: ~4 in flight already saturates;
+//32 = generous cap). Effective only with read_cache=1. Run with
+//vm.page-cluster=0 so the KERNEL's readahead is off while ours runs.
+//Runtime-tunable (read per fault).
+static ssize_t vra_win_show(struct kobject *kobj,
+			    struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", READ_ONCE(zest_vra_win));
+}
+
+static ssize_t vra_win_store(struct kobject *kobj,
+			     struct kobj_attribute *attr,
+			     const char *buf, size_t count)
+{
+	unsigned int val;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &val);
+	if (ret)
+		return ret;
+	if (val > ZEST_SWAP_RA_WIN_MAX)
+		return -EINVAL;
+	WRITE_ONCE(zest_vra_win, val);
+	return count;
+}
+
+static struct kobj_attribute vra_win_attr = __ATTR_RW(vra_win);
+
+//zest-vra: submission mode A/B. 0 (default) = requests go through the kfifo
+//to the big-core worker; 1 = L2P translate + claim + submit_bio directly in
+//fault context (the bio is still async -- this only moves the ~us submission
+//work inline, eliminating worker wakeup latency at the cost of fault-path
+//cycles). Compare ra_late/dup (busy_direct) between the two modes.
+static ssize_t vra_inline_show(struct kobject *kobj,
+			       struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%d\n", atomic_read(&zest_vra_inline));
+}
+
+static ssize_t vra_inline_store(struct kobject *kobj,
+				struct kobj_attribute *attr,
+				const char *buf, size_t count)
+{
+	bool on;
+	int ret;
+
+	ret = kstrtobool(buf, &on);
+	if (ret)
+		return ret;
+	atomic_set(&zest_vra_inline, on ? 1 : 0);
+	return count;
+}
+
+static struct kobj_attribute vra_inline_attr = __ATTR_RW(vra_inline);
+
+//zest-vra (M3.5): max prefetch fills in flight at the device. 0 = unlimited
+//(legacy behavior: the only cap is free cache ways, ~1000 -- measured to
+//stuff the UFS queue and inflate demand-read latency ~1.5x, costing ~11%
+//peak swap-in bandwidth). Set to the QD where 4K random read saturates
+//(FIO: ~4-8): a demand read then waits behind at most this many fills.
+//Runtime-tunable (read per submission). Worker mode waits at the cap;
+//vra_inline mode drops (counted in stats as vra_throttled).
+static ssize_t vra_inflight_show(struct kobject *kobj,
+				 struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", READ_ONCE(zest_vra_inflight));
+}
+
+static ssize_t vra_inflight_store(struct kobject *kobj,
+				  struct kobj_attribute *attr,
+				  const char *buf, size_t count)
+{
+	unsigned int val;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &val);
+	if (ret)
+		return ret;
+	if (val > 1024)
+		return -EINVAL;
+	WRITE_ONCE(zest_vra_inflight, val);
+	return count;
+}
+
+static struct kobj_attribute vra_inflight_attr = __ATTR_RW(vra_inflight);
+
+//zest-vra (M3.6): hit-streak threshold to jump the window straight to vra_win,
+//skipping the Linux doubling ladder. 0 = off (stock slope). A round that ends
+//with >= this many consecutive peek hits opens the next window at the cap --
+//targets long runs only (singleton rounds have hits==0). CAVEAT: a fresh VMA
+//bootstraps with synthetic hits=4 (see GET_SWAP_RA_VAL), so values <= 4 also
+//fire the jump on the FIRST fault of every VMA; start sweeping at 5 unless
+//that aggressive bootstrap is wanted. Runtime-tunable.
+static ssize_t vra_jump_show(struct kobject *kobj,
+			     struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", READ_ONCE(zest_vra_jump));
+}
+
+static ssize_t vra_jump_store(struct kobject *kobj,
+			      struct kobj_attribute *attr,
+			      const char *buf, size_t count)
+{
+	unsigned int val;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &val);
+	if (ret)
+		return ret;
+	if (val > 64)
+		return -EINVAL;
+	WRITE_ONCE(zest_vra_jump, val);
+	return count;
+}
+
+static struct kobj_attribute vra_jump_attr = __ATTR_RW(vra_jump);
+
+//zest-vra (M3.6): blunt window floor, 0 = off. Applies to EVERY readahead
+//round including the ~2/3 singleton ones, i.e. deliberately M2-shaped waste:
+//this knob exists to sweep the precision<->coverage trade-off curve for the
+//paper, not as a recommended setting. Clamped to vra_win at use.
+static ssize_t vra_min_show(struct kobject *kobj,
+			    struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", READ_ONCE(zest_vra_min));
+}
+
+static ssize_t vra_min_store(struct kobject *kobj,
+			     struct kobj_attribute *attr,
+			     const char *buf, size_t count)
+{
+	unsigned int val;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &val);
+	if (ret)
+		return ret;
+	if (val > ZEST_SWAP_RA_WIN_MAX)
+		return -EINVAL;
+	WRITE_ONCE(zest_vra_min, val);
+	return count;
+}
+
+static struct kobj_attribute vra_min_attr = __ATTR_RW(vra_min);
+
+/* -------------------------------------------------------------- */
+/* group                                                           */
+/* -------------------------------------------------------------- */
+
+static struct attribute *zest_attrs[] = {
+	&enable_attr.attr,
+	&stats_attr.attr,
+	&fatal_attr.attr,
+	&cache_retain_min_free_attr.attr,
+	&ra_debug_attr.attr,
+	&wbuf_sort_attr.attr,
+	&read_cache_attr.attr,
+	&read_cache_slots_attr.attr,
+	&vra_win_attr.attr,
+	&vra_inline_attr.attr,
+	&vra_inflight_attr.attr,
+	&vra_jump_attr.attr,
+	&vra_min_attr.attr,
+	NULL,
+};
+
+static const struct attribute_group zest_attr_group = {
+	.attrs = zest_attrs,
+};
+
+int zest_sysfs_init(void)
+{
+	int ret;
+
+	zest_kobj = kobject_create_and_add("zest", kernel_kobj);
+	if (!zest_kobj)
+		return -ENOMEM;
+
+	ret = sysfs_create_group(zest_kobj, &zest_attr_group);
+	if (ret) {
+		kobject_put(zest_kobj);
+		zest_kobj = NULL;
+		return ret;
+	}
+	return 0;
+}
+
+void zest_sysfs_exit(void)
+{
+	if (zest_kobj) {
+		sysfs_remove_group(zest_kobj, &zest_attr_group);
+		kobject_put(zest_kobj);
+		zest_kobj = NULL;
+	}
+}
