+	if (sbi->zest_enable) {
+		//zest: swapoff returns the filesystem to the default non-ZEST mode.
+		sbi->zest_enable = false;
+		f2fs_notice(sbi, "zest: swapoff auto-disabled zest_enable");
+	}
 
