diff --git a/mm/zest/zest_main.c b/mm/zest/zest_main.c
new file mode 100644
index 000000000000..4f32f283a6a9
--- /dev/null
+++ b/mm/zest/zest_main.c
@@ -0,0 +1,3564 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ZEST main: static branch, registry, lifecycle, hook stubs,
+ * subsystem-wide stats.
+ *
+ * Step 1 adds redirect counters but keeps swap I/O hooks as stubs.
+ */
+#define pr_fmt(fmt) "zest: " fmt
+
+#include <linux/init.h>
+#include <linux/module.h>
+#include <linux/printk.h>
+#include <linux/spinlock.h>
+#include <linux/list.h>
+#include <linux/slab.h>
+#include <linux/blkdev.h>
+#include <linux/swap.h>
+#include <linux/swapops.h>
+#include <linux/atomic.h>
+//zest: needed for swap_extent rbtree walk, percpu cluster_next reset,
+//and the random seed of those percpu cursors.
+#include <linux/rbtree.h>
+#include <linux/percpu.h>
+#include <linux/cpumask.h>
+#include <linux/random.h>
+//zest: bio submission, folio writeback bookkeeping, swap-stat counters,
+//folio kmap for the slot-0 header copy, sort() for zone dedup.
+//read_mapping_page is in pagemap.h -- used to grab the mkswap header
+//from the F2FS page cache (mm/swapfile.c populated it moments before
+//our swap_activate hook fires).
+#include <linux/bio.h>
+#include <linux/writeback.h>
+#include <linux/vmstat.h>
+#include <linux/highmem.h>
+#include <linux/mm.h>
+#include <linux/pagemap.h>
+#include <linux/sort.h>
+#include <linux/math64.h>	//zest-ra: div64_u64 for avg-segments telemetry
+#include <linux/hash.h>		//zest-ra: hash_long for the packed VMA sort key
+#include <linux/log2.h>		//zest-rc: roundup_pow_of_two/ilog2 for the set geometry
+#include <linux/ioprio.h>	//zest-vra: IOPRIO_CLASS_IDLE for prefetch bios
+//zest-gc: background GC thread + its wakeup, plus batched-GC completion.
+#include <linux/kthread.h>
+#include <linux/wait.h>
+#include <linux/completion.h>
+#include <linux/rcupdate.h>
+#include <linux/workqueue.h>
+#include <linux/zest.h>
+
+#include "zest_internal.h"
+
+//zest1
+/* Master static branch. Toggle via /sys/kernel/zest/enable. */
+DEFINE_STATIC_KEY_FALSE(zest_enabled_key);
+
+/* Global stats. Defined here, declared in zest_internal.h. */
+struct zest_global_stats zest_stats;
+
+//zest-znswap: swap-cache retention threshold in free zones (see
+//ZEST_CACHE_RETAIN_MIN_FREE). Tunable via /sys/kernel/zest/cache_retain_min_free.
+unsigned int zest_cache_retain_min_free = ZEST_CACHE_RETAIN_MIN_FREE;
+
+//zest-ra (debug): VMA-readahead placement instrumentation master switch.
+//Default off -> no vkey alloc / capture / stats. See zest_ra_debug_set().
+atomic_t zest_ra_dbg = ATOMIC_INIT(0);
+
+//zest-rc: swap-in read-cache master switch. Default off. See zest_rc_enable_set().
+atomic_t zest_rc_enable = ATOMIC_INIT(0);
+//zest-rc (v3): cache size in total pages, /sys/kernel/zest/read_cache_slots.
+//Read at alloc time only (next swapon / runtime enable).
+unsigned int zest_rc_slots = ZEST_RC_SLOTS_DEFAULT;
+//zest-vra: readahead window (pages), 0 = engine off (default). See
+//zest_internal.h. Read per fault via __zest_swap_ra_win().
+unsigned int zest_vra_win;
+//zest-vra: 1 = submit fills inline in fault context instead of the worker.
+atomic_t zest_vra_inline = ATOMIC_INIT(0);
+//zest-vra (M3.5): max fills in flight at the device, 0 = unlimited. See
+//zest_internal.h. Read per submission.
+unsigned int zest_vra_inflight;
+//zest-vra (M3.6): asymmetric-aggression window knobs (see linux/zest.h).
+//Both 0 (default) = stock Linux __swapin_nr_pages behavior. Read per
+//readahead round in mm/swap_state.c.
+unsigned int zest_vra_jump;
+unsigned int zest_vra_min;
+//zest-ra: write-side VMA placement mode, /sys/kernel/zest/wbuf_sort.
+//0 = off (default; ra_debug then only captures + logs, never reorders),
+//1 = bounce gather-copy (one extra 4M memcpy per flush, device bios stay
+//big and contiguous), 2 = zero-copy permuted bio (no copy; bvecs fragment
+//wherever VMA order diverges from arrival order -- watch avg_bio_kb).
+//Only effective while ra_debug=1 has the vkey machinery capturing.
+unsigned int zest_wbuf_sort;
+
+/* zest3.1: subsystem-wide FATAL latch mirror. See zest_internal.h. */
+atomic_t   zest_fatal       = ATOMIC_INIT(0);
+atomic64_t zest_fatal_count = ATOMIC64_INIT(0);
+atomic64_t zest_fatal_slot  = ATOMIC64_INIT(0);
+atomic_t   zest_fatal_nr    = ATOMIC_INIT(0);
+
+/* -------------------------------------------------------------- */
+/* Registry                                                       */
+/* -------------------------------------------------------------- */
+
+//zest: ZEST allows exactly one zest-enabled swapfile (enforced at swapon),
+//so the multi-swapfile registry+spinlock is gone. A single RCU-published
+//pointer serves every runtime path with no lock:
+//  - hot path: rcu_dereference_raw() (see zest_current()); lifetime is
+//    guaranteed because f2fs_swap_deactivate -> zest_release_for_swapfile
+//    runs only after try_to_unuse() has quiesced all swap I/O, so no
+//    swap-in/out can deref a freed zi.
+//  - stats/monitoring: rcu_read_lock() + rcu_dereference() (preempt-disable
+//    only, no spinlock, safe to poll at high frequency).
+//zest_singleton_mutex serializes the cold swapon/swapoff claim+release only.
+static struct zest_info __rcu *zest_singleton;
+static DEFINE_MUTEX(zest_singleton_mutex);
+
+//zest: lockless hot-path resolver. Returns the zest_info iff @sis is the one
+//zest-enabled swapfile, else NULL. No rcu_read_lock: callers run only while
+//swap is active (before swap_deactivate frees zi).
+static __always_inline struct zest_info *zest_current(struct swap_info_struct *sis)
+{
+	struct zest_info *zi = rcu_dereference_raw(zest_singleton);
+
+	return (zi && zi->sis == sis) ? zi : NULL;
+}
+
+//zest-gc: read the (single) swapfile's GC counters for the subsystem-wide
+///sys/kernel/zest/stats node.
+void zest_gc_collect_stats(struct zest_gc_stats_sum *s)
+{
+	struct zest_info *zi;
+
+	memset(s, 0, sizeof(*s));
+	//zest: lockless via RCU -- single swapfile, no iteration. Safe to poll
+	//at high frequency for runtime monitoring; synchronize_rcu() in the
+	//release path waits out any reader here before zi is freed.
+	rcu_read_lock();
+	zi = rcu_dereference(zest_singleton);
+	if (zi) {
+		s->runs       = atomic64_read(&zi->gc_runs);
+		s->moved      = atomic64_read(&zi->gc_moved_blocks);
+		s->reclaimed  = atomic64_read(&zi->gc_zones_reclaimed);
+		s->aborts     = atomic64_read(&zi->gc_aborts_stale);
+		s->free_zones = atomic_read(&zi->nr_free_zones);
+		s->nr_swapfiles = 1;
+		//zest-wbuf: flush-size telemetry.
+		s->flush_count = atomic64_read(&zi->flush_count);
+		s->flush_pages = atomic64_read(&zi->flush_pages);
+		s->wbuf_cap = zi->wbuf_cap;
+		//zest-ra: bio-size telemetry (host flush + GC writes).
+		s->bio_count = atomic64_read(&zi->bio_count);
+		s->host_wb_bytes = atomic64_read(&zi->host_wb_bytes);
+		s->gc_wb_bytes = atomic64_read(&zi->gc_wb_bytes);
+		//zest-rc: read-cache telemetry.
+		s->rc_hits = atomic64_read(&zi->rc.hits);
+		s->rc_misses = atomic64_read(&zi->rc.misses);
+		s->rc_busy_direct = atomic64_read(&zi->rc.busy_direct);
+		s->rc_fills = atomic64_read(&zi->rc.fills);
+		s->rc_fill_pages = atomic64_read(&zi->rc.fill_pages);
+		s->rc_fill_aborts = atomic64_read(&zi->rc.fill_aborts);
+		s->rc_fill_drops = atomic64_read(&zi->rc.fill_drops);
+		s->rc_fill_dups = atomic64_read(&zi->rc.fill_dups);
+		s->rc_late_fills = atomic64_read(&zi->rc.late_fills);
+		s->rc_useful_evict = atomic64_read(&zi->rc.useful_evict);
+		s->rc_wasted_evict = atomic64_read(&zi->rc.wasted_evict);
+		s->rc_ways = READ_ONCE(zi->rc.nr_ways);
+		s->rc_on = (READ_ONCE(zi->rc.ready) &&
+			    atomic_read(&zest_rc_enable)) ? 1 : 0;
+		s->ra_enq = atomic64_read(&zi->ra_enq);
+		s->ra_fifo_full = atomic64_read(&zi->ra_fifo_full);
+		s->ra_skip = atomic64_read(&zi->ra_skip);
+		s->ra_submitted = atomic64_read(&zi->ra_submitted);
+		s->ra_throttled = atomic64_read(&zi->ra_throttled);
+		s->ra_inflight = atomic_read(&zi->ra_inflight);
+		s->ra_peek_hits = atomic64_read(&zi->ra_peek_hits);
+		{
+			unsigned int b;
+
+			for (b = 0; b < ZEST_VRA_WIN_BUCKETS; b++)
+				s->ra_win_hist[b] =
+					atomic64_read(&zi->ra_win_hist[b]);
+		}
+	}
+	rcu_read_unlock();
+}
+
+/* -------------------------------------------------------------- */
+/* Hot-path predicate (Step 1: still always false)                */
+/* -------------------------------------------------------------- */
+
+bool __zest_should_intercept(struct swap_info_struct *sis)
+{
+	//zest2: a sis is intercepted iff it's the registered zest swapfile.
+	//The static-key gate in zest.h's inline keeps the cold path branch-free
+	//when ZEST isn't in use (no swapfile registered). Lockless singleton
+	//read on the hot path -- no registry spinlock.
+	return zest_current(sis) != NULL;
+}
+
+//zest-znswap: see __zest_swap_retain_cache() in zest.h. Resolve the folio's
+//swapfile; if it's the ZEST swapfile and the freelist still holds STRICTLY MORE
+//than zest_cache_retain_min_free free zones, tell mm to keep the slot (return
+//true) instead of trimming under vm_swap_full(). Lockless: zest_current() is an
+//rcu_dereference_raw (callers run while swap is active), nr_free_zones is
+//atomic. A racing change in free-zone count only flips a heuristic -- never a
+//correctness issue, since the swap allocator's own vm_swap_full() reclaim paths
+//(swapfile.c) remain the safety valve that frees cache-only slots under genuine
+//slot pressure.
+bool __zest_swap_retain_cache(struct folio *folio)
+{
+	struct swap_info_struct *sis = swp_swap_info(folio->swap);
+	struct zest_info *zi;
+
+	if (!sis)
+		return false;
+	zi = zest_current(sis);
+	if (!zi)
+		return false;
+	return atomic_read(&zi->nr_free_zones) >
+	       READ_ONCE(zest_cache_retain_min_free);
+}
+
+/* -------------------------------------------------------------- */
+/* Redirect counters (called from F2FS segment.c, gc.c)           */
+/* -------------------------------------------------------------- */
+
+void zest_account_redirect_data(void)
+{
+	atomic64_inc(&zest_stats.redirect_data);
+}
+
+void zest_account_redirect_node(void)
+{
+	atomic64_inc(&zest_stats.redirect_node);
+}
+
+/* -------------------------------------------------------------- */
+/* zest: bio completion + helpers                                */
+/* -------------------------------------------------------------- */
+
+//zest: replica of mm/page_io.c's static end_swap_bio_read. Copied line-for-line
+//so ZEST stays a self-contained module without requiring core mm to export the
+//symbol. If the upstream implementation changes (e.g. new folio-state contract)
+//keep this in sync.
+//zest-wbuf: there is no longer a write-side end_swap_bio_write replica. Swap-out
+//acks the folio (folio_end_writeback) at memcpy time, and the device write is a
+//ZEST-owned flush bio carrying *buffer* pages (not folios) -- see the flush path
+//below (zest_wbuf_bio_endio).
+static void zest3_end_swap_bio_read(struct bio *bio)
+{
+	struct folio *folio = bio_first_folio_all(bio);
+	struct zest_zone *z = bio->bi_private;
+
+	if (bio->bi_status) {
+		pr_alert("zest: read-error on swap-device (%u:%u:%llu) bi status %d\n",
+				     MAJOR(bio_dev(bio)), MINOR(bio_dev(bio)),
+				     (unsigned long long)bio->bi_iter.bi_sector, bio->bi_status);
+	} else {
+		folio_mark_uptodate(folio);
+	}
+	folio_unlock(folio);
+	if (z)
+		atomic_dec(&z->inflight_reads);
+	bio_put(bio);
+}
+
+//zest-wbuf: the flush worker, defined after the zone/map helpers it needs.
+static void zest_wbuf_flush_work(struct work_struct *w);
+
+//zest-wbuf: shared completion for one buffer's flush bio(s). A flush is one bio
+//in the common case, or <=2 after a zone-boundary split. Bias idiom (like the
+//GC batch writer): pending starts at 1, +1 per submitted bio, drop the bias
+//after the last submit; the last endio fires `done`. inflight_writes is NOT
+//touched here -- the worker holds it across wait_for_completion (process
+//context) so GC's victim drain is correct without interrupt-context locking.
+struct zest_wbuf_io {
+	atomic_t	pending;
+	blk_status_t	status;
+	struct completion done;
+};
+
+static void zest_wbuf_bio_endio(struct bio *bio)
+{
+	struct zest_wbuf_io *io = bio->bi_private;
+
+	if (bio->bi_status) {
+		io->status = bio->bi_status;
+		pr_alert("zest-wbuf: flush write-error sector=%llu status=%d\n",
+			 (unsigned long long)bio->bi_iter.bi_sector,
+			 bio->bi_status);
+	}
+	if (atomic_dec_and_test(&io->pending))
+		complete(&io->done);
+	bio_put(bio);
+}
+
+//zest-wbuf: free one buffer's backing pages + metadata. Safe on partial/NULL
+//(init error path and release both call it).
+static void zest_wbuf_free_one(struct zest_wbuf *wb)
+{
+	if (wb->pages) {
+		if (wb->contig) {
+			if (wb->base)
+				__free_pages(wb->base, wb->order);
+		} else {
+			unsigned int i;
+
+			for (i = 0; i < wb->cap; i++)
+				if (wb->pages[i])
+					__free_page(wb->pages[i]);
+		}
+		kvfree(wb->pages);
+		wb->pages = NULL;
+	}
+	kvfree(wb->bslot);
+	wb->bslot = NULL;
+	//zest-ra (debug): the vkey[] array, if the ra_debug switch ever allocated
+	//it. At swapoff the singleton is unpublished under zest_singleton_mutex
+	//before teardown, so zest_ra_debug_set() can't race this free; the disable
+	//path NULLs it first, so this sees NULL then. kvfree(NULL) is fine either way.
+	kvfree(wb->vkey);
+	wb->vkey = NULL;
+	wb->base = NULL;
+}
+
+//zest-wbuf: allocate one buffer. contig=true: one PHYSICALLY-CONTIGUOUS run of
+//(1<<order) pages (fast path -> bio_add_page coalesces into big segments).
+//contig=false: @want individual pages (fragmented fallback; functional, small
+//segments). Returns 0 / -ENOMEM; on failure leave it freeable via free_one.
+static int zest_wbuf_alloc_one(struct zest_wbuf *wb, bool contig,
+			       unsigned int order, unsigned int want)
+{
+	unsigned int cap = contig ? (1u << order) : want;
+	unsigned int i;
+
+	//Set cap up front so a partial-failure free_one() bounds its page loop
+	//correctly (and frees any pages already allocated). contig stays false
+	//until base succeeds, so a failed contig attempt frees via the (all-NULL)
+	//page array, not __free_pages(NULL).
+	wb->cap = cap;
+	//kvcalloc (NULL-init): on a partial fragmented alloc, free_one must see
+	//NULL for not-yet-allocated entries rather than garbage.
+	wb->pages = kvcalloc(cap, sizeof(*wb->pages), GFP_KERNEL);
+	if (!wb->pages)
+		return -ENOMEM;
+	wb->bslot = kvmalloc_array(cap, sizeof(*wb->bslot), GFP_KERNEL);
+	if (!wb->bslot)
+		return -ENOMEM;
+	memset(wb->bslot, 0xff, (size_t)cap * sizeof(*wb->bslot));
+
+	if (contig) {
+		//__GFP_NORETRY|__GFP_NOWARN: fail fast so the caller can try a
+		//smaller order instead of stalling in compaction/OOM.
+		wb->base = alloc_pages(GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN,
+				       order);
+		if (!wb->base)
+			return -ENOMEM;
+		wb->order  = order;
+		wb->contig = true;
+		for (i = 0; i < cap; i++)
+			wb->pages[i] = wb->base + i;
+	} else {
+		wb->base   = NULL;
+		wb->order  = 0;
+		wb->contig = false;
+		for (i = 0; i < cap; i++) {
+			wb->pages[i] = alloc_page(GFP_KERNEL);
+			if (!wb->pages[i])
+				return -ENOMEM;
+		}
+	}
+	wb->cap = cap;
+	return 0;
+}
+
+//zest-wbuf: allocate the whole ring. Try ZEST_WBUF_COUNT physically-contiguous
+//runs at decreasing order (4M -> ... -> 256K, per the user's fallback chain);
+//if none works, fall back to a fragmented per-page buffer of the full target
+//size. All buffers share one cap so the global page index / L2P encoding stays
+//uniform. cap is always a divisor of (or <=) the zone size, so a full-buffer
+//flush stays zone-aligned; partial flushes are handled by the <=2-bio split.
+static int zest_wbuf_pool_alloc(struct zest_info *zi)
+{
+	unsigned int target = ZEST_WBUF_BYTES >> PAGE_SHIFT;
+	int min_order = get_order(256u << 10);
+	int order, i;
+
+	for (order = get_order(ZEST_WBUF_BYTES); order >= min_order; order--) {
+		bool ok = true;
+
+		for (i = 0; i < (int)ZEST_WBUF_COUNT; i++) {
+			if (zest_wbuf_alloc_one(&zi->wbufs[i], true,
+						(unsigned int)order, 0)) {
+				ok = false;
+				break;
+			}
+		}
+		if (ok) {
+			zi->wbuf_cap = 1u << order;
+			pr_notice("zest-wbuf: %u contiguous buffers x %u pages (%u KiB each)\n",
+				  ZEST_WBUF_COUNT, zi->wbuf_cap,
+				  (zi->wbuf_cap << PAGE_SHIFT) >> 10);
+			return 0;
+		}
+		for (i = 0; i < (int)ZEST_WBUF_COUNT; i++)
+			zest_wbuf_free_one(&zi->wbufs[i]);
+		pr_warn("zest-wbuf: contiguous alloc failed at order %d (%u KiB); trying smaller\n",
+			order, (unsigned int)(((1u << order) << PAGE_SHIFT) >> 10));
+	}
+
+	pr_warn("zest-wbuf: no contiguous run down to 256K; using FRAGMENTED buffers (small segments -> reduced write bandwidth)\n");
+	for (i = 0; i < (int)ZEST_WBUF_COUNT; i++) {
+		if (zest_wbuf_alloc_one(&zi->wbufs[i], false, 0, target)) {
+			for (; i >= 0; i--)
+				zest_wbuf_free_one(&zi->wbufs[i]);
+			return -ENOMEM;
+		}
+	}
+	zi->wbuf_cap = target;
+	pr_warn("zest-wbuf: fragmented fallback ok: %u buffers x %u pages\n",
+		ZEST_WBUF_COUNT, zi->wbuf_cap);
+	return 0;
+}
+
+static void zest_wbuf_pool_free(struct zest_info *zi)
+{
+	unsigned int i;
+
+	for (i = 0; i < ZEST_WBUF_COUNT; i++)
+		zest_wbuf_free_one(&zi->wbufs[i]);
+}
+
+//zest-wbuf: seal the FILLING buffer @wb (caller holds zi->buf_lock): snapshot
+//its fill, flip to FLUSHING, and queue its flush. No-op if not FILLING (so a
+//rotation and the backstop dwork can both call it without double-sealing).
+static void zest_wbuf_seal_locked(struct zest_info *zi, struct zest_wbuf *wb)
+{
+	if (wb->state != ZEST_WBUF_FILLING)
+		return;
+	wb->sealed_fill = wb->fill;
+	if (wb->sealed_fill) {
+		wb->state = ZEST_WBUF_FLUSHING;
+		queue_work(zi->wbuf_wq, &wb->flush_work);
+	} else {
+		//Empty (backstop fired on an untouched buffer): straight to FREE.
+		wb->state = ZEST_WBUF_FREE;
+		wake_up_all(&zi->wbuf_free_wait);
+	}
+}
+
+//zest-wbuf: index of a FREE buffer, or -1. Caller holds zi->buf_lock.
+static int zest_wbuf_pick_free_locked(struct zest_info *zi)
+{
+	unsigned int i;
+
+	for (i = 0; i < ZEST_WBUF_COUNT; i++)
+		if (zi->wbufs[i].state == ZEST_WBUF_FREE)
+			return (int)i;
+	return -1;
+}
+
+//zest-wbuf: lockless wait-condition for writers blocked on a free buffer. The
+//authoritative re-check happens under buf_lock in the claim loop.
+static bool zest_wbuf_any_free(struct zest_info *zi)
+{
+	unsigned int i;
+
+	for (i = 0; i < ZEST_WBUF_COUNT; i++)
+		if (READ_ONCE(zi->wbufs[i].state) == ZEST_WBUF_FREE)
+			return true;
+	return false;
+}
+
+/* ============================================================= */
+/* zest-ra (debug): VMA-readahead placement instrumentation       */
+/* ------------------------------------------------------------- */
+/* All gated by the /sys/kernel/zest/ra_debug switch (zest_ra_dbg).*/
+/* While off: vkey[] arrays are NULL, nothing here runs.          */
+/* ============================================================= */
+
+//anon_vma pointer of a plain-anon folio, 0 otherwise. Mirrors folio_anon_vma()
+//(mm/internal.h) inline to avoid pulling that header in; the strict
+//(m & FLAGS) == ANON test excludes KSM (ANON|MOVABLE) and shmem/movable.
+static inline unsigned long zest_folio_anon_vma(struct folio *folio)
+{
+	unsigned long m = (unsigned long)READ_ONCE(folio->mapping);
+
+	if ((m & PAGE_MAPPING_FLAGS) != PAGE_MAPPING_ANON)
+		return 0;
+	return m - PAGE_MAPPING_ANON;
+}
+
+//Pack a VMA coord into the u64 sort key persisted per slot (vkey_persist[]) and
+//used to order GC batches: high 32 = hash of anon_vma (groups one VMA together),
+//low 32 = folio index (orders pages within the VMA). av==0 -> 0 (the "no key"
+//sentinel; non-anon pages sort to one end). Lossy (hash collisions / idx
+//truncation) but only feeds sort() -> affects coalescing quality, never
+//correctness (placement is committed positionally per slot).
+static inline u64 zest_ra_pack_key(unsigned long av, pgoff_t idx)
+{
+	if (!av)
+		return 0;
+	return ((u64)hash_long(av, 32) << 32) | (u32)idx;
+}
+
+//sort_r comparators over an index permutation; priv = the wbuf being measured.
+static int zest_dbg_cmp_slot(const void *a, const void *b, const void *priv)
+{
+	const struct zest_wbuf *wb = priv;
+	u32 sa = wb->bslot[*(const u32 *)a];
+	u32 sb = wb->bslot[*(const u32 *)b];
+
+	return (sa > sb) - (sa < sb);
+}
+
+static int zest_dbg_cmp_vma(const void *a, const void *b, const void *priv)
+{
+	const struct zest_wbuf *wb = priv;
+	const struct zest_vkey *ka = &wb->vkey[*(const u32 *)a];
+	const struct zest_vkey *kb = &wb->vkey[*(const u32 *)b];
+
+	if (ka->av != kb->av)
+		return (ka->av > kb->av) - (ka->av < kb->av);
+	return (ka->idx > kb->idx) - (ka->idx < kb->idx);
+}
+
+//Count, in a sealed buffer of @n staged pages: how many maximal runs the pages
+//form when ordered by VMA coord (anon_vma, then consecutive index) vs by swap
+//slot. Hypothesis to validate: FEW vma runs (pages are VMA-clustered) but MANY
+//slot runs (their slots are scattered) => a VMA-ordered placement would coalesce
+//reads that slot order cannot. Only anon pages have a VMA coord, so vma_segs and
+//the paired slot_segs are computed over the anon subset (apples-to-apples);
+//all_slot_segs is over every staged page for reference. Caller holds dbg_mutex
+//(so vkey[] can't be freed underneath) and has already snapshotted wb->vkey!=NULL.
+//Runs only in the background ordered flush worker -> a GFP_KERNEL scratch + two
+//sorts are fine. Pure measurement: does not reorder bslot/vkey (the commit path
+//reads them by buffer position).
+static void zest_dbg_seg_stats(struct zest_info *zi, struct zest_wbuf *wb,
+			       unsigned int n)
+{
+	unsigned int i, anon_n = 0;
+	unsigned int vma_segs = 0, slot_segs_anon = 0, slot_segs_all = 0;
+	u64 flushes;
+	u32 *ord;
+
+	if (!n)
+		return;
+	//GFP_NOIO: runs on the WQ_MEM_RECLAIM flush worker -> must not recurse into
+	//reclaim/IO on the swap device.
+	ord = kmalloc_array(n, sizeof(*ord), GFP_NOIO);
+	if (!ord)
+		return;
+
+	//slot runs over ALL staged pages.
+	for (i = 0; i < n; i++)
+		ord[i] = i;
+	sort_r(ord, n, sizeof(*ord), zest_dbg_cmp_slot, NULL, wb);
+	for (i = 0; i < n; i++)
+		if (i == 0 || wb->bslot[ord[i]] != wb->bslot[ord[i - 1]] + 1)
+			slot_segs_all++;
+
+	//anon subset: VMA runs, and slot runs over the SAME subset.
+	for (i = 0; i < n; i++)
+		if (wb->vkey[i].av)
+			ord[anon_n++] = i;
+	if (anon_n) {
+		sort_r(ord, anon_n, sizeof(*ord), zest_dbg_cmp_vma, NULL, wb);
+		for (i = 0; i < anon_n; i++) {
+			const struct zest_vkey *cur = &wb->vkey[ord[i]];
+			const struct zest_vkey *prv;
+
+			if (i == 0) {
+				vma_segs++;
+				continue;
+			}
+			prv = &wb->vkey[ord[i - 1]];
+			if (cur->av != prv->av || cur->idx != prv->idx + 1)
+				vma_segs++;
+		}
+		sort_r(ord, anon_n, sizeof(*ord), zest_dbg_cmp_slot, NULL, wb);
+		for (i = 0; i < anon_n; i++)
+			if (i == 0 ||
+			    wb->bslot[ord[i]] != wb->bslot[ord[i - 1]] + 1)
+				slot_segs_anon++;
+	}
+	kfree(ord);
+
+	atomic64_add(vma_segs, &zi->dbg_vma_segs);
+	atomic64_add(slot_segs_anon, &zi->dbg_slot_segs);
+	atomic64_add(anon_n, &zi->dbg_seg_pages);
+	flushes = atomic64_inc_return(&zi->dbg_seg_flushes);
+
+	pr_info_ratelimited(
+		"zest-ra: flush n=%u anon=%u vma_segs=%u slot_segs=%u all_slot_segs=%u | avg vma=%llu slot=%llu pages=%llu over %llu flushes\n",
+		n, anon_n, vma_segs, slot_segs_anon, slot_segs_all,
+		div64_u64((u64)atomic64_read(&zi->dbg_vma_segs), flushes),
+		div64_u64((u64)atomic64_read(&zi->dbg_slot_segs), flushes),
+		div64_u64((u64)atomic64_read(&zi->dbg_seg_pages), flushes),
+		flushes);
+}
+
+//Allocate the per-wbuf vkey[] arrays (zeroed: av=0 == "no VMA coord", so pages
+//staged before the switch flipped on read as non-anon and are skipped, never as
+//garbage). Idempotent; resets the running averages so each enable starts fresh.
+//dbg_mutex serializes against the flush worker's stats read; pointers are
+//published under buf_lock so the write path sees NULL-or-valid atomically.
+static int zest_dbg_vkey_alloc(struct zest_info *zi)
+{
+	struct zest_vkey *v[ZEST_WBUF_COUNT] = {};
+	unsigned int i;
+	int ret = 0;
+
+	mutex_lock(&zi->dbg_mutex);
+	if (zi->wbufs[0].vkey)
+		goto out;			//already allocated
+	for (i = 0; i < ZEST_WBUF_COUNT; i++) {
+		v[i] = kvcalloc(zi->wbuf_cap, sizeof(*v[i]), GFP_KERNEL);
+		if (!v[i]) {
+			ret = -ENOMEM;
+			for (i = 0; i < ZEST_WBUF_COUNT; i++)
+				kvfree(v[i]);
+			goto out;
+		}
+	}
+	atomic64_set(&zi->dbg_vma_segs, 0);
+	atomic64_set(&zi->dbg_slot_segs, 0);
+	atomic64_set(&zi->dbg_seg_pages, 0);
+	atomic64_set(&zi->dbg_seg_flushes, 0);
+	spin_lock(&zi->buf_lock);
+	for (i = 0; i < ZEST_WBUF_COUNT; i++)
+		zi->wbufs[i].vkey = v[i];
+	spin_unlock(&zi->buf_lock);
+	pr_notice("zest-ra: debug vkey arrays allocated (%u buffers x %u pages)\n",
+		  ZEST_WBUF_COUNT, zi->wbuf_cap);
+out:
+	mutex_unlock(&zi->dbg_mutex);
+	return ret;
+}
+
+//Free the vkey[] arrays. NULL under buf_lock first (so writers/flush stop using
+//them), then free under dbg_mutex (so a flush mid-stats, which holds dbg_mutex,
+//has finished before the memory goes away). Safe to call when already freed.
+//zest-ra: allocate everything the placement feature needs. Each part is
+//independent and best-effort -- a partial result just runs degraded:
+//  - per-wbuf vkey[]   : capture + stats + host sort key (no vkey -> feature off)
+//  - vkey_persist[]    : GC re-sort key, ~nr_slots*8 (no persist -> GC keeps scan order)
+//  - bounce (contiguous): host reorder write target (no bounce -> host arrival order)
+//Idempotent. These are NEVER freed on runtime disable -- the GC kthread reads
+//vkey_persist locklessly and the flush worker uses bounce/vkey[] outside any lock
+//that a free could synchronize against -- so runtime free would be a UAF. They
+//are freed only at swapoff (zest_ra_free), where GC is stopped and the flush wq
+//drained. Disable therefore just clears zest_ra_dbg; the memory lingers to swapoff.
+static void zest_ra_enable_alloc(struct zest_info *zi)
+{
+	if (zest_dbg_vkey_alloc(zi))
+		pr_warn("zest-ra: vkey[] alloc failed; capture/sort off\n");
+
+	mutex_lock(&zi->dbg_mutex);
+	//nr_slots must already be set: kvmalloc_array(0,...) returns ZERO_SIZE_PTR
+	//(non-NULL 0x10), which would pass the != NULL guard and wild-write.
+	if (!zi->vkey_persist && zi->nr_slots) {
+		u64 *p = kvmalloc_array(zi->nr_slots, sizeof(u64),
+					GFP_KERNEL | __GFP_ZERO);
+		if (!ZERO_OR_NULL_PTR(p))
+			WRITE_ONCE(zi->vkey_persist, p);
+		else
+			pr_warn("zest-ra: vkey_persist alloc failed; GC reorder off\n");
+	} else if (!zi->nr_slots) {
+		pr_warn("zest-ra: nr_slots==0 at enable; vkey_persist deferred\n");
+	}
+	mutex_unlock(&zi->dbg_mutex);
+
+	if (!zi->bounce.pages) {
+		//Match the staging cap (a power of two) so a full flush fits in one
+		//bounce; reuse the wbuf contiguous allocator. Must be a single
+		//contiguous run -- a fragmented bounce would lose the big write, the
+		//whole point -- so on any shortfall we drop it and host reorder stays
+		//off (writes go in arrival order, correct but no read gain).
+		int order = get_order((size_t)zi->wbuf_cap << PAGE_SHIFT);
+
+		if (zest_wbuf_alloc_one(&zi->bounce, true,
+					(unsigned int)order, 0) ||
+		    !zi->bounce.contig || zi->bounce.cap < zi->wbuf_cap) {
+			zest_wbuf_free_one(&zi->bounce);
+			pr_warn("zest-ra: bounce alloc failed; host reorder off\n");
+		}
+	}
+}
+
+//zest-ra: free the placement arrays. Called ONLY from swapoff release, after
+//zest_gc_thread_stop() + drain_workqueue() have quiesced the lockless readers.
+//(Per-wbuf vkey[] are freed by zest_wbuf_pool_free()/free_one().)
+static void zest_ra_free(struct zest_info *zi)
+{
+	zest_wbuf_free_one(&zi->bounce);
+	kvfree(zi->vkey_persist);
+	zi->vkey_persist = NULL;
+}
+
+//zest-ra: log ZEST's resident allocation at swapon so the new big arrays
+//(+vkey_persist ~16M, +bounce ~4M, contiguous gc_buf) are visible. Call once all
+//arrays are allocated, near the end of zest_init_for_swapfile.
+static void zest_report_memory(struct zest_info *zi)
+{
+	u64 l2p_b, vkp_b, zones_b, rmap_b = 0, gcbuf_b, gcsort_b, ring_b, bounce_b,
+	    hdr_b, rc_b, total;
+	unsigned int i;
+
+	l2p_b   = (u64)zi->nr_slots * sizeof(*zi->l2p);
+	vkp_b   = zi->vkey_persist ? (u64)zi->nr_slots * sizeof(*zi->vkey_persist) : 0;
+	zones_b = (u64)zi->nr_zones * sizeof(*zi->zones);
+	for (i = 0; i < zi->nr_zones; i++)
+		rmap_b += (u64)zi->zones[i].nr_blocks * sizeof(u32);
+	gcbuf_b = (u64)ZEST_GC_BUF_PAGES * sizeof(*zi->gc_buf) +
+		  (u64)zi->gc_buf_nr * PAGE_SIZE;
+	gcsort_b = zi->gc_sort ? (u64)ZEST_GC_BUF_PAGES * sizeof(*zi->gc_sort) : 0;
+	ring_b  = (u64)ZEST_WBUF_COUNT *
+		  ((u64)zi->wbuf_cap * PAGE_SIZE +
+		   (u64)zi->wbuf_cap * sizeof(u32) +
+		   (zi->wbufs[0].vkey ?
+		    (u64)zi->wbuf_cap * sizeof(struct zest_vkey) : 0));
+	bounce_b = zi->bounce.pages ? (u64)zi->bounce.cap * PAGE_SIZE : 0;
+	hdr_b   = zi->mkswap_header ? PAGE_SIZE : 0;
+	rc_b    = zi->rc.ready ? (u64)zi->rc.nr_ways *
+				 (PAGE_SIZE + sizeof(struct zest_rc_way)) : 0;
+	total = l2p_b + vkp_b + zones_b + rmap_b + gcbuf_b + gcsort_b + ring_b +
+		bounce_b + hdr_b + rc_b;
+
+	pr_notice("zest-mem: l2p=%lluK vkey_persist=%lluK zones=%lluK rmap=%lluK gc_buf=%lluK gc_sort=%lluK wbuf_ring=%lluK bounce=%lluK hdr=%lluK rc=%lluK | TOTAL=%lluMiB\n",
+		  l2p_b >> 10, vkp_b >> 10, zones_b >> 10, rmap_b >> 10,
+		  gcbuf_b >> 10, gcsort_b >> 10, ring_b >> 10, bounce_b >> 10,
+		  hdr_b >> 10, rc_b >> 10, total >> 20);
+}
+
+//ra_debug sysfs entry point (the VMA-placement master switch). On 1: best-effort
+//allocate the placement arrays for the live swapfile (if any) then arm. On 0:
+//just disarm -- arrays are NOT freed at runtime (see zest_ra_enable_alloc); they
+//persist until swapoff. With no swapfile yet the flag is remembered and swapon
+//allocates if it finds the switch on. Serialized vs swapon/swapoff by
+//zest_singleton_mutex. Runtime enable may fail to get the contiguous bounce/16MB
+//persist array under fragmentation -> degraded; enable before swapon for best luck.
+int zest_ra_debug_set(bool on)
+{
+	struct zest_info *zi;
+
+	mutex_lock(&zest_singleton_mutex);
+	zi = rcu_dereference_protected(zest_singleton,
+				       lockdep_is_held(&zest_singleton_mutex));
+	if (on && zi)
+		zest_ra_enable_alloc(zi);
+	//Publish the fully-built placement arrays before the switch: a flush/GC that
+	//observes the switch on (with the paired smp_rmb) sees them complete, not
+	//half-initialized (the runtime-enable race; swapon is ordered by RCU publish).
+	smp_wmb();
+	atomic_set(&zest_ra_dbg, on ? 1 : 0);
+	mutex_unlock(&zest_singleton_mutex);
+	return 0;
+}
+
+//zest-wbuf: NO idle-tail backstop. With early-ack there is no writeback hang,
+//and swap has no power-loss durability requirement, so a partially-filled buffer
+//is simply left to fill (or to be discarded at swapoff). Flushing it on a timer
+//would emit small bios and waste the big-contiguous-write advantage. A buffer
+//flushes ONLY when it fills to cap (via the rotation in zest_swap_writepage).
+
+//zest3: binary search through zi->zones[] for the zone containing a
+//given 512B sector. Returns zi->nr_zones if not found (caller should
+//tolerate; this should never happen for a sector we ourselves handed
+//out via the allocator).
+static unsigned int zest3_find_zone_for_sector(struct zest_info *zi,
+					       sector_t sector)
+{
+	unsigned int lo = 0, hi = zi->nr_zones;
+
+	while (lo < hi) {
+		unsigned int mid = lo + (hi - lo) / 2;
+		struct zest_zone *z = &zi->zones[mid];
+		sector_t zone_end =
+			z->start_sector + ((sector_t)z->nr_blocks << 3);
+
+		if (sector < z->start_sector)
+			hi = mid;
+		else if (sector >= zone_end)
+			lo = mid + 1;
+		else
+			return mid;
+	}
+	return zi->nr_zones;
+}
+
+//zest-gc: block offset of @sector within zone @z (PAGE-sized blocks).
+//Caller must have established (via zest3_find_zone_for_sector) that
+//@sector belongs to @z.
+static inline unsigned int zest_blk_in_zone(const struct zest_zone *z,
+					    sector_t sector)
+{
+	return (unsigned int)((sector - z->start_sector) >> (PAGE_SHIFT - 9));
+}
+
+//zest-gc: invalidate the L2P -> physical mapping that @sector currently
+//backs, if any: drop its rmap entry and decrement the owning zone's
+//valid_blocks. MUST be called with zi->map_lock held. @sector is a live
+//(old) L2P value being overwritten or freed.
+static void zest_map_invalidate_sector(struct zest_info *zi, sector_t sector)
+{
+	unsigned int z_idx = zest3_find_zone_for_sector(zi, sector);
+	struct zest_zone *z;
+
+	if (z_idx >= zi->nr_zones)
+		return;
+	z = &zi->zones[z_idx];
+	{
+		unsigned int blk = zest_blk_in_zone(z, sector);
+
+		if (z->rmap[blk] != ZEST_INVALID_SLOT) {
+			z->rmap[blk] = ZEST_INVALID_SLOT;
+			atomic_dec(&z->valid_blocks);
+		}
+	}
+}
+
+/* -------------------------------------------------------------- */
+/* zest-rc (v3): set-associative swap-in read cache               */
+/* -------------------------------------------------------------- */
+
+//zest-rc (v3): the way set holding @slot. nr_sets is a power of two (>=2,
+//so set_shift >= 1 and hash_32's shift stays defined); ways[] is set-major.
+static inline struct zest_rc_way *zest_rc_set(struct zest_rcache *rc,
+					      unsigned long slot)
+{
+	return &rc->ways[(size_t)hash_32((u32)slot, rc->set_shift) *
+			 ZEST_RC_WAYS];
+}
+
+//zest-rc: allocate the cache once (idempotent). Geometry comes from the
+//read_cache_slots knob: nr_sets = pow2(slots/WAYS), clamped to >=2 sets.
+//Backing pages are INDIVIDUAL 4K allocations -- v3 fills are single scattered
+//pages, so physical contiguity buys nothing. On failure the cache stays !ready
+//(lookup/claim short-circuit). Called from swapon (and a best-effort runtime
+//enable) under zest_singleton_mutex.
+static void zest_rc_alloc(struct zest_info *zi)
+{
+	struct zest_rcache *rc = &zi->rc;
+	unsigned int want = READ_ONCE(zest_rc_slots);
+	unsigned int nr_sets, nr_ways, i;
+	struct zest_rc_way *ways;
+
+	if (rc->ready)
+		return;
+
+	nr_sets = max_t(unsigned int, 2,
+			roundup_pow_of_two(DIV_ROUND_UP(want, ZEST_RC_WAYS)));
+	nr_ways = nr_sets * ZEST_RC_WAYS;
+
+	ways = kvcalloc(nr_ways, sizeof(*ways), GFP_KERNEL);
+	if (!ways) {
+		pr_warn("zest-rc: way array alloc failed; read cache off\n");
+		return;
+	}
+	for (i = 0; i < nr_ways; i++) {
+		ways[i].slot = ZEST_INVALID_SLOT;
+		ways[i].page = alloc_page(GFP_KERNEL | __GFP_NOWARN);
+		if (!ways[i].page) {
+			while (i--)
+				__free_page(ways[i].page);
+			kvfree(ways);
+			pr_warn("zest-rc: page alloc failed; read cache off\n");
+			return;
+		}
+	}
+	rc->ways = ways;
+	rc->nr_ways = nr_ways;
+	rc->nr_sets = nr_sets;
+	rc->set_shift = ilog2(nr_sets);
+	rc->victim_rr = 0;
+	smp_wmb();		/* publish the arrays before ->ready (runtime enable) */
+	WRITE_ONCE(rc->ready, true);
+	pr_notice("zest-rc: read cache ready: %u sets x %u ways = %u pages (%u KiB)\n",
+		  nr_sets, ZEST_RC_WAYS, nr_ways,
+		  nr_ways << (PAGE_SHIFT - 10));
+}
+
+//zest-rc: free the cache. ONLY from swapoff release, after the per-zone
+//inflight_reads drain (an async fill holds an inflight ref on its source zone,
+//so the drain guarantees no fill is still DMAing into a way page here).
+static void zest_rc_free(struct zest_info *zi)
+{
+	struct zest_rcache *rc = &zi->rc;
+	unsigned int i;
+
+	if (!rc->ready)
+		return;
+	WRITE_ONCE(rc->ready, false);
+	for (i = 0; i < rc->nr_ways; i++)
+		if (rc->ways[i].page)
+			__free_page(rc->ways[i].page);
+	kvfree(rc->ways);
+	rc->ways = NULL;
+	rc->nr_ways = 0;
+}
+
+//zest-rc: drop any cached copy of @slot. Called UNDER map_lock from the two L2P
+//mutation points (writepage rewrite -> BUF; slot_free -> INVALID) so a later
+//swap-in of @slot can never hit stale data; map_lock also serializes
+//invalidates of the same slot (the eviction ledger below counts each live page
+//exactly once). Read side of rc->lock: a single idempotent WRITE_ONCE, safe vs
+//a concurrent lookup (also read side); excluded from claim/fill_done by the
+//write side. GC relocation needs NO hook (it moves identical bytes; the cached
+//copy stays valid for the slot).
+static void zest_rc_invalidate_slot(struct zest_info *zi, unsigned long slot)
+{
+	struct zest_rcache *rc = &zi->rc;
+	struct zest_rc_way *w;
+	unsigned int i;
+
+	if (!READ_ONCE(rc->ready))
+		return;
+	read_lock(&rc->lock);
+	w = zest_rc_set(rc, slot);
+	for (i = 0; i < ZEST_RC_WAYS; i++, w++) {
+		if (READ_ONCE(w->slot) != (u32)slot)
+			continue;
+		WRITE_ONCE(w->slot, ZEST_INVALID_SLOT);
+		//A busy way is a fill in flight: fill_done sees the key gone and
+		//books the abort. Only a LIVE page exits the cache right here.
+		if (!READ_ONCE(w->busy))
+			atomic64_inc(READ_ONCE(w->hit) ? &rc->useful_evict
+						       : &rc->wasted_evict);
+		break;	/* claim dedups: at most one way holds a given slot */
+	}
+	read_unlock(&rc->lock);
+}
+
+//zest-rc: swap-in fast path. If @slot is cached, copy it into @folio, mark it
+//uptodate, unlock, and return true. Read side of rc->lock (the only writes are
+//lockless flag hints: `hit` for the precision ledger, `raced` to tell an
+//in-flight fill it lost the race). A BUSY matching way is a MISS by design:
+//the fault must never wait on a fill -- the caller submits its own read
+//immediately and the duplicate IO is just counted (busy_direct). Keyed by
+//slot: a hit may sit at a different physical sector than l2p[slot] now (GC
+//relocated it) but GC copies identical bytes; free/rewrite are handled by
+//zest_rc_invalidate_slot.
+static bool zest_rc_lookup(struct zest_info *zi, unsigned long slot,
+			   struct folio *folio)
+{
+	struct zest_rcache *rc = &zi->rc;
+	struct zest_rc_way *w;
+	unsigned int i;
+	bool hit = false, busy = false;
+
+	if (!READ_ONCE(rc->ready) || !atomic_read(&zest_rc_enable))
+		return false;
+
+	read_lock(&rc->lock);
+	w = zest_rc_set(rc, slot);
+	for (i = 0; i < ZEST_RC_WAYS; i++, w++) {
+		if (READ_ONCE(w->slot) != (u32)slot)
+			continue;
+		if (READ_ONCE(w->busy)) {
+			WRITE_ONCE(w->raced, true);
+			busy = true;
+		} else {
+			void *kaddr = kmap_local_folio(folio, 0);
+
+			memcpy(kaddr, page_address(w->page), PAGE_SIZE);
+			kunmap_local(kaddr);
+			WRITE_ONCE(w->hit, true);
+			hit = true;
+		}
+		break;
+	}
+	read_unlock(&rc->lock);
+
+	if (hit) {
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		count_vm_events(PSWPIN, folio_nr_pages(folio));
+		atomic64_inc(&zi->nr_reads);
+		atomic64_inc(&rc->hits);
+		return true;
+	}
+	if (busy)
+		atomic64_inc(&rc->busy_direct);
+	atomic64_inc(&rc->misses);
+	return false;
+}
+
+//zest-rc (v3): claim a way for an async prefetch fill of @slot. Returns the
+//claimed way (key set, busy) or NULL when nothing should be read: the slot is
+//already cached / being filled (fill_dups), or every way in its set is busy
+//(fill_drops -- the natural inflight cap: at most nr_ways fills in flight).
+//Victim: an empty way if the set has one, else round-robin over the non-busy
+//live ways. The caller then reads the slot's CURRENT data into way->page (one
+//4K bio, REQ_RAHEAD + low ioprio, under the zone inflight_reads protocol) with
+//NO rc lock held, and finishes with zest_rc_fill_done. Consumed by the VMA
+//readahead engine (zest_vra_fill_one below).
+static struct zest_rc_way *
+zest_rc_claim(struct zest_info *zi, unsigned long slot)
+{
+	struct zest_rcache *rc = &zi->rc;
+	struct zest_rc_way *set, *empty = NULL, *live = NULL, *victim;
+	unsigned int i, start;
+
+	if (!READ_ONCE(rc->ready) || !atomic_read(&zest_rc_enable))
+		return NULL;
+
+	write_lock(&rc->lock);
+	set = zest_rc_set(rc, slot);
+	start = rc->victim_rr++;
+	for (i = 0; i < ZEST_RC_WAYS; i++) {
+		struct zest_rc_way *w = &set[(start + i) % ZEST_RC_WAYS];
+
+		if (w->slot == (u32)slot) {	/* cached or already in flight */
+			write_unlock(&rc->lock);
+			atomic64_inc(&rc->fill_dups);
+			return NULL;
+		}
+		if (w->busy)
+			continue;
+		if (w->slot == ZEST_INVALID_SLOT) {
+			if (!empty)
+				empty = w;
+		} else if (!live) {
+			live = w;
+		}
+	}
+	victim = empty ? empty : live;
+	if (!victim) {
+		write_unlock(&rc->lock);
+		atomic64_inc(&rc->fill_drops);
+		return NULL;
+	}
+	//Evicting a published page: close its precision-ledger entry.
+	if (victim->slot != ZEST_INVALID_SLOT)
+		atomic64_inc(victim->hit ? &rc->useful_evict
+					 : &rc->wasted_evict);
+	victim->slot = (u32)slot;
+	victim->busy = true;
+	victim->raced = false;
+	victim->hit = false;
+	write_unlock(&rc->lock);
+	atomic64_inc(&rc->fills);
+	return victim;
+}
+
+//zest-rc (v3): publish (or discard) a claimed fill. @ok = the device read into
+//@way->page succeeded. Publication is keyed: if the way's key changed while the
+//read was in flight (slot rewritten/freed -> invalidate set it to INVALID under
+//map_lock), the just-read bytes are stale -> discard, the way returns to empty.
+//The write_lock here also orders the DMA'd page contents before any lookup's
+//memcpy (the lock pair is the barrier). Pairs 1:1 with zest_rc_claim.
+static void
+zest_rc_fill_done(struct zest_info *zi, struct zest_rc_way *way,
+		  unsigned long slot, bool ok)
+{
+	struct zest_rcache *rc = &zi->rc;
+	bool late = false;
+
+	write_lock(&rc->lock);
+	if (way->slot != (u32)slot)
+		ok = false;		/* invalidated mid-flight; key already INVALID */
+	else if (!ok)
+		way->slot = ZEST_INVALID_SLOT;	/* read error: drop the claim */
+	else
+		late = way->raced;
+	way->busy = false;
+	write_unlock(&rc->lock);
+
+	if (ok) {
+		atomic64_inc(&rc->fill_pages);
+		if (late)
+			atomic64_inc(&rc->late_fills);
+	} else {
+		atomic64_inc(&rc->fill_aborts);
+	}
+}
+
+//zest-rc: /sys/kernel/zest/read_cache entry point. On 1: best-effort allocate the
+//cache for the live swapfile (if any) then arm. On 0: just disarm -- the cache
+//is NOT freed at runtime (an in-flight fill DMAs into it); it persists until
+//swapoff. With no swapfile yet the flag is remembered and swapon allocates if
+//it finds the switch on. Serialized vs swapon/swapoff by zest_singleton_mutex.
+int zest_rc_enable_set(bool on)
+{
+	struct zest_info *zi;
+
+	mutex_lock(&zest_singleton_mutex);
+	zi = rcu_dereference_protected(zest_singleton,
+				       lockdep_is_held(&zest_singleton_mutex));
+	if (on && zi)
+		zest_rc_alloc(zi);
+	//Publish the fully-built cache before the switch: a lookup/claim that
+	//observes the switch on (with the paired read of ->ready) sees it complete.
+	smp_wmb();
+	atomic_set(&zest_rc_enable, on ? 1 : 0);
+	mutex_unlock(&zest_singleton_mutex);
+	return 0;
+}
+
+/* -------------------------------------------------------------- */
+/* zest-vra: VMA-readahead prefetch engine                        */
+/* -------------------------------------------------------------- */
+
+//zest-vra: prefetch bio completion. Runs in irq/softirq context, so it must
+//NOT take the rc rwlock (the fault-path readers are irq-unsafe by design):
+//it records the status, queues the way on the lockless completion list, and
+//lets the worker publish it (zest_rc_fill_done) in process context.
+//ORDER MATTERS: the inflight_reads ref is dropped LAST. The release-side
+//teardown waits for inflight_reads==0 and then flushes/destroys ra_wq -- the
+//llist_add and queue_work above the dec are thereby guaranteed to have
+//happened before the flush, so no completion is ever lost or queued onto a
+//destroyed workqueue.
+static void zest_vra_end_fill(struct bio *bio)
+{
+	struct zest_rc_way *way = bio->bi_private;
+	struct zest_info *zi = way->fill_zi;
+	struct zest_zone *z = way->fill_zone;
+
+	way->fill_ok = !bio->bi_status;
+	bio_put(bio);
+	llist_add(&way->fill_node, &zi->ra_done);
+	queue_work(zi->ra_wq, &zi->ra_work);
+	//zest-vra (M3.5): release the inflight-cap slot and wake a throttled
+	//worker. Must stay ABOVE the zone-ref dec: zi accesses (including the
+	//waitqueue) are only guaranteed safe while this fill's zone ref pins
+	//the teardown. wake_up is irq-safe.
+	atomic_dec(&zi->ra_inflight);
+	wake_up(&zi->ra_throttle_wq);
+	smp_mb__before_atomic();	/* llist_add/queue_work before the dec */
+	atomic_dec(&z->inflight_reads);
+}
+
+//zest-vra: prefetch one slot into the read cache -- one async 4K read.
+//Callable from the worker (default) or directly from fault context
+//(vra_inline); submit_bio itself is async either way. Best-effort at every
+//step: any obstacle just drops the hint (the fault that may come later does
+//its own read). Follows the same inflight_reads protocol as the readpage
+//path: ref the zone, full barrier, recheck l2p -- GC can't reset the zone
+//under the read, and a mid-claim relocation/free is detected and aborted
+//(no retry: this is a hint, not a demand read).
+static void zest_vra_fill_one(struct zest_info *zi, u32 slot)
+{
+	struct zest_rc_way *way;
+	struct zest_zone *z;
+	unsigned int z_idx;
+	sector_t sector;
+	struct bio *bio;
+
+	if (READ_ONCE(zi->ra_dead) || unlikely(atomic_read(&zi->fatal)))
+		return;
+	if (unlikely(slot >= zi->nr_slots))
+		return;		/* defensive; never trip FATAL from a hint */
+	sector = READ_ONCE(zi->l2p[slot]);
+	//Unmapped, or still staged in the write buffer: a fault on this slot is
+	//served from RAM (BUF) anyway -- nothing useful to prefetch from flash.
+	if (sector == ZEST_INVALID_SECTOR || zest_l2p_is_buf(sector)) {
+		atomic64_inc(&zi->ra_skip);
+		return;
+	}
+
+	way = zest_rc_claim(zi, slot);
+	if (!way)
+		return;		/* dup / set busy -- counted inside claim */
+
+	z_idx = zest3_find_zone_for_sector(zi, sector);
+	if (unlikely(z_idx >= zi->nr_zones)) {
+		zest_rc_fill_done(zi, way, slot, false);
+		return;
+	}
+	z = &zi->zones[z_idx];
+	atomic_inc(&z->inflight_reads);
+	//StoreLoad barrier between the inc and the l2p recheck; pairs with the
+	//smp_mb() before the GC/release "while (inflight_reads) cpu_relax()"
+	//drain. Same protocol as zest_swap_readpage.
+	smp_mb();
+	if (READ_ONCE(zi->l2p[slot]) != sector) {
+		atomic_dec(&z->inflight_reads);
+		zest_rc_fill_done(zi, way, slot, false);
+		return;
+	}
+
+	way->fill_zi   = zi;
+	way->fill_zone = z;
+	way->fill_slot = slot;
+
+	//REQ_RAHEAD marks it droppable; IDLE ioprio keeps prefetch behind fault
+	//reads in mq-deadline's priority classes. GFP_NOIO: may run in fault
+	//context (vra_inline) under memory pressure.
+	bio = bio_alloc(zi->bdev, 1, REQ_OP_READ | REQ_RAHEAD, GFP_NOIO);
+	bio->bi_iter.bi_sector = sector;
+	bio->bi_ioprio = IOPRIO_PRIO_VALUE(IOPRIO_CLASS_IDLE, 0);
+	bio->bi_end_io = zest_vra_end_fill;
+	bio->bi_private = way;
+	__bio_add_page(bio, way->page, PAGE_SIZE, 0);
+	//zest-vra (M3.5): inflight-cap accounting. Nothing can fail between the
+	//inc and submit_bio, so the inc/dec (endio) pair is exact. The cap check
+	//itself lives at the callers (worker waits / inline drops): a transient
+	//overshoot of one fill per concurrent submitter is fine, the cap bounds
+	//queue depth, it is not an invariant.
+	atomic_inc(&zi->ra_inflight);
+	submit_bio(bio);
+	atomic64_inc(&zi->ra_submitted);
+}
+
+//zest-vra (M3.5): true while fills-in-flight is at/over the cap (0 = no cap).
+//The worker's wait condition also breaks on teardown.
+static bool zest_vra_at_cap(struct zest_info *zi)
+{
+	unsigned int lim = READ_ONCE(zest_vra_inflight);
+
+	return lim && atomic_read(&zi->ra_inflight) >= lim;
+}
+
+//zest-vra: the prefetch worker. Publishes finished fills first (freeing busy
+//ways for the claims below), then drains the request fifo, submitting one
+//async bio per slot -- by the end of a pass, up to a fifo's worth of fills
+//are in flight, naturally capped by the number of free cache ways (claim
+//returns NULL when a set is exhausted). Runs on ra_wq (WQ_UNBOUND|WQ_SYSFS):
+//pin it via /sys/devices/virtual/workqueue/zest_vra/cpumask (big cores).
+static void zest_vra_publish_done(struct zest_info *zi)
+{
+	struct llist_node *node;
+
+	node = llist_del_all(&zi->ra_done);
+	while (node) {
+		struct zest_rc_way *way =
+			llist_entry(node, struct zest_rc_way, fill_node);
+
+		//Advance BEFORE fill_done: once published, the way (and its
+		//fill_node) can be re-claimed and re-queued concurrently by an
+		//inline submitter; the detached chain itself is private.
+		node = node->next;
+		zest_rc_fill_done(zi, way, way->fill_slot, way->fill_ok);
+	}
+}
+
+static void zest_vra_work(struct work_struct *work)
+{
+	struct zest_info *zi = container_of(work, struct zest_info, ra_work);
+	struct blk_plug plug;
+	u32 slot;
+
+	zest_vra_publish_done(zi);
+
+	//zest-vra: plug the batch like the kernel's swap readahead does --
+	//fills whose sectors happen to be adjacent (VMA neighbors that swapped
+	//out back-to-back through the write buffer) merge into one request in
+	//the plug list, and the rest still dispatch as one flush instead of a
+	//submit_bio each. Merging happens at the REQUEST level: our bio stats
+	//stay 4K, watch the device's average request size instead.
+	blk_start_plug(&plug);
+	while (kfifo_out_spinlocked(&zi->ra_fifo, &slot, 1,
+				    &zi->ra_fifo_lock)) {
+		//zest-vra (M3.5): inflight cap -- park until an endio frees a
+		//slot (or teardown). Requests wait HERE, in the fifo, not at the
+		//device: a demand read then never queues behind more than
+		//vra_inflight fills. While parked, completions pile up on
+		//ra_done (their re-queued work runs after this pass), so
+		//publish them ourselves after every wait -- a fill's data must
+		//become visible (and its way claimable) the moment it lands,
+		//not when the fifo drains. Interruptible: kworkers get no
+		//signals, and this must not trip the hung-task detector while
+		//parked across a long demand storm.
+		if (zest_vra_at_cap(zi)) {
+			//Dispatch the plugged requests BEFORE parking: the
+			//endios this wait needs cannot arrive while their
+			//requests sit unflushed in our own plug. (schedule()
+			//would flush it anyway, but only after the first
+			//wait_event pass falls asleep -- be explicit.)
+			blk_finish_plug(&plug);
+			wait_event_interruptible(zi->ra_throttle_wq,
+						 READ_ONCE(zi->ra_dead) ||
+						 !zest_vra_at_cap(zi));
+			zest_vra_publish_done(zi);
+			blk_start_plug(&plug);
+		}
+		zest_vra_fill_one(zi, slot);
+	}
+	blk_finish_plug(&plug);
+}
+
+//zest-vra: slow path of zest_swap_ra_win() (mm/swap_state.c fault hook).
+//Returns the window to collect, or 0 = ZEST does not own readahead for this
+//swapfile (engine off / cache off / not our swapfile) -> the kernel's own
+//readahead applies. Lockless; same lifetime rules as zest_swap_readpage
+//(faults on the swapfile cannot outlive release).
+unsigned int __zest_swap_ra_win(struct swap_info_struct *sis)
+{
+	struct zest_info *zi = zest_current(sis);
+	unsigned int win = READ_ONCE(zest_vra_win);
+
+	if (!zi || !win || !zi->ra_wq || READ_ONCE(zi->ra_dead))
+		return 0;
+	if (!READ_ONCE(zi->rc.ready) || !atomic_read(&zest_rc_enable))
+		return 0;
+	return min_t(unsigned int, win, ZEST_SWAP_RA_WIN_MAX);
+}
+
+//zest-vra: slow path of zest_swap_ra_submit() -- the fault path hands over
+//the collected VMA-neighbor slots. Default: enqueue + kick the worker (the
+//fault pays one spinlocked memcpy into the fifo). vra_inline: translate and
+//submit right here (bios are still async; A/B knob for worker wakeup
+//latency). A full fifo DROPS the excess -- prefetch is a hint, never a
+//backlog the fault path must wait on.
+void __zest_swap_ra_submit(struct swap_info_struct *sis, const u32 *slots,
+			   unsigned int n)
+{
+	struct zest_info *zi = zest_current(sis);
+	unsigned int i, q;
+
+	if (!zi || !zi->ra_wq || READ_ONCE(zi->ra_dead))
+		return;
+	atomic64_add(n, &zi->ra_enq);
+
+	if (atomic_read(&zest_vra_inline)) {
+		struct blk_plug plug;
+
+		//zest-vra: batch the window's fills in a plug (adjacent-sector
+		//ones merge, the rest dispatch as one flush). Nesting is safe:
+		//if the fault path already runs under a plug this is a no-op
+		//and the outer plug does the batching.
+		blk_start_plug(&plug);
+		for (i = 0; i < n; i++) {
+			//zest-vra (M3.5): at the inflight cap the fault path
+			//DROPS the rest of the window (a hint is never worth
+			//sleeping in a fault for) -- only the worker mode gets
+			//the wait-don't-drop behavior.
+			if (zest_vra_at_cap(zi)) {
+				atomic64_add(n - i, &zi->ra_throttled);
+				break;
+			}
+			zest_vra_fill_one(zi, slots[i]);
+		}
+		blk_finish_plug(&plug);
+		return;
+	}
+
+	q = kfifo_in_spinlocked(&zi->ra_fifo, slots, n, &zi->ra_fifo_lock);
+	if (q < n)
+		atomic64_add(n - q, &zi->ra_fifo_full);
+	if (q)
+		queue_work(zi->ra_wq, &zi->ra_work);
+}
+
+//zest-vra (M3): hit-attribution probe for the adaptive window -- the analog
+//of the kernel finding a PG_readahead page in the swap cache. True iff @slot
+//is in the read cache: live (the upcoming lookup will hit) OR busy/in-flight
+//(prediction was right, the fill is merely late; lateness is judged by
+//rc_late_fills, not by starving the window). Key-only scan, no copy, no flag
+//writes -- the real lookup right behind us does the bookkeeping. Read side of
+//rc->lock like the lookup (fault context, never irq).
+bool __zest_swap_ra_peek(struct swap_info_struct *sis, u32 slot)
+{
+	struct zest_info *zi = zest_current(sis);
+	struct zest_rcache *rc;
+	struct zest_rc_way *w;
+	unsigned int i;
+	bool hit = false;
+
+	if (!zi)
+		return false;
+	rc = &zi->rc;
+	if (!READ_ONCE(rc->ready) || !atomic_read(&zest_rc_enable))
+		return false;
+
+	read_lock(&rc->lock);
+	w = zest_rc_set(rc, slot);
+	for (i = 0; i < ZEST_RC_WAYS; i++, w++) {
+		if (READ_ONCE(w->slot) == slot) {
+			hit = true;
+			break;
+		}
+	}
+	read_unlock(&rc->lock);
+
+	if (hit)
+		atomic64_inc(&zi->ra_peek_hits);
+	return hit;
+}
+
+//zest-vra (M3): per-round window-size histogram (ilog2 buckets, see
+//ZEST_VRA_WIN_BUCKETS). One call per readahead round -- i.e. per peek-MISS
+//fault, where the adaptive policy actually picked a window.
+void __zest_swap_ra_stat_win(struct swap_info_struct *sis, unsigned int win)
+{
+	struct zest_info *zi = zest_current(sis);
+
+	if (!zi || !win)
+		return;
+	atomic64_inc(&zi->ra_win_hist[min_t(unsigned int, ilog2(win),
+					    ZEST_VRA_WIN_BUCKETS - 1)]);
+}
+
+//zest-wbuf: pop a fresh zone for the flush write frontier. Unlike the old
+//swap-out path this BLOCKS until a zone is available and never rejects: the
+//pages being flushed were already acked (folio_end_writeback) at memcpy time,
+//so there is nothing to re-dirty -- the data lives only in the buffer. The
+//pressure valve is upstream: a writer that finds no FREE buffer rejects.
+//Honors ZEST_GC_RESERVE (leave headroom for GC's own frontier) and kicks GC.
+//Returns NULL only if the FATAL latch trips. Runs in the (process-context)
+//flush worker, so it may sleep.
+static struct zest_zone *zest_wbuf_pop_zone(struct zest_info *zi)
+{
+	struct zest_zone *z;
+
+	for (;;) {
+		if (unlikely(atomic_read(&zi->fatal)))
+			return NULL;
+
+		spin_lock(&zi->freelist_lock);
+		if (atomic_read(&zi->nr_free_zones) > ZEST_GC_RESERVE) {
+			z = list_first_entry(&zi->freelist, struct zest_zone,
+					     free_node);
+			list_del_init(&z->free_node);
+			atomic_dec(&zi->nr_free_zones);
+			spin_unlock(&zi->freelist_lock);
+			return z;
+		}
+		spin_unlock(&zi->freelist_lock);
+
+		//No room: kick GC and wait (re-kicking every 200ms so a genuinely
+		//full device self-resolves once mm pressure frees swap slots and GC
+		//can reclaim a zone). The ordered wbuf_wq is single-threaded, so a
+		//stall here naturally backpressures: buffers stay FLUSHING, writers
+		//find no FREE buffer and reject -> mm reclaims/kills -> slots free.
+		zest_gc_kick(zi);
+		pr_warn_ratelimited("zest-wbuf: flush waiting for a free zone (free=%d, gc=%s)\n",
+				    atomic_read(&zi->nr_free_zones),
+				    zi->gc_thread ? "on" : "off");
+		wait_event_timeout(zi->gc_done_wait,
+			atomic_read(&zi->nr_free_zones) > ZEST_GC_RESERVE ||
+			atomic_read(&zi->fatal), HZ / 5);
+	}
+}
+
+//zest-wbuf: flush worker. One per sealed buffer, run by the ORDERED wbuf_wq so
+//flushes (and thus device submits) stay in write-pointer order -- this replaces
+//the io_lock that used to serialize the write path. Steps:
+//  1. wait for every claimed page's memcpy to finish (lockless ->copied count);
+//  2. lay the n pages out on the device, splitting across at most one zone
+//     boundary (buffer cap <= zone size) into <=2 segments -- no padding: the
+//     first segment fills cur_zone to its exact end (-> FULL, open-zone resource
+//     released) and the second continues in a fresh zone;
+//  3. submit the segment bio(s) (contiguous pages coalesce into big requests)
+//     and wait for completion;
+//  4. commit each page under map_lock IFF l2p[slot] still == BUF|gidx (freed or
+//     re-staged in-flight => dead device block, left unmapped for GC); the
+//     inflight_writes refs are dropped only AFTER commit so GC's victim drain on
+//     a now-FULL first segment can't reset it before its rmap is published;
+//  5. recycle the buffer (FREE) and wake writers waiting for one.
+static void zest_wbuf_flush_work(struct work_struct *w)
+{
+	struct zest_wbuf *wb = container_of(w, struct zest_wbuf, flush_work);
+	struct zest_info *zi = wb->zi;
+	unsigned int n = wb->sealed_fill;
+	struct {
+		struct zest_zone *z;
+		sector_t	base;	/* device sector of the segment's first page */
+		unsigned int	first;	/* local buffer page index of segment start */
+		unsigned int	cnt;	/* pages in this segment */
+	} seg[2];
+	unsigned int nseg = 0, placed = 0;
+	struct zest_wbuf_io io;
+	struct bio *bio = NULL;
+	struct zest_zone *z;
+	unsigned int s, k;
+	//zest-ra: VMA placement reorder state. perm[pos] = staging index written to
+	//device position pos (NULL == identity = no reorder). Two modes (wbuf_sort):
+	//  1 (bounce): gather-copy staging into the contiguous bounce in perm order
+	//    and build the bio over it -- one extra 4M memcpy per flush, but the
+	//    device write keeps coalescing into big contiguous bios.
+	//  2 (zero-copy): no copy -- the bio's bvecs reference the staging pages in
+	//    perm order directly. bvecs still coalesce wherever perm is consecutive
+	//    (staging is physically contiguous), i.e. wherever VMA order agrees with
+	//    arrival order; elsewhere the bio fragments (BIO_MAX_VECS caps a fully
+	//    scattered flush at 1M per bio) -- avg_bio_kb is the judge.
+	//src = the buffer the device bio reads from (bounce in mode 1).
+	bool reorder = false;
+	unsigned int sort_mode = 0;
+	u32 *perm = NULL;
+	struct zest_wbuf *src = wb;
+
+	if (unlikely(!n))
+		goto recycle;
+
+	//(1) wait for all in-flight memcpys to land. Producers add to ->copied
+	//after their memcpy; seal snapshotted ->fill into n under buf_lock, so all
+	//n claims are accounted and this terminates. smp_rmb pairs with the
+	//producer's smp_wmb so the buffer data is visible before we read it.
+	while (atomic_read(&wb->copied) < n)
+		cpu_relax();
+	smp_rmb();
+
+	if (unlikely(atomic_read(&zi->fatal)))
+		goto recycle;
+
+	//zest-ra: build the VMA-sorted permutation for this flush. Needs the switch
+	//on (for vkey capture), captured keys (wb->vkey), a sort mode, and -- for
+	//mode 1 only -- the contiguous bounce to write from. vkey/vkey_persist/
+	//bounce are freed only at swapoff (never at runtime disable), so these
+	//pointers are read locklessly here without UAF. perm stays NULL (=
+	//identity, arrival order) if any prerequisite is missing or perm alloc fails.
+	if (atomic_read(&zest_ra_dbg)) {
+		//Pair with the smp_wmb() before atomic_set() in zest_ra_debug_set:
+		//once we observe the switch on, the placement arrays (vkey/bounce,
+		//incl. bounce->pages[]) are fully built. (The swapon path is already
+		//ordered by the RCU singleton publish.) Never freed until swapoff, so
+		//these pointers are then stable for the rest of this flush.
+		smp_rmb();
+		sort_mode = READ_ONCE(zest_wbuf_sort);
+		reorder = wb->vkey && sort_mode &&
+			  (sort_mode != 1 || zi->bounce.pages);
+	}
+	if (reorder) {
+		perm = kmalloc_array(n, sizeof(*perm), GFP_NOIO);
+		if (perm) {
+			for (k = 0; k < n; k++)
+				perm[k] = k;
+			sort_r(perm, n, sizeof(*perm), zest_dbg_cmp_vma, NULL, wb);
+		} else {
+			reorder = false;	//OOM -> arrival order (correct, no gain)
+		}
+	}
+
+	//zest-ra: segment-count telemetry (switch-gated; reads stable wb->vkey).
+	if (atomic_read(&zest_ra_dbg) && wb->vkey)
+		zest_dbg_seg_stats(zi, wb, n);
+
+	//(2) layout. cur_zone is advanced here; the single-threaded wbuf_wq makes
+	//this worker the sole host zone-allocator, so no lock guards cur_zone /
+	//wp_blocks beyond freelist_lock on the pop.
+	z = &zi->zones[zi->cur_zone];
+	if (z->wp_blocks >= z->nr_blocks) {	//prev flush filled it exactly
+		z = zest_wbuf_pop_zone(zi);
+		if (!z)
+			goto recycle;
+		zi->cur_zone = z - zi->zones;
+	}
+	{
+		unsigned int room = z->nr_blocks - z->wp_blocks;
+		unsigned int c0 = min(n, room);
+
+		seg[nseg].z = z;
+		seg[nseg].base = z->start_sector +
+				 ((sector_t)z->wp_blocks << (PAGE_SHIFT - 9));
+		seg[nseg].first = 0;
+		seg[nseg].cnt = c0;
+		z->wp_blocks += c0;
+		nseg++;
+		placed = c0;
+	}
+	if (placed < n) {
+		//straddle: first zone filled to its end (FULL, no pad); continue in a
+		//fresh zone. cap <= zone size => exactly one extra segment.
+		unsigned int c1 = n - placed;
+
+		z = zest_wbuf_pop_zone(zi);
+		if (!z)
+			goto recycle;	//fatal: drop the tail (already acked; the
+					//swapfile rejects everything once latched)
+		zi->cur_zone = z - zi->zones;
+		seg[nseg].z = z;
+		seg[nseg].base = z->start_sector;	//fresh zone -> wp 0
+		seg[nseg].first = placed;
+		seg[nseg].cnt = c1;
+		z->wp_blocks += c1;
+		nseg++;
+		placed = n;
+	}
+
+	//zest-ra (mode 1): gather-copy the staged pages into the CONTIGUOUS bounce
+	//in VMA-sorted order, so the device bio (built over bounce below) keeps
+	//coalescing into big requests. staging is only READ here (never mutated) so
+	//concurrent swap-in still serves correctly from staging by gidx; the bounce
+	//is write-only and never read by swap-in. After this, device position p
+	//holds the data of staging slot perm[p], so src=bounce is indexed by
+	//position directly. Mode 2 skips the copy: the submit loop below indexes
+	//staging through perm instead (device position p still gets the data of
+	//staging slot perm[p] -- same layout, no copy, fragmented bvecs).
+	if (reorder && sort_mode == 1) {
+		unsigned int p;
+
+		for (p = 0; p < n; p++)
+			memcpy(page_address(zi->bounce.pages[p]),
+			       page_address(wb->pages[perm[p]]), PAGE_SIZE);
+		src = &zi->bounce;
+	}
+
+	//(3) submit. Bias completion idiom (pending=1 + 1 per bio). Each segment's
+	//zone takes one inflight_writes ref, dropped after commit (step 4).
+	atomic_set(&io.pending, 1);
+	io.status = 0;
+	init_completion(&io.done);
+
+	for (s = 0; s < nseg; s++) {
+		atomic_inc(&seg[s].z->inflight_writes);
+		bio = NULL;
+		for (k = 0; k < seg[s].cnt; k++) {
+			//Device position -> source page. Mode 2 (src == wb with a
+			//perm) reads staging in permuted order; mode 1 reads the
+			//bounce (already permuted by the copy) and mode 0 reads
+			//staging, both in position order.
+			unsigned int pos = seg[s].first + k;
+			struct page *pg = src->pages[(perm && src == wb) ?
+						     perm[pos] : pos];
+
+			if (bio && !bio_add_page(bio, pg, PAGE_SIZE, 0)) {
+				atomic64_add(bio->bi_iter.bi_size, &zi->host_wb_bytes);
+				atomic64_inc(&zi->bio_count);
+				atomic_inc(&io.pending);
+				submit_bio(bio);
+				bio = NULL;
+			}
+			if (!bio) {
+				bio = bio_alloc(zi->bdev,
+					min(seg[s].cnt - k,
+					    (unsigned int)BIO_MAX_VECS),
+					REQ_OP_WRITE, GFP_NOIO);
+				bio->bi_iter.bi_sector = seg[s].base +
+					((sector_t)k << (PAGE_SHIFT - 9));
+				bio->bi_private = &io;
+				bio->bi_end_io = zest_wbuf_bio_endio;
+				__bio_add_page(bio, pg, PAGE_SIZE, 0);
+			}
+		}
+		if (bio) {
+			atomic64_add(bio->bi_iter.bi_size, &zi->host_wb_bytes);
+			atomic64_inc(&zi->bio_count);
+			atomic_inc(&io.pending);
+			submit_bio(bio);
+		}
+	}
+	if (atomic_dec_and_test(&io.pending))
+		complete(&io.done);
+	wait_for_completion(&io.done);
+
+	//(4) commit. Device writes are durable now; publish l2p BUF->sector for
+	//pages whose slot still points here. inflight_writes held until after this.
+	//zest-ra invariant: sec / rmap-block come from the DEVICE position
+	//(seg.first+k); slot / want-gidx / vkey_persist index all come from the
+	//STAGING index li = perm[pos] (== pos when not reordering). Mixing the two
+	//would point l2p[slot] at another slot's data.
+	spin_lock(&zi->map_lock);
+	for (s = 0; s < nseg; s++) {
+		for (k = 0; k < seg[s].cnt; k++) {
+			unsigned int pos = seg[s].first + k;
+			unsigned int li = perm ? perm[pos] : pos;
+			u32 slot = wb->bslot[li];
+			sector_t want = zest_l2p_mk_buf(wb->gbase + li);
+			sector_t sec = seg[s].base +
+				       ((sector_t)k << (PAGE_SHIFT - 9));
+
+			if (slot == ZEST_INVALID_SLOT)
+				continue;
+			if (READ_ONCE(zi->l2p[slot]) != want)
+				continue;	//freed / re-staged in-flight -> dead
+			seg[s].z->rmap[zest_blk_in_zone(seg[s].z, sec)] = slot;
+			atomic_inc(&seg[s].z->valid_blocks);
+			WRITE_ONCE(zi->l2p[slot], sec);
+			//zest-ra: persist the VMA key IN LOCKSTEP with l2p (only on a
+			//real commit) so GC can re-sort this slot later. Guarded exactly
+			//like l2p so a freed/re-staged-in-flight slot is never stamped.
+			if (zi->vkey_persist && wb->vkey)
+				WRITE_ONCE(zi->vkey_persist[slot],
+					   zest_ra_pack_key(wb->vkey[li].av,
+							    wb->vkey[li].idx));
+		}
+	}
+	spin_unlock(&zi->map_lock);
+
+	for (s = 0; s < nseg; s++)
+		atomic_dec(&seg[s].z->inflight_writes);
+
+	if (io.status)
+		atomic64_inc(&zi->nr_write_rejects);
+
+	//zest-wbuf: flush-size telemetry. avg = flush_pages/flush_count -> if it
+	//sits well below wbuf_cap, flushes are dribbling out small (bad bandwidth);
+	//if it's ~= wbuf_cap, flushes are full-size and any remaining bandwidth gap
+	//is a device/zoned-QD issue, not a small-bio one.
+	atomic64_inc(&zi->flush_count);
+	atomic64_add(n, &zi->flush_pages);
+
+	pr_debug("zest-wbuf: flushed %u pages in %u seg(s) cur_zone=%u\n",
+		 n, nseg, zi->cur_zone);
+
+recycle:
+	kfree(perm);	//zest-ra: NULL on the early-goto paths -> kfree(NULL) ok
+	//(5) recycle and wake any writer blocked on a free buffer.
+	spin_lock(&zi->buf_lock);
+	wb->fill = 0;
+	wb->sealed_fill = 0;
+	atomic_set(&wb->copied, 0);
+	wb->state = ZEST_WBUF_FREE;
+	spin_unlock(&zi->buf_lock);
+	wake_up_all(&zi->wbuf_free_wait);
+
+	//A flush just consumed free zone(s); nudge GC to refill the freelist.
+	zest_gc_kick(zi);
+}
+
+//zest-gc: free the preallocated GC migration buffer. Safe on partially-built
+//or NULL buffers (init error path and swapoff both call it).
+static void zest_gc_buf_free(struct zest_info *zi)
+{
+	unsigned int e;
+
+	//zest-ra: sort scratch.
+	kvfree(zi->gc_sort);
+	zi->gc_sort = NULL;
+
+	if (!zi->gc_buf)
+		return;
+	//zest-ra: free the page backing store as a unit on the contiguous path,
+	//page-by-page on the fragmented fallback.
+	if (zi->gc_buf_contig) {
+		if (zi->gc_buf_base)
+			__free_pages(zi->gc_buf_base, zi->gc_buf_order);
+		zi->gc_buf_base = NULL;
+		zi->gc_buf_contig = false;
+	} else {
+		for (e = 0; e < zi->gc_buf_nr; e++)
+			if (zi->gc_buf[e].page)
+				__free_page(zi->gc_buf[e].page);
+	}
+	kvfree(zi->gc_buf);
+	zi->gc_buf = NULL;
+	zi->gc_buf_nr = 0;
+}
+
+/* -------------------------------------------------------------- */
+/* zest3: init-time helpers                                       */
+/* -------------------------------------------------------------- */
+
+//zest3: sort comparator on start_sector ascending.
+static int zest3_zone_cmp(const void *a, const void *b)
+{
+	const struct zest_zone *za = a, *zb = b;
+
+	if (za->start_sector < zb->start_sector)
+		return -1;
+	if (za->start_sector > zb->start_sector)
+		return 1;
+	return 0;
+}
+
+//zest3: discover every physical zone the swapfile occupies.
+//
+//Each swap_extent.start_block is in PAGE-sized blocks. Convert to
+//bdev 512B sectors via << (PAGE_SHIFT - 9). An extent may span multiple
+//zones; round down to a zone boundary and step by zone_sectors.
+//Duplicates (two extents in the same zone) are collapsed by sort+dedup.
+//zest3: shared state for building zi->zones[] from both the swap extents and
+//the OP-region walk.
+struct zest3_zone_build {
+	struct zest_info	*zi;
+	struct zest_zone	*tmp;
+	unsigned int		cap;
+	unsigned int		n;
+	sector_t		zone_sectors;
+	unsigned int		blocks_per_zone;
+};
+
+//zest3: append every zone touched by [local_blk, local_blk+nr_pages) (device-
+//local F2FS blocks) into the build array. Rounds down to the zone boundary and
+//steps by zone_sectors; sort+dedup later collapses duplicates.
+static int zest3_add_extent_zones(struct zest3_zone_build *b,
+				  unsigned int local_blk, unsigned int nr_pages)
+{
+	sector_t s = (sector_t)local_blk << (PAGE_SHIFT - 9);
+	sector_t e = s + ((sector_t)nr_pages << (PAGE_SHIFT - 9));
+	sector_t z = (s / b->zone_sectors) * b->zone_sectors;
+
+	for (; z < e; z += b->zone_sectors) {
+		if (b->n >= b->cap) {
+			pr_alert("zest: zone array overflow (cap=%u)\n",
+				  b->cap);
+			return -ENOSPC;
+		}
+		b->tmp[b->n].start_sector = z;
+		b->tmp[b->n].nr_blocks    = b->blocks_per_zone;
+		b->tmp[b->n].wp_blocks    = 0;
+		atomic_set(&b->tmp[b->n].valid_blocks, 0);
+		b->n++;
+	}
+	return 0;
+}
+
+//zest3: f2fs_zest_walk_op_extents() callback. pblk is a global F2FS block
+//address; convert to device-local then add its zones.
+static int zest3_op_extent_cb(unsigned int pblk, unsigned int len, void *data)
+{
+	struct zest3_zone_build *b = data;
+	unsigned int local_blk =
+		f2fs_zest_blkaddr_to_dev_local(b->zi->sbi, pblk);
+
+	if (local_blk == (unsigned int)-1) {
+		pr_alert("zest: OP pblk %u not on zoned dev\n", pblk);
+		return -EIO;
+	}
+	return zest3_add_extent_zones(b, local_blk, len);
+}
+
+static int zest3_discover_zones(struct zest_info *zi)
+{
+	struct swap_info_struct *sis = zi->sis;
+	struct f2fs_sb_info *sbi = zi->sbi;
+	struct inode *inode = sis->swap_file->f_mapping->host;
+	sector_t zone_sectors = bdev_zone_sectors(zi->bdev);
+	struct zest3_zone_build b;
+	unsigned int ext_cnt = 0, i, w;
+	struct rb_node *rb;
+	int ret;
+
+	if (!zone_sectors) {
+		pr_alert("zest: bdev_zone_sectors=0 (not zoned?)\n");
+		return -EINVAL;
+	}
+
+	b.zi = zi;
+	b.zone_sectors = zone_sectors;
+	b.blocks_per_zone = zone_sectors >> (PAGE_SHIFT - 9);
+	b.n = 0;
+
+	//cap: worst-case distinct zones across swap + OP regions, plus one
+	//boundary zone per swap extent, plus slack. Tiny in practice
+	//(GiB-sized zones), so be generous and safe.
+	for (rb = rb_first(&sis->swap_extent_root); rb; rb = rb_next(rb))
+		ext_cnt++;
+	b.cap = (sis->max + zi->op_nr_blocks) / b.blocks_per_zone
+		+ ext_cnt + 16;
+
+	b.tmp = kvmalloc_array(b.cap, sizeof(*b.tmp), GFP_KERNEL);
+	if (!b.tmp)
+		return -ENOMEM;
+
+	pr_notice("zest: discovering zone_sectors=%llu blocks_per_zone=%u swap_max=%u op_blocks=%u cap=%u\n",
+		  (unsigned long long)zone_sectors, b.blocks_per_zone,
+		  (unsigned int)sis->max, zi->op_nr_blocks, b.cap);
+
+	//swap-visible zones, from the swap extent rbtree.
+	for (rb = rb_first(&sis->swap_extent_root); rb; rb = rb_next(rb)) {
+		struct swap_extent *se =
+			rb_entry(rb, struct swap_extent, rb_node);
+		unsigned int local_blk =
+			f2fs_zest_blkaddr_to_dev_local(sbi, se->start_block);
+
+		if (local_blk == (unsigned int)-1) {
+			kvfree(b.tmp);
+			pr_alert("zest: block %llu not on zoned dev\n",
+				  (unsigned long long)se->start_block);
+			return -EIO;
+		}
+		ret = zest3_add_extent_zones(&b, local_blk, se->nr_pages);
+		if (ret) {
+			kvfree(b.tmp);
+			return ret;
+		}
+	}
+	pr_notice("zest: swap-region added %u zone entries (pre-dedup)\n", b.n);
+
+	//OP zones, from the reserved tail of the swapfile inode.
+	if (zi->op_nr_blocks) {
+		unsigned int before = b.n;
+
+		ret = f2fs_zest_walk_op_extents(inode, zi->op_start_lblk,
+						zi->op_start_lblk +
+						zi->op_nr_blocks,
+						zest3_op_extent_cb, &b);
+		if (ret) {
+			kvfree(b.tmp);
+			pr_alert("zest: OP extent walk failed: %d\n", ret);
+			return ret;
+		}
+		pr_notice("zest: OP-region added %u zone entries (pre-dedup)\n",
+			  b.n - before);
+	}
+
+	sort(b.tmp, b.n, sizeof(*b.tmp), zest3_zone_cmp, NULL);
+
+	w = 0;
+	for (i = 0; i < b.n; i++) {
+		if (w == 0 ||
+		    b.tmp[w - 1].start_sector != b.tmp[i].start_sector)
+			b.tmp[w++] = b.tmp[i];
+	}
+
+	zi->zones    = b.tmp;
+	zi->nr_zones = w;
+	pr_notice("zest: %u zones discovered (deduped from %u), %u blocks/zone\n",
+		  w, b.n, b.blocks_per_zone);
+	return 0;
+}
+
+//zest3: capture the mkswap header (slot 0) into a kmalloc'd page.
+//
+//No flash read happens here. sys_swapon called read_mapping_page(mapping,
+//0, swap_file) just before our swap_activate hook (mm/swapfile.c:3474),
+//so slot 0 is guaranteed to be in the F2FS page cache and still pinned
+//by sys_swapon's local kmap. Calling read_mapping_page again is a hash
+//lookup that returns that same cached page; we memcpy it out and drop
+//our ref. No vfs_read iter, no flash trip.
+//
+//Why we buffer instead of intercepting mkswap's write: mkswap runs
+//BEFORE swapon and writes via the F2FS data path (in-place under PIN),
+//not via swap_writepage -- our swap I/O hook can't see it. Snapshotting
+//here lets step (3) reset every zone safely, including the one that
+//physically holds the header block. Future slot-0 reads come from
+//zi->mkswap_header (see zest_swap_readpage).
+static int zest3_capture_mkswap_header(struct zest_info *zi)
+{
+	struct file *file = zi->sis->swap_file;
+	struct address_space *mapping;
+	struct page *page;
+	void *kaddr, *buf;
+
+	if (!file) {
+		pr_alert("zest: capture_mkswap: sis->swap_file is NULL\n");
+		return -EINVAL;
+	}
+	mapping = file->f_mapping;
+
+	buf = kmalloc(PAGE_SIZE, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	page = read_mapping_page(mapping, 0, file);
+	if (IS_ERR(page)) {
+		int err = PTR_ERR(page);
+
+		kfree(buf);
+		pr_alert("zest: read_mapping_page slot 0 failed: %d\n", err);
+		return err;
+	}
+
+	kaddr = kmap_local_page(page);
+	memcpy(buf, kaddr, PAGE_SIZE);
+	kunmap_local(kaddr);
+	put_page(page);
+
+	zi->mkswap_header = buf;
+	pr_notice("zest: mkswap header captured from page-cache (no flash read)\n");
+	return 0;
+}
+
+//zest3: blkdev_report_zones callback: copy the reported blk_zone into
+//caller-supplied storage. Returns 0 so the report walk completes.
+static int zest3_report1_cb(struct blk_zone *zone, unsigned int idx,
+			    void *data)
+{
+	struct blk_zone *dst = data;
+
+	*dst = *zone;
+	return 0;
+}
+
+//zest3: walk zi->zones[] and reset every zone that isn't already EMPTY.
+//
+//Why per-zone reporting (nr=1) instead of one big range: zones[] may
+//be non-contiguous (swapfile fragmented across more than one zone group,
+//or sandwiched between other f2fs sections). Asking for N zones at
+//start_sector[0] would return the hardware's next N zones, not
+//necessarily the ones we own.
+//
+//EMPTY zones are skipped: they're already at wp=0 from the device's
+//perspective, so REQ_OP_ZONE_RESET would be a no-op but still costs a
+//round-trip. OPEN/CLOSED/FULL all need a reset so the ZEST allocator
+//can start from wp_blocks=0 with a clean device-side write pointer.
+//
+//blkdev_zone_mgmt is synchronous (submit_bio_wait inside) and safe from
+//swapon syscall context.
+static int zest3_reset_nonempty_zones(struct zest_info *zi)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < zi->nr_zones; i++) {
+		struct zest_zone *z = &zi->zones[i];
+		struct blk_zone hw;
+
+		ret = blkdev_report_zones(zi->bdev, z->start_sector, 1,
+					  zest3_report1_cb, &hw);
+		if (ret < 0) {
+			pr_alert("zest: report zone %u failed: %d\n", i,
+				  ret);
+			return ret;
+		}
+		if (ret == 0 || hw.start != z->start_sector) {
+			pr_alert("zest: report zone %u start mismatch (got=%llu expect=%llu)\n",
+				  i, (unsigned long long)hw.start,
+				  (unsigned long long)z->start_sector);
+			return -EIO;
+		}
+
+		if (hw.cond == BLK_ZONE_COND_EMPTY) {
+			pr_notice("zest: zone %u zid %llu already EMPTY, skip reset (start=%llu, len=%llu)\n",
+				  i, (unsigned long long)z->start_sector/2162688, (unsigned long long)z->start_sector, (unsigned long long)z->nr_blocks << (PAGE_SHIFT - 9));
+			continue;
+		}
+
+		//zest-wbuf: reset zone 0 too (previously special-cased to keep the
+		//mkswap header's on-device write pointer). The header is already
+		//captured to zi->mkswap_header (slot-0 reads come from RAM) AND
+		//sys_swapon validated it from the file before this hook ran, so the
+		//on-device copy is no longer needed this session. Resetting it makes
+		//EVERY zone start at wp=0, so a full-buffer flush is zone-aligned and
+		//the <=2-bio split only ever triggers at a true zone tail. (Re-swapon
+		//re-runs mkswap, so wiping the signature here is fine.)
+		ret = blkdev_zone_mgmt(zi->bdev, REQ_OP_ZONE_RESET, z->start_sector, hw.len, GFP_NOFS);
+		if (ret) {
+			pr_alert("zest: zone %u reset failed: %d\n", i,
+				  ret);
+			return ret;
+		}
+		pr_notice("zest: zone %u reset zid %llu start=%llu hw.len=%llu zoneelen=%llu cond %u -> EMPTY\n",
+			  i, (unsigned long long)z->start_sector/2162688,(unsigned long long)z->start_sector, (unsigned long long)hw.len, (unsigned long long)z->nr_blocks << (PAGE_SHIFT - 9), hw.cond);
+	}
+	return 0;
+}
+
+/* -------------------------------------------------------------- */
+/* Swap I/O entry points called from mm/page_io.c                 */
+/* (bodies defined after the lifecycle section)                   */
+/* -------------------------------------------------------------- */
+
+void zest_swap_writepage(struct page *page, struct writeback_control *wbc,
+			 struct swap_info_struct *sis);
+void zest_swap_readpage(struct folio *folio, struct swap_info_struct *sis);
+
+/* -------------------------------------------------------------- */
+/* Lifecycle entry points (still stubs)                           */
+/* -------------------------------------------------------------- */
+
+/*
+ * zest2: swapon takeover.
+ *
+ * Preconditions (caller-enforced by f2fs_swap_activate):
+ *   - sbi->zest_enable == 1
+ *   - check_swap_activate() returned successfully, so
+ *     sis->swap_extent_root is populated and sis->max/pages/highest_bit
+ *     have been set to the full (16 GiB) capacity.
+ *   - Every block on the swapfile has been migrated onto zoned sections
+ *     (because we inverted f2fs_valid_pinned_area under zest_enable).
+ *
+ * Steps:
+ *   1. Walk swap_extent rbtree; every extent must resolve to the same
+ *      zoned bdev. Multi-zoned-dev configurations are rejected for now.
+ *   2. Halve the swap subsystem's visible capacity.
+ *      sis->{max,pages,highest_bit} get shrunk. swap_map / cluster_info
+ *      backing memory was sized by mm/swapfile.c off the *local*
+ *      maxpages variable BEFORE this callback, so it's oversized (~16 MB
+ *      wasted for an 8 GiB OP half) but not corrupted. Allocator paths
+ *      never index past sis->highest_bit.
+ *   3. Re-seed percpu cluster_next cursors with random offsets within
+ *      the new [1, highest_bit] range. mm/swapfile.c seeded them off
+ *      the original highest_bit before our callback fired, so some
+ *      cursors may currently sit in the upper (now-invalid) half.
+ *      Scanner would self-correct via wrap, but re-seeding cleans up
+ *      first-scan behavior.
+ *   4. Publish the singleton: __zest_should_intercept(sis) now returns true.
+ *   5. Auto-enable the global static branch so the swap I/O hot path
+ *      in page_io.c is no longer patched out.
+ *
+ * Context: sys_swapon syscall context (sleepable). The inode_lock on
+ * the swap file is held by the caller -- this is a mutex (sleepable)
+ * and does not bar GFP_KERNEL: direct reclaim from a 40-byte slab
+ * allocation will not re-enter this swap inode. mm/swapfile.c's own
+ * swap_map allocation at swapon time uses GFP_KERNEL by the same
+ * reasoning.
+ */
+int zest_init_for_swapfile(struct f2fs_sb_info *sbi,
+			   struct swap_info_struct *sis)
+{
+	struct zest_info *zi;
+	struct rb_node *rb;
+	struct block_device *zbdev = NULL;
+	struct inode *swap_inode;
+	unsigned int swap_blocks;
+	int ret = 0;	//zest3
+
+	//zest: only one zest-enabled swapfile is allowed. Fast-fail here (racy
+	//read is fine); the authoritative claim+recheck is under the mutex at
+	//the publish point below.
+	if (rcu_access_pointer(zest_singleton)) {
+		pr_warn("zest: init: refusing 2nd zest swapfile; one already active (sis=%p)\n",
+			sis);
+		return -EBUSY;
+	}
+
+	/* Step 1: every extent on the same zoned bdev. */
+	for (rb = rb_first(&sis->swap_extent_root); rb; rb = rb_next(rb)) {
+		struct swap_extent *se =
+			rb_entry(rb, struct swap_extent, rb_node);
+		struct block_device *bd =
+			f2fs_zest_lookup_zoned_bdev(sbi, se->start_block);
+
+		if (!bd) {
+			pr_err("zest: init: extent start_block=%llu not on zoned dev\n",
+				(unsigned long long)se->start_block);
+			return -EINVAL;
+		}
+		if (!zbdev) {
+			zbdev = bd;
+		} else if (zbdev != bd) {
+			pr_err("zest: init: extents span multiple zoned devs, not supported\n");
+			return -EOPNOTSUPP;
+		}
+	}
+	if (!zbdev) {
+		pr_err("zest: init: empty swap_extent_root\n");
+		return -EINVAL;
+	}
+
+	zi = kzalloc(sizeof(*zi), GFP_KERNEL);
+	if (!zi)
+		return -ENOMEM;
+
+	spin_lock_init(&zi->freelist_lock);		//zest3
+	INIT_LIST_HEAD(&zi->freelist);			//zest3
+	//zest-gc: logical-map lock, GC frontier, freelist depth, GC thread.
+	spin_lock_init(&zi->map_lock);
+	zi->gc_cur_zone = ZEST_NO_ZONE;
+	zi->gc_buf = NULL;
+	zi->gc_buf_nr = 0;
+	atomic_set(&zi->nr_free_zones, 0);
+	init_waitqueue_head(&zi->gc_wait);
+	init_waitqueue_head(&zi->gc_done_wait);
+	zi->gc_thread = NULL;
+	atomic64_set(&zi->gc_runs, 0);
+	atomic64_set(&zi->gc_moved_blocks, 0);
+	atomic64_set(&zi->gc_zones_reclaimed, 0);
+	atomic64_set(&zi->gc_aborts_stale, 0);
+	zi->sbi  = sbi;
+	zi->sis  = sis;
+	zi->bdev = zbdev;
+
+	//zest-wbuf: write-staging buffer ring + its ordered flush workqueue. The
+	//ORDERED (single-threaded) wq serializes flushes so device submits stay in
+	//write-pointer order -- this is what replaces the old io_lock on the write
+	//path. WQ_MEM_RECLAIM because flushes run under memory pressure.
+	spin_lock_init(&zi->buf_lock);
+	init_waitqueue_head(&zi->wbuf_free_wait);
+	atomic64_set(&zi->flush_count, 0);
+	atomic64_set(&zi->flush_pages, 0);
+	atomic64_set(&zi->bio_count, 0);	//zest-ra: write telemetry
+	atomic64_set(&zi->host_wb_bytes, 0);
+	atomic64_set(&zi->gc_wb_bytes, 0);
+	//zest-ra: vkey lifetime mutex. The placement arrays are NOT allocated here
+	//-- only if/when the ra switch is on (checked after the ring is built).
+	mutex_init(&zi->dbg_mutex);
+	//zest-rc: read-cache lock. The cache arrays are allocated below (if the
+	//read_cache switch is on), after nr_slots/zones are set up.
+	rwlock_init(&zi->rc.lock);
+	zi->wbuf_wq = alloc_ordered_workqueue("zest_wbuf",
+					      WQ_MEM_RECLAIM | WQ_HIGHPRI);
+	if (!zi->wbuf_wq) {
+		ret = -ENOMEM;
+		goto err;
+	}
+	ret = zest_wbuf_pool_alloc(zi);
+	if (ret) {
+		pr_alert("zest-wbuf: buffer pool alloc failed: %d\n", ret);
+		goto err;
+	}
+	{
+		unsigned int bi;
+
+		for (bi = 0; bi < ZEST_WBUF_COUNT; bi++) {
+			struct zest_wbuf *wb = &zi->wbufs[bi];
+
+			wb->zi = zi;
+			wb->gbase = bi * zi->wbuf_cap;
+			wb->fill = 0;
+			wb->sealed_fill = 0;
+			atomic_set(&wb->copied, 0);
+			//Buffer 0 is the initial FILLING cur; the rest start FREE.
+			wb->state = (bi == 0) ? ZEST_WBUF_FILLING : ZEST_WBUF_FREE;
+			INIT_WORK(&wb->flush_work, zest_wbuf_flush_work);
+		}
+		zi->wbuf_cur = 0;
+		pr_notice("zest-wbuf: ring ready: %u buffers, cap=%u pages, gidx<%u\n",
+			  ZEST_WBUF_COUNT, zi->wbuf_cap,
+			  ZEST_WBUF_COUNT * zi->wbuf_cap);
+	}
+
+	//zest-vra: prefetch engine. Best-effort: on alloc failure ra_wq stays
+	//NULL and the engine is simply off (faults fall back to kernel
+	//readahead) -- never abort swapon for it. Invariant: ra_wq != NULL
+	//<=> ra_fifo allocated (release/err free the fifo only behind ra_wq).
+	spin_lock_init(&zi->ra_fifo_lock);
+	init_llist_head(&zi->ra_done);
+	INIT_WORK(&zi->ra_work, zest_vra_work);
+	zi->ra_dead = false;
+	atomic_set(&zi->ra_inflight, 0);
+	init_waitqueue_head(&zi->ra_throttle_wq);
+	if (kfifo_alloc(&zi->ra_fifo, ZEST_VRA_FIFO, GFP_KERNEL)) {
+		zi->ra_wq = NULL;
+		pr_warn("zest-vra: fifo alloc failed; readahead engine off\n");
+	} else {
+		zi->ra_wq = alloc_workqueue("zest_vra",
+					    WQ_UNBOUND | WQ_SYSFS, 1);
+		if (!zi->ra_wq) {
+			kfifo_free(&zi->ra_fifo);
+			pr_warn("zest-vra: wq alloc failed; readahead engine off\n");
+		} else {
+			pr_notice("zest-vra: engine ready: fifo=%u, wq cpumask via /sys/devices/virtual/workqueue/zest_vra/cpumask\n",
+				  ZEST_VRA_FIFO);
+		}
+	}
+
+	//zest-ra: placement-array allocation moved BELOW, after zi->nr_slots is set
+	//(vkey_persist is sized by nr_slots; allocating with nr_slots==0 here would
+	//return ZERO_SIZE_PTR and later wild-write).
+
+	atomic64_set(&zi->nr_writes, 0);
+	atomic64_set(&zi->nr_reads, 0);
+	atomic64_set(&zi->nr_write_rejects, 0);		//zest3
+	atomic_set(&zi->fatal, 0);			//zest3.1
+	atomic64_set(&zi->fatal_count, 0);		//zest3.1
+	atomic64_set(&zi->fatal_slot, 0);		//zest3.1
+	atomic_set(&zi->fatal_nr, 0);			//zest3.1
+
+	//zest3: NO sis->max halving anymore. swap sees exactly the swap-visible
+	//capacity (the mkswap'd file size), and over-provisioning comes from a
+	//separate auto-reserved region appended to the swapfile inode (approach
+	//C). This is what fixes the cluster-allocator OOB: the modern per-cluster
+	//allocator hands out slots from free_clusters covering the *full*
+	//maxpages; if we shrank sis->max it would still allocate the hidden upper
+	//half, beyond a halved l2p[] -> heap corruption -> get_swap_pages
+	//hardlockup. With sis->max untouched and l2p sized to it, that is gone by
+	//construction.
+	swap_blocks = sis->max;
+
+	//zest3 Step 2: auto-reserve the OP region by extending the swapfile inode
+	//with extra pinned zoned sections (reuses the fallocate pinning path).
+	//OP size is derived from sbi->zest_op_ratio inside the f2fs glue (which
+	//has the full sbi type; here sbi is opaque). Best-effort: OP=0 is
+	//functional (no GC headroom), so never abort swapon on reserve failure.
+	//Reuse-aware across swapon cycles.
+	swap_inode = sis->swap_file->f_mapping->host;
+	ret = f2fs_zest_reserve_op_section(swap_inode, swap_blocks,
+					   &zi->op_start_lblk, &zi->op_nr_blocks);
+	if (ret)
+		pr_alert("zest: OP reserve returned %d; continuing with op_nr_blocks=%u\n",
+			  ret, zi->op_nr_blocks);
+	ret = 0;	//OP is best-effort; do not fail swapon
+
+	//zest3 Step 3: allocate L→P map sized to the FULL swap-visible capacity.
+	//Typical phone: ~2M slots * 8B = ~16 MiB. kvzalloc falls back to vmalloc
+	//if contiguous memory isn't available.
+	zi->nr_slots = sis->max;
+	zi->l2p = kvmalloc_array(zi->nr_slots, sizeof(*zi->l2p), GFP_KERNEL);
+	if (!zi->l2p) {
+		ret = -ENOMEM;
+		pr_alert("zest: l2p alloc failed nr_slots=%lu\n",
+			  zi->nr_slots);
+		goto err;
+	}
+	memset(zi->l2p, 0xff, zi->nr_slots * sizeof(*zi->l2p));
+	pr_notice("zest: l2p alloc nr_slots=%lu bytes=%lu\n",
+		  zi->nr_slots,
+		  (unsigned long)(zi->nr_slots * sizeof(*zi->l2p)));
+
+	//zest-ra: if the placement switch is on, allocate the placement arrays now
+	//-- AFTER nr_slots/wbuf_cap are set (vkey_persist is sized by nr_slots; doing
+	//this with nr_slots==0 would hand back ZERO_SIZE_PTR and later wild-write).
+	//Best-effort and degraded-safe; freed only at swapoff.
+	if (atomic_read(&zest_ra_dbg))
+		zest_ra_enable_alloc(zi);
+
+	//zest-rc: allocate the read cache if the switch is on. Sized by the
+	//read_cache_slots knob, best-effort, degraded-safe (stays off on failure).
+	if (atomic_read(&zest_rc_enable))
+		zest_rc_alloc(zi);
+
+	//zest3 Step 3b: enumerate zones (swap-visible region + OP region).
+	ret = zest3_discover_zones(zi);
+	if (ret)
+		goto err;
+
+	//zest3 Step 3c: snapshot mkswap header from F2FS page cache.
+	ret = zest3_capture_mkswap_header(zi);
+	if (ret)
+		goto err;
+
+	//zest3 Step 3c.1: flush + invalidate swapfile page cache before
+	//resetting zones. mkswap may have left dirty pages (especially
+	//the header at page 0). Without this, F2FS writeback would write
+	//them back AFTER zone reset, creating an unexpected IMP_OPEN zone.
+	{
+		struct address_space *mapping = zi->sis->swap_file->f_mapping;
+
+		filemap_write_and_wait(mapping);
+		invalidate_mapping_pages(mapping, 0, -1);
+	}
+
+	//zest3 Step 3d: reset any zone that isn't already EMPTY. After
+	//this, every zone in zi->zones[] starts at wp=0 device-side and
+	//ZEST owns the write pointer.
+	ret = zest3_reset_nonempty_zones(zi);
+	if (ret)
+		goto err;
+
+	//zest-gc Step 3d.1: allocate a per-zone reverse map (rmap), sized to
+	//the zone capacity in blocks. Index = block offset within the zone,
+	//value = swap slot, ZEST_INVALID_SLOT == free. Maintained in lockstep
+	//with l2p[] under zi->map_lock. Total memory ~= sum(nr_blocks)*4B, on the order
+	//of the l2p map itself.
+	{
+		unsigned int zi_i;
+
+		for (zi_i = 0; zi_i < zi->nr_zones; zi_i++) {
+			struct zest_zone *z = &zi->zones[zi_i];
+
+			z->rmap = kvmalloc_array(z->nr_blocks, sizeof(u32),
+					       GFP_KERNEL);
+			if (!z->rmap) {
+				ret = -ENOMEM;
+				pr_notice("zest-gc: rmap alloc failed zone=%u nr_blocks=%u\n",
+					  zi_i, z->nr_blocks);
+				goto err;
+			}
+			memset(z->rmap, 0xff, (size_t)z->nr_blocks * sizeof(u32));
+			z->is_gc_front = false;
+		}
+	}
+
+	//zest-gc Step 3d.2: preallocate the GC migration buffer (2 MiB worth of
+	//pages) once, up front, so GC never allocates on the reclaim path. Owned
+	//solely by gc_thread. Best-effort: if it fails GC is disabled (gc_thread
+	//never starts) and swap-out falls back to reject under pressure.
+	{
+		unsigned int e;
+		int order = get_order((size_t)ZEST_GC_BUF_PAGES << PAGE_SHIFT);
+		struct page *base;
+
+		zi->gc_buf = kvmalloc_array(ZEST_GC_BUF_PAGES,
+					    sizeof(*zi->gc_buf), GFP_KERNEL);
+		if (zi->gc_buf) {
+			//zest-ra: prefer ONE physically-contiguous run (allocated now,
+			//while memory is unfragmented) so GC writes coalesce into big
+			//bios like the host flush. Unconditional -- NOT gated by the ra
+			//switch. Fall back to per-page (functional, small bios).
+			base = alloc_pages(GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN,
+					   order);
+			if (base) {
+				zi->gc_buf_base  = base;
+				zi->gc_buf_order = (unsigned int)order;
+				zi->gc_buf_contig = true;
+				for (e = 0; e < ZEST_GC_BUF_PAGES; e++)
+					zi->gc_buf[e].page = base + e;
+				zi->gc_buf_nr = ZEST_GC_BUF_PAGES;
+				pr_notice("zest-gc: contiguous migration buffer %u pages (order %d)\n",
+					  ZEST_GC_BUF_PAGES, order);
+			} else {
+				zi->gc_buf_contig = false;
+				for (e = 0; e < ZEST_GC_BUF_PAGES; e++) {
+					zi->gc_buf[e].page = alloc_page(GFP_KERNEL);
+					if (!zi->gc_buf[e].page)
+						break;
+				}
+				zi->gc_buf_nr = e;	/* usable entries */
+				pr_notice("zest-gc: fragmented migration buffer %u/%u pages (no contiguous run)\n",
+					  e, ZEST_GC_BUF_PAGES);
+			}
+			//zest-ra: scratch for VMA-key sort of a batch (small; always).
+			zi->gc_sort = kvmalloc_array(ZEST_GC_BUF_PAGES,
+						     sizeof(*zi->gc_sort), GFP_KERNEL);
+			if (!zi->gc_sort)
+				pr_notice("zest-gc: gc_sort alloc failed; GC reorder off\n");
+		} else {
+			zi->gc_buf_nr = 0;
+			pr_notice("zest-gc: buffer array alloc failed; GC disabled\n");
+		}
+	}
+
+	//zest3 Step 3e: initialize per-zone fields and populate freelist.
+	//All zones start EMPTY (wp_blocks=0 after reset). Add every zone
+	//to the freelist, then pop the first one as cur_zone.
+	{
+		unsigned int zi_i;
+		unsigned int nr_free = 0;
+
+        //skip zone 0
+		for (zi_i = 0; zi_i < zi->nr_zones; zi_i++) {
+			INIT_LIST_HEAD(&zi->zones[zi_i].free_node);
+			atomic_set(&zi->zones[zi_i].inflight_reads, 0);
+			atomic_set(&zi->zones[zi_i].inflight_writes, 0);
+			if(zi_i > 0){
+				list_add_tail(&zi->zones[zi_i].free_node,
+				      &zi->freelist);
+				nr_free++;
+			}
+		}
+		zi->cur_zone = 0;
+		atomic_set(&zi->nr_free_zones, nr_free);
+	}
+
+	/* Step 4: claim the singleton slot (only one zest swapfile allowed).
+	 * Recheck under the mutex closes the race with a concurrent swapon that
+	 * passed the fast-fail check above. On loss, fall through to err: which
+	 * frees zi and returns -EBUSY. */
+	mutex_lock(&zest_singleton_mutex);
+	if (rcu_access_pointer(zest_singleton)) {
+		mutex_unlock(&zest_singleton_mutex);
+		pr_warn("zest: refusing 2nd zest swapfile; one already active (sis=%p)\n",
+			sis);
+		ret = -EBUSY;
+		goto err;
+	}
+	rcu_assign_pointer(zest_singleton, zi);
+	/* Step 5: ensure global static branch is on (under the same mutex so it
+	 * stays consistent with the singleton state). */
+	if (!static_branch_unlikely(&zest_enabled_key)) {
+		static_branch_enable(&zest_enabled_key);
+		pr_notice("zest: static branch auto-enabled by swapon\n");
+	}
+	mutex_unlock(&zest_singleton_mutex);
+
+	pr_notice("zest: registered sis=%p bdev=%pg\n", sis, zbdev);
+	pr_notice("zest: init complete: nr_slots=%lu nr_zones=%u\n",
+		  zi->nr_slots, zi->nr_zones);
+	zest_report_memory(zi);		//zest-ra: log resident allocation
+
+	//zest-gc Step 6: start the GC executor thread, but only if the
+	//migration buffer was allocated -- without it GC cannot relocate, and
+	//swap-out simply falls back to reject under pressure (no block-wait).
+	if (zi->gc_buf_nr && zest_gc_thread_start(zi))
+		pr_notice("zest-gc: GC thread start failed; running without GC\n");
+
+	return 0;
+
+err:
+	//zest3: rollback. kfree/kvfree(NULL) is safe, so this works
+	//regardless of which step we tripped on. sis->max is no longer modified
+	//(no halving), so nothing to restore there. Any OP blocks already
+	//reserved on the inode are intentionally left in place: they are valid
+	//pinned blocks, harmless, and will be reused on the next swapon attempt
+	//(reuse-aware) or freed when the swapfile is deleted.
+	if (zi->zones) {
+		unsigned int zi_i;
+
+		for (zi_i = 0; zi_i < zi->nr_zones; zi_i++)
+			kvfree(zi->zones[zi_i].rmap);
+	}
+	zest_gc_buf_free(zi);
+	kfree(zi->mkswap_header);
+	kvfree(zi->zones);
+	kvfree(zi->l2p);
+	//zest-vra: free the engine (no I/O has flowed during init, so a plain
+	//destroy+free is enough).
+	if (zi->ra_wq) {
+		destroy_workqueue(zi->ra_wq);
+		kfifo_free(&zi->ra_fifo);
+	}
+	//zest-wbuf: free the staging ring and its workqueue (safe on partial/NULL).
+	zest_wbuf_pool_free(zi);
+	if (zi->wbuf_wq)
+		destroy_workqueue(zi->wbuf_wq);
+	kfree(zi);
+	pr_alert("zest: init aborted: %d\n", ret);
+	return ret;
+}
+
+/*
+ * zest2: swapoff release. Unpublish the singleton under the cold-path mutex,
+ * then synchronize_rcu() to wait out any in-flight stats reader before
+ * tearing zi down. Swap I/O is already quiesced here (f2fs_swap_deactivate
+ * runs after try_to_unuse()), so the lockless hot path cannot race the free.
+ */
+void zest_release_for_swapfile(struct f2fs_sb_info *sbi)
+{
+	struct zest_info *zi;
+	unsigned int i;
+
+	mutex_lock(&zest_singleton_mutex);
+	zi = rcu_dereference_protected(zest_singleton,
+				       lockdep_is_held(&zest_singleton_mutex));
+	if (zi && zi->sbi == sbi) {
+		rcu_assign_pointer(zest_singleton, NULL);
+		/* No swapfile intercepted anymore: drop the static branch. */
+		if (static_branch_unlikely(&zest_enabled_key)) {
+			static_branch_disable(&zest_enabled_key);
+			pr_notice("zest: static branch auto-disabled (no swapfile)\n");
+		}
+	} else {
+		zi = NULL;
+	}
+	mutex_unlock(&zest_singleton_mutex);
+
+	if (!zi) {
+		pr_notice("zest: release: no entry matched (sbi=%p)\n", sbi);
+		return;
+	}
+
+	//Wait out any in-flight stats reader (rcu_read_lock in
+	//zest_gc_collect_stats) before freeing zi.
+	synchronize_rcu();
+
+	//zest-gc: stop the background GC thread first -- it touches
+	//zones/l2p/rmap and the freelist. kthread_stop() blocks until
+	//the thread observes kthread_should_stop() and returns, so after
+	//this no GC activity can race the teardown below.
+	zest_gc_thread_stop(zi);
+
+	//zest-wbuf: by now try_to_unuse() has read every live page back into RAM
+	//(swap-in served from the buffer for not-yet-flushed slots) and freed the
+	//slots, so the staging buffers hold only logically-dead data -- DISCARD
+	//them, no flush needed. Just drain any flush_work queued/running before
+	//quiesce: each flush worker drops its inflight_writes ref on completion
+	//(which the per-zone drain below also waits for), and drain_workqueue()
+	//blocks new work, so after this no flush can race the teardown.
+	drain_workqueue(zi->wbuf_wq);
+
+	//zest-vra: stop the prefetch engine BEFORE the per-zone inflight drain.
+	//ra_dead gates every new submission (worker and inline paths);
+	//cancel_work_sync waits out a running worker pass. Fills already in
+	//flight hold zone inflight_reads refs -- the zone loop below waits them
+	//out. Their endios may RE-queue ra_work after this cancel; that is fine
+	//(the late run only publishes completions, rc is still alive) and the
+	//destroy below the drain flushes the last of them.
+	if (zi->ra_wq) {
+		WRITE_ONCE(zi->ra_dead, true);
+		smp_mb();	/* ra_dead visible before the worker is waited out */
+		//zest-vra (M3.5): a worker parked at the inflight cap must see
+		//ra_dead and bail, or cancel_work_sync deadlocks against it.
+		wake_up_all(&zi->ra_throttle_wq);
+		cancel_work_sync(&zi->ra_work);
+	}
+
+	pr_notice("zest: release sis=%p bdev=%pg writes=%lld reads=%lld rejects=%lld gc_runs=%lld gc_moved=%lld gc_reclaimed=%lld\n",
+		zi->sis, zi->bdev,
+		(long long)atomic64_read(&zi->nr_writes),
+		(long long)atomic64_read(&zi->nr_reads),
+		(long long)atomic64_read(&zi->nr_write_rejects),
+		(long long)atomic64_read(&zi->gc_runs),
+		(long long)atomic64_read(&zi->gc_moved_blocks),
+		(long long)atomic64_read(&zi->gc_zones_reclaimed));
+
+	//zest3: reset every zone we ever wrote into (state > EMPTY)
+	//so the next swapon doesn't inherit our wp. This covers both
+	//swap-visible and OP zones. We only reset the *hardware* zone
+	//state here; the OP blocks remain allocated to the swapfile
+	//inode (reserve-and-reuse) and are freed only when the swapfile
+	//is deleted (rm), via the normal VFS path after S_SWAPFILE is
+	//cleared. Wait for any inflight reads to drain before resetting.
+	for (i = 0; i < zi->nr_zones; i++) {
+		struct zest_zone *z = &zi->zones[i];
+		sector_t len = (sector_t)z->nr_blocks
+				<< (PAGE_SHIFT - 9);
+		int rret;
+
+		if (z->wp_blocks == 0)
+			continue;
+		//zest-gc: full barrier before draining inflight I/O,
+		//pairing with the inc in zest_swap_readpage (reads) and
+		//zest_swap_writepage (writes). Without it these loads could
+		//be reordered ahead of an in-flight inc and we'd reset a
+		//zone with I/O still outstanding -> torn data / device error.
+		smp_mb();
+		while (atomic_read(&z->inflight_reads) > 0 ||
+		       atomic_read(&z->inflight_writes) > 0)
+			cpu_relax();
+		rret = blkdev_zone_mgmt(zi->bdev, REQ_OP_ZONE_RESET,
+					z->start_sector, len,
+					GFP_NOFS);
+		if (rret)
+			pr_alert("zest: release: zone %u reset failed: %d\n",
+				  i, rret);
+		else
+			pr_notice("zest: release: zone %u reset (was wp=%u)\n",
+				  i, z->wp_blocks);
+	}
+
+	//zest3: free the per-swapfile state.
+	//zest-gc: free per-zone reverse maps before the zone array, plus
+	//the GC migration buffer (gc_thread already stopped above).
+	for (i = 0; i < zi->nr_zones; i++)
+		kvfree(zi->zones[i].rmap);
+	zest_gc_buf_free(zi);
+	//zest-ra: free the placement arrays (bounce + vkey_persist). Safe here:
+	//gc_thread stopped + wbuf_wq drained above, so the lockless GC reader and
+	//the flush worker (the two users) are both quiesced. Per-wbuf vkey[] are
+	//freed by zest_wbuf_pool_free() below.
+	zest_ra_free(zi);
+	//zest-vra: tear down the engine. Every fill bio has completed by now
+	//(the per-zone drain waited out their inflight refs, and endio drops
+	//the ref only AFTER llist_add + queue_work), so destroying the wq --
+	//which drains queued work -- publishes every remaining completion via
+	//fill_done while the read cache is still alive. The manual llist drain
+	//after destroy is belt-and-braces (should always find it empty).
+	if (zi->ra_wq) {
+		struct llist_node *node;
+
+		destroy_workqueue(zi->ra_wq);
+		zi->ra_wq = NULL;
+		node = llist_del_all(&zi->ra_done);
+		while (node) {
+			struct zest_rc_way *way =
+				llist_entry(node, struct zest_rc_way,
+					    fill_node);
+
+			node = node->next;
+			zest_rc_fill_done(zi, way, way->fill_slot,
+					  way->fill_ok);
+		}
+		kfifo_free(&zi->ra_fifo);
+	}
+	//zest-rc: free the read cache. Safe here: the per-zone inflight_reads
+	//drain above waited out any in-flight fill (a fill holds a ref on its
+	//source zone), so nothing is DMAing into way pages anymore.
+	zest_rc_free(zi);
+	kfree(zi->mkswap_header);
+	kvfree(zi->zones);
+	kvfree(zi->l2p);
+	//zest-wbuf: free the staging ring (drained above) and its workqueue.
+	zest_wbuf_pool_free(zi);
+	if (zi->wbuf_wq)
+		destroy_workqueue(zi->wbuf_wq);
+	kfree(zi);
+}
+
+/* -------------------------------------------------------------- */
+/* zest3: swap I/O implementations                                */
+/* -------------------------------------------------------------- */
+
+//zest3.1: trip the permanent L2P-OOB FATAL latch.
+//
+//Records the offending (slot, nr_pages) on both the per-swapfile zest_info
+//and the subsystem-wide mirror (so /sys/kernel/zest/fatal survives swapoff),
+//latches `fatal` so all subsequent interceptions reject immediately, then
+//shouts via pr_emerg_ratelimited. With CONFIG_PSTORE_CONSOLE=y that emerg
+//line is captured into the pstore Console record (ramoops / efi-pstore) for
+//post-reboot forensics. We deliberately do NOT BUG()/panic: the caller exits
+//the page safely so the rest of the system keeps running and the latch can be
+//read out live via sysfs.
+//
+//`fatal` (the latch) is set last so any reader that observes fatal==1 also
+//observes the matching count/slot/nr that were stored just before it.
+static void zest_fatal_trip(struct zest_info *zi, unsigned long slot,
+			    unsigned int nr_pages)
+{
+	atomic64_inc(&zi->fatal_count);
+	atomic64_set(&zi->fatal_slot, slot);
+	atomic_set(&zi->fatal_nr, nr_pages);
+	smp_wmb();
+	atomic_set(&zi->fatal, 1);
+
+	atomic64_inc(&zest_fatal_count);
+	atomic64_set(&zest_fatal_slot, slot);
+	atomic_set(&zest_fatal_nr, nr_pages);
+	smp_wmb();
+	atomic_set(&zest_fatal, 1);
+
+	pr_emerg_ratelimited("zest: FATAL L2P OOB slot=%lu nr=%u nr_slots=%lu\n",
+			     slot, nr_pages, zi->nr_slots);
+}
+
+//zest-wbuf: swap-out hot path.
+//
+//Called from __swap_writepage (mm/page_io.c) when zest_should_intercept
+//returned true. Folio enters locked. We memcpy its pages into the FILLING
+//staging buffer and ACK immediately (folio_start+end_writeback); the device
+//write is deferred to the ordered flush worker, which assigns the zone write
+//pointer and emits one big contiguous bio. On exit:
+//  - acked: pages copied to the buffer, l2p[slot]=BUF|gidx, folio writeback
+//    ended + unlocked. mm may free the page; reads come from the buffer until
+//    the flush commits a real device sector (then l2p[slot]=sector); or
+//  - rejected: no FREE buffer within the bounded wait -- the pressure valve,
+//    equivalent to the old "no free zone" reject. Folio re-dirtied + unlocked.
+//
+//Locking: NO io_lock. buf_lock (a brief spinlock; no memcpy/submit under it)
+//hands out distinct buffer page indices and arbitrates the FILLING->FLUSHING
+//seal. map_lock publishes l2p=BUF and invalidates the superseded old mapping
+//(its GC-leak-race role is unchanged). wb->copied is a lockless completion
+//counter the flush worker waits on. Device-write ORDER is provided by the
+//single-threaded (ordered) flush workqueue, not by a lock here. A folio larger
+//than the remaining buffer space simply spans into the next buffer.
+void zest_swap_writepage(struct page *page, struct writeback_control *wbc,
+			 struct swap_info_struct *sis)
+{
+	struct folio *folio = page_folio(page);
+	struct zest_info *zi = zest_current(sis);
+	unsigned int nr_pages, done;
+	unsigned long slot_start;
+	//zest-ra (debug): VMA coord of this folio, captured here because the folio
+	//is freed after the early-ack below. 0 av == not plain anon. Only read when
+	//the ra_debug switch is on; left zero otherwise (no cost on the off path).
+	unsigned long dbg_av = 0;
+	pgoff_t dbg_idx = 0;
+
+	if (unlikely(!zi)) {
+		WARN_ONCE(1, "zest: writepage with no zi for sis=%p\n", sis);
+		folio_mark_dirty(folio);
+		folio_clear_reclaim(folio);
+		folio_unlock(folio);
+		return;
+	}
+
+	nr_pages   = folio_nr_pages(folio);
+	slot_start = swp_offset(folio->swap);
+
+	//zest-ra (debug): grab (anon_vma, base index) before early-ack frees the
+	//folio. Page (done+k) within the folio has index dbg_idx + done + k.
+	if (atomic_read(&zest_ra_dbg)) {
+		dbg_av  = zest_folio_anon_vma(folio);
+		dbg_idx = folio->index;
+	}
+
+	if (unlikely(atomic_read(&zi->fatal) ||
+		     slot_start + nr_pages > zi->nr_slots)) {
+		if (slot_start + nr_pages > zi->nr_slots)
+			zest_fatal_trip(zi, slot_start, nr_pages);
+		folio_mark_dirty(folio);
+		folio_clear_reclaim(folio);
+		folio_unlock(folio);
+		return;
+	}
+
+	//Mark the whole folio under writeback up front; we end it once every page
+	//is staged (possibly across more than one buffer). Each page's data is in
+	//the buffer before we end writeback, so mm may free the page afterwards.
+	folio_start_writeback(folio);
+
+	done = 0;
+	while (done < nr_pages) {
+		struct zest_wbuf *wb;
+		unsigned int g, c, k;
+
+		//--- claim a run of buffer pages (buf_lock) ---
+		spin_lock(&zi->buf_lock);
+		wb = &zi->wbufs[zi->wbuf_cur];
+		if (wb->state != ZEST_WBUF_FILLING || wb->fill == wb->cap) {
+			int next;
+
+			//cur is full or was sealed by the backstop: seal it (if still
+			//FILLING) and switch to a FREE buffer.
+			if (wb->state == ZEST_WBUF_FILLING)
+				zest_wbuf_seal_locked(zi, wb);
+			next = zest_wbuf_pick_free_locked(zi);
+			if (next < 0) {
+				spin_unlock(&zi->buf_lock);
+				//Pressure valve: no FREE buffer. Wait bounded, else
+				//reject (the remaining pages are not acked).
+				if (!wait_event_timeout(zi->wbuf_free_wait,
+						zest_wbuf_any_free(zi) ||
+						atomic_read(&zi->fatal),
+						HZ / 5))
+					goto reject;
+				if (atomic_read(&zi->fatal))
+					goto reject;
+				continue;
+			}
+			wb = &zi->wbufs[next];
+			wb->state = ZEST_WBUF_FILLING;
+			wb->fill = 0;
+			atomic_set(&wb->copied, 0);
+			zi->wbuf_cur = (unsigned int)next;
+		}
+		g = wb->fill;
+		c = min(nr_pages - done, wb->cap - g);
+		wb->fill += c;
+		for (k = 0; k < c; k++)
+			wb->bslot[g + k] = (u32)(slot_start + done + k);
+		//zest-ra (debug): record each staged page's VMA coord alongside its
+		//slot. wb->vkey is read under buf_lock (same as it is published/NULLed)
+		//so it's NULL-or-valid atomically; idx = base index + folio offset.
+		if (wb->vkey) {
+			for (k = 0; k < c; k++) {
+				wb->vkey[g + k].av  = dbg_av;
+				wb->vkey[g + k].idx = dbg_av ?
+					(pgoff_t)(dbg_idx + done + k) : 0;
+			}
+		}
+		spin_unlock(&zi->buf_lock);
+
+		//--- copy folio pages -> buffer pages (no locks) ---
+		for (k = 0; k < c; k++) {
+			void *dst = page_address(wb->pages[g + k]);
+			void *src = kmap_local_folio(folio,
+				(size_t)(done + k) << PAGE_SHIFT);
+
+			memcpy(dst, src, PAGE_SIZE);
+			kunmap_local(src);
+		}
+
+		//--- publish l2p=BUF + invalidate the superseded mapping (map_lock) ---
+		//Reading old INSIDE the lock keeps the GC-leak-race closed (same as the
+		//old write path). An old *device* sector is dead now -> invalidate it.
+		//An old *BUF* entry (slot re-staged before its flush) is left alone:
+		//that flush's commit skips it via the l2p mismatch.
+		spin_lock(&zi->map_lock);
+		for (k = 0; k < c; k++) {
+			unsigned long slot = slot_start + done + k;
+			sector_t old = zi->l2p[slot];
+
+			if (old != ZEST_INVALID_SECTOR && !zest_l2p_is_buf(old))
+				zest_map_invalidate_sector(zi, old);
+			WRITE_ONCE(zi->l2p[slot],
+				   zest_l2p_mk_buf(wb->gbase + g + k));
+			//zest-rc: this slot is being rewritten -> any cached copy is
+			//now stale; drop it (read side of rc->lock, under map_lock).
+			zest_rc_invalidate_slot(zi, slot);
+		}
+		spin_unlock(&zi->map_lock);
+
+		//--- announce completion: publish the data before bumping copied so
+		//the flush worker (smp_rmb after its wait) sees a fully-written page.
+		smp_wmb();
+		atomic_add(c, &wb->copied);
+		done += c;
+	}
+
+	count_vm_events(PSWPOUT, nr_pages);
+	folio_end_writeback(folio);	//early ack: swap-out is "done"
+	folio_unlock(folio);
+
+	//No backstop: a partial buffer just waits to fill (or is discarded at
+	//swapoff). This keeps flushes at the full buffer cap -> big device writes.
+	atomic64_inc(&zi->nr_writes);
+	pr_debug("zest-wbuf: staged slot=%lu nr=%u\n", slot_start, nr_pages);
+	zest_gc_kick(zi);
+	return;
+
+reject:
+	//No buffer space. End the (not-yet-acked) folio writeback and re-dirty so
+	//mm retries the WHOLE folio later. Any leading pages already staged keep
+	//valid BUF mappings (reads still served from the buffer); the retry simply
+	//re-stages them into fresh buffer pages and the stale copies become dead
+	//space their flush skips. No data is lost.
+	atomic64_inc(&zi->nr_write_rejects);
+	zest_gc_kick(zi);
+	pr_alert_ratelimited("zest-wbuf: reject slot=%lu nr=%u done=%u (no free buffer)\n",
+			     slot_start, nr_pages, done);
+	folio_end_writeback(folio);
+	folio_mark_dirty(folio);
+	folio_clear_reclaim(folio);
+	folio_unlock(folio);
+}
+
+//zest3: swap-in hot path.
+//
+//Called from swap_readpage (mm/page_io.c) when zest_should_intercept
+//returned true. Folio enters locked. On exit we have either:
+//  - served data inline (header memcpy or defensive zero), marked
+//    uptodate, unlocked; or
+//  - submitted one async bio (uptodate + unlock via end_io).
+//
+//Single-page only: __read_swap_cache_async (mm/swap_state.c) calls
+//vma_alloc_folio(..., order=0, ...) unconditionally, so every folio
+//handed to swap_readpage in this kernel is single-page even though
+//writes can be multi-page (mTHP swap-out). VM_WARN_ON_ONCE catches
+//any future kernel change that introduces multi-page swap-in.
+//
+//inflight_reads protocol (zest3 refactor):
+//  1. READ_ONCE l2p[slot] → sector
+//  2. Find zone → atomic_inc(&zone->inflight_reads)
+//  3. Re-read l2p[slot]: if changed, atomic_dec + retry (GC relocated)
+//  4. Submit bio; end_io does atomic_dec
+//  GC waits for inflight_reads == 0 before resetting a zone.
+void zest_swap_readpage(struct folio *folio, struct swap_info_struct *sis)
+{
+	struct zest_info *zi = zest_current(sis);
+	unsigned long slot;
+	sector_t sector;
+	struct zest_zone *z;
+	unsigned int z_idx;
+	struct bio *bio;
+	void *kaddr;
+
+	if (unlikely(!zi)) {
+		WARN_ONCE(1, "zest: readpage with no zi for sis=%p\n", sis);
+		folio_unlock(folio);
+		return;
+	}
+
+	VM_WARN_ON_ONCE(folio_nr_pages(folio) != 1);
+
+	slot = swp_offset(folio->swap);
+
+	//zest3.1: L2P bounds + FATAL latch. A single-page swap-in indexes
+	//zi->l2p[slot]; slot >= nr_slots would read past the map. Reject
+	//without touching l2p[] or submitting a bio, and latch FATAL. We leave
+	//the folio !uptodate on unlock (unlike the writepage path's mark-dirty)
+	//so the fault fails loudly -- SIGBUS to the caller -- rather than
+	//feeding the process silently zeroed data. Once latched, every later
+	//swap-in (including the slot-0 header) short-circuits here.
+	if (unlikely(atomic_read(&zi->fatal) || slot >= zi->nr_slots)) {
+		if (slot >= zi->nr_slots)
+			zest_fatal_trip(zi, slot, 1);
+		folio_unlock(folio);
+		return;
+	}
+
+	if (slot == 0 && zi->mkswap_header) {
+		kaddr = kmap_local_folio(folio, 0);
+		memcpy(kaddr, zi->mkswap_header, PAGE_SIZE);
+		kunmap_local(kaddr);
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		atomic64_inc(&zi->nr_reads);
+		pr_debug("zest: read slot=0 from header cache\n");
+		return;
+	}
+
+retry:
+	sector = READ_ONCE(zi->l2p[slot]);
+
+	if (sector == ZEST_INVALID_SECTOR) {
+		pr_warn_ratelimited("zest: read slot=%lu unmapped (unexpected), zeroed\n",
+				    slot);
+		folio_zero_range(folio, 0, folio_size(folio));
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		atomic64_inc(&zi->nr_reads);
+		return;
+	}
+
+	//zest-wbuf: still staged in a RAM buffer (not yet flushed to a real
+	//sector) -- serve it straight from the buffer (a memcpy, no bio). The
+	//on-device sector either doesn't exist yet or, mid-flush, hasn't had the
+	//device write pointer passed (zoned reads below wp return garbage), so we
+	//MUST read RAM here. Seqlock-style re-check: for a given slot, l2p only
+	//ever leaves BUF for a real sector or INVALID and never returns to the
+	//same BUF|gidx (no ABA); so if l2p[slot] still equals `sector` after the
+	//copy, the buffer page was not recycled+reused under us and the data is
+	//valid. Otherwise retry (it became a real sector / INVALID / other buffer).
+	if (zest_l2p_is_buf(sector)) {
+		u32 gidx = zest_l2p_gidx(sector);
+		struct zest_wbuf *wb = &zi->wbufs[gidx / zi->wbuf_cap];
+		struct page *bp = wb->pages[gidx % zi->wbuf_cap];
+
+		kaddr = kmap_local_folio(folio, 0);
+		memcpy(kaddr, page_address(bp), PAGE_SIZE);
+		kunmap_local(kaddr);
+		smp_rmb();
+		if (READ_ONCE(zi->l2p[slot]) != sector)
+			goto retry;
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		//zest-wbuf: PSWPIN counts every SERVED swap-in, RAM or flash (ZRAM
+		//semantics), so /proc/vmstat pswpin rate stays comparable across
+		//readahead on/off configs. Count after the seqlock recheck only --
+		//the retry path must not double-count.
+		count_vm_events(PSWPIN, folio_nr_pages(folio));
+		atomic64_inc(&zi->nr_reads);
+		pr_debug("zest-wbuf: read slot=%lu from buffer gidx=%u\n",
+			 slot, gidx);
+		return;
+	}
+
+	//zest-rc: read-cache fast path. On a hit it serves the folio and we are
+	//done. A miss -- including "the slot's fill is still in flight" (busy) --
+	//falls straight through to the single-page read below: the fault NEVER
+	//waits on a prefetch fill (the duplicate IO is counted as busy_direct).
+	if (zest_rc_lookup(zi, slot, folio)) {
+		return;
+	}
+
+	z_idx = zest3_find_zone_for_sector(zi, sector);
+	if (z_idx < zi->nr_zones) {
+		z = &zi->zones[z_idx];
+		atomic_inc(&z->inflight_reads);
+		//zest-gc: full barrier between the inflight_reads increment and
+		//the re-read of l2p[slot]. Pairs with the smp_mb() before GC's
+		//(and swapoff's) "while (inflight_reads) cpu_relax()" drain. This
+		//is a StoreLoad pair: without the barrier the re-read could hoist
+		//above the inc, GC could observe inflight==0, and reset the zone
+		//while this read is in flight -> torn/garbage swap-in. If GC has
+		//already relocated this slot, the re-read mismatches and we retry
+		//against the new location.
+		smp_mb();
+		if (READ_ONCE(zi->l2p[slot]) != sector) {
+			atomic_dec(&z->inflight_reads);
+			goto retry;
+		}
+	} else {
+		z = NULL;
+	}
+
+	//zest: GFP_NOIO -- swap-in runs in the direct-reclaim / fault path under
+	//memory pressure; GFP_KERNEL here could recurse into reclaim and stall.
+	bio = bio_alloc(zi->bdev, 1, REQ_OP_READ, GFP_NOIO);
+	bio->bi_iter.bi_sector = sector;
+	bio->bi_end_io = zest3_end_swap_bio_read;
+	bio->bi_private = z;
+	bio_add_folio_nofail(bio, folio, folio_size(folio), 0);
+	count_vm_events(PSWPIN, folio_nr_pages(folio));
+	submit_bio(bio);
+
+	atomic64_inc(&zi->nr_reads);
+	pr_debug("zest: read slot=%lu sector=%llu\n",
+			      slot, (unsigned long long)sector);
+}
+
+//zest-gc: swap-slot-free hook (see zest.h). Drop L2P/rmap and decrement
+//valid_blocks for each freed slot so GC accounting is exact. Atomic
+//context (caller holds swap_info_struct::lock); takes only map_lock.
+void zest_swap_slot_free(struct swap_info_struct *sis, unsigned long offset,
+			 unsigned int nr)
+{
+	struct zest_info *zi = zest_current(sis);
+	unsigned int i;
+	unsigned int freed = 0;
+
+	if (unlikely(!zi) || unlikely(atomic_read(&zi->fatal)))
+		return;
+	//Out-of-bounds range: ignore silently (do NOT trip FATAL here -- the
+	//free path is best-effort accounting, not a data path, and we must
+	//not index l2p[] past its end).
+	if (unlikely(offset + nr > zi->nr_slots))
+		return;
+
+	spin_lock(&zi->map_lock);
+	for (i = 0; i < nr; i++) {
+		sector_t old = zi->l2p[offset + i];
+
+		if (old == ZEST_INVALID_SECTOR)
+			continue;
+		//zest-wbuf: a still-staged (BUF) slot has no device sector / rmap /
+		//valid_blocks yet -- just drop the L2P entry. Its pending flush sees
+		//l2p[slot] != BUF|gidx at commit time and skips it (the staged page
+		//becomes dead space that GC reclaims). Only a real device sector
+		//needs the rmap/valid_blocks invalidate.
+		if (!zest_l2p_is_buf(old))
+			zest_map_invalidate_sector(zi, old);
+		WRITE_ONCE(zi->l2p[offset + i], ZEST_INVALID_SECTOR);
+		//zest-rc: slot freed -> drop any cached copy so a later swap-in of a
+		//re-allocated slot can't hit stale data (read side, under map_lock).
+		zest_rc_invalidate_slot(zi, offset + i);
+		freed++;
+	}
+	spin_unlock(&zi->map_lock);
+
+	//Debug-only: this is the swap-slot-free hook (kernel freed swap slots),
+	//NOT GC reclaim -- it fires at swap-churn rate and is decoupled from the
+	//physical write frontier, so keep it off the default console. Real GC
+	//activity logs "zest-gc: victim/reclaimed".
+	if (freed)
+		pr_debug("zest: slot_free offset=%lu nr=%u freed=%u\n",
+			 offset, nr, freed);
+}
+
+/* -------------------------------------------------------------- */
+/* zest-gc: garbage collection                                    */
+/* -------------------------------------------------------------- */
+
+//zest-gc: victim selection. Among FULL zones (wp_blocks == nr_blocks) that
+//are neither the host write frontier (cur_zone) nor the GC write frontier
+//(gc_cur_zone) nor on the freelist (wp_blocks == 0 already excludes those),
+//pick the one with the fewest valid_blocks. Returns its index, or
+//ZEST_NO_ZONE if there is no profitable victim (the best candidate is fully
+//valid, i.e. nothing would be reclaimed).
+//
+//valid_blocks is read locklessly (atomic); a concurrent host invalidate or
+//free can only shrink it, so a victim we pick may end up even cheaper to
+//evacuate than estimated -- never the reverse. The chosen zone is FULL and
+//not a frontier, so no new mappings can be appended to it; its valid set is
+//stable-or-shrinking for the duration of GC.
+static unsigned int zest_gc_pick_victim(struct zest_info *zi)
+{
+	unsigned int best = ZEST_NO_ZONE;
+	unsigned int best_valid = UINT_MAX;
+	unsigned int i;
+
+	for (i = 0; i < zi->nr_zones; i++) {
+		struct zest_zone *z = &zi->zones[i];
+		unsigned int v;
+
+		if (i == zi->cur_zone || i == zi->gc_cur_zone)
+			continue;
+		if (z->is_gc_front)
+			continue;
+		if (z->wp_blocks != z->nr_blocks)	/* not FULL (EMPTY/free or partial) */
+			continue;
+		v = atomic_read(&z->valid_blocks);
+		if (v < best_valid) {
+			best_valid = v;
+			best = i;
+		}
+	}
+
+	if (best == ZEST_NO_ZONE)
+		return ZEST_NO_ZONE;
+	//No reclaim benefit if the cheapest FULL zone is entirely valid: we'd
+	//copy nr_blocks blocks just to free and re-consume one zone. Skip.
+	if (best_valid >= zi->zones[best].nr_blocks)
+		return ZEST_NO_ZONE;
+	return best;
+}
+
+//zest-gc: GC write-frontier accessor. Returns the current frontier zone with
+//at least one free block, opening or rotating to a fresh free zone as needed.
+//Returns NULL if the freelist is empty (no space to relocate into). Only the
+//single GC executor touches gc_cur_zone and the frontier wp, so no lock is
+//needed there; only the freelist pop takes freelist_lock (shared with host).
+static struct zest_zone *zest_gc_frontier(struct zest_info *zi)
+{
+	struct zest_zone *z;
+
+	if (zi->gc_cur_zone != ZEST_NO_ZONE) {
+		z = &zi->zones[zi->gc_cur_zone];
+		if (z->wp_blocks < z->nr_blocks)
+			return z;
+		//Frontier full: it becomes an ordinary FULL zone (a future
+		//victim). Already at wp==nr_blocks on the device -> no padding.
+		z->is_gc_front = false;
+		zi->gc_cur_zone = ZEST_NO_ZONE;
+	}
+
+	spin_lock(&zi->freelist_lock);
+	if (list_empty(&zi->freelist)) {
+		spin_unlock(&zi->freelist_lock);
+		return NULL;
+	}
+	z = list_first_entry(&zi->freelist, struct zest_zone, free_node);
+	list_del_init(&z->free_node);
+	atomic_dec(&zi->nr_free_zones);
+	spin_unlock(&zi->freelist_lock);
+	z->is_gc_front = true;
+	zi->gc_cur_zone = z - zi->zones;
+	return z;
+}
+
+//zest-gc: shared completion state for a batch of GC bios.
+struct zest_gc_io {
+	atomic_t	pending;
+	blk_status_t	status;
+	struct completion done;
+};
+
+static void zest_gc_batch_endio(struct bio *bio)
+{
+	struct zest_gc_io *io = bio->bi_private;
+
+	if (bio->bi_status)
+		io->status = bio->bi_status;
+	if (atomic_dec_and_test(&io->pending))
+		complete(&io->done);
+	bio_put(bio);
+}
+
+//zest-ra: sort a GC batch by packed VMA key (key lives in the element, so plain
+//sort()). Equal/zero keys keep arbitrary order (hint only). See zest_gc_run_one.
+static int zest_gc_sort_cmp(const void *a, const void *b)
+{
+	const struct zest_gc_sort *ka = a, *kb = b;
+
+	if (ka->key != kb->key)
+		return (ka->key > kb->key) - (ka->key < kb->key);
+	return 0;
+}
+
+//zest-gc: batch-read @n victim valid pages into their buffer pages. gc_buf[j]
+//was tagged with the victim block (.vblk) it should hold. Reads are scattered
+//and independent, so they go out as @n separate bios issued together under the
+//caller's plug; we wait for all. Returns 0 or a negative errno.
+static int zest_gc_batch_read(struct zest_info *zi, struct zest_zone *victim,
+			      unsigned int n)
+{
+	struct zest_gc_io io;
+	unsigned int j;
+
+	atomic_set(&io.pending, n);
+	io.status = 0;
+	init_completion(&io.done);
+
+	for (j = 0; j < n; j++) {
+		struct bio *bio = bio_alloc(zi->bdev, 1, REQ_OP_READ, GFP_NOIO);
+		sector_t s = victim->start_sector +
+			((sector_t)zi->gc_buf[j].vblk << (PAGE_SHIFT - 9));
+
+		bio->bi_iter.bi_sector = s;
+		bio->bi_private = &io;
+		bio->bi_end_io = zest_gc_batch_endio;
+		__bio_add_page(bio, zi->gc_buf[j].page, PAGE_SIZE, 0);
+		submit_bio(bio);
+	}
+	wait_for_completion(&io.done);
+	return blk_status_to_errno(io.status);
+}
+
+//zest-gc: batch-write the @n buffer pages to consecutive frontier sectors
+//starting at @base (gc_buf[0..n) -> base..base+n). The caller sized @n to the
+//frontier zone's remaining space, so this is a single sequential, zone-legal
+//run.
+//
+//F2FS-style merge: keep ONE open bio and append pages with bio_add_page; only
+//when it fills (add returns 0) do we submit it and open a new one -- no bio per
+//page. Submission is ASYNC (no per-bio device round-trip); we wait ONCE at the
+//end via a shared completion. Bios go out in ascending-sector order under the
+//caller's blk_plug, so the block layer's zoned write-locking issues them to the
+//device in write-pointer order, and GC is the sole writer to this frontier.
+//
+//The bio count isn't known up front: bio_add_page stops not only at
+//BIO_MAX_VECS but at the device's max_sectors/segment limits, so a bio may hold
+//fewer than 256 pages. Hence the bias idiom (pending=1, inc per submitted bio,
+//drop the bias at the end) rather than the read path's pending=n -- precomputing
+//a count could undershoot and let the completion fire before all writes land.
+//
+//A new bio opened at page i starts at sector base+i (pages are emitted in
+//order to contiguous sectors), so no separate "emitted" cursor is needed.
+//
+//zest-ra: gc_buf is now a contiguous run (zest_gc_buf_alloc) on the fast path,
+//so bio_add_page coalesces these pages into multipage bvecs -> big GC writes
+//(matching the host flush); on the fragmented fallback it's one bvec each.
+static int zest_gc_batch_write(struct zest_info *zi, sector_t base,
+			       unsigned int n)
+{
+	struct zest_gc_io io;
+	struct bio *bio = NULL;
+	unsigned int i;
+
+	atomic_set(&io.pending, 1);	/* bias; dropped after the last submit */
+	io.status = 0;
+	init_completion(&io.done);
+
+	for (i = 0; i < n; i++) {
+		if (bio && !bio_add_page(bio, zi->gc_buf[i].page, PAGE_SIZE, 0)) {
+			atomic64_add(bio->bi_iter.bi_size, &zi->gc_wb_bytes);
+			atomic64_inc(&zi->bio_count);
+			atomic_inc(&io.pending);
+			submit_bio(bio);	/* full -> issue, open a fresh bio */
+			bio = NULL;
+		}
+		if (!bio) {
+			bio = bio_alloc(zi->bdev, BIO_MAX_VECS, REQ_OP_WRITE,
+					GFP_NOIO);
+			bio->bi_iter.bi_sector = base +
+				((sector_t)i << (PAGE_SHIFT - 9));
+			bio->bi_private = &io;
+			bio->bi_end_io = zest_gc_batch_endio;
+			__bio_add_page(bio, zi->gc_buf[i].page, PAGE_SIZE, 0);
+		}
+	}
+	if (bio) {
+		atomic64_add(bio->bi_iter.bi_size, &zi->gc_wb_bytes);
+		atomic64_inc(&zi->bio_count);
+		atomic_inc(&io.pending);
+		submit_bio(bio);
+	}
+
+	//Drop the bias: if every submitted bio already completed, this fires
+	//the completion; otherwise the last endio does.
+	if (atomic_dec_and_test(&io.pending))
+		complete(&io.done);
+	wait_for_completion(&io.done);
+	return blk_status_to_errno(io.status);
+}
+
+//zest-gc: evacuate ONE victim zone with the foreground batched flow, modeled on
+//f2fs do_garbage_collect: pick a victim, then under one block-plug repeat
+//{ gather a buffer-sized batch of still-valid pages bounded by the frontier's
+//remaining space -> batch-read -> batch-write to the frontier -> under map_lock
+//verify-and-commit each (l2p unchanged => repoint; else drop the copy) } until
+//the zone is fully scanned; then drain inflight reads, RESET the zone and
+//return it to the freelist. Returns 0 on reclaim, -ENODATA if there is no
+//profitable victim, -ENOSPC if the frontier ran out of space mid-evacuation,
+//else a negative errno.
+//
+//rmap is a validated hint: a victim block is gathered if rmap says "valid",
+//but the new mapping is committed only if l2p[slot] still points at the old
+//victim sector at commit time (verify-before-update). A block the host
+//rewrote/freed during the batch is dropped; its frontier copy becomes dead
+//space, reclaimed when that frontier zone is itself GC'd later.
+int zest_gc_run_one(struct zest_info *zi)
+{
+	unsigned int vidx;
+	struct zest_zone *victim;
+	struct blk_plug plug;
+	unsigned int scan = 0;
+	unsigned int moved = 0, aborted = 0;
+	sector_t len;
+	int err = 0;
+
+	if (unlikely(atomic_read(&zi->fatal)))
+		return -EIO;
+	if (unlikely(!zi->gc_buf_nr))
+		return -ENODATA;
+
+	vidx = zest_gc_pick_victim(zi);
+	if (vidx == ZEST_NO_ZONE)
+		return -ENODATA;
+	victim = &zi->zones[vidx];
+
+	atomic64_inc(&zi->gc_runs);
+	pr_debug("zest-gc: victim zone=%u valid=%u nr_blocks=%u free_zones=%d\n",
+		  vidx, atomic_read(&victim->valid_blocks), victim->nr_blocks,
+		  atomic_read(&zi->nr_free_zones));
+
+	//zest-gc: drain in-flight DATA writes to the victim before reading it.
+	//The victim is FULL and no longer cur_zone, so no NEW writes can target
+	//it; this waits out the tail writes that were still in flight when it
+	//rotated out of cur_zone. Without this, GC could read a block whose
+	//write the device write pointer hasn't passed yet -> stale/garbage data
+	//relocated and committed. smp_mb() orders the drain before the reads.
+	smp_mb();
+	while (atomic_read(&victim->inflight_writes) > 0)
+		cpu_relax();
+
+	blk_start_plug(&plug);
+	while (scan < victim->nr_blocks) {
+		struct zest_zone *fz;
+		unsigned int room, cap, n, wp0, j;
+		sector_t base;
+
+		//Open/rotate the frontier and size the batch to its remaining
+		//space so the whole batch lands sequentially inside one zone.
+		fz = zest_gc_frontier(zi);
+		if (!fz) {
+			err = -ENOSPC;
+			break;
+		}
+		room = fz->nr_blocks - fz->wp_blocks;
+		cap = min(zi->gc_buf_nr, room);
+
+		//Gather up to `cap` still-valid victim blocks (rmap as hint,
+		//read locklessly: a victim is FULL and not a frontier, so its
+		//rmap entries only ever go valid->invalid, never the reverse,
+		//and any stale "valid" is caught by the commit-time l2p check).
+		n = 0;
+		while (scan < victim->nr_blocks && n < cap) {
+			u32 rv = READ_ONCE(victim->rmap[scan]);
+
+			if (rv != ZEST_INVALID_SLOT) {
+				zi->gc_buf[n].slot = rv;
+				zi->gc_buf[n].vblk = scan;
+				n++;
+			}
+			scan++;
+		}
+		if (n == 0)
+			continue;	/* span all dead; keep scanning */
+
+		//zest-ra: reorder the batch by persisted VMA key BEFORE reading, so
+		//VMA-adjacent pages land on adjacent frontier sectors (placement
+		//survives GC). Sort only the {slot,vblk} tuples (via gc_sort scratch);
+		//gc_buf[].page stays bound to its position == device write position.
+		//Gated by switch + vkey_persist + gc_sort; else keep scan order.
+		{
+			u64 *vp = READ_ONCE(zi->vkey_persist);
+
+			if (atomic_read(&zest_ra_dbg) && vp && zi->gc_sort) {
+				unsigned int j;
+
+				for (j = 0; j < n; j++) {
+					zi->gc_sort[j].slot = zi->gc_buf[j].slot;
+					zi->gc_sort[j].vblk = zi->gc_buf[j].vblk;
+					zi->gc_sort[j].key  =
+						READ_ONCE(vp[zi->gc_buf[j].slot]);
+				}
+				sort(zi->gc_sort, n, sizeof(*zi->gc_sort),
+				     zest_gc_sort_cmp, NULL);
+				for (j = 0; j < n; j++) {
+					zi->gc_buf[j].slot = zi->gc_sort[j].slot;
+					zi->gc_buf[j].vblk = zi->gc_sort[j].vblk;
+				}
+			}
+		}
+
+		err = zest_gc_batch_read(zi, victim, n);
+		if (err) {
+			pr_warn_ratelimited("zest-gc: batch read failed err=%d\n",
+					    err);
+			break;
+		}
+
+		//Reserve the contiguous frontier run (gc_thread-only wp), then
+		//write the whole batch out sequentially.
+		wp0 = fz->wp_blocks;
+		base = fz->start_sector + ((sector_t)wp0 << (PAGE_SHIFT - 9));
+		fz->wp_blocks += n;
+
+		err = zest_gc_batch_write(zi, base, n);
+		if (err) {
+			pr_warn_ratelimited("zest-gc: batch write failed err=%d\n",
+					    err);
+			break;
+		}
+
+		//Verify-before-update under map_lock. Aborted entries leave dead
+		//space at their frontier sector (reclaimed at that zone's GC).
+		spin_lock(&zi->map_lock);
+		for (j = 0; j < n; j++) {
+			unsigned int vblk = zi->gc_buf[j].vblk;
+			unsigned long slot = zi->gc_buf[j].slot;
+			sector_t old = victim->start_sector +
+				((sector_t)vblk << (PAGE_SHIFT - 9));
+			sector_t new = base + ((sector_t)j << (PAGE_SHIFT - 9));
+
+			if (zi->l2p[slot] == old) {
+				fz->rmap[wp0 + j] = (u32)slot;
+				atomic_inc(&fz->valid_blocks);
+				WRITE_ONCE(zi->l2p[slot], new);
+				victim->rmap[vblk] = ZEST_INVALID_SLOT;
+				atomic_dec(&victim->valid_blocks);
+				moved++;
+			} else {
+				aborted++;
+			}
+		}
+		spin_unlock(&zi->map_lock);
+		cond_resched();
+	}
+	blk_finish_plug(&plug);
+
+	if (err) {
+		//Partial evacuation: committed blocks already moved (l2p
+		//repointed, victim valid decremented exactly); the victim keeps
+		//the rest and is NOT reset. Caller (thread) backs off / retries.
+		atomic64_add(moved, &zi->gc_moved_blocks);
+		atomic64_add(aborted, &zi->gc_aborts_stale);
+		return err;
+	}
+
+	//Drain readers that may still target the victim, then RESET it.
+	//smp_mb() pairs with the barrier after atomic_inc(inflight_reads) in
+	//zest_swap_readpage. All victim l2p entries are repointed, so no NEW
+	//swap-in can find the victim; only reads that passed their re-check
+	//before the last relocation remain, and the drain waits them out.
+	smp_mb();
+	while (atomic_read(&victim->inflight_reads) > 0)
+		cpu_relax();
+
+	len = (sector_t)victim->nr_blocks << (PAGE_SHIFT - 9);
+	err = blkdev_zone_mgmt(zi->bdev, REQ_OP_ZONE_RESET, victim->start_sector,
+			       len, GFP_NOFS);
+	if (err) {
+		pr_warn("zest-gc: victim zone=%u RESET failed err=%d\n", vidx, err);
+		atomic64_add(moved, &zi->gc_moved_blocks);
+		atomic64_add(aborted, &zi->gc_aborts_stale);
+		return err;
+	}
+
+	//Victim is EMPTY: clear logical state and return it to the freelist.
+	spin_lock(&zi->map_lock);
+	memset(victim->rmap, 0xff, (size_t)victim->nr_blocks * sizeof(u32));
+	atomic_set(&victim->valid_blocks, 0);
+	victim->wp_blocks = 0;
+	spin_unlock(&zi->map_lock);
+
+	spin_lock(&zi->freelist_lock);
+	INIT_LIST_HEAD(&victim->free_node);
+	list_add_tail(&victim->free_node, &zi->freelist);
+	atomic_inc(&zi->nr_free_zones);
+	spin_unlock(&zi->freelist_lock);
+
+	//Wake any swap-out writer blocked on an empty freelist.
+	wake_up_all(&zi->gc_done_wait);
+
+	atomic64_add(moved, &zi->gc_moved_blocks);
+	atomic64_add(aborted, &zi->gc_aborts_stale);
+	atomic64_inc(&zi->gc_zones_reclaimed);
+	pr_debug("zest-gc: reclaimed zone=%u moved=%u aborted=%u free_zones=%d\n",
+		  vidx, moved, aborted, atomic_read(&zi->nr_free_zones));
+	return 0;
+}
+
+//zest-gc: wake the GC thread if the freelist has fallen below the threshold.
+//Cheap enough to call from the swap-out hot path.
+void zest_gc_kick(struct zest_info *zi)
+{
+	if (!zi->gc_thread)
+		return;
+	if (atomic_read(&zi->nr_free_zones) < f2fs_zest_gc_threshold(zi->sbi))
+		wake_up(&zi->gc_wait);
+}
+
+//zest-gc: the single GC executor. Sleeps until kicked (freelist below the
+//threshold), then runs the foreground batched evacuation repeatedly until the
+//freelist is replenished to the target, no profitable victim remains, or it is
+//asked to stop. Gated by the per-sb zest_gc_enable knob so GC can be disabled
+//at runtime without tearing anything down. There is no background cost-benefit
+//policy -- this is the foreground flow, just driven by a dedicated thread so
+//its blocking I/O and zone resets stay off the reclaim/writeback path.
+static int zest_gc_threadfn(void *data)
+{
+	struct zest_info *zi = data;
+
+	while (!kthread_should_stop()) {
+		unsigned int target, threshold;
+		bool progressed = false;
+
+		wait_event_interruptible(zi->gc_wait,
+			kthread_should_stop() ||
+			(f2fs_zest_gc_enabled(zi->sbi) &&
+			 atomic_read(&zi->nr_free_zones) <
+				f2fs_zest_gc_threshold(zi->sbi)));
+
+		if (kthread_should_stop())
+			break;
+		if (!f2fs_zest_gc_enabled(zi->sbi))
+			continue;
+		
+		pr_debug("zest-gc: kicked (free_zones=%d)\n",
+			  atomic_read(&zi->nr_free_zones));
+		target = f2fs_zest_gc_target(zi->sbi);
+		threshold = f2fs_zest_gc_threshold(zi->sbi);
+		if (target < threshold)
+			target = threshold;
+
+		while (!kthread_should_stop() &&
+		       f2fs_zest_gc_enabled(zi->sbi) &&
+		       atomic_read(&zi->nr_free_zones) < target) {
+			int ret = zest_gc_run_one(zi);
+
+			if (ret)
+				break;		/* -ENODATA / -ENOSPC / error */
+			progressed = true;
+			cond_resched();
+		}
+
+		//If we still can't satisfy the threshold and made no progress
+		//this round (no profitable victim, or no space to relocate),
+		//back off briefly so a persistent near-full state doesn't busy
+		//-spin the CPU re-evaluating the same wait condition.
+		if (!progressed &&
+		    atomic_read(&zi->nr_free_zones) <
+			    f2fs_zest_gc_threshold(zi->sbi))
+			schedule_timeout_interruptible(HZ / 10);
+	}
+	return 0;
+}
+
+int zest_gc_thread_start(struct zest_info *zi)
+{
+	struct task_struct *t;
+
+	t = kthread_run(zest_gc_threadfn, zi, "zest-gc/%pg", zi->bdev);
+	if (IS_ERR(t))
+		return PTR_ERR(t);
+	zi->gc_thread = t;
+	return 0;
+}
+
+void zest_gc_thread_stop(struct zest_info *zi)
+{
+	if (zi->gc_thread) {
+		kthread_stop(zi->gc_thread);
+		zi->gc_thread = NULL;
+	}
+}
+
+/* -------------------------------------------------------------- */
+/* Module init                                                    */
+/* -------------------------------------------------------------- */
+
+static int __init zest_init(void)
+{
+	int ret;
+
+	atomic64_set(&zest_stats.redirect_data, 0);
+	atomic64_set(&zest_stats.redirect_node, 0);
+
+	ret = zest_sysfs_init();
+	if (ret) {
+		pr_err("sysfs init failed: %d\n", ret);
+		return ret;
+	}
+
+	pr_notice("ZEST loaded; disabled by default\n");
+	return 0;
+}
+
+fs_initcall(zest_init);
