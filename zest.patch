+static ssize_t stats_show(struct kobject *kobj, struct kobj_attribute *attr,
+			  char *buf)
+{
+	struct zest_gc_stats_sum gc;
+	u64 avg_pages, avg_kb, avg_bio_kb, total_wb, write_amp_milli;
+	u64 rc_total, rc_evicts, rc_hit_milli, rc_prec_milli;
+
+	zest_gc_collect_stats(&gc);
+
+	//zest-rc (v3): hit_rate = hits/(hits+misses) -- how often a fault is served
+	//from RAM. precision = useful/(useful+wasted) over the eviction ledger --
+	//how much of what prefetch published was ever used; THE judge of the window
+	//policy (low precision = the prefetch wastes bandwidth). Both x1000.
+	rc_total = gc.rc_hits + gc.rc_misses;
+	rc_hit_milli = rc_total ? div64_u64(gc.rc_hits * 1000ULL, rc_total) : 0;
+	rc_evicts = gc.rc_useful_evict + gc.rc_wasted_evict;
+	rc_prec_milli = rc_evicts ?
+		div64_u64(gc.rc_useful_evict * 1000ULL, rc_evicts) : 0;
+
+	//zest-wbuf: average buffer-flush size. Compare avg_flush_kb against
+	//wbuf_cap_kb: ~= cap means full big flushes (good); much smaller means
+	//flushes are dribbling out and bandwidth suffers.
+	avg_pages = gc.flush_count ? gc.flush_pages / gc.flush_count : 0;
+	avg_kb = avg_pages << (PAGE_SHIFT - 10);
+
+	//zest-ra: total device write = host buffer flush + GC relocation.
+	total_wb = gc.host_wb_bytes + gc.gc_wb_bytes;
+	//Average bio size across both -- reflects bio_add_page coalescing
+	//(contiguous ~= max_hw; scattered ~= 512K).
+	avg_bio_kb = gc.bio_count ? div64_u64(total_wb, gc.bio_count) >> 10 : 0;
+	//Write amplification = total / host-data, x1000 fixed-point (1.000 = no GC
+	//overhead). Host bytes can be 0 before the first flush -> report 0.
+	write_amp_milli = gc.host_wb_bytes ?
+		div64_u64(total_wb * 1000ULL, gc.host_wb_bytes) : 0;
