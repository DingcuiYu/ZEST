+	WRITE_ONCE(swapout_slot_order_tracking, enabled);
+}
+
+void swapout_slot_order_record(struct page *page)
+{
+	struct folio *folio = page_folio(page);
+	struct swap_info_struct *sis = page_swap_info(page);
+	struct swap_info_ext *sie = to_swap_info_ext(sis);
+	unsigned long offset = swp_offset(folio->swap);
+	unsigned int nr_pages = folio_nr_pages(folio);
+	u64 order;
+	unsigned int i;
+
+	if (!READ_ONCE(swapout_slot_order_tracking))
+		return;
+	if (!sie || !READ_ONCE(sie->slot_order_map))
+		return;
+	if (offset >= sis->max)
+		return;
+
+	nr_pages = min_t(unsigned int, nr_pages, sis->max - offset);
+	order = atomic64_inc_return(&swapout_slot_order_next);
+	for (i = 0; i < nr_pages; i++)
+		WRITE_ONCE(sie->slot_order_map[offset + i], order);
+}
+
+u64 swapout_slot_order_lookup(swp_entry_t entry)
+{
+	struct swap_info_struct *sis = swp_swap_info(entry);
+	struct swap_info_ext *sie;
+	unsigned long offset = swp_offset(entry);
+
+	if (!sis || offset >= sis->max)
+		return 0;
+	sie = to_swap_info_ext(sis);
+	if (!sie || !READ_ONCE(sie->slot_order_map))
+		return 0;
+
+	return READ_ONCE(sie->slot_order_map[offset]);
+}
