+static u64 swap_slot_reread_monitor_total_io_reads;
+static u64 swap_slot_reread_monitor_repeated_io_reads;
+static u64 swap_slot_reread_monitor_freed_read_slots;
+static u64 swap_slot_reread_monitor_freed_repeated_slots;
