+		"wbuf_flushes: %llu\n"
+		"wbuf_flush_pages: %llu\n"
+		"wbuf_avg_flush_kb: %llu\n"
+		"wbuf_cap_kb: %u\n"
+		"avg_bio_kb: %llu\n"
+		"host_wb_kb: %llu\n"
+		"gc_wb_kb: %llu\n"
+		"total_wb_kb: %llu\n"
+		"write_amp: %llu.%03llu\n"
+		"rc_on: %u\n"
+		"rc_ways: %u\n"
+		"rc_hits: %llu\n"
