+
+//zest-gc: sentinel for "no GC write frontier currently open".
+#define ZEST_NO_ZONE		((unsigned int)-1)
+#define ZEST_INVALID_SECTOR	((sector_t)-1)
+#define ZEST_INVALID_SLOT	((u32)-1)
+
+//zest-wbuf: L2P third state. A live l2p[] entry is now one of:
+//  ZEST_INVALID_SECTOR (-1)      -> unmapped
+//  (v != -1) && (v & ZEST_BUF_FLAG) -> staged in a RAM write buffer; the low
+//                                    bits are the GLOBAL buffer page index
+//                                    (gidx). Served from RAM on read, committed
+//                                    to a real device sector by the flush
+//                                    end-of-write path.
+//  otherwise                     -> a real 512B device sector.
+//gidx is tiny (< ZEST_WBUF_COUNT * cap_pages), so ZEST_BUF_FLAG|gidx can never
+//collide with the all-ones ZEST_INVALID_SECTOR. Always test ==INVALID first,
+//then the flag. See zest_swap_writepage / zest_swap_readpage / the flush path.
+#define ZEST_BUF_FLAG		((sector_t)1ULL << 63)
+
+static inline bool zest_l2p_is_buf(sector_t v)
+{
+	return v != ZEST_INVALID_SECTOR && (v & ZEST_BUF_FLAG);
+}
+static inline u32 zest_l2p_gidx(sector_t v)
+{
+	return (u32)(v & ~ZEST_BUF_FLAG);
+}
+static inline sector_t zest_l2p_mk_buf(u32 gidx)
+{
+	return ZEST_BUF_FLAG | (sector_t)gidx;
+}
+
+//zest-gc: GC migration buffer size, in PAGE-sized blocks (2 MiB). One batch
+//of victim valid pages is read into this buffer then written to the GC write
+//frontier. Owned exclusively by the single GC executor (gc_thread) -> no lock.
+#define ZEST_GC_BUF_PAGES	512u
+
+//zest-gc: number of free zones the host allocator must always leave for GC to
+//use as its write frontier. Without this reserve a swap-out that blocks
+//waiting for GC could deadlock: GC needs >=1 free zone to relocate into before
+//it can free a victim. The host refuses to consume the last ZEST_GC_RESERVE
+//free zones and waits for GC instead; GC alone may dip into them because every
+//reclaimed victim returns a zone to the freelist.
+#define ZEST_GC_RESERVE		1u
+
+//zest-gc: max times a swap-out writer re-waits for GC to free a zone before it
+//gives up and rejects the page (folio re-dirtied, mm retries later). Each wait
+//is bounded (HZ/5), so this caps the total block to ~2s -- after that the swap
+//device is genuinely out of reclaimable space and GC can't keep up.
+#define ZEST_GC_WAIT_MAX	10u
+
+//zest-wbuf: RAM write-staging buffer ring. Swap-out memcpy's the folio into one
+//of these PHYSICALLY-CONTIGUOUS buffers and acks immediately (early
+//folio_end_writeback); a dedicated ORDERED workqueue flushes a full/sealed
+//buffer to the zoned device as one large contiguous bio (so the device sees big
+//sequential writes -- its high-bandwidth regime, ~290 vs ~200 MB/s for 4K-
+//granular bios), assigning the zone write pointer only at flush time. Replaces
+//the old folio-packing wbio accumulator (capped at 512K by the 128-segment 4K
+//scatter limit). See zest_swap_writepage and the flush path in zest_main.c.
+//
+//ZEST_WBUF_BYTES is the target size of EACH buffer; the device write-bandwidth
+//vs block-size knee measured ~292 MB/s at 4 MiB. ZEST_WBUF_COUNT buffers form a
+//ping-pong ring so writers can fill one while another flushes.
+#define ZEST_WBUF_BYTES		(4u << 20)	/* 4 MiB per buffer */
+#define ZEST_WBUF_COUNT		2u		/* ping-pong ring depth */
+
+//zest-znswap: swap-cache retention threshold (ZNSwap-style), in free zones.
+//For the ZEST swapfile we override the kernel's device-agnostic vm_swap_full()
+//"swap >50% full -> trim swap cache" heuristic: that heuristic exists to spare
+//a *device-managed* FTL's GC from extra valid data, but ZEST's GC is
+//host-managed, so it's pointless here. While the freelist holds STRICTLY MORE
+//than this many free zones we keep swapped-in clean pages' slots, so a later
+//reclaim can drop them WITHOUT rewriting (the on-device copy is still valid).
+//At/below it we fall back to normal trimming so zones don't fill. Lower =
+//retain more aggressively (fewer rewrites, less zone headroom). Tunable via
+///sys/kernel/zest/cache_retain_min_free.
+#define ZEST_CACHE_RETAIN_MIN_FREE	2u
+
+//zest-rc (v3): ZEST-private swap-in read cache -- a 4K-page, set-associative
+//landing zone for VMA-predicted ASYNC prefetch. The v1/v2 physically-aligned
+//window prefetch is GONE: measurement showed pages written together are almost
+//never faulted back together (<=2 of any 32-neighbor write window), so a
+//physical window's hit ceiling was hopeless. VMA-space runs are real (~half of
+//all faulted pages sit in runs >=2), but their slots map to SCATTERED device
+//sectors, so fills are individual 4K reads issued ASYNCHRONOUSLY off the fault
+//path (prefetch engine wired separately; this file provides the cache substrate:
+//lookup / invalidate / claim / fill_done). The fault path NEVER waits on a
+//fill: a lookup that finds its slot busy just misses and the caller submits its
+//own read immediately (the duplicate IO is tolerated and counted). Gated by
+///sys/kernel/zest/read_cache, sized by /sys/kernel/zest/read_cache_slots (takes
+//effect at the next swapon/enable). Run with vm.page-cluster=0: ZEST owns
+//prefetch; the kernel's own swap readahead must be off.
+#define ZEST_RC_WAYS		8u	/* set associativity */
+#define ZEST_RC_SLOTS_DEFAULT	1024u	/* total cache pages (4 MiB) */
+
+//zest-vra: the VMA-readahead prefetch engine feeding the read cache. The
+//fault path (zest_swapin_readahead in mm/swap_state.c) collects VMA-neighbor
+//slots and hands them over via __zest_swap_ra_submit(); by default they go
+//through a kfifo to a dedicated worker (WQ_UNBOUND|WQ_SYSFS -- pin it to big
+//cores via /sys/devices/virtual/workqueue/zest_vra/cpumask) which translates
+//L2P, claims a cache way, and submits one async 4K read per slot tagged
+//REQ_RAHEAD + IOPRIO_CLASS_IDLE so prefetch never queues ahead of fault
+//reads. bio completions land on a lockless llist and are published by the
+//worker in process context (fill_done takes the rc rwlock, which must stay
+//irq-unsafe for the hot fault path). vra_inline=1 bypasses the worker and
+//submits straight from fault context (A/B for worker wakeup latency).
+//ZEST_VRA_FIFO is the request queue depth (u32 slots; overflow = drop+count).
+#define ZEST_VRA_FIFO		4096u
+//zest-vra (M3): window-size histogram buckets, by ilog2 of the window the
+//adaptive policy chose per readahead round: [1] [2-3] [4-7] [8-15] [16-31]
+//[32]. Bucket 0 ("stayed quiet on a singleton") vs the top buckets ("opened
+//up on a stream") is the at-a-glance check that adaptation actually bites.
+#define ZEST_VRA_WIN_BUCKETS	6u
+
+/*
+ * Global, subsystem-wide ZEST stats. They are atomic64 so userspace can
+ * read them without holding any lock.
+ *
+ * Per-cpu counters could be faster, but cold/warm redirect happens at
+ * F2FS write-back rate -- not hot enough to matter on a phone.
+ */
+struct zest_global_stats {
+	atomic64_t	redirect_data;	/* COLD_DATA -> WARM_DATA */
+	atomic64_t	redirect_node;	/* COLD_NODE -> WARM_NODE */
+};
+
+extern struct zest_global_stats zest_stats;
+
+//zest-znswap: runtime-tunable swap-cache retention threshold (free zones).
+//Read on the reclaim/fault path via __zest_swap_retain_cache(); written via
+///sys/kernel/zest/cache_retain_min_free. See ZEST_CACHE_RETAIN_MIN_FREE.
+extern unsigned int zest_cache_retain_min_free;
+
+//zest-ra (debug): master switch for the VMA-readahead placement instrumentation
+//(/sys/kernel/zest/ra_debug). 0 = off (default): no vkey alloc, no capture, no
+//stats -- zero overhead. 1 = on. Flipped via zest_ra_debug_set(), read
+//locklessly on the write/flush paths.
+extern atomic_t zest_ra_dbg;
+int zest_ra_debug_set(bool on);
+//zest-ra: write-side VMA placement mode (/sys/kernel/zest/wbuf_sort), only
+//effective with ra_debug=1 (the vkey capture). 0 = off (default; ra_debug
+//measures, never reorders), 1 = bounce gather-copy (big bios kept, +1 copy),
+//2 = zero-copy permuted bio (no copy, bvecs fragment where VMA order
+//diverges from arrival order). Read per flush in zest_wbuf_flush_work.
+extern unsigned int zest_wbuf_sort;
+
+//zest-rc: master switch for the swap-in read cache (/sys/kernel/zest/read_cache).
+//0 = off (default), 1 = on. On enable the per-swapfile cache is allocated
+//(best-effort) if a swapfile is registered; on disable the lookup/fill paths
+//just short-circuit -- the cache memory is NOT freed at runtime (an in-flight
+//fill DMAs into it), only at swapoff. Read locklessly on the swap-in path.
+//See zest_rc_enable_set().
+extern atomic_t zest_rc_enable;
+int zest_rc_enable_set(bool on);
+//zest-rc (v3): cache size in total pages (= ways), /sys/kernel/zest/
+//read_cache_slots. Read at alloc time only (next swapon / runtime enable);
+//rounded so the set count is a power of two.
+extern unsigned int zest_rc_slots;
+
+//zest-vra: readahead window MAX in pages, /sys/kernel/zest/vra_win. 0 = engine
+//off (default; the kernel's own readahead then applies). Effective only with
+//the read cache on (fills land there). Clamped to ZEST_SWAP_RA_WIN_MAX.
+//M3: this is the cap handed to the adaptive policy (__swapin_nr_pages in
+//mm/swap_state.c) -- the actual per-round window grows/shrinks with hits.
+extern unsigned int zest_vra_win;
+//zest-vra: submission mode, /sys/kernel/zest/vra_inline. 0 (default) = hand
+//requests to the big-core worker; 1 = L2P+claim+submit_bio directly in fault
+//context (the bio itself is still async). A/B knob for worker wakeup latency.
+extern atomic_t zest_vra_inline;
+//zest-vra (M3.5): max prefetch fills in flight at the DEVICE, /sys/kernel/
+//zest/vra_inflight. 0 = unlimited (legacy; the only cap is free cache ways,
+//~1000 -- measured to stuff the UFS internal queue and inflate demand-read
+//latency ~1.5x). Set to the QD where random read saturates (FIO: ~4-8): a
+//demand read then waits behind at most this many fills. Worker mode WAITS
+//when at the cap (requests queue in the fifo); inline mode DROPS (the fault
+//path must never sleep on a hint) and counts ra_throttled.
+extern unsigned int zest_vra_inflight;
+
+//zest3: per-zone state for the ZEST sequential allocator.
+//Each entry maps to one physical zone on `bdev` that the swapfile
+//occupies. nr_blocks is the zone capacity in PAGE-sized blocks
+//(zone_sectors >> (PAGE_SHIFT - 9)).
+//
+//No explicit state field: the host write frontier advances strictly
+//sequentially (the single ordered flush worker is the sole writer of cur_zone
+/// wp_blocks), so EMPTY/OPEN/FULL is fully derivable from wp_blocks:
+//  wp_blocks == 0           -> EMPTY
+//  0 < wp_blocks < nr_blocks -> OPEN (only ever cur_zone)
+//  wp_blocks == nr_blocks   -> FULL
+struct zest_zone {
+	sector_t	start_sector;	/* 512B sector on bdev */
+	unsigned int	nr_blocks;	/* capacity in PAGE-sized blocks */
+	unsigned int	wp_blocks;	/* next-write offset (0..nr_blocks) */ //host front: flush worker only; GC front: gc_thread only
+	atomic_t	valid_blocks;	/* live mappings; transitions under zi->map_lock */
+	struct list_head free_node;	//zest3: freelist linkage
+	atomic_t	inflight_reads;	//zest3: outstanding read bios targeting this zone
+	//zest-wbuf: outstanding DATA-write bios targeting this zone. The flush
+	//worker increments it per segment before submit and drops it AFTER the
+	//device write completes and the map is committed. GC drains this to 0
+	//before reading a victim: a zone can be software-FULL (wp==nr_blocks)
+	//while its tail writes are still in flight, and on a zoned device reading
+	//a block whose device write pointer hasn't passed yet returns stale/
+	//garbage data.
+	atomic_t	inflight_writes;
+
+	//zest-gc: reverse map, index = block offset within the zone
+	//(0..nr_blocks), value = swap slot, ZEST_INVALID_SLOT == free.
+	//kvmalloc'd to nr_blocks entries, then filled with the invalid
+	//sentinel. Maintained in lockstep with zi->l2p[] under zi->map_lock
+	//so it has NO false-negatives: for every live l2p[K]=S,
+	//rmap[(S-start)>>shift] == K. GC enumerates victim blocks via rmap
+	//(a hint) then re-validates against l2p[] before migrating.
+	u32		*rmap;
+	//zest-gc: set while this zone is the GC write frontier (gc_cur_zone).
+	//Excluded from victim selection. Only ever touched by the single GC
+	//executor (gc_thread), so it needs no lock.
+	bool		is_gc_front;
+};
+
+//zest-gc: one entry of the GC migration buffer. During evacuation a batch of
+//victim valid pages is read into ent.page, tagged with the swap slot it holds
+//and the victim block it came from, so the post-write verify-and-commit step
+//can re-check l2p[slot] and compute the old sector.
+struct zest_gc_ent {
+	struct page	*page;	/* preallocated migration page */
+	u32		slot;	/* swap slot this page holds */
+	unsigned int	vblk;	/* block offset within the victim zone */
+};
+
+//zest-wbuf: one staging buffer in the ping-pong ring.
+//  FREE     -> recycled, available to become the next FILLING buffer.
+//  FILLING  -> the current cur buffer accepting memcpy'd swap-out pages.
+//  FLUSHING -> sealed; its flush_work is queued/running, writing it to device.
+//pages[] are PHYSICALLY CONTIGUOUS when `base` was allocated as a high-order
+//run (the fast path that lets bio_add_page coalesce into a few large segments
+//-> big device requests). On the fragmented fallback they are independent
+//pages (functional, but small segments like the old wbio).
+enum zest_wbuf_state { ZEST_WBUF_FREE, ZEST_WBUF_FILLING, ZEST_WBUF_FLUSHING };
+
+//zest-ra: per staged page, the VMA logical coordinate captured at memcpy time.
+//It MUST be grabbed then, not at flush time: the wbuf early-acks the folio
+//(folio_end_writeback) at memcpy, so the original folio is typically freed
+//before the (deferred, ordered) flush runs. av = anon_vma pointer (0 == not a
+//plain-anon page: shmem/KSM/other); idx = folio->index, which for private anon
+//equals the page's virtual page number (address >> PAGE_SHIFT) and is identical
+//across processes that share the anon_vma (fork/COW). At flush time this drives
+//(a) the optional placement reorder -- sort staged pages by (av,idx) so VMA-
+//adjacent pages land on adjacent device sectors for swap-in readahead merging --
+//and (b) the segment-count stats. The array is allocated ONLY while the runtime
+///sys/kernel/zest/ra_debug switch is on (NULL otherwise -> zero overhead).
+struct zest_vkey {
+	unsigned long	av;	/* anon_vma ptr; 0 if not plain anon */
+	pgoff_t		idx;	/* folio index == virtual page number for anon */
+};
+
+//zest-ra: scratch triple used to sort a GC migration batch by VMA key before
+//reading victim blocks into the (contiguous) gc_buf. The page never moves -- only
+//these {slot,vblk} tuples are reordered -- so gc_buf[j].page stays bound to its
+//buffer position j (= the device write position). See zest_gc_run_one.
+struct zest_gc_sort {
+	u32	slot;
+	u32	vblk;
+	u64	key;	/* packed (hash32(av)<<32)|idx; 0 == no key */
+};
+
+struct zest_wbuf {
+	struct page		**pages;	/* cap entries; data lives here */
+	struct page		*base;		/* high-order run head, NULL if fragmented */
+	unsigned int		order;		/* alloc order of `base` (fast path) */
+	bool			contig;		/* true: base+order run; false: per-page */
+	u32			*bslot;		/* bslot[i] = swap slot staged in page i */
+	struct zest_vkey	*vkey;		/* vkey[i] = VMA coord of staged page i; NULL unless ra_debug on */
+	unsigned int		cap;		/* capacity in PAGE-sized blocks */
+	unsigned int		gbase;		/* global page-index base (ring slot * cap) */
+	unsigned int		fill;		/* claimed pages [0,fill); under zi->buf_lock */
+	unsigned int		sealed_fill;	/* fill snapshot at seal; flush reads it */
+	atomic_t		copied;		/* pages whose memcpy finished (lockless) */
+	enum zest_wbuf_state	state;		/* under zi->buf_lock */
+	struct work_struct	flush_work;	/* queued on zi->wbuf_wq (ordered) */
+	struct zest_info	*zi;		/* back-pointer for the work fn */
+};
+
+//zest-rc (v3): one cache way. `slot` is the key (ZEST_INVALID_SLOT = empty);
+//`page` is its preallocated 4K backing page. `busy` marks an async fill in
+//flight (claim -> fill_done window): the way is invisible to lookups meanwhile
+//(they miss and direct-read; never wait). `raced` records that a fault
+//direct-read overtook the in-flight fill (the fill is late = duplicate IO);
+//`hit` records the published page was served at least once (drives the
+//precision ledger at eviction).
+struct zest_rc_way {
+	u32		slot;
+	bool		busy;
+	bool		raced;
+	bool		hit;
+	struct page	*page;
+	//zest-vra: fill context, OWNED by the prefetch engine while busy (claim
+	//guarantees exclusivity: a busy way is never retargeted). Carries what
+	//the bio endio needs (it only gets the way pointer): fill_slot is the
+	//claim-time key (way->slot may be invalidated mid-flight, fill_done
+	//compares against this); fill_zone holds the inflight_reads ref to drop;
+	//fill_ok is the bio status; fill_node queues the completion to the
+	//worker (fill_done takes the rc rwlock -> must run in process context).
+	struct zest_info *fill_zi;
+	struct zest_zone *fill_zone;
+	u32		fill_slot;
+	bool		fill_ok;
+	struct llist_node fill_node;
+};
+
+//zest-rc (v3): set-associative swap-in read cache state.
+//Consistency model (unchanged from v1):
+//  - keyed by SLOT: a hit serves way->page regardless of where l2p[slot] points
+//    now (GC relocates identical bytes -> no GC hook); free/rewrite are caught
+//    by zest_rc_invalidate_slot at the two L2P mutation points -- both run
+//    under map_lock, which also serializes invalidates of the same slot.
+//  - lock is an rwlock: READ side = lookup (memcpy out) + invalidate (single
+//    WRITE_ONCE, idempotent); WRITE side = claim/fill_done (the only places
+//    that retarget a way). Lock order map_lock -> lock (invalidate holds
+//    map_lock first; lookup/claim/fill_done take lock alone). `busy` covers
+//    the lockless fill DMA: claim sets it under the write lock (draining
+//    in-flight lookups), so a lookup never copies from a page an async fill
+//    is writing into.
+//  - ledgers: every claim ends exactly once as fill_pages (published) or
+//    fill_aborts (IO error / invalidated mid-flight); every PUBLISHED page
+//    exits exactly once via useful_evict or wasted_evict (claim eviction or
+//    live invalidate) -- precision = useful/(useful+wasted) is the core
+//    "was the prefetch right" metric.
+struct zest_rcache {
+	rwlock_t	lock;		/* rc_lock */
+	bool		ready;		/* arrays allocated (swapon/enable -> swapoff) */
+	unsigned int	nr_ways;	/* total ways == cache pages (nr_sets * WAYS) */
+	unsigned int	nr_sets;	/* power of two */
+	unsigned int	set_shift;	/* ilog2(nr_sets), for the hash_32 set index */
+	unsigned int	victim_rr;	/* round-robin victim cursor (under write lock) */
+	struct zest_rc_way *ways;	/* kvcalloc'd, set-major: set s = ways[s*WAYS..] */
+	//Telemetry (counted whenever the cache is allocated).
+	atomic64_t	hits;		/* lookups served from cache */
+	atomic64_t	misses;		/* lookups that found nothing usable */
+	atomic64_t	busy_direct;	/* lookups that hit a busy way -> direct read (dup IO) */
+	atomic64_t	fills;		/* successful claims (fill intents) */
+	atomic64_t	fill_pages;	/* fills published live into the cache */
+	atomic64_t	fill_aborts;	/* fills discarded (IO error / invalidated mid-flight) */
+	atomic64_t	fill_drops;	/* claims rejected: every way in the set busy */
+	atomic64_t	fill_dups;	/* claims rejected: slot already cached / in flight */
+	atomic64_t	late_fills;	/* fills published after a direct read overtook them */
+	atomic64_t	useful_evict;	/* published pages that left after >=1 hit */
+	atomic64_t	wasted_evict;	/* published pages that left without ever being hit */
+};
+
+/*
+ * Registry entry. zest_init_for_swapfile populates everything below
+ * and zest_release_for_swapfile tears it down.
+ */
+struct zest_info {
+	struct f2fs_sb_info	*sbi;
+	struct swap_info_struct	*sis;
+	struct block_device	*bdev;
+
+	//zest3: L2P map -- index = swap slot in [0, nr_slots),
+	//value = 512B sector on bdev, ZEST_INVALID_SECTOR means unmapped.
+	//Allocated and filled with the invalid sentinel because sector 0 can
+	//be a valid physical address on some devices.
+	sector_t		*l2p;
+	unsigned long		nr_slots;	/* == sis->max at init time */
+
+	//zest-ra: persisted VMA sort key per swap slot, parallel to l2p[]. Packed
+	//(hash32(anon_vma)<<32)|(u32)folio_index; 0 == none. Written at host-flush
+	//commit IN LOCKSTEP with l2p[slot] under map_lock (only when the slot still
+	//maps here), read locklessly as a hint by GC to re-sort a migration batch so
+	//VMA placement survives compaction. NULL unless the ra placement switch was
+	//on; allocated at swapon (or best-effort on runtime enable), freed only at
+	//swapoff (the GC kthread reads it locklessly -> no safe runtime free).
+	u64			*vkey_persist;
+
+	//zest3: zone array, kvzalloc'd. Sorted by start_sector ascending,
+	//covers the swap-visible zones PLUS the auto-reserved over-provisioning
+	//(OP) zones. cur_zone is the allocator cursor cycling through zones
+	//circularly.
+	unsigned int		nr_zones;
+	struct zest_zone	*zones;
+	unsigned int		cur_zone;
+
+	//zest3: over-provisioning region, in F2FS blocks, on the swapfile
+	//inode just past the swap-visible size [op_start_lblk, +op_nr_blocks).
+	//Reserved at swapon via f2fs_zest_reserve_op_section() and kept across
+	//swapoff (freed only when the swapfile is deleted). op_nr_blocks==0
+	//means "no OP headroom" (degraded but functional).
+	unsigned int		op_start_lblk;
+	unsigned int		op_nr_blocks;
+
+	//zest-wbuf: io_lock is GONE. The old mutex serialized allocate-wp +
+	//build-bio + submit_bio so writes reached the zoned device in write-
+	//pointer order. That ordering is now provided by the single-threaded
+	//(ordered) wbuf_wq, the sole host writer of cur_zone / wp_blocks; the swap
+	//-out path only copies into RAM and never submits a device write.
+
+	//zest-wbuf: RAM write-staging buffer ring (replaces the folio-packing
+	//wbio). Swap-out memcpy's into the FILLING buffer and acks immediately;
+	//a full/sealed buffer is flushed to the device by the ordered wbuf_wq as
+	//one big contiguous bio, with the zone write pointer allocated only at
+	//flush time. io_lock is GONE from the write path: device-write ordering
+	//is provided by the single-threaded (ordered) wbuf_wq instead.
+	//  - buf_lock guards wbuf_cur, each buffer's `fill`, and the FILLING->
+	//    FLUSHING seal. Tiny critical section: no memcpy, no submit under it.
+	//  - wb->copied is a lockless atomic (producer adds after its memcpy);
+	//    the flush worker waits copied >= sealed_fill before building the bio.
+	//  - writers that need a fresh buffer but find none FREE wait on
+	//    wbuf_free_wait (bounded) then reject (folio re-dirtied) -- the
+	//    pressure valve, equivalent to the old "no free zone" reject.
+	struct zest_wbuf	wbufs[ZEST_WBUF_COUNT];
+	unsigned int		wbuf_cap;	/* pages per buffer (all equal) */
+	unsigned int		wbuf_cur;	/* index of the FILLING buffer */
+	spinlock_t		buf_lock;	/* guards wbuf_cur, fill, state/seal */
+	wait_queue_head_t	wbuf_free_wait;	/* writers wait for a FREE buffer */
+	struct workqueue_struct *wbuf_wq;	/* ORDERED: serializes flushes -> wp order */
+
+	//zest-ra: write-only PHYSICALLY-CONTIGUOUS bounce buffer (cap == wbuf_cap).
+	//When the placement reorder is on, the flush worker gather-copies staging
+	//pages into this buffer in VMA-sorted order, then builds the device bio over
+	//these contiguous pages -- preserving the big-request (high bandwidth) write
+	//while reordering, without mutating staging (which still serves swap-in reads
+	//by gidx). Only pages/base/order/contig/cap are used (allocated via the same
+	//zest_wbuf_alloc_one helper). NULL if reorder never enabled or alloc failed
+	//(then flush writes staging in arrival order -- correct, no read gain). The
+	//ordered wbuf_wq runs one flush at a time, so a single bounce is sufficient.
+	//Freed only at swapoff (in use by the flush worker outside dbg_mutex).
+	struct zest_wbuf	bounce;
+
+	//zest-rc: swap-in read cache (v3, 4K-slot set-associative). Allocated
+	//at swapon when /sys/kernel/zest/read_cache is on; freed at swapoff after
+	//the per-zone inflight_reads drain (an in-flight fill holds a ref there).
+	struct zest_rcache	rc;
+
+	//zest-vra: VMA-readahead prefetch engine (see the block comment at
+	//ZEST_VRA_FIFO). ra_wq/ra_fifo allocated at swapon (best-effort: NULL
+	//ra_wq = engine off, degraded-safe); torn down in release BEFORE the
+	//read cache is freed. ra_dead gates teardown: set (then cancel the
+	//worker) before the per-zone inflight drain so no NEW fills are
+	//submitted while zones are being reset; completions of already-flying
+	//fills still get published by late worker runs (rc is alive until
+	//zest_rc_free below).
+	struct workqueue_struct *ra_wq;		/* WQ_UNBOUND|WQ_SYSFS, 1 active */
+	struct work_struct	ra_work;
+	DECLARE_KFIFO_PTR(ra_fifo, u32);	/* prefetch slot requests */
+	spinlock_t		ra_fifo_lock;	/* multi-producer in, worker out */
+	struct llist_head	ra_done;	/* fill completions (from endio) */
+	bool			ra_dead;	/* teardown: stop submitting */
+	//zest-vra (M3.5): fills currently in flight at the device (inc just
+	//before submit_bio, dec in the endio). The worker sleeps on
+	//ra_throttle_wq while >= zest_vra_inflight (woken by the endio and by
+	//teardown after setting ra_dead).
+	atomic_t		ra_inflight;
+	wait_queue_head_t	ra_throttle_wq;
+	//zest-vra stats: enq = slots handed over by the fault path; fifo_full =
+	//dropped on a full queue; skip = dropped at L2P translate (unmapped /
+	//still in the write buffer -> a fault would be served from RAM anyway);
+	//submitted = prefetch bios actually issued.
+	atomic64_t		ra_enq;
+	atomic64_t		ra_fifo_full;
+	atomic64_t		ra_skip;
+	atomic64_t		ra_submitted;
+	//zest-vra (M3.5): throttled = requests dropped at the inflight cap
+	//(inline mode only; the worker waits instead of dropping).
+	atomic64_t		ra_throttled;
+	//zest-vra (M3): peek_hits = faults whose slot the attribution probe found
+	//already in the cache (live or in flight) -> hits credit, NO re-collection
+	//(should track rc.hits; a persistent surplus = pages evicted between
+	//prefetch and fault, i.e. the cache is too small). win_hist = windows the
+	//adaptive policy chose, bucketed by ilog2 (see ZEST_VRA_WIN_BUCKETS).
+	atomic64_t		ra_peek_hits;
+	atomic64_t		ra_win_hist[ZEST_VRA_WIN_BUCKETS];
+
+	//zest-ra: write telemetry (ALWAYS counted, independent of the switch).
+	//bio_count = number of submit_bio across host flush + GC (for avg bio size).
+	//host_wb_bytes / gc_wb_bytes = device bytes written by the host buffer flush
+	//vs GC relocation, summed by bio->bi_iter.bi_size per submit. Surfaced via
+	///sys/kernel/zest/stats as: avg_bio_kb = (host+gc)/bio_count (coalescing),
+	//total_write_kb = host+gc, write_amp = (host+gc)/host (GC write overhead).
+	atomic64_t		bio_count;
+	atomic64_t		host_wb_bytes;
+	atomic64_t		gc_wb_bytes;
+
+	//zest-wbuf: flush-size telemetry. flush_count = number of buffer flushes,
+	//flush_pages = total pages flushed. avg flush size = flush_pages/flush_count
+	//(in pages); surfaced via /sys/kernel/zest/stats to diagnose whether flushes
+	//actually reach the buffer cap (big bios) or are dribbling out small.
+	atomic64_t		flush_count;
+	atomic64_t		flush_pages;
+
+	//zest-ra (debug): VMA-readahead placement instrumentation. dbg_mutex
+	//serializes the per-wbuf vkey[] array lifetime (alloc on ra_debug=1,
+	//free on ra_debug=0/swapoff) against the flush worker's stats read, so
+	//the read can never touch a freed array. The four atomic64 are running
+	//sums over flushes seen while the switch was on; avg = sum/seg_flushes,
+	//logged (rate-limited) by zest_dbg_seg_stats(). All idle/zero while the
+	//switch is off.
+	struct mutex		dbg_mutex;
+	atomic64_t		dbg_vma_segs;	/* sum of VMA-contiguous runs */
+	atomic64_t		dbg_slot_segs;	/* sum of slot-contiguous runs (same anon subset) */
+	atomic64_t		dbg_seg_pages;	/* sum of anon pages measured */
+	atomic64_t		dbg_seg_flushes;/* flushes measured (the denominator) */
+
+	//zest3: freelist of zones with wp_blocks == 0 (EMPTY). GC returns
+	//zones here after reset; swap-out pops when cur_zone fills.
+	struct list_head	freelist;
+	spinlock_t		freelist_lock;
+	//zest-gc: O(1) freelist depth, kept in sync with adds/removes under
+	//freelist_lock. Read locklessly by the GC trigger / kthread loop.
+	atomic_t		nr_free_zones;
+
+	//zest-gc: sole consistency point for the logical maps. Guards every
+	//transition of l2p[], each zone->rmap[], and zone valid_blocks. A
+	//spinlock (not a mutex) so the swap-slot-free hook -- which runs under
+	//swap_info_struct::lock (atomic) -- can participate. NEVER held across
+	//a sleeping call (no bio_alloc / submit_bio / mutex under it).
+	spinlock_t		map_lock;
+
+	//zest-gc: GC write frontier zone index, independent of the host's
+	//cur_zone so GC migration writes pack into their own zone. Touched only
+	//by the single GC executor (gc_thread) -> no lock needed. ZEST_NO_ZONE
+	//means no frontier is open yet (one is popped from the freelist on the
+	//next GC write).
+	unsigned int		gc_cur_zone;
+
+	//zest-gc: preallocated migration buffer (ZEST_GC_BUF_PAGES entries),
+	//owned solely by gc_thread. Reserved at swapon so GC never allocates
+	//pages on the reclaim/writeback path. Single executor => no locking.
+	struct zest_gc_ent	*gc_buf;
+	unsigned int		gc_buf_nr;
+	//zest-ra: gc_buf page backing-store bookkeeping. When gc_buf_contig, all
+	//gc_buf[i].page come from one high-order run (gc_buf_base, gc_buf_order) so
+	//GC writes coalesce into big bios (matching the host flush). On the per-page
+	//fallback gc_buf_base==NULL and each page is freed individually. Set at
+	//swapon (unconditional -- NOT gated by the ra switch).
+	struct page		*gc_buf_base;
+	unsigned int		gc_buf_order;
+	bool			gc_buf_contig;
+	//zest-ra: scratch for sorting a migration batch by VMA key (gc_buf_nr
+	//entries), preallocated with gc_buf. Used only when the placement reorder is
+	//on; the page array itself is never permuted (see struct zest_gc_sort).
+	struct zest_gc_sort	*gc_sort;
+
+	//zest-gc: the single GC executor and its two wait queues:
+	//  gc_wait      -- gc_thread sleeps here until kicked (freelist low).
+	//  gc_done_wait -- swap-out writers blocked on an empty freelist sleep
+	//                  here; GC wakes them each time it frees a zone.
+	struct task_struct	*gc_thread;
+	wait_queue_head_t	gc_wait;
+	wait_queue_head_t	gc_done_wait;
+
+	//zest-gc: stats, surfaced via /sys/kernel/zest/stats.
+	atomic64_t		gc_runs;		/* GC cycles run */
+	atomic64_t		gc_moved_blocks;	/* blocks relocated */
+	atomic64_t		gc_zones_reclaimed;	/* victims reset+freed */
+	atomic64_t		gc_aborts_stale;	/* commits dropped: l2p moved */
+
+	//zest3: captured mkswap header (slot 0). PAGE_SIZE kmalloc'd
+	//buffer; populated at init then immutable. Serves the (defensive)
+	//slot-0 read path. Allowing init to copy the header lets us reset
+	//the zone that originally held it.
+	void			*mkswap_header;
+
+	atomic64_t		nr_writes;
+	atomic64_t		nr_reads;
+	atomic64_t		nr_write_rejects;	//zest3
+
+	//zest3.1: L2P out-of-bounds FATAL latch. Tripped the first time a swap
+	//slot index >= nr_slots reaches the hot path (which would otherwise
+	//index l2p[] past its end -> heap corruption). Once set, this swapfile
+	//rejects every further swap-in/out without touching l2p[] or submitting
+	//a bio. Mirrored into the subsystem-wide zest_fatal* globals so it stays
+	//readable via /sys/kernel/zest/fatal even after swapoff frees this zi.
+	atomic_t		fatal;		/* 0=ok, 1=permanently tripped */
+	atomic64_t		fatal_count;	/* # of OOB events observed */
+	atomic64_t		fatal_slot;	/* last offending slot index */
+	atomic_t		fatal_nr;	/* last offending nr_pages */
+};
+
+//zest3.1: subsystem-wide mirror of the per-swapfile FATAL latch. Lives in
+//zest_main.c, outlives any individual zest_info, and backs the read-only
+///sys/kernel/zest/fatal node so the latch is observable until module unload
+/// reboot (not just until swapoff).
+extern atomic_t		zest_fatal;
+extern atomic64_t	zest_fatal_count;
+extern atomic64_t	zest_fatal_slot;
+extern atomic_t		zest_fatal_nr;
+
+/* zest-gc: GC entry points (zest_main.c) */
+int  zest_gc_run_one(struct zest_info *zi);	/* one GC cycle; -ENODATA if no victim */
+void zest_gc_kick(struct zest_info *zi);	/* wake the GC thread if below threshold */
+int  zest_gc_thread_start(struct zest_info *zi);
+void zest_gc_thread_stop(struct zest_info *zi);
+
+/* zest-gc: registry-wide GC stat aggregate for /sys/kernel/zest/stats. */
+struct zest_gc_stats_sum {
+	u64		runs;
+	u64		moved;
+	u64		reclaimed;
+	u64		aborts;
+	long		free_zones;
+	unsigned int	nr_swapfiles;
+	//zest-wbuf: buffer-flush telemetry (avg flush size = flush_pages/flush_count;
+	//compare against wbuf_cap, the per-buffer page capacity).
+	u64		flush_count;
+	u64		flush_pages;
+	unsigned int	wbuf_cap;
+	//zest-ra: write telemetry. avg_bio_kb=(host+gc)/bio_count; total_write=host+gc;
+	//write_amp=(host+gc)/host (GC-driven write amplification).
+	u64		bio_count;
+	u64		host_wb_bytes;
+	u64		gc_wb_bytes;
+	//zest-rc (v3): read-cache telemetry. hit_rate = hits/(hits+misses);
+	//precision = useful/(useful+wasted) -- how much of what prefetch published
+	//was ever used; busy_direct ~= duplicate IO (fault overtook a fill).
+	//rc_on = cache allocated AND switch on; rc_ways = allocated size in pages.
+	u64		rc_hits;
+	u64		rc_misses;
+	u64		rc_busy_direct;
+	u64		rc_fills;
+	u64		rc_fill_pages;
+	u64		rc_fill_aborts;
+	u64		rc_fill_drops;
+	u64		rc_fill_dups;
+	u64		rc_late_fills;
+	u64		rc_useful_evict;
+	u64		rc_wasted_evict;
+	unsigned int	rc_ways;
+	unsigned int	rc_on;
+	//zest-vra: prefetch-engine telemetry (see the zi field comments).
+	u64		ra_enq;
+	u64		ra_fifo_full;
+	u64		ra_skip;
+	u64		ra_submitted;
+	u64		ra_throttled;
+	int		ra_inflight;	/* live snapshot, not a counter */
+	u64		ra_peek_hits;
+	u64		ra_win_hist[ZEST_VRA_WIN_BUCKETS];
+};
+void zest_gc_collect_stats(struct zest_gc_stats_sum *s);
+
+/* zest_sysfs.c */
+int  zest_sysfs_init(void);
+void zest_sysfs_exit(void);
+
+#endif /* _MM_ZEST_INTERNAL_H */
