diff --git a/include/linux/zest.h b/include/linux/zest.h
new file mode 100644
index 000000000000..b05237493cec
--- /dev/null
+++ b/include/linux/zest.h
@@ -0,0 +1,334 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * ZEST: Zoned-storage swap layer for mobile F2FS
+ *
+ * Step 1: cold->warm redirect to free up open-zone budget for ZEST.
+ *
+ * The static branch keeps the fast path identical to upstream when
+ * disabled. Even when enabled, redirect is gated per-sb on
+ * sbi->zest_enable.
+ */
+//zest1
+#ifndef _LINUX_ZEST_H
+#define _LINUX_ZEST_H
+
+#include <linux/types.h>
+#include <linux/jump_label.h>
+
+struct page;
+struct folio;
+struct writeback_control;
+struct swap_info_struct;
+struct block_device;
+struct f2fs_sb_info;
+struct inode;
+
+#ifdef CONFIG_ZEST_SWAP
+
+DECLARE_STATIC_KEY_FALSE(zest_enabled_key);
+
+/* Slow-path part of zest_should_intercept(). Forward-declared early. */
+bool __zest_should_intercept(struct swap_info_struct *sis);
+
+/*
+ * Hot-path predicate. Single static_branch test when disabled.
+ */
+static __always_inline bool zest_should_intercept(struct swap_info_struct *sis)
+{
+	if ((!static_branch_unlikely(&zest_enabled_key)))
+		return false;
+	return __zest_should_intercept(sis);
+}
+
+/* mm/page_io.c hooks (still stubs in Step 1). */
+void zest_swap_writepage(struct page *page, struct writeback_control *wbc,
+			 struct swap_info_struct *sis);
+void zest_swap_readpage(struct folio *folio, struct swap_info_struct *sis);
+
+/*
+ * zest-znswap: swap-cache retention override. Slow-path helper, called only
+ * after the static-branch gate in zest_swap_retain_cache(). Returns true iff
+ * @folio is swapped to the ZEST swapfile AND the freelist currently holds more
+ * than zest_cache_retain_min_free free zones -- i.e. there is physical headroom
+ * to keep swapped-in clean pages' slots instead of trimming them under the
+ * kernel's device-agnostic vm_swap_full() heuristic.
+ */
+bool __zest_swap_retain_cache(struct folio *folio);
+
+/*
+ * Hot-path predicate for mm reclaim/fault: should we KEEP this folio's swap
+ * slot (suppress the vm_swap_full()-driven trim)? Branch-free single
+ * static_branch test when ZEST is disabled.
+ */
+static __always_inline bool zest_swap_retain_cache(struct folio *folio)
+{
+	if ((!static_branch_unlikely(&zest_enabled_key)))
+		return false;
+	return __zest_swap_retain_cache(folio);
+}
+
+/*
+ * zest-vra: ZEST-private VMA swap readahead (mm/swap_state.c hook).
+ *
+ * When active, swapin_readahead() bypasses the kernel's own vma/cluster
+ * readahead for entries on the ZEST swapfile: the fault path collects the
+ * VMA-neighbor swap slots (a lockless PTE walk, microseconds) and hands them
+ * to ZEST, which prefetches them ASYNCHRONOUSLY (one scattered 4K low-prio
+ * read each) into its private read cache -- the fault itself reads only its
+ * own page and NEVER waits on a prefetch.
+ *
+ *   zest_swap_ra_win()    -> the window size to collect, 0 = not active
+ *                            (ZEST off / not the ZEST swapfile / read cache
+ *                            off / vra_win=0). Bounded by ZEST_SWAP_RA_WIN_MAX
+ *                            so callers can use a fixed on-stack array.
+ *   zest_swap_ra_submit() -> hand the collected neighbor slots to the
+ *                            prefetch engine (enqueue to a worker by default;
+ *                            submits inline in fault context if vra_inline).
+ *   zest_swap_ra_peek()   -> hit attribution for the adaptive window (M3):
+ *                            true iff the faulting slot is in the ZEST read
+ *                            cache (prefetch predicted it -- the analog of
+ *                            finding a PG_readahead page in the swap cache).
+ *                            The caller then credits a hit and does NOT
+ *                            re-collect; window growth happens at the next
+ *                            peek-miss fault.
+ *   zest_swap_ra_stat_win() -> window-size histogram bookkeeping, one call
+ *                            per readahead round (peek-miss fault).
+ */
+#define ZEST_SWAP_RA_WIN_MAX	32u
+
+unsigned int __zest_swap_ra_win(struct swap_info_struct *sis);
+void __zest_swap_ra_submit(struct swap_info_struct *sis, const u32 *slots,
+			   unsigned int n);
+bool __zest_swap_ra_peek(struct swap_info_struct *sis, u32 slot);
+void __zest_swap_ra_stat_win(struct swap_info_struct *sis, unsigned int win);
+
+static __always_inline unsigned int
+zest_swap_ra_win(struct swap_info_struct *sis)
+{
+	if ((!static_branch_unlikely(&zest_enabled_key)))
+		return 0;
+	return __zest_swap_ra_win(sis);
+}
+
+static __always_inline void
+zest_swap_ra_submit(struct swap_info_struct *sis, const u32 *slots,
+		    unsigned int n)
+{
+	if ((!static_branch_unlikely(&zest_enabled_key)))
+		return;
+	__zest_swap_ra_submit(sis, slots, n);
+}
+
+static __always_inline bool
+zest_swap_ra_peek(struct swap_info_struct *sis, u32 slot)
+{
+	if ((!static_branch_unlikely(&zest_enabled_key)))
+		return false;
+	return __zest_swap_ra_peek(sis, slot);
+}
+
+static __always_inline void
+zest_swap_ra_stat_win(struct swap_info_struct *sis, unsigned int win)
+{
+	if ((!static_branch_unlikely(&zest_enabled_key)))
+		return;
+	__zest_swap_ra_stat_win(sis, win);
+}
+
+/*
+ * zest-vra (M3.6): asymmetric-aggression window knobs, applied ON TOP of the
+ * Linux __swapin_nr_pages slope (which is tuned for a shared swap cache /
+ * LRU; ZEST's waste lands in a private fixed arena and its fills are
+ * inflight-capped, so it can afford to open up where Linux must stay shy).
+ * Both default 0 = stock Linux behavior.
+ *
+ *   zest_swap_ra_jump()  -> hit-streak threshold: a readahead round that
+ *                           ended with >= this many peek hits opens the NEXT
+ *                           window straight at vra_win instead of climbing
+ *                           the doubling ladder (fewer window-end misses
+ *                           inside long runs -- the singleton 67% of rounds
+ *                           have hits==0 and are untouched).
+ *   zest_swap_ra_min()   -> blunt window floor, singletons included. This is
+ *                           knowingly M2-shaped waste; it exists to sweep the
+ *                           precision<->coverage trade-off curve, not as a
+ *                           recommended setting.
+ */
+extern unsigned int zest_vra_jump;
+extern unsigned int zest_vra_min;
+
+static __always_inline unsigned int zest_swap_ra_jump(void)
+{
+	return READ_ONCE(zest_vra_jump);
+}
+
+static __always_inline unsigned int zest_swap_ra_min(void)
+{
+	return READ_ONCE(zest_vra_min);
+}
+
+/*
+ * zest-gc: swap-slot-free hook, called from mm/swapfile.c swap_range_free()
+ * when [offset, offset+nr) are released. Clears the L2P/rmap entries and
+ * decrements the owning zones' valid_blocks so GC accounting stays exact
+ * (otherwise freed-but-not-overwritten blocks would be counted as valid and
+ * GC would needlessly relocate dead data). Runs under swap_info_struct::lock
+ * (atomic context): the implementation takes only zi->map_lock (a spinlock)
+ * and never sleeps. Guarded by zest_should_intercept() at the call site.
+ */
+void zest_swap_slot_free(struct swap_info_struct *sis, unsigned long offset,
+			 unsigned int nr);
+
+/* Lifecycle hooks called from fs/f2fs/ at swapon/swapoff. */
+int  zest_init_for_swapfile(struct f2fs_sb_info *sbi,
+			    struct swap_info_struct *sis);
+void zest_release_for_swapfile(struct f2fs_sb_info *sbi);
+
+/*
+ * zest2: bdev resolver provided by fs/f2fs/zest_f2fs.c.
+ * Returns the zoned block_device that backs the given F2FS pblock,
+ * or NULL if the pblock is not on any zoned dev. Used by zest_main.c
+ * to discover the underlying device of an active swapfile without
+ * pulling f2fs internals into mm/zest/.
+ */
+struct block_device *f2fs_zest_lookup_zoned_bdev(struct f2fs_sb_info *sbi,
+						 sector_t pblock);
+
+/*
+ * zest3: convert F2FS global block address to device-local block address.
+ * In multi-device setups, F2FS block addresses include an offset for the
+ * device's position in the logical address space. This subtracts that
+ * offset so the result is relative to the start of the zoned device.
+ * Returns (unsigned)-1 on error (block not on any zoned device).
+ */
+unsigned int f2fs_zest_blkaddr_to_dev_local(struct f2fs_sb_info *sbi,
+					    unsigned int blkaddr);
+
+/*
+ * zest3: auto-reserve an over-provisioning (OP) region by extending the
+ * swapfile inode with extra pinned, zoned sections (reuses the fallocate
+ * pinning path). The blocks live beyond the swap-visible size so mm never
+ * sees them. Reuse-aware (no-op if the inode already extends past
+ * @swap_blocks) and best-effort on ENOSPC. Block units are F2FS blocks.
+ * On return *out_start_lblk = @swap_blocks and *out_nr_blocks is the full
+ * OP region length (0 if none). Returns 0 on success (incl. best-effort
+ * partial / OP=0), negative errno only on hard failure with nothing reserved.
+ */
+int f2fs_zest_reserve_op_section(struct inode *inode, unsigned int swap_blocks,
+				 unsigned int *out_start_lblk,
+				 unsigned int *out_nr_blocks);
+
+/*
+ * zest3: walk the physical extents backing inode lblocks [start_lblk,
+ * end_lblk) (the OP region), invoking @cb(pblk, len, data) per extent.
+ * pblk is an F2FS global block address. cb returning non-zero aborts the
+ * walk with that value. Returns 0 on success.
+ */
+int f2fs_zest_walk_op_extents(struct inode *inode, unsigned int start_lblk,
+			      unsigned int end_lblk,
+			      int (*cb)(unsigned int pblk, unsigned int len,
+					void *data),
+			      void *data);
+
+/* ---- Step 1: cold->warm redirect accounting ---- */
+
+/*
+ * Called by F2FS from __get_segment_type() and from gc.c paths
+ * whenever ZEST has rewritten COLD_DATA -> WARM_DATA or
+ * COLD_NODE -> WARM_NODE. Lightweight counters so we can verify
+ * from userspace that the redirect actually fired.
+ */
+void zest_account_redirect_data(void);
+void zest_account_redirect_node(void);
+
+/*
+ * zest-gc: GC tunable accessors provided by fs/f2fs/zest_f2fs.c. mm/zest/
+ * treats struct f2fs_sb_info as opaque, so it reads the per-sb GC knobs
+ * (sysfs: zest_gc_enable / zest_gc_threshold / zest_gc_target) through these
+ * helpers rather than dereferencing sbi directly.
+ */
+bool         f2fs_zest_gc_enabled(struct f2fs_sb_info *sbi);
+unsigned int f2fs_zest_gc_threshold(struct f2fs_sb_info *sbi);
+unsigned int f2fs_zest_gc_target(struct f2fs_sb_info *sbi);
+
+#else /* !CONFIG_ZEST_SWAP */
+
+static inline bool zest_should_intercept(struct swap_info_struct *sis)
+{
+	return false;
+}
+static inline void zest_swap_writepage(struct page *page,
+				       struct writeback_control *wbc,
+				       struct swap_info_struct *sis) { }
+static inline void zest_swap_readpage(struct folio *folio,
+				      struct swap_info_struct *sis) { }
+static inline bool zest_swap_retain_cache(struct folio *folio)
+{
+	return false;
+}
+//zest-vra: stubs when CONFIG_ZEST_SWAP=n
+#define ZEST_SWAP_RA_WIN_MAX	32u
+static inline unsigned int zest_swap_ra_win(struct swap_info_struct *sis)
+{
+	return 0;
+}
+static inline void zest_swap_ra_submit(struct swap_info_struct *sis,
+				       const u32 *slots, unsigned int n) { }
+static inline bool zest_swap_ra_peek(struct swap_info_struct *sis, u32 slot)
+{
+	return false;
+}
+static inline void zest_swap_ra_stat_win(struct swap_info_struct *sis,
+					 unsigned int win) { }
+static inline unsigned int zest_swap_ra_jump(void)
+{
+	return 0;
+}
+static inline unsigned int zest_swap_ra_min(void)
+{
+	return 0;
+}
+static inline void zest_swap_slot_free(struct swap_info_struct *sis,
+				       unsigned long offset, unsigned int nr) { }
+static inline int  zest_init_for_swapfile(struct f2fs_sb_info *sbi,
+					  struct swap_info_struct *sis)
+{
+	return 0;
+}
+static inline void zest_release_for_swapfile(struct f2fs_sb_info *sbi) { }
+//zest2: stub when CONFIG_ZEST_SWAP=n
+static inline struct block_device *
+f2fs_zest_lookup_zoned_bdev(struct f2fs_sb_info *sbi, sector_t pblock)
+{
+	return NULL;
+}
+static inline unsigned int
+f2fs_zest_blkaddr_to_dev_local(struct f2fs_sb_info *sbi, unsigned int blkaddr)
+{
+	return blkaddr;
+}
+static inline int
+f2fs_zest_reserve_op_section(struct inode *inode, unsigned int swap_blocks,
+			     unsigned int *out_start_lblk,
+			     unsigned int *out_nr_blocks)
+{
+	if (out_start_lblk)
+		*out_start_lblk = swap_blocks;
+	if (out_nr_blocks)
+		*out_nr_blocks = 0;
+	return 0;
+}
+static inline int
+f2fs_zest_walk_op_extents(struct inode *inode, unsigned int start_lblk,
+			  unsigned int end_lblk,
+			  int (*cb)(unsigned int pblk, unsigned int len,
+				    void *data),
+			  void *data)
+{
+	return 0;
+}
+static inline void zest_account_redirect_data(void) { }
+static inline void zest_account_redirect_node(void) { }
+
+#endif /* CONFIG_ZEST_SWAP */
+
+#endif /* _LINUX_ZEST_H */
