+#include <linux/f2fs_fs.h>
+#include <linux/blk_types.h>
+#include <linux/blkdev.h>
+#include <linux/blkzoned.h>
+#include <linux/sched.h>
+#include <linux/string.h>
+#include <linux/types.h>
+//zest2: needed to export f2fs_zest_lookup_zoned_bdev declared in zest.h
+#include <linux/zest.h>
+
+#include "f2fs.h"
+#include "segment.h"
+#include "gc.h"
+
+#define ZEST_EVAC_GC_MAX_ITER	16
+
+#ifdef CONFIG_BLK_DEV_ZONED
+
+struct zest_report_one_ctx {
+	struct blk_zone zone;
+	bool got;
+};
+
+static int zest_report_one_cb(struct blk_zone *z, unsigned int idx, void *data)
+{
+	struct zest_report_one_ctx *c = data;
+
+	c->zone = *z;
+	c->got = true;
+	return 0;
+}
+
+struct zest_summary_ctx {
+	unsigned int cnt[16];	/* indexed by blk_zone_cond & 0xf */
+	unsigned long total;
+};
+
+static int zest_summary_cb(struct blk_zone *z, unsigned int idx, void *data)
+{
+	struct zest_summary_ctx *c = data;
+
+	c->total++;
+	c->cnt[z->cond & 0xf]++;
+	return 0;
+}
+
+static struct f2fs_dev_info *zest_zoned_dev_for(struct f2fs_sb_info *sbi,
+						block_t blkaddr)
+{
+	int i;
+
+	for (i = 0; i < sbi->s_ndevs; i++) {
+		if (!bdev_is_zoned(FDEV(i).bdev))
+			continue;
+		if (sbi->s_ndevs == 1 ||
+		    (FDEV(i).start_blk <= blkaddr &&
+		     blkaddr <= FDEV(i).end_blk))
+			return &FDEV(i);
+	}
+	return NULL;
+}
+
+/*
+ * Evacuate the section currently backing cold data / cold node and RESET
+ * its underlying zone. The redirect (zest_enable) must already
+ * be on -- otherwise we have no guarantee that cold writes have
+ * stopped landing in the victim section.
+ */
+static int zest_evacuate_curseg_section(struct f2fs_sb_info *sbi, int seg_type)
+{
+	struct curseg_info *cs = CURSEG_I(sbi, seg_type);
+	struct f2fs_dev_info *zbd;
+	block_t cs_zblk;
+	unsigned int victim_segno, victim_secno, victim_seg0;
+	unsigned int new_segno, new_secno;
+	sector_t zone_sector, zone_nr_sectors;
+	int log_spb = sbi->log_blocksize - SECTOR_SHIFT;
+	unsigned int vblocks;
+	int iter, err;
+	struct zest_report_one_ctx ctx = { .got = false };
+
+	if (!sbi->zest_enable) {
+		f2fs_warn(sbi, "zest: evacuate refused, zest_enable=0");
+		return -EINVAL;
+	}
+
+	mutex_lock(&cs->curseg_mutex);
+	victim_segno = cs->segno;
+	mutex_unlock(&cs->curseg_mutex);
+
+	if (victim_segno == NULL_SEGNO) {
+		f2fs_warn(sbi, "zest: curseg (type %u) has NULL_SEGNO", seg_type);
+		return -EINVAL;
+	}
+
+	victim_secno = GET_SEC_FROM_SEG(sbi, victim_segno);
+	victim_seg0 = GET_SEG_FROM_SEC(sbi, victim_secno);
+	cs_zblk = START_BLOCK(sbi, victim_seg0);
+
+	zbd = zest_zoned_dev_for(sbi, cs_zblk);
+	if (!zbd) {
+		f2fs_notice(sbi,
+			"zest: segno=%u (type %u) not on zoned dev, nothing to evacuate",
+			victim_segno, seg_type);
+		return 0;
+	}
+
+	zone_sector = ((sector_t)(cs_zblk - zbd->start_blk)) << log_spb;
+	zone_nr_sectors = bdev_zone_sectors(zbd->bdev);
+
+	err = blkdev_report_zones(zbd->bdev, zone_sector, 1,
+                              zest_report_one_cb, &ctx);
+    if (err != 1 || !ctx.got) {
+        f2fs_err(sbi, "zest: post-CP report_zones failed err=%d", err);
+        return err < 0 ? err : -EIO;
+    }
+
+    if (ctx.zone.cond == BLK_ZONE_COND_EMPTY) {
+		f2fs_notice(sbi,
+			"zest: zone already empty, no need to evacuate (segtype=%u segno=%u)",
+			seg_type, victim_segno);
+		return 0;
+	}
+
+	vblocks = get_valid_blocks(sbi, victim_seg0, true);
+	f2fs_notice(sbi,
+		"zest: evacuate begin type=%u secno=%u seg0=%u curseg =%u valid=%u zone_sector=0x%llx nr_sec=0x%llx",
+		seg_type, victim_secno, victim_seg0, victim_segno, vblocks,
+		(u64)zone_sector, (u64)zone_nr_sectors);
+
+	/*
+	 * Step 1: move cold_data curseg away from the victim section so
+	 * GC will accept it as a victim (f2fs_gc refuses sections that
+	 * contain a current curseg via IS_CURSEC).
+	 */
+	err = f2fs_allocate_new_section(sbi, seg_type, true);
+	if (err) {
+		f2fs_err(sbi, "zest: rotate cold_data curseg failed err=%d", err);
+		return err;
+	}
+
+	mutex_lock(&cs->curseg_mutex);
+	new_segno = cs->segno;
+	mutex_unlock(&cs->curseg_mutex);
+	new_secno = (new_segno == NULL_SEGNO) ? NULL_SECNO
+					      : GET_SEC_FROM_SEG(sbi, new_segno);
+	if (new_secno == victim_secno) {
+		f2fs_err(sbi,
+			"zest: rotate produced same secno=%u, abort", victim_secno);
+		return -EBUSY;
+	}
+	f2fs_notice(sbi,
+		"zest: cold_data curseg rotated segno %u -> %u (secno %u -> %u)",
+		victim_segno, new_segno, victim_secno, new_secno);
+
+	/*
+	 * Step 2: targeted GC loop. f2fs_gc requires the caller to hold
+	 * sbi->gc_lock (write) on entry, and releases it before return.
+	 * Each iteration reacquires it.
+	 */
+	for (iter = 0; iter < ZEST_EVAC_GC_MAX_ITER; iter++) {
+		struct f2fs_gc_control gc_ctrl = {
+			.victim_segno		= victim_seg0,
+			.init_gc_type		= FG_GC,
+			.no_bg_gc		= true,
+			.should_migrate_blocks	= true,
+			.err_gc_skipped		= true,
+			.nr_free_secs		= 1,
+		};
+
+		vblocks = get_valid_blocks(sbi, victim_seg0, true);
+		if (vblocks == 0)
+			break;
+
+		f2fs_down_write(&sbi->gc_lock);
+		err = f2fs_gc(sbi, &gc_ctrl);
+		/* f2fs_gc has already released gc_lock here */
+
+		if (err && err != -EAGAIN) {
+			f2fs_err(sbi,
+				"zest: gc iter=%d err=%d valid_left=%u",
+				iter, err, vblocks);
+			return err;
+		}
+
+		f2fs_notice(sbi,
+			"zest: gc iter=%d ret=%d valid_after=%u",
+			iter, err,
+			get_valid_blocks(sbi, victim_seg0, true));
+		cond_resched();
+	}
+
+	vblocks = get_valid_blocks(sbi, victim_seg0, true);
+	if (vblocks != 0) {
+		f2fs_err(sbi,
+			"zest: evacuate did not converge after %d iter(s), valid_left=%u",
+			iter, vblocks);
+		return -EBUSY;
+	}
+	f2fs_notice(sbi, "zest: evacuate converged in %d iter(s)", iter);
+
+	/*
+	 * Step 3:  persist NAT/SIT, let CP turn PRE -> FREE + zone RESET
+	 */
+	struct cp_control cpc = { .reason = CP_SYNC };
+
+    f2fs_down_write(&sbi->gc_lock);
+    err = f2fs_write_checkpoint(sbi, &cpc);
+    f2fs_up_write(&sbi->gc_lock);
+
+    if (err) {
+        f2fs_err(sbi, "zest: checkpoint failed err=%d", err);
+        return err;
+    }
+
+	if (!f2fs_issue_discard_timeout(sbi))
+    	f2fs_warn(sbi, "zest: issue discard timed out, fallback RESET will run");
+
+	/* Step 4: verify the zone actually got RESET (depends on realtime_discard) */
+
+    err = blkdev_report_zones(zbd->bdev, zone_sector, 1,
+                              zest_report_one_cb, &ctx);
+    if (err != 1 || !ctx.got) {
+        f2fs_err(sbi, "zest: post-CP report_zones failed err=%d", err);
+        return err < 0 ? err : -EIO;
+    }
+    if (ctx.zone.cond != BLK_ZONE_COND_EMPTY) {
+        f2fs_notice(sbi,
+            "zest: CP did not reset zone (cond=%s); issuing explicit RESET",
+            blk_zone_cond_str(ctx.zone.cond));
+        err = blkdev_zone_mgmt(zbd->bdev, REQ_OP_ZONE_RESET,
+                               zone_sector, zone_nr_sectors, GFP_KERNEL);
+        if (err) {
+            f2fs_err(sbi, "zest: explicit RESET failed err=%d", err);
+            return err;
+        }
+    }
+
+	f2fs_notice(sbi,
+    "zest: section (%u) evacuated, zone_sector=0x%llx nr_sectors=0x%llx EMPTY", seg_type,
+    (u64)zone_sector, (u64)zone_nr_sectors);
+	return 0;
+}
+
+int f2fs_zest_evacuate_cold_section(struct f2fs_sb_info *sbi)
+{
+    int err;
+
+    err = zest_evacuate_curseg_section(sbi, CURSEG_COLD_DATA);
+    if (err)
+        return err;
+    return zest_evacuate_curseg_section(sbi, CURSEG_COLD_NODE);
+}
+
+static int zest_summary_one_dev(struct f2fs_sb_info *sbi, int devi,
+				char *buf, int len, int max)
+{
+	struct f2fs_dev_info *d = &FDEV(devi);
+	struct zest_summary_ctx ctx = {};
+	int err;
+
+	err = blkdev_report_zones(d->bdev, 0, UINT_MAX,
+				  zest_summary_cb, &ctx);
+	if (err < 0) {
+		len += scnprintf(buf + len, max - len,
+			"dev=%s report_err=%d\n", d->path, err);
+		return len;
+	}
+
+	len += scnprintf(buf + len, max - len,
+		"dev=%s nr_zones=%lu max_open=%u max_active=%u "
+		"empty=%u imp_open=%u exp_open=%u closed=%u full=%u "
+		"readonly=%u offline=%u\n",
+		d->path,
+		ctx.total,
+		bdev_max_open_zones(d->bdev),
+		bdev_max_active_zones(d->bdev),
+		ctx.cnt[BLK_ZONE_COND_EMPTY],
+		ctx.cnt[BLK_ZONE_COND_IMP_OPEN],
+		ctx.cnt[BLK_ZONE_COND_EXP_OPEN],
+		ctx.cnt[BLK_ZONE_COND_CLOSED],
+		ctx.cnt[BLK_ZONE_COND_FULL],
+		ctx.cnt[BLK_ZONE_COND_READONLY],
+		ctx.cnt[BLK_ZONE_COND_OFFLINE]);
+	return len;
+}
+
+static int zest_summary_one_cs(struct f2fs_sb_info *sbi, int type,
+			       const char *label, char *buf, int len, int max)
+{
+	int log_spb = sbi->log_blocksize - SECTOR_SHIFT;
+	struct curseg_info *cs = CURSEG_I(sbi, type);
+	struct zest_report_one_ctx ctx = { .got = false };
+	struct f2fs_dev_info *zbd;
+	block_t cs_zblk;
+	sector_t zone_sector;
+	unsigned int vblocks;
+	int err;
+
+	mutex_lock(&cs->curseg_mutex);
+	if (cs->segno == NULL_SEGNO) {
+    	len += scnprintf(buf + len, max - len,
+        "%s: not_initialized\n", label);
+		goto out;
+	}
+	cs_zblk = START_BLOCK(sbi,
+		GET_SEG_FROM_SEC(sbi, GET_SEC_FROM_SEG(sbi, cs->segno)));
+	vblocks = get_valid_blocks(sbi, cs->segno, true);
+	zbd = zest_zoned_dev_for(sbi, cs_zblk);
+
+	if (!zbd) {
+		len += scnprintf(buf + len, max - len,
+			"%s: segno=%u not_on_zoned_dev valid_blks=%u\n",
+			label, cs->segno, vblocks);
+		goto out;
+	}
+
+	zone_sector = ((sector_t)(cs_zblk - zbd->start_blk)) << log_spb;
+	err = blkdev_report_zones(zbd->bdev, zone_sector, 1,
+				  zest_report_one_cb, &ctx);
+	if (err != 1 || !ctx.got) {
+		len += scnprintf(buf + len, max - len,
+			"%s: segno=%u report_err=%d valid_blks=%u\n",
+			label, cs->segno, err, vblocks);
+		goto out;
+	}
+
+	len += scnprintf(buf + len, max - len,
+		"%s: segno=%u zone_start=0x%llx wp_off=0x%llx cond=%s valid_blks=%u\n",
+		label, cs->segno,
+		(u64)ctx.zone.start,
+		(u64)(ctx.zone.wp - ctx.zone.start),
+		blk_zone_cond_str(ctx.zone.cond),
+		vblocks);
+out:
+	mutex_unlock(&cs->curseg_mutex);
+	return len;
+}
+
+int f2fs_zest_zone_summary_emit(struct f2fs_sb_info *sbi,
+				char *buf, size_t size)
+{
+	int len = 0, i;
+	int max = (int)size;
+
+	for (i = 0; i < sbi->s_ndevs; i++) {
+		if (!bdev_is_zoned(FDEV(i).bdev))
+			continue;
+		len = zest_summary_one_dev(sbi, i, buf, len, max);
+	}
+	len = zest_summary_one_cs(sbi, CURSEG_HOT_DATA, "hot_data",
+				  buf, len, max);
+	len = zest_summary_one_cs(sbi, CURSEG_WARM_DATA, "warm_data",
+				  buf, len, max);
+	len = zest_summary_one_cs(sbi, CURSEG_COLD_DATA, "cold_data",
+				  buf, len, max);
+	len = zest_summary_one_cs(sbi, CURSEG_HOT_NODE, "hot_node",
+				  buf, len, max);
+	len = zest_summary_one_cs(sbi, CURSEG_WARM_NODE, "warm_node",
+				  buf, len, max);
+	len = zest_summary_one_cs(sbi, CURSEG_COLD_NODE, "cold_node",
+				  buf, len, max);
+	len = zest_summary_one_cs(sbi, CURSEG_COLD_DATA_PINNED, "cold_data_pinned",
+				  buf, len, max);
+	return len;
+}
+
+//zest2: exported resolver used by mm/zest/zest_main.c at swapon time
+//to find the zoned block_device that owns a given F2FS pblock. Wraps
+//the file-local zest_zoned_dev_for() and returns just the bdev.
+struct block_device *f2fs_zest_lookup_zoned_bdev(struct f2fs_sb_info *sbi,
+						 sector_t pblock)
+{
+	struct f2fs_dev_info *dev;
+
+	dev = zest_zoned_dev_for(sbi, (block_t)pblock);
+	if (!dev) {
+		f2fs_info(sbi,
+			"zest: lookup_zoned_bdev pblock=%llu -> no zoned dev",
+			(unsigned long long)pblock);
+		return NULL;
+	}
+	return dev->bdev;
+}
+
+//zest-gc: GC tunable accessors. mm/zest/ treats f2fs_sb_info as opaque, so
+//it reads the per-sb GC knobs through these helpers. READ_ONCE because the
+//sysfs store path can update them concurrently with the GC kthread.
+bool f2fs_zest_gc_enabled(struct f2fs_sb_info *sbi)
+{
+	return READ_ONCE(sbi->zest_gc_enable) != 0;
+}
+
+unsigned int f2fs_zest_gc_threshold(struct f2fs_sb_info *sbi)
+{
+	return READ_ONCE(sbi->zest_gc_threshold);
+}
+
+unsigned int f2fs_zest_gc_target(struct f2fs_sb_info *sbi)
+{
+	return READ_ONCE(sbi->zest_gc_target);
+}
+
+//zest3: convert F2FS global block address to device-local block address.
+//Returns the offset in blocks from the start of the target zoned device,
+//or (block_t)-1 on error.
+block_t f2fs_zest_blkaddr_to_dev_local(struct f2fs_sb_info *sbi,
+					block_t blkaddr)
+{
+	struct f2fs_dev_info *dev;
+
+	dev = zest_zoned_dev_for(sbi, blkaddr);
+	if (!dev)
+		return (block_t)-1;
+	return blkaddr - dev->start_blk;
+}
+
+//zest3: auto-reserve an over-provisioning region by extending the swapfile
+//inode with extra pinned, zoned sections. This is a faithful copy of the
+//pinned branch of f2fs_expand_inode_data() (file.c) -- same locks, same GC
+//pre-flight, same per-section f2fs_allocate_pinning_section() +
+//f2fs_map_blocks(F2FS_GET_BLOCK_PRE_DIO, CURSEG_COLD_DATA_PINNED). The blocks
+//become ordinary pinned-file blocks (consistent SIT/NAT/i_blocks/i_size); they
+//sit beyond the swap-visible size (mkswap header), so mm never maps them into
+//swap_extent_root.
+//
+//Context: called from zest_init_for_swapfile (the swap_activate hook).
+//sys_swapon already holds inode_lock (claim_swapfile) and has NOT yet taken
+//swapon_mutex; no F2FS lock is held at the call site. We take
+//pin_sem -> gc_lock -> f2fs_lock_op in the SAME order as the fallocate path,
+//so no new lock ordering is introduced. We must NOT re-take inode_lock.
+//
+//Reuse-aware: if the inode already extends past @swap_blocks (a prior swapon
+//left an OP region), nothing is allocated and the existing tail is returned.
+//Best-effort: a mid-loop failure keeps whatever was allocated; OP=0 is
+//functional (no GC headroom), so the caller should not abort swapon on error.
+int f2fs_zest_reserve_op_section(struct inode *inode, unsigned int swap_blocks,
+				 unsigned int *out_start_lblk,
+				 unsigned int *out_nr_blocks)
+{
+	struct f2fs_sb_info *sbi = F2FS_I_SB(inode);
+	struct f2fs_gc_control gc_control = {
+		.victim_segno		= NULL_SEGNO,
+		.init_gc_type		= FG_GC,
+		.should_migrate_blocks	= false,
+		.err_gc_skipped		= true,
+		.nr_free_secs		= 0,
+	};
+	unsigned int op_ratio = READ_ONCE(sbi->zest_op_ratio);
+	unsigned int op_blocks = (unsigned int)((u64)swap_blocks * op_ratio / 100);
+	block_t cur_blocks = F2FS_BYTES_TO_BLK(i_size_read(inode));
+	block_t sec_blks = CAP_BLKS_PER_SEC(sbi);
+	/* anything the inode already has beyond the swap-visible area is
+	 * existing OP (a prior swapon's region, or a sub-section file tail). */
+	block_t have_op = (cur_blocks > swap_blocks) ? cur_blocks - swap_blocks : 0;
+	block_t target, to_alloc, allocated = 0;
+	int err = 0;
+
+	*out_start_lblk = swap_blocks;
+	*out_nr_blocks = have_op;
+
+	target = roundup(op_blocks, sec_blks);
+	f2fs_debug(sbi,
+		"zest: OP plan ino=%lu swap_blocks=%u op_ratio=%u%% -> op_blocks=%u target=%u",
+		inode->i_ino, swap_blocks, op_ratio, op_blocks,
+		(unsigned int)target);
+
+	/* Reuse: already have at least the requested OP. */
+	if (have_op >= target) {
+		f2fs_notice(sbi,
+			"zest: OP reuse ino=%lu start_lblk=%u nr_blocks=%u (i_size_blks=%u swap_blks=%u target=%u)",
+			inode->i_ino, swap_blocks, (unsigned int)have_op,
+			(unsigned int)cur_blocks, swap_blocks,
+			(unsigned int)target);
+		return 0;
+	}
+
+	if (!op_blocks)
+		return 0;
+
+	/* Allocate the shortfall, starting at the inode's current end so we
+	 * never re-map blocks the file already owns (incl. any tail). */
+	to_alloc = target - have_op;
+	f2fs_debug(sbi,
+		"zest: OP reserve begin ino=%lu start_lblk=%u have_op=%u target=%u to_alloc=%u sec_blks=%u",
+		inode->i_ino, swap_blocks, (unsigned int)have_op,
+		(unsigned int)target, (unsigned int)to_alloc,
+		(unsigned int)sec_blks);
+
+	while (allocated < to_alloc) {
+		struct f2fs_map_blocks map = {
+			.m_lblk		= cur_blocks + allocated,
+			.m_len		= sec_blks,
+			.m_next_pgofs	= NULL,
+			.m_next_extent	= NULL,
+			.m_seg_type	= CURSEG_COLD_DATA_PINNED,
+			.m_may_create	= true,
+		};
+
+		f2fs_down_write(&sbi->pin_sem);
+
+		if (unlikely(is_sbi_flag_set(sbi, SBI_CP_DISABLED))) {
+			if (has_not_enough_free_secs(sbi, 0, 0)) {
+				f2fs_up_write(&sbi->pin_sem);
+				err = -ENOSPC;
+				break;
+			}
+		}
+
+		if (has_not_enough_free_secs(sbi, 0, sbi->reserved_pin_section)) {
+			f2fs_down_write(&sbi->gc_lock);
+			stat_inc_gc_call_count(sbi, FOREGROUND);
+			err = f2fs_gc(sbi, &gc_control);
+			/* f2fs_gc has already released gc_lock here */
+			if (err && err != -ENODATA) {
+				f2fs_up_write(&sbi->pin_sem);
+				break;
+			}
+			err = 0;
+		}
+
+		err = f2fs_allocate_pinning_section(sbi);
+		if (err) {
+			f2fs_up_write(&sbi->pin_sem);
+			break;
+		}
+
+		err = f2fs_map_blocks(inode, &map, F2FS_GET_BLOCK_PRE_DIO);
+		f2fs_up_write(&sbi->pin_sem);
+		if (err)
+			break;
+
+		file_dont_truncate(inode);
+		allocated += map.m_len;
+		f2fs_debug(sbi,
+			"zest: OP reserve section lblk=%u pblk=%u len=%u (allocated=%u/%u)",
+			map.m_lblk, map.m_pblk, map.m_len,
+			(unsigned int)allocated, (unsigned int)to_alloc);
+		cond_resched();
+	}
+
+	if (allocated) {
+		loff_t new_size = F2FS_BLK_TO_BYTES(cur_blocks + allocated);
+
+		if (new_size > i_size_read(inode))
+			f2fs_i_size_write(inode, new_size);
+	}
+
+	*out_nr_blocks = have_op + allocated;
+	if (have_op + allocated)
+		f2fs_notice(sbi,
+			"zest: OP reserve done ino=%lu start_lblk=%u nr_blocks=%u (have_op=%u +alloc=%u) new_isize=%llu last_err=%d",
+			inode->i_ino, swap_blocks, *out_nr_blocks,
+			(unsigned int)have_op, (unsigned int)allocated,
+			(unsigned long long)i_size_read(inode), err);
+	else
+		f2fs_warn(sbi,
+			"zest: OP reserve got 0 blocks (err=%d); running with no OP headroom",
+			err);
+
+	/* OP is best-effort: report success whenever we have any OP region. */
+	return (have_op + allocated) ? 0 : (err ? err : 0);
+}
+
+//zest3: walk the physical extents backing inode lblocks [start_lblk, end_lblk)
+//(the OP region) via the same FIEMAP map path check_swap_activate() uses, and
+//hand each (global pblock, len) extent to @cb. Holes are unexpected (the region
+//was just pinned) and treated as an error.
+int f2fs_zest_walk_op_extents(struct inode *inode, unsigned int start_lblk,
+			      unsigned int end_lblk,
+			      int (*cb)(unsigned int pblk, unsigned int len,
+					void *data),
+			      void *data)
+{
+	struct f2fs_sb_info *sbi = F2FS_I_SB(inode);
+	block_t lblk = start_lblk;
+	int ret;
+
+	while (lblk < end_lblk) {
+		struct f2fs_map_blocks map;
+
+		cond_resched();
+		memset(&map, 0, sizeof(map));
+		map.m_lblk = lblk;
+		map.m_len = end_lblk - lblk;
+		map.m_next_pgofs = NULL;
+		map.m_next_extent = NULL;
+		map.m_seg_type = NO_CHECK_TYPE;
+		map.m_may_create = false;
+
+		ret = f2fs_map_blocks(inode, &map, F2FS_GET_BLOCK_FIEMAP);
+		if (ret) {
+			f2fs_err(sbi, "zest: OP walk map_blocks lblk=%u err=%d",
+				 (unsigned int)lblk, ret);
+			return ret;
+		}
+		if (!(map.m_flags & F2FS_MAP_FLAGS)) {
+			f2fs_err(sbi, "zest: OP region has hole at lblk=%u",
+				 (unsigned int)lblk);
+			return -EINVAL;
+		}
+		ret = cb(map.m_pblk, map.m_len, data);
+		if (ret)
+			return ret;
+		lblk += map.m_len;
+	}
+	return 0;
+}
+
+#else /* !CONFIG_BLK_DEV_ZONED */
+
+//zest2: stub when CONFIG_BLK_DEV_ZONED is off, no zoned dev exists.
+struct block_device *f2fs_zest_lookup_zoned_bdev(struct f2fs_sb_info *sbi,
+						 sector_t pblock)
+{
+	return NULL;
+}
+
+block_t f2fs_zest_blkaddr_to_dev_local(struct f2fs_sb_info *sbi,
+					block_t blkaddr)
+{
+	return blkaddr;
+}
+
+//zest-gc: accessor stubs when no zoned dev exists (GC never runs).
+bool f2fs_zest_gc_enabled(struct f2fs_sb_info *sbi)
+{
+	return false;
+}
+
+unsigned int f2fs_zest_gc_threshold(struct f2fs_sb_info *sbi)
+{
+	return 0;
+}
+
+unsigned int f2fs_zest_gc_target(struct f2fs_sb_info *sbi)
+{
+	return 0;
+}
+
+//zest3: stubs when CONFIG_BLK_DEV_ZONED is off (no zoned dev, no OP).
+int f2fs_zest_reserve_op_section(struct inode *inode, unsigned int swap_blocks,
+				 unsigned int *out_start_lblk,
+				 unsigned int *out_nr_blocks)
+{
+	*out_start_lblk = swap_blocks;
+	*out_nr_blocks = 0;
+	return 0;
+}
+
+int f2fs_zest_walk_op_extents(struct inode *inode, unsigned int start_lblk,
+			      unsigned int end_lblk,
+			      int (*cb)(unsigned int pblk, unsigned int len,
+					void *data),
+			      void *data)
+{
+	return 0;
+}
+
+int f2fs_zest_evacuate_cold_section(struct f2fs_sb_info *sbi)
+{
+	return 0;
+}
+
+int f2fs_zest_zone_summary_emit(struct f2fs_sb_info *sbi,
+				char *buf, size_t size)
+{
+	return scnprintf(buf, size, "CONFIG_BLK_DEV_ZONED disabled\n");
+}
+
+#endif /* CONFIG_BLK_DEV_ZONED */
