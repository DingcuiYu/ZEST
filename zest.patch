+static void swap_slot_reread_monitor_reset_locked(void)
+{
+	int type;
+
+	swap_slot_reread_monitor_total_io_reads = 0;
+	swap_slot_reread_monitor_repeated_io_reads = 0;
+	swap_slot_reread_monitor_freed_read_slots = 0;
+	swap_slot_reread_monitor_freed_repeated_slots = 0;
+
+	for (type = 0; type < MAX_SWAPFILES; type++) {
+		struct swap_slot_reread_monitor_area *area =
+			&swap_slot_reread_monitor_areas[type];
+
+		if (area->read_counts && area->nr_slots)
+			memset(area->read_counts, 0,
+			       area->nr_slots * sizeof(*area->read_counts));
+	}
+}
+
+int swap_slot_reread_monitor_set(bool enabled)
+{
+	unsigned long nr_slots[MAX_SWAPFILES] = {};
+	u32 *new_counts[MAX_SWAPFILES] = {};
+	u32 *old_counts[MAX_SWAPFILES] = {};
+	unsigned long flags;
+	int type;
+	int ret = 0;
+
+	if (enabled) {
+		spin_lock(&swap_lock);
+		for (type = 0; type < nr_swapfiles; type++) {
+			struct swap_info_struct *si = swap_info[type];
+
+			if (si && (si->flags & SWP_USED))
+				nr_slots[type] = si->max;
+		}
+		spin_unlock(&swap_lock);
+
+		for (type = 0; type < MAX_SWAPFILES; type++) {
+			if (!nr_slots[type])
+				continue;
+
+			new_counts[type] = vzalloc(array_size(nr_slots[type],
+							      sizeof(*new_counts[type])));
+			if (!new_counts[type]) {
+				ret = -ENOMEM;
+				goto out_free_new;
+			}
+		}
+	}
+
+	spin_lock(&swap_lock);
+	spin_lock_irqsave(&swap_slot_reread_monitor_lock, flags);
+	if (enabled) {
+		for (type = 0; type < MAX_SWAPFILES; type++) {
+			struct swap_info_struct *si = swap_info[type];
+			struct swap_slot_reread_monitor_area *area =
+				&swap_slot_reread_monitor_areas[type];
+
+			if (!si || !(si->flags & SWP_USED) || !nr_slots[type])
+				continue;
+			if (area->read_counts)
+				continue;
+
+			area->read_counts = new_counts[type];
+			area->nr_slots = nr_slots[type];
+			new_counts[type] = NULL;
+		}
+		swap_slot_reread_monitor_reset_locked();
+		WRITE_ONCE(swap_slot_reread_monitor_enabled, true);
+	} else {
+		WRITE_ONCE(swap_slot_reread_monitor_enabled, false);
+		for (type = 0; type < MAX_SWAPFILES; type++) {
+			struct swap_slot_reread_monitor_area *area =
+				&swap_slot_reread_monitor_areas[type];
+
+			old_counts[type] = area->read_counts;
+			area->read_counts = NULL;
+			area->nr_slots = 0;
+		}
+		swap_slot_reread_monitor_reset_locked();
+	}
+	spin_unlock_irqrestore(&swap_slot_reread_monitor_lock, flags);
+	spin_unlock(&swap_lock);
+
+out_free_new:
+	for (type = 0; type < MAX_SWAPFILES; type++) {
+		vfree(new_counts[type]);
+		vfree(old_counts[type]);
+	}
+
+	return ret;
+}
+
+void swap_slot_reread_monitor_get_stats(
+		struct swap_slot_reread_monitor_stats *stats)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&swap_slot_reread_monitor_lock, flags);
+	stats->enabled = swap_slot_reread_monitor_enabled;
+	stats->total_io_reads = swap_slot_reread_monitor_total_io_reads;
+	stats->repeated_io_reads = swap_slot_reread_monitor_repeated_io_reads;
+	stats->freed_read_slots = swap_slot_reread_monitor_freed_read_slots;
+	stats->freed_repeated_slots =
+		swap_slot_reread_monitor_freed_repeated_slots;
+	spin_unlock_irqrestore(&swap_slot_reread_monitor_lock, flags);
+}
+
+void swap_slot_reread_monitor_read(swp_entry_t entry)
+{
+	struct swap_slot_reread_monitor_area *area;
+	unsigned long flags;
+	unsigned long offset = swp_offset(entry);
+	int type = swp_type(entry);
+	u32 count;
+
+	if (!READ_ONCE(swap_slot_reread_monitor_enabled))
+		return;
+	if (type >= MAX_SWAPFILES)
+		return;
+
+	spin_lock_irqsave(&swap_slot_reread_monitor_lock, flags);
+	if (!swap_slot_reread_monitor_enabled)
+		goto out;
+
+	area = &swap_slot_reread_monitor_areas[type];
+	if (!area->read_counts || offset >= area->nr_slots)
+		goto out;
+
+	count = area->read_counts[offset];
+	if (count)
+		swap_slot_reread_monitor_repeated_io_reads++;
+	if (count != U32_MAX)
+		area->read_counts[offset] = count + 1;
+	swap_slot_reread_monitor_total_io_reads++;
+out:
+	spin_unlock_irqrestore(&swap_slot_reread_monitor_lock, flags);
+}
+
+void swap_slot_reread_monitor_free(struct swap_info_struct *si,
+				   unsigned long offset,
+				   unsigned int nr_entries)
+{
+	struct swap_slot_reread_monitor_area *area;
+	unsigned long flags;
+	unsigned long end = offset + nr_entries;
+
+	if (!READ_ONCE(swap_slot_reread_monitor_enabled))
+		return;
+
+	spin_lock_irqsave(&swap_slot_reread_monitor_lock, flags);
+	if (!swap_slot_reread_monitor_enabled)
+		goto out;
+
+	area = &swap_slot_reread_monitor_areas[si->type];
+	if (!area->read_counts || offset >= area->nr_slots)
+		goto out;
+
+	end = min(end, area->nr_slots);
+	while (offset < end) {
+		u32 count = area->read_counts[offset];
+
+		if (count) {
+			swap_slot_reread_monitor_freed_read_slots++;
+			if (count > 1)
+				swap_slot_reread_monitor_freed_repeated_slots++;
+			area->read_counts[offset] = 0;
+		}
+		offset++;
+	}
+out:
+	spin_unlock_irqrestore(&swap_slot_reread_monitor_lock, flags);
+}
