+		stats->data_writeback_retry_wait.total +
+		stats->data_cached_ipu_submit.total +
+		stats->data_write_cache_other.total +
+		stats->data_cp_rwsem_trylock.total + stats->data_other.total;
+	seq_puts(m,
+		"\n# target data-submit additive breakdown; zero-call samples are included\n");
+	seq_printf(m, "data_breakdown_valid_records=%llu\n",
