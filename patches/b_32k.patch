+/* SPDX-License-Identifier: GPL-2.0 */
+/* Public hooks for optional ZEST swap-fault accounting. */
+#ifndef _LINUX_ZEST_H
+#define _LINUX_ZEST_H
+
+#include <linux/mm_types.h>
+#include <linux/swap.h>
+#include <linux/swapops.h>
+#include <linux/types.h>
+
+/*
+ * Per-invocation state embedded in do_swap_page().  Retry records themselves
+ * remain private to mm/zest; keeping this object small avoids adding any
+ * allocation or sleep to the fault path.
+ */
+struct zest_swap_fault_call {
+	unsigned long entry;
+	unsigned long address;
+	u64 generation;
+	int retry_idx;
+	bool active;
+	bool retry_matched;
+	bool cache_lookup_done;
+	bool counted;
+	bool canceled;
+	bool first_cache_hit;
+	bool tried;
+};
+
+#ifdef CONFIG_ZEST_SWAP
+
+void zest_swap_fault_start(struct zest_swap_fault_call *call,
+			   swp_entry_t entry,
+			   unsigned long address,
+			   unsigned int fault_flags);
+void zest_swap_fault_cache_lookup(struct zest_swap_fault_call *call,
+				   bool cache_hit);
+void zest_swap_fault_end(struct zest_swap_fault_call *call,
+				 vm_fault_t result);
+static inline void zest_swap_fault_cancel(struct zest_swap_fault_call *call)
+{
+	if (call)
+		call->canceled = true;
+}
+
+#else /* !CONFIG_ZEST_SWAP */
+
+static inline void zest_swap_fault_start(struct zest_swap_fault_call *call,
+					 swp_entry_t entry,
+					 unsigned long address,
+					 unsigned int fault_flags)
+{
+}
+static inline void zest_swap_fault_cache_lookup(
+					 struct zest_swap_fault_call *call,
+					 bool cache_hit)
+{
+}
+static inline void zest_swap_fault_end(struct zest_swap_fault_call *call,
+					 vm_fault_t result)
+{
+}
+static inline void zest_swap_fault_cancel(struct zest_swap_fault_call *call)
+{
+}
+
+#endif /* CONFIG_ZEST_SWAP */
+
+#endif /* _LINUX_ZEST_H */
