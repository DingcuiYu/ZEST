+
+int swap_32kchunk_pool_init(void)
+{
+	int i;
+	int ret = 0;
+
+	mutex_lock(&swap_32kchunk_init_lock);
+	if (!swap_32kchunk_pool) {
+		mempool_t *pool = mempool_create_kmalloc_pool(
+			SWAP_IO_CHUNK_PAGES * 2,
