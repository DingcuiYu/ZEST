index 0000000000000000000000000000000000000000..2b5c80239a9df66626bfb31d04424ee26757ef54
--- /dev/null
+++ b/mm/zest/zest_swap_fault_stats.c
@@ -0,0 +1,336 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ZEST swap fault accounting.  This is deliberately independent from the
+ * swap-latency tracer: accounting remains enabled even when tracing is off.
+ */
+#define pr_fmt(fmt) "zest: " fmt
+
+#include <linux/atomic.h>
+#include <linux/hash.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/slab.h>
+#include <linux/sched.h>
+#include <linux/spinlock.h>
+#include <linux/vmalloc.h>
+#include <linux/zest.h>
+
+#include "zest_internal.h"
+
+#define ZEST_SWAP_FAULT_RETRY_BUFFER_BYTES (1U << 20)
+#define ZEST_SWAP_FAULT_HASH_BITS 10
+#define ZEST_SWAP_FAULT_HASH_SIZE (1U << ZEST_SWAP_FAULT_HASH_BITS)
+
+struct zest_swap_fault_retry {
+	struct hlist_node hash_node;
+	struct list_head fifo_node;
+	struct task_struct *task;
+	unsigned long entry;
+	unsigned long address;
+	u64 generation;
+	u32 index;
+	bool first_cache_hit;
+	bool in_use;
+};
+
+static atomic64_t page_faults = ATOMIC64_INIT(0);
+static atomic64_t swap_cache_hits = ATOMIC64_INIT(0);
+static atomic64_t swap_cache_misses = ATOMIC64_INIT(0);
+static atomic64_t async_retry_overflow = ATOMIC64_INIT(0);
+
+static DEFINE_SPINLOCK(retry_lock);
+static struct hlist_head retry_hash[ZEST_SWAP_FAULT_HASH_SIZE];
+static LIST_HEAD(retry_fifo);
+static struct zest_swap_fault_retry *retry_records;
+static unsigned int retry_capacity;
+static unsigned int retry_pending;
+static u64 retry_generation = 1;
+static bool retry_initialized;
+
+static unsigned int retry_bucket(struct task_struct *task,
+				unsigned long address, unsigned long entry)
+{
+	unsigned long key = (unsigned long)task ^ address ^ entry;
+
+	return hash_long(key, ZEST_SWAP_FAULT_HASH_BITS);
+}
+
+static void retry_release_locked(struct zest_swap_fault_retry *rec)
+{
+	if (!rec->in_use)
+		return;
+	if (!hlist_unhashed(&rec->hash_node))
+		hlist_del_init(&rec->hash_node);
+	if (!list_empty(&rec->fifo_node)) {
+		list_del_init(&rec->fifo_node);
+		if (retry_pending)
+			retry_pending--;
+	}
+	if (rec->task)
+		put_task_struct(rec->task);
+	rec->task = NULL;
+	rec->in_use = false;
+}
+
+static void retry_evict_oldest_locked(void)
+{
+	struct zest_swap_fault_retry *rec;
+
+	if (list_empty(&retry_fifo))
+		return;
+	rec = list_first_entry(&retry_fifo,
+				       struct zest_swap_fault_retry, fifo_node);
+	atomic64_inc(&async_retry_overflow);
+	retry_release_locked(rec);
+}
+
+static struct zest_swap_fault_retry *retry_alloc_locked(void)
+{
+	unsigned int i;
+
+	if (!retry_records || !retry_capacity) {
+		atomic64_inc(&async_retry_overflow);
+		return NULL;
+	}
+
+	for (i = 0; i < retry_capacity; i++) {
+		if (!retry_records[i].in_use)
+			return &retry_records[i];
+	}
+
+	/* FIFO eviction is safe only for records that are still pending. */
+	if (!list_empty(&retry_fifo)) {
+		retry_evict_oldest_locked();
+		for (i = 0; i < retry_capacity; i++)
+			if (!retry_records[i].in_use)
+				return &retry_records[i];
+	}
+
+	atomic64_inc(&async_retry_overflow);
+	return NULL;
+}
+
+static void retry_publish_locked(struct zest_swap_fault_retry *rec,
+					struct zest_swap_fault_call *call)
+{
+	unsigned int bucket;
+
+	if (!rec->task) {
+		rec->task = current;
+		get_task_struct(rec->task);
+	}
+	rec->entry = call->entry;
+	rec->address = call->address;
+	rec->generation = call->generation;
+	rec->first_cache_hit = call->first_cache_hit;
+	rec->in_use = true;
+	INIT_HLIST_NODE(&rec->hash_node);
+	INIT_LIST_HEAD(&rec->fifo_node);
+	bucket = retry_bucket(rec->task, rec->address, rec->entry);
+	hlist_add_head(&rec->hash_node, &retry_hash[bucket]);
+	list_add_tail(&rec->fifo_node, &retry_fifo);
+	retry_pending++;
+}
+
+static struct zest_swap_fault_retry *retry_find_locked(
+		struct task_struct *task, unsigned long address, unsigned long entry)
+{
+	struct zest_swap_fault_retry *rec;
+	unsigned int bucket = retry_bucket(task, address, entry);
+
+	hlist_for_each_entry(rec, &retry_hash[bucket], hash_node) {
+		if (rec->task == task && rec->address == address &&
+		    rec->entry == entry && rec->generation == retry_generation)
+			return rec;
+	}
+	return NULL;
+}
+
+static void retry_unpend_locked(struct zest_swap_fault_retry *rec)
+{
+	hlist_del_init(&rec->hash_node);
+	list_del_init(&rec->fifo_node);
+	if (retry_pending)
+		retry_pending--;
+}
+
