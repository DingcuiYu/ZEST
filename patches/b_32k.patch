+++ b/tools/testing/f2fs_fsync_latency/android_sqlite_probe.c
@@ -0,0 +1,197 @@
+// SPDX-License-Identifier: Apache-2.0
+/*
+ * Query an Android platform libsqlite.so without linking its private ABI.
+ *
+ * The optional database is opened read-only.  For a WAL database, inspect a
+ * quiesced database or a consistent copy of the db, -wal, and -shm files.
+ * Opening a live database from another process can otherwise observe a moving
+ * state and, depending on SQLite version and permissions, interact with SHM or
+ * recovery.  PRAGMA synchronous and wal_autocheckpoint below describe this
+ * newly opened connection, not the settings of another live connection.
+ */
+
+#include <dlfcn.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+typedef struct sqlite3 sqlite3;
+typedef struct sqlite3_stmt sqlite3_stmt;
+
+enum {
+	SQLITE_OK = 0,
+	SQLITE_OPEN_READONLY = 1,
+	SQLITE_OPEN_READWRITE = 2,
+	SQLITE_OPEN_CREATE = 4,
+	SQLITE_ROW = 100,
+	SQLITE_DONE = 101,
+};
+
+struct sqlite_api {
+	const char *(*libversion)(void);
+	const char *(*sourceid)(void);
+	int (*threadsafe)(void);
+	int (*open_v2)(const char *, sqlite3 **, int, const char *);
+	int (*close)(sqlite3 *);
+	const char *(*errmsg)(sqlite3 *);
+	int (*prepare_v2)(sqlite3 *, const char *, int, sqlite3_stmt **,
+		const char **);
+	int (*step)(sqlite3_stmt *);
+	int (*finalize)(sqlite3_stmt *);
+	int (*column_count)(sqlite3_stmt *);
+	const char *(*column_name)(sqlite3_stmt *, int);
+	const unsigned char *(*column_text)(sqlite3_stmt *, int);
+};
+
+static int load_symbol(void *handle, void **out, const char *name)
+{
+	*out = dlsym(handle, name);
+	if (*out != NULL)
+		return 0;
+	fprintf(stderr, "dlsym(%s): %s\n", name, dlerror());
+	return -1;
+}
+
+#define LOAD(handle, api, member, symbol) \
+	load_symbol((handle), (void **)&(api)->member, (symbol))
+
+static int load_api(void *handle, struct sqlite_api *api)
+{
+	return LOAD(handle, api, libversion, "sqlite3_libversion") ||
+		LOAD(handle, api, sourceid, "sqlite3_sourceid") ||
+		LOAD(handle, api, threadsafe, "sqlite3_threadsafe") ||
+		LOAD(handle, api, open_v2, "sqlite3_open_v2") ||
+		LOAD(handle, api, close, "sqlite3_close") ||
+		LOAD(handle, api, errmsg, "sqlite3_errmsg") ||
+		LOAD(handle, api, prepare_v2, "sqlite3_prepare_v2") ||
+		LOAD(handle, api, step, "sqlite3_step") ||
+		LOAD(handle, api, finalize, "sqlite3_finalize") ||
+		LOAD(handle, api, column_count, "sqlite3_column_count") ||
+		LOAD(handle, api, column_name, "sqlite3_column_name") ||
+		LOAD(handle, api, column_text, "sqlite3_column_text");
+}
+
+static int query(struct sqlite_api *api, sqlite3 *db, const char *sql,
+		int allow_empty)
+{
+	sqlite3_stmt *statement = NULL;
+	int rc = api->prepare_v2(db, sql, -1, &statement, NULL);
+	int rows = 0;
+
+	if (rc != SQLITE_OK) {
+		fprintf(stderr, "%s: %s\n", sql, api->errmsg(db));
+		return -1;
+	}
+	printf("[%s]\n", sql);
+	while ((rc = api->step(statement)) == SQLITE_ROW) {
+		int columns = api->column_count(statement);
+		int column;
+
+		for (column = 0; column < columns; ++column) {
+			const unsigned char *value =
+				api->column_text(statement, column);
+
+			printf("%s%s=%s", column ? " " : "",
+				api->column_name(statement, column),
+				value != NULL ? (const char *)value : "NULL");
+		}
+		putchar('\n');
+		++rows;
+	}
+	if (rc != SQLITE_DONE)
+		fprintf(stderr, "%s step: %s\n", sql, api->errmsg(db));
+	if (rows == 0) {
+		if (allow_empty)
+			printf("(no rows; compile-option diagnostics may be omitted)\n");
+		else
+			fprintf(stderr, "%s: query returned no rows\n", sql);
+	}
+	rc = api->finalize(statement);
+	return rc == SQLITE_OK && (allow_empty || rows != 0) ? 0 : -1;
+}
+
+static void *open_library(const char **loaded_path)
+{
+	const char *override = getenv("SQLITE_LIB");
+	const char *paths[] = {
+		override,
+		"libsqlite.so",
+		"/system/lib64/libsqlite.so",
+		"/system_ext/lib64/libsqlite.so",
+		"/product/lib64/libsqlite.so",
+		"/vendor/lib64/libsqlite.so",
+	};
+	size_t index;
+
+	for (index = 0; index < sizeof(paths) / sizeof(paths[0]); ++index) {
+		void *handle;
+
+		if (paths[index] == NULL)
+			continue;
+		handle = dlopen(paths[index], RTLD_NOW | RTLD_LOCAL);
+		if (handle != NULL) {
+			*loaded_path = paths[index];
+			return handle;
+		}
+	}
+	fprintf(stderr, "dlopen libsqlite.so failed: %s\n", dlerror());
+	fprintf(stderr, "set SQLITE_LIB to the absolute platform library path\n");
+	return NULL;
+}
+
+int main(int argc, char **argv)
+{
+	const char *database_path = argc > 1 ? argv[1] : ":memory:";
+	const char *loaded_path = NULL;
+	int flags = argc > 1 ? SQLITE_OPEN_READONLY :
+		SQLITE_OPEN_READWRITE | SQLITE_OPEN_CREATE;
+	struct sqlite_api api;
+	sqlite3 *database = NULL;
+	void *handle;
+	int rc = 0;
+
+	if (argc > 2) {
+		fprintf(stderr, "usage: %s [database-path]\n", argv[0]);
+		return 2;
+	}
+	handle = open_library(&loaded_path);
+	if (handle == NULL)
+		return 1;
+	if (load_api(handle, &api) != 0) {
+		dlclose(handle);
+		return 1;
+	}
+	printf("library=%s\nversion=%s\nsourceid=%s\nthreadsafe=%d\n",
+		loaded_path, api.libversion(), api.sourceid(), api.threadsafe());
+	if (argc > 1) {
+		printf("database=%s\nopen_mode=readonly\n", database_path);
+		fprintf(stderr,
+			"note: synchronous and wal_autocheckpoint are for the "
+			"probe connection\n");
+	}
+	rc = api.open_v2(database_path, &database, flags, NULL);
+	if (rc != SQLITE_OK) {
+		fprintf(stderr, "open(%s): %s\n", database_path,
+			database != NULL ? api.errmsg(database) :
+			"failed without handle");
+		if (database != NULL)
+			api.close(database);
+		dlclose(handle);
+		return 1;
+	}
+	rc |= query(&api, database,
+		"SELECT sqlite_version(), sqlite_source_id()", 0);
+	rc |= query(&api, database, "PRAGMA compile_options", 1);
+	rc |= query(&api, database, "PRAGMA main.journal_mode", 0);
+	rc |= query(&api, database, "PRAGMA main.synchronous", 0);
+	rc |= query(&api, database, "PRAGMA main.page_size", 0);
+	rc |= query(&api, database, "PRAGMA wal_autocheckpoint", 0);
+	if (api.close(database) != SQLITE_OK) {
+		fprintf(stderr, "sqlite3_close(%s) failed\n", database_path);
+		rc = -1;
+	}
+	if (dlclose(handle) != 0) {
+		fprintf(stderr, "dlclose(%s): %s\n", loaded_path, dlerror());
+		rc = -1;
+	}
+	return rc != 0;
+}
diff --git a/tools/testing/f2fs_fsync_latency/run_sqlite_fsync_matrix.ps1 b/tools/testing/f2fs_fsync_latency/run_sqlite_fsync_matrix.ps1
new file mode 100644
index 0000000000000000000000000000000000000000..106ce026db899cb8691419ba6ad7ade047f7ba5d
--- /dev/null
+++ b/tools/testing/f2fs_fsync_latency/run_sqlite_fsync_matrix.ps1
@@ -0,0 +1,1797 @@
+# SPDX-License-Identifier: GPL-2.0
+#
+# Run the real-configuration SQLite fsync matrix on an Android device, pull
+# every binary trace with adb pull, and analyze traces only after device testing
+# has finished.  Analysis-only mode never contacts a device.  The script is
+# compatible with Windows PowerShell 5.1.
+
+[CmdletBinding()]
+param(
+    [string]$Adb = "adb.exe",
+    [string]$Python = "python.exe",
+    [string]$Analyzer = "",
+    [string]$OutputRoot = "",
+    [string]$Serial = "",
+
+    [string]$DeviceBenchmark =
+        "/data/local/tmp/sqlite_fsync_bench",
+    [string]$DeviceRoot =
+        "/data/local/tmp/sqlite-fsync-matrix",
+    [string]$TraceControlDir =
+        "/sys/kernel/debug/f2fs_fsync_latency",
+
+    [uint64]$Transactions = 1000000,
+    [uint64]$Warmup = 100,
+    [uint32]$Tables = 3,
+    [uint64]$OperationsPerTable = 1,
+    [uint64]$PayloadBytes = 100,
+    [uint64]$WorkingSet = 1024,
+    [uint32]$WalAutocheckpoint = 1000,
+    [uint32]$BusyTimeoutMs = 30000,
+
+    [string[]]$JournalModes = @("WAL", "DELETE"),
+    [string[]]$OperationNames = @("insert", "delete", "update"),
+    [uint32[]]$ThreadCounts = @(1, 2, 4, 8),
+
+    [switch]$AnalysisOnly,
+    [string[]]$AnalysisJournalModes = @("WAL", "DELETE"),
+
+    [uint32]$MinimumDeviceFreeGiB = 8,
+    [uint32]$CooldownSeconds = 15,
+
+    [switch]$SkipSpaceChecks,
+    [switch]$KeepDeviceArtifacts,
+    [switch]$FailFast
+)
+
+Set-StrictMode -Version 2.0
+$ErrorActionPreference = "Stop"
+
+# The matrix deliberately keeps one 4 GiB vmalloc buffer resident across all
+# selected cases.  A case stop seals the current session but does not free the
+# allocation.  Startup reuses an existing 4 GiB allocation when possible; the
+# final matrix reset returns it to the device.
+[uint32]$MatrixTraceBufferMb = 4096
+[uint64]$MatrixTraceBufferBytes = 4294967296
+[uint64]$MatrixTraceCapacityRecords = 7456540
+
+function ConvertTo-PosixSingleQuoted {
+    param(
+        [Parameter(Mandatory = $true)]
+        [AllowEmptyString()]
+        [string]$Value
+    )
+
+    # A single quote inside a POSIX single-quoted word is represented by:
+    #
+    #     '"'"'
+    #
+    # Build that sequence without relying on hard-to-read PowerShell quote
+    # escaping.
+    $singleQuote = [string][char]39
+    $doubleQuote = [string][char]34
+    $replacement = $singleQuote + $doubleQuote + $singleQuote +
+        $doubleQuote + $singleQuote
+
+    return $singleQuote + $Value.Replace($singleQuote, $replacement) +
+        $singleQuote
+}
+
+function Join-PosixCommand {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string[]]$ArgumentList
+    )
+
+    $quoted = @(
+        foreach ($argument in $ArgumentList) {
+            ConvertTo-PosixSingleQuoted -Value $argument
+        }
+    )
+    return ($quoted -join " ")
+}
+
+function Assert-SafeRemotePath {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string]$Path,
+
+        [Parameter(Mandatory = $true)]
+        [string]$AllowedRoot
+    )
+
+    $root = $AllowedRoot.TrimEnd("/")
+    $prefix = $root + "/"
+
+    if (-not $Path.StartsWith(
+            $prefix,
+            [System.StringComparison]::Ordinal
+        )) {
+        throw "Unsafe remote path outside run root: $Path"
+    }
+    if ($Path -notmatch "^/[A-Za-z0-9._/-]+$") {
+        throw "Unsafe characters in remote path: $Path"
+    }
+}
+
+function Get-AdbArguments {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string[]]$Tail
+    )
+
+    $arguments = @()
+    if (-not [string]::IsNullOrWhiteSpace($Serial)) {
+        $arguments += "-s"
+        $arguments += $Serial
+    }
+    $arguments += $Tail
+    return ,$arguments
+}
+
+function Invoke-AdbCommand {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string[]]$Arguments,
+
+        [Parameter(Mandatory = $true)]
+        [string]$LogPath,
+
+        [switch]$EchoOutput
+    )
+
+    $parent = Split-Path -Parent $LogPath
+    if (-not [string]::IsNullOrWhiteSpace($parent)) {
+        New-Item -ItemType Directory -Force -Path $parent | Out-Null
+    }
+
+    $lines = [System.Collections.Generic.List[string]]::new()
+    $encoding = [System.Text.UTF8Encoding]::new($false)
+    $writer = [System.IO.StreamWriter]::new(
+        $LogPath,
+        $false,
+        $encoding
+    )
+    $adbSubcommand = if ($Arguments.Count -gt 0) {
+        $Arguments[0]
+    }
+    else {
+        ""
+    }
+    $writer.WriteLine(
+        "# host_start_utc=" + [DateTime]::UtcNow.ToString("o")
+    )
+    $writer.WriteLine("# adb_program=$Adb")
+    $writer.WriteLine("# adb_serial=$Serial")
+    $writer.WriteLine("# adb_subcommand=$adbSubcommand")
+    $writer.Flush()
+    $exitCode = 255
+    $savedErrorActionPreference = $ErrorActionPreference
+
+    try {
+        # Windows PowerShell 5.1 wraps native stderr as ErrorRecord objects.
+        # adb writes successful pull progress to stderr, so the script-level
+        # ErrorActionPreference=Stop must not turn that output into a false
+        # terminating failure.
+        $ErrorActionPreference = "Continue"
+        $adbArguments = Get-AdbArguments -Tail $Arguments
+        & $Adb @adbArguments 2>&1 | ForEach-Object {
+            if ($_ -is [System.Management.Automation.ErrorRecord] -and
+                    $null -ne $_.Exception) {
+                $line = [string]$_.Exception.Message
+            }
+            else {
+                $line = [string]$_
+            }
+            [void]$lines.Add($line)
+            $writer.WriteLine($line)
+            $writer.Flush()
+            if ($EchoOutput) {
+                Write-Host $line
+            }
+        }
+        if ($null -ne $LASTEXITCODE) {
+            $exitCode = [int]$LASTEXITCODE
+        }
+    }
+    catch {
+        if ($_.Exception -is [System.Management.Automation.PipelineStoppedException]) {
+            throw
+        }
+        $line = $_.Exception.ToString()
+        [void]$lines.Add($line)
+        $writer.WriteLine($line)
+        $writer.Flush()
+        if ($EchoOutput) {
+            Write-Host $line
+        }
+        $exitCode = 255
+    }
+    finally {
+        $ErrorActionPreference = $savedErrorActionPreference
+        $writer.WriteLine(
+            "# host_end_utc=" + [DateTime]::UtcNow.ToString("o")
+        )
+        $writer.WriteLine("# adb_exit_code=$exitCode")
+        $writer.Flush()
+        $writer.Dispose()
+    }
+
+    return [pscustomobject]@{
+        ExitCode = [int]$exitCode
+        Text = ($lines -join "`n")
+    }
+}
+
+function Invoke-RootCommand {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string]$InnerCommand,
+
+        [Parameter(Mandatory = $true)]
+        [string]$LogPath,
+
+        [switch]$EchoOutput
+    )
+
+    # adb shell receives one complete command string.  The inner command is
+    # itself one safely quoted argv for Android su -c.
+    $outerCommand = "su -c " +
+        (ConvertTo-PosixSingleQuoted -Value $InnerCommand)
+    return Invoke-AdbCommand `
+        -Arguments @("shell", $outerCommand) `
+        -LogPath $LogPath `
+        -EchoOutput:$EchoOutput
+}
+
+function Get-LastIntegerMarker {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string]$Text,
+
+        [Parameter(Mandatory = $true)]
+        [string]$Name
+    )
+
+    $pattern = "(?m)^" + [regex]::Escape($Name) +
+        "=([0-9]+)[ 	]*$"
+    $matches = [regex]::Matches($Text, $pattern)
+    if ($matches.Count -eq 0) {
+        return $null
+    }
+    return [uint64]$matches[$matches.Count - 1].Groups[1].Value
+}
+
+function Get-KernelStat {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string]$Text,
+
+        [Parameter(Mandatory = $true)]
+        [string]$Name
+    )
+
+    return Get-LastIntegerMarker -Text $Text -Name $Name
+}
+
+function Get-LastPrefixedLine {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string]$Text,
+
+        [Parameter(Mandatory = $true)]
+        [string]$Prefix
+    )
+
+    $pattern = "(?m)^" + [regex]::Escape($Prefix) + "[^\r\n]*$"
+    $matches = [regex]::Matches($Text, $pattern)
+    if ($matches.Count -eq 0) {
+        return ""
+    }
+    return $matches[$matches.Count - 1].Value
+}
+
+function Test-KeyValueToken {
+    param(
+        [Parameter(Mandatory = $true)]
+        [AllowEmptyString()]
+        [string]$Line,
+
+        [Parameter(Mandatory = $true)]
+        [string]$Name,
+
+        [Parameter(Mandatory = $true)]
+        [AllowEmptyString()]
+        [string]$Value
+    )
+
+    $pattern = "(?:^|[ \t])" + [regex]::Escape($Name) + "=" +
+        [regex]::Escape($Value) + "(?:[ \t]|$)"
+    return [regex]::IsMatch($Line, $pattern)
+}
+
+function Get-DeviceAvailableKiB {
+    param(
+        [Parameter(Mandatory = $true)]
+        [string]$RemotePath,
+
+        [Parameter(Mandatory = $true)]
+        [string]$LogPath
+    )
+
+    $quotedPath = ConvertTo-PosixSingleQuoted -Value $RemotePath
+    $result = Invoke-RootCommand `
+        -InnerCommand ("df -k " + $quotedPath + " | tail -n 1") `
+        -LogPath $LogPath
+    if ($result.ExitCode -ne 0) {
+        throw "Remote df failed; see $LogPath"
+    }
+
+    $lines = @($result.Text -split "`r?`n" | Where-Object {
+        -not [string]::IsNullOrWhiteSpace($_)
+    })
+    if ($lines.Count -eq 0) {
+        throw "Remote df returned no data; see $LogPath"
+    }
+    $fields = @($lines[$lines.Count - 1].Trim() -split "\s+")
+    if ($fields.Count -lt 4) {
+        throw "Cannot parse remote df output; see $LogPath"
+    }
+
+    [uint64]$availableKiB = 0
+    if (-not [uint64]::TryParse($fields[3], [ref]$availableKiB)) {
+        throw "Cannot parse remote available KiB; see $LogPath"
+    }
+    return $availableKiB
+}
+
+function Write-ResultsManifest {
+    param(
+        [Parameter(Mandatory = $true)]
+        [object[]]$Rows,
+
+        [Parameter(Mandatory = $true)]
+        [string]$CsvPath,
+
+        [Parameter(Mandatory = $true)]
+        [string]$JsonPath
+    )
+
+    $Rows | Export-Csv `
+        -LiteralPath $CsvPath `
+        -NoTypeInformation `
+        -Encoding UTF8
+    ConvertTo-Json -InputObject @($Rows) -Depth 6 | Out-File `
+        -LiteralPath $JsonPath `
+        -Encoding utf8 `
+        -Width 4096
+}
+
+function Get-ResultProperty {
+    param(
+        [AllowNull()]
+        [object]$Source,
+
+        [Parameter(Mandatory = $true)]
+        [string]$Name,
+
+        [AllowNull()]
+        [object]$DefaultValue
+    )
+
+    if ($null -eq $Source) {
+        return $DefaultValue
+    }
+    $property = $Source.PSObject.Properties[$Name]
+    if ($null -eq $property -or $null -eq $property.Value) {
+        return $DefaultValue
+    }
+    return $property.Value
+}
+
+function Get-ResultJournalMode {
+    param(
+        [Parameter(Mandatory = $true)]
+        [object]$Result
+    )
+
+    $caseId = [string](Get-ResultProperty $Result "CaseId" "")
+    $caseMatch = [regex]::Match($caseId, "^(wal|delete)-")
+    if ($caseMatch.Success) {
+        return $caseMatch.Groups[1].Value.ToUpperInvariant()
+    }
+
+    $journalMode = [string](Get-ResultProperty $Result "JournalMode" "")
+    $journalMode = $journalMode.ToUpperInvariant()
+    if ($journalMode -in @("WAL", "DELETE")) {
+        return $journalMode
+    }
+    return ""
+}
+
+function ConvertTo-ExistingTraceResult {
+    param(
+        [AllowNull()]
+        [object]$PriorResult,
+
+        [Parameter(Mandatory = $true)]
+        [string]$CaseId,
+
+        [Parameter(Mandatory = $true)]
+        [string]$TracePath,
+
+        [Parameter(Mandatory = $true)]
+        [string]$StatsPath
+    )
+
+    $caseMatch = [regex]::Match(
+        $CaseId,
+        "^(wal|delete)-(insert|delete|update)-t(1|2|4|8)$"
+    )
+    $defaultJournal = ""
+    $defaultOperation = ""
+    $defaultThreads = ""
+    if ($caseMatch.Success) {
+        $defaultJournal = $caseMatch.Groups[1].Value.ToUpperInvariant()
+        $defaultOperation = $caseMatch.Groups[2].Value
+        $defaultThreads = $caseMatch.Groups[3].Value
+    }
+    $origin = if ($null -eq $PriorResult) {
+        "discovered_trace"
+    }
+    else {
+        Get-ResultProperty $PriorResult "ResultOrigin" "prior_manifest"
+    }
+    $defaultFailure = if ($null -eq $PriorResult) {
+        "existing_trace_without_prior_manifest;"
+    }
+    else {
+        ""
+    }
+
+    $analysisStatus = [string](Get-ResultProperty $PriorResult `
+        "AnalysisStatus" "PENDING")
+    if ([string]::IsNullOrWhiteSpace($analysisStatus)) {
+        $analysisStatus = "PENDING"
+    }
+
+    return [pscustomobject][ordered]@{
+        CaseId = $CaseId
+        ResultOrigin = $origin
+        JournalMode = Get-ResultProperty $PriorResult "JournalMode" `
+            $defaultJournal
+        Operation = Get-ResultProperty $PriorResult "Operation" `
+            $defaultOperation
+        Threads = Get-ResultProperty $PriorResult "Threads" $defaultThreads
+        Transactions = Get-ResultProperty $PriorResult "Transactions" ""
+        WarmupPerThread = Get-ResultProperty $PriorResult `
+            "WarmupPerThread" ""
+        WalAutocheckpoint = Get-ResultProperty $PriorResult `
+            "WalAutocheckpoint" ""
+        TraceBufferMb = Get-ResultProperty $PriorResult "TraceBufferMb" `
+            $MatrixTraceBufferMb
+        Status = Get-ResultProperty $PriorResult "Status" "DISCOVERED"
+        FailureReason = Get-ResultProperty $PriorResult "FailureReason" `
+            $defaultFailure
+        SetupRc = Get-ResultProperty $PriorResult "SetupRc" ""
+        AdbRunRc = Get-ResultProperty $PriorResult "AdbRunRc" ""
+        RemoteRunRc = Get-ResultProperty $PriorResult "RemoteRunRc" ""
+        ChmodRc = Get-ResultProperty $PriorResult "ChmodRc" ""
+        PullTraceRc = Get-ResultProperty $PriorResult "PullTraceRc" ""
+        PullStatsRc = Get-ResultProperty $PriorResult "PullStatsRc" ""
+        CleanupRc = Get-ResultProperty $PriorResult "CleanupRc" ""
+        ConfigurationValidation = Get-ResultProperty $PriorResult `
+            "ConfigurationValidation" ""
+        TraceValidation = Get-ResultProperty $PriorResult `
+            "TraceValidation" ""
+        WorkloadComplete = Get-ResultProperty $PriorResult `
+            "WorkloadComplete" ""
+        KernelStatsValidation = Get-ResultProperty $PriorResult `
+            "KernelStatsValidation" ""
+        TraceEnvelopeValidation = Get-ResultProperty $PriorResult `
+            "TraceEnvelopeValidation" ""
+        TraceLengthValidation = Get-ResultProperty $PriorResult `
+            "TraceLengthValidation" ""
+        Records = Get-ResultProperty $PriorResult "Records" ""
+        CapacityRecords = Get-ResultProperty $PriorResult `
+            "CapacityRecords" ""
+        FsyncRecords = Get-ResultProperty $PriorResult "FsyncRecords" ""
+        FdatasyncRecords = Get-ResultProperty $PriorResult `
+            "FdatasyncRecords" ""
+        TgidFilter = Get-ResultProperty $PriorResult "TgidFilter" ""
+        BenchmarkBeginNs = Get-ResultProperty $PriorResult `
+            "BenchmarkBeginNs" ""
+        TransactionsEndNs = Get-ResultProperty $PriorResult `
+            "TransactionsEndNs" ""
+        FinalEndNs = Get-ResultProperty $PriorResult "FinalEndNs" ""
+        TraceStartNs = Get-ResultProperty $PriorResult "TraceStartNs" ""
+        TraceStopNs = Get-ResultProperty $PriorResult "TraceStopNs" ""
+        RecordUtilization = Get-ResultProperty $PriorResult `
+            "RecordUtilization" ""
+        LocalTraceBytes = Get-ResultProperty $PriorResult `
+            "LocalTraceBytes" ""
+        ExpectedTraceBytes = Get-ResultProperty $PriorResult `
+            "ExpectedTraceBytes" ""
+        TraceSha256 = Get-ResultProperty $PriorResult "TraceSha256" ""
+        LocalTrace = $TracePath
+        LocalStats = $StatsPath
+        AnalysisRc = Get-ResultProperty $PriorResult "AnalysisRc" $null
+        AnalysisIntegrityValidation = Get-ResultProperty $PriorResult `
+            "AnalysisIntegrityValidation" $null
+        AnalysisStatus = $analysisStatus
+        ReportPath = Get-ResultProperty $PriorResult "ReportPath" ""
+        CdfPath = Get-ResultProperty $PriorResult "CdfPath" ""
+    }
+}
+
+if ([string]::IsNullOrWhiteSpace($Analyzer)) {
+    $Analyzer = Join-Path $PSScriptRoot "analyze_trace.py"
+}
+if ($AnalysisOnly -and [string]::IsNullOrWhiteSpace($OutputRoot)) {
+    throw "-AnalysisOnly requires an existing -OutputRoot"
+}
+if ([string]::IsNullOrWhiteSpace($OutputRoot)) {
+    $OutputRoot = Join-Path `
+        ([string](Get-Location)) `
+        ("sqlite-fsync-matrix-" + (Get-Date -Format "yyyyMMdd-HHmmss"))
+}
+
+if (-not (Test-Path -LiteralPath $Analyzer -PathType Leaf)) {
+    throw "analyze_trace.py not found: $Analyzer"
+}
+$Analyzer = (Resolve-Path -LiteralPath $Analyzer).Path
+
+$pythonCommand = Get-Command $Python -ErrorAction SilentlyContinue
+if ($null -eq $pythonCommand) {
+    throw "Python executable not found: $Python"
+}
+if ($AnalysisJournalModes.Count -eq 0) {
+    throw "analysis journal modes cannot be empty"
+}
+for ($index = 0; $index -lt $AnalysisJournalModes.Count; $index++) {
+    $AnalysisJournalModes[$index] =
+        $AnalysisJournalModes[$index].ToUpperInvariant()
+    if ($AnalysisJournalModes[$index] -notin @("WAL", "DELETE")) {
+        throw (
+            "Unsupported analysis journal mode: {0}"
+        ) -f $AnalysisJournalModes[$index]
+    }
+}
+$AnalysisJournalModes = @(
+    $AnalysisJournalModes | Select-Object -Unique
+)
+
+if (-not $AnalysisOnly) {
+    $adbCommand = Get-Command $Adb `
+        -CommandType Application `
+        -ErrorAction SilentlyContinue
+    if ($null -eq $adbCommand) {
+        throw "adb executable not found or is not a native application: $Adb"
+    }
+
+    if ($Transactions -eq 0 -or $Tables -eq 0 -or
+            $OperationsPerTable -eq 0 -or $PayloadBytes -eq 0 -or
+            $WorkingSet -eq 0) {
+        throw (
+            "transactions/tables/operations/payload/working-set must be positive"
+        )
+    }
+    if ($JournalModes.Count -eq 0 -or $OperationNames.Count -eq 0 -or
+            $ThreadCounts.Count -eq 0) {
+        throw (
+            "journal modes, operation names, and thread counts cannot be empty"
+        )
+    }
+    for ($index = 0; $index -lt $JournalModes.Count; $index++) {
+        $JournalModes[$index] = $JournalModes[$index].ToUpperInvariant()
+        if ($JournalModes[$index] -notin @("WAL", "DELETE")) {
+            throw "Unsupported journal mode: $($JournalModes[$index])"
+        }
+    }
+    for ($index = 0; $index -lt $OperationNames.Count; $index++) {
+        $OperationNames[$index] = $OperationNames[$index].ToLowerInvariant()
+        if ($OperationNames[$index] -notin @("insert", "delete", "update")) {
+            throw "Unsupported operation name: $($OperationNames[$index])"
+        }
+    }
+    foreach ($threadCount in $ThreadCounts) {
+        if ($threadCount -notin @(1, 2, 4, 8)) {
+            throw "Unsupported thread count: $threadCount"
+        }
+    }
+    $JournalModes = @($JournalModes | Select-Object -Unique)
+    $OperationNames = @($OperationNames | Select-Object -Unique)
+    $ThreadCounts = @($ThreadCounts | Select-Object -Unique)
+    if ($DeviceBenchmark -notmatch "^/[A-Za-z0-9._/-]+$" -or
+            $DeviceRoot -notmatch "^/[A-Za-z0-9._/-]+$" -or
+            $TraceControlDir -notmatch "^/[A-Za-z0-9._/-]+$") {
+        throw "Device paths must be absolute and contain only safe characters"
+    }
+}
+
+if (Test-Path -LiteralPath $OutputRoot) {
+    if (-not (Test-Path -LiteralPath $OutputRoot -PathType Container)) {
+        throw (
+            "OutputRoot exists but is not a directory: {0}. " +
+            "Choose another -OutputRoot or rename/remove the conflicting file."
+        ) -f $OutputRoot
+    }
+}
+elseif ($AnalysisOnly) {
+    throw "Analysis-only OutputRoot does not exist: $OutputRoot"
+}
+else {
+    New-Item -ItemType Directory -Force -Path $OutputRoot | Out-Null
+}
+if (-not (Test-Path -LiteralPath $OutputRoot -PathType Container)) {
+    throw "OutputRoot could not be created as a directory: $OutputRoot"
+}
+$OutputRoot = (Resolve-Path -LiteralPath $OutputRoot).Path
+
+$traceRoot = Join-Path $OutputRoot "traces"
+$statsRoot = Join-Path $OutputRoot "stats"
+$consoleRoot = Join-Path $OutputRoot "console"
+$reportRoot = Join-Path $OutputRoot "reports"
+$cdfRoot = Join-Path $OutputRoot "csv"
+$controlRoot = Join-Path $OutputRoot "control"
+if ($AnalysisOnly -and
+        -not (Test-Path -LiteralPath $traceRoot -PathType Container)) {
+    throw "Analysis-only trace directory does not exist: $traceRoot"
+}
+$directories = if ($AnalysisOnly) {
+    @($reportRoot, $cdfRoot)
+}
+else {
+    @(
+        $traceRoot,
+        $statsRoot,
+        $consoleRoot,
+        $reportRoot,
+        $cdfRoot,
+        $controlRoot
+    )
+}
+foreach ($directory in $directories) {
+    New-Item -ItemType Directory -Force -Path $directory | Out-Null
+}
+
+$manifestCsv = Join-Path $OutputRoot "results.csv"
+$manifestJson = Join-Path $OutputRoot "results.json"
+$priorResultByCase = @{}
+if (Test-Path -LiteralPath $manifestCsv -PathType Leaf) {
+    foreach ($priorResult in @(Import-Csv -LiteralPath $manifestCsv)) {
+        $priorCaseId = [string](Get-ResultProperty $priorResult "CaseId" "")
+        if (-not [string]::IsNullOrWhiteSpace($priorCaseId)) {
+            $priorResultByCase[$priorCaseId] = $priorResult
+        }
+    }
+}
+
+$results = @(
+    foreach ($traceFile in @(Get-ChildItem -LiteralPath $traceRoot `
+            -Filter "*.bin" -File | Sort-Object -Property Name)) {
+        $existingCaseId = [System.IO.Path]::GetFileNameWithoutExtension(
+            $traceFile.Name
+        )
+        $priorResult = $null
+        if ($priorResultByCase.ContainsKey($existingCaseId)) {
+            $priorResult = $priorResultByCase[$existingCaseId]
+        }
+        ConvertTo-ExistingTraceResult `
+            -PriorResult $priorResult `
+            -CaseId $existingCaseId `
+            -TracePath $traceFile.FullName `
+            -StatsPath (Join-Path $statsRoot ($traceFile.Name + ".stats"))
+    }
+)
+$abortRequested = $false
+$anyFailure = $false
+
+if ($AnalysisOnly -and $results.Count -eq 0) {
+    throw "No trace files found in analysis-only trace directory: $traceRoot"
+}
+
+if (-not $AnalysisOnly) {
+$runId = (Get-Date -Format "yyyyMMdd-HHmmss") + "-" + $PID
+$deviceRunRoot = $DeviceRoot.TrimEnd("/") + "/" + $runId
+$deviceDbRoot = $deviceRunRoot + "/db"
+$deviceTraceRoot = $deviceRunRoot + "/trace"
+
+$cases = @()
+foreach ($journalMode in $JournalModes) {
+    foreach ($operation in $OperationNames) {
+        foreach ($threads in $ThreadCounts) {
+            $journalName = $journalMode.ToLowerInvariant()
+            $caseId = "{0}-{1}-t{2}" -f $journalName, $operation, $threads
+            $autoCheckpoint = if ($journalMode -eq "WAL") {
+                [string]$WalAutocheckpoint
+            }
+            else {
+                "N/A"
+            }
+
+            $cases += [pscustomobject][ordered]@{
+                CaseId = $caseId
+                JournalMode = $journalMode
+                Operation = $operation
+                Threads = [uint32]$threads
+                Transactions = $Transactions
+                WarmupPerThread = $Warmup
+                Tables = $Tables
+                OperationsPerTable = $OperationsPerTable
+                PayloadBytes = $PayloadBytes
+                WorkingSetPerDatabase = $WorkingSet
+                Synchronous = "FULL"
+                RandomKey = $true
+                WalAutocheckpoint = $autoCheckpoint
+                BusyTimeoutMs = $BusyTimeoutMs
+                TraceBufferMb = $MatrixTraceBufferMb
+            }
+        }
+    }
+}
+$expectedCaseCount = $JournalModes.Count * $OperationNames.Count *
+    $ThreadCounts.Count
+if ($cases.Count -ne $expectedCaseCount) {
+    throw (
+        "Internal matrix error: expected {0} selected cases, got {1}"
+    ) -f $expectedCaseCount, $cases.Count
+}
+$matrixDescription = [pscustomobject][ordered]@{
+    GeneratedUtc = [DateTime]::UtcNow.ToString("o")
+    DeviceSerial = $Serial
+    DeviceBenchmark = $DeviceBenchmark
+    DeviceRunRoot = $deviceRunRoot
+    Analyzer = $Analyzer
+    DatabaseMode = "per-thread-db"
+    Synchronous = "FULL"
+    WalAutocheckpoint = $WalAutocheckpoint
+    DeleteWalAutocheckpoint = "N/A"
+    TraceBufferMb = $MatrixTraceBufferMb
+    TraceBufferBytes = $MatrixTraceBufferBytes
+    TraceCapacityRecords = $MatrixTraceCapacityRecords
+    TraceBufferLifecycle = "preallocate-once; reuse all cases; reset at end"
+    SelectedJournalModes = $JournalModes
+    SelectedAnalysisJournalModes = $AnalysisJournalModes
+    SelectedOperations = $OperationNames
+    SelectedThreadCounts = $ThreadCounts
+    Note = "Transactions are total across workers; warmup is per worker."
+    Cases = $cases
+}
+$matrixDescription | ConvertTo-Json -Depth 8 | Out-File `
+    -LiteralPath (Join-Path $OutputRoot "matrix.json") `
+    -Encoding utf8 `
+    -Width 4096
+
+if (-not $SkipSpaceChecks) {
+    [uint64]$requiredHostBytes = 4GB
+    foreach ($case in $cases) {
+        $requiredHostBytes += [uint64]$case.TraceBufferMb * 1MB
+    }
+    try {
+        $rootPath = [System.IO.Path]::GetPathRoot($OutputRoot)
+        $drive = [System.IO.DriveInfo]::new($rootPath)
+        if ([uint64]$drive.AvailableFreeSpace -lt $requiredHostBytes) {
+            $message = (
+                "Host output volume has {0:N2} GiB free; worst-case " +
+                "trace storage requires about {1:N2} GiB"
+            ) -f (
+                $drive.AvailableFreeSpace / 1GB
+            ), (
+                $requiredHostBytes / 1GB
+            )
+            throw $message
+        }
+    }
+    catch {
+        if ($_.Exception.Message -like "Host output volume has*") {
+            throw
+        }
+        Write-Warning (
+            "Could not determine host free space: " +
+            $_.Exception.Message
+        )
+    }
+}
+
+$getState = Invoke-AdbCommand `
+    -Arguments @("get-state") `
+    -LogPath (Join-Path $controlRoot "adb-get-state.txt")
+if ($getState.ExitCode -ne 0 -or $getState.Text -notmatch "(?m)^device$") {
+    throw "adb device is not ready; see control/adb-get-state.txt"
+}
+
+$quotedBenchmark = ConvertTo-PosixSingleQuoted -Value $DeviceBenchmark
+$quotedTraceDir = ConvertTo-PosixSingleQuoted -Value $TraceControlDir
+$quotedRunRoot = ConvertTo-PosixSingleQuoted -Value $deviceRunRoot
+$quotedDbRoot = ConvertTo-PosixSingleQuoted -Value $deviceDbRoot
+$quotedTraceRoot = ConvertTo-PosixSingleQuoted -Value $deviceTraceRoot
+$quotedEnable = ConvertTo-PosixSingleQuoted -Value (
+    $TraceControlDir.TrimEnd("/") + "/enable"
+)
+$quotedReset = ConvertTo-PosixSingleQuoted -Value (
+    $TraceControlDir.TrimEnd("/") + "/reset"
+)
+$quotedBufferSize = ConvertTo-PosixSingleQuoted -Value (
+    $TraceControlDir.TrimEnd("/") + "/buffer_size_mb"
+)
+$quotedStats = ConvertTo-PosixSingleQuoted -Value (
+    $TraceControlDir.TrimEnd("/") + "/stats"
+)
+
+$preflightCommand = @(
+    "set -e;"
+    "if [ ! -d $quotedTraceDir ]; then"
+    "  mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null || true;"
+    "fi;"
+    "test `$(id -u) -eq 0;"
+    "test -x $quotedBenchmark;"
+    "test -d $quotedTraceDir;"
+    "test -w $quotedEnable;"
+    "test -w $quotedReset;"
+    "test -w $quotedBufferSize;"
+    "mkdir -p $quotedRunRoot $quotedDbRoot $quotedTraceRoot;"
+    "echo 0 > $quotedEnable;"
+    "echo preflight_ok"
+) -join " "
+$preflight = Invoke-RootCommand `
+    -InnerCommand $preflightCommand `
+    -LogPath (Join-Path $controlRoot "device-preflight.txt")
+if ($preflight.ExitCode -ne 0 -or
+        $preflight.Text -notmatch "preflight_ok") {
+    throw "Device/root/tracer preflight failed; see control/device-preflight.txt"
+}
+
+if (-not $SkipSpaceChecks) {
+    $availableKiB = Get-DeviceAvailableKiB `
+        -RemotePath $deviceRunRoot `
+        -LogPath (Join-Path $controlRoot "device-df-initial.txt")
+    [uint64]$minimumDeviceKiB = [uint64]$MinimumDeviceFreeGiB * 1MB
+    if ($availableKiB -lt $minimumDeviceKiB) {
+        $message = (
+            "Device has {0:N2} GiB free; at least {1} GiB is required"
+        ) -f ($availableKiB / 1MB), $MinimumDeviceFreeGiB
+        throw $message
+    }
+}
+
+$bufferPreallocateCommand = @(
+    "set +e;"
+    "echo preallocation_phase=begin;"
+    "echo preallocation_boot_id;"
+    "cat /proc/sys/kernel/random/boot_id;"
+    "echo preallocation_uptime;"
+    "cat /proc/uptime;"
+    "echo preallocation_meminfo_before;"
+    "cat /proc/meminfo;"
+    "echo preallocation_debugfs_before;"
+    "cat $quotedBufferSize 2>/dev/null || true;"
+    "cat $quotedEnable 2>/dev/null || true;"
+    "echo 0 > $quotedEnable;"
+    "stop_rc=`$?;"
+    "echo preallocation_stop_rc=`$stop_rc;"
+    "if [ `$stop_rc -ne 0 ]; then exit `$stop_rc; fi;"
+    "echo $MatrixTraceBufferMb > $quotedBufferSize;"
+    "size_rc=`$?;"
+    "echo preallocation_size_rc=`$size_rc;"
+    "if [ `$size_rc -ne 0 ]; then exit `$size_rc; fi;"
+    "echo 1 > $quotedEnable;"
+    "start_rc=`$?;"
+    "echo preallocation_start_rc=`$start_rc;"
+    "if [ `$start_rc -ne 0 ]; then"
+    "  echo preallocation_boot_id_after_failure;"
+    "  cat /proc/sys/kernel/random/boot_id || true;"
+    "  echo preallocation_uptime_after_failure;"
+    "  cat /proc/uptime || true;"
+    "  echo preallocation_meminfo_after_failure;"
+    "  cat /proc/meminfo || true;"
+    "  echo preallocation_debugfs_after_failure;"
+    "  cat $quotedBufferSize 2>/dev/null || true;"
+    "  cat $quotedEnable 2>/dev/null || true;"
+    "  dmesg | tail -n 300 || true;"
+    "  exit `$start_rc;"
+    "fi;"
+    "echo 0 > $quotedEnable;"
+    "final_stop_rc=`$?;"
+    "echo preallocation_final_stop_rc=`$final_stop_rc;"
+    "if [ `$final_stop_rc -ne 0 ]; then exit `$final_stop_rc; fi;"
+    "echo preallocation_boot_id_after_success;"
+    "cat /proc/sys/kernel/random/boot_id || true;"
+    "echo preallocation_uptime_after_success;"
+    "cat /proc/uptime || true;"
+    "echo preallocation_meminfo_after_success;"
+    "cat /proc/meminfo || true;"
+    "cat $quotedStats;"
+    "stats_rc=`$?;"
+    "echo preallocation_stats_rc=`$stats_rc;"
+    "if [ `$stats_rc -ne 0 ]; then exit `$stats_rc; fi;"
+    "echo buffer_preallocation_ok"
+) -join " "
+$bufferPreallocate = Invoke-RootCommand `
+    -InnerCommand $bufferPreallocateCommand `
+    -LogPath (Join-Path $controlRoot "device-buffer-preallocate.txt")
+if ($bufferPreallocate.ExitCode -ne 0 -or
+        $bufferPreallocate.Text -notmatch "buffer_preallocation_ok") {
+    $preallocationStartRc = Get-LastIntegerMarker `
+        -Text $bufferPreallocate.Text `
+        -Name "preallocation_start_rc"
+    throw (
+        "4 GiB trace buffer preallocation failed " +
+        "(adb_rc={0}, enable_rc={1}); see " +
+        "control/device-buffer-preallocate.txt"
+    ) -f $bufferPreallocate.ExitCode, $preallocationStartRc
+}
+$preflightBufferBytes = Get-KernelStat `
+    -Text $bufferPreallocate.Text `
+    -Name "buffer_bytes"
+$preflightCapacity = Get-KernelStat `
+    -Text $bufferPreallocate.Text `
+    -Name "capacity_records"
+$preflightEnabled = Get-KernelStat `
+    -Text $bufferPreallocate.Text `
+    -Name "enabled"
+if ($preflightBufferBytes -ne $MatrixTraceBufferBytes -or
+        $preflightCapacity -ne $MatrixTraceCapacityRecords -or
+        $preflightEnabled -ne 0) {
+    throw (
+        "4 GiB trace buffer preallocation validation failed: " +
+        "buffer_bytes={0}, capacity_records={1}, enabled={2}; " +
+        "see control/device-buffer-preallocate.txt"
+    ) -f $preflightBufferBytes, $preflightCapacity, $preflightEnabled
+}
+
+for ($caseIndex = 0; $caseIndex -lt $cases.Count; $caseIndex++) {
+    if ($abortRequested) {
+        break
+    }
+
+    $case = $cases[$caseIndex]
+    $caseId = [string]$case.CaseId
+    $remoteDbDir = $deviceDbRoot + "/" + $caseId
+    $remoteTrace = $deviceTraceRoot + "/" + $caseId + ".bin"
+    $remoteStats = $remoteTrace + ".stats"
+    Assert-SafeRemotePath -Path $remoteDbDir -AllowedRoot $deviceRunRoot
+    Assert-SafeRemotePath -Path $remoteTrace -AllowedRoot $deviceRunRoot
+    Assert-SafeRemotePath -Path $remoteStats -AllowedRoot $deviceRunRoot
+
+    $localTrace = Join-Path $traceRoot ($caseId + ".bin")
+    $localStats = Join-Path $statsRoot ($caseId + ".bin.stats")
+    $consoleLog = Join-Path $consoleRoot ($caseId + ".console.txt")
+    $setupLog = Join-Path $consoleRoot ($caseId + ".setup.txt")
+    $spaceLog = Join-Path $consoleRoot ($caseId + ".df.txt")
+    $chmodLog = Join-Path $consoleRoot ($caseId + ".chmod.txt")
+    $pullTraceLog = Join-Path $consoleRoot ($caseId + ".pull-bin.txt")
+    $pullStatsLog = Join-Path $consoleRoot ($caseId + ".pull-stats.txt")
+    $cleanupLog = Join-Path $consoleRoot ($caseId + ".cleanup.txt")
+    $commandLog = Join-Path $consoleRoot ($caseId + ".command.txt")
+
+    $setupRc = $null
+    $adbRunRc = $null
+    $remoteRunRc = $null
+    $chmodRc = $null
+    $pullTraceRc = $null
+    $pullStatsRc = $null
+    $cleanupRc = $null
+    $configurationValidation = $false
+    $traceValidation = $false
+    $workloadComplete = $false
+    $statsValidation = $false
+    $traceEnvelopeValidation = $false
+    $traceLengthValidation = $false
+    $benchmarkBeginNs = $null
+    $transactionsEndNs = $null
+    $finalEndNs = $null
+    $traceStartNs = $null
+    $traceStopNs = $null
+    $expectedTraceBytes = $null
+    $localTraceBytes = $null
+    $records = $null
+    $capacityRecords = $null
+    $fsyncRecords = $null
+    $fdatasyncRecords = $null
+    $tgidFilter = $null
+    $recordUtilization = $null
+    $hostSha256 = ""
+    $caseFailed = $false
+    $failureReason = ""
+
+    Write-Host ""
+    $caseMessage = (
+        "[{0}/{1}] {2}: journal={3} operation={4} threads={5} " +
+        "trace_buffer={6}MiB"
+    ) -f (
+        $caseIndex + 1
+    ), $cases.Count, $caseId, $case.JournalMode, $case.Operation,
+        $case.Threads, $case.TraceBufferMb
+    Write-Host $caseMessage
+
+    try {
+        $quotedDbDir = ConvertTo-PosixSingleQuoted -Value $remoteDbDir
+        $quotedRemoteTrace = ConvertTo-PosixSingleQuoted -Value $remoteTrace
+        $quotedRemoteStats = ConvertTo-PosixSingleQuoted -Value $remoteStats
+        $setupCommand = @(
+            "set -e;"
+            "echo 0 > $quotedEnable;"
+            "rm -rf -- $quotedDbDir;"
+            "rm -f -- $quotedRemoteTrace $quotedRemoteStats;"
+            "mkdir -p -- $quotedDbDir;"
+            "sync"
+        ) -join " "
+        $setup = Invoke-RootCommand `
+            -InnerCommand $setupCommand `
+            -LogPath $setupLog
+        $setupRc = $setup.ExitCode
+        if ($setupRc -ne 0) {
+            throw "case setup failed with rc=$setupRc"
+        }
+
+        if (-not $SkipSpaceChecks) {
+            $availableKiB = Get-DeviceAvailableKiB `
+                -RemotePath $deviceRunRoot `
+                -LogPath $spaceLog
+            [uint64]$minimumDeviceKiB =
+                [uint64]$MinimumDeviceFreeGiB * 1MB
+            if ($availableKiB -lt $minimumDeviceKiB) {
+                $message = (
+                    "device free space is {0:N2} GiB, below {1} GiB"
+                ) -f ($availableKiB / 1MB), $MinimumDeviceFreeGiB
+                throw $message
+            }
+        }
+
+        $benchmarkArguments = @(
+            $DeviceBenchmark,
+            "--per-thread-db",
+            "--db-dir", $remoteDbDir,
+            "--operation", [string]$case.Operation,
+            "--journal-mode", [string]$case.JournalMode,
+            "--synchronous", "FULL",
+            "--trace-dir", $TraceControlDir,
+            "--threads", [string]$case.Threads,
+            "--transactions", [string]$case.Transactions,
+            "--warmup", [string]$case.WarmupPerThread,
+            "--tables", [string]$case.Tables,
+            "--operations-per-table", [string]$case.OperationsPerTable,
+            "--payload", [string]$case.PayloadBytes,
+            "--working-set", [string]$case.WorkingSetPerDatabase,
+            "--random-key",
+            "--busy-timeout", [string]$case.BusyTimeoutMs,
+            "--trace-buffer-mb", [string]$case.TraceBufferMb,
+            "--output-log", $remoteTrace
+        )
+        if ($case.JournalMode -eq "WAL") {
+            $benchmarkArguments += "--wal-autocheckpoint"
+            $benchmarkArguments += [string]$WalAutocheckpoint
+        }
+
+        $benchmarkCommand = Join-PosixCommand `
+            -ArgumentList $benchmarkArguments
+        $benchmarkCommand +=
+            '; rc=$?; echo __BENCH_RC__=$rc; exit $rc'
+        $benchmarkCommand | Out-File `
+            -LiteralPath $commandLog `
+            -Encoding utf8 `
+            -Width 4096
+
+        $run = Invoke-RootCommand `
+            -InnerCommand $benchmarkCommand `
+            -LogPath $consoleLog `
+            -EchoOutput
+        $adbRunRc = $run.ExitCode
+        $remoteRunRc = Get-LastIntegerMarker `
+            -Text $run.Text `
+            -Name "__BENCH_RC__"
+
+        $effectiveLine = Get-LastPrefixedLine `
+            -Text $run.Text `
+            -Prefix "sqlite_effective "
+        $configurationLine = Get-LastPrefixedLine `
+            -Text $run.Text `
+            -Prefix "configuration "
+        $expectedJournalLower = (
+            [string]$case.JournalMode
+        ).ToLowerInvariant()
+        $configurationValidation = (
+            (Test-KeyValueToken -Line $effectiveLine `
+                -Name "journal_mode" -Value $expectedJournalLower) -and
+            (Test-KeyValueToken -Line $effectiveLine `
+                -Name "synchronous" -Value "2") -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "db_mode" -Value "per-thread-db") -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "operation" -Value ([string]$case.Operation)) -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "journal_mode" -Value ([string]$case.JournalMode)) -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "synchronous" -Value "FULL") -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "threads" -Value ([string]$case.Threads)) -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "transactions_total" `
+                -Value ([string]$case.Transactions)) -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "warmup_per_thread" `
+                -Value ([string]$case.WarmupPerThread)) -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "tables" -Value ([string]$case.Tables)) -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "operations_per_table" `
+                -Value ([string]$case.OperationsPerTable)) -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "payload_bytes" -Value ([string]$case.PayloadBytes)) -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "working_set" `
+                -Value ([string]$case.WorkingSetPerDatabase)) -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "key_order" -Value "random-permutation") -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "busy_timeout_ms" `
+                -Value ([string]$case.BusyTimeoutMs)) -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "trace" -Value "on") -and
+            (Test-KeyValueToken -Line $configurationLine `
+                -Name "trace_filter" -Value "hit")
+        )
+        if ($case.JournalMode -eq "WAL") {
+            $configurationValidation = $configurationValidation -and
+                (Test-KeyValueToken -Line $effectiveLine `
+                    -Name "wal_autocheckpoint" `
+                    -Value ([string]$WalAutocheckpoint)) -and
+                (Test-KeyValueToken -Line $configurationLine `
+                    -Name "wal_autocheckpoint" `
+                    -Value ([string]$WalAutocheckpoint))
+        }
+
+        $clockMatches = [regex]::Matches(
+            $run.Text,
+            "(?m)^benchmark_clock clock=CLOCK_MONOTONIC " +
+            "benchmark_begin_ns=([0-9]+) " +
+            "transactions_end_ns=([0-9]+) final_end_ns=([0-9]+)[ \t]*$"
+        )
+        if ($clockMatches.Count -gt 0) {
+            $lastClock = $clockMatches[$clockMatches.Count - 1]
+            $benchmarkBeginNs = [uint64]$lastClock.Groups[1].Value
+            $transactionsEndNs = [uint64]$lastClock.Groups[2].Value
+            $finalEndNs = [uint64]$lastClock.Groups[3].Value
+        }
+
+        $traceValidation = [regex]::IsMatch(
+            $run.Text,
+            "(?m)^trace_validation status=VALID complete=1 " +
+            "stopped_full=0 dropped=0 invalid_records=0[ \t]*$"
+        )
+        $workloadMatches = [regex]::Matches(
+            $run.Text,
+            "(?m)^workload requested=([0-9]+) completed=([0-9]+)\b"
+        )
+        if ($workloadMatches.Count -gt 0) {
+            $lastWorkload = $workloadMatches[$workloadMatches.Count - 1]
+            [uint64]$requested = $lastWorkload.Groups[1].Value
+            [uint64]$completed = $lastWorkload.Groups[2].Value
+            $workloadComplete = (
+                $requested -eq $Transactions -and
+                $completed -eq $Transactions
+            )
+        }
+        $traceByteMatches = [regex]::Matches(
+            $run.Text,
+            "(?m)^trace_log path=\S+ bytes=([0-9]+)[ \t]*$"
+        )
+        if ($traceByteMatches.Count -gt 0) {
+            $expectedTraceBytes = [uint64]$traceByteMatches[
+                $traceByteMatches.Count - 1
+            ].Groups[1].Value
+        }
+
+        if ($adbRunRc -ne 0) {
+            $caseFailed = $true
+            $failureReason += "adb_run_rc=$adbRunRc;"
+        }
+        if ($null -eq $remoteRunRc) {
+            $caseFailed = $true
+            $failureReason += "missing_remote_exit_marker;"
+        }
+        elseif ($remoteRunRc -ne 0) {
+            $caseFailed = $true
+            $failureReason += "remote_run_rc=$remoteRunRc;"
+        }
+        if (-not $traceValidation) {
+            $caseFailed = $true
+            $failureReason += "trace_validation_failed;"
+        }
+        if (-not $workloadComplete) {
+            $caseFailed = $true
+            $failureReason += "workload_incomplete;"
+        }
+        if (-not $configurationValidation) {
+            $caseFailed = $true
+            $failureReason += "effective_configuration_mismatch;"
+        }
+
+        $chmodCommand = @(
+            "if [ -f $quotedRemoteTrace ]; then"
+            "  chmod 0644 $quotedRemoteTrace;"
+            "fi;"
+            "if [ -f $quotedRemoteStats ]; then"
+            "  chmod 0644 $quotedRemoteStats;"
+            "fi"
+        ) -join " "
+        $chmod = Invoke-RootCommand `
+            -InnerCommand $chmodCommand `
+            -LogPath $chmodLog
+        $chmodRc = $chmod.ExitCode
+
+        Remove-Item -LiteralPath $localTrace -Force -ErrorAction SilentlyContinue
+        Remove-Item -LiteralPath $localStats -Force -ErrorAction SilentlyContinue
+
+        $pullTrace = Invoke-AdbCommand `
+            -Arguments @("pull", $remoteTrace, $localTrace) `
+            -LogPath $pullTraceLog
+        $pullTraceRc = $pullTrace.ExitCode
+        if ($pullTraceRc -ne 0 -or
+                -not (Test-Path -LiteralPath $localTrace -PathType Leaf)) {
+            $caseFailed = $true
+            $failureReason += "trace_pull_failed;"
+        }
+
+        $pullStats = Invoke-AdbCommand `
+            -Arguments @("pull", $remoteStats, $localStats) `
+            -LogPath $pullStatsLog
+        $pullStatsRc = $pullStats.ExitCode
+        if ($pullStatsRc -ne 0 -or
+                -not (Test-Path -LiteralPath $localStats -PathType Leaf)) {
+            $caseFailed = $true
+            $failureReason += "stats_pull_failed;"
+        }
+
+        if (Test-Path -LiteralPath $localTrace -PathType Leaf) {
+            $traceInfo = Get-Item -LiteralPath $localTrace
+            $localTraceBytes = [uint64]$traceInfo.Length
+            if ($null -ne $expectedTraceBytes) {
+                $traceLengthValidation =
+                    $localTraceBytes -eq $expectedTraceBytes
+            }
+            if (-not $traceLengthValidation) {
+                $caseFailed = $true
+                $failureReason += "trace_byte_count_mismatch;"
+            }
+            $hostSha256 = (
+                Get-FileHash -LiteralPath $localTrace -Algorithm SHA256
+            ).Hash
+        }
+
+        if (Test-Path -LiteralPath $localStats -PathType Leaf) {
+            $statsText = Get-Content -LiteralPath $localStats -Raw
+            $completeStat = Get-KernelStat -Text $statsText -Name "complete"
+            $stoppedFullStat = Get-KernelStat `
+                -Text $statsText `
+                -Name "stopped_full"
+            $droppedStat = Get-KernelStat -Text $statsText -Name "dropped"
+            $invalidStat = Get-KernelStat `
+                -Text $statsText `
+                -Name "invalid_records"
+            $enabledStat = Get-KernelStat -Text $statsText -Name "enabled"
+            $records = Get-KernelStat -Text $statsText -Name "records"
+            $capacityRecords = Get-KernelStat `
+                -Text $statsText `
+                -Name "capacity_records"
+            $fsyncRecords = Get-KernelStat `
+                -Text $statsText `
+                -Name "fsync_records"
+            $fdatasyncRecords = Get-KernelStat `
+                -Text $statsText `
+                -Name "fdatasync_records"
+            $tgidFilter = Get-KernelStat -Text $statsText -Name "tgid_filter"
+            $traceStartNs = Get-KernelStat -Text $statsText -Name "start_ns"
+            $traceStopNs = Get-KernelStat -Text $statsText -Name "stop_ns"
+            $fsyncErrors = Get-KernelStat `
+                -Text $statsText `
+                -Name "fsync_errors"
+            $physicalCheckpointErrors = Get-KernelStat `
+                -Text $statsText `
+                -Name "physical_checkpoint_errors"
+            $physicalCheckpointInvalid = Get-KernelStat `
+                -Text $statsText `
+                -Name "physical_checkpoint_invalid"
+            $balanceInvalid = Get-KernelStat `
+                -Text $statsText `
+                -Name "balance_checkpoint_invalid"
+            $balanceErrors = Get-KernelStat `
+                -Text $statsText `
+                -Name "balance_checkpoint_errors"
+            $dataBreakdownInvalid = Get-KernelStat `
+                -Text $statsText `
+                -Name "data_breakdown_invalid_records"
+            $submitDetailInvalid = Get-KernelStat `
+                -Text $statsText `
+                -Name "submit_detail_invalid_records"
+            $associationInvalid = Get-KernelStat `
+                -Text $statsText `
+                -Name "association_invalid_records"
+            $traceEnvelopeValidation = (
+                $null -ne $traceStartNs -and
+                $null -ne $traceStopNs -and
+                $null -ne $benchmarkBeginNs -and
+                $null -ne $transactionsEndNs -and
+                $null -ne $finalEndNs -and
+                $traceStartNs -gt 0 -and
+                $traceStartNs -le $benchmarkBeginNs -and
+                $benchmarkBeginNs -le $transactionsEndNs -and
+                $transactionsEndNs -le $finalEndNs -and
+                $finalEndNs -le $traceStopNs
+            )
+            $statsValidation = (
+                $completeStat -eq 1 -and
+                $stoppedFullStat -eq 0 -and
+                $droppedStat -eq 0 -and
+                $invalidStat -eq 0 -and
+                $enabledStat -eq 0 -and
+                $fsyncErrors -eq 0 -and
+                $physicalCheckpointErrors -eq 0 -and
+                $physicalCheckpointInvalid -eq 0 -and
+                $balanceInvalid -eq 0 -and
+                $balanceErrors -eq 0 -and
+                $dataBreakdownInvalid -eq 0 -and
+                $submitDetailInvalid -eq 0 -and
+                $associationInvalid -eq 0 -and
+                $null -ne $fsyncRecords -and
+                $fsyncRecords -gt 0 -and
+                $null -ne $tgidFilter -and
+                $tgidFilter -gt 0 -and
+                $tgidFilter -lt 4294967295 -and
+                $null -ne $records -and
+                $null -ne $capacityRecords -and
+                $records -gt 0 -and
+                $capacityRecords -gt 0 -and
+                $records -lt $capacityRecords
+            )
+            if ($null -ne $records -and $null -ne $capacityRecords -and
+                    $capacityRecords -ne 0) {
+                $recordUtilization = [double]$records /
+                    [double]$capacityRecords
+            }
+            if (-not $statsValidation) {
+                $caseFailed = $true
+                $failureReason += "kernel_stats_validation_failed;"
+            }
+            if (-not $traceEnvelopeValidation) {
+                $caseFailed = $true
+                $failureReason += "trace_envelope_invalid;"
+            }
+            if ($null -ne $records -and $null -ne $localTraceBytes) {
+                [uint64]$calculatedBytes = 256 + [uint64]$records * 576
+                if ($localTraceBytes -ne $calculatedBytes) {
+                    $caseFailed = $true
+                    $failureReason += "records_vs_file_size_mismatch;"
+                    $traceLengthValidation = $false
+                }
+            }
+        }
+    }
+    catch {
+        if ($_.Exception -is [System.Management.Automation.PipelineStoppedException]) {
+            throw
+        }
+        $caseFailed = $true
+        if ([string]::IsNullOrWhiteSpace($failureReason)) {
+            $failureReason = $_.Exception.Message
+        }
+        else {
+            $failureReason += $_.Exception.Message
+        }
+        $_.Exception.ToString() | Out-File `
+            -LiteralPath (Join-Path $consoleRoot ($caseId + ".exception.txt")) `
+            -Encoding utf8 `
+            -Width 4096
+    }
+    finally {
+        $quotedDbDir = ConvertTo-PosixSingleQuoted -Value $remoteDbDir
+        $quotedRemoteTrace = ConvertTo-PosixSingleQuoted -Value $remoteTrace
+        $quotedRemoteStats = ConvertTo-PosixSingleQuoted -Value $remoteStats
+        $cleanupParts = @(
+            "control_rc=0;"
+            "echo 0 > $quotedEnable 2>/dev/null || control_rc=1;"
+        )
+        if (-not $KeepDeviceArtifacts) {
+            $cleanupParts +=
+                "rm -rf -- $quotedDbDir || control_rc=1;"
+            $cleanupParts +=
+                ("rm -f -- $quotedRemoteTrace $quotedRemoteStats " +
+                "|| control_rc=1;")
+            $cleanupParts += "sync || control_rc=1;"
+        }
+        $cleanupParts += 'exit $control_rc'
+        try {
+            $cleanup = Invoke-RootCommand `
+                -InnerCommand ($cleanupParts -join " ") `
+                -LogPath $cleanupLog
+            $cleanupRc = $cleanup.ExitCode
+        }
+        catch {
+            if ($_.Exception -is [System.Management.Automation.PipelineStoppedException]) {
+                throw
+            }
+            $cleanupRc = 255
+            $failureReason += "cleanup_exception;"
+            $_.Exception.ToString() | Out-File `
+                -LiteralPath (Join-Path $consoleRoot ($caseId + ".cleanup-exception.txt")) `
+                -Encoding utf8 `
+                -Width 4096
+        }
+        if ($cleanupRc -ne 0) {
+            $caseFailed = $true
+            $failureReason += "cleanup_failed;"
+        }
+
+        $status = if ($caseFailed) { "FAILED" } else { "VALID" }
+        $row = [pscustomobject][ordered]@{
+            CaseId = $caseId
+            ResultOrigin = "current_run"
+            JournalMode = $case.JournalMode
+            Operation = $case.Operation
+            Threads = $case.Threads
+            Transactions = $case.Transactions
+            WarmupPerThread = $case.WarmupPerThread
+            WalAutocheckpoint = $case.WalAutocheckpoint
+            TraceBufferMb = $case.TraceBufferMb
+            Status = $status
+            FailureReason = $failureReason
+            SetupRc = $setupRc
+            AdbRunRc = $adbRunRc
+            RemoteRunRc = $remoteRunRc
+            ChmodRc = $chmodRc
+            PullTraceRc = $pullTraceRc
+            PullStatsRc = $pullStatsRc
+            CleanupRc = $cleanupRc
+            ConfigurationValidation = $configurationValidation
+            TraceValidation = $traceValidation
+            WorkloadComplete = $workloadComplete
+            KernelStatsValidation = $statsValidation
+            TraceEnvelopeValidation = $traceEnvelopeValidation
+            TraceLengthValidation = $traceLengthValidation
+            Records = $records
+            CapacityRecords = $capacityRecords
+            FsyncRecords = $fsyncRecords
+            FdatasyncRecords = $fdatasyncRecords
+            TgidFilter = $tgidFilter
+            BenchmarkBeginNs = $benchmarkBeginNs
+            TransactionsEndNs = $transactionsEndNs
+            FinalEndNs = $finalEndNs
+            TraceStartNs = $traceStartNs
+            TraceStopNs = $traceStopNs
+            RecordUtilization = $recordUtilization
+            LocalTraceBytes = $localTraceBytes
+            ExpectedTraceBytes = $expectedTraceBytes
+            TraceSha256 = $hostSha256
+            LocalTrace = $localTrace
+            LocalStats = $localStats
+            AnalysisRc = $null
+            AnalysisIntegrityValidation = $null
+            AnalysisStatus = "PENDING"
+            ReportPath = ""
+            CdfPath = ""
+        }
+        # Keep prior rows until their selected case has actually completed.
+        # This preserves provenance for not-yet-reached cases if the matrix is
+        # interrupted again partway through an incremental run.
+        $results = @($results | Where-Object {
+            [string]$_.CaseId -ne $caseId
+        })
+        $results += $row
+        Write-ResultsManifest `
+            -Rows $results `
+            -CsvPath $manifestCsv `
+            -JsonPath $manifestJson
+
+        if ($caseFailed) {
+            $anyFailure = $true
+            Write-Warning "$caseId failed: $failureReason"
+            if ($FailFast) {
+                $abortRequested = $true
+            }
+        }
+        else {
+            $validMessage = (
+                "{0} VALID: records={1}/{2} utilization={3:P2} sha256={4}"
+            ) -f $caseId, $records, $capacityRecords,
+                $recordUtilization, $hostSha256
+            Write-Host $validMessage
+        }
+    }
+
+    if ($CooldownSeconds -gt 0 -and
+            $caseIndex + 1 -lt $cases.Count -and
+            -not $abortRequested) {
+        Write-Host "Cooling down for $CooldownSeconds seconds..."
+        Start-Sleep -Seconds $CooldownSeconds
+    }
+}
+
+# All selected cases have stopped and copied their trace.  Release the shared
+# 4 GiB allocation exactly once before the potentially long offline analysis.
+$finalCleanupParts = @(
+    "control_rc=0;"
+    "echo 0 > $quotedEnable 2>/dev/null || control_rc=1;"
+    "echo 1 > $quotedReset 2>/dev/null || control_rc=1;"
+)
+if (-not $KeepDeviceArtifacts) {
+    $finalCleanupParts +=
+        "rm -rf -- $quotedRunRoot || control_rc=1;"
+}
+$finalCleanupParts += "sync || control_rc=1;"
+$finalCleanupParts += "exit `$control_rc"
+$finalCleanup = Invoke-RootCommand `
+    -InnerCommand ($finalCleanupParts -join " ") `
+    -LogPath (Join-Path $controlRoot "device-final-cleanup.txt")
+if ($finalCleanup.ExitCode -ne 0) {
+    $anyFailure = $true
+    Write-Warning (
+        "Final trace-buffer/device cleanup failed; see " +
+        "control/device-final-cleanup.txt"
+    )
+}
+}
+
+Write-Host ""
+if ($AnalysisOnly) {
+    Write-Host "Analysis-only mode. Starting offline analysis..."
+}
+else {
+    Write-Host "Device phase complete. Starting offline analysis..."
+}
+
+# The trace directory is authoritative for offline analysis.  By default this
+# includes traces from an earlier run in the same OutputRoot; the independent
+# AnalysisJournalModes filter can select only WAL or DELETE without touching
+# the other mode's prior analysis results.
+$resultByCase = @{}
+foreach ($existingResult in $results) {
+    $resultByCase[[string]$existingResult.CaseId] = $existingResult
+}
+foreach ($traceFile in @(Get-ChildItem -LiteralPath $traceRoot `
+        -Filter "*.bin" -File | Sort-Object -Property Name)) {
+    $discoveredCaseId = [System.IO.Path]::GetFileNameWithoutExtension(
+        $traceFile.Name
+    )
+    if ($resultByCase.ContainsKey($discoveredCaseId)) {
+        $resultByCase[$discoveredCaseId].LocalTrace = $traceFile.FullName
+        continue
+    }
+    $priorResult = $null
+    if ($priorResultByCase.ContainsKey($discoveredCaseId)) {
+        $priorResult = $priorResultByCase[$discoveredCaseId]
+    }
+    $discoveredResult = ConvertTo-ExistingTraceResult `
+        -PriorResult $priorResult `
+        -CaseId $discoveredCaseId `
+        -TracePath $traceFile.FullName `
+        -StatsPath (Join-Path $statsRoot ($traceFile.Name + ".stats"))
+    $results += $discoveredResult
+    $resultByCase[$discoveredCaseId] = $discoveredResult
+}
+$results = @($results | Sort-Object -Property CaseId)
+
+$analyzeEveryJournalMode = $AnalysisJournalModes.Count -eq 2
+$analysisResults = @(
+    foreach ($result in $results) {
+        if ($analyzeEveryJournalMode -or
+                (Get-ResultJournalMode -Result $result) -in
+                    $AnalysisJournalModes) {
+            $result
+        }
+    }
+)
+if ($analysisResults.Count -eq 0) {
+    throw (
+        "No traces match -AnalysisJournalModes {0} in {1}"
+    ) -f ($AnalysisJournalModes -join ","), $traceRoot
+}
+$analysisSelectionMessage = (
+    "Offline analysis journal modes: {0}; traces selected: {1}/{2}"
+) -f ($AnalysisJournalModes -join ","), $analysisResults.Count,
+    $results.Count
+Write-Host $analysisSelectionMessage
+
+for ($index = 0; $index -lt $analysisResults.Count; $index++) {
+    $row = $analysisResults[$index]
+    $tracePath = [string]$row.LocalTrace
+    $reportPath = Join-Path $reportRoot ($row.CaseId + ".report.txt")
+    $cdfPath = Join-Path $cdfRoot ($row.CaseId + ".flush-cdf.csv")
+    $analysisOutput = @()
+    $analysisRc = 255
+    $analysisIntegrityValidation = $false
+
+    if (-not (Test-Path -LiteralPath $tracePath -PathType Leaf)) {
+        $analysisOutput = @("error: trace file is missing: $tracePath")
+        $analysisRc = 2
+    }
+    elseif ((Get-Item -LiteralPath $tracePath).Length -lt 256) {
+        $analysisOutput = @("error: trace file is shorter than its header")
+        $analysisRc = 3
+    }
+    else {
+        Write-Host "Analyzing $($row.CaseId)..."
+        $savedAnalysisErrorActionPreference = $ErrorActionPreference
+        try {
+            $ErrorActionPreference = "Continue"
+            $analysisOutput = @(
+                & $Python `
+                    $Analyzer `
+                    $tracePath `
+                    "--flush-cdf" `
+                    $cdfPath `
+                    "--progress" `
+                    2>&1 |
+                    ForEach-Object {
+                        $isErrorRecord = $_ -is [System.Management.Automation.ErrorRecord]
+                        $line = if ($isErrorRecord -and
+                                $null -ne $_.Exception) {
+                            [string]$_.Exception.Message
+                        }
+                        else {
+                            [string]$_
+                        }
+                        if ($line -match
+                                "^(analysis_stage=|parsed [0-9]+/[0-9]+ records$)") {
+                            Write-Host ("  " + $line)
+                        }
+                        else {
+                            $line
+                        }
+                    }
+            )
+            $analysisRc = $LASTEXITCODE
+        }
+        catch {
+            if ($_.Exception -is [System.Management.Automation.PipelineStoppedException]) {
+                throw
+            }
+            $analysisOutput += $_.Exception.ToString()
+            $analysisRc = 255
+        }
+        finally {
+            $ErrorActionPreference = $savedAnalysisErrorActionPreference
+        }
+        $analysisOutput = @(
+            foreach ($item in $analysisOutput) {
+                if ($item -is [System.Management.Automation.ErrorRecord] -and
+                        $null -ne $item.Exception) {
+                    [string]$item.Exception.Message
+                }
+                else {
+                    [string]$item
+                }
+            }
+        )
+    }
+
+    $analysisOutput | ForEach-Object { [string]$_ } | Out-File `
+        -LiteralPath $reportPath `
+        -Encoding utf8 `
+        -Width 4096
+
+    if ($analysisRc -eq 0) {
+        $analysisText = ($analysisOutput |
+            ForEach-Object { [string]$_ }) -join "`n"
+        $declared = Get-LastIntegerMarker `
+            -Text $analysisText -Name "declared_records"
+        $available = Get-LastIntegerMarker `
+            -Text $analysisText -Name "available_records"
+        $parsed = Get-LastIntegerMarker `
+            -Text $analysisText -Name "parsed_records"
+        $valid = Get-LastIntegerMarker `
+            -Text $analysisText -Name "valid_records"
+        $validBreakdown = Get-LastIntegerMarker `
+            -Text $analysisText -Name "valid_breakdown_records"
+        $validSubmitDetail = Get-LastIntegerMarker `
+            -Text $analysisText -Name "valid_submit_page_detail_records"
+        $breakdownAdditivity = Get-LastPrefixedLine `
+            -Text $analysisText -Prefix "additivity_status="
+        $submitAdditivity = Get-LastPrefixedLine `
+            -Text $analysisText -Prefix "submit_page_additivity_status="
+        $analysisIntegrityValidation = (
+            (Get-LastIntegerMarker -Text $analysisText `
+                -Name "format_version") -eq 6 -and
+            (Get-LastIntegerMarker -Text $analysisText `
+                -Name "record_size") -eq 576 -and
+            $null -ne $declared -and
+            $null -ne $available -and
+            $null -ne $parsed -and
+            $null -ne $valid -and
+            $null -ne $validBreakdown -and
+            $null -ne $validSubmitDetail -and
+            $declared -eq $available -and
+            $available -eq $parsed -and
+            $parsed -eq $valid -and
+            (Get-LastIntegerMarker -Text $analysisText `
+                -Name "invalid_records") -eq 0 -and
+            (Get-LastIntegerMarker -Text $analysisText `
+                -Name "dropped") -eq 0 -and
+            (Get-LastIntegerMarker -Text $analysisText `
+                -Name "stopped_full") -eq 0 -and
+            (Get-LastIntegerMarker -Text $analysisText `
+                -Name "enabled") -eq 0 -and
+            (Get-LastIntegerMarker -Text $analysisText `
+                -Name "invalid_breakdown_records") -eq 0 -and
+            (Get-LastIntegerMarker -Text $analysisText `
+                -Name "invalid_submit_page_detail_records") -eq 0 -and
+            (Get-LastIntegerMarker -Text $analysisText `
+                -Name "invalid_physical_checkpoint_records") -eq 0 -and
+            (Get-LastIntegerMarker -Text $analysisText `
+                -Name "semantically_invalid_flush_records") -eq 0 -and
+            (Get-LastIntegerMarker -Text $analysisText `
+                -Name "semantically_invalid_records") -eq 0 -and
+            (Get-LastIntegerMarker -Text $analysisText `
+                -Name "association_invalid_waiters") -eq 0 -and
+            (($validBreakdown -eq 0) -or
+                $breakdownAdditivity -eq "additivity_status=VALID") -and
+            (($validSubmitDetail -eq 0) -or
+                $submitAdditivity -eq "submit_page_additivity_status=VALID") -and
+            $analysisText -notmatch
+                "WARNING: (invalid records were excluded|invalid stage samples were excluded|record consistency checks failed)"
+        )
+    }
+
+    $row.AnalysisRc = [int]$analysisRc
+    $row.AnalysisIntegrityValidation = $analysisIntegrityValidation
+    $row.ReportPath = $reportPath
+    $row.CdfPath = $cdfPath
+    if ($analysisRc -eq 0 -and
+            (Test-Path -LiteralPath $cdfPath -PathType Leaf)) {
+        if (-not $analysisIntegrityValidation) {
+            $row.AnalysisStatus = "FAILED"
+            $anyFailure = $true
+        }
+        else {
+            $row.AnalysisStatus = if ($row.Status -eq "VALID") {
+                "VALID"
+            }
+            else {
+                "DIAGNOSTIC_ONLY"
+            }
+        }
+    }
+    else {
+        $row.AnalysisStatus = "FAILED"
+        $anyFailure = $true
+    }
+
+    # Persist one completed analysis at a time.  An interrupted long-running
+    # DELETE analysis therefore keeps both prior results and every case that
+    # already finished in this invocation; the in-progress case is untouched.
+    Write-ResultsManifest `
+        -Rows $results `
+        -CsvPath $manifestCsv `
+        -JsonPath $manifestJson
+}
+
+Write-ResultsManifest `
+    -Rows $results `
+    -CsvPath $manifestCsv `
+    -JsonPath $manifestJson
+
+Write-Host ""
+Write-Host "Output root: $OutputRoot"
+Write-Host "Manifest CSV: $manifestCsv"
+Write-Host "Trace directory: $traceRoot"
+Write-Host "Report directory: $reportRoot"
+Write-Host "CDF directory: $cdfRoot"
+Write-Host ""
+$results | Select-Object -Property @(
+    "CaseId",
+    "Status",
+    "AnalysisStatus",
+    "Records",
+    "CapacityRecords",
+    "RecordUtilization"
+) | Format-Table -AutoSize
+
+if ($anyFailure) {
+    Write-Error (
+        "One or more cases or analyses failed. See results.csv and the " +
+        "per-case console/report files."
+    )
+    exit 1
+}
+
+exit 0
diff --git a/tools/testing/f2fs_fsync_latency/sqlite_fsync_bench.cpp b/tools/testing/f2fs_fsync_latency/sqlite_fsync_bench.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..12c122cd703898be5af9b93a6079e96b55e9e5ad
--- /dev/null
+++ b/tools/testing/f2fs_fsync_latency/sqlite_fsync_bench.cpp
@@ -0,0 +1,2276 @@
+// SPDX-License-Identifier: Apache-2.0
+/*
+ * Native SQLite workload for the F2FS fsync latency tracer.
+ *
+ * The measured path has no benchmark-owned shared locks, allocation, or
+ * printing.  Every worker owns its SQLite connection and preallocated sample
+ * arrays.  The only shared writer serialization in shared-db mode is inside
+ * SQLite and the filesystem, which is the behavior that mode is intended to
+ * exercise.
+ */
+
+#include <sqlite3.h>
+
+#if !defined(SQLITE_VERSION_NUMBER) || SQLITE_VERSION_NUMBER < 3008008
+#error "sqlite_fsync_bench requires SQLite 3.8.8 or newer"
+#endif
+
+#include <algorithm>
+#include <cerrno>
+#include <cmath>
+#include <condition_variable>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <exception>
+#include <fcntl.h>
+#include <functional>
+#include <inttypes.h>
+#include <limits>
+#include <mutex>
+#include <string>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <sys/types.h>
+#include <thread>
+#include <time.h>
+#include <unistd.h>
+#include <utility>
+#include <vector>
+
+namespace {
+
+constexpr const char kDefaultDbDir[] =
+	"/data/local/tmp/f2fs_fsync_latency_db";
+constexpr const char kDefaultTraceDir[] =
+	"/sys/kernel/debug/f2fs_fsync_latency";
+constexpr const char kDefaultOutputLog[] =
+	"/data/local/tmp/f2fs_fsync_latency.bin";
+constexpr uint32_t kDefaultThreads = 1;
+constexpr uint64_t kDefaultTransactions = 1000000;
+constexpr uint64_t kDefaultWarmup = 100;
+constexpr uint64_t kDefaultOperationsPerTable = 1;
+constexpr uint64_t kDefaultPayloadBytes = 100;
+constexpr uint64_t kDefaultWorkingSet = 1024;
+constexpr uint32_t kDefaultTables = 3;
+constexpr uint32_t kDefaultWalAutoCheckpoint = 1000;
+constexpr uint32_t kDefaultBusyTimeoutMs = 30000;
+constexpr uint32_t kDefaultTraceBufferMb = 2048;
+constexpr uint32_t kMaxThreads = 1024;
+constexpr uint32_t kMaxTables = 64;
+
+enum class DatabaseMode {
+	kPerThread,
+	kShared,
+};
+
+enum class JournalMode {
+	kWal,
+	kDelete,
+};
+
+enum class Operation {
+	kInsert,
+	kUpdate,
+	kDelete,
+};
+
+enum class SynchronousMode {
+	kFull,
+	kNormal,
+	kExtra,
+	kOff,
+};
+
+struct Options {
+	DatabaseMode database_mode = DatabaseMode::kPerThread;
+	JournalMode journal_mode = JournalMode::kWal;
+	SynchronousMode synchronous = SynchronousMode::kFull;
+	Operation operation = Operation::kInsert;
+	uint32_t threads = kDefaultThreads;
+	uint64_t transactions = kDefaultTransactions;
+	uint64_t warmup = kDefaultWarmup;
+	uint64_t operations_per_table = kDefaultOperationsPerTable;
+	uint64_t payload_bytes = kDefaultPayloadBytes;
+	uint64_t working_set = kDefaultWorkingSet;
+	uint32_t tables = kDefaultTables;
+	uint32_t wal_autocheckpoint = kDefaultWalAutoCheckpoint;
+	uint32_t busy_timeout_ms = kDefaultBusyTimeoutMs;
+	uint32_t trace_buffer_mb = kDefaultTraceBufferMb;
+	std::string db_dir = kDefaultDbDir;
+	std::string trace_dir = kDefaultTraceDir;
+	std::string output_log = kDefaultOutputLog;
+	bool trace = true;
+	bool trace_filter_miss = false;
+	bool random_key = false;
+};
+
+void PrintUsage(const char *program)
+{
+	std::printf(
+		"Usage: %s [options]\n"
+		"\n"
+		"Workload layout (default: --per-thread-db):\n"
+		"  --per-thread-db             one independent database/connection per worker\n"
+		"  --shared-db                 independent connections to one shared database\n"
+		"  --db-mode MODE              per-thread-db or shared-db\n"
+		"  --db-dir PATH               database directory (default: %s)\n"
+		"\n"
+		"SQLite settings:\n"
+		"  --operation OP              insert, update, or delete (default: insert)\n"
+		"  --journal-mode MODE         WAL or DELETE (default: WAL)\n"
+		"  --wal | --delete            journal-mode aliases; --delete is not an operation\n"
+		"  --synchronous MODE          FULL, NORMAL, EXTRA, or OFF (default: FULL)\n"
+		"  --threads N                 worker threads (default: %u)\n"
+		"  --transactions N            measured transactions total across workers (default: %" PRIu64 ")\n"
+		"  --warmup N                  unmeasured transactions per thread (default: %" PRIu64 ")\n"
+		"  --tables N                  tables in each database (default: %u)\n"
+		"  --operations-per-table N    operation rounds per table per transaction (default: %" PRIu64 ")\n"
+		"  --rows-per-txn N            legacy alias for --operations-per-table\n"
+		"  --random-key                deterministic random key permutation\n"
+		"  --sequential-key            sequential keys (default)\n"
+		"  --payload N                 payload bytes per row (default: %" PRIu64 ")\n"
+		"  --working-set N             UPDATE rows/table; DELETE minimum; INSERT ignores (default: %" PRIu64 ")\n"
+		"  --wal-autocheckpoint N      SQLite WAL page threshold; 0 disables (default: %u)\n"
+		"  --busy-timeout N            SQLite busy timeout in ms (default: %u)\n"
+		"\n"
+		"Kernel trace settings:\n"
+		"  --trace-dir PATH            debugfs control directory (default: %s)\n"
+		"  --trace-buffer-mb N         in-kernel log size in MiB (default: %u)\n"
+		"  --output-log PATH           binary trace destination (default: %s)\n"
+		"                              text stats are also saved as PATH.stats\n"
+		"  --trace-filter-miss         enable trace with a deliberately unmatched TGID\n"
+		"  --no-trace                  run only userspace latency measurement\n"
+		"  -h, --help                  show this help\n",
+		program, kDefaultDbDir, kDefaultThreads, kDefaultTransactions,
+		kDefaultWarmup, kDefaultTables, kDefaultOperationsPerTable,
+		kDefaultPayloadBytes, kDefaultWorkingSet, kDefaultWalAutoCheckpoint,
+		kDefaultBusyTimeoutMs, kDefaultTraceDir, kDefaultTraceBufferMb,
+		kDefaultOutputLog);
+}
+
+std::string Uppercase(std::string value)
+{
+	for (char &c : value) {
+		if (c >= 'a' && c <= 'z')
+			c = static_cast<char>(c - 'a' + 'A');
+	}
+	return value;
+}
+
+bool ParseUnsigned(const std::string &text, uint64_t minimum,
+		uint64_t maximum, uint64_t *value, std::string *error)
+{
+	char *end = nullptr;
+	unsigned long long parsed;
+
+	if (text.empty() || text[0] == '-') {
+		*error = "invalid unsigned integer: " + text;
+		return false;
+	}
+	errno = 0;
+	parsed = std::strtoull(text.c_str(), &end, 0);
+	if (errno == ERANGE || end == text.c_str() || *end != '\0') {
+		*error = "invalid unsigned integer: " + text;
+		return false;
+	}
+	if (parsed < minimum || parsed > maximum) {
+		*error = "value out of range: " + text;
+		return false;
+	}
+	*value = static_cast<uint64_t>(parsed);
+	return true;
+}
+
+bool OptionValue(int argc, char **argv, int *index, const std::string &name,
+		const std::string &inline_value, bool has_inline,
+		std::string *value, std::string *error)
+{
+	if (has_inline) {
+		if (inline_value.empty()) {
+			*error = "missing value for " + name;
+			return false;
+		}
+		*value = inline_value;
+		return true;
+	}
+	if (*index + 1 >= argc) {
+		*error = "missing value for " + name;
+		return false;
+	}
+	++*index;
+	*value = argv[*index];
+	return true;
+}
+
+bool RejectInlineValue(const std::string &name, bool has_inline,
+		std::string *error)
+{
+	if (!has_inline)
+		return true;
+	*error = name + " does not take a value";
+	return false;
+}
+
+bool ParseArguments(int argc, char **argv, Options *options, bool *show_help,
+		std::string *error)
+{
+	*show_help = false;
+	for (int i = 1; i < argc; ++i) {
+		std::string argument = argv[i];
+		std::string name = argument;
+		std::string inline_value;
+		std::string value;
+		bool has_inline = false;
+		uint64_t number;
+		size_t equal = argument.find('=');
+
+		if (equal != std::string::npos) {
+			name = argument.substr(0, equal);
+			inline_value = argument.substr(equal + 1);
+			has_inline = true;
+		}
+
+		if (name == "-h" || name == "--help") {
+			if (!RejectInlineValue(name, has_inline, error))
+				return false;
+			*show_help = true;
+			return true;
+		} else if (name == "--per-thread-db") {
+			if (!RejectInlineValue(name, has_inline, error))
+				return false;
+			options->database_mode = DatabaseMode::kPerThread;
+		} else if (name == "--shared-db") {
+			if (!RejectInlineValue(name, has_inline, error))
+				return false;
+			options->database_mode = DatabaseMode::kShared;
+		} else if (name == "--wal") {
+			if (!RejectInlineValue(name, has_inline, error))
+				return false;
+			options->journal_mode = JournalMode::kWal;
+		} else if (name == "--delete") {
+			if (!RejectInlineValue(name, has_inline, error))
+				return false;
+			options->journal_mode = JournalMode::kDelete;
+		} else if (name == "--no-trace") {
+			if (!RejectInlineValue(name, has_inline, error))
+				return false;
+			options->trace = false;
+		} else if (name == "--trace-filter-miss") {
+			if (!RejectInlineValue(name, has_inline, error))
+				return false;
+			options->trace_filter_miss = true;
+		} else if (name == "--random-key") {
+			if (!RejectInlineValue(name, has_inline, error))
+				return false;
+			options->random_key = true;
+		} else if (name == "--sequential-key") {
+			if (!RejectInlineValue(name, has_inline, error))
+				return false;
+			options->random_key = false;
+		} else if (name == "--db-mode") {
+			if (!OptionValue(argc, argv, &i, name, inline_value,
+					has_inline, &value, error))
+				return false;
+			value = Uppercase(value);
+			if (value == "PER-THREAD-DB" || value == "PER_THREAD_DB")
+				options->database_mode = DatabaseMode::kPerThread;
+			else if (value == "SHARED-DB" || value == "SHARED_DB")
+				options->database_mode = DatabaseMode::kShared;
+			else {
+				*error = "--db-mode must be per-thread-db or shared-db";
+				return false;
+			}
+		} else if (name == "--operation") {
+			if (!OptionValue(argc, argv, &i, name, inline_value,
+					has_inline, &value, error))
+				return false;
+			value = Uppercase(value);
+			if (value == "INSERT")
+				options->operation = Operation::kInsert;
+			else if (value == "UPDATE")
+				options->operation = Operation::kUpdate;
+			else if (value == "DELETE")
+				options->operation = Operation::kDelete;
+			else {
+				*error = "--operation must be insert, update, or delete";
+				return false;
+			}
+		} else if (name == "--journal-mode") {
+			if (!OptionValue(argc, argv, &i, name, inline_value,
+					has_inline, &value, error))
+				return false;
+			value = Uppercase(value);
+			if (value == "WAL")
+				options->journal_mode = JournalMode::kWal;
+			else if (value == "DELETE")
+				options->journal_mode = JournalMode::kDelete;
+			else {
+				*error = "--journal-mode must be WAL or DELETE";
+				return false;
+			}
+		} else if (name == "--synchronous") {
+			if (!OptionValue(argc, argv, &i, name, inline_value,
+					has_inline, &value, error))
+				return false;
+			value = Uppercase(value);
+			if (value == "FULL")
+				options->synchronous = SynchronousMode::kFull;
+			else if (value == "NORMAL")
+				options->synchronous = SynchronousMode::kNormal;
+			else if (value == "EXTRA")
+				options->synchronous = SynchronousMode::kExtra;
+			else if (value == "OFF")
+				options->synchronous = SynchronousMode::kOff;
+			else {
+				*error = "--synchronous must be FULL, NORMAL, EXTRA, or OFF";
+				return false;
+			}
+		} else if (name == "--db-dir" || name == "--trace-dir" ||
+			   name == "--output-log") {
+			if (!OptionValue(argc, argv, &i, name, inline_value,
+					has_inline, &value, error))
+				return false;
+			if (value.empty()) {
+				*error = name + " must not be empty";
+				return false;
+			}
+			if (name == "--db-dir")
+				options->db_dir = value;
+			else if (name == "--trace-dir")
+				options->trace_dir = value;
+			else
+				options->output_log = value;
+		} else if (name == "--threads" || name == "--tables" ||
+			   name == "--transactions" || name == "--warmup" ||
+			   name == "--operations-per-table" ||
+			   name == "--rows-per-txn" ||
+			   name == "--payload" || name == "--working-set" ||
+			   name == "--wal-autocheckpoint" ||
+			   name == "--busy-timeout" ||
+			   name == "--trace-buffer-mb") {
+			if (!OptionValue(argc, argv, &i, name, inline_value,
+					has_inline, &value, error))
+				return false;
+			uint64_t minimum = 0;
+			uint64_t maximum = std::numeric_limits<uint32_t>::max();
+
+			if (name == "--threads") {
+				minimum = 1;
+				maximum = kMaxThreads;
+			} else if (name == "--tables") {
+				minimum = 1;
+				maximum = kMaxTables;
+			} else if (name == "--transactions" ||
+				   name == "--operations-per-table" ||
+				   name == "--rows-per-txn" ||
+				   name == "--working-set") {
+				minimum = 1;
+				maximum = static_cast<uint64_t>(
+					std::numeric_limits<int64_t>::max());
+			} else if (name == "--warmup") {
+				maximum = static_cast<uint64_t>(
+					std::numeric_limits<int64_t>::max());
+			} else if (name == "--payload") {
+				maximum = static_cast<uint64_t>(
+					std::numeric_limits<int>::max());
+			} else if (name == "--busy-timeout") {
+				maximum = static_cast<uint64_t>(
+					std::numeric_limits<int>::max());
+			} else if (name == "--trace-buffer-mb") {
+				minimum = 1;
+				maximum = 32768;
+			}
+			if (!ParseUnsigned(value, minimum, maximum, &number, error)) {
+				*error = name + ": " + *error;
+				return false;
+			}
+			if (name == "--threads")
+				options->threads = static_cast<uint32_t>(number);
+			else if (name == "--tables")
+				options->tables = static_cast<uint32_t>(number);
+			else if (name == "--transactions")
+				options->transactions = number;
+			else if (name == "--warmup")
+				options->warmup = number;
+			else if (name == "--operations-per-table" ||
+				 name == "--rows-per-txn")
+				options->operations_per_table = number;
+			else if (name == "--payload")
+				options->payload_bytes = number;
+			else if (name == "--working-set")
+				options->working_set = number;
+			else if (name == "--wal-autocheckpoint")
+				options->wal_autocheckpoint =
+					static_cast<uint32_t>(number);
+			else if (name == "--busy-timeout")
+				options->busy_timeout_ms =
+					static_cast<uint32_t>(number);
+			else
+				options->trace_buffer_mb =
+					static_cast<uint32_t>(number);
+		} else {
+			*error = "unknown option: " + argument;
+			return false;
+		}
+	}
+	return true;
+}
+
+const char *DatabaseModeName(DatabaseMode mode)
+{
+	return mode == DatabaseMode::kPerThread ? "per-thread-db" : "shared-db";
+}
+
+const char *JournalModeName(JournalMode mode)
+{
+	return mode == JournalMode::kWal ? "WAL" : "DELETE";
+}
+
+const char *OperationName(Operation operation)
+{
+	switch (operation) {
+	case Operation::kInsert:
+		return "insert";
+	case Operation::kUpdate:
+		return "update";
+	case Operation::kDelete:
+		return "delete";
+	}
+	return "unknown";
+}
+
+const char *SynchronousModeName(SynchronousMode mode)
+{
+	switch (mode) {
+	case SynchronousMode::kFull:
+		return "FULL";
+	case SynchronousMode::kNormal:
+		return "NORMAL";
+	case SynchronousMode::kExtra:
+		return "EXTRA";
+	case SynchronousMode::kOff:
+		return "OFF";
+	}
+	return "UNKNOWN";
+}
+
+std::string JoinPath(const std::string &directory, const std::string &name)
+{
+	if (!directory.empty() && directory.back() == '/')
+		return directory + name;
+	return directory + "/" + name;
+}
+
+std::string ParentDirectory(const std::string &path)
+{
+	size_t slash = path.find_last_of('/');
+
+	if (slash == std::string::npos)
+		return ".";
+	if (slash == 0)
+		return "/";
+	return path.substr(0, slash);
+}
+
+std::string TableName(uint32_t table)
+{
+	return "bench_" + std::to_string(table);
+}
+
+uint64_t MeasuredTransactionsForWorker(const Options &options,
+		uint32_t worker)
+{
+	uint64_t quotient = options.transactions / options.threads;
+	uint64_t remainder = options.transactions % options.threads;
+
+	return quotient + (worker < remainder ? 1 : 0);
+}
+
+uint64_t MeasuredTransactionsBeforeWorker(const Options &options,
+		uint32_t worker)
+{
+	uint64_t quotient = options.transactions / options.threads;
+	uint64_t remainder = options.transactions % options.threads;
+
+	return quotient * worker + std::min<uint64_t>(worker, remainder);
+}
+
+uint64_t WorkerMutationRounds(const Options &options, uint32_t worker)
+{
+	return (options.warmup + MeasuredTransactionsForWorker(options, worker)) *
+		options.operations_per_table;
+}
+
+uint64_t TotalMutationRounds(const Options &options)
+{
+	return (options.transactions + options.warmup * options.threads) *
+		options.operations_per_table;
+}
+
+uint64_t DatabaseSeedRows(const Options &options, uint32_t database_index)
+{
+	if (options.operation == Operation::kInsert)
+		return 0;
+	if (options.operation == Operation::kUpdate)
+		return options.working_set;
+	if (options.database_mode == DatabaseMode::kShared)
+		return std::max(options.working_set, TotalMutationRounds(options));
+	return std::max(options.working_set,
+		WorkerMutationRounds(options, database_index));
+}
+
+bool MakeDirectory(const std::string &path, std::string *error)
+{
+	struct stat status;
+
+	if (path.empty()) {
+		*error = "empty directory path";
+		return false;
+	}
+	for (size_t end = 1; end <= path.size(); ++end) {
+		if (end != path.size() && path[end] != '/')
+			continue;
+		std::string component = path.substr(0, end);
+
+		if (component.empty() || component == ".")
+			continue;
+		if (mkdir(component.c_str(), 0755) == 0 || errno == EEXIST)
+			continue;
+		*error = "mkdir(" + component + "): " + std::strerror(errno);
+		return false;
+	}
+	if (stat(path.c_str(), &status) != 0) {
+		*error = "stat(" + path + "): " + std::strerror(errno);
+		return false;
+	}
+	if (!S_ISDIR(status.st_mode)) {
+		*error = path + " is not a directory";
+		return false;
+	}
+	return true;
+}
+
+bool RemoveIfPresent(const std::string &path, std::string *error)
+{
+	if (unlink(path.c_str()) == 0 || errno == ENOENT)
+		return true;
+	*error = "unlink(" + path + "): " + std::strerror(errno);
+	return false;
+}
+
+bool RemoveDatabaseFiles(const std::string &path, std::string *error)
+{
+	return RemoveIfPresent(path, error) &&
+		RemoveIfPresent(path + "-wal", error) &&
+		RemoveIfPresent(path + "-shm", error) &&
+		RemoveIfPresent(path + "-journal", error);
+}
+
+std::vector<std::string> BuildDatabasePaths(const Options &options)
+{
+	std::vector<std::string> paths;
+
+	if (options.database_mode == DatabaseMode::kShared) {
+		paths.push_back(JoinPath(options.db_dir, "sqlite_fsync_shared.db"));
+		return paths;
+	}
+	paths.reserve(options.threads);
+	for (uint32_t i = 0; i < options.threads; ++i) {
+		paths.push_back(JoinPath(options.db_dir,
+			"sqlite_fsync_thread_" + std::to_string(i) + ".db"));
+	}
+	return paths;
+}
+
+bool ExecSql(sqlite3 *database, const std::string &sql, std::string *error)
+{
+	char *message = nullptr;
+	int rc = sqlite3_exec(database, sql.c_str(), nullptr, nullptr, &message);
+
+	if (rc == SQLITE_OK)
+		return true;
+	*error = "SQLite error running [" + sql + "]: " +
+		(message != nullptr ? message : sqlite3_errmsg(database));
+	sqlite3_free(message);
+	return false;
+}
+
+bool OpenDatabase(const std::string &path, bool create, uint32_t busy_timeout,
+		sqlite3 **database, std::string *error)
+{
+	int flags = SQLITE_OPEN_READWRITE | SQLITE_OPEN_NOMUTEX;
+	int rc;
+
+	if (create)
+		flags |= SQLITE_OPEN_CREATE;
+	*database = nullptr;
+	rc = sqlite3_open_v2(path.c_str(), database, flags, nullptr);
+	if (rc != SQLITE_OK) {
+		*error = "sqlite3_open_v2(" + path + "): " +
+			(*database != nullptr ? sqlite3_errmsg(*database) :
+			 sqlite3_errstr(rc));
+		if (*database != nullptr)
+			sqlite3_close_v2(*database);
+		*database = nullptr;
+		return false;
+	}
+	sqlite3_extended_result_codes(*database, 1);
+	rc = sqlite3_busy_timeout(*database, static_cast<int>(busy_timeout));
+	if (rc != SQLITE_OK) {
+		*error = "sqlite3_busy_timeout(" + path + "): " +
+			sqlite3_errmsg(*database);
+		sqlite3_close_v2(*database);
+		*database = nullptr;
+		return false;
+	}
+	return true;
+}
+
+bool ReadSingleTextPragma(sqlite3 *database, const char *sql,
+		std::string *value, std::string *error)
+{
+	sqlite3_stmt *statement = nullptr;
+	int rc = sqlite3_prepare_v2(database, sql, -1, &statement, nullptr);
+
+	if (rc != SQLITE_OK) {
+		*error = std::string("prepare ") + sql + ": " +
+			sqlite3_errmsg(database);
+		return false;
+	}
+	rc = sqlite3_step(statement);
+	if (rc != SQLITE_ROW || sqlite3_column_type(statement, 0) != SQLITE_TEXT) {
+		*error = std::string("query ") + sql + ": " +
+			(rc == SQLITE_ROW ? "non-text result" : sqlite3_errmsg(database));
+		sqlite3_finalize(statement);
+		return false;
+	}
+	const unsigned char *text = sqlite3_column_text(statement, 0);
+	*value = text != nullptr ? reinterpret_cast<const char *>(text) : "";
+	rc = sqlite3_finalize(statement);
+	if (rc != SQLITE_OK) {
+		*error = std::string("finalize ") + sql + ": " +
+			sqlite3_errmsg(database);
+		return false;
+	}
+	return true;
+}
+
+bool ReadSingleIntegerPragma(sqlite3 *database, const char *sql,
+		sqlite3_int64 *value, std::string *error)
+{
+	sqlite3_stmt *statement = nullptr;
+	int rc = sqlite3_prepare_v2(database, sql, -1, &statement, nullptr);
+
+	if (rc != SQLITE_OK) {
+		*error = std::string("prepare ") + sql + ": " +
+			sqlite3_errmsg(database);
+		return false;
+	}
+	rc = sqlite3_step(statement);
+	if (rc != SQLITE_ROW || sqlite3_column_type(statement, 0) != SQLITE_INTEGER) {
+		*error = std::string("query ") + sql + ": " +
+			(rc == SQLITE_ROW ? "non-integer result" :
+			 sqlite3_errmsg(database));
+		sqlite3_finalize(statement);
+		return false;
+	}
+	*value = sqlite3_column_int64(statement, 0);
+	rc = sqlite3_finalize(statement);
+	if (rc != SQLITE_OK) {
+		*error = std::string("finalize ") + sql + ": " +
+			sqlite3_errmsg(database);
+		return false;
+	}
+	return true;
+}
+
+bool ConfigureConnection(sqlite3 *database, const Options &options,
+		bool set_journal_mode, std::string *error)
+{
+	std::string actual_mode;
+	std::string requested_mode = JournalModeName(options.journal_mode);
+
+	if (set_journal_mode) {
+		/* These only take effect before the first schema object is created. */
+		if (!ExecSql(database, "PRAGMA page_size=4096", error) ||
+			!ExecSql(database, "PRAGMA auto_vacuum=FULL", error))
+			return false;
+		if (!ReadSingleTextPragma(database,
+				("PRAGMA journal_mode=" + requested_mode).c_str(),
+				&actual_mode, error))
+			return false;
+	} else if (!ReadSingleTextPragma(database, "PRAGMA journal_mode",
+				&actual_mode, error)) {
+		return false;
+	}
+	if (Uppercase(actual_mode) != requested_mode) {
+		*error = "SQLite journal_mode is " + actual_mode +
+			", requested " + requested_mode;
+		return false;
+	}
+	if (!ExecSql(database,
+			"PRAGMA synchronous=" +
+			std::string(SynchronousModeName(options.synchronous)), error))
+		return false;
+	if (options.journal_mode == JournalMode::kWal &&
+		!ExecSql(database,
+			"PRAGMA wal_autocheckpoint=" +
+			std::to_string(options.wal_autocheckpoint), error))
+		return false;
+	return true;
+}
+
+bool PrintDatabaseConfiguration(const std::string &path,
+		const Options &options, std::string *error)
+{
+	sqlite3 *database = nullptr;
+	std::string journal_mode;
+	sqlite3_int64 synchronous;
+	sqlite3_int64 page_size;
+	sqlite3_int64 wal_autocheckpoint;
+	sqlite3_int64 auto_vacuum;
+	bool ok = false;
+
+	if (!OpenDatabase(path, false, options.busy_timeout_ms, &database, error))
+		return false;
+	if (!ConfigureConnection(database, options, false, error) ||
+		!ReadSingleTextPragma(database, "PRAGMA journal_mode", &journal_mode,
+			error) ||
+		!ReadSingleIntegerPragma(database, "PRAGMA synchronous", &synchronous,
+			error) ||
+		!ReadSingleIntegerPragma(database, "PRAGMA page_size", &page_size,
+			error) ||
+		!ReadSingleIntegerPragma(database, "PRAGMA wal_autocheckpoint",
+			&wal_autocheckpoint, error) ||
+		!ReadSingleIntegerPragma(database, "PRAGMA auto_vacuum", &auto_vacuum,
+			error))
+		goto out;
+	std::printf(
+		"sqlite_effective path=%s journal_mode=%s synchronous=%" PRId64
+		" page_size=%" PRId64 " wal_autocheckpoint=%" PRId64
+		" auto_vacuum=%" PRId64 "\n",
+		path.c_str(), journal_mode.c_str(),
+		static_cast<int64_t>(synchronous), static_cast<int64_t>(page_size),
+		static_cast<int64_t>(wal_autocheckpoint),
+		static_cast<int64_t>(auto_vacuum));
+	ok = true;
+
+out:
+	if (database != nullptr) {
+		int rc = sqlite3_close_v2(database);
+
+		if (ok && rc != SQLITE_OK) {
+			*error = "close SQLite configuration connection for " + path +
+				": " + sqlite3_errstr(rc);
+			ok = false;
+		}
+	}
+	return ok;
+}
+
+bool Rollback(sqlite3 *database)
+{
+	return sqlite3_exec(database, "ROLLBACK", nullptr, nullptr, nullptr) ==
+		SQLITE_OK;
+}
+
+bool PrepareDatabase(const std::string &path, const Options &options,
+		uint64_t seed_rows, std::string *error)
+{
+	sqlite3 *database = nullptr;
+	std::vector<sqlite3_stmt *> inserts;
+	bool transaction_open = false;
+	bool ok = false;
+
+	if (!RemoveDatabaseFiles(path, error))
+		return false;
+	if (!OpenDatabase(path, true, options.busy_timeout_ms, &database, error))
+		return false;
+	if (!ConfigureConnection(database, options, true, error))
+		goto out;
+	for (uint32_t table = 0; table < options.tables; ++table) {
+		std::string sql = "CREATE TABLE " + TableName(table) + " ("
+			"id INTEGER PRIMARY KEY, "
+			"payload BLOB NOT NULL, "
+			"generation INTEGER NOT NULL)";
+
+		if (!ExecSql(database, sql, error))
+			goto out;
+	}
+	if (seed_rows == 0) {
+		ok = true;
+		goto out;
+	}
+	if (!ExecSql(database, "BEGIN IMMEDIATE", error))
+		goto out;
+	transaction_open = true;
+	inserts.resize(options.tables, nullptr);
+	for (uint32_t table = 0; table < options.tables; ++table) {
+		std::string sql = "INSERT INTO " + TableName(table) +
+			"(id, payload, generation) VALUES(?1, zeroblob(?2), 0)";
+
+		if (sqlite3_prepare_v2(database, sql.c_str(), -1, &inserts[table],
+				nullptr) != SQLITE_OK) {
+			*error = "prepare seed INSERT for " + TableName(table) + ": " +
+				sqlite3_errmsg(database);
+			goto out;
+		}
+	}
+	for (uint64_t id = 1; id <= seed_rows; ++id) {
+		for (uint32_t table = 0; table < options.tables; ++table) {
+			sqlite3_stmt *insert = inserts[table];
+			int rc = sqlite3_bind_int64(insert, 1,
+				static_cast<sqlite3_int64>(id));
+
+			if (rc == SQLITE_OK)
+				rc = sqlite3_bind_int(insert, 2,
+					static_cast<int>(options.payload_bytes));
+			if (rc == SQLITE_OK)
+				rc = sqlite3_step(insert);
+			if (rc != SQLITE_DONE) {
+				*error = "seed INSERT into " + TableName(table) + ": " +
+					sqlite3_errmsg(database);
+				goto out;
+			}
+			rc = sqlite3_reset(insert);
+			if (rc != SQLITE_OK) {
+				*error = "reset seed INSERT for " + TableName(table) +
+					": " + sqlite3_errmsg(database);
+				goto out;
+			}
+		}
+	}
+	if (!ExecSql(database, "COMMIT", error))
+		goto out;
+	transaction_open = false;
+	ok = true;
+
+out:
+	for (sqlite3_stmt *insert : inserts) {
+		if (insert != nullptr)
+			sqlite3_finalize(insert);
+	}
+	if (transaction_open)
+		Rollback(database);
+	if (database != nullptr) {
+		int rc = sqlite3_close_v2(database);
+
+		if (ok && rc != SQLITE_OK) {
+			*error = "sqlite3_close_v2(" + path + "): " +
+				sqlite3_errstr(rc);
+			ok = false;
+		}
+	}
+	return ok;
+}
+
+struct CheckpointStats {
+	uint64_t log_frames = 0;
+	uint64_t checkpointed_frames = 0;
+};
+
+bool CheckpointDatabase(const std::string &path, const Options &options,
+		const char *mode, CheckpointStats *stats, std::string *error)
+{
+	sqlite3 *database = nullptr;
+	sqlite3_stmt *statement = nullptr;
+	std::string sql;
+	bool ok = false;
+	int rc;
+
+	stats->log_frames = 0;
+	stats->checkpointed_frames = 0;
+	if (options.journal_mode != JournalMode::kWal)
+		return true;
+	if (!OpenDatabase(path, false, options.busy_timeout_ms, &database, error))
+		return false;
+	if (!ConfigureConnection(database, options, false, error))
+		goto out;
+	sql = std::string("PRAGMA wal_checkpoint(") + mode + ")";
+	rc = sqlite3_prepare_v2(database, sql.c_str(), -1, &statement, nullptr);
+	if (rc != SQLITE_OK) {
+		*error = "prepare WAL checkpoint for " + path + ": " +
+			sqlite3_errmsg(database);
+		goto out;
+	}
+	rc = sqlite3_step(statement);
+	if (rc != SQLITE_ROW) {
+		*error = "WAL checkpoint for " + path + ": " +
+			sqlite3_errmsg(database);
+		goto out;
+	}
+	if (sqlite3_column_int(statement, 0) != 0) {
+		*error = "WAL checkpoint remained busy for " + path;
+		goto out;
+	}
+	if (sqlite3_column_int64(statement, 1) < 0 ||
+			sqlite3_column_int64(statement, 2) < 0) {
+		*error = "WAL checkpoint returned negative frame counts for " + path;
+		goto out;
+	}
+	stats->log_frames = static_cast<uint64_t>(
+		sqlite3_column_int64(statement, 1));
+	stats->checkpointed_frames = static_cast<uint64_t>(
+		sqlite3_column_int64(statement, 2));
+	ok = true;
+
+out:
+	if (statement != nullptr) {
+		rc = sqlite3_finalize(statement);
+		if (ok && rc != SQLITE_OK) {
+			*error = "finalize WAL checkpoint for " + path + ": " +
+				sqlite3_errmsg(database);
+			ok = false;
+		}
+	}
+	if (database != nullptr) {
+		rc = sqlite3_close_v2(database);
+		if (ok && rc != SQLITE_OK) {
+			*error = "close WAL checkpoint connection for " + path +
+				": " + sqlite3_errstr(rc);
+			ok = false;
+		}
+	}
+	return ok;
+}
+
+class StartBarrier {
+public:
+	explicit StartBarrier(size_t workers) : workers_(workers) {}
+
+	bool WorkerArriveAndWait()
+	{
+		std::unique_lock<std::mutex> lock(mutex_);
+
+		if (cancelled_)
+			return false;
+		++arrived_;
+		condition_.notify_all();
+		condition_.wait(lock, [this]() { return released_ || cancelled_; });
+		return !cancelled_;
+	}
+
+	bool WaitForWorkers()
+	{
+		std::unique_lock<std::mutex> lock(mutex_);
+
+		condition_.wait(lock, [this]() {
+			return arrived_ == workers_ || cancelled_;
+		});
+		return !cancelled_;
+	}
+
+	void ReleaseWorkers()
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+
+		released_ = true;
+		condition_.notify_all();
+	}
+
+	void Cancel()
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+
+		cancelled_ = true;
+		condition_.notify_all();
+	}
+
+private:
+	const size_t workers_;
+	std::mutex mutex_;
+	std::condition_variable condition_;
+	size_t arrived_ = 0;
+	bool released_ = false;
+	bool cancelled_ = false;
+};
+
+class OneShotBarrier {
+public:
+	explicit OneShotBarrier(size_t participants) : participants_(participants) {}
+
+	bool ArriveAndWait()
+	{
+		std::unique_lock<std::mutex> lock(mutex_);
+
+		if (cancelled_)
+			return false;
+		++arrived_;
+		if (arrived_ == participants_) {
+			released_ = true;
+			condition_.notify_all();
+		} else {
+			condition_.wait(lock, [this]() {
+				return released_ || cancelled_;
+			});
+		}
+		return !cancelled_;
+	}
+
+	void Cancel()
+	{
+		std::lock_guard<std::mutex> lock(mutex_);
+
+		cancelled_ = true;
+		condition_.notify_all();
+	}
+
+private:
+	const size_t participants_;
+	std::mutex mutex_;
+	std::condition_variable condition_;
+	size_t arrived_ = 0;
+	bool released_ = false;
+	bool cancelled_ = false;
+};
+
+struct WorkloadPhases {
+	explicit WorkloadPhases(size_t workers)
+		: start_barrier(workers), transactions_done_barrier(workers + 1),
+		  checkpoint_start_barrier(workers + 1),
+		  checkpoint_done_barrier(workers + 1),
+		  release_barrier(workers + 1) {}
+
+	void CancelAll()
+	{
+		start_barrier.Cancel();
+		transactions_done_barrier.Cancel();
+		checkpoint_start_barrier.Cancel();
+		checkpoint_done_barrier.Cancel();
+		release_barrier.Cancel();
+	}
+
+	StartBarrier start_barrier;
+	OneShotBarrier transactions_done_barrier;
+	OneShotBarrier checkpoint_start_barrier;
+	OneShotBarrier checkpoint_done_barrier;
+	OneShotBarrier release_barrier;
+};
+
+struct WorkerDatabase {
+	sqlite3 *database = nullptr;
+	sqlite3_stmt *begin = nullptr;
+	std::vector<sqlite3_stmt *> mutations;
+	sqlite3_stmt *commit = nullptr;
+	sqlite3_stmt *rollback = nullptr;
+
+	~WorkerDatabase()
+	{
+		Close();
+	}
+
+	WorkerDatabase(const WorkerDatabase &) = delete;
+	WorkerDatabase &operator=(const WorkerDatabase &) = delete;
+	WorkerDatabase() = default;
+
+	void Close()
+	{
+		if (begin != nullptr)
+			sqlite3_finalize(begin);
+		for (sqlite3_stmt *mutation : mutations) {
+			if (mutation != nullptr)
+				sqlite3_finalize(mutation);
+		}
+		if (commit != nullptr)
+			sqlite3_finalize(commit);
+		if (rollback != nullptr)
+			sqlite3_finalize(rollback);
+		begin = nullptr;
+		mutations.clear();
+		commit = nullptr;
+		rollback = nullptr;
+		if (database != nullptr)
+			sqlite3_close_v2(database);
+		database = nullptr;
+	}
+};
+
+uint64_t GreatestCommonDivisor(uint64_t left, uint64_t right)
+{
+	while (right != 0) {
+		uint64_t remainder = left % right;
+
+		left = right;
+		right = remainder;
+	}
+	return left;
+}
+
+uint64_t Mix64(uint64_t value)
+{
+	value += 0x9e3779b97f4a7c15ULL;
+	value = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9ULL;
+	value = (value ^ (value >> 27)) * 0x94d049bb133111ebULL;
+	return value ^ (value >> 31);
+}
+
+class KeySequence {
+public:
+	KeySequence(uint64_t span, uint64_t first_ordinal, bool random,
+			uint64_t seed)
+		: span_(span), ordinal_(first_ordinal), random_(random)
+	{
+		if (!random_ || span_ <= 1)
+			return;
+		multiplier_ = Mix64(seed) % span_;
+		while (multiplier_ == 0 ||
+				GreatestCommonDivisor(multiplier_, span_) != 1) {
+			++multiplier_;
+			if (multiplier_ == span_)
+				multiplier_ = 1;
+		}
+		offset_ = Mix64(seed ^ 0xd1b54a32d192ed03ULL) % span_;
+	}
+
+	uint64_t Next()
+	{
+		uint64_t position = ordinal_++ % span_;
+
+		if (random_ && span_ > 1) {
+			__uint128_t product = static_cast<__uint128_t>(multiplier_) *
+				position;
+
+			position = static_cast<uint64_t>((product + offset_) % span_);
+		}
+		return position + 1;
+	}
+
+private:
+	uint64_t span_;
+	uint64_t ordinal_;
+	bool random_;
+	uint64_t multiplier_ = 1;
+	uint64_t offset_ = 0;
+};
+
+bool PrepareStatement(sqlite3 *database, const char *sql,
+		sqlite3_stmt **statement, std::string *error)
+{
+	int rc = sqlite3_prepare_v2(database, sql, -1, statement, nullptr);
+
+	if (rc == SQLITE_OK)
+		return true;
+	*error = std::string("prepare [") + sql + "]: " +
+		sqlite3_errmsg(database);
+	return false;
+}
+
+bool OpenWorkerDatabase(const std::string &path, const Options &options,
+		const std::string &payload, WorkerDatabase *worker,
+		std::string *error)
+{
+	const void *payload_data = payload.empty() ?
+		static_cast<const void *>("") : payload.data();
+	int rc;
+
+	if (!OpenDatabase(path, false, options.busy_timeout_ms,
+			&worker->database, error))
+		return false;
+	if (!ConfigureConnection(worker->database, options, false, error))
+		return false;
+	if (!PrepareStatement(worker->database, "BEGIN IMMEDIATE",
+			&worker->begin, error) ||
+		!PrepareStatement(worker->database, "COMMIT", &worker->commit,
+			error) ||
+		!PrepareStatement(worker->database, "ROLLBACK", &worker->rollback,
+			error))
+		return false;
+	worker->mutations.resize(options.tables, nullptr);
+	for (uint32_t table = 0; table < options.tables; ++table) {
+		std::string sql;
+
+		switch (options.operation) {
+		case Operation::kInsert:
+			sql = "INSERT INTO " + TableName(table) +
+				"(id, payload, generation) VALUES(?1, ?2, 0)";
+			break;
+		case Operation::kUpdate:
+			sql = "UPDATE " + TableName(table) +
+				" SET payload=?2, generation=generation+1 WHERE id=?1";
+			break;
+		case Operation::kDelete:
+			sql = "DELETE FROM " + TableName(table) + " WHERE id=?1";
+			break;
+		}
+		if (!PrepareStatement(worker->database, sql.c_str(),
+				&worker->mutations[table], error))
+			return false;
+		if (options.operation == Operation::kDelete)
+			continue;
+		rc = sqlite3_bind_blob(worker->mutations[table], 2, payload_data,
+			static_cast<int>(payload.size()), SQLITE_STATIC);
+		if (rc != SQLITE_OK) {
+			*error = "bind payload for " + TableName(table) + ": " +
+				sqlite3_errmsg(worker->database);
+			return false;
+		}
+	}
+	return true;
+}
+
+uint64_t MonotonicNowNs()
+{
+	struct timespec timestamp;
+
+	clock_gettime(CLOCK_MONOTONIC, &timestamp);
+	return static_cast<uint64_t>(timestamp.tv_sec) * 1000000000ULL +
+		static_cast<uint64_t>(timestamp.tv_nsec);
+}
+
+bool PassiveCheckpoint(WorkerDatabase *worker, CheckpointStats *stats,
+		std::string *error)
+{
+	int log_frames = 0;
+	int checkpointed_frames = 0;
+	int rc = sqlite3_wal_checkpoint_v2(worker->database, nullptr,
+		SQLITE_CHECKPOINT_PASSIVE, &log_frames, &checkpointed_frames);
+
+	stats->log_frames = 0;
+	stats->checkpointed_frames = 0;
+	if (rc != SQLITE_OK) {
+		*error = "sqlite3_wal_checkpoint_v2(PASSIVE): " +
+			std::string(sqlite3_errmsg(worker->database));
+		return false;
+	}
+	if (log_frames < 0 || checkpointed_frames < 0) {
+		*error = "sqlite3_wal_checkpoint_v2(PASSIVE) returned negative "
+			"frame counts";
+		return false;
+	}
+	stats->log_frames = static_cast<uint64_t>(log_frames);
+	stats->checkpointed_frames = static_cast<uint64_t>(checkpointed_frames);
+	return true;
+}
+
+void ResetAfterStep(sqlite3_stmt *statement)
+{
+	(void)sqlite3_reset(statement);
+}
+
+void RollbackWorker(WorkerDatabase *worker)
+{
+	int rc = sqlite3_step(worker->rollback);
+
+	(void)rc;
+	ResetAfterStep(worker->rollback);
+}
+
+bool StepDone(WorkerDatabase *worker, sqlite3_stmt *statement,
+		const char *operation, std::string *error)
+{
+	int rc = sqlite3_step(statement);
+
+	if (rc == SQLITE_DONE) {
+		ResetAfterStep(statement);
+		return true;
+	}
+	*error = std::string(operation) + ": " +
+		sqlite3_errmsg(worker->database);
+	ResetAfterStep(statement);
+	return false;
+}
+
+bool ExecuteTransaction(WorkerDatabase *worker, const Options &options,
+		KeySequence *keys, bool measure, uint64_t *transaction_ns,
+		uint64_t *commit_ns, std::string *error)
+{
+	uint64_t transaction_begin_ns = 0;
+	uint64_t commit_begin_ns = 0;
+	uint64_t commit_end_ns = 0;
+
+	if (measure)
+		transaction_begin_ns = MonotonicNowNs();
+	if (!StepDone(worker, worker->begin, "BEGIN IMMEDIATE", error))
+		return false;
+	for (uint64_t round = 0; round < options.operations_per_table; ++round) {
+		uint64_t key = keys->Next();
+
+		for (uint32_t table = 0; table < options.tables; ++table) {
+			sqlite3_stmt *mutation = worker->mutations[table];
+			int rc = sqlite3_bind_int64(mutation, 1,
+				static_cast<sqlite3_int64>(key));
+
+			if (rc == SQLITE_OK)
+				rc = sqlite3_step(mutation);
+			if (rc != SQLITE_DONE) {
+				*error = std::string(OperationName(options.operation)) +
+					" " + TableName(table) + ": " +
+					sqlite3_errmsg(worker->database);
+				ResetAfterStep(mutation);
+				RollbackWorker(worker);
+				return false;
+			}
+			if (sqlite3_changes(worker->database) != 1) {
+				*error = std::string(OperationName(options.operation)) +
+					" " + TableName(table) +
+					" changed a row count other than one";
+				ResetAfterStep(mutation);
+				RollbackWorker(worker);
+				return false;
+			}
+			ResetAfterStep(mutation);
+		}
+	}
+	if (measure)
+		commit_begin_ns = MonotonicNowNs();
+	int rc = sqlite3_step(worker->commit);
+	if (measure)
+		commit_end_ns = MonotonicNowNs();
+	if (rc != SQLITE_DONE) {
+		*error = "COMMIT: " + std::string(sqlite3_errmsg(worker->database));
+		ResetAfterStep(worker->commit);
+		RollbackWorker(worker);
+		return false;
+	}
+	ResetAfterStep(worker->commit);
+	if (measure) {
+		*transaction_ns = commit_end_ns - transaction_begin_ns;
+		*commit_ns = commit_end_ns - commit_begin_ns;
+	}
+	return true;
+}
+
+struct WorkerResult {
+	std::vector<uint64_t> transaction_samples;
+	std::vector<uint64_t> commit_samples;
+	CheckpointStats checkpoint_stats;
+	uint64_t completed = 0;
+	bool checkpoint_ok = true;
+	std::string error;
+	std::string checkpoint_error;
+};
+
+void SetWorkerError(WorkerResult *result, const std::string &message)
+{
+	if (result->error.empty())
+		result->error = message;
+}
+
+void WorkerMain(uint32_t worker_index, const std::string &database_path,
+		const Options &options, WorkloadPhases *phases, WorkerResult *result)
+{
+	bool measured_phase = false;
+	std::string payload;
+	WorkerDatabase database;
+	uint64_t measured_transactions =
+		MeasuredTransactionsForWorker(options, worker_index);
+	uint64_t key_span;
+	uint64_t first_ordinal;
+	uint64_t key_seed;
+
+	if (options.operation == Operation::kUpdate) {
+		key_span = options.working_set;
+		first_ordinal = options.random_key ? 0 :
+			(static_cast<uint64_t>(worker_index) * 104729ULL) % key_span;
+		key_seed = 0x243f6a8885a308d3ULL + worker_index;
+	} else if (options.database_mode == DatabaseMode::kShared) {
+		key_span = options.operation == Operation::kInsert ?
+			TotalMutationRounds(options) : DatabaseSeedRows(options, 0);
+		first_ordinal = (options.warmup * worker_index +
+			MeasuredTransactionsBeforeWorker(options, worker_index)) *
+			options.operations_per_table;
+		/* All workers must use the same permutation of the shared keyspace. */
+		key_seed = 0x13198a2e03707344ULL;
+	} else {
+		key_span = options.operation == Operation::kInsert ?
+			WorkerMutationRounds(options, worker_index) :
+			DatabaseSeedRows(options, worker_index);
+		first_ordinal = 0;
+		key_seed = 0xa4093822299f31d0ULL + worker_index;
+	}
+	KeySequence keys(key_span, first_ordinal, options.random_key, key_seed);
+
+	try {
+		result->transaction_samples.resize(
+			static_cast<size_t>(measured_transactions));
+		result->commit_samples.resize(
+			static_cast<size_t>(measured_transactions));
+		payload.assign(static_cast<size_t>(options.payload_bytes),
+			static_cast<char>('A' + worker_index % 26));
+		if (!OpenWorkerDatabase(database_path, options, payload, &database,
+				&result->error)) {
+			phases->CancelAll();
+			return;
+		}
+		for (uint64_t transaction = 0; transaction < options.warmup;
+				++transaction) {
+			uint64_t unused_transaction_ns = 0;
+			uint64_t unused_commit_ns = 0;
+
+			if (!ExecuteTransaction(&database, options, &keys, false,
+					&unused_transaction_ns, &unused_commit_ns,
+					&result->error)) {
+				result->error = "warmup transaction " +
+					std::to_string(transaction) + ": " + result->error;
+				phases->CancelAll();
+				return;
+			}
+		}
+		if (!phases->start_barrier.WorkerArriveAndWait())
+			return;
+		measured_phase = true;
+		for (uint64_t transaction = 0;
+				transaction < measured_transactions; ++transaction) {
+			uint64_t transaction_ns;
+			uint64_t commit_ns;
+			std::string sql_error;
+
+			if (!ExecuteTransaction(&database, options, &keys, true,
+					&transaction_ns, &commit_ns, &sql_error)) {
+				SetWorkerError(result, "measured transaction " +
+					std::to_string(transaction) + ": " + sql_error);
+				break;
+			}
+			result->transaction_samples[static_cast<size_t>(
+				result->completed)] = transaction_ns;
+			result->commit_samples[static_cast<size_t>(result->completed)] =
+				commit_ns;
+			++result->completed;
+		}
+	} catch (const std::exception &exception) {
+		SetWorkerError(result, std::string("worker exception: ") +
+			exception.what());
+		if (!measured_phase) {
+			phases->CancelAll();
+			return;
+		}
+	} catch (...) {
+		SetWorkerError(result, "worker exception: unknown exception");
+		if (!measured_phase) {
+			phases->CancelAll();
+			return;
+		}
+	}
+
+	/* Keep all connections open for the collective in-trace checkpoint. */
+	if (measured_phase) {
+		(void)phases->transactions_done_barrier.ArriveAndWait();
+		if (!phases->checkpoint_start_barrier.ArriveAndWait())
+			return;
+		if (options.journal_mode == JournalMode::kWal &&
+				(options.database_mode == DatabaseMode::kPerThread ||
+				 worker_index == 0)) {
+			result->checkpoint_ok = false;
+			try {
+				result->checkpoint_ok = PassiveCheckpoint(&database,
+					&result->checkpoint_stats,
+					&result->checkpoint_error);
+			} catch (const std::exception &exception) {
+				try {
+					result->checkpoint_error =
+						std::string("checkpoint exception: ") +
+						exception.what();
+				} catch (...) {
+				}
+			} catch (...) {
+				try {
+					result->checkpoint_error =
+						"checkpoint exception: unknown";
+				} catch (...) {
+				}
+			}
+		}
+		if (!phases->checkpoint_done_barrier.ArriveAndWait())
+			return;
+		(void)phases->release_barrier.ArriveAndWait();
+	}
+}
+
+bool WriteAll(int fd, const void *data, size_t length, std::string *error)
+{
+	const char *position = static_cast<const char *>(data);
+
+	while (length != 0) {
+		ssize_t written = write(fd, position, length);
+
+		if (written < 0 && errno == EINTR)
+			continue;
+		if (written <= 0) {
+			*error = std::string("write: ") + std::strerror(errno);
+			return false;
+		}
+		position += written;
+		length -= static_cast<size_t>(written);
+	}
+	return true;
+}
+
+bool WriteControl(const std::string &path, const std::string &value,
+		std::string *error)
+{
+	int fd = open(path.c_str(), O_WRONLY | O_CLOEXEC);
+	bool ok;
+
+	if (fd < 0) {
+		*error = "open(" + path + "): " + std::strerror(errno);
+		return false;
+	}
+	ok = WriteAll(fd, value.data(), value.size(), error);
+	if (close(fd) != 0 && ok) {
+		*error = "close(" + path + "): " + std::strerror(errno);
+		ok = false;
+	}
+	if (!ok)
+		*error = path + ": " + *error;
+	return ok;
+}
+
+bool ReadTextFile(const std::string &path, std::string *contents,
+		std::string *error)
+{
+	char buffer[16384];
+	int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+
+	if (fd < 0) {
+		*error = "open(" + path + "): " + std::strerror(errno);
+		return false;
+	}
+	contents->clear();
+	for (;;) {
+		ssize_t count = read(fd, buffer, sizeof(buffer));
+
+		if (count < 0 && errno == EINTR)
+			continue;
+		if (count < 0) {
+			*error = "read(" + path + "): " + std::strerror(errno);
+			close(fd);
+			return false;
+		}
+		if (count == 0)
+			break;
+		contents->append(buffer, static_cast<size_t>(count));
+	}
+	if (close(fd) != 0) {
+		*error = "close(" + path + "): " + std::strerror(errno);
+		return false;
+	}
+	return true;
+}
+
+bool WriteRegularFile(const std::string &path, const void *data, size_t length,
+		std::string *error)
+{
+	int fd = open(path.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC,
+		0644);
+	bool ok;
+
+	if (fd < 0) {
+		*error = "open(" + path + "): " + std::strerror(errno);
+		return false;
+	}
+	ok = WriteAll(fd, data, length, error);
+	if (close(fd) != 0 && ok) {
+		*error = "close(" + path + "): " + std::strerror(errno);
+		ok = false;
+	}
+	if (!ok)
+		*error = path + ": " + *error;
+	return ok;
+}
+
+bool CopyFile(const std::string &source, const std::string &destination,
+		uint64_t *bytes, std::string *error)
+{
+	constexpr size_t kCopyBufferBytes = 1024 * 1024;
+	std::vector<char> buffer(kCopyBufferBytes);
+	int input = open(source.c_str(), O_RDONLY | O_CLOEXEC);
+	int output;
+	bool ok = true;
+
+	*bytes = 0;
+	if (input < 0) {
+		*error = "open(" + source + "): " + std::strerror(errno);
+		return false;
+	}
+	output = open(destination.c_str(),
+		O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+	if (output < 0) {
+		*error = "open(" + destination + "): " + std::strerror(errno);
+		close(input);
+		return false;
+	}
+	for (;;) {
+		ssize_t count = read(input, buffer.data(), buffer.size());
+
+		if (count < 0 && errno == EINTR)
+			continue;
+		if (count < 0) {
+			*error = "read(" + source + "): " + std::strerror(errno);
+			ok = false;
+			break;
+		}
+		if (count == 0)
+			break;
+		if (!WriteAll(output, buffer.data(), static_cast<size_t>(count),
+				error)) {
+			*error = destination + ": " + *error;
+			ok = false;
+			break;
+		}
+		*bytes += static_cast<uint64_t>(count);
+	}
+	if (close(output) != 0 && ok) {
+		*error = "close(" + destination + "): " + std::strerror(errno);
+		ok = false;
+	}
+	if (close(input) != 0 && ok) {
+		*error = "close(" + source + "): " + std::strerror(errno);
+		ok = false;
+	}
+	return ok;
+}
+
+class TraceController {
+public:
+	explicit TraceController(const Options &options) : options_(options) {}
+
+	~TraceController()
+	{
+		if (active_) {
+			std::string ignored;
+
+			(void)WriteControl(JoinPath(options_.trace_dir, "enable"),
+				"0\n", &ignored);
+		}
+	}
+
+	bool Start(std::string *error)
+	{
+		uint32_t tgid = options_.trace_filter_miss ?
+			std::numeric_limits<uint32_t>::max() :
+			static_cast<uint32_t>(getpid());
+
+		if (!WriteControl(JoinPath(options_.trace_dir, "tgid_filter"),
+				std::to_string(tgid) + "\n", error) ||
+			!WriteControl(JoinPath(options_.trace_dir, "buffer_size_mb"),
+				std::to_string(options_.trace_buffer_mb) + "\n", error))
+			return false;
+		if (!WriteControl(JoinPath(options_.trace_dir, "enable"), "1\n",
+				error)) {
+			std::string ignored;
+
+			/* The enable write may have reached debugfs before a late error. */
+			(void)WriteControl(JoinPath(options_.trace_dir, "enable"),
+				"0\n", &ignored);
+			return false;
+		}
+		active_ = true;
+		return true;
+	}
+
+	bool Stop(std::string *error)
+	{
+		if (!active_)
+			return true;
+		if (!WriteControl(JoinPath(options_.trace_dir, "enable"), "0\n",
+				error))
+			return false;
+		if (!ConfirmDisabled(error))
+			return false;
+		active_ = false;
+		return true;
+	}
+
+	bool Dump(std::string *stats, uint64_t *log_bytes, std::string *error)
+	{
+		std::string stats_path = options_.output_log + ".stats";
+
+		/* Refuse a snapshot if another controller re-enabled the tracer. */
+		if (!ConfirmDisabled(error))
+			return false;
+		if (!ReadTextFile(JoinPath(options_.trace_dir, "stats"), stats,
+				error))
+			return false;
+		if (!WriteRegularFile(stats_path, stats->data(), stats->size(), error))
+			return false;
+		return CopyFile(JoinPath(options_.trace_dir, "log"),
+			options_.output_log, log_bytes, error);
+	}
+
+private:
+	bool ConfirmDisabled(std::string *error) const
+	{
+		std::string state;
+		char *end = nullptr;
+		unsigned long enabled;
+
+		if (!ReadTextFile(JoinPath(options_.trace_dir, "enable"), &state,
+				error))
+			return false;
+		errno = 0;
+		enabled = std::strtoul(state.c_str(), &end, 0);
+		while (end != nullptr && (*end == ' ' || *end == '\t' ||
+				*end == '\r' || *end == '\n'))
+			++end;
+		if (errno != 0 || end == state.c_str() || end == nullptr ||
+				*end != '\0') {
+			*error = "invalid enable state from " +
+				JoinPath(options_.trace_dir, "enable") + ": " + state;
+			return false;
+		}
+		if (enabled != 0) {
+			*error = "tracer is still enabled; refusing to read stats/log";
+			return false;
+		}
+		return true;
+	}
+
+	const Options &options_;
+	bool active_ = false;
+};
+
+struct TraceIntegrity {
+	uint64_t complete = 0;
+	uint64_t stopped_full = 0;
+	uint64_t dropped = 0;
+	uint64_t invalid_records = 0;
+};
+
+bool ReadKernelStat(const std::string &stats, const char *key,
+		uint64_t *value, std::string *error)
+{
+	std::string prefix = std::string(key) + "=";
+	size_t search = 0;
+	size_t found = std::string::npos;
+
+	for (;;) {
+		size_t position = stats.find(prefix, search);
+
+		if (position == std::string::npos)
+			break;
+		if (position == 0 || stats[position - 1] == '\n') {
+			if (found != std::string::npos) {
+				*error = "duplicate kernel stat: " + std::string(key);
+				return false;
+			}
+			found = position;
+		}
+		search = position + prefix.size();
+	}
+	if (found == std::string::npos) {
+		*error = "missing kernel stat: " + std::string(key);
+		return false;
+	}
+	size_t value_begin = found + prefix.size();
+	size_t value_end = stats.find('\n', value_begin);
+	std::string text = stats.substr(value_begin,
+		value_end == std::string::npos ? std::string::npos :
+		value_end - value_begin);
+
+	if (!ParseUnsigned(text, 0, std::numeric_limits<uint64_t>::max(),
+			value, error)) {
+		*error = "kernel stat " + std::string(key) + ": " + *error;
+		return false;
+	}
+	return true;
+}
+
+bool ValidateTraceIntegrity(const std::string &stats, TraceIntegrity *integrity,
+		std::string *error)
+{
+	if (!ReadKernelStat(stats, "complete", &integrity->complete, error) ||
+		!ReadKernelStat(stats, "stopped_full", &integrity->stopped_full,
+			error) ||
+		!ReadKernelStat(stats, "dropped", &integrity->dropped, error) ||
+		!ReadKernelStat(stats, "invalid_records",
+			&integrity->invalid_records, error))
+		return false;
+	if (integrity->complete != 1 || integrity->stopped_full != 0 ||
+			integrity->dropped != 0 || integrity->invalid_records != 0) {
+		*error = "kernel trace is incomplete or corrupt";
+		return false;
+	}
+	return true;
+}
+
+uint64_t Percentile(const std::vector<uint64_t> &sorted, long double percent)
+{
+	long double rank;
+	size_t index;
+
+	if (sorted.empty())
+		return 0;
+	rank = std::ceil(percent * static_cast<long double>(sorted.size()) /
+		100.0L);
+	index = rank <= 1.0L ? 0 : static_cast<size_t>(rank - 1.0L);
+	if (index >= sorted.size())
+		index = sorted.size() - 1;
+	return sorted[index];
+}
+
+void PrintLatencySummary(const char *name, std::vector<uint64_t> *samples)
+{
+	long double total = 0;
+
+	if (samples->empty()) {
+		std::printf("%s count=0\n", name);
+		return;
+	}
+	std::sort(samples->begin(), samples->end());
+	for (uint64_t value : *samples)
+		total += static_cast<long double>(value);
+	std::printf(
+		"%s count=%zu avg_ns=%.0Lf min_ns=%" PRIu64
+		" p50_ns=%" PRIu64 " p90_ns=%" PRIu64
+		" p95_ns=%" PRIu64 " p99_ns=%" PRIu64
+		" p99.9_ns=%" PRIu64 " max_ns=%" PRIu64 "\n",
+		name, samples->size(), total / samples->size(), samples->front(),
+		Percentile(*samples, 50.0L), Percentile(*samples, 90.0L),
+		Percentile(*samples, 95.0L), Percentile(*samples, 99.0L),
+		Percentile(*samples, 99.9L), samples->back());
+}
+
+void PrintWorkerErrors(const std::vector<WorkerResult> &results)
+{
+	for (size_t i = 0; i < results.size(); ++i) {
+		if (!results[i].error.empty())
+			std::fprintf(stderr, "worker %zu: %s\n", i,
+				results[i].error.c_str());
+		if (!results[i].checkpoint_error.empty())
+			std::fprintf(stderr, "worker %zu final checkpoint: %s\n", i,
+				results[i].checkpoint_error.c_str());
+		else if (!results[i].checkpoint_ok)
+			std::fprintf(stderr,
+				"worker %zu final checkpoint failed without details\n", i);
+	}
+}
+
+bool CheckedAdd(uint64_t left, uint64_t right, uint64_t *result)
+{
+	if (right > std::numeric_limits<uint64_t>::max() - left)
+		return false;
+	*result = left + right;
+	return true;
+}
+
+bool CheckedMultiply(uint64_t left, uint64_t right, uint64_t *result)
+{
+	if (left != 0 && right > std::numeric_limits<uint64_t>::max() / left)
+		return false;
+	*result = left * right;
+	return true;
+}
+
+bool ValidateOptions(const Options &options, std::string *error)
+{
+	uint64_t size_max = static_cast<uint64_t>(
+		std::numeric_limits<size_t>::max());
+	uint64_t total_warmup;
+	uint64_t total_transactions;
+	uint64_t total_rounds;
+	uint64_t total_sql_operations;
+	uint64_t operations_per_transaction;
+
+	if (options.transactions > size_max / sizeof(uint64_t)) {
+		*error = "--transactions is too large for aggregate sample arrays";
+		return false;
+	}
+	if (!CheckedMultiply(options.warmup, options.threads, &total_warmup) ||
+		!CheckedAdd(options.transactions, total_warmup,
+			&total_transactions) ||
+		!CheckedMultiply(total_transactions, options.operations_per_table,
+			&total_rounds)) {
+		*error = "transactions, warmup, threads, and operations-per-table overflow";
+		return false;
+	}
+	if (!CheckedMultiply(options.tables, options.operations_per_table,
+			&operations_per_transaction)) {
+		*error = "tables * operations-per-table overflows";
+		return false;
+	}
+	if (!CheckedMultiply(total_rounds, options.tables,
+			&total_sql_operations)) {
+		*error = "total SQL operation count overflows";
+		return false;
+	}
+	if (operations_per_transaction == 0) {
+		*error = "each transaction must contain at least one operation";
+		return false;
+	}
+	if (options.operation != Operation::kUpdate &&
+			total_rounds > static_cast<uint64_t>(
+				std::numeric_limits<int64_t>::max())) {
+		*error = "INSERT/DELETE key space exceeds SQLite INTEGER range";
+		return false;
+	}
+	if (options.trace && options.output_log ==
+			JoinPath(options.trace_dir, "log")) {
+		*error = "--output-log must not name the debugfs log file";
+		return false;
+	}
+	if (!options.trace && options.trace_filter_miss) {
+		*error = "--trace-filter-miss cannot be combined with --no-trace";
+		return false;
+	}
+	return true;
+}
+
+bool ValidateSeedSpace(const Options &options, const std::string &directory,
+		std::string *error)
+{
+	struct statvfs space;
+	uint64_t database_count = options.database_mode == DatabaseMode::kShared ?
+		1 : options.threads;
+	uint64_t min_seed_rows = std::numeric_limits<uint64_t>::max();
+	uint64_t max_seed_rows = 0;
+	uint64_t total_seed_rows = 0;
+	uint64_t total_seed_table_rows;
+	uint64_t minimum_payload_bytes;
+	uint64_t projected_insert_table_rows = 0;
+	uint64_t projected_insert_payload_bytes = 0;
+	uint64_t required_payload_bytes;
+	uint64_t available_bytes;
+	uint64_t fragment_size;
+
+	for (uint32_t i = 0; i < database_count; ++i) {
+		uint64_t rows = DatabaseSeedRows(options, i);
+
+		min_seed_rows = std::min(min_seed_rows, rows);
+		max_seed_rows = std::max(max_seed_rows, rows);
+		if (!CheckedAdd(total_seed_rows, rows, &total_seed_rows)) {
+			*error = "database seed row count overflows";
+			return false;
+		}
+	}
+	if (!CheckedMultiply(total_seed_rows, options.tables,
+			&total_seed_table_rows) ||
+		!CheckedMultiply(total_seed_table_rows, options.payload_bytes,
+			&minimum_payload_bytes)) {
+		*error = "database seed payload size overflows";
+		return false;
+	}
+	if (options.operation == Operation::kInsert &&
+		(!CheckedMultiply(TotalMutationRounds(options), options.tables,
+			&projected_insert_table_rows) ||
+		 !CheckedMultiply(projected_insert_table_rows,
+			options.payload_bytes, &projected_insert_payload_bytes))) {
+		*error = "projected INSERT payload size overflows";
+		return false;
+	}
+	required_payload_bytes = std::max(minimum_payload_bytes,
+		projected_insert_payload_bytes);
+	if (statvfs(directory.c_str(), &space) != 0) {
+		*error = "statvfs(" + directory + "): " + std::strerror(errno);
+		return false;
+	}
+	fragment_size = space.f_frsize != 0 ? space.f_frsize : space.f_bsize;
+	if (fragment_size == 0) {
+		*error = "statvfs(" + directory + ") returned zero block sizes";
+		return false;
+	}
+	if (space.f_bavail >
+			std::numeric_limits<uint64_t>::max() / fragment_size)
+		available_bytes = std::numeric_limits<uint64_t>::max();
+	else
+		available_bytes = static_cast<uint64_t>(space.f_bavail) *
+			fragment_size;
+	std::printf(
+		"database_seed database_files=%" PRIu64
+		" rows_per_table_min=%" PRIu64 " rows_per_table_max=%" PRIu64
+		" total_table_rows=%" PRIu64 " minimum_payload_bytes=%" PRIu64
+		" projected_insert_table_rows=%" PRIu64
+		" projected_insert_payload_bytes=%" PRIu64
+		" available_bytes=%" PRIu64 "\n",
+		database_count, min_seed_rows, max_seed_rows, total_seed_table_rows,
+		minimum_payload_bytes, projected_insert_table_rows,
+		projected_insert_payload_bytes, available_bytes);
+	if (required_payload_bytes > available_bytes) {
+		*error = "row payload alone exceeds available database filesystem space; "
+			"SQLite metadata, journals, and WAL need additional space";
+		return false;
+	}
+	return true;
+}
