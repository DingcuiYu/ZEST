+	f2fs_latency_breakdown_metric_show(m, "submit_page_write",
+		&stats->data_submit_page, stats->data_breakdown_total.total);
+	f2fs_latency_breakdown_metric_show(m, "submit_merged_write_cond",
+		&stats->data_submit_merged, stats->data_breakdown_total.total);
+	f2fs_latency_breakdown_metric_show(m, "existing_writeback_wait",
+		&stats->data_existing_wb_wait, stats->data_breakdown_total.total);
+	f2fs_latency_breakdown_metric_show(m, "writepages_mutex_wait",
+		&stats->data_writepages_mutex_wait,
+		stats->data_breakdown_total.total);
+	f2fs_latency_breakdown_metric_show(m, "folio_tag_scan",
+		&stats->data_folio_tag_scan, stats->data_breakdown_total.total);
+	f2fs_latency_breakdown_metric_show(m, "folio_lock_contended_wait",
+		&stats->data_folio_lock_contended,
+		stats->data_breakdown_total.total);
+	f2fs_latency_breakdown_metric_show(m, "write_single_other",
+		&stats->data_write_single_other, stats->data_breakdown_total.total);
+	f2fs_latency_breakdown_metric_show(m, "compressed_write_other",
+		&stats->data_compressed_write_other,
+		stats->data_breakdown_total.total);
+	f2fs_latency_breakdown_metric_show(m, "io_order_lock_wait",
+		&stats->data_io_order_lock_wait,
+		stats->data_breakdown_total.total);
+	f2fs_latency_breakdown_metric_show(m, "balance_gc",
+		&stats->data_balance_gc, stats->data_breakdown_total.total);
+	f2fs_latency_breakdown_metric_show(m, "blk_finish_plug",
+		&stats->data_blk_finish_plug, stats->data_breakdown_total.total);
+	f2fs_latency_breakdown_metric_show(m, "do_write_data_page_other",
+		&stats->data_do_write_other, stats->data_breakdown_total.total);
+	f2fs_latency_breakdown_metric_show(m, "writeback_retry_wait",
+		&stats->data_writeback_retry_wait,
+		stats->data_breakdown_total.total);
+	f2fs_latency_breakdown_metric_show(m, "cached_ipu_submit",
+		&stats->data_cached_ipu_submit,
+		stats->data_breakdown_total.total);
