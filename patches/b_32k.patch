+def _print_sched_phase_summary(
+    direction: str,
+    phase_name: str,
+    phase: dict,
+) -> None:
+    valid = phase["sched_valid"]
+    run_delay = phase["run_delay_valid"]
+    print(
+        f"    [{direction}/{phase_name}] "
+        f"candidates={phase['candidate_records']:,}, "
+        f"sched_valid={valid['count']:,} "
+        f"({valid['percent_of_candidates']:.6f}%), "
+        f"run_delay_valid={run_delay['count']:,} "
+        f"({run_delay['percent_of_sched_valid']:.6f}% of sched-valid)"
+    )
+
+    for component in _SCHED_COMPONENTS:
+        metric = phase["latency"][component]
+        percentiles = metric["percentiles_ms"]
+        print(
+            f"      {component:<24} samples={metric['count']:,} "
+            f"avg={metric['average_ms']:.6f}ms "
+            f"p50={percentiles['p50']:.6f}ms "
+            f"p99={percentiles['p99']:.6f}ms "
+            f"p99.99={percentiles['p99_99']:.6f}ms "
+            f"max={metric['max_ms']:.6f}ms"
+        )
+
+    for component in _SCHED_RATIO_COMPONENTS:
+        ratio = phase["ratio_of_wall"][component]
+        percentiles = ratio["percentiles_percent"]
+        print(
+            f"      {component + '/wall':<24} "
+            f"samples={ratio['count']:,} "
+            f"mean-record={ratio['mean_of_record_ratios_percent']:.6f}% "
+            f"aggregate={ratio['aggregate_time_share_percent']:.6f}% "
+            f"p50={percentiles['p50']:.6f}% "
+            f"p99={percentiles['p99']:.6f}%"
+        )
+
+    switches = phase["context_switches"]
+    voluntary_hist = switches["voluntary_histogram"]
+    involuntary_hist = switches["involuntary_histogram"]
+    histogram_order = "/".join(_SCHED_CS_BUCKETS)
+    print(
+        "      context-switch histograms "
+        f"(buckets {histogram_order}): voluntary="
+        + "/".join(
+            f"{voluntary_hist[bucket]:,}"
+            for bucket in _SCHED_CS_BUCKETS
+        )
+        + ", involuntary="
+        + "/".join(
+            f"{involuntary_hist[bucket]:,}"
+            for bucket in _SCHED_CS_BUCKETS
+        )
+    )
+    switch_classes = switches["switch_class"]
+    print(
+        "      mutually-exclusive switch classes: "
+        + ", ".join(
+            f"{name}={switch_classes[name]['count']:,}"
+            for name in _SCHED_SWITCH_CLASSES
+        )
+    )
+    endpoint_cpu = phase["endpoint_cpu_change"]
+    print(
+        f"      endpoint CPU changed: changed={endpoint_cpu['changed']:,}, "
+        f"same_cpu={endpoint_cpu['same_cpu']:,}, "
+        f"changed%={endpoint_cpu['changed_percent_of_valid']:.6f}%"
+    )
+
+    for tail_name in (
+        "gt_1ms",
+        "gt_10ms",
+        "gt_100ms",
+        "ge_p99",
+        "ge_p99_9",
+        "ge_p99_99",
