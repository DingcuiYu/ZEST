+static void f2fs_latency_active_put(void)
+{
+	if (atomic_dec_and_test(&f2fs_latency_active))
+		wake_up_all(&f2fs_latency_active_wait);
+}
+
+static void f2fs_latency_fill_header(struct f2fs_latency_buffer *buffer)
+{
+	struct f2fs_latency_log_header *header =
+		f2fs_latency_header(buffer);
+	u64 records = min_t(u64, atomic64_read(&buffer->next_record),
+				buffer->capacity);
+
+	header->records = records;
+	header->dropped = atomic64_read(&buffer->dropped);
+	header->stop_ns = READ_ONCE(buffer->stop_ns);
+	header->stopped_full = READ_ONCE(buffer->stopped_full);
+	header->tgid_filter = buffer->tgid_filter;
+	header->enabled = atomic_read(&f2fs_latency_enabled);
+}
+
+static void f2fs_latency_stop_and_drain(void)
+{
+	struct f2fs_latency_buffer *buffer;
+
+	atomic_set(&f2fs_latency_enabled, 0);
+	/* Pair with the active-writer acquire/recheck sequence. */
+	smp_mb();
+	synchronize_rcu();
+	wait_event(f2fs_latency_active_wait,
+			   !atomic_read(&f2fs_latency_active));
+
+	buffer = rcu_dereference_protected(f2fs_latency_buffer,
+			lockdep_is_held(&f2fs_latency_control_lock));
+	if (!buffer)
+		return;
+	if (READ_ONCE(buffer->sealed))
+		return;
+
+	if (!READ_ONCE(buffer->stop_ns))
+		WRITE_ONCE(buffer->stop_ns, ktime_get_ns());
+	f2fs_latency_fill_header(buffer);
+	WRITE_ONCE(buffer->sealed, true);
+}
+
+static void f2fs_latency_stop_full(struct f2fs_latency_buffer *buffer,
+		bool dropped)
+{
+	u64 stop_ns = ktime_get_ns();
+	bool disabled;
+
+	if (dropped)
+		atomic64_inc(&buffer->dropped);
+	WRITE_ONCE(buffer->stopped_full, true);
+	(void)cmpxchg64(&buffer->stop_ns, 0, stop_ns);
+	disabled = atomic_cmpxchg(&f2fs_latency_enabled, 1, 0) == 1;
+	if (disabled)
+		f2fs_latency_fill_header(buffer);
+	if (atomic_cmpxchg(&buffer->full_reported, 0, 1) == 0)
+		pr_info("f2fs_fsync_latency: session=%llu log full at %llu records (%lu bytes); tracing disabled, read /sys/kernel/debug/%s/log\n",
+			buffer->session, buffer->capacity, buffer->bytes,
+			F2FS_LATENCY_DIR_NAME);
+}
+
+static struct f2fs_latency_record *
+f2fs_latency_reserve(u16 type, u64 *setup_begin_ns, bool continuation)
+{
+	struct f2fs_latency_buffer *buffer;
+	struct f2fs_latency_record *record;
+	u64 reserve_begin_ns, reserve_end_ns;
+	u64 index;
+	u32 reserve_cpu;
+
+	/* A continuation has an active type=1/type=3 parent holding the buffer. */
+	if (!atomic_read_acquire(&f2fs_latency_enabled) && !continuation)
+		return NULL;
+
+	*setup_begin_ns = ktime_get_ns();
+	rcu_read_lock();
+	if (!atomic_read_acquire(&f2fs_latency_enabled) && !continuation) {
+		rcu_read_unlock();
+		return NULL;
+	}
+
+	buffer = rcu_dereference(f2fs_latency_buffer);
+	if (!buffer) {
+		rcu_read_unlock();
+		return NULL;
+	}
+
+	atomic_inc(&f2fs_latency_active);
+	/* If disable misses this reference, the recheck must see disabled. */
+	smp_mb__after_atomic();
+	if (unlikely((!atomic_read(&f2fs_latency_enabled) && !continuation) ||
+		       READ_ONCE(buffer->sealed) ||
+		       READ_ONCE(buffer->stopped_full))) {
+		f2fs_latency_active_put();
+		rcu_read_unlock();
+		return NULL;
+	}
+	rcu_read_unlock();
+
+	preempt_disable();
+	reserve_begin_ns = ktime_get_ns();
+	index = atomic64_fetch_inc_relaxed(&buffer->next_record);
+	reserve_end_ns = ktime_get_ns();
+	reserve_cpu = raw_smp_processor_id();
+	preempt_enable();
+	if (unlikely(index >= buffer->capacity)) {
+		f2fs_latency_stop_full(buffer, true);
+		f2fs_latency_active_put();
+		return NULL;
+	}
+	if (unlikely(index == buffer->capacity - 1))
+		f2fs_latency_stop_full(buffer, false);
+
+	record = f2fs_latency_record_at(buffer, index);
+	memset(record, 0, sizeof(*record));
+	record->version = F2FS_LATENCY_FORMAT_VERSION;
+	record->type = type;
+	record->size = sizeof(*record);
+	record->seq = index;
+	record->session = buffer->session;
+	record->reserve_ns = reserve_end_ns - reserve_begin_ns;
+	record->pid = current->pid;
+	record->tgid = current->tgid;
+	record->cpu = reserve_cpu;
+	memcpy(record->comm, current->comm, sizeof(record->comm));
+	return record;
+}
+
+static void f2fs_latency_commit(struct f2fs_latency_record *record,
+		u64 finish_begin_ns)
+{
+	u64 finish_end_ns = ktime_get_ns();
+
+	record->write_ns += finish_end_ns - finish_begin_ns;
+	/* Publish every initialized field before exposing a valid record. */
+	smp_store_release(&record->magic, F2FS_LATENCY_RECORD_MAGIC);
+	f2fs_latency_active_put();
+}
+
+static void f2fs_latency_set_mount_flags(struct f2fs_latency_record *record,
+		struct f2fs_sb_info *sbi)
+{
+	if (test_opt(sbi, NOBARRIER))
+		record->flags |= F2FS_FSYNC_LAT_MOUNT_NOBARRIER;
+	if (test_opt(sbi, FLUSH_MERGE))
+		record->flags |= F2FS_FSYNC_LAT_FLUSH_MERGE;
+	if (f2fs_is_multi_device(sbi))
+		record->flags |= F2FS_FSYNC_LAT_MULTI_DEVICE;
+	if (f2fs_sb_has_blkzoned(sbi))
+		record->flags |= F2FS_FSYNC_LAT_BLKZONED;
+	if (F2FS_OPTION(sbi).fsync_mode == FSYNC_MODE_NOBARRIER)
+		record->flags |= F2FS_FSYNC_LAT_FSYNC_NOBARRIER;
+}
+
+bool f2fs_fsync_latency_enabled(void)
+{
+	return atomic_read_acquire(&f2fs_latency_enabled);
+}
+
+bool f2fs_fsync_latency_flush_scan_needed(void)
+{
+	return f2fs_fsync_latency_enabled() ||
+		atomic_read(&f2fs_latency_active);
+}
+
+void f2fs_fsync_latency_begin(struct f2fs_fsync_latency_ctx *ctx,
+		struct inode *inode, loff_t start, loff_t end, int datasync,
+		bool atomic)
+{
+	struct f2fs_latency_record *record;
+	struct f2fs_sb_info *sbi = F2FS_I_SB(inode);
+	u64 setup_begin_ns, setup_end_ns;
+	u32 filter;
+
+	ctx->record = NULL;
+	if (!atomic_read_acquire(&f2fs_latency_enabled))
+		return;
+	filter = READ_ONCE(f2fs_latency_tgid_filter);
+	if (filter && filter != current->tgid)
+		return;
+
+	record = f2fs_latency_reserve(F2FS_LATENCY_RECORD_FSYNC,
+					      &setup_begin_ns, false);
+	if (!record)
+		return;
+	ctx->node_submit_begin_ns = 0;
+	ctx->node_wait_begin_ns = 0;
+	ctx->data_accounted_ns = 0;
+	INIT_HLIST_NODE(&ctx->data_scope_node);
+	ctx->data_scope_mapping = NULL;
+	ctx->data_scope_task = NULL;
+	ctx->data_scope_wbc = NULL;
+	memset(&ctx->balance_cp, 0, sizeof(ctx->balance_cp));
+	ctx->data_region_depth = 0;
+	ctx->data_scope_registered = false;
+
+	record->ino = inode->i_ino;
+	record->range_start = start;
+	record->range_end = end;
+	record->dev = new_encode_dev(inode->i_sb->s_dev);
+	record->datasync = !!datasync;
+	if (datasync)
+		record->flags |= F2FS_FSYNC_LAT_DATASYNC;
+	if (S_ISDIR(inode->i_mode))
+		record->flags |= F2FS_FSYNC_LAT_DIRECTORY;
+	if (atomic)
+		record->flags |= F2FS_FSYNC_LAT_ATOMIC;
+	f2fs_latency_set_mount_flags(record, sbi);
+	record->values[F2FS_LAT_VALUE_AUX] = F2FS_OPTION(sbi).fsync_mode;
+
+	setup_end_ns = ktime_get_ns();
+	record->values[F2FS_LAT_VALUE_SETUP_NS] =
+		setup_end_ns - setup_begin_ns;
+	record->write_ns = setup_end_ns - setup_begin_ns;
+	record->start_ns = setup_end_ns;
+	ctx->record = record;
+}
+
+void f2fs_fsync_latency_end(struct f2fs_fsync_latency_ctx *ctx,
+		struct inode *inode, unsigned int cp_reason, int ret)
+{
+	struct f2fs_latency_record *record = ctx->record;
+	u64 finish_begin_ns;
+
+	if (!record)
+		return;
+	if (WARN_ON_ONCE(ctx->data_scope_registered)) {
+		record->flags |= F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR;
+		f2fs_latency_data_scope_unregister(ctx);
+	}
+
+	finish_begin_ns = ktime_get_ns();
+	record->end_ns = finish_begin_ns;
+	record->ret = ret;
+	record->cp_reason = cp_reason;
+	record->ino = inode->i_ino;
+	if (ret)
+		record->flags |= F2FS_FSYNC_LAT_ERROR;
+	ctx->record = NULL;
+	f2fs_latency_commit(record, finish_begin_ns);
+}
+
+void f2fs_fsync_latency_mark(struct f2fs_fsync_latency_ctx *ctx, u32 flags)
+{
+	struct f2fs_latency_record *record = ctx->record;
+
+	if (record)
+		record->flags |= flags;
+}
+
+static unsigned int f2fs_latency_data_scope_index(
+		const struct task_struct *task, const struct address_space *mapping)
+{
+	unsigned long key = (unsigned long)task ^
+		((unsigned long)mapping >> L1_CACHE_SHIFT);
+
+	return hash_long(key, F2FS_LATENCY_DATA_SCOPE_BITS);
+}
+
+static bool f2fs_latency_data_scope_register(
+		struct f2fs_fsync_latency_ctx *ctx, struct address_space *mapping)
+{
+	struct f2fs_latency_data_scope_bucket *bucket;
+	unsigned int index;
+
+	if (WARN_ON_ONCE(ctx->data_scope_registered)) {
+		if (ctx->record)
+			((struct f2fs_latency_record *)ctx->record)->flags |=
+				F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR;
+		return false;
+	}
+	ctx->data_scope_mapping = mapping;
+	ctx->data_scope_task = current;
+	ctx->data_scope_wbc = NULL;
+	index = f2fs_latency_data_scope_index(current, mapping);
+	bucket = &f2fs_latency_data_scopes[index];
+	spin_lock(&bucket->lock);
+	hlist_add_head(&ctx->data_scope_node, &bucket->scopes);
+	ctx->data_scope_registered = true;
+	atomic_inc(&f2fs_latency_active_data_scopes);
+	spin_unlock(&bucket->lock);
+	return true;
+}
+
+static void f2fs_latency_data_scope_unregister(
+		struct f2fs_fsync_latency_ctx *ctx)
+{
+	struct f2fs_latency_data_scope_bucket *bucket;
+	struct f2fs_latency_record *record = ctx->record;
+	unsigned int index;
+
+	if (!ctx->data_scope_registered)
+		return;
+	index = f2fs_latency_data_scope_index(ctx->data_scope_task,
+		ctx->data_scope_mapping);
+	bucket = &f2fs_latency_data_scopes[index];
+	spin_lock(&bucket->lock);
+	if (ctx->data_scope_wbc && record)
+		record->flags |= F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR;
+	ctx->data_scope_wbc = NULL;
+	hlist_del_init(&ctx->data_scope_node);
+	ctx->data_scope_registered = false;
+	ctx->data_scope_mapping = NULL;
+	ctx->data_scope_task = NULL;
+	atomic_dec(&f2fs_latency_active_data_scopes);
+	spin_unlock(&bucket->lock);
+}
+
+struct f2fs_fsync_latency_ctx *f2fs_fsync_latency_data_scope_claim(
+		struct address_space *mapping, struct writeback_control *wbc)
+{
+	struct f2fs_latency_data_scope_bucket *bucket;
+	struct f2fs_fsync_latency_ctx *ctx;
+	unsigned int index;
+
+	if (!atomic_read(&f2fs_latency_active_data_scopes))
+		return NULL;
+	index = f2fs_latency_data_scope_index(current, mapping);
+	bucket = &f2fs_latency_data_scopes[index];
+	spin_lock(&bucket->lock);
+	hlist_for_each_entry(ctx, &bucket->scopes, data_scope_node) {
+		if (ctx->data_scope_task != current ||
+		    ctx->data_scope_mapping != mapping)
+			continue;
+		if (ctx->data_scope_wbc) {
+			if (ctx->record)
+				((struct f2fs_latency_record *)ctx->record)->flags |=
+					F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR;
+			ctx = NULL;
+			break;
+		}
+		ctx->data_scope_wbc = wbc;
+		break;
+	}
+	spin_unlock(&bucket->lock);
+	return ctx;
+}
+
+void f2fs_fsync_latency_data_scope_release(
+		struct f2fs_fsync_latency_ctx *ctx, struct writeback_control *wbc)
+{
+	struct f2fs_latency_data_scope_bucket *bucket;
+	struct f2fs_latency_record *record;
+	unsigned int index;
+
+	if (!ctx)
+		return;
+	record = ctx->record;
+	index = f2fs_latency_data_scope_index(ctx->data_scope_task,
+		ctx->data_scope_mapping);
+	bucket = &f2fs_latency_data_scopes[index];
+	spin_lock(&bucket->lock);
+	if (!ctx->data_scope_registered || ctx->data_scope_wbc != wbc) {
+		if (record)
+			record->flags |= F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR;
+	} else {
+		ctx->data_scope_wbc = NULL;
+	}
+	spin_unlock(&bucket->lock);
+}
+
+static bool f2fs_latency_data_breakdown_complete(
+		struct f2fs_fsync_latency_ctx *ctx)
+{
+	struct f2fs_latency_record *record = ctx->record;
+	u64 begin_ns = record->values[F2FS_LAT_VALUE_DATA_SUBMIT_BEGIN_NS];
+	u64 end_ns = record->values[F2FS_LAT_VALUE_DATA_SUBMIT_END_NS];
+	u64 detail_sum = 0;
+	u64 sum = 0;
+	unsigned int i;
+
+	if (ctx->data_region_depth)
+		goto error;
+	for (i = 0; i < F2FS_FSYNC_LAT_DATA_SUBSTAGE_COUNT; i++) {
+		u64 elapsed = record->values[
+			f2fs_latency_data_substage_ns_index(i)];
+
+		if (check_add_overflow(sum, elapsed, &sum))
+			goto error;
+	}
+	if (sum != ctx->data_accounted_ns || !begin_ns || end_ns < begin_ns ||
+	    sum > end_ns - begin_ns)
+		goto error;
+	for (i = 0; i < F2FS_FSYNC_LAT_DATA_DETAIL_COUNT; i++) {
+		u64 elapsed = record->values[
+			f2fs_latency_data_detail_ns_index(i)];
+		u64 calls = record->values[
+			f2fs_latency_data_detail_count_index(i)];
+
+		if ((elapsed && !calls) ||
+		    check_add_overflow(detail_sum, elapsed, &detail_sum))
+			goto error;
+	}
+	if (detail_sum > record->values[F2FS_LAT_VALUE_DATA_SUBMIT_PAGE_NS] ||
+	    record->values[F2FS_LAT_VALUE_DETAIL_SUBMIT_IO_RWSEM_COUNT] !=
+		record->values[F2FS_LAT_VALUE_DATA_SUBMIT_PAGE_COUNT])
+		goto error;
+	return true;
+
+error:
+	record->flags |= F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR;
+	return false;
+}
+
+int f2fs_fsync_latency_data_write_and_wait(
+		struct f2fs_fsync_latency_ctx *ctx, struct file *file,
+		loff_t start, loff_t end)
+{
+	struct f2fs_latency_record *record = ctx->record;
+	struct address_space *mapping = file->f_mapping;
+	int err = 0, err2;
+	u64 now, wait_begin_ns;
+	bool scope_registered;
+
+	if (!record)
+		return file_write_and_wait_range(file, start, end);
+	if (end < start)
+		return 0;
+
+	/* Keep the same cheap predicate as file_write_and_wait_range(). */
+	if (mapping->nrpages) {
+		record->flags |= F2FS_FSYNC_LAT_DATA_WRITEBACK;
+		scope_registered = f2fs_latency_data_scope_register(ctx, mapping);
+		now = ktime_get_ns();
+		record->values[F2FS_LAT_VALUE_DATA_SUBMIT_BEGIN_NS] = now;
+		err = filemap_fdatawrite_range(mapping, start, end);
+		now = ktime_get_ns();
+		record->values[F2FS_LAT_VALUE_DATA_SUBMIT_END_NS] = now;
+		if (scope_registered)
+			f2fs_latency_data_breakdown_complete(ctx);
+		if (scope_registered)
+			f2fs_latency_data_scope_unregister(ctx);
+		if (scope_registered &&
+		    !(record->flags & F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR))
+			record->flags |= F2FS_FSYNC_LAT_DATA_BREAKDOWN_VALID;
+		if (err != -EIO) {
+			record->flags |= F2FS_FSYNC_LAT_DATA_WAIT;
+			wait_begin_ns = ktime_get_ns();
+			err2 = file_fdatawait_range(file, start, end);
+			record->values[F2FS_LAT_VALUE_DATA_WAIT_TOTAL_NS] =
+				ktime_get_ns() - wait_begin_ns;
+			if (!err)
+				err = err2;
+			return err;
+		}
+
+		record->flags |= F2FS_FSYNC_LAT_DATA_WAIT_SKIPPED_EIO;
+		record->values[F2FS_LAT_VALUE_DATA_WAIT_TOTAL_NS] = 0;
+	} else {
+		now = ktime_get_ns();
+		record->values[F2FS_LAT_VALUE_DATA_SUBMIT_BEGIN_NS] = now;
+		record->values[F2FS_LAT_VALUE_DATA_SUBMIT_END_NS] = now;
+		record->values[F2FS_LAT_VALUE_DATA_WAIT_TOTAL_NS] = 0;
+	}
+
+	err2 = file_check_and_advance_wb_err(file);
+	if (!err)
+		err = err2;
+	return err;
+}
+
+u64 f2fs_fsync_latency_data_substage_begin(
+		struct f2fs_fsync_latency_ctx *ctx)
+{
+	if (!ctx || !ctx->record)
+		return 0;
+	return ktime_get_ns();
+}
+
+static bool f2fs_latency_data_substage_add(
+		struct f2fs_fsync_latency_ctx *ctx,
+		enum f2fs_fsync_latency_data_substage substage, u64 elapsed_ns)
+{
+	struct f2fs_latency_record *record = ctx->record;
+	unsigned int ns_index, count_index;
+	u64 new_elapsed, new_count, new_accounted;
+
+	if (unlikely(substage >= F2FS_FSYNC_LAT_DATA_SUBSTAGE_COUNT))
+		goto error;
+	ns_index = f2fs_latency_data_substage_ns_index(substage);
+	count_index = f2fs_latency_data_substage_count_index(substage);
+	if (check_add_overflow(record->values[ns_index], elapsed_ns,
+			&new_elapsed) ||
+	    check_add_overflow(record->values[count_index], 1ULL,
+			&new_count) ||
+	    check_add_overflow(ctx->data_accounted_ns, elapsed_ns,
+			&new_accounted))
+		goto error;
+	record->values[ns_index] = new_elapsed;
+	record->values[count_index] = new_count;
+	ctx->data_accounted_ns = new_accounted;
+	return true;
+
+error:
+	record->flags |= F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR;
+	return false;
+}
+
+void f2fs_fsync_latency_data_substage_end(
+		struct f2fs_fsync_latency_ctx *ctx,
+		enum f2fs_fsync_latency_data_substage substage, u64 begin_ns)
+{
+	struct f2fs_latency_record *record;
+	u64 end_ns;
+
+	if (!ctx || !ctx->record || !begin_ns)
+		return;
+	record = ctx->record;
+	if (unlikely(substage >= F2FS_FSYNC_LAT_DATA_SUBSTAGE_COUNT)) {
+		record->flags |= F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR;
+		return;
+	}
+	end_ns = ktime_get_ns();
+	if (unlikely(end_ns < begin_ns)) {
+		record->flags |= F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR;
+		return;
+	}
+	f2fs_latency_data_substage_add(ctx, substage, end_ns - begin_ns);
+}
+
+void f2fs_fsync_latency_data_detail_end(
+		struct f2fs_fsync_latency_ctx *ctx,
+		enum f2fs_fsync_latency_data_detail detail, u64 begin_ns)
+{
+	struct f2fs_latency_record *record;
+	unsigned int count_index, ns_index;
+	u64 end_ns, new_count, new_elapsed;
+
+	if (!ctx || !ctx->record || !begin_ns)
+		return;
+	record = ctx->record;
+	if (unlikely(detail >= F2FS_FSYNC_LAT_DATA_DETAIL_COUNT))
+		goto error;
+	end_ns = ktime_get_ns();
+	if (unlikely(end_ns < begin_ns))
+		goto error;
+	ns_index = f2fs_latency_data_detail_ns_index(detail);
+	count_index = f2fs_latency_data_detail_count_index(detail);
+	if (check_add_overflow(record->values[ns_index], end_ns - begin_ns,
+			&new_elapsed) ||
+	    check_add_overflow(record->values[count_index], 1ULL,
+			&new_count))
+		goto error;
+	record->values[ns_index] = new_elapsed;
+	record->values[count_index] = new_count;
+	return;
+
+error:
+	record->flags |= F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR;
+}
+
+void f2fs_fsync_latency_data_region_begin(
+		struct f2fs_fsync_latency_ctx *ctx,
+		struct f2fs_fsync_latency_data_region *region)
+{
+	memset(region, 0, sizeof(*region));
+	if (!ctx || !ctx->record)
+		return;
+	if (unlikely(ctx->data_region_depth == U32_MAX)) {
+		((struct f2fs_latency_record *)ctx->record)->flags |=
+			F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR;
+		return;
+	}
+	region->accounted_ns = ctx->data_accounted_ns;
+	region->depth = ++ctx->data_region_depth;
+	region->begin_ns = ktime_get_ns();
+}
+
+void f2fs_fsync_latency_data_region_end(
+		struct f2fs_fsync_latency_ctx *ctx,
+		enum f2fs_fsync_latency_data_substage substage,
+		struct f2fs_fsync_latency_data_region *region)
+{
+	struct f2fs_latency_record *record;
+	u64 end_ns, inclusive_ns, nested_ns;
+
+	if (!ctx || !ctx->record || !region->begin_ns)
+		return;
+	record = ctx->record;
+	end_ns = ktime_get_ns();
+	if (unlikely(region->depth != ctx->data_region_depth ||
+		       end_ns < region->begin_ns ||
+		       ctx->data_accounted_ns < region->accounted_ns))
+		goto error;
+	inclusive_ns = end_ns - region->begin_ns;
+	nested_ns = ctx->data_accounted_ns - region->accounted_ns;
+	if (unlikely(nested_ns > inclusive_ns))
+		goto error;
+	ctx->data_region_depth--;
+	f2fs_latency_data_substage_add(ctx, substage,
+		inclusive_ns - nested_ns);
+	memset(region, 0, sizeof(*region));
+	return;
+
+error:
+	record->flags |= F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR;
+	ctx->data_region_depth = 0;
+	memset(region, 0, sizeof(*region));
+}
+
+void f2fs_fsync_latency_folio_lock(
+		struct f2fs_fsync_latency_ctx *ctx, struct folio *folio)
+{
+	u64 begin_ns;
+
+	if (!ctx || !ctx->record) {
+		folio_lock(folio);
+		return;
+	}
+	might_sleep();
+	if (folio_trylock(folio))
+		return;
+	begin_ns = ktime_get_ns();
+	__folio_lock(folio);
+	f2fs_fsync_latency_data_substage_end(ctx,
+		F2FS_FSYNC_LAT_DATA_FOLIO_LOCK_CONTENDED, begin_ns);
+}
+
+void f2fs_fsync_latency_balance_checkpoint_commit(
+		struct f2fs_fsync_latency_ctx *ctx,
+		const struct f2fs_fsync_latency_balance_cp_result *result)
+{
+	struct f2fs_latency_record *parent;
+	struct f2fs_latency_record *record;
+	u64 setup_begin_ns, setup_end_ns, finish_begin_ns;
+	u32 mount_flags = F2FS_FSYNC_LAT_MOUNT_NOBARRIER |
+		F2FS_FSYNC_LAT_FLUSH_MERGE |
+		F2FS_FSYNC_LAT_MULTI_DEVICE |
+		F2FS_FSYNC_LAT_BLKZONED |
+		F2FS_FSYNC_LAT_FSYNC_NOBARRIER;
+
+	if (!ctx || !ctx->record || !result || !result->triggered)
+		return;
+	parent = ctx->record;
+	record = f2fs_latency_reserve(F2FS_LATENCY_RECORD_BALANCE_CP_WAITER,
+		&setup_begin_ns, true);
+	if (!record)
+		return;
+
+	record->flags = F2FS_FSYNC_LAT_CHECKPOINT |
+		F2FS_FSYNC_LAT_BALANCE_CP_WAITER |
+		(parent->flags & mount_flags);
+	record->ino = parent->ino;
+	record->dev = parent->dev;
+	record->datasync = parent->datasync;
+	record->cp_reason = CP_SYNC;
+	record->ret = result->ret;
+	if (result->ret)
+		record->flags |= F2FS_FSYNC_LAT_ERROR;
+	if (result->batch_id)
+		record->flags |= F2FS_FSYNC_LAT_CP_BATCH_ASSOC;
+	if (result->execution_valid)
+		record->flags |= F2FS_FSYNC_LAT_CP_EXEC_VALID;
+	record->start_ns = result->sync_begin_ns;
+	record->end_ns = result->sync_end_ns;
+	record->values[F2FS_LAT_VALUE_BALANCE_PARENT_SEQ] = parent->seq;
+	record->values[F2FS_LAT_VALUE_BALANCE_SYNC_BEGIN_NS] =
+		result->sync_begin_ns;
+	record->values[F2FS_LAT_VALUE_BALANCE_SYNC_END_NS] =
+		result->sync_end_ns;
+	record->values[F2FS_LAT_VALUE_BALANCE_CP_BATCH_ID] = result->batch_id;
+	record->values[F2FS_LAT_VALUE_BALANCE_CP_EXECUTION_BEGIN_NS] =
+		result->execution_begin_ns;
+	record->values[F2FS_LAT_VALUE_BALANCE_CP_EXECUTION_END_NS] =
+		result->execution_end_ns;
+	record->values[F2FS_LAT_VALUE_BALANCE_CP_DEVICE_FLUSH_NS] =
+		result->device_flush_ns;
+	record->values[F2FS_LAT_VALUE_BALANCE_CP_DEVICE_FLUSH_MAX_NS] =
+		result->device_flush_max_ns;
+	record->values[F2FS_LAT_VALUE_BALANCE_CP_DEVICE_FLUSH_COUNT] =
+		result->device_flush_count;
+	record->values[F2FS_LAT_VALUE_BALANCE_CP_DEVICE_FLUSH_ERRORS] =
+		result->device_flush_errors;
+	record->values[F2FS_LAT_VALUE_BALANCE_CALL_INDEX] =
+		parent->values[
+			f2fs_latency_data_substage_count_index(
+				F2FS_FSYNC_LAT_DATA_BALANCE_GC)];
+	record->values[F2FS_LAT_VALUE_BALANCE_TRIGGER_KIND] =
+		F2FS_FSYNC_LAT_BALANCE_TRIGGER_BG_SYNC_FS;
+	setup_end_ns = ktime_get_ns();
+	record->write_ns = setup_end_ns - setup_begin_ns;
+	finish_begin_ns = ktime_get_ns();
+	f2fs_latency_commit(record, finish_begin_ns);
+}
+
+void f2fs_fsync_latency_node_submit_begin(
+		struct f2fs_fsync_latency_ctx *ctx)
+{
+	struct f2fs_latency_record *record = ctx->record;
+	u64 now;
+
+	if (!record)
+		return;
+	now = ktime_get_ns();
+	if (!record->node_submit_count)
+		record->values[F2FS_LAT_VALUE_NODE_SUBMIT_FIRST_BEGIN_NS] = now;
+	record->flags |= F2FS_FSYNC_LAT_NODE_SUBMIT;
+	record->node_submit_count++;
+	ctx->node_submit_begin_ns = now;
+}
+
+void f2fs_fsync_latency_node_submit_end(
+		struct f2fs_fsync_latency_ctx *ctx)
+{
+	struct f2fs_latency_record *record = ctx->record;
+	u64 now;
+
+	if (!record || !ctx->node_submit_begin_ns)
+		return;
+	now = ktime_get_ns();
+	record->values[F2FS_LAT_VALUE_NODE_SUBMIT_LAST_END_NS] = now;
+	record->values[F2FS_LAT_VALUE_NODE_SUBMIT_TOTAL_NS] +=
+		now - ctx->node_submit_begin_ns;
+	ctx->node_submit_begin_ns = 0;
+}
+
+void f2fs_fsync_latency_node_wait_begin(
+		struct f2fs_fsync_latency_ctx *ctx)
+{
+	struct f2fs_latency_record *record = ctx->record;
+	u64 now;
+
+	if (!record)
+		return;
+	now = ktime_get_ns();
+	if (!(record->flags & F2FS_FSYNC_LAT_NODE_WAIT))
+		record->values[F2FS_LAT_VALUE_NODE_WAIT_FIRST_BEGIN_NS] = now;
+	record->flags |= F2FS_FSYNC_LAT_NODE_WAIT;
+	ctx->node_wait_begin_ns = now;
+}
+
+void f2fs_fsync_latency_node_wait_end(
+		struct f2fs_fsync_latency_ctx *ctx)
+{
+	struct f2fs_latency_record *record = ctx->record;
+	u64 now;
+
+	if (!record || !ctx->node_wait_begin_ns)
+		return;
+	now = ktime_get_ns();
+	record->values[F2FS_LAT_VALUE_NODE_WAIT_LAST_END_NS] = now;
+	record->values[F2FS_LAT_VALUE_NODE_WAIT_TOTAL_NS] +=
+		now - ctx->node_wait_begin_ns;
+	ctx->node_wait_begin_ns = 0;
+}
+
+void f2fs_fsync_latency_flush_begin(struct f2fs_fsync_latency_ctx *ctx)
+{
+	struct f2fs_latency_record *record = ctx->record;
+
+	if (!record)
+		return;
+	record->flags |= F2FS_FSYNC_LAT_LOGICAL_FLUSH;
+	record->values[F2FS_LAT_VALUE_LOGICAL_FLUSH_BEGIN_NS] =
+		ktime_get_ns();
+}
+
+void f2fs_fsync_latency_flush_end(struct f2fs_fsync_latency_ctx *ctx)
+{
+	struct f2fs_latency_record *record = ctx->record;
+
+	if (record)
+		record->values[F2FS_LAT_VALUE_LOGICAL_FLUSH_END_NS] =
+			ktime_get_ns();
+}
+
+void f2fs_fsync_latency_checkpoint_begin(
+		struct f2fs_fsync_latency_ctx *ctx)
+{
+	struct f2fs_latency_record *record = ctx->record;
+
+	if (!record)
+		return;
+	record->flags |= F2FS_FSYNC_LAT_CHECKPOINT;
+	record->values[F2FS_LAT_VALUE_CHECKPOINT_BEGIN_NS] =
+		ktime_get_ns();
+}
+
+void f2fs_fsync_latency_checkpoint_end(
+		struct f2fs_fsync_latency_ctx *ctx,
+		const struct f2fs_fsync_latency_cp_result *latency)
+{
+	struct f2fs_latency_record *record = ctx->record;
+	u64 now;
+
+	if (!record)
+		return;
+	now = ktime_get_ns();
+	record->values[F2FS_LAT_VALUE_CHECKPOINT_END_NS] = now;
+	if (!latency || !latency->batch_id)
+		return;
+	record->flags |= F2FS_FSYNC_LAT_CP_BATCH_ASSOC;
+	record->values[F2FS_LAT_VALUE_CP_BATCH_ID] = latency->batch_id;
+	record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_NS] =
+		latency->device_flush_ns;
+	record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_MAX_NS] =
+		latency->device_flush_max_ns;
+	record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_COUNT] =
+		latency->device_flush_count;
+	record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_ERRORS] =
+		latency->device_flush_errors;
+	if (latency->execution_valid) {
+		record->flags |= F2FS_FSYNC_LAT_CP_EXEC_VALID;
+		record->values[F2FS_LAT_VALUE_CP_EXECUTION_BEGIN_NS] =
+			latency->execution_begin_ns;
+		record->values[F2FS_LAT_VALUE_CP_EXECUTION_END_NS] =
+			latency->execution_end_ns;
+	}
+}
+
+void f2fs_fsync_latency_checkpoint_batch_begin(
+		struct f2fs_fsync_latency_cp_result *latency)
+{
+	u64 batch_id;
+
+	memset(latency, 0, sizeof(*latency));
+	batch_id = atomic64_inc_return_relaxed(&f2fs_latency_next_cp_batch);
+	if (unlikely(!batch_id))
+		batch_id = atomic64_inc_return_relaxed(
+				&f2fs_latency_next_cp_batch);
+	latency->batch_id = batch_id;
+}
+
+void f2fs_fsync_latency_checkpoint_execution_begin(
+		struct f2fs_fsync_latency_checkpoint_ctx *ctx,
+		struct f2fs_fsync_latency_cp_result *latency,
+		struct f2fs_sb_info *sbi)
+{
+	struct f2fs_latency_record *record;
+	u64 setup_begin_ns, begin_ns;
+
+	memset(ctx, 0, sizeof(*ctx));
+	if (!latency || !latency->batch_id)
+		return;
+	record = f2fs_latency_reserve(F2FS_LATENCY_RECORD_CHECKPOINT,
+		&setup_begin_ns, latency->trace_continuation);
+	/*
+	 * A global checkpoint can race with enable=0 after its caller sampled
+	 * the enabled state.  If it did not reserve a record, do not keep doing
+	 * timing work after tracing has been disabled.  A target fsync
+	 * checkpoint is different: its parent record keeps the session alive,
+	 * and still needs the execution timing even if a separate type=3 record
+	 * cannot be reserved.
+	 */
+	if (!record && !latency->trace_continuation)
+		return;
+	if (record) {
+		latency->trace_continuation = true;
+		record->flags = F2FS_FSYNC_LAT_CHECKPOINT |
+			F2FS_FSYNC_LAT_CP_BATCH_ASSOC |
+			F2FS_FSYNC_LAT_CP_EXEC_VALID;
+		record->dev = new_encode_dev(sbi->sb->s_dev);
+		f2fs_latency_set_mount_flags(record, sbi);
+		record->values[F2FS_LAT_VALUE_CP_BATCH_ID] =
+			latency->batch_id;
+		begin_ns = ktime_get_ns();
+		record->values[F2FS_LAT_VALUE_SETUP_NS] =
+			begin_ns - setup_begin_ns;
+		record->write_ns = begin_ns - setup_begin_ns;
+		record->start_ns = begin_ns;
+	} else {
+		begin_ns = ktime_get_ns();
+	}
+	latency->execution_begin_ns = begin_ns;
+	latency->execution_end_ns = 0;
+	latency->execution_valid = false;
+	ctx->record = record;
+	ctx->result = latency;
+	ctx->execution_begin_ns = begin_ns;
+}
+
+void f2fs_fsync_latency_checkpoint_execution_end(
+		struct f2fs_fsync_latency_checkpoint_ctx *ctx, int ret)
+{
+	struct f2fs_fsync_latency_cp_result *latency = ctx->result;
+	struct f2fs_latency_record *record = ctx->record;
+	u64 finish_begin_ns;
+
+	if (!latency || !ctx->execution_begin_ns)
+		return;
+	finish_begin_ns = ktime_get_ns();
+	if (unlikely(finish_begin_ns < ctx->execution_begin_ns)) {
+		if (record) {
+			record->end_ns = finish_begin_ns;
+			record->ret = -ERANGE;
+			record->flags &= ~F2FS_FSYNC_LAT_CP_EXEC_VALID;
+			record->flags |= F2FS_FSYNC_LAT_ERROR;
+			f2fs_latency_commit(record, finish_begin_ns);
+		}
+		memset(ctx, 0, sizeof(*ctx));
+		return;
+	}
+	latency->execution_end_ns = finish_begin_ns;
+	latency->execution_valid = true;
+	if (record) {
+		record->end_ns = finish_begin_ns;
+		record->ret = ret;
+		if (ret)
+			record->flags |= F2FS_FSYNC_LAT_ERROR;
+		record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_NS] =
+			latency->device_flush_ns;
+		record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_MAX_NS] =
+			latency->device_flush_max_ns;
+		record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_COUNT] =
+			latency->device_flush_count;
+		record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_ERRORS] =
+			latency->device_flush_errors;
+		record->values[F2FS_LAT_VALUE_CP_EXECUTION_BEGIN_NS] =
+			latency->execution_begin_ns;
+		record->values[F2FS_LAT_VALUE_CP_EXECUTION_END_NS] =
+			latency->execution_end_ns;
+		f2fs_latency_commit(record, finish_begin_ns);
+	}
+	memset(ctx, 0, sizeof(*ctx));
+}
+
+void f2fs_fsync_latency_physical_flush_begin(
+		struct f2fs_fsync_latency_flush_ctx *ctx,
+		struct f2fs_sb_info *sbi, struct block_device *bdev, u32 ino,
+		enum f2fs_fsync_latency_flush_source source,
+		bool continuation,
+		struct f2fs_fsync_latency_cp_result *checkpoint)
+{
+	struct f2fs_latency_record *record;
+	u64 setup_begin_ns, setup_end_ns;
+
+	ctx->record = NULL;
+	ctx->checkpoint = checkpoint;
+	ctx->issue_begin_ns = 0;
+	record = f2fs_latency_reserve(F2FS_LATENCY_RECORD_FLUSH,
+					      &setup_begin_ns,
+					      continuation ||
+					      (checkpoint &&
+					       checkpoint->trace_continuation));
+	if (!record) {
+		if (checkpoint)
+			ctx->issue_begin_ns = ktime_get_ns();
+		return;
+	}
+
+	record->flags = F2FS_FSYNC_LAT_PHYSICAL_FLUSH;
+	if (source == F2FS_FSYNC_LAT_FLUSH_DEVICE)
+		record->flags |= F2FS_FSYNC_LAT_FLUSH_DEVICE_CACHE;
+	record->ino = ino;
+	record->dev = new_encode_dev(bdev->bd_dev);
+	f2fs_latency_set_mount_flags(record, sbi);
+	record->values[F2FS_LAT_VALUE_AUX] = source;
+	record->flags |= F2FS_FSYNC_LAT_FLUSH_MOUNT_DEV;
+	record->values[F2FS_LAT_VALUE_FLUSH_MOUNT_DEV] =
+		new_encode_dev(sbi->sb->s_dev);
+	if (checkpoint && checkpoint->batch_id) {
+		record->flags |= F2FS_FSYNC_LAT_CP_BATCH_ASSOC;
+		record->values[F2FS_LAT_VALUE_FLUSH_CP_BATCH_ID] =
+			checkpoint->batch_id;
+	}
+	setup_end_ns = ktime_get_ns();
+	record->values[F2FS_LAT_VALUE_SETUP_NS] =
+		setup_end_ns - setup_begin_ns;
+	record->write_ns = setup_end_ns - setup_begin_ns;
+	record->start_ns = setup_end_ns;
+	ctx->issue_begin_ns = setup_end_ns;
+	ctx->record = record;
+}
+
+void f2fs_fsync_latency_physical_flush_end(
+		struct f2fs_fsync_latency_flush_ctx *ctx, int ret)
+{
+	struct f2fs_latency_record *record = ctx->record;
+	struct f2fs_fsync_latency_cp_result *checkpoint = ctx->checkpoint;
+	u64 finish_begin_ns;
+	u64 flush_ns;
+
+	if (!record && !checkpoint)
+		return;
+	finish_begin_ns = ktime_get_ns();
+	flush_ns = finish_begin_ns - ctx->issue_begin_ns;
+	if (checkpoint) {
+		checkpoint->device_flush_ns += flush_ns;
+		checkpoint->device_flush_count++;
+		if (flush_ns > checkpoint->device_flush_max_ns)
+			checkpoint->device_flush_max_ns = flush_ns;
+		if (ret)
+			checkpoint->device_flush_errors++;
+	}
+	ctx->checkpoint = NULL;
+	ctx->issue_begin_ns = 0;
+	if (!record)
+		return;
+	record->end_ns = finish_begin_ns;
+	record->ret = ret;
+	if (ret)
+		record->flags |= F2FS_FSYNC_LAT_ERROR;
+	ctx->record = NULL;
+	f2fs_latency_commit(record, finish_begin_ns);
+}
+
+static struct f2fs_latency_buffer *f2fs_latency_alloc_buffer(unsigned int mb)
+{
+	struct f2fs_latency_log_header *header;
+	struct f2fs_latency_buffer *buffer;
+	u64 bytes64 = (u64)mb << 20;
+	unsigned long bytes;
+	void *memory;
+
+	if (bytes64 > ULONG_MAX || bytes64 <= F2FS_LATENCY_HEADER_SIZE)
+		return ERR_PTR(-E2BIG);
+	bytes = bytes64;
+
+	buffer = kzalloc(sizeof(*buffer), GFP_KERNEL);
+	if (!buffer)
+		return ERR_PTR(-ENOMEM);
+
+	/*
+	 * vmalloc does not support __GFP_NORETRY, and a multi-GiB log needs
+	 * normal direct reclaim to consume MemAvailable rather than MemFree.
+	 */
+	memory = __vmalloc(bytes, GFP_KERNEL | __GFP_NOWARN);
+	if (!memory) {
+		kfree(buffer);
+		return ERR_PTR(-ENOMEM);
+	}
+
+	buffer->memory = memory;
+	buffer->bytes = bytes;
+	buffer->capacity =
+		(bytes - F2FS_LATENCY_HEADER_SIZE) / F2FS_LATENCY_RECORD_SIZE;
+	atomic64_set(&buffer->next_record, 0);
+	atomic64_set(&buffer->dropped, 0);
+	atomic_set(&buffer->full_reported, 0);
+
+	header = f2fs_latency_header(buffer);
+	memset(header, 0, sizeof(*header));
+	memcpy(header->magic, "F2FSLAT", 7);
+	header->version = F2FS_LATENCY_FORMAT_VERSION;
+	header->header_size = F2FS_LATENCY_HEADER_SIZE;
+	header->record_size = F2FS_LATENCY_RECORD_SIZE;
+	header->endian = F2FS_LATENCY_ENDIAN_MARKER;
+	header->buffer_bytes = buffer->bytes;
+	header->capacity = buffer->capacity;
+	strscpy(header->kernel_release, init_utsname()->release,
+		sizeof(header->kernel_release));
+	return buffer;
+}
+
+static void f2fs_latency_free_buffer(struct f2fs_latency_buffer *buffer)
+{
+	if (!buffer)
+		return;
+	vfree(buffer->memory);
+	kfree(buffer);
+}
+
+static int f2fs_latency_start(void)
+{
+	struct f2fs_latency_log_header *header;
+	struct f2fs_latency_buffer *buffer;
+	unsigned int requested_mb;
+	u64 requested_bytes;
+	int ret = 0;
+
+	mutex_lock(&f2fs_latency_control_lock);
+	requested_mb = f2fs_latency_buffer_mb;
+	requested_bytes = (u64)requested_mb << 20;
+	if (atomic_read(&f2fs_latency_enabled))
+		goto out_unlock;
+	if (f2fs_latency_readers) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+
+	f2fs_latency_stop_and_drain();
+	buffer = rcu_dereference_protected(f2fs_latency_buffer,
+			lockdep_is_held(&f2fs_latency_control_lock));
+	if (buffer && buffer->bytes != requested_bytes) {
+		RCU_INIT_POINTER(f2fs_latency_buffer, NULL);
+		f2fs_latency_free_buffer(buffer);
+		buffer = NULL;
+	}
+
+	if (!buffer) {
+		buffer = f2fs_latency_alloc_buffer(requested_mb);
+		if (IS_ERR(buffer)) {
+			ret = PTR_ERR(buffer);
+			pr_err("f2fs_fsync_latency: failed to allocate %u MiB log: %d\n",
+				requested_mb, ret);
+			goto out_unlock;
+		}
+		rcu_assign_pointer(f2fs_latency_buffer, buffer);
+	}
+
+	atomic64_set(&buffer->next_record, 0);
+	atomic64_set(&buffer->dropped, 0);
+	atomic_set(&buffer->full_reported, 0);
+	buffer->session = ++f2fs_latency_next_session;
+	buffer->start_ns = ktime_get_ns();
+	buffer->stop_ns = 0;
+	buffer->tgid_filter = f2fs_latency_tgid_filter;
+	buffer->stopped_full = false;
+	buffer->sealed = false;
+
+	header = f2fs_latency_header(buffer);
+	memset(header, 0, sizeof(*header));
+	memcpy(header->magic, "F2FSLAT", 7);
+	header->version = F2FS_LATENCY_FORMAT_VERSION;
+	header->header_size = F2FS_LATENCY_HEADER_SIZE;
+	header->record_size = F2FS_LATENCY_RECORD_SIZE;
+	header->endian = F2FS_LATENCY_ENDIAN_MARKER;
+	header->buffer_bytes = buffer->bytes;
+	header->capacity = buffer->capacity;
+	header->session = buffer->session;
+	header->start_ns = buffer->start_ns;
+	header->tgid_filter = buffer->tgid_filter;
+	header->enabled = 1;
+	strscpy(header->kernel_release, init_utsname()->release,
+		sizeof(header->kernel_release));
+
+	/* Publish the initialized session before enabling hot-path readers. */
+	atomic_set_release(&f2fs_latency_enabled, 1);
+	pr_info("f2fs_fsync_latency: session=%llu started, buffer=%lu bytes, capacity=%llu records, tgid=%u\n",
+		buffer->session, buffer->bytes, buffer->capacity,
+		buffer->tgid_filter);
+
+out_unlock:
+	mutex_unlock(&f2fs_latency_control_lock);
+	return ret;
+}
+
+static void f2fs_latency_stop(void)
+{
+	mutex_lock(&f2fs_latency_control_lock);
+	f2fs_latency_stop_and_drain();
+	mutex_unlock(&f2fs_latency_control_lock);
+}
+
+static ssize_t f2fs_latency_enable_read(struct file *file, char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	char value[4];
+	int len;
+
+	len = scnprintf(value, sizeof(value), "%d\n",
+			atomic_read(&f2fs_latency_enabled));
+	return simple_read_from_buffer(buf, count, ppos, value, len);
+}
+
+static ssize_t f2fs_latency_enable_write(struct file *file,
+		const char __user *buf, size_t count, loff_t *ppos)
+{
+	bool enable;
+	int ret;
+
+	ret = kstrtobool_from_user(buf, count, &enable);
+	if (ret)
+		return ret;
+	if (enable) {
+		ret = f2fs_latency_start();
+		if (ret)
+			return ret;
+	} else {
+		f2fs_latency_stop();
+	}
+	return count;
+}
+
+static const struct file_operations f2fs_latency_enable_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = f2fs_latency_enable_read,
+	.write = f2fs_latency_enable_write,
+	.llseek = default_llseek,
+};
+
+static ssize_t f2fs_latency_buffer_mb_read(struct file *file,
+		char __user *buf, size_t count, loff_t *ppos)
+{
+	char value[24];
+	int len;
+
+	len = scnprintf(value, sizeof(value), "%u\n",
+			READ_ONCE(f2fs_latency_buffer_mb));
+	return simple_read_from_buffer(buf, count, ppos, value, len);
+}
+
+static ssize_t f2fs_latency_buffer_mb_write(struct file *file,
+		const char __user *buf, size_t count, loff_t *ppos)
+{
+	unsigned int mb;
+	int ret;
+
+	ret = kstrtouint_from_user(buf, count, 0, &mb);
+	if (ret)
+		return ret;
+	if (mb < F2FS_LATENCY_MIN_MB || mb > F2FS_LATENCY_MAX_MB)
+		return -ERANGE;
+
+	mutex_lock(&f2fs_latency_control_lock);
+	if (atomic_read(&f2fs_latency_enabled) || f2fs_latency_readers)
+		ret = -EBUSY;
+	else
+		WRITE_ONCE(f2fs_latency_buffer_mb, mb);
+	mutex_unlock(&f2fs_latency_control_lock);
+	return ret ? ret : count;
+}
+
+static const struct file_operations f2fs_latency_buffer_mb_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = f2fs_latency_buffer_mb_read,
+	.write = f2fs_latency_buffer_mb_write,
+	.llseek = default_llseek,
+};
+
+static ssize_t f2fs_latency_tgid_read(struct file *file, char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	char value[24];
+	int len;
+
+	len = scnprintf(value, sizeof(value), "%u\n",
+			READ_ONCE(f2fs_latency_tgid_filter));
+	return simple_read_from_buffer(buf, count, ppos, value, len);
+}
+
+static ssize_t f2fs_latency_tgid_write(struct file *file,
+		const char __user *buf, size_t count, loff_t *ppos)
+{
+	unsigned int tgid;
+	int ret;
+
+	ret = kstrtouint_from_user(buf, count, 0, &tgid);
+	if (ret)
+		return ret;
+
+	mutex_lock(&f2fs_latency_control_lock);
+	if (atomic_read(&f2fs_latency_enabled) || f2fs_latency_readers)
+		ret = -EBUSY;
+	else
+		WRITE_ONCE(f2fs_latency_tgid_filter, tgid);
+	mutex_unlock(&f2fs_latency_control_lock);
+	return ret ? ret : count;
+}
+
+static const struct file_operations f2fs_latency_tgid_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = f2fs_latency_tgid_read,
+	.write = f2fs_latency_tgid_write,
+	.llseek = default_llseek,
+};
+
+static ssize_t f2fs_latency_reset_write(struct file *file,
+		const char __user *buf, size_t count, loff_t *ppos)
+{
+	struct f2fs_latency_buffer *buffer;
+	bool reset;
+	int ret;
+
+	ret = kstrtobool_from_user(buf, count, &reset);
+	if (ret)
+		return ret;
+	if (!reset)
+		return count;
+
+	mutex_lock(&f2fs_latency_control_lock);
+	if (f2fs_latency_readers) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	f2fs_latency_stop_and_drain();
+	buffer = rcu_dereference_protected(f2fs_latency_buffer,
+			lockdep_is_held(&f2fs_latency_control_lock));
+	RCU_INIT_POINTER(f2fs_latency_buffer, NULL);
+	f2fs_latency_free_buffer(buffer);
+
+out_unlock:
+	mutex_unlock(&f2fs_latency_control_lock);
+	return ret ? ret : count;
+}
+
+static const struct file_operations f2fs_latency_reset_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = f2fs_latency_reset_write,
+	.llseek = no_llseek,
+};
+
+static int f2fs_latency_snapshot_get(struct f2fs_latency_buffer **buffer)
+{
+	int ret = 0;
+
+	mutex_lock(&f2fs_latency_control_lock);
+	if (atomic_read(&f2fs_latency_enabled)) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	f2fs_latency_stop_and_drain();
+	*buffer = rcu_dereference_protected(f2fs_latency_buffer,
+			lockdep_is_held(&f2fs_latency_control_lock));
+	if (!*buffer) {
+		ret = -ENODATA;
+		goto out_unlock;
+	}
+	f2fs_latency_readers++;
+
+out_unlock:
+	mutex_unlock(&f2fs_latency_control_lock);
+	return ret;
+}
+
+static void f2fs_latency_snapshot_put(void)
+{
+	mutex_lock(&f2fs_latency_control_lock);
+	WARN_ON_ONCE(!f2fs_latency_readers);
+	if (f2fs_latency_readers)
+		f2fs_latency_readers--;
+	mutex_unlock(&f2fs_latency_control_lock);
+}
+
+static int f2fs_latency_log_open(struct inode *inode, struct file *file)
+{
+	struct f2fs_latency_log_reader *reader;
+	struct f2fs_latency_buffer *buffer;
+	u64 records;
+	int ret;
+
+	ret = f2fs_latency_snapshot_get(&buffer);
+	if (ret)
+		return ret;
+
+	reader = kzalloc(sizeof(*reader), GFP_KERNEL);
+	if (!reader) {
+		f2fs_latency_snapshot_put();
+		return -ENOMEM;
+	}
+	records = min_t(u64, atomic64_read(&buffer->next_record),
+				buffer->capacity);
+	reader->buffer = buffer;
+	reader->length = F2FS_LATENCY_HEADER_SIZE +
+		records * F2FS_LATENCY_RECORD_SIZE;
+	file->private_data = reader;
+	return 0;
+}
+
+static ssize_t f2fs_latency_log_read(struct file *file, char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	struct f2fs_latency_log_reader *reader = file->private_data;
+
+	return simple_read_from_buffer(buf, count, ppos,
+			reader->buffer->memory, reader->length);
+}
+
+static int f2fs_latency_log_release(struct inode *inode, struct file *file)
+{
+	kfree(file->private_data);
+	f2fs_latency_snapshot_put();
+	return 0;
+}
+
+static const struct file_operations f2fs_latency_log_fops = {
+	.owner = THIS_MODULE,
+	.open = f2fs_latency_log_open,
+	.read = f2fs_latency_log_read,
+	.release = f2fs_latency_log_release,
+	.llseek = default_llseek,
+};
+
+static void f2fs_latency_metric_add(struct f2fs_latency_metric *metric,
+		u64 value)
+{
+	if (!metric->count || value < metric->min)
+		metric->min = value;
+	if (value > metric->max)
+		metric->max = value;
+	metric->count++;
+	metric->total += value;
+}
+
+static void f2fs_latency_metric_show(struct seq_file *m, const char *name,
+		const struct f2fs_latency_metric *metric)
+{
+	u64 average = metric->count ?
+		div64_u64(metric->total, metric->count) : 0;
+
+	seq_printf(m,
+		"%-24s count=%llu avg_ns=%llu min_ns=%llu max_ns=%llu total_ns=%llu\n",
+		name, metric->count, average, metric->min, metric->max,
+		metric->total);
+}
+
+static void f2fs_latency_breakdown_metric_show(struct seq_file *m,
+		const char *name, const struct f2fs_latency_metric *metric,
+		u64 parent_total)
+{
+	u64 average = metric->count ?
+		div64_u64(metric->total, metric->count) : 0;
+	u64 ppm = parent_total ?
+		mul_u64_u64_div_u64(metric->total, 1000000ULL,
+			parent_total) : 0;
+
+	seq_printf(m,
+		"%-28s count=%llu avg_ns=%llu min_ns=%llu max_ns=%llu total_ns=%llu pct_data_submit=%llu.%04llu%%\n",
+		name, metric->count, average, metric->min, metric->max,
+		metric->total, ppm / 10000, ppm % 10000);
+}
+
+static void f2fs_latency_submit_detail_metric_show(struct seq_file *m,
+		const char *name, const struct f2fs_latency_metric *metric,
+		u64 submit_page_total, u64 data_submit_total)
+{
+	u64 average = metric->count ?
+		div64_u64(metric->total, metric->count) : 0;
+	u64 submit_ppm = submit_page_total ?
+		mul_u64_u64_div_u64(metric->total, 1000000ULL,
+			submit_page_total) : 0;
+	u64 data_ppm = data_submit_total ?
+		mul_u64_u64_div_u64(metric->total, 1000000ULL,
+			data_submit_total) : 0;
+
+	seq_printf(m,
+		"%-32s count=%llu avg_ns=%llu min_ns=%llu max_ns=%llu total_ns=%llu pct_submit_page_write=%llu.%04llu%% pct_data_submit=%llu.%04llu%%\n",
+		name, metric->count, average, metric->min, metric->max,
+		metric->total, submit_ppm / 10000, submit_ppm % 10000,
+		data_ppm / 10000, data_ppm % 10000);
+}
+
+static u64 f2fs_latency_delta(u64 end, u64 begin)
+{
+	return end >= begin ? end - begin : 0;
+}
+
+static bool f2fs_latency_checkpoint_association_valid(
+		const struct f2fs_latency_record *record, u64 checkpoint_ns)
+{
+	u64 total = record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_NS];
+	u64 maximum = record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_MAX_NS];
+	u64 count = record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_COUNT];
+	u64 errors = record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_ERRORS];
+	u64 execution_begin =
+		record->values[F2FS_LAT_VALUE_CP_EXECUTION_BEGIN_NS];
+	u64 execution_end =
+		record->values[F2FS_LAT_VALUE_CP_EXECUTION_END_NS];
+
+	if (record->flags & (F2FS_FSYNC_LAT_NODE_SUBMIT |
+			     F2FS_FSYNC_LAT_NODE_WAIT))
+		return false;
+	if (!record->values[F2FS_LAT_VALUE_CP_BATCH_ID] || errors > count ||
+	    maximum > total || total > checkpoint_ns)
+		return false;
+	if (record->flags & F2FS_FSYNC_LAT_CP_EXEC_VALID) {
+		if (!execution_begin || execution_end <= execution_begin ||
+		    execution_begin <
+			record->values[F2FS_LAT_VALUE_CHECKPOINT_BEGIN_NS] ||
+		    execution_end >
+			record->values[F2FS_LAT_VALUE_CHECKPOINT_END_NS] ||
+		    total > execution_end - execution_begin)
+			return false;
+	} else if (execution_begin || execution_end || count) {
+		return false;
+	}
+	return count || (!total && !maximum && !errors);
+}
+
+static bool f2fs_latency_collect_submit_detail(
+		struct f2fs_latency_stats *stats,
+		const struct f2fs_latency_record *record, u64 parent_ns,
+		u64 parent_calls)
+{
+	struct f2fs_latency_metric *metrics[] = {
+		&stats->submit_io_rwsem,
+		&stats->submit_zone_pending,
+		&stats->submit_merged_bio,
+	};
+	u64 *call_totals[] = {
+		&stats->submit_io_rwsem_calls,
+		&stats->submit_zone_pending_calls,
+		&stats->submit_merged_bio_calls,
+	};
+	u64 elapsed[F2FS_FSYNC_LAT_DATA_DETAIL_COUNT];
+	u64 calls[F2FS_FSYNC_LAT_DATA_DETAIL_COUNT];
+	u64 sum = 0;
+	unsigned int i;
+
+	BUILD_BUG_ON(ARRAY_SIZE(metrics) !=
+		F2FS_FSYNC_LAT_DATA_DETAIL_COUNT);
+	BUILD_BUG_ON(ARRAY_SIZE(call_totals) !=
+		F2FS_FSYNC_LAT_DATA_DETAIL_COUNT);
+	for (i = 0; i < F2FS_FSYNC_LAT_DATA_DETAIL_COUNT; i++) {
+		elapsed[i] = record->values[
+			f2fs_latency_data_detail_ns_index(i)];
+		calls[i] = record->values[
+			f2fs_latency_data_detail_count_index(i)];
+		if ((elapsed[i] && !calls[i]) || elapsed[i] > parent_ns ||
+		    sum > parent_ns - elapsed[i])
+			goto invalid;
+		sum += elapsed[i];
+	}
+	if (calls[F2FS_FSYNC_LAT_DATA_DETAIL_SUBMIT_IO_RWSEM] != parent_calls)
+		goto invalid;
+
+	stats->submit_detail_valid++;
+	for (i = 0; i < F2FS_FSYNC_LAT_DATA_DETAIL_COUNT; i++) {
+		f2fs_latency_metric_add(metrics[i], elapsed[i]);
+		*call_totals[i] += calls[i];
+	}
+	f2fs_latency_metric_add(&stats->submit_page_other, parent_ns - sum);
+	return true;
+
+invalid:
+	stats->submit_detail_invalid++;
+	return false;
+}
+
+static void f2fs_latency_collect_data_breakdown(
+		struct f2fs_latency_stats *stats,
+		const struct f2fs_latency_record *record, u64 data_submit_ns)
+{
+	struct f2fs_latency_metric *metrics[] = {
+		&stats->data_allocate,
+		&stats->data_submit_page,
+		&stats->data_submit_merged,
+		&stats->data_existing_wb_wait,
+		&stats->data_writepages_mutex_wait,
+		&stats->data_folio_tag_scan,
+		&stats->data_folio_lock_contended,
+		&stats->data_write_single_other,
+		&stats->data_compressed_write_other,
+		&stats->data_io_order_lock_wait,
+		&stats->data_balance_gc,
+		&stats->data_blk_finish_plug,
+		&stats->data_do_write_other,
+		&stats->data_writeback_retry_wait,
+		&stats->data_cached_ipu_submit,
+		&stats->data_write_cache_other,
+		&stats->data_cp_rwsem_trylock,
+	};
+	u64 *call_totals[] = {
+		&stats->data_allocate_calls,
+		&stats->data_submit_page_calls,
+		&stats->data_submit_merged_calls,
+		&stats->data_existing_wb_wait_calls,
+		&stats->data_writepages_mutex_wait_calls,
+		&stats->data_folio_tag_scan_calls,
+		&stats->data_folio_lock_contended_calls,
+		&stats->data_write_single_other_calls,
+		&stats->data_compressed_write_other_calls,
+		&stats->data_io_order_lock_wait_calls,
+		&stats->data_balance_gc_calls,
+		&stats->data_blk_finish_plug_calls,
+		&stats->data_do_write_other_calls,
+		&stats->data_writeback_retry_wait_calls,
+		&stats->data_cached_ipu_submit_calls,
+		&stats->data_write_cache_other_calls,
+		&stats->data_cp_rwsem_trylock_calls,
+	};
+	u64 elapsed[F2FS_FSYNC_LAT_DATA_SUBSTAGE_COUNT];
+	u64 calls[F2FS_FSYNC_LAT_DATA_SUBSTAGE_COUNT];
+	u64 sum = 0;
+	unsigned int i;
+	bool extension_present = false;
+	bool invalid = false;
+
+	BUILD_BUG_ON(ARRAY_SIZE(metrics) !=
+		F2FS_FSYNC_LAT_DATA_SUBSTAGE_COUNT);
+	BUILD_BUG_ON(ARRAY_SIZE(call_totals) !=
+		F2FS_FSYNC_LAT_DATA_SUBSTAGE_COUNT);
+	for (i = 0; i < F2FS_FSYNC_LAT_DATA_SUBSTAGE_COUNT; i++) {
+		elapsed[i] = record->values[
+			f2fs_latency_data_substage_ns_index(i)];
+		calls[i] = record->values[
+			f2fs_latency_data_substage_count_index(i)];
+		if (elapsed[i] || calls[i])
+			extension_present = true;
+	}
+	for (i = 0; i < F2FS_FSYNC_LAT_DATA_DETAIL_COUNT; i++) {
+		if (record->values[f2fs_latency_data_detail_ns_index(i)] ||
+		    record->values[f2fs_latency_data_detail_count_index(i)])
+			extension_present = true;
+	}
+	if (!(record->flags & F2FS_FSYNC_LAT_DATA_BREAKDOWN_VALID)) {
+		if ((record->flags & F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR) ||
+		    extension_present)
+			stats->data_breakdown_invalid++;
+		else
+			stats->data_breakdown_unavailable++;
+		return;
+	}
+	if (record->flags & F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR)
+		invalid = true;
+
+	for (i = 0; i < F2FS_FSYNC_LAT_DATA_SUBSTAGE_COUNT; i++) {
+		if (elapsed[i] && !calls[i])
+			invalid = true;
+		if (elapsed[i] > data_submit_ns ||
+		    sum > data_submit_ns - elapsed[i])
+			invalid = true;
+		else
+			sum += elapsed[i];
+	}
+	if (invalid) {
+		stats->data_breakdown_invalid++;
+		return;
+	}
+	if (!f2fs_latency_collect_submit_detail(stats, record,
+		elapsed[F2FS_FSYNC_LAT_DATA_SUBMIT_PAGE],
+		calls[F2FS_FSYNC_LAT_DATA_SUBMIT_PAGE])) {
+		stats->data_breakdown_invalid++;
+		return;
+	}
+
+	stats->data_breakdown_valid++;
+	f2fs_latency_metric_add(&stats->data_breakdown_total, data_submit_ns);
+	for (i = 0; i < F2FS_FSYNC_LAT_DATA_SUBSTAGE_COUNT; i++) {
+		f2fs_latency_metric_add(metrics[i], elapsed[i]);
+		*call_totals[i] += calls[i];
+	}
+	f2fs_latency_metric_add(&stats->data_other, data_submit_ns - sum);
+}
+
+static void f2fs_latency_collect_fsync(struct f2fs_latency_stats *stats,
+		const struct f2fs_latency_record *record)
+{
+	u64 accounted = 0, total, value;
+	u32 flags = record->flags;
+
+	stats->fsync_records++;
+	if (flags & F2FS_FSYNC_LAT_ERROR)
+		stats->errors++;
+	if (flags & F2FS_FSYNC_LAT_DATASYNC)
+		stats->datasync++;
+	if (flags & F2FS_FSYNC_LAT_CHECKPOINT)
+		stats->checkpoint++;
+	if (flags & F2FS_FSYNC_LAT_NOOP_AFTER_DATA)
+		stats->noop++;
+
+	total = f2fs_latency_delta(record->end_ns, record->start_ns);
+	f2fs_latency_metric_add(&stats->fsync_total, total);
+	if (flags & F2FS_FSYNC_LAT_DATA_WRITEBACK) {
+		value = f2fs_latency_delta(
+			record->values[F2FS_LAT_VALUE_DATA_SUBMIT_END_NS],
+			record->values[F2FS_LAT_VALUE_DATA_SUBMIT_BEGIN_NS]);
+		f2fs_latency_metric_add(&stats->data_submit, value);
+		f2fs_latency_collect_data_breakdown(stats, record, value);
+		accounted += value;
+	} else if (flags & (F2FS_FSYNC_LAT_DATA_BREAKDOWN_VALID |
+			    F2FS_FSYNC_LAT_DATA_BREAKDOWN_ERROR)) {
+		stats->data_breakdown_invalid++;
+	}
+	if (flags & F2FS_FSYNC_LAT_DATA_WAIT) {
+		value = record->values[F2FS_LAT_VALUE_DATA_WAIT_TOTAL_NS];
+		f2fs_latency_metric_add(&stats->data_wait, value);
+		accounted += value;
+	}
+	if (flags & F2FS_FSYNC_LAT_NODE_SUBMIT) {
+		value = record->values[F2FS_LAT_VALUE_NODE_SUBMIT_TOTAL_NS];
+		f2fs_latency_metric_add(&stats->node_submit, value);
+		accounted += value;
+	}
+	if (flags & F2FS_FSYNC_LAT_NODE_WAIT) {
+		value = record->values[F2FS_LAT_VALUE_NODE_WAIT_TOTAL_NS];
+		f2fs_latency_metric_add(&stats->node_wait, value);
+		accounted += value;
+	}
+	if (flags & F2FS_FSYNC_LAT_LOGICAL_FLUSH) {
+		value = f2fs_latency_delta(
+			record->values[F2FS_LAT_VALUE_LOGICAL_FLUSH_END_NS],
+			record->values[F2FS_LAT_VALUE_LOGICAL_FLUSH_BEGIN_NS]);
+		f2fs_latency_metric_add(&stats->logical_flush, value);
+		stats->logical_flushes++;
+		accounted += value;
+	}
+	if (flags & F2FS_FSYNC_LAT_CHECKPOINT) {
+		bool association_valid = false;
+
+		value = f2fs_latency_delta(
+			record->values[F2FS_LAT_VALUE_CHECKPOINT_END_NS],
+			record->values[F2FS_LAT_VALUE_CHECKPOINT_BEGIN_NS]);
+		f2fs_latency_metric_add(&stats->checkpoint_time, value);
+		if (flags & F2FS_FSYNC_LAT_CP_BATCH_ASSOC) {
+			association_valid =
+				f2fs_latency_checkpoint_association_valid(record,
+					value);
+			if (!association_valid)
+				stats->checkpoint_assoc_invalid++;
+		} else {
+			stats->checkpoint_assoc_unavailable++;
+		}
+		if (association_valid) {
+			stats->checkpoint_assoc_records++;
+			stats->checkpoint_assoc_wall_ns += value;
+			stats->checkpoint_batch_flush_ns_per_waiter +=
+				record->values[
+					F2FS_LAT_VALUE_CP_DEVICE_FLUSH_NS];
+			stats->checkpoint_batch_flush_attempts_per_waiter +=
+				record->values[
+					F2FS_LAT_VALUE_CP_DEVICE_FLUSH_COUNT];
+			if (record->values[
+					F2FS_LAT_VALUE_CP_DEVICE_FLUSH_COUNT])
+				stats->checkpoint_batch_flush_records++;
+		}
+		accounted += value;
+	}
+	f2fs_latency_metric_add(&stats->unaccounted,
+				total > accounted ? total - accounted : 0);
+}
+
+static void f2fs_latency_collect_flush(struct f2fs_latency_stats *stats,
+		const struct f2fs_latency_record *record)
+{
+	u64 value = f2fs_latency_delta(record->end_ns, record->start_ns);
+
+	stats->flush_records++;
+	if (record->flags & F2FS_FSYNC_LAT_FLUSH_DEVICE_CACHE) {
+		stats->physical_device_flushes++;
+		f2fs_latency_metric_add(&stats->device_flush, value);
+	} else {
+		stats->physical_fsync_flushes++;
+		f2fs_latency_metric_add(&stats->physical_flush, value);
+	}
+}
+
+static void f2fs_latency_collect_checkpoint_record(
+		struct f2fs_latency_stats *stats,
+		const struct f2fs_latency_record *record)
+{
+	u64 execution_ns = f2fs_latency_delta(record->end_ns,
+		record->start_ns);
+	u64 flush_ns = record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_NS];
+	u64 flush_max_ns =
+		record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_MAX_NS];
+	u64 flush_count =
+		record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_COUNT];
+	u64 flush_errors =
+		record->values[F2FS_LAT_VALUE_CP_DEVICE_FLUSH_ERRORS];
+	bool valid;
+
+	stats->physical_checkpoint_records++;
+	if (record->ret || (record->flags & F2FS_FSYNC_LAT_ERROR))
+		stats->physical_checkpoint_errors++;
+	valid = (record->flags & (F2FS_FSYNC_LAT_CHECKPOINT |
+				  F2FS_FSYNC_LAT_CP_BATCH_ASSOC |
+				  F2FS_FSYNC_LAT_CP_EXEC_VALID)) ==
+		(F2FS_FSYNC_LAT_CHECKPOINT |
+		 F2FS_FSYNC_LAT_CP_BATCH_ASSOC |
+		 F2FS_FSYNC_LAT_CP_EXEC_VALID) &&
+		record->values[F2FS_LAT_VALUE_CP_BATCH_ID] &&
+		record->start_ns && record->end_ns > record->start_ns &&
+		record->values[F2FS_LAT_VALUE_CP_EXECUTION_BEGIN_NS] ==
+			record->start_ns &&
+		record->values[F2FS_LAT_VALUE_CP_EXECUTION_END_NS] ==
+			record->end_ns &&
+		flush_errors <= flush_count && flush_max_ns <= flush_ns &&
+		flush_ns <= execution_ns &&
+		(flush_count || (!flush_ns && !flush_max_ns && !flush_errors));
+	if (!valid) {
+		stats->physical_checkpoint_invalid++;
+		return;
+	}
+	f2fs_latency_metric_add(&stats->physical_checkpoint_execution,
+		execution_ns);
+	f2fs_latency_metric_add(&stats->physical_checkpoint_device_flush,
+		flush_ns);
+	if (flush_count)
+		stats->physical_checkpoint_with_device_flush++;
+}
+
+static void f2fs_latency_collect_balance_cp_waiter(
+		struct f2fs_latency_stats *stats,
+		const struct f2fs_latency_record *record)
+{
+	u64 sync_begin = record->values[F2FS_LAT_VALUE_BALANCE_SYNC_BEGIN_NS];
+	u64 sync_end = record->values[F2FS_LAT_VALUE_BALANCE_SYNC_END_NS];
+	u64 execution_begin = record->values[
+		F2FS_LAT_VALUE_BALANCE_CP_EXECUTION_BEGIN_NS];
+	u64 execution_end = record->values[
+		F2FS_LAT_VALUE_BALANCE_CP_EXECUTION_END_NS];
+	u64 flush_ns = record->values[
+		F2FS_LAT_VALUE_BALANCE_CP_DEVICE_FLUSH_NS];
+	u64 flush_max_ns = record->values[
+		F2FS_LAT_VALUE_BALANCE_CP_DEVICE_FLUSH_MAX_NS];
+	u64 flush_count = record->values[
+		F2FS_LAT_VALUE_BALANCE_CP_DEVICE_FLUSH_COUNT];
+	u64 flush_errors = record->values[
+		F2FS_LAT_VALUE_BALANCE_CP_DEVICE_FLUSH_ERRORS];
+	u64 sync_ns, execution_ns = 0;
+	u32 required_flags = F2FS_FSYNC_LAT_CHECKPOINT |
+		F2FS_FSYNC_LAT_BALANCE_CP_WAITER;
+	u32 allowed_flags = required_flags |
+		F2FS_FSYNC_LAT_CP_BATCH_ASSOC |
+		F2FS_FSYNC_LAT_CP_EXEC_VALID |
+		F2FS_FSYNC_LAT_ERROR |
+		F2FS_FSYNC_LAT_MOUNT_NOBARRIER |
+		F2FS_FSYNC_LAT_FLUSH_MERGE |
+		F2FS_FSYNC_LAT_MULTI_DEVICE |
+		F2FS_FSYNC_LAT_BLKZONED |
+		F2FS_FSYNC_LAT_FSYNC_NOBARRIER;
+	bool execution_valid = record->flags & F2FS_FSYNC_LAT_CP_EXEC_VALID;
+	bool execution_present = execution_begin || execution_end;
+	bool valid;
+
+	stats->balance_cp_waiter_records++;
+	if (record->ret || (record->flags & F2FS_FSYNC_LAT_ERROR))
+		stats->balance_cp_errors++;
+	sync_ns = f2fs_latency_delta(sync_end, sync_begin);
+	valid = (record->flags & required_flags) == required_flags &&
+		!(record->flags & ~allowed_flags) &&
+		!!record->ret == !!(record->flags & F2FS_FSYNC_LAT_ERROR) &&
+		record->values[F2FS_LAT_VALUE_BALANCE_PARENT_SEQ] < record->seq &&
+		record->values[F2FS_LAT_VALUE_BALANCE_CALL_INDEX] &&
+		record->values[F2FS_LAT_VALUE_BALANCE_TRIGGER_KIND] ==
+			F2FS_FSYNC_LAT_BALANCE_TRIGGER_BG_SYNC_FS &&
+		record->start_ns == sync_begin && record->end_ns == sync_end &&
+		sync_begin && sync_end >= sync_begin &&
+		flush_errors <= flush_count && flush_max_ns <= flush_ns &&
+		(flush_count || (!flush_ns && !flush_max_ns && !flush_errors));
+	if (!!(record->flags & F2FS_FSYNC_LAT_CP_BATCH_ASSOC) !=
+	    !!record->values[F2FS_LAT_VALUE_BALANCE_CP_BATCH_ID])
+		valid = false;
+	if (execution_valid != execution_present)
+		valid = false;
+	if (execution_valid) {
+		if (!record->values[F2FS_LAT_VALUE_BALANCE_CP_BATCH_ID] ||
+		    !execution_begin || execution_end <= execution_begin ||
+		    execution_begin < sync_begin || execution_end > sync_end)
+			valid = false;
+		else
+			execution_ns = execution_end - execution_begin;
+		if (flush_ns > execution_ns)
+			valid = false;
+	} else if (execution_begin || execution_end || flush_count || flush_ns ||
+		   flush_max_ns || flush_errors) {
+		valid = false;
+	}
+	if (!valid) {
+		stats->balance_cp_invalid++;
+		return;
+	}
+
+	f2fs_latency_metric_add(&stats->balance_cp_sync_wait, sync_ns);
+	f2fs_latency_metric_add(&stats->balance_cp_execution_per_waiter,
+		execution_ns);
+	f2fs_latency_metric_add(&stats->balance_cp_device_flush_per_waiter,
+		flush_ns);
+	if (!execution_valid)
+		stats->balance_cp_no_execution++;
+}
+
+static int f2fs_latency_stats_show(struct seq_file *m, void *unused)
+{
+	struct f2fs_latency_buffer *buffer = m->private;
+	struct f2fs_latency_stats *stats;
+	u64 flush_bins[ARRAY_SIZE(f2fs_latency_flush_cdf_ns) + 1] = { };
+	u64 records = min_t(u64, atomic64_read(&buffer->next_record),
+				buffer->capacity);
+	u64 cumulative = 0;
+	u64 data_component_total;
+	u64 submit_detail_total;
+	u64 i;
+
+	stats = kzalloc(sizeof(*stats), GFP_KERNEL);
+	if (!stats)
+		return -ENOMEM;
+
+	for (i = 0; i < records; i++) {
+		const struct f2fs_latency_record *record =
+			f2fs_latency_record_at(buffer, i);
+		u64 flush_ns;
+		unsigned int bin;
+
+		/* Pairs with the release-store performed when the record commits. */
+		if (smp_load_acquire(&record->magic) !=
+				F2FS_LATENCY_RECORD_MAGIC) {
+			stats->invalid_records++;
+			continue;
+		}
+
+		f2fs_latency_metric_add(&stats->reserve, record->reserve_ns);
+		f2fs_latency_metric_add(&stats->logger_write, record->write_ns);
+		if (record->type == F2FS_LATENCY_RECORD_FSYNC) {
+			f2fs_latency_collect_fsync(stats, record);
+		} else if (record->type == F2FS_LATENCY_RECORD_FLUSH) {
+			f2fs_latency_collect_flush(stats, record);
+			if (record->flags & F2FS_FSYNC_LAT_FLUSH_DEVICE_CACHE)
+				goto next_record;
+			flush_ns = f2fs_latency_delta(record->end_ns,
+						       record->start_ns);
+			for (bin = 0;
+			     bin < ARRAY_SIZE(f2fs_latency_flush_cdf_ns);
+			     bin++) {
+				if (flush_ns <= f2fs_latency_flush_cdf_ns[bin])
+					break;
+			}
+			flush_bins[bin]++;
+		} else if (record->type == F2FS_LATENCY_RECORD_CHECKPOINT) {
+			f2fs_latency_collect_checkpoint_record(stats, record);
+		} else if (record->type ==
+			   F2FS_LATENCY_RECORD_BALANCE_CP_WAITER) {
+			f2fs_latency_collect_balance_cp_waiter(stats, record);
+		} else {
+			stats->invalid_records++;
+		}
+
+next_record:
+		if (!(i & 0x3fff))
+			cond_resched();
+	}
+
+	seq_printf(m, "session=%llu\n", buffer->session);
+	seq_printf(m, "enabled=%d\n", atomic_read(&f2fs_latency_enabled));
+	seq_printf(m, "complete=%u\n", !buffer->stopped_full);
+	seq_printf(m, "stopped_full=%u\n", buffer->stopped_full);
+	seq_printf(m, "buffer_bytes=%lu\n", buffer->bytes);
+	seq_printf(m, "capacity_records=%llu\n", buffer->capacity);
+	seq_printf(m, "records=%llu\n", records);
+	seq_printf(m, "dropped=%lld\n", atomic64_read(&buffer->dropped));
+	seq_printf(m, "invalid_records=%llu\n", stats->invalid_records);
+	seq_printf(m, "tgid_filter=%u\n", buffer->tgid_filter);
