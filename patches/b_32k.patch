+)
+
+DATA_V3_DETAIL_FIELDS = (
+    ("data_writepages_mutex_wait", VALUE_DATA_WRITEPAGES_MUTEX_WAIT_NS,
+     VALUE_DATA_WRITEPAGES_MUTEX_WAIT_COUNT, "writepages_mutex_wait"),
+    ("data_folio_tag_scan", VALUE_DATA_FOLIO_TAG_SCAN_NS,
+     VALUE_DATA_FOLIO_TAG_SCAN_COUNT, "folio_tag_scan"),
+    ("data_folio_lock_contended_wait", VALUE_DATA_FOLIO_LOCK_CONTENDED_NS,
+     VALUE_DATA_FOLIO_LOCK_CONTENDED_COUNT,
+     "folio_lock_contended_wait"),
+    ("data_write_single_other", VALUE_DATA_WRITE_SINGLE_OTHER_NS,
+     VALUE_DATA_WRITE_SINGLE_OTHER_COUNT, "write_single_other"),
+    ("data_compressed_write_other", VALUE_DATA_COMPRESSED_WRITE_OTHER_NS,
+     VALUE_DATA_COMPRESSED_WRITE_OTHER_COUNT, "compressed_write_other"),
+    ("data_io_order_lock_wait", VALUE_DATA_IO_ORDER_LOCK_WAIT_NS,
+     VALUE_DATA_IO_ORDER_LOCK_WAIT_COUNT, "io_order_lock_wait"),
+    ("data_balance_gc", VALUE_DATA_BALANCE_GC_NS,
+     VALUE_DATA_BALANCE_GC_COUNT, "balance_gc"),
+    ("data_blk_finish_plug", VALUE_DATA_BLK_FINISH_PLUG_NS,
+     VALUE_DATA_BLK_FINISH_PLUG_COUNT, "blk_finish_plug"),
+)
+
+DATA_V4_ADDITIONAL_FIELDS = (
+    ("data_do_write_data_page_other", VALUE_DATA_DO_WRITE_OTHER_NS,
+     VALUE_DATA_DO_WRITE_OTHER_COUNT, "do_write_data_page_other"),
+    ("data_writeback_retry_wait", VALUE_DATA_WRITEBACK_RETRY_WAIT_NS,
+     VALUE_DATA_WRITEBACK_RETRY_WAIT_COUNT, "writeback_retry_wait"),
+    ("data_cached_ipu_submit", VALUE_DATA_CACHED_IPU_SUBMIT_NS,
+     VALUE_DATA_CACHED_IPU_SUBMIT_COUNT, "cached_ipu_submit"),
+    ("data_write_cache_pages_other", VALUE_DATA_WRITE_CACHE_OTHER_NS,
+     VALUE_DATA_WRITE_CACHE_OTHER_COUNT, "write_cache_pages_other"),
+)
+
+DATA_V5_ADDITIONAL_FIELDS = (
+    ("data_cp_rwsem_trylock", VALUE_DATA_CP_RWSEM_TRYLOCK_NS,
+     VALUE_DATA_CP_RWSEM_TRYLOCK_COUNT, "cp_rwsem_trylock"),
+)
+
+DATA_SUBMIT_PAGE_DETAIL_FIELDS = (
+    ("data_submit_page_io_rwsem_acquire", VALUE_DETAIL_SUBMIT_IO_RWSEM_NS,
+     VALUE_DETAIL_SUBMIT_IO_RWSEM_COUNT, "submit_page_io_rwsem_acquire"),
+    ("data_submit_page_zone_pending_wait_bio_put",
+     VALUE_DETAIL_SUBMIT_ZONE_PENDING_NS,
+     VALUE_DETAIL_SUBMIT_ZONE_PENDING_COUNT,
+     "submit_page_zone_pending_wait_bio_put"),
+    ("data_submit_page_merged_bio", VALUE_DETAIL_SUBMIT_MERGED_BIO_NS,
+     VALUE_DETAIL_SUBMIT_MERGED_BIO_COUNT, "submit_page_merged_bio"),
+)
+
+DATA_DETAIL_FIELDS = (
+    DATA_V3_DETAIL_FIELDS
+    + DATA_V4_ADDITIONAL_FIELDS
+    + DATA_V5_ADDITIONAL_FIELDS
+)
+
+# The type=1 checkpoint path is mutually exclusive with node submit/wait, so
+# values[4..8] carry the completion batch result when CP_BATCH_ASSOC is set.
+VALUE_CP_BATCH_ID = VALUE_NODE_SUBMIT_FIRST_BEGIN_NS
+VALUE_CP_DEVICE_FLUSH_NS = VALUE_NODE_SUBMIT_LAST_END_NS
+VALUE_CP_DEVICE_FLUSH_MAX_NS = VALUE_NODE_SUBMIT_TOTAL_NS
+VALUE_CP_DEVICE_FLUSH_COUNT = VALUE_NODE_WAIT_FIRST_BEGIN_NS
+VALUE_CP_DEVICE_FLUSH_ERRORS = VALUE_NODE_WAIT_LAST_END_NS
