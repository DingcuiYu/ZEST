+def nearest_rank(sorted_values: Sequence[int], probability: float) -> int:
+    rank = max(1, int(math.ceil(probability * len(sorted_values))))
+    return int(sorted_values[rank - 1])
+
+
+def summarize_metric(
+    metric: LatencyMetric, sorted_values: Optional[Sequence[int]] = None
+) -> MetricSummary:
+    if sorted_values is None:
+        sorted_values = sorted(metric.samples)
+    count = len(sorted_values)
+    if not count:
+        return MetricSummary(0, None, None, None, None, None, None, None)
+
+    percentiles = {
+        name: nearest_rank(sorted_values, probability)
+        for name, probability in PERCENTILES
+    }
+    return MetricSummary(
+        count=count,
+        mean_ns=metric.total_ns / count,
+        p50_ns=percentiles["p50_ns"],
+        p90_ns=percentiles["p90_ns"],
+        p95_ns=percentiles["p95_ns"],
+        p99_ns=percentiles["p99_ns"],
+        p99_9_ns=percentiles["p99_9_ns"],
+        max_ns=int(sorted_values[-1]),
+    )
+
+
+def write_flush_cdf(
+    output_path: Path,
+    input_path: Path,
+    collector: Collector,
+    summaries: Dict[str, MetricSummary],
+) -> None:
+    if output_path.resolve() == input_path.resolve():
+        raise TraceFormatError("CDF output path must differ from the trace input")
+
+    try:
+        output_path.parent.mkdir(parents=True, exist_ok=True)
+        temporary = output_path.with_name(
+            ".{}.tmp.{}".format(output_path.name, os.getpid())
+        )
+        with temporary.open("w", newline="", encoding="utf-8") as stream:
+            writer = csv.writer(stream)
+            writer.writerow(
+                (
+                    "scope",
+                    "latency_ns",
+                    "latency_us",
+                    "latency_ms",
+                    "count_at_latency",
+                    "cumulative_count",
+                    "total_count",
+                    "cdf",
+                    "cdf_percent",
+                )
+            )
+
+            for scope, metric_name in FLUSH_CDF_SCOPES:
+                metric = collector.metrics[metric_name]
+                ordered = sorted(metric.samples)
+                summaries[metric_name] = summarize_metric(metric, ordered)
+                total = len(ordered)
+                cumulative = 0
+                for latency, group in itertools.groupby(ordered):
+                    count_at_latency = sum(1 for _ in group)
+                    cumulative += count_at_latency
+                    cdf = cumulative / total
+                    writer.writerow(
+                        (
+                            scope,
+                            latency,
+                            "{:.6f}".format(latency / 1_000.0),
+                            "{:.9f}".format(latency / 1_000_000.0),
+                            count_at_latency,
+                            cumulative,
+                            total,
+                            "{:.12f}".format(cdf),
+                            "{:.9f}".format(cdf * 100.0),
+                        )
+                    )
+                metric.release_samples()
+                del ordered
+        os.replace(str(temporary), str(output_path))
+    except OSError as error:
+        try:
+            temporary.unlink()
+        except (OSError, UnboundLocalError):
+            pass
+        raise TraceFormatError(
+            "cannot write flush CDF {}: {}".format(output_path, error)
+        )
+
+
+def build_summaries(
+    collector: Collector,
+    input_path: Path,
+    cdf_path: Path,
+    progress: bool = False,
+) -> Tuple[Dict[str, MetricSummary], MetricSummary, MetricSummary]:
+    summaries = {}  # type: Dict[str, MetricSummary]
+    print_progress(progress, "associate_physical_checkpoints")
+    physical_batches = collect_physical_checkpoint_associations(collector)
+    print_progress(progress, "associate_target_checkpoints")
+    collect_checkpoint_associations(collector, physical_batches)
+    print_progress(progress, "associate_balance_checkpoints")
+    collect_balance_checkpoint_associations(collector, physical_batches)
+    print_progress(progress, "match_fsync_flush_inodes")
+    collect_matched_inode_flushes(collector)
+    print_progress(progress, "write_flush_cdf")
+    write_flush_cdf(cdf_path, input_path, collector, summaries)
+
+    print_progress(progress, "summarize_stage_metrics")
+    for index, name in enumerate(STAGE_NAMES):
+        if name in summaries:
+            continue
+        metric = collector.metrics[name]
+        summaries[name] = summarize_metric(metric)
+        metric.release_samples()
+        if (index + 1) % 10 == 0:
+            print_progress(
+                progress,
+                "summarize_stage_metrics_{}/{}".format(
+                    index + 1, len(STAGE_NAMES)
+                ),
+            )
+
+    print_progress(progress, "summarize_checkpoint_share_metrics")
+    for name in CHECKPOINT_SHARE_METRICS:
+        metric = collector.metrics[name]
+        summaries[name] = summarize_metric(metric)
+        metric.release_samples()
+
+    print_progress(progress, "summarize_logger_overhead")
+    reserve_summary = summarize_metric(collector.reserve)
+    collector.reserve.release_samples()
+    write_summary = summarize_metric(collector.write)
+    collector.write.release_samples()
+    return summaries, reserve_summary, write_summary
+
