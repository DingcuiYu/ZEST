+static struct f2fs_latency_record *
+f2fs_latency_record_at(struct f2fs_latency_buffer *buffer, u64 index)
+{
+	return (struct f2fs_latency_record *)
+		((u8 *)buffer->memory + F2FS_LATENCY_HEADER_SIZE +
+		 index * F2FS_LATENCY_RECORD_SIZE);
