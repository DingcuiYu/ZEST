+
+static void __swap_writepage_traced(struct page *page,
+		struct writeback_control *wbc, struct swap_latency_call *latency);
+static int swap_writechunk_bdev(struct folio *folio,
+		struct writeback_control *wbc, struct swap_info_struct *sis,
+		struct swap_latency_call *latency);
+
+static struct swap_32kchunk_lane *swap_32kchunk_lane(unsigned int type,
+		unsigned long base)
+{
+	unsigned long chunk = base >> SWAP_IO_CHUNK_ORDER;
+
+	return &swap_32kchunk_lanes[(chunk + type) &
+					 (SWAP_32KCHUNK_LANE_NR - 1)];
+}
+
+/* Allocate only per-I/O destinations; no page survives as a chunk cache. */
+static bool swap_32kchunk_alloc_scratch(struct page **pages,
+		int target_index, struct page *target)
+{
+	int i;
+
+	for (i = 0; i < SWAP_IO_CHUNK_PAGES; i++) {
+		if (i == target_index) {
+			pages[i] = target;
+			continue;
+		}
