+	f2fs_latency_breakdown_metric_show(m, "data_submit_other",
+		&stats->data_other, stats->data_breakdown_total.total);
+	seq_printf(m,
+		"calls allocate=%llu submit_page=%llu submit_merged=%llu existing_writeback_wait=%llu writepages_mutex=%llu folio_tag_scan=%llu folio_lock_contended=%llu write_single_other=%llu compressed_write_other=%llu io_order_lock=%llu balance_gc=%llu blk_finish_plug=%llu do_write_other=%llu writeback_retry_wait=%llu cached_ipu_submit=%llu write_cache_other=%llu cp_rwsem_trylock=%llu\n",
+		stats->data_allocate_calls, stats->data_submit_page_calls,
+		stats->data_submit_merged_calls,
+		stats->data_existing_wb_wait_calls,
+		stats->data_writepages_mutex_wait_calls,
+		stats->data_folio_tag_scan_calls,
+		stats->data_folio_lock_contended_calls,
+		stats->data_write_single_other_calls,
+		stats->data_compressed_write_other_calls,
+		stats->data_io_order_lock_wait_calls,
+		stats->data_balance_gc_calls,
+		stats->data_blk_finish_plug_calls,
+		stats->data_do_write_other_calls,
+		stats->data_writeback_retry_wait_calls,
+		stats->data_cached_ipu_submit_calls,
+		stats->data_write_cache_other_calls,
+		stats->data_cp_rwsem_trylock_calls);
+
+	submit_detail_total = stats->submit_io_rwsem.total +
+		stats->submit_zone_pending.total +
+		stats->submit_merged_bio.total + stats->submit_page_other.total;
+	seq_puts(m,
+		"\n# submit_page_write hierarchical detail; rows are children of submit_page_write and are not top-level additive leaves\n");
