+int main(int argc, char **argv)
+{
+	Options options;
+	bool show_help;
+	std::string error;
+	std::vector<std::string> database_paths;
+	std::vector<WorkerResult> results;
+	std::vector<std::thread> workers;
+	std::vector<uint64_t> transaction_samples;
+	std::vector<uint64_t> commit_samples;
+	std::string trace_stats;
+	uint64_t trace_log_bytes = 0;
+	uint64_t benchmark_begin_ns = 0;
+	uint64_t transactions_end_ns = 0;
+	uint64_t benchmark_end_ns = 0;
+	uint64_t final_checkpoint_ns = 0;
+	CheckpointStats final_checkpoint_stats;
+	TraceIntegrity trace_integrity;
+	bool trace_stop_ok = true;
+	bool trace_dump_ok = true;
+	bool trace_integrity_ok = true;
+	bool workload_ok = true;
+	bool final_checkpoint_ok = true;
+
+	if (!ParseArguments(argc, argv, &options, &show_help, &error)) {
+		std::fprintf(stderr, "%s\n\n", error.c_str());
+		PrintUsage(argv[0]);
+		return 2;
+	}
+	if (show_help) {
+		PrintUsage(argv[0]);
+		return 0;
+	}
+	if (!ValidateOptions(options, &error)) {
+		std::fprintf(stderr, "%s\n", error.c_str());
+		return 2;
+	}
+	if (options.threads > 1 && sqlite3_threadsafe() == 0) {
+		std::fprintf(stderr,
+			"--threads > 1 requires a threadsafe SQLite build\n");
+		return 2;
+	}
+	if (!MakeDirectory(options.db_dir, &error)) {
+		std::fprintf(stderr, "%s\n", error.c_str());
+		return 1;
+	}
+	if (!ValidateSeedSpace(options, options.db_dir, &error)) {
+		std::fprintf(stderr, "%s\n", error.c_str());
+		return 1;
+	}
+	if (options.trace &&
+		!MakeDirectory(ParentDirectory(options.output_log), &error)) {
+		std::fprintf(stderr, "%s\n", error.c_str());
+		return 1;
+	}
+
+	std::printf("sqlite_library libversion=%s sourceid=\"%s\" threadsafe=%d\n",
+		sqlite3_libversion(), sqlite3_sourceid(), sqlite3_threadsafe());
+	database_paths = BuildDatabasePaths(options);
+	for (size_t i = 0; i < database_paths.size(); ++i) {
+		const std::string &path = database_paths[i];
+
+		if (!PrepareDatabase(path, options,
+				DatabaseSeedRows(options, static_cast<uint32_t>(i)), &error)) {
+			std::fprintf(stderr, "database preparation failed: %s\n",
+				error.c_str());
+			return 1;
+		}
+	}
+	if (!PrintDatabaseConfiguration(database_paths[0], options, &error)) {
+		std::fprintf(stderr, "read effective SQLite configuration: %s\n",
+			error.c_str());
+		return 1;
+	}
+
+	std::printf(
+		"configuration db_mode=%s operation=%s journal_mode=%s synchronous=%s "
+		"threads=%u transactions_total=%" PRIu64
+		" transactions_worker_min=%" PRIu64 " transactions_worker_max=%" PRIu64
+		" warmup_per_thread=%" PRIu64 " tables=%u"
+		" operations_per_table=%" PRIu64 " sql_operations_per_txn=%" PRIu64
+		" payload_bytes=%" PRIu64 " working_set=%" PRIu64 " key_order=%s"
+		" wal_autocheckpoint=%u busy_timeout_ms=%u trace=%s trace_filter=%s\n",
+		DatabaseModeName(options.database_mode),
+		OperationName(options.operation),
+		JournalModeName(options.journal_mode),
+		SynchronousModeName(options.synchronous), options.threads,
+		options.transactions, options.transactions / options.threads,
+		options.transactions / options.threads +
+			(options.transactions % options.threads != 0 ? 1 : 0),
+		options.warmup, options.tables,
+		options.operations_per_table,
+		static_cast<uint64_t>(options.tables) * options.operations_per_table,
+		options.payload_bytes, options.working_set,
+		options.random_key ? "random-permutation" : "sequential",
+		options.wal_autocheckpoint, options.busy_timeout_ms,
+		options.trace ? "on" : "off",
+		options.trace_filter_miss ? "miss" : "hit");
+	std::fflush(stdout);
+
+	WorkloadPhases phases(options.threads);
+	TraceController trace(options);
+	results.resize(options.threads);
+	workers.reserve(options.threads);
+	try {
+		for (uint32_t i = 0; i < options.threads; ++i) {
+			const std::string &path =
+				options.database_mode == DatabaseMode::kShared ?
+				database_paths[0] : database_paths[i];
+
+			workers.emplace_back(WorkerMain, i, std::cref(path),
+				std::cref(options), &phases, &results[i]);
+		}
+	} catch (const std::exception &exception) {
+		error = std::string("create worker thread: ") + exception.what();
+		phases.CancelAll();
+		for (std::thread &worker : workers)
+			worker.join();
+		std::fprintf(stderr, "%s\n", error.c_str());
+		PrintWorkerErrors(results);
+		return 1;
+	}
+
+	if (!phases.start_barrier.WaitForWorkers()) {
+		for (std::thread &worker : workers)
+			worker.join();
+		std::fprintf(stderr, "worker preparation or warmup failed\n");
+		PrintWorkerErrors(results);
+		return 1;
+	}
+
+	/*
+	 * Workers are idle at start_barrier here.  Checkpointing after every
+	 * warmup keeps all preparation I/O outside the trace window.
+	 */
+	for (const std::string &path : database_paths) {
+		CheckpointStats ignored;
+
+		if (!CheckpointDatabase(path, options, "TRUNCATE", &ignored,
+				&error)) {
+			phases.CancelAll();
+			for (std::thread &worker : workers)
+				worker.join();
+			std::fprintf(stderr, "pre-trace checkpoint failed: %s\n",
+				error.c_str());
+			PrintWorkerErrors(results);
+			return 1;
+		}
+	}
+
+	if (options.trace && !trace.Start(&error)) {
+		phases.CancelAll();
+		for (std::thread &worker : workers)
+			worker.join();
+		std::fprintf(stderr,
+			"trace start failed (root/debugfs permissions may be required): %s\n",
+			error.c_str());
+		return 1;
+	}
+
+	benchmark_begin_ns = MonotonicNowNs();
+	phases.start_barrier.ReleaseWorkers();
+	(void)phases.transactions_done_barrier.ArriveAndWait();
+	transactions_end_ns = MonotonicNowNs();
+	uint64_t checkpoint_begin_ns = MonotonicNowNs();
+	(void)phases.checkpoint_start_barrier.ArriveAndWait();
+	(void)phases.checkpoint_done_barrier.ArriveAndWait();
+	benchmark_end_ns = MonotonicNowNs();
+	if (options.journal_mode == JournalMode::kWal)
+		final_checkpoint_ns = benchmark_end_ns - checkpoint_begin_ns;
+
+	if (options.trace && !trace.Stop(&error)) {
+		trace_stop_ok = false;
+		trace_integrity_ok = false;
+		std::fprintf(stderr, "trace stop failed: %s\n", error.c_str());
+		std::fprintf(stderr,
+			"trace_validation status=INVALID reason=trace_stop_failed\n");
+	}
+	/* Workers cannot finalize/close SQLite until the stop write returned. */
+	(void)phases.release_barrier.ArriveAndWait();
+	for (std::thread &worker : workers)
+		worker.join();
+
+	uint64_t completed = 0;
+	for (const WorkerResult &result : results) {
+		completed += result.completed;
+		if (!result.error.empty())
+			workload_ok = false;
+		if (!result.checkpoint_ok || !result.checkpoint_error.empty())
+			final_checkpoint_ok = false;
+		final_checkpoint_stats.log_frames +=
+			result.checkpoint_stats.log_frames;
+		final_checkpoint_stats.checkpointed_frames +=
+			result.checkpoint_stats.checkpointed_frames;
+	}
+	transaction_samples.reserve(static_cast<size_t>(completed));
+	commit_samples.reserve(static_cast<size_t>(completed));
+	for (const WorkerResult &result : results) {
+		transaction_samples.insert(transaction_samples.end(),
+			result.transaction_samples.begin(),
+			result.transaction_samples.begin() +
+				static_cast<size_t>(result.completed));
+		commit_samples.insert(commit_samples.end(),
+			result.commit_samples.begin(),
+			result.commit_samples.begin() +
+				static_cast<size_t>(result.completed));
+	}
+
+	uint64_t transactions_elapsed_ns =
+		transactions_end_ns - benchmark_begin_ns;
+	uint64_t checkpoint_inclusive_ns = benchmark_end_ns - benchmark_begin_ns;
+	long double transaction_tps = transactions_elapsed_ns == 0 ? 0.0L :
+		static_cast<long double>(completed) * 1000000000.0L /
+		static_cast<long double>(transactions_elapsed_ns);
+	long double checkpoint_inclusive_tps = checkpoint_inclusive_ns == 0 ?
+		0.0L : static_cast<long double>(completed) * 1000000000.0L /
+		static_cast<long double>(checkpoint_inclusive_ns);
+	uint64_t operations_per_transaction =
+		static_cast<uint64_t>(options.tables) * options.operations_per_table;
+	long double operations_per_second = transaction_tps *
+		static_cast<long double>(operations_per_transaction);
+	std::printf(
+		"benchmark_clock clock=CLOCK_MONOTONIC benchmark_begin_ns=%" PRIu64
+		" transactions_end_ns=%" PRIu64 " final_end_ns=%" PRIu64 "\n",
+		benchmark_begin_ns, transactions_end_ns, benchmark_end_ns);
+	std::printf(
+		"workload requested=%" PRIu64 " completed=%" PRIu64
+		" transaction_window_ns=%" PRIu64
+		" userspace_tps=%.3Lf sql_operations_per_sec=%.3Lf\n",
+		options.transactions, completed, transactions_elapsed_ns,
+		transaction_tps, operations_per_second);
+	std::printf(
+		"final_checkpoint mode=%s final_checkpoint_ns=%" PRIu64
+		" log_frames=%" PRIu64 " checkpointed_frames=%" PRIu64
+		" checkpoint_inclusive_window_ns=%" PRIu64
+		" checkpoint_inclusive_tps=%.3Lf\n",
+		options.journal_mode == JournalMode::kWal ? "PASSIVE" : "none",
+		final_checkpoint_ns, final_checkpoint_stats.log_frames,
+		final_checkpoint_stats.checkpointed_frames, checkpoint_inclusive_ns,
+		checkpoint_inclusive_tps);
+	PrintLatencySummary("transaction_latency", &transaction_samples);
+	PrintLatencySummary("commit_latency", &commit_samples);
+	PrintWorkerErrors(results);
+
+	if (options.trace && trace_stop_ok) {
+		if (!trace.Dump(&trace_stats, &trace_log_bytes, &error)) {
+			trace_dump_ok = false;
+			trace_integrity_ok = false;
+			std::fprintf(stderr, "trace dump failed: %s\n", error.c_str());
+			std::fprintf(stderr,
+				"trace_validation status=INVALID reason=trace_dump_failed\n");
+		} else {
+			std::string integrity_error;
+
+			trace_integrity_ok = ValidateTraceIntegrity(trace_stats,
+				&trace_integrity, &integrity_error);
+			if (trace_integrity_ok) {
+				std::printf(
+					"trace_validation status=VALID complete=%" PRIu64
+					" stopped_full=%" PRIu64 " dropped=%" PRIu64
+					" invalid_records=%" PRIu64 "\n",
+					trace_integrity.complete, trace_integrity.stopped_full,
+					trace_integrity.dropped,
+					trace_integrity.invalid_records);
+			} else {
+				std::fprintf(stderr,
+					"trace_validation status=INVALID complete=%" PRIu64
+					" stopped_full=%" PRIu64 " dropped=%" PRIu64
+					" invalid_records=%" PRIu64 " reason=%s\n",
+					trace_integrity.complete, trace_integrity.stopped_full,
+					trace_integrity.dropped,
+					trace_integrity.invalid_records,
+					integrity_error.c_str());
+			}
+			std::printf("trace_log path=%s bytes=%" PRIu64 "\n",
+				options.output_log.c_str(), trace_log_bytes);
+			std::printf("trace_stats path=%s.stats\n",
+				options.output_log.c_str());
+			std::printf("\n# kernel trace statistics\n");
+			std::fwrite(trace_stats.data(), 1, trace_stats.size(), stdout);
+			if (trace_stats.empty() || trace_stats.back() != '\n')
+				std::putchar('\n');
+		}
+	}
+
+	return workload_ok && final_checkpoint_ok && trace_stop_ok &&
+		trace_dump_ok && trace_integrity_ok ? 0 : 1;
+}
