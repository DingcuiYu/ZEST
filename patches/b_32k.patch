+VALUE_BALANCE_TRIGGER_KIND = 14
+
+BALANCE_TRIGGER_F2FS_BALANCE = 1
+
+
+FSYNC_MODE_NAMES = {
+    0: "posix",
+    1: "strict",
+    2: "nobarrier",
+}
+
+CP_NO_NEEDED = 0
+CP_REASON_NAMES = {
+    CP_NO_NEEDED: "CP_NO_NEEDED",
+    1: "CP_NON_REGULAR",
+    2: "CP_COMPRESSED",
+    3: "CP_HARDLINK",
+    4: "CP_SB_NEED_CP",
+    5: "CP_WRONG_PINO",
+    6: "CP_NO_SPC_ROLL",
