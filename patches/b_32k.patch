+HEADER_STRUCT = struct.Struct("<8s4I9Q4I64s80s")
+
+RECORD_PREFIX = (
+    "<IHHII"
+    "6Q"
+    "Qqq"
+    "Ii"
+    "6I"
+    "16s"
+)
+RECORD_STRUCT_V1 = struct.Struct(RECORD_PREFIX + "15Q")
+RECORD_STRUCT_V2 = struct.Struct(RECORD_PREFIX + "23Q")
+RECORD_STRUCT_V3 = struct.Struct(RECORD_PREFIX + "39Q")
+RECORD_STRUCT_V4 = struct.Struct(RECORD_PREFIX + "47Q")
+RECORD_STRUCT_V5 = struct.Struct(RECORD_PREFIX + "55Q")
+RECORD_STRUCT_V6 = struct.Struct(RECORD_PREFIX + "55Q")
+FORMAT_LAYOUTS = {
+    1: (256, 15, RECORD_STRUCT_V1),
+    2: (320, 23, RECORD_STRUCT_V2),
+    3: (448, 39, RECORD_STRUCT_V3),
+    4: (512, 47, RECORD_STRUCT_V4),
+    5: (576, 55, RECORD_STRUCT_V5),
+    6: (576, 55, RECORD_STRUCT_V6),
+}
+
+assert HEADER_STRUCT.size == HEADER_SIZE
+assert RECORD_STRUCT_V1.size == 256
+assert RECORD_STRUCT_V2.size == 320
+assert RECORD_STRUCT_V3.size == 448
+assert RECORD_STRUCT_V4.size == 512
