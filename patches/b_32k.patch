+
+	data_component_total = stats->data_allocate.total +
+		stats->data_submit_page.total + stats->data_submit_merged.total +
+		stats->data_existing_wb_wait.total +
+		stats->data_writepages_mutex_wait.total +
+		stats->data_folio_tag_scan.total +
+		stats->data_folio_lock_contended.total +
+		stats->data_write_single_other.total +
+		stats->data_compressed_write_other.total +
+		stats->data_io_order_lock_wait.total +
