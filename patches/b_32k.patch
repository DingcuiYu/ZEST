diff --git a/fs/f2fs/fsync_latency_trace.c b/fs/f2fs/fsync_latency_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..65db48c165f117ad0f141a75bbed893b7c0d5011
--- /dev/null
+++ b/fs/f2fs/fsync_latency_trace.c
@@ -0,0 +1,2897 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Low-overhead F2FS fsync latency tracing.
+ *
+ * One fixed-size binary record is reserved at fsync entry. Stage timestamps
+ * are written into that private slot, so only the initial atomic reservation
+ * is shared between writers. Explicit device flushes use separate records.
+ */
+
+#include <linux/atomic.h>
+#include <linux/blkdev.h>
+#include <linux/build_bug.h>
+#include <linux/debugfs.h>
+#include <linux/f2fs_fs.h>
+#include <linux/fs.h>
+#include <linux/gfp.h>
+#include <linux/hash.h>
+#include <linux/kdev_t.h>
+#include <linux/ktime.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/overflow.h>
+#include <linux/pagemap.h>
+#include <linux/rcupdate.h>
+#include <linux/sched.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/utsname.h>
+#include <linux/vmalloc.h>
+#include <linux/wait.h>
+#include <linux/writeback.h>
+
+#include "f2fs.h"
+#include "fsync_latency_trace.h"
+
+#define F2FS_LATENCY_DIR_NAME		"f2fs_fsync_latency"
+#define F2FS_LATENCY_DEFAULT_MB		2048U
+#define F2FS_LATENCY_MIN_MB		1U
+#define F2FS_LATENCY_MAX_MB		32768U
+#define F2FS_LATENCY_FORMAT_VERSION	6U
+#define F2FS_LATENCY_HEADER_SIZE		256U
+#define F2FS_LATENCY_RECORD_SIZE		576U
+#define F2FS_LATENCY_RECORD_MAGIC	0x524c3246U /* "F2LR" */
+#define F2FS_LATENCY_ENDIAN_MARKER	0x01020304U
+#define F2FS_LATENCY_COMM_LEN		16U
+#define F2FS_LATENCY_DATA_SCOPE_BITS	6U
+#define F2FS_LATENCY_DATA_SCOPE_COUNT	(1U << F2FS_LATENCY_DATA_SCOPE_BITS)
+
+enum f2fs_latency_record_type {
+	F2FS_LATENCY_RECORD_FSYNC = 1,
+	F2FS_LATENCY_RECORD_FLUSH = 2,
+	F2FS_LATENCY_RECORD_CHECKPOINT = 3,
+	F2FS_LATENCY_RECORD_BALANCE_CP_WAITER = 4,
+};
+
+enum f2fs_latency_value_index {
+	F2FS_LAT_VALUE_SETUP_NS,
+	F2FS_LAT_VALUE_DATA_SUBMIT_BEGIN_NS,
+	F2FS_LAT_VALUE_DATA_SUBMIT_END_NS,
+	F2FS_LAT_VALUE_DATA_WAIT_TOTAL_NS,
+	F2FS_LAT_VALUE_NODE_SUBMIT_FIRST_BEGIN_NS,
+	F2FS_LAT_VALUE_NODE_SUBMIT_LAST_END_NS,
+	F2FS_LAT_VALUE_NODE_SUBMIT_TOTAL_NS,
+	F2FS_LAT_VALUE_NODE_WAIT_FIRST_BEGIN_NS,
+	F2FS_LAT_VALUE_NODE_WAIT_LAST_END_NS,
+	F2FS_LAT_VALUE_NODE_WAIT_TOTAL_NS,
+	F2FS_LAT_VALUE_LOGICAL_FLUSH_BEGIN_NS,
+	F2FS_LAT_VALUE_LOGICAL_FLUSH_END_NS,
+	F2FS_LAT_VALUE_CHECKPOINT_BEGIN_NS,
+	F2FS_LAT_VALUE_CHECKPOINT_END_NS,
+	F2FS_LAT_VALUE_AUX,
+	F2FS_LAT_VALUE_DATA_ALLOCATE_NS,
+	F2FS_LAT_VALUE_DATA_SUBMIT_PAGE_NS,
+	F2FS_LAT_VALUE_DATA_SUBMIT_MERGED_NS,
+	F2FS_LAT_VALUE_DATA_EXISTING_WB_WAIT_NS,
+	F2FS_LAT_VALUE_DATA_ALLOCATE_COUNT,
+	F2FS_LAT_VALUE_DATA_SUBMIT_PAGE_COUNT,
+	F2FS_LAT_VALUE_DATA_SUBMIT_MERGED_COUNT,
+	F2FS_LAT_VALUE_DATA_EXISTING_WB_WAIT_COUNT,
+	F2FS_LAT_VALUE_DATA_WRITEPAGES_MUTEX_WAIT_NS,
+	F2FS_LAT_VALUE_DATA_WRITEPAGES_MUTEX_WAIT_COUNT,
+	F2FS_LAT_VALUE_DATA_FOLIO_TAG_SCAN_NS,
+	F2FS_LAT_VALUE_DATA_FOLIO_TAG_SCAN_COUNT,
+	F2FS_LAT_VALUE_DATA_FOLIO_LOCK_CONTENDED_NS,
+	F2FS_LAT_VALUE_DATA_FOLIO_LOCK_CONTENDED_COUNT,
+	F2FS_LAT_VALUE_DATA_WRITE_SINGLE_OTHER_NS,
+	F2FS_LAT_VALUE_DATA_WRITE_SINGLE_OTHER_COUNT,
+	F2FS_LAT_VALUE_DATA_COMPRESSED_WRITE_OTHER_NS,
+	F2FS_LAT_VALUE_DATA_COMPRESSED_WRITE_OTHER_COUNT,
+	F2FS_LAT_VALUE_DATA_IO_ORDER_LOCK_WAIT_NS,
+	F2FS_LAT_VALUE_DATA_IO_ORDER_LOCK_WAIT_COUNT,
+	F2FS_LAT_VALUE_DATA_BALANCE_GC_NS,
+	F2FS_LAT_VALUE_DATA_BALANCE_GC_COUNT,
+	F2FS_LAT_VALUE_DATA_BLK_FINISH_PLUG_NS,
+	F2FS_LAT_VALUE_DATA_BLK_FINISH_PLUG_COUNT,
+	F2FS_LAT_VALUE_DATA_DO_WRITE_OTHER_NS,
+	F2FS_LAT_VALUE_DATA_DO_WRITE_OTHER_COUNT,
+	F2FS_LAT_VALUE_DATA_WRITEBACK_RETRY_WAIT_NS,
+	F2FS_LAT_VALUE_DATA_WRITEBACK_RETRY_WAIT_COUNT,
+	F2FS_LAT_VALUE_DATA_CACHED_IPU_SUBMIT_NS,
+	F2FS_LAT_VALUE_DATA_CACHED_IPU_SUBMIT_COUNT,
+	F2FS_LAT_VALUE_DATA_WRITE_CACHE_OTHER_NS,
+	F2FS_LAT_VALUE_DATA_WRITE_CACHE_OTHER_COUNT,
+	F2FS_LAT_VALUE_DATA_CP_RWSEM_TRYLOCK_NS,
+	F2FS_LAT_VALUE_DATA_CP_RWSEM_TRYLOCK_COUNT,
+	F2FS_LAT_VALUE_DETAIL_SUBMIT_IO_RWSEM_NS,
+	F2FS_LAT_VALUE_DETAIL_SUBMIT_IO_RWSEM_COUNT,
+	F2FS_LAT_VALUE_DETAIL_SUBMIT_ZONE_PENDING_NS,
+	F2FS_LAT_VALUE_DETAIL_SUBMIT_ZONE_PENDING_COUNT,
+	F2FS_LAT_VALUE_DETAIL_SUBMIT_MERGED_BIO_NS,
+	F2FS_LAT_VALUE_DETAIL_SUBMIT_MERGED_BIO_COUNT,
+	F2FS_LAT_VALUE_COUNT,
+};
+
+#define F2FS_LAT_DATA_V2_STAGE_COUNT	4U
+
+static unsigned int f2fs_latency_data_substage_ns_index(
+		enum f2fs_fsync_latency_data_substage stage)
+{
+	if (stage < F2FS_LAT_DATA_V2_STAGE_COUNT)
+		return F2FS_LAT_VALUE_DATA_ALLOCATE_NS + stage;
+	return F2FS_LAT_VALUE_DATA_WRITEPAGES_MUTEX_WAIT_NS +
+		2 * (stage - F2FS_LAT_DATA_V2_STAGE_COUNT);
+}
+
+static unsigned int f2fs_latency_data_substage_count_index(
+		enum f2fs_fsync_latency_data_substage stage)
+{
+	if (stage < F2FS_LAT_DATA_V2_STAGE_COUNT)
+		return F2FS_LAT_VALUE_DATA_ALLOCATE_COUNT + stage;
+	return F2FS_LAT_VALUE_DATA_WRITEPAGES_MUTEX_WAIT_COUNT +
+		2 * (stage - F2FS_LAT_DATA_V2_STAGE_COUNT);
+}
+
+static unsigned int f2fs_latency_data_detail_ns_index(
+		enum f2fs_fsync_latency_data_detail detail)
+{
+	return F2FS_LAT_VALUE_DETAIL_SUBMIT_IO_RWSEM_NS + 2 * detail;
+}
+
+static unsigned int f2fs_latency_data_detail_count_index(
+		enum f2fs_fsync_latency_data_detail detail)
+{
+	return F2FS_LAT_VALUE_DETAIL_SUBMIT_IO_RWSEM_COUNT + 2 * detail;
+}
+
+/* The node fields are unused when a type=1 record takes the checkpoint path. */
+#define F2FS_LAT_VALUE_CP_BATCH_ID \
+	F2FS_LAT_VALUE_NODE_SUBMIT_FIRST_BEGIN_NS
+#define F2FS_LAT_VALUE_CP_DEVICE_FLUSH_NS \
+	F2FS_LAT_VALUE_NODE_SUBMIT_LAST_END_NS
+#define F2FS_LAT_VALUE_CP_DEVICE_FLUSH_MAX_NS \
+	F2FS_LAT_VALUE_NODE_SUBMIT_TOTAL_NS
+#define F2FS_LAT_VALUE_CP_DEVICE_FLUSH_COUNT \
+	F2FS_LAT_VALUE_NODE_WAIT_FIRST_BEGIN_NS
+#define F2FS_LAT_VALUE_CP_DEVICE_FLUSH_ERRORS \
+	F2FS_LAT_VALUE_NODE_WAIT_LAST_END_NS
+#define F2FS_LAT_VALUE_CP_EXECUTION_BEGIN_NS \
+	F2FS_LAT_VALUE_NODE_WAIT_TOTAL_NS
+#define F2FS_LAT_VALUE_CP_EXECUTION_END_NS \
+	F2FS_LAT_VALUE_LOGICAL_FLUSH_BEGIN_NS
+
+/* Type=2 records otherwise use only SETUP_NS and AUX. */
+#define F2FS_LAT_VALUE_FLUSH_CP_BATCH_ID \
+	F2FS_LAT_VALUE_NODE_SUBMIT_FIRST_BEGIN_NS
+#define F2FS_LAT_VALUE_FLUSH_MOUNT_DEV \
+	F2FS_LAT_VALUE_NODE_SUBMIT_LAST_END_NS
+
+/* Type=4 sparse target balance-checkpoint waiter records. */
+#define F2FS_LAT_VALUE_BALANCE_PARENT_SEQ \
+	F2FS_LAT_VALUE_SETUP_NS
+#define F2FS_LAT_VALUE_BALANCE_SYNC_BEGIN_NS \
+	F2FS_LAT_VALUE_DATA_SUBMIT_BEGIN_NS
+#define F2FS_LAT_VALUE_BALANCE_SYNC_END_NS \
+	F2FS_LAT_VALUE_DATA_SUBMIT_END_NS
+#define F2FS_LAT_VALUE_BALANCE_CP_BATCH_ID \
+	F2FS_LAT_VALUE_DATA_WAIT_TOTAL_NS
+#define F2FS_LAT_VALUE_BALANCE_CP_EXECUTION_BEGIN_NS \
+	F2FS_LAT_VALUE_NODE_SUBMIT_FIRST_BEGIN_NS
+#define F2FS_LAT_VALUE_BALANCE_CP_EXECUTION_END_NS \
+	F2FS_LAT_VALUE_NODE_SUBMIT_LAST_END_NS
