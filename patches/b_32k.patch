+			"time_weighted_completion_batch_source1_flush_attribution=-\n");
+	}
+	seq_puts(m,
+		"# Exact bounded same-mount checkpoint-wall overlap share requires analyze_trace.py.\n");
+
+	seq_puts(m,
+		"\n# target balance_fs -> balance_fs_bg(false) -> sync_fs checkpoint waiters\n");
+	seq_puts(m,
+		"# Per-waiter execution and source=1 totals repeat a merged physical batch for every selected target waiter; deduplicate by batch ID offline for physical cost.\n");
+	f2fs_latency_metric_show(m, "balance_sync_wait",
+		&stats->balance_cp_sync_wait);
+	f2fs_latency_metric_show(m, "balance_checkpoint_execution_per_waiter",
+		&stats->balance_cp_execution_per_waiter);
+	f2fs_latency_metric_show(m, "balance_source1_flush_per_waiter",
+		&stats->balance_cp_device_flush_per_waiter);
+	if (stats->balance_cp_sync_wait.total) {
+		u64 execution_ppm = mul_u64_u64_div_u64(
+			stats->balance_cp_execution_per_waiter.total, 1000000ULL,
+			stats->balance_cp_sync_wait.total);
+		u64 flush_ppm = mul_u64_u64_div_u64(
+			stats->balance_cp_device_flush_per_waiter.total, 1000000ULL,
+			stats->balance_cp_sync_wait.total);
+
+		seq_printf(m,
+			"time_weighted_waiter_execution_share_of_sync_wait=%llu.%04llu%%\n",
+			execution_ppm / 10000, execution_ppm % 10000);
+		seq_printf(m,
+			"time_weighted_waiter_source1_share_of_sync_wait=%llu.%04llu%%\n",
+			flush_ppm / 10000, flush_ppm % 10000);
+	} else {
+		seq_puts(m,
+			"time_weighted_waiter_execution_share_of_sync_wait=-\n");
+		seq_puts(m,
+			"time_weighted_waiter_source1_share_of_sync_wait=-\n");
+	}
+	seq_puts(m,
+		"# sync wait is synchronous for the caller even when checkpoint_merge delegates execution to the checkpoint kthread.\n");
+
+	seq_puts(m,
+		"\n# global unique physical checkpoint source=1 device-cache share\n");
+	seq_puts(m,
+		"# Numerator is secondary-device f2fs_flush_device_cache() attempts only; primary PREFLUSH/FUA is excluded.\n");
+	seq_puts(m,
+		"# checkpoint_device_flush includes a zero sample for each valid batch without a source=1 attempt.\n");
+	f2fs_latency_metric_show(m, "checkpoint_execution",
+		&stats->physical_checkpoint_execution);
+	f2fs_latency_metric_show(m, "checkpoint_device_flush",
+		&stats->physical_checkpoint_device_flush);
+	seq_printf(m, "batches_with_device_flush=%llu\n",
+		stats->physical_checkpoint_with_device_flush);
+	if (stats->physical_checkpoint_execution.total) {
+		u64 ppm = mul_u64_u64_div_u64(
+			stats->physical_checkpoint_device_flush.total,
+			1000000ULL, stats->physical_checkpoint_execution.total);
+
+		seq_printf(m,
+			"time_weighted_physical_checkpoint_device_flush_share=%llu.%04llu%%\n",
+			ppm / 10000, ppm % 10000);
+	} else {
+		seq_puts(m,
+			"time_weighted_physical_checkpoint_device_flush_share=-\n");
+	}
+	seq_puts(m,
+		"# Denominator excludes checkpoint queue, gc_lock, cp_global_sem wait, and no-op dispatches.\n");
+	seq_puts(m,
+		"# Flush retry sleep is inside the denominator but outside the source=1 numerator.\n");
+
+	seq_puts(m, "\n# logger overhead; reserve_ns covers only the shared slot atomic\n");
+	f2fs_latency_metric_show(m, "slot_reserve", &stats->reserve);
+	f2fs_latency_metric_show(m, "trace_setup_finalize", &stats->logger_write);
+	seq_puts(m,
+		"# write_ns includes active-get/reserve/init/finalize; it excludes active-put and all stage hooks, including per-call data substages.\n");
+
+	seq_puts(m,
+		"\n# source=0 explicit fsync physical flush latency CDF\n");
+	for (i = 0; i < ARRAY_SIZE(flush_bins); i++) {
+		u64 cdf_ppm;
+
+		cumulative += flush_bins[i];
+		cdf_ppm = stats->physical_fsync_flushes ?
+			div64_u64(cumulative * 1000000ULL,
+				  stats->physical_fsync_flushes) : 0;
+		if (i < ARRAY_SIZE(f2fs_latency_flush_cdf_ns))
+			seq_printf(m,
+				"le_ns=%llu count=%llu cumulative=%llu cdf=%llu.%04llu%%\n",
+				f2fs_latency_flush_cdf_ns[i], flush_bins[i],
+				cumulative, cdf_ppm / 10000,
+				cdf_ppm % 10000);
+		else
+			seq_printf(m,
+				"le_ns=inf count=%llu cumulative=%llu cdf=%llu.%04llu%%\n",
+				flush_bins[i], cumulative, cdf_ppm / 10000,
+				cdf_ppm % 10000);
+	}
+
+	seq_puts(m,
+		"\n# explicit_fsync_physical_flush covers source=0 F2FS blkdev_issue_flush(); "
+		"strict/atomic PREFLUSH|FUA remains classified in node_submit_path.\n");
+	seq_puts(m,
+		"# explicit fsync flushes inherit the selected fsync batch; multi-device secondary-cache records are global.\n");
+	kfree(stats);
+	return 0;
+}
+
+static int f2fs_latency_stats_open(struct inode *inode, struct file *file)
+{
+	struct f2fs_latency_buffer *buffer;
+	int ret;
+
+	ret = f2fs_latency_snapshot_get(&buffer);
+	if (ret)
+		return ret;
+	ret = single_open(file, f2fs_latency_stats_show, buffer);
+	if (ret)
+		f2fs_latency_snapshot_put();
+	return ret;
+}
+
+static int f2fs_latency_stats_release(struct inode *inode, struct file *file)
+{
+	int ret = single_release(inode, file);
+
+	f2fs_latency_snapshot_put();
+	return ret;
+}
+
+static const struct file_operations f2fs_latency_stats_fops = {
+	.owner = THIS_MODULE,
+	.open = f2fs_latency_stats_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = f2fs_latency_stats_release,
+};
+
+static int f2fs_latency_format_show(struct seq_file *m, void *unused)
+{
+	seq_puts(m, "F2FS fsync latency binary format v6\n");
+	seq_puts(m, "clock: ktime_get_ns (CLOCK_MONOTONIC nanoseconds)\n");
+	seq_puts(m, "header: 256 bytes, records: 576 bytes, native little-endian\n");
+	seq_puts(m,
+		 "record types: 1=fsync summary, 2=explicit blkdev flush, 3=physical checkpoint execution, 4=target balance checkpoint waiter\n");
+	seq_puts(m, "fsync values[0]: setup_ns\n");
+	seq_puts(m,
+		 "fsync values[1..3]: data_submit_begin/end, data_wait_total_ns\n");
+	seq_puts(m, "fsync values[4..6]: node_submit first/last/total\n");
+	seq_puts(m, "fsync values[7..9]: node_wait first/last/total\n");
+	seq_puts(m, "fsync values[10..11]: logical_flush begin/end\n");
+	seq_puts(m, "fsync values[12..13]: checkpoint begin/end\n");
+	seq_puts(m,
+		 "fsync values[15..18]: data allocate/submit-page/submit-merged/existing-writeback-wait totals\n");
+	seq_puts(m,
+		 "fsync values[19..22]: matching data-substage call counts\n");
+	seq_puts(m,
+		 "fsync values[23..46]: elapsed/count pairs for writepages-mutex, tag-scan, contended-folio-lock, write-single-other, compressed-other, io-order-lock, balance-GC, blk-finish-plug, do-write-other, retry-wait, cached-IPU-submit, and write-cache-other\n");
+	seq_puts(m,
+		 "fsync values[47..48]: cp-rwsem trylock elapsed/count\n");
+	seq_puts(m,
+		 "all 17 top-level data substages are exclusive/additive; data-submit-other is the parent minus their sum\n");
+	seq_puts(m,
+		 "cp-rwsem trylock measures nonblocking f2fs_trylock_op() call wall time; failed-attempt retry sleep is in writeback-retry-wait\n");
+	seq_puts(m,
+		 "fsync values[49..54]: submit-page io-rwsem acquisition, zone-pending wait plus bio-put, and __submit_merged_bio elapsed/count pairs\n");
+	seq_puts(m,
+		 "submit-page details are hierarchical children, not top-level additive leaves; submit-page-other is their parent minus their sum\n");
+	seq_puts(m,
+		 "OPU allocate/submit leaves are covered; IPU core remains in do-write-other and cached IPU submits have a separate leaf\n");
+	seq_puts(m,
+		 "values[14]: type=1 fsync mode 0/1/2; type=2 flush source 0/1\n");
+	seq_puts(m,
+		 "flag bit24: DATA_BREAKDOWN_VALID; bit25: DATA_BREAKDOWN_ERROR\n");
+	seq_puts(m,
+		 "checkpoint values[4..8]: batch_id, device_flush total/max/count/errors\n");
+	seq_puts(m,
+		 "checkpoint values[9..10]: physical checkpoint execution begin/end\n");
+	seq_puts(m,
+		 "flag bit22: CP_BATCH_ASSOC; bit26: CP_EXEC_VALID\n");
+	seq_puts(m,
+		 "type=4 common start/end and values[1..2]: synchronous f2fs_sync_fs() call begin/end\n");
+	seq_puts(m,
+		 "type=4 values[0]: parent type=1 seq; values[3..9]: batch_id, physical execution begin/end, source=1 flush total/max/count/errors\n");
+	seq_puts(m,
+		 "type=4 values[10..14]: balance call index, dispatch mode, physical/selected waiter counts, trigger kind; currently only trigger kind 1 is emitted\n");
+	seq_puts(m,
+		 "type=4 requires CHECKPOINT bit9 and BALANCE_CP_WAITER bit27; batch_id without CP_EXEC_VALID is a legal no-op checkpoint result\n");
+	seq_puts(m,
+		 "type=4 synchronous call intervals allow end == begin (0 ns); physical execution intervals require end > begin\n");
+	seq_puts(m,
+		 "associated type=2 values[4]: checkpoint batch_id\n");
+	seq_puts(m,
+		 "type=2 values[5]: encoded F2FS mount device for overlap joins\n");
+	seq_puts(m,
+		 "flag bit23: FLUSH_MOUNT_DEV validates type=2 values[5]\n");
+	seq_puts(m,
+		 "type=3 uses record start/end as the unique physical checkpoint execution interval and values[4..10] as its batch result; ret is the checkpoint result\n");
+	seq_puts(m,
+		 "A merged checkpoint batch copies one physical flush aggregate to every selected waiter.\n");
+	seq_puts(m, "reserve_ns measures shared atomic slot reservation.\n");
+	seq_puts(m, "write_ns measures setup plus record finalization.\n");
+	seq_puts(m,
+		 "write_ns excludes active-put and all stage timestamp hooks, including per-call data substages and submit-page details.\n");
+	seq_puts(m,
+		 "Type=3 is global and bypasses TGID filtering; pid/tgid/comm identify the checkpoint executor, so target joins use batch ID.\n");
+	seq_puts(m,
+		 "Type=4 inherits the selected parent type=1 inode/device and target task identity, and is reserved as a continuation after its balance substage ends.\n");
+	seq_puts(m,
+		 "Every traced non-no-op physical checkpoint with an available slot has one type=3 record; its source=1 type=2 flush attempts share the batch ID.\n");
+	seq_puts(m,
+		 "Type=3 execution excludes merge queue, gc_lock/cp_global_sem waits, and no-op dispatch; source=1 excludes primary checkpoint PREFLUSH/FUA.\n");
+	seq_puts(m,
+		 "Multi-device checkpoint secondary-cache flush records remain global.\n");
+	seq_puts(m, "The call filling the final slot may pay synchronous printk cost.\n");
+	seq_puts(m, "An outer f2fs_sync_file cp_error fast failure is not recorded.\n");
+	seq_puts(m, "Read log/stats only after enable=0.\n");
+	seq_puts(m, "A full log sets enable=0 and complete=0 automatically.\n");
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(f2fs_latency_format);
+
+static bool f2fs_latency_create_debugfs_file(const char *name, umode_t mode,
+		const struct file_operations *fops)
+{
+	return !IS_ERR_OR_NULL(debugfs_create_file(name, mode,
+			f2fs_latency_debugfs_root, NULL, fops));
+}
+
+void f2fs_fsync_latency_init(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < F2FS_LATENCY_DATA_SCOPE_COUNT; i++) {
+		spin_lock_init(&f2fs_latency_data_scopes[i].lock);
+		INIT_HLIST_HEAD(&f2fs_latency_data_scopes[i].scopes);
+	}
+	f2fs_latency_debugfs_root =
+		debugfs_create_dir(F2FS_LATENCY_DIR_NAME, NULL);
+	if (IS_ERR_OR_NULL(f2fs_latency_debugfs_root)) {
+		pr_warn("f2fs_fsync_latency: debugfs interface unavailable\n");
+		f2fs_latency_debugfs_root = NULL;
+		return;
+	}
+
+	if (f2fs_latency_create_debugfs_file("enable", 0600,
+			&f2fs_latency_enable_fops) &&
+	    f2fs_latency_create_debugfs_file("buffer_size_mb", 0600,
+			&f2fs_latency_buffer_mb_fops) &&
+	    f2fs_latency_create_debugfs_file("tgid_filter", 0600,
+			&f2fs_latency_tgid_fops) &&
+	    f2fs_latency_create_debugfs_file("reset", 0200,
+			&f2fs_latency_reset_fops) &&
+	    f2fs_latency_create_debugfs_file("log", 0400,
+			&f2fs_latency_log_fops) &&
+	    f2fs_latency_create_debugfs_file("stats", 0400,
+			&f2fs_latency_stats_fops) &&
+	    f2fs_latency_create_debugfs_file("format", 0400,
+			&f2fs_latency_format_fops))
+		return;
+
+	pr_err("f2fs_fsync_latency: failed to create complete debugfs interface\n");
+	debugfs_remove_recursive(f2fs_latency_debugfs_root);
+	f2fs_latency_debugfs_root = NULL;
+}
+
+void f2fs_fsync_latency_exit(void)
+{
+	struct f2fs_latency_buffer *buffer;
+
+	debugfs_remove_recursive(f2fs_latency_debugfs_root);
+	f2fs_latency_debugfs_root = NULL;
+
+	mutex_lock(&f2fs_latency_control_lock);
+	f2fs_latency_stop_and_drain();
+	buffer = rcu_dereference_protected(f2fs_latency_buffer,
+			lockdep_is_held(&f2fs_latency_control_lock));
+	RCU_INIT_POINTER(f2fs_latency_buffer, NULL);
+	f2fs_latency_free_buffer(buffer);
+	mutex_unlock(&f2fs_latency_control_lock);
+}
