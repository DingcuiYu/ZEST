+def parse_arguments(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
+    parser = argparse.ArgumentParser(
+        description=(
+            "Analyze an F2FS fsync latency binary dump and write an exact "
+            "empirical CDF CSV for explicit physical flush latency."
+        )
+    )
+    parser.add_argument("trace", type=Path, help="binary dump read from debugfs log")
+    parser.add_argument(
+        "--flush-cdf",
+        type=Path,
+        default=None,
+        metavar="PATH",
+        help="CDF output path (default: TRACE.flush_cdf.csv)",
+    )
+    parser.add_argument(
+        "--progress",
+        action="store_true",
+        help=(
+            "print record progress every one million records and report "
+            "subsequent analysis stages"
+        ),
+    )
+    return parser.parse_args(argv)
