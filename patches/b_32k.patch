+#define SWAP_32KCHUNK_LANE_NR	1024
+
+/*
+ * Hashed lanes serialize operations for one chunk without retaining swap
+ * data outside the normal swap cache.  Keep enough lanes that a slow
+ * asynchronous Flash BIO does not make unrelated chunks repeatedly redirty
+ * merely because their hashes collide.
+ */
+struct swap_32kchunk_lane {
+	struct mutex lock;
+	wait_queue_head_t io_wait;
+	atomic_t read_inflight;
+	bool write_inflight;
+};
+
+struct swap_32kchunk_io {
+	struct folio *folios[SWAP_IO_CHUNK_PAGES];
+	struct page *pages[SWAP_IO_CHUNK_PAGES];
+	struct swap_32kchunk_lane *lane;
+	struct swap_info_struct *sis;
+	unsigned long base;
+	unsigned int target_index;
+	void *latency_io;
+};
+
+static mempool_t *swap_32kchunk_pool;
+static struct swap_32kchunk_lane
+	swap_32kchunk_lanes[SWAP_32KCHUNK_LANE_NR];
+static DEFINE_MUTEX(swap_32kchunk_init_lock);
+static bool swap_32kchunk_lanes_ready;
+
+/* Private debug counters; no sysfs, tracepoint, UAPI or exported symbol. */
+static struct {
+	atomic64_t read_bios;
+	atomic64_t write_bios;
+	atomic64_t invalid_bios;
+	atomic64_t alignment_errors;
+	atomic64_t read_errors;
+	atomic64_t write_errors;
+	atomic64_t write_retries;
+	atomic64_t rewrite_read_bios;
+	atomic64_t rewrite_write_bios;
