+
+/*
+ * Reserve one aligned order-3 swap range, but charge and return it as eight
+ * independent base-page entries.  The caller must either add every folio to
+ * swap cache or release every returned entry.
+ */
+bool folio_alloc_swap_chunk(struct folio **folios, swp_entry_t *entries)
+{
+	swp_entry_t base;
+	unsigned long offset;
+	unsigned int type;
+	int i;
+
+	for (i = 0; i < SWAP_IO_CHUNK_PAGES; i++) {
+		if (WARN_ON_ONCE(folio_nr_pages(folios[i]) != 1))
+			return false;
+		entries[i].val = 0;
+	}
+
+	if (!get_swap_32kchunk(&base))
+		return false;
+
+	offset = swp_offset(base);
+	type = swp_type(base);
+	for (i = 0; i < SWAP_IO_CHUNK_PAGES; i++)
+		entries[i] = swp_entry(type, offset + i);
+	if (WARN_ON_ONCE(swap_32kchunk_base(swp_swap_info(base), offset) !=
+			 offset))
+		goto fail;
+
+	for (i = 0; i < SWAP_IO_CHUNK_PAGES; i++) {
+		if (mem_cgroup_try_charge_swap(folios[i], entries[i]))
+			goto fail;
+	}
+
+	return true;
+
+fail:
+	/* This also drops any memcg charges recorded for earlier entries. */
+	swapcache_free_entries(entries, SWAP_IO_CHUNK_PAGES);
+	return false;
+}
diff --git a/mm/swap_state.c b/mm/swap_state.c
index d12dedc52a81c58f8c2cae0ee0de69f8b04be01c..51323c2761fed831dc1e6aa7b8a875e43ab5c0e8 100644
--- a/mm/swap_state.c
+++ b/mm/swap_state.c
@@ -224,6 +224,46 @@ bool add_to_swap(struct folio *folio)
 	return false;
 }
 
+/*
+ * Add eight independent base-page folios to one aligned swap chunk.  Cache
+ * insertion is transactional: on failure no folio keeps a chunk entry.
+ */
+bool add_to_swap_chunk(struct folio **folios)
+{
+	swp_entry_t entries[SWAP_IO_CHUNK_PAGES];
+	int added;
+	int i;
+
+	for (i = 0; i < SWAP_IO_CHUNK_PAGES; i++) {
+		if (WARN_ON_ONCE(!folio_test_locked(folios[i]) ||
+				 !folio_test_uptodate(folios[i]) ||
+				 folio_test_swapcache(folios[i]) ||
+				 folio_nr_pages(folios[i]) != 1))
+			return false;
+	}
+
+	if (!folio_alloc_swap_chunk(folios, entries))
+		return false;
+
+	for (i = 0; i < SWAP_IO_CHUNK_PAGES; i++) {
+		if (add_to_swap_cache(folios[i], entries[i],
+				      __GFP_HIGH | __GFP_NOMEMALLOC |
+				      __GFP_NOWARN, NULL))
+			goto fail;
+		folio_mark_dirty(folios[i]);
+	}
+
+	return true;
+
+fail:
+	added = i;
+	while (i--)
+		delete_from_swap_cache(folios[i]);
+	swapcache_free_entries(entries + added,
+			       SWAP_IO_CHUNK_PAGES - added);
+	return false;
+}
+
 /*
  * This must be called only on folios that have
  * been verified to be in the swap cache and locked.
@@ -866,6 +906,19 @@ static struct page *swap_vma_readahead(swp_entry_t fentry, gfp_t gfp_mask,
 struct page *swapin_readahead(swp_entry_t entry, gfp_t gfp_mask,
 				struct vm_fault *vmf)
 {
+	struct swap_info_struct *si;
