diff --git a/mm/swap_latency_trace.c b/mm/swap_latency_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..6218186fcf7b1b2f5220ff4e6a60bd4fa4bc3ff8
--- /dev/null
+++ b/mm/swap_latency_trace.c
@@ -0,0 +1,1763 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Low-overhead swap-in/swap-out latency tracing.
+ *
+ * The log is a fixed-size binary ring-in-the-sense-of-a-monotonic append
+ * area.  A session starts at record zero and is sealed by enable=0.  The
+ * backing vmalloc area is retained until reset, so a subsequent session with
+ * the same size does not allocate another multi-GiB area.
+ */
+
+#include <linux/atomic.h>
+#include <linux/bio.h>
+#include <linux/blkdev.h>
+#include <linux/build_bug.h>
+#include <linux/debugfs.h>
+#include <linux/fs.h>
+#include <linux/hash.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/kdev_t.h>
+#include <linux/ktime.h>
+#include <linux/limits.h>
+#include <linux/mm.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/pagemap.h>
+#include <linux/preempt.h>
+#include <linux/rcupdate.h>
+#include <linux/sched.h>
+#include <linux/sched/cputime.h>
+#include <linux/sched/task.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/swap.h>
+#include <linux/uaccess.h>
+#include <linux/utsname.h>
+#include <linux/vmalloc.h>
+#include <linux/wait.h>
+
+#include "swap_latency_trace.h"
+
+#define SWAP_LATENCY_DIR_NAME		"swap_latency"
+#define SWAP_LATENCY_DEFAULT_MB		2048U
+#define SWAP_LATENCY_MIN_MB		1U
+#define SWAP_LATENCY_MAX_MB		32768U
+#define SWAP_LATENCY_FORMAT_VERSION	3U
+#define SWAP_LATENCY_HEADER_SIZE	256U
+#define SWAP_LATENCY_RECORD_SIZE	320U
+#define SWAP_LATENCY_RECORD_MAGIC	0x52544c53U /* "SLTR" */
+#define SWAP_LATENCY_ENDIAN_MARKER	0x01020304U
+#define SWAP_LATENCY_COMM_LEN		16U
+#define SWAP_LATENCY_SCOPE_BITS		6U
+#define SWAP_LATENCY_SCOPE_COUNT		(1U << SWAP_LATENCY_SCOPE_BITS)
+#define SWAP_LATENCY_RETRY_BITS		6U
+#define SWAP_LATENCY_RETRY_COUNT		(1U << SWAP_LATENCY_RETRY_BITS)
+#define SWAP_LATENCY_BACKEND_FLAG_MASK	(SWAP_LATENCY_F_ZSWAP | \
+	SWAP_LATENCY_F_FS_OPS | SWAP_LATENCY_F_BDEV | \
+	SWAP_LATENCY_F_SWAPFILE | SWAP_LATENCY_F_ZRAM | \
+	SWAP_LATENCY_F_BLOCK_DEVICE | SWAP_LATENCY_F_NO_IO | \
+	SWAP_LATENCY_F_UNTRACKED_IO)
+
+struct swap_latency_log_header {
+	u8 magic[8];
+	u32 version;
+	u32 header_size;
+	u32 record_size;
+	u32 endian;
+	u64 buffer_bytes;
+	u64 capacity;
+	u64 records;
+	u64 dropped;
+	u64 session;
+	u64 start_ns;
+	u64 stop_ns;
+	u32 stopped_full;
+	u32 enabled;
+	u32 reserved0;
+	u32 reserved1;
+	char kernel_release[64];
+	u8 reserved[96];
+};
+
+struct swap_latency_swapin_extension {
+	u64 rvh_begin_ns;
+	u64 rvh_end_ns;
+	u64 vh_begin_ns;
+	u64 vh_end_ns;
+	u64 wait_begin_ns;
+	u64 wait_end_ns;
+	u32 flags;
+	u32 reserved;
+};
+
+struct swap_latency_swapout_extension {
+	u64 hook_begin_ns;
+	u64 hook_end_ns;
+	u64 flags_before;
+	u64 flags_after;
+	u64 helper_begin_ns;
+	u32 helper;
+	atomic_t submit_state;
+	u32 submit_return_cpu;
+	atomic_t evidence_flags;
+};
+
+/*
+ * Format v3 stores finalized deltas rather than stale scheduler counter
+ * snapshots.  The first half describes the root do_swap_page/swap_writepage
+ * call; the second half describes the primary restricted vendor read hook.
+ */
+struct swap_latency_sched_extension {
+	u64 root_exec_ns;
+	u64 root_run_delay_ns;
+	u64 rvh_exec_ns;
+	u64 rvh_run_delay_ns;
+	u32 root_nvcsw;
+	u32 root_nivcsw;
+	u32 rvh_nvcsw;
+	u32 rvh_nivcsw;
+	u32 root_begin_cpu;
+	u32 root_end_cpu;
+	u32 rvh_begin_cpu;
+	u32 rvh_end_cpu;
+};
+
+union swap_latency_record_extension {
+	struct swap_latency_swapin_extension swapin;
+	struct swap_latency_swapout_extension swapout;
+};
+
+/*
+ * Fields through comm are the on-disk format.  pending is an internal
+ * lifetime reference (one for the call and one for each async bio) and is
+ * intentionally kept in the record so no per-record heap allocation is
+ * needed.  Readers ignore pending and decode the final type-specific
+ * extension only when its version is recognized.
+ */
+struct swap_latency_record {
+	u32 magic;
+	u16 version;
+	u16 type;
+	atomic_t flags;
+	u32 size;
+	u64 seq;
+	u64 session;
+	u64 call_begin_ns;
+	u64 call_end_ns;
+	u64 kernel_ns;
+	u64 submit_begin_ns;
+	u64 submit_end_ns;
+	u64 device_begin_ns;
+	u64 device_end_ns;
+	u64 swap_entry;
+	u64 sector;
+	u64 io_bytes;
+	u64 address;
+	u64 reserve_ns;
+	u32 dev;
+	s32 bio_status;
+	u32 pid;
+	u32 tgid;
+	u32 cpu;
+	u32 order;
+	u32 backend;
+	s32 result;
+	u32 sis_flags;
+	u32 nr_pages;
+	u32 submit_cpu;
+	u32 complete_cpu;
+	char comm[SWAP_LATENCY_COMM_LEN];
+	atomic_t pending;
+	u32 extension_version;
+	union swap_latency_record_extension extension;
+	struct swap_latency_sched_extension sched;
+};
+
+struct swap_latency_buffer {
+	void *memory;
+	unsigned long bytes;
+	u64 capacity;
+	u64 session;
+	u64 start_ns;
+	u64 stop_ns;
+	atomic64_t next_record ____cacheline_aligned_in_smp;
+	atomic64_t dropped;
+	atomic_t full_reported;
+	bool stopped_full;
+	bool sealed;
+};
+
+struct swap_latency_reader {
+	struct swap_latency_buffer *buffer;
+	loff_t length;
+};
+
+struct swap_latency_scope_bucket {
+	spinlock_t lock;
+	struct hlist_head scopes;
+};
+
+/*
+ * A retry state owns the call reference of a swap-in record after its first
+ * VM_FAULT_RETRY.  The next FAULT_FLAG_TRIED attempt may consume that
+ * reference, but only after do_swap_page() confirms a cache hit.
+ */
+struct swap_latency_retry {
+	struct hlist_node node;
+	struct swap_latency_record *record;
+	struct task_struct *task;
+	u64 session;
+	u64 call_begin_ns;
+	unsigned long address;
+	struct swap_latency_sched_snapshot sched_begin;
+};
+
+struct swap_latency_retry_bucket {
+	spinlock_t lock;
+	struct hlist_head retries;
+};
+
+static struct swap_latency_scope_bucket
+	swap_latency_scopes[SWAP_LATENCY_SCOPE_COUNT];
+static struct swap_latency_retry_bucket
+	swap_latency_retries[SWAP_LATENCY_RETRY_COUNT];
+static DEFINE_MUTEX(swap_latency_control_lock);
+static DECLARE_WAIT_QUEUE_HEAD(swap_latency_active_wait);
+static atomic_t swap_latency_enabled ____cacheline_aligned_in_smp =
+	ATOMIC_INIT(0);
+static atomic_t swap_latency_active ____cacheline_aligned_in_smp =
+	ATOMIC_INIT(0);
+static atomic64_t swap_latency_next_session;
+static struct swap_latency_buffer __rcu *swap_latency_buffer;
+static struct dentry *swap_latency_debugfs_root;
+static unsigned int swap_latency_buffer_mb = SWAP_LATENCY_DEFAULT_MB;
+static unsigned int swap_latency_readers;
+
+static void swap_latency_record_put(struct swap_latency_record *record);
+static void swap_latency_retry_drain(void);
+
+static_assert(sizeof(struct swap_latency_log_header) ==
+		SWAP_LATENCY_HEADER_SIZE);
+static_assert(sizeof(struct swap_latency_record) ==
+		SWAP_LATENCY_RECORD_SIZE);
+static_assert(sizeof(struct swap_latency_swapin_extension) == 56);
+static_assert(sizeof(struct swap_latency_swapout_extension) == 56);
+static_assert(sizeof(union swap_latency_record_extension) == 56);
+static_assert(sizeof(struct swap_latency_sched_extension) == 64);
+static_assert(TASK_COMM_LEN == SWAP_LATENCY_COMM_LEN);
+static_assert(offsetof(struct swap_latency_record, seq) == 16);
+static_assert(offsetof(struct swap_latency_record, call_begin_ns) == 32);
+static_assert(offsetof(struct swap_latency_record, swap_entry) == 88);
+static_assert(offsetof(struct swap_latency_record, comm) == 176);
+static_assert(offsetof(struct swap_latency_record, pending) == 192);
+static_assert(offsetof(struct swap_latency_record, extension_version) == 196);
+static_assert(offsetof(struct swap_latency_record, extension) == 200);
+static_assert(offsetof(struct swap_latency_record, sched) == 256);
+static_assert(offsetof(struct swap_latency_swapout_extension, helper) == 40);
+static_assert(offsetof(struct swap_latency_swapout_extension,
+		evidence_flags) == 52);
+
+static struct swap_latency_log_header *swap_latency_header(
+		struct swap_latency_buffer *buffer)
+{
+	return buffer->memory;
+}
+
+static struct swap_latency_record *swap_latency_record_at(
+		struct swap_latency_buffer *buffer, u64 index)
+{
+	return (struct swap_latency_record *)((u8 *)buffer->memory +
+			SWAP_LATENCY_HEADER_SIZE + index * SWAP_LATENCY_RECORD_SIZE);
+}
+
+static void swap_latency_active_put(void)
+{
+	if (atomic_dec_and_test(&swap_latency_active))
+		wake_up_all(&swap_latency_active_wait);
+}
+
+static unsigned int swap_latency_scope_index(const struct task_struct *task)
+{
+	return hash_ptr(task, SWAP_LATENCY_SCOPE_BITS);
+}
+
+static unsigned int swap_latency_retry_index(const struct task_struct *task)
+{
+	return hash_ptr(task, SWAP_LATENCY_RETRY_BITS);
+}
+
+
+static bool swap_latency_enabled_now(void)
+{
+	return atomic_read_acquire(&swap_latency_enabled);
+}
+
+static void swap_latency_retry_free(struct swap_latency_retry *retry)
+{
+	if (!retry)
+		return;
+	put_task_struct(retry->task);
+	kfree(retry);
+}
+
+static void swap_latency_retry_release(struct swap_latency_retry *retry)
+{
+	struct swap_latency_record *record;
+
+	if (!retry)
+		return;
+	record = retry->record;
+	swap_latency_retry_free(retry);
+	swap_latency_record_put(record);
+}
+
+static bool swap_latency_retry_matches(const struct swap_latency_retry *retry,
+		const struct swap_latency_call *call)
+{
+	swp_entry_t entry = { .val = retry->record->swap_entry };
+
+	return retry->task == current && retry->session == call->session &&
+		retry->address == call->address &&
+		swp_type(entry) == swp_type(call->entry) &&
+		swp_offset(entry) == swp_offset(call->entry);
+}
+
+static struct swap_latency_retry *swap_latency_retry_take(
+		struct swap_latency_call *call)
+{
+	struct swap_latency_retry *retry;
+	struct hlist_node *node;
+	unsigned int bucket;
+	u32 flags;
+
+	if (!swap_latency_enabled_now())
+		return NULL;
+	bucket = swap_latency_retry_index(current);
+	spin_lock(&swap_latency_retries[bucket].lock);
+	hlist_for_each_entry_safe(retry, node,
+			&swap_latency_retries[bucket].retries, node) {
+		if (!swap_latency_retry_matches(retry, call))
+			continue;
+		hlist_del_init(&retry->node);
+		spin_unlock(&swap_latency_retries[bucket].lock);
+
+		flags = atomic_read(&retry->record->flags);
+		if ((flags & (SWAP_LATENCY_F_CACHE_MISS |
+			      SWAP_LATENCY_F_RETRY)) ==
+		    (SWAP_LATENCY_F_CACHE_MISS | SWAP_LATENCY_F_RETRY) &&
+		    !(flags & SWAP_LATENCY_F_CACHE_HIT))
+			return retry;
+
+		/* A malformed/stale state must fall back to a normal record. */
+		swap_latency_retry_release(retry);
+		return NULL;
+	}
+	spin_unlock(&swap_latency_retries[bucket].lock);
+	return NULL;
+}
+
+static bool swap_latency_retry_queue(struct swap_latency_call *call)
+{
+	struct swap_latency_retry *retry = call->retry;
+	struct swap_latency_record *record = call->record;
+	unsigned int bucket;
+	bool new_retry = false;
+	u32 flags;
+
+	if (!record || !swap_latency_enabled_now())
+		return false;
+	flags = atomic_read(&record->flags);
+	if ((flags & (SWAP_LATENCY_F_CACHE_MISS | SWAP_LATENCY_F_RETRY)) !=
+	    (SWAP_LATENCY_F_CACHE_MISS | SWAP_LATENCY_F_RETRY) ||
+	    (flags & SWAP_LATENCY_F_CACHE_HIT))
+		return false;
+
+	if (!retry) {
+		retry = kmalloc(sizeof(*retry), GFP_ATOMIC);
+		if (!retry)
+			return false;
+		INIT_HLIST_NODE(&retry->node);
+		retry->record = record;
+		retry->task = current;
+		get_task_struct(retry->task);
+		new_retry = true;
+	} else {
+		/* The detached state already owns this call reference. */
+		INIT_HLIST_NODE(&retry->node);
+	}
+	retry->session = call->session;
+	retry->call_begin_ns = call->call_begin_ns;
+	retry->address = call->address;
+	retry->sched_begin = call->sched_begin;
+	bucket = swap_latency_retry_index(retry->task);
+	spin_lock(&swap_latency_retries[bucket].lock);
+	if (!swap_latency_enabled_now()) {
+		spin_unlock(&swap_latency_retries[bucket].lock);
+		if (new_retry)
+			swap_latency_retry_free(retry);
+		return false;
+	}
+	hlist_add_head(&retry->node, &swap_latency_retries[bucket].retries);
+	spin_unlock(&swap_latency_retries[bucket].lock);
+	call->retry = NULL;
+	return true;
+}
+
+static void swap_latency_retry_drain(void)
+{
+	struct swap_latency_retry *retry;
+	struct hlist_node *node;
+	unsigned int i;
+
+	for (i = 0; i < SWAP_LATENCY_RETRY_COUNT; i++) {
+		HLIST_HEAD(retries);
+
+		spin_lock(&swap_latency_retries[i].lock);
+		hlist_move_list(&swap_latency_retries[i].retries, &retries);
+		spin_unlock(&swap_latency_retries[i].lock);
+
+		hlist_for_each_entry_safe(retry, node,
+				&retries, node) {
+			hlist_del_init(&retry->node);
+			swap_latency_retry_release(retry);
+		}
+	}
+}
+
+/*
+ * Settle the current execution slice while preemption is already disabled.
+ * The caller places the wall marker on the desired side of this snapshot and
+ * keeps preemption disabled until both operations have completed.  This is
+ * important: taking a snapshot, enabling preemption, and only then reading
+ * ktime can let the task sleep in the gap.  That sleep would be charged to
+ * the scheduler deltas without belonging to the measured interval.
+ */
+static void swap_latency_take_sched_snapshot_locked(
+		struct swap_latency_sched_snapshot *snapshot)
+{
+	memset(snapshot, 0, sizeof(*snapshot));
+	snapshot->exec_runtime_ns = task_sched_runtime(current);
+#ifdef CONFIG_SCHED_INFO
+	snapshot->run_delay_ns = READ_ONCE(current->sched_info.run_delay);
+	snapshot->run_delay_valid = true;
+#endif
+	snapshot->nvcsw = READ_ONCE(current->nvcsw);
+	snapshot->nivcsw = READ_ONCE(current->nivcsw);
+	snapshot->cpu = raw_smp_processor_id();
+	snapshot->valid = true;
+}
+
+/* Snapshot first, then mark the beginning while the task cannot be switched. */
+static u64 swap_latency_sched_interval_begin(
+		struct swap_latency_sched_snapshot *snapshot)
+{
+	u64 wall_ns;
+
+	preempt_disable();
+	swap_latency_take_sched_snapshot_locked(snapshot);
+	wall_ns = ktime_get_ns();
+	preempt_enable();
+	return wall_ns;
+}
+
+/* Mark the end first, then snapshot while the task cannot be switched. */
+static u64 swap_latency_sched_interval_end(
+		struct swap_latency_sched_snapshot *snapshot)
+{
+	u64 wall_ns;
+
+	preempt_disable();
+	wall_ns = ktime_get_ns();
+	swap_latency_take_sched_snapshot_locked(snapshot);
+	preempt_enable();
+	return wall_ns;
+}
+
+static u32 swap_latency_switch_delta(unsigned long begin, unsigned long end,
+		bool *overflow)
+{
+	unsigned long delta = end - begin;
+
+	if (delta > U32_MAX) {
+		*overflow = true;
+		return U32_MAX;
+	}
+	return (u32)delta;
+}
+
+static void swap_latency_store_root_sched(struct swap_latency_record *record,
+		const struct swap_latency_sched_snapshot *begin,
+		const struct swap_latency_sched_snapshot *end)
+{
+	bool overflow = false;
+	u32 flags = 0;
+
+	if (!begin->valid || !end->valid ||
+		end->exec_runtime_ns < begin->exec_runtime_ns)
+		return;
+
+	record->sched.root_exec_ns = end->exec_runtime_ns -
+		begin->exec_runtime_ns;
+	record->sched.root_nvcsw = swap_latency_switch_delta(begin->nvcsw,
+		end->nvcsw, &overflow);
+	record->sched.root_nivcsw = swap_latency_switch_delta(begin->nivcsw,
+		end->nivcsw, &overflow);
+	record->sched.root_begin_cpu = begin->cpu;
+	record->sched.root_end_cpu = end->cpu;
+	flags |= SWAP_LATENCY_F_SCHED_VALID;
+
+	if (begin->run_delay_valid && end->run_delay_valid &&
+		end->run_delay_ns >= begin->run_delay_ns) {
+		record->sched.root_run_delay_ns = end->run_delay_ns -
+			begin->run_delay_ns;
+		flags |= SWAP_LATENCY_F_RUN_DELAY_VALID;
+	}
+	if (overflow)
+		flags |= SWAP_LATENCY_F_SCHED_COUNTER_OVERFLOW;
+	atomic_or(flags, &record->flags);
+}
+
+static u32 swap_latency_store_rvh_sched(struct swap_latency_record *record,
+		const struct swap_latency_sched_snapshot *begin,
+		const struct swap_latency_sched_snapshot *end)
+{
+	bool overflow = false;
+	u32 flags = 0;
+
+	if (!begin->valid || !end->valid ||
+		end->exec_runtime_ns < begin->exec_runtime_ns)
+		return 0;
+
+	record->sched.rvh_exec_ns = end->exec_runtime_ns -
+		begin->exec_runtime_ns;
+	record->sched.rvh_nvcsw = swap_latency_switch_delta(begin->nvcsw,
+		end->nvcsw, &overflow);
+	record->sched.rvh_nivcsw = swap_latency_switch_delta(begin->nivcsw,
+		end->nivcsw, &overflow);
+	record->sched.rvh_begin_cpu = begin->cpu;
+	record->sched.rvh_end_cpu = end->cpu;
+	flags |= SWAP_LATENCY_VENDOR_F_RVH_SCHED_VALID;
+
+	if (begin->run_delay_valid && end->run_delay_valid &&
+		end->run_delay_ns >= begin->run_delay_ns) {
+		record->sched.rvh_run_delay_ns = end->run_delay_ns -
+			begin->run_delay_ns;
+		flags |= SWAP_LATENCY_VENDOR_F_RVH_RUN_DELAY_VALID;
+	}
+	if (overflow)
+		flags |= SWAP_LATENCY_VENDOR_F_RVH_SCHED_OVERFLOW;
+	return flags;
+}
+
+static enum swap_latency_backend swap_latency_classify(
+		struct swap_info_struct *sis)
+{
+	const struct block_device *bdev = sis ? sis->bdev : NULL;
+	/* sis->flags is updated non-atomically while swap is being set up. */
+	unsigned long flags = sis ? data_race(sis->flags) : 0;
+
+	if (flags & SWP_FS_OPS)
+		return SWAP_LATENCY_BACKEND_FS_OPS;
+	if (bdev && bdev->bd_disk &&
+		!strncmp(bdev->bd_disk->disk_name, "zram", 4))
+		return SWAP_LATENCY_BACKEND_ZRAM;
+	if (flags & SWP_BLKDEV)
+		return SWAP_LATENCY_BACKEND_BLOCK_DEVICE;
+	return SWAP_LATENCY_BACKEND_SWAPFILE;
+}
+
+static void swap_latency_set_backend(struct swap_latency_record *record,
+		enum swap_latency_backend backend)
+{
+	if (!record)
+		return;
+	atomic_andnot(SWAP_LATENCY_BACKEND_FLAG_MASK, &record->flags);
+	record->backend = backend;
+	switch (backend) {
+	case SWAP_LATENCY_BACKEND_ZRAM:
+		atomic_or(SWAP_LATENCY_F_ZRAM | SWAP_LATENCY_F_BDEV,
+				&record->flags);
+		break;
+	case SWAP_LATENCY_BACKEND_SWAPFILE:
+		atomic_or(SWAP_LATENCY_F_SWAPFILE | SWAP_LATENCY_F_BDEV,
+				&record->flags);
+		break;
+	case SWAP_LATENCY_BACKEND_BLOCK_DEVICE:
+		atomic_or(SWAP_LATENCY_F_BLOCK_DEVICE |
+				SWAP_LATENCY_F_BDEV, &record->flags);
+		break;
+	case SWAP_LATENCY_BACKEND_FS_OPS:
+		atomic_or(SWAP_LATENCY_F_FS_OPS |
+				SWAP_LATENCY_F_UNTRACKED_IO, &record->flags);
+		break;
+	case SWAP_LATENCY_BACKEND_ZSWAP:
+		atomic_or(SWAP_LATENCY_F_ZSWAP | SWAP_LATENCY_F_NO_IO,
+				&record->flags);
+		break;
+	default:
+		break;
+	}
+}
+
+static void swap_latency_fill_header(struct swap_latency_buffer *buffer)
+{
+	struct swap_latency_log_header *header = swap_latency_header(buffer);
+	u64 records = min_t(u64, atomic64_read(&buffer->next_record),
+			buffer->capacity);
+
+	header->records = records;
+	header->dropped = atomic64_read(&buffer->dropped);
+	header->stop_ns = READ_ONCE(buffer->stop_ns);
+	header->stopped_full = READ_ONCE(buffer->stopped_full);
+	header->enabled = atomic_read(&swap_latency_enabled);
+}
+
+static void swap_latency_stop_and_drain(void)
+{
+	struct swap_latency_buffer *buffer;
+
+	atomic_set(&swap_latency_enabled, 0);
+	/* Prevent a reserving writer from publishing after the disable. */
+	smp_mb();
+	/* Release retry states whose fault will never re-enter do_swap_page(). */
+	swap_latency_retry_drain();
+	synchronize_rcu();
+	wait_event(swap_latency_active_wait,
+			!atomic_read(&swap_latency_active));
+
+	buffer = rcu_dereference_protected(swap_latency_buffer,
+			lockdep_is_held(&swap_latency_control_lock));
+	if (!buffer || READ_ONCE(buffer->sealed))
+		return;
+	if (!READ_ONCE(buffer->stop_ns))
+		WRITE_ONCE(buffer->stop_ns, ktime_get_ns());
+	swap_latency_fill_header(buffer);
+	WRITE_ONCE(buffer->sealed, true);
+}
+
+static void swap_latency_stop_full(struct swap_latency_buffer *buffer,
+		bool dropped)
+{
+	if (dropped)
+		atomic64_inc(&buffer->dropped);
+	WRITE_ONCE(buffer->stopped_full, true);
+	(void)cmpxchg64(&buffer->stop_ns, 0, ktime_get_ns());
+	if (atomic_cmpxchg(&swap_latency_enabled, 1, 0) == 1 &&
+		atomic_cmpxchg(&buffer->full_reported, 0, 1) == 0)
+		pr_info("swap_latency: log full at %llu records (%lu bytes); "
+			"tracing disabled\n", buffer->capacity, buffer->bytes);
+}
+
+static struct swap_latency_record *swap_latency_reserve(
+		struct swap_latency_call *call, struct swap_info_struct *sis)
+{
+	struct swap_latency_buffer *buffer;
+	struct swap_latency_record *record;
+	u64 reserve_begin_ns;
+	u64 index;
+	u32 cpu;
+	unsigned int scope;
+
+	if (!call->call_begin_ns || !call->session ||
+		!swap_latency_enabled_now())
+		return NULL;
+	reserve_begin_ns = ktime_get_ns();
+
+	rcu_read_lock();
+	if (!swap_latency_enabled_now())
+		goto out_rcu;
+	buffer = rcu_dereference(swap_latency_buffer);
+	if (!buffer)
+		goto out_rcu;
+	atomic_inc(&swap_latency_active);
+	/* Pair with the disable-side recheck before waiting for active writers. */
+	smp_mb__after_atomic();
+	if (!swap_latency_enabled_now() || READ_ONCE(buffer->sealed) ||
+		READ_ONCE(buffer->stopped_full) ||
+		call->session != READ_ONCE(buffer->session) ||
+		call->call_begin_ns < READ_ONCE(buffer->start_ns)) {
+		swap_latency_active_put();
+		goto out_rcu;
+	}
+	rcu_read_unlock();
+
+	preempt_disable();
+	index = atomic64_fetch_inc_relaxed(&buffer->next_record);
+	cpu = raw_smp_processor_id();
+	preempt_enable();
+	if (unlikely(index >= buffer->capacity)) {
+		swap_latency_stop_full(buffer, true);
+		swap_latency_active_put();
+		return NULL;
+	}
+	if (unlikely(index == buffer->capacity - 1))
+		swap_latency_stop_full(buffer, false);
+
+	record = swap_latency_record_at(buffer, index);
+	memset(record, 0, sizeof(*record));
+	atomic_set(&record->flags, 0);
+	atomic_set(&record->pending, 1);
+	record->version = SWAP_LATENCY_FORMAT_VERSION;
+	record->type = call->type;
+	record->size = sizeof(*record);
+	record->seq = index;
+	record->session = buffer->session;
+	record->call_begin_ns = call->call_begin_ns;
+	record->swap_entry = call->entry.val;
+	record->address = call->address;
+	record->pid = current->pid;
+	record->tgid = current->tgid;
+	record->cpu = cpu;
+	record->nr_pages = 1;
+	if (call->type == SWAP_LATENCY_RECORD_SWAPIN) {
+		record->extension_version = SWAP_LATENCY_VENDOR_EXT_VERSION;
+	} else {
+		record->extension_version = SWAP_LATENCY_SWAPOUT_EXT_VERSION;
+		atomic_set(&record->extension.swapout.submit_state,
+				SWAP_LATENCY_SWAPOUT_SUBMIT_NONE);
+		atomic_set(&record->extension.swapout.evidence_flags, 0);
+	}
+	memcpy(record->comm, current->comm, sizeof(record->comm));
+	if (sis) {
+		/* The swap flags can change during swapoff; keep this diagnostic-only. */
+		record->sis_flags = data_race(sis->flags);
+		swap_latency_set_backend(record,
+				swap_latency_classify(sis));
+		if (sis->bdev)
+			record->dev = new_encode_dev(sis->bdev->bd_dev);
+		else if (sis->swap_file)
+			record->dev = new_encode_dev(
+				file_inode(sis->swap_file)->i_sb->s_dev);
+	}
+	if (call->type == SWAP_LATENCY_RECORD_SWAPIN)
+		atomic_or(SWAP_LATENCY_F_READ, &record->flags);
+	else
+		atomic_or(SWAP_LATENCY_F_WRITE, &record->flags);
+
+	call->record = record;
+	call->task = current;
+	call->target_io_claimed = false;
+	if (call->type == SWAP_LATENCY_RECORD_SWAPIN) {
+		scope = swap_latency_scope_index(current);
+		INIT_HLIST_NODE(&call->scope_node);
+		spin_lock(&swap_latency_scopes[scope].lock);
+		hlist_add_head(&call->scope_node,
+			&swap_latency_scopes[scope].scopes);
+		call->registered = true;
+		spin_unlock(&swap_latency_scopes[scope].lock);
+	}
+	record->reserve_ns = ktime_get_ns() - reserve_begin_ns;
+	return record;
+
+out_rcu:
+	rcu_read_unlock();
+	return NULL;
+}
+
+void swap_latency_call_prepare(struct swap_latency_call *call, u16 type,
+		unsigned long address)
+{
+	call->record = NULL;
+	call->call_begin_ns = 0;
+	if (!swap_latency_enabled_now())
+		return;
+	memset(call, 0, sizeof(*call));
+	call->type = type;
+	call->address = address;
+	call->session = atomic64_read(&swap_latency_next_session);
+	call->call_begin_ns = swap_latency_sched_interval_begin(
+		&call->sched_begin);
+}
+
+void swap_latency_call_start(struct swap_latency_call *call, swp_entry_t entry,
+				struct swap_info_struct *sis, unsigned int fault_flags)
+{
+	struct swap_latency_retry *retry;
+
+	if (!call->call_begin_ns)
+		return;
+	call->entry = entry;
+	if (call->type == SWAP_LATENCY_RECORD_SWAPIN &&
+	    (fault_flags & FAULT_FLAG_TRIED)) {
+		retry = swap_latency_retry_take(call);
+		if (retry) {
+			/* Keep the current attempt in case its lookup is a miss. */
+			call->attempt_begin_ns = call->call_begin_ns;
+			call->attempt_sched_begin = call->sched_begin;
+			call->retry = retry;
+			call->record = retry->record;
+			call->call_begin_ns = retry->call_begin_ns;
+			call->sched_begin = retry->sched_begin;
+			call->task = current;
+			/* The original miss already claimed the target read I/O. */
+			call->target_io_claimed = true;
+			return;
+		}
+	}
+	swap_latency_reserve(call, sis);
+}
+
+bool swap_latency_call_retry_cache_hit(struct swap_latency_call *call)
+{
+	struct swap_latency_record *record;
+
+	if (!call || !call->record || !call->retry)
+		return false;
+	record = call->record;
+	/* The retry lookup completes the original miss; it is not a new hit. */
+	atomic_andnot(SWAP_LATENCY_F_RETRY, &record->flags);
+	record->result &= ~VM_FAULT_RETRY;
+	call->retry_merged = true;
+	return true;
+}
+
+void swap_latency_call_retry_cache_miss(struct swap_latency_call *call,
+		struct swap_info_struct *sis)
+{
+	struct swap_latency_retry *retry;
+	struct swap_latency_record *record;
+
+	if (!call || !call->record || !call->retry)
+		return;
+	retry = call->retry;
+	record = call->record;
+	call->retry = NULL;
+	call->record = NULL;
+	call->retry_merged = false;
+	call->call_begin_ns = call->attempt_begin_ns;
+	call->sched_begin = call->attempt_sched_begin;
+	call->target_io_claimed = false;
+	swap_latency_retry_free(retry);
+	swap_latency_record_put(record);
+	swap_latency_reserve(call, sis);
+}
+
+void swap_latency_call_mark(struct swap_latency_call *call, u32 flags,
+		enum swap_latency_backend backend)
+{
+	struct swap_latency_record *record;
+
+	if (!call)
+		return;
+	record = call->record;
+	if (!record)
+		return;
+	if (flags)
+		atomic_or(flags, &record->flags);
+	if (backend != SWAP_LATENCY_BACKEND_UNKNOWN)
+		swap_latency_set_backend(record, backend);
+}
+
+static bool swap_latency_entry_in_folio(const struct swap_latency_call *call,
+		struct folio *folio)
+{
+	swp_entry_t base = page_swap_entry(&folio->page);
+	unsigned long nr = folio_nr_pages(folio);
+	unsigned long offset;
+
+	if (swp_type(base) != swp_type(call->entry))
+		return false;
+	if (swp_offset(call->entry) < swp_offset(base))
+		return false;
+	offset = swp_offset(call->entry) - swp_offset(base);
+	return offset < nr;
+}
+
+static struct swap_latency_record *swap_latency_find_target(
+		struct folio *folio)
+{
+	struct swap_latency_call *scope_call;
+	struct swap_latency_record *record = NULL;
+	unsigned int bucket;
+
+	if (!folio || !atomic_read(&swap_latency_active))
+		return NULL;
+
+	bucket = swap_latency_scope_index(current);
+	spin_lock(&swap_latency_scopes[bucket].lock);
+	hlist_for_each_entry(scope_call,
+			&swap_latency_scopes[bucket].scopes, scope_node) {
+		if (scope_call->task != current ||
+			scope_call->target_io_claimed ||
+			!swap_latency_entry_in_folio(scope_call, folio))
+			continue;
+		record = scope_call->record;
+		break;
+	}
+	spin_unlock(&swap_latency_scopes[bucket].lock);
+	return record;
+}
+
+void swap_latency_vendor_hook_begin(struct swap_latency_vendor_hook *hook,
+		struct folio *folio, bool restricted)
+{
+	hook->record = NULL;
+	hook->begin_ns = 0;
+	hook->restricted = restricted;
+	hook->record = swap_latency_find_target(folio);
+	if (hook->record) {
+		if (restricted) {
+			hook->begin_ns = swap_latency_sched_interval_begin(
+				&hook->sched_begin);
+		} else {
+			hook->begin_ns = ktime_get_ns();
+		}
+	}
+}
+
+void swap_latency_vendor_hook_end(struct swap_latency_vendor_hook *hook,
+		struct folio *folio, bool handled)
+{
+	struct swap_latency_record *record = hook->record;
+	struct swap_latency_sched_snapshot sched_end;
+	u32 flags;
+	u64 end_ns;
+
+	if (!record)
+		return;
+
+	if (hook->restricted)
+		end_ns = swap_latency_sched_interval_end(&sched_end);
+	else
+		end_ns = ktime_get_ns();
+	if (hook->restricted) {
+		record->extension.swapin.rvh_begin_ns = hook->begin_ns;
+		record->extension.swapin.rvh_end_ns = end_ns;
+		flags = SWAP_LATENCY_VENDOR_F_RVH_CALLED;
+		if (handled)
+			flags |= SWAP_LATENCY_VENDOR_F_RVH_HANDLED;
+		if (folio_test_uptodate(folio))
+			flags |= SWAP_LATENCY_VENDOR_F_RVH_RETURN_UPTODATE;
+		if (folio_test_locked(folio))
+			flags |= SWAP_LATENCY_VENDOR_F_RVH_RETURN_LOCKED;
+		flags |= swap_latency_store_rvh_sched(record,
+			&hook->sched_begin, &sched_end);
+	} else {
+		record->extension.swapin.vh_begin_ns = hook->begin_ns;
+		record->extension.swapin.vh_end_ns = end_ns;
+		flags = SWAP_LATENCY_VENDOR_F_VH_CALLED;
+		if (handled)
+			flags |= SWAP_LATENCY_VENDOR_F_VH_HANDLED;
+		if (folio_test_uptodate(folio))
+			flags |= SWAP_LATENCY_VENDOR_F_VH_RETURN_UPTODATE;
+		if (folio_test_locked(folio))
+			flags |= SWAP_LATENCY_VENDOR_F_VH_RETURN_LOCKED;
+	}
+	record->extension.swapin.flags |= flags;
+	hook->record = NULL;
+}
+
+void swap_latency_vendor_wait_begin(struct swap_latency_call *call)
+{
+	struct swap_latency_record *record;
+
+	if (!call)
+		return;
+	record = call->record;
+	if (!record ||
+		!(atomic_read(&record->flags) & SWAP_LATENCY_F_VENDOR_BYPASS))
+		return;
+	record->extension.swapin.wait_begin_ns = ktime_get_ns();
+}
+
+void swap_latency_vendor_wait_end(struct swap_latency_call *call)
+{
+	struct swap_latency_record *record;
+
+	if (!call)
+		return;
+	record = call->record;
+	if (!record || !record->extension.swapin.wait_begin_ns)
+		return;
+	record->extension.swapin.wait_end_ns = ktime_get_ns();
+	record->extension.swapin.flags |= SWAP_LATENCY_VENDOR_F_WAIT_VALID;
+}
+
+static bool swap_latency_is_swapout_v2(
+		const struct swap_latency_record *record)
+{
+	return record && record->type == SWAP_LATENCY_RECORD_SWAPOUT &&
+		record->extension_version == SWAP_LATENCY_SWAPOUT_EXT_VERSION;
+}
+
+void swap_latency_swapout_hook_begin(struct swap_latency_call *call,
+		unsigned long flags_before, bool hook_enabled)
+{
+	struct swap_latency_record *record = call ? call->record : NULL;
+
+	if (!swap_latency_is_swapout_v2(record))
+		return;
+	record->extension.swapout.flags_before = flags_before;
+	record->extension.swapout.hook_begin_ns = ktime_get_ns();
+	if (hook_enabled)
+		atomic_or(SWAP_LATENCY_SWAPOUT_E_HOOK_ENABLED,
+				&record->extension.swapout.evidence_flags);
+}
+
+void swap_latency_swapout_hook_end(struct swap_latency_call *call,
+		unsigned long flags_after)
+{
+	struct swap_latency_record *record = call ? call->record : NULL;
+	u64 end_ns;
+
+	if (!swap_latency_is_swapout_v2(record) ||
+		!record->extension.swapout.hook_begin_ns)
+		return;
+	end_ns = ktime_get_ns();
+	record->extension.swapout.hook_end_ns = end_ns;
+	record->extension.swapout.flags_after = flags_after;
+	if (record->extension.swapout.flags_before != flags_after)
+		atomic_or(SWAP_LATENCY_SWAPOUT_E_HOOK_FLAGS_CHANGED,
+				&record->extension.swapout.evidence_flags);
+}
+
+void swap_latency_swapout_helper_enter(struct swap_latency_call *call,
+		enum swap_latency_swapout_helper helper)
+{
+	struct swap_latency_record *record = call ? call->record : NULL;
+
+	if (!swap_latency_is_swapout_v2(record))
+		return;
+	record->extension.swapout.helper = helper;
+	record->extension.swapout.helper_begin_ns = ktime_get_ns();
+}
+
+static struct swap_latency_record *swap_latency_claim_target(
+		struct swap_latency_call *call, struct folio *folio, bool async)
+{
+	struct swap_latency_record *record;
+	struct swap_latency_call *scope_call;
+	struct hlist_node *node;
+	unsigned int bucket;
+
+	if (call) {
+		if (!call->record || call->target_io_claimed ||
+			!swap_latency_entry_in_folio(call, folio))
+			return NULL;
+		call->target_io_claimed = true;
+		record = call->record;
+		if (async)
+			atomic_inc(&record->pending);
+		return record;
+	}
+
+	if (!atomic_read(&swap_latency_active))
+		return NULL;
+	bucket = swap_latency_scope_index(current);
+	spin_lock(&swap_latency_scopes[bucket].lock);
+	hlist_for_each_entry_safe(scope_call, node,
+			&swap_latency_scopes[bucket].scopes, scope_node) {
+		if (scope_call->task != current || scope_call->target_io_claimed ||
+			!swap_latency_entry_in_folio(scope_call, folio))
+			continue;
+		scope_call->target_io_claimed = true;
+		record = scope_call->record;
+		if (async)
+			atomic_inc(&record->pending);
+		spin_unlock(&swap_latency_scopes[bucket].lock);
+		return record;
+	}
+	spin_unlock(&swap_latency_scopes[bucket].lock);
+	return NULL;
+}
+
+void swap_latency_target_mark(struct swap_latency_call *call,
+		struct folio *folio, u32 flags, enum swap_latency_backend backend)
+{
+	struct swap_latency_record *record;
+
+	record = swap_latency_claim_target(call, folio, false);
+	if (!record)
+		return;
+	if (flags)
+		atomic_or(flags, &record->flags);
+	if (backend != SWAP_LATENCY_BACKEND_UNKNOWN)
+		swap_latency_set_backend(record, backend);
+	if (folio) {
+		record->order = folio_order(folio);
+		record->nr_pages = folio_nr_pages(folio);
+	}
+}
+
+static void swap_latency_swapout_state_error(
+		struct swap_latency_record *record)
+{
+	if (swap_latency_is_swapout_v2(record))
+		atomic_or(SWAP_LATENCY_SWAPOUT_E_STATE_ERROR,
+				&record->extension.swapout.evidence_flags);
+}
+
+static void swap_latency_swapout_io_begin(
+		struct swap_latency_record *record, struct swap_info_struct *sis,
+		bool synchronous)
+{
+	struct swap_latency_swapout_extension *extension;
+	u32 evidence = 0;
+
+	if (!swap_latency_is_swapout_v2(record))
+		return;
+	extension = &record->extension.swapout;
+	if (sis && sis->bdev) {
+		if (bdev_synchronous(sis->bdev))
+			evidence |= SWAP_LATENCY_SWAPOUT_E_QUEUE_SYNCHRONOUS;
+		if (READ_ONCE(sis->bdev->bd_has_submit_bio))
+			evidence |= SWAP_LATENCY_SWAPOUT_E_BDEV_HAS_SUBMIT_BIO;
+	}
+	if (evidence)
+		atomic_or(evidence, &extension->evidence_flags);
+	if (atomic_cmpxchg(&extension->submit_state,
+			SWAP_LATENCY_SWAPOUT_SUBMIT_NONE,
+			synchronous ? SWAP_LATENCY_SWAPOUT_SYNC_WAIT_ACTIVE :
+			SWAP_LATENCY_SWAPOUT_ASYNC_SUBMIT_ACTIVE) !=
+			SWAP_LATENCY_SWAPOUT_SUBMIT_NONE)
+		swap_latency_swapout_state_error(record);
+}
+
+static void swap_latency_swapout_submit_return(
+		struct swap_latency_record *record, bool synchronous)
+{
+	struct swap_latency_swapout_extension *extension;
+	int old;
+
+	if (!swap_latency_is_swapout_v2(record))
+		return;
+	extension = &record->extension.swapout;
+	/*
+	 * The cmpxchg is the return marker.  It orders a racing async end_io
+	 * without touching the bio, which may already have been freed.
+	 */
+	preempt_disable();
+	if (synchronous) {
+		old = atomic_cmpxchg(&extension->submit_state,
+				SWAP_LATENCY_SWAPOUT_SYNC_WAIT_ACTIVE,
+				SWAP_LATENCY_SWAPOUT_SYNC_WAIT_RETURNED_COMPLETE);
+		if (old != SWAP_LATENCY_SWAPOUT_SYNC_WAIT_ACTIVE)
+			swap_latency_swapout_state_error(record);
+	} else {
+		old = atomic_cmpxchg(&extension->submit_state,
+				SWAP_LATENCY_SWAPOUT_ASYNC_SUBMIT_ACTIVE,
+				SWAP_LATENCY_SWAPOUT_ASYNC_RETURNED_PENDING);
+		if (old != SWAP_LATENCY_SWAPOUT_ASYNC_SUBMIT_ACTIVE &&
+			old !=
+			SWAP_LATENCY_SWAPOUT_ASYNC_ENDIO_BEFORE_RETURN_MARKER)
+			swap_latency_swapout_state_error(record);
+	}
+	extension->submit_return_cpu = raw_smp_processor_id();
+	preempt_enable();
+}
+
+static void swap_latency_swapout_async_complete(
+		struct swap_latency_record *record)
+{
+	struct swap_latency_swapout_extension *extension;
+	int old;
+	u32 evidence = 0;
+
+	if (!swap_latency_is_swapout_v2(record))
+		return;
+	extension = &record->extension.swapout;
+	/* Whichever cmpxchg wins classifies completion around the return marker. */
+	old = atomic_cmpxchg(&extension->submit_state,
+			SWAP_LATENCY_SWAPOUT_ASYNC_SUBMIT_ACTIVE,
+			SWAP_LATENCY_SWAPOUT_ASYNC_ENDIO_BEFORE_RETURN_MARKER);
+	if (old == SWAP_LATENCY_SWAPOUT_ASYNC_RETURNED_PENDING) {
+		old = atomic_cmpxchg(&extension->submit_state,
+				SWAP_LATENCY_SWAPOUT_ASYNC_RETURNED_PENDING,
+				SWAP_LATENCY_SWAPOUT_ASYNC_ENDIO_AFTER_RETURN_MARKER);
+		if (old != SWAP_LATENCY_SWAPOUT_ASYNC_RETURNED_PENDING)
+			swap_latency_swapout_state_error(record);
+	} else if (old != SWAP_LATENCY_SWAPOUT_ASYNC_SUBMIT_ACTIVE) {
+		swap_latency_swapout_state_error(record);
+	}
+	if (in_task())
+		evidence |= SWAP_LATENCY_SWAPOUT_E_COMPLETION_IN_TASK;
+	if (in_serving_softirq())
+		evidence |= SWAP_LATENCY_SWAPOUT_E_COMPLETION_IN_SOFTIRQ;
+	if (evidence)
+		atomic_or(evidence, &extension->evidence_flags);
+}
+
+void *swap_latency_io_begin(struct swap_latency_call *call,
+		struct folio *folio, struct swap_info_struct *sis, bool write,
+		bool synchronous, bool direct, sector_t sector, size_t bytes)
+{
+	struct swap_latency_record *record;
+	u32 cpu;
+	u64 begin_ns;
+
+	/* Unscoped writes are zswap writeback, not a swap_writepage call. */
+	if (write && !call)
+		return NULL;
+	record = swap_latency_claim_target(call, folio, !synchronous);
+	if (!record)
+		return NULL;
+
+	record->sector = sector;
+	record->io_bytes = bytes;
+	record->order = folio_order(folio);
+	record->nr_pages = folio_nr_pages(folio);
+	preempt_disable();
+	cpu = raw_smp_processor_id();
+	preempt_enable();
+	record->submit_cpu = cpu;
+	atomic_or(SWAP_LATENCY_F_BIO | SWAP_LATENCY_F_BDEV |
+			(write ? SWAP_LATENCY_F_WRITE : SWAP_LATENCY_F_READ) |
+			(synchronous ? SWAP_LATENCY_F_SYNC : SWAP_LATENCY_F_ASYNC) |
+			(direct ? SWAP_LATENCY_F_DIRECT : 0), &record->flags);
+	if (sis) {
+		/* The swap flags can change during swapoff; keep this diagnostic-only. */
+		record->sis_flags = data_race(sis->flags);
+	}
+	if (write)
+		swap_latency_swapout_io_begin(record, sis, synchronous);
+	/* Timestamp last so trace bookkeeping is not charged to the bio. */
+	begin_ns = ktime_get_ns();
+	record->submit_begin_ns = begin_ns;
+	record->device_begin_ns = begin_ns;
+	return record;
+}
+
+void swap_latency_submit_end(void *token)
+{
+	struct swap_latency_record *record = token;
+
+	if (!record)
+		return;
+	swap_latency_swapout_submit_return(record, false);
+	record->submit_end_ns = ktime_get_ns();
+	atomic_or(SWAP_LATENCY_F_SUBMIT_VALID, &record->flags);
+}
+
+void swap_latency_sync_io_end(void *token, blk_status_t status)
+{
+	struct swap_latency_record *record = token;
+	u64 end_ns;
+
+	if (!record)
+		return;
+	swap_latency_swapout_submit_return(record, true);
+	end_ns = ktime_get_ns();
+	record->submit_end_ns = end_ns;
+	record->device_end_ns = end_ns;
+	record->bio_status = blk_status_to_errno(status);
+	if (status)
+		atomic_or(SWAP_LATENCY_F_ERROR, &record->flags);
+	atomic_or(SWAP_LATENCY_F_SUBMIT_VALID |
+			SWAP_LATENCY_F_DEVICE_VALID, &record->flags);
+	preempt_disable();
+	record->complete_cpu = raw_smp_processor_id();
+	preempt_enable();
+}
+
+void swap_latency_async_io_complete(void *token, blk_status_t status)
+{
+	struct swap_latency_record *record = token;
+
+	if (!record)
+		return;
+	preempt_disable();
+	swap_latency_swapout_async_complete(record);
+	record->device_end_ns = ktime_get_ns();
+	record->bio_status = blk_status_to_errno(status);
+	if (status)
+		atomic_or(SWAP_LATENCY_F_ERROR, &record->flags);
+	atomic_or(SWAP_LATENCY_F_DEVICE_VALID, &record->flags);
+	record->complete_cpu = raw_smp_processor_id();
+	preempt_enable();
+}
+
+static void swap_latency_record_finish(struct swap_latency_record *record)
+{
+	u32 flags;
+	u64 call_ns, overlap = 0;
+	u64 call_begin, call_end, device_begin, device_end;
+
+	flags = atomic_read(&record->flags);
+	call_begin = READ_ONCE(record->call_begin_ns);
+	call_end = READ_ONCE(record->call_end_ns);
+	call_ns = call_end >= call_begin ? call_end - call_begin : 0;
+	if ((flags & SWAP_LATENCY_F_DEVICE_VALID) &&
+		READ_ONCE(record->device_end_ns) >=
+			READ_ONCE(record->device_begin_ns)) {
+		device_begin = READ_ONCE(record->device_begin_ns);
+		device_end = READ_ONCE(record->device_end_ns);
+		if (device_begin < call_end && device_end > call_begin) {
+			u64 begin = max(device_begin, call_begin);
+			u64 end = min(device_end, call_end);
+
+			if (end > begin)
+				overlap = end - begin;
+		}
+	}
+	if (!(flags & (SWAP_LATENCY_F_BIO |
+			SWAP_LATENCY_F_UNTRACKED_IO |
+			SWAP_LATENCY_F_ZSWAP)))
+		atomic_or(SWAP_LATENCY_F_NO_IO, &record->flags);
+	if (call_ns > overlap)
+		call_ns -= overlap;
+	else
+		call_ns = 0;
+	record->kernel_ns = call_ns > record->reserve_ns ?
+		call_ns - record->reserve_ns : 0;
+	atomic_or(SWAP_LATENCY_F_CALL_VALID, &record->flags);
+	/* Publish all fields, including flags, before the reader sees magic. */
+	smp_store_release(&record->magic, SWAP_LATENCY_RECORD_MAGIC);
+	swap_latency_active_put();
+}
+
+static void swap_latency_record_put(struct swap_latency_record *record)
+{
+	if (record && atomic_dec_and_test(&record->pending))
+		swap_latency_record_finish(record);
+}
+
+void swap_latency_call_end(struct swap_latency_call *call, s32 result)
+{
+	struct swap_latency_record *record = call->record;
+	struct swap_latency_sched_snapshot sched_end;
+	u64 end_ns;
+	unsigned int bucket;
+
+	if (!record)
+		return;
+	end_ns = swap_latency_sched_interval_end(&sched_end);
+	record->call_end_ns = end_ns;
+	/* A merged retry is one major miss even when its final return is zero. */
+	if (call->retry_merged)
+		result |= record->result & VM_FAULT_MAJOR;
+	record->result = result;
+	swap_latency_store_root_sched(record, &call->sched_begin, &sched_end);
+	if (call->type == SWAP_LATENCY_RECORD_SWAPIN) {
+		if (result & VM_FAULT_ERROR)
+			atomic_or(SWAP_LATENCY_F_ERROR, &record->flags);
+		if (result & VM_FAULT_RETRY)
+			atomic_or(SWAP_LATENCY_F_RETRY, &record->flags);
+		else if (call->retry_merged)
+			atomic_andnot(SWAP_LATENCY_F_RETRY, &record->flags);
+		if (call->registered) {
+			bucket = swap_latency_scope_index(call->task);
+			spin_lock(&swap_latency_scopes[bucket].lock);
+			hlist_del_init(&call->scope_node);
+			call->registered = false;
+			spin_unlock(&swap_latency_scopes[bucket].lock);
+		}
+		if ((result & VM_FAULT_RETRY) &&
+		    swap_latency_retry_queue(call)) {
+			/* The pending state now owns this call's record reference. */
+			call->record = NULL;
+			return;
+		}
+	} else if (result) {
+		atomic_or(SWAP_LATENCY_F_ERROR, &record->flags);
+	}
+	if (call->retry) {
+		swap_latency_retry_free(call->retry);
+		call->retry = NULL;
+	}
+	call->record = NULL;
+	swap_latency_record_put(record);
+}
+
+
+void swap_latency_async_io_put(void *token)
+{
+	swap_latency_record_put(token);
+}
+
+static struct swap_latency_buffer *swap_latency_alloc_buffer(unsigned int mb)
+{
+	struct swap_latency_buffer *buffer;
+	struct swap_latency_log_header *header;
+	u64 bytes64 = (u64)mb << 20;
+	unsigned long bytes;
+	void *memory;
+
+	if (bytes64 > ULONG_MAX || bytes64 <= SWAP_LATENCY_HEADER_SIZE)
+		return ERR_PTR(-E2BIG);
+	bytes = bytes64;
+	buffer = kzalloc(sizeof(*buffer), GFP_KERNEL);
+	if (!buffer)
+		return ERR_PTR(-ENOMEM);
+	memory = __vmalloc(bytes, GFP_KERNEL | __GFP_NOWARN);
+	if (!memory) {
+		kfree(buffer);
+		return ERR_PTR(-ENOMEM);
+	}
+	buffer->memory = memory;
+	buffer->bytes = bytes;
+	buffer->capacity = (bytes - SWAP_LATENCY_HEADER_SIZE) /
+			SWAP_LATENCY_RECORD_SIZE;
+	atomic64_set(&buffer->next_record, 0);
+	atomic64_set(&buffer->dropped, 0);
+	atomic_set(&buffer->full_reported, 0);
+	header = swap_latency_header(buffer);
+	memset(header, 0, sizeof(*header));
+	memcpy(header->magic, "SWPLAT", 6);
+	header->version = SWAP_LATENCY_FORMAT_VERSION;
+	header->header_size = SWAP_LATENCY_HEADER_SIZE;
+	header->record_size = SWAP_LATENCY_RECORD_SIZE;
+	header->endian = SWAP_LATENCY_ENDIAN_MARKER;
+	header->buffer_bytes = bytes;
+	header->capacity = buffer->capacity;
+	strscpy(header->kernel_release, init_utsname()->release,
+			 sizeof(header->kernel_release));
+	return buffer;
+}
+
+static void swap_latency_free_buffer(struct swap_latency_buffer *buffer)
+{
+	if (!buffer)
+		return;
+	vfree(buffer->memory);
+	kfree(buffer);
+}
+
+static void swap_latency_init_header(struct swap_latency_buffer *buffer)
+{
+	struct swap_latency_log_header *header = swap_latency_header(buffer);
+
+	memset(header, 0, sizeof(*header));
+	memcpy(header->magic, "SWPLAT", 6);
+	header->version = SWAP_LATENCY_FORMAT_VERSION;
+	header->header_size = SWAP_LATENCY_HEADER_SIZE;
+	header->record_size = SWAP_LATENCY_RECORD_SIZE;
+	header->endian = SWAP_LATENCY_ENDIAN_MARKER;
+	header->buffer_bytes = buffer->bytes;
+	header->capacity = buffer->capacity;
+	header->session = buffer->session;
+	header->start_ns = buffer->start_ns;
+	header->enabled = 1;
+	strscpy(header->kernel_release, init_utsname()->release,
+			 sizeof(header->kernel_release));
+}
+
+static int swap_latency_start(void)
+{
+	struct swap_latency_buffer *buffer;
+	unsigned int requested_mb;
+	u64 requested_bytes;
+	int ret = 0;
+
+	mutex_lock(&swap_latency_control_lock);
+	if (atomic_read(&swap_latency_enabled))
+		goto out_unlock;
+	if (swap_latency_readers) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	requested_mb = READ_ONCE(swap_latency_buffer_mb);
+	requested_bytes = (u64)requested_mb << 20;
+	swap_latency_stop_and_drain();
+	buffer = rcu_dereference_protected(swap_latency_buffer,
+			lockdep_is_held(&swap_latency_control_lock));
+	if (buffer && buffer->bytes != requested_bytes) {
+		/* Changing size requires an explicit reset first. */
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	if (!buffer) {
+		buffer = swap_latency_alloc_buffer(requested_mb);
+		if (IS_ERR(buffer)) {
+			ret = PTR_ERR(buffer);
+			pr_err("swap_latency: failed to allocate %u MiB log: %d\n",
+				requested_mb, ret);
+			goto out_unlock;
+		}
+		rcu_assign_pointer(swap_latency_buffer, buffer);
+	}
+
+	atomic64_set(&buffer->next_record, 0);
+	atomic64_set(&buffer->dropped, 0);
+	atomic_set(&buffer->full_reported, 0);
+	buffer->session = atomic64_inc_return(&swap_latency_next_session);
+	buffer->start_ns = ktime_get_ns();
+	buffer->stop_ns = 0;
+	buffer->stopped_full = false;
+	buffer->sealed = false;
+	swap_latency_init_header(buffer);
+	atomic_set_release(&swap_latency_enabled, 1);
+	pr_info("swap_latency: session=%llu started, buffer=%lu bytes, capacity=%llu records\n",
+		buffer->session, buffer->bytes,
+		buffer->capacity);
+
+out_unlock:
+	mutex_unlock(&swap_latency_control_lock);
+	return ret;
+}
+
+static void swap_latency_stop(void)
+{
+	mutex_lock(&swap_latency_control_lock);
+	swap_latency_stop_and_drain();
+	mutex_unlock(&swap_latency_control_lock);
+}
+
+static ssize_t swap_latency_enable_read(struct file *file, char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	char value[4];
+	int len = scnprintf(value, sizeof(value), "%d\n",
+			atomic_read(&swap_latency_enabled));
+
+	return simple_read_from_buffer(buf, count, ppos, value, len);
+}
+
+static ssize_t swap_latency_enable_write(struct file *file,
+		const char __user *buf, size_t count, loff_t *ppos)
+{
+	bool enable;
+	int ret = kstrtobool_from_user(buf, count, &enable);
+
+	if (ret)
+		return ret;
+	if (enable) {
+		ret = swap_latency_start();
+		if (ret)
+			return ret;
+	} else {
+		swap_latency_stop();
+	}
+	return count;
+}
+
+static const struct file_operations swap_latency_enable_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = swap_latency_enable_read,
+	.write = swap_latency_enable_write,
+	.llseek = default_llseek,
+};
+
+static ssize_t swap_latency_buffer_mb_read(struct file *file,
+		char __user *buf, size_t count, loff_t *ppos)
+{
+	char value[24];
+	int len = scnprintf(value, sizeof(value), "%u\n",
+			READ_ONCE(swap_latency_buffer_mb));
+
+	return simple_read_from_buffer(buf, count, ppos, value, len);
+}
+
+static ssize_t swap_latency_buffer_mb_write(struct file *file,
+		const char __user *buf, size_t count, loff_t *ppos)
+{
+	struct swap_latency_buffer *buffer;
+	unsigned int mb;
+	int ret;
+
+	ret = kstrtouint_from_user(buf, count, 0, &mb);
+	if (ret)
+		return ret;
+	if (mb < SWAP_LATENCY_MIN_MB || mb > SWAP_LATENCY_MAX_MB)
+		return -ERANGE;
+	mutex_lock(&swap_latency_control_lock);
+	buffer = rcu_dereference_protected(swap_latency_buffer,
+			lockdep_is_held(&swap_latency_control_lock));
+	if (atomic_read(&swap_latency_enabled) || swap_latency_readers ||
+		(buffer && buffer->bytes != ((u64)mb << 20)))
+		ret = -EBUSY;
+	else
+		WRITE_ONCE(swap_latency_buffer_mb, mb);
+	mutex_unlock(&swap_latency_control_lock);
+	return ret ? ret : count;
+}
+
+static const struct file_operations swap_latency_buffer_mb_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = swap_latency_buffer_mb_read,
+	.write = swap_latency_buffer_mb_write,
+	.llseek = default_llseek,
+};
+
+static ssize_t swap_latency_reset_write(struct file *file,
+		const char __user *buf, size_t count, loff_t *ppos)
+{
+	struct swap_latency_buffer *buffer;
+	bool reset;
+	int ret = kstrtobool_from_user(buf, count, &reset);
+
+	if (ret)
+		return ret;
+	if (!reset)
+		return count;
+	mutex_lock(&swap_latency_control_lock);
+	if (swap_latency_readers) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	swap_latency_stop_and_drain();
+	buffer = rcu_dereference_protected(swap_latency_buffer,
+			lockdep_is_held(&swap_latency_control_lock));
+	RCU_INIT_POINTER(swap_latency_buffer, NULL);
+	swap_latency_free_buffer(buffer);
+	ret = 0;
+out_unlock:
+	mutex_unlock(&swap_latency_control_lock);
+	return ret ? ret : count;
+}
+
+static const struct file_operations swap_latency_reset_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = swap_latency_reset_write,
+	.llseek = no_llseek,
+};
+
+static int swap_latency_log_open(struct inode *inode, struct file *file)
+{
+	struct swap_latency_reader *reader;
+	struct swap_latency_buffer *buffer;
+	u64 records;
+	int ret = 0;
+
+	mutex_lock(&swap_latency_control_lock);
+	if (atomic_read(&swap_latency_enabled)) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	swap_latency_stop_and_drain();
+	buffer = rcu_dereference_protected(swap_latency_buffer,
+			lockdep_is_held(&swap_latency_control_lock));
+	if (!buffer) {
+		ret = -ENODATA;
+		goto out_unlock;
+	}
+	swap_latency_readers++;
+	mutex_unlock(&swap_latency_control_lock);
+
+	reader = kzalloc(sizeof(*reader), GFP_KERNEL);
+	if (!reader) {
+		mutex_lock(&swap_latency_control_lock);
+		swap_latency_readers--;
+		mutex_unlock(&swap_latency_control_lock);
+		return -ENOMEM;
+	}
+	records = min_t(u64, atomic64_read(&buffer->next_record),
+			buffer->capacity);
+	reader->buffer = buffer;
+	reader->length = SWAP_LATENCY_HEADER_SIZE +
+			records * SWAP_LATENCY_RECORD_SIZE;
+	file->private_data = reader;
+	return 0;
+
+out_unlock:
+	mutex_unlock(&swap_latency_control_lock);
+	return ret;
+}
+
+static ssize_t swap_latency_log_read(struct file *file, char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	struct swap_latency_reader *reader = file->private_data;
+
+	return simple_read_from_buffer(buf, count, ppos, reader->buffer->memory,
+			reader->length);
+}
+
+static int swap_latency_log_release(struct inode *inode, struct file *file)
+{
+	struct swap_latency_reader *reader = file->private_data;
+
+	kfree(reader);
+	mutex_lock(&swap_latency_control_lock);
+	WARN_ON_ONCE(!swap_latency_readers);
+	if (swap_latency_readers)
+		swap_latency_readers--;
+	mutex_unlock(&swap_latency_control_lock);
+	return 0;
+}
+
+static const struct file_operations swap_latency_log_fops = {
+	.owner = THIS_MODULE,
+	.open = swap_latency_log_open,
+	.read = swap_latency_log_read,
+	.release = swap_latency_log_release,
+	.llseek = default_llseek,
+};
+
+static int swap_latency_format_show(struct seq_file *m, void *unused)
+{
+	seq_puts(m, "magic=SWPLAT version=3 endian=0x01020304\n");
+	seq_printf(m, "header_size=%u record_size=%u\n",
+		SWAP_LATENCY_HEADER_SIZE, SWAP_LATENCY_RECORD_SIZE);
+	seq_puts(m, "record type=1 swapin, type=2 swapout\n");
+	seq_puts(m, "call=[call_begin_ns,call_end_ns]\n");
+	seq_puts(m, "kernel_ns is call time outside the device interval and ");
+	seq_puts(m, "excluding reserve_ns\n");
+	seq_puts(m, "submit=[submit_begin_ns,submit_end_ns] measures only the ");
+	seq_puts(m, "submit_bio(_wait) invocation\n");
+	seq_puts(m, "device=[device_begin_ns,device_end_ns] is bio submit to ");
+	seq_puts(m, "end_io entry; for async bios it is not submit duration\n");
+	seq_puts(m, "backend: 1=zram 2=swapfile 3=block-device 4=zswap ");
+	seq_puts(m, "5=filesystem-ops\n");
+	seq_puts(m, "NO_IO means no generic BIO was associated with the record; ");
+	seq_puts(m, "vendor or compression work may still exist. UNTRACKED_IO ");
+	seq_puts(m, "means vendor/filesystem I/O predates or escapes this scope; ");
+	seq_puts(m, "device time is unavailable and kernel_ns may include its wait. ");
+	seq_puts(m, "CACHE_INFLIGHT marks an observed in-flight ");
+	seq_puts(m, "folio.\n");
+	seq_puts(m, "reserved extension v1 records RVH/VH hook intervals, hook ");
+	seq_puts(m, "handled/return folio state, and the subsequent ");
+	seq_puts(m, "folio_lock_or_retry interval for vendor-bypassed swap-in.\n");
+	seq_puts(m, "v3 appends a 64-byte sched block at offset 256 with finalized ");
+	seq_puts(m, "task-runtime/run-delay/context-switch deltas and begin/end CPU ");
+	seq_puts(m, "for the root call and primary RVH read hook. Wall markers sit ");
+	seq_puts(m, "inside the measured operation; each marker and its adjacent ");
+	seq_puts(m, "scheduler snapshot share one preemption-disabled window, so ");
+	seq_puts(m, "no schedulable gap can enter the counter delta. ");
+	seq_puts(m, "task_sched_runtime rq-lock work remains outside the wall ");
+	seq_puts(m, "interval, with a narrow timestamp-boundary uncertainty. ");
+	seq_puts(m, "SCHED_VALID/RUN_DELAY_VALID and RVH vendor flags gate fields.\n");
+	seq_puts(m, "Read log only after enable=0; reset releases the vmalloc area.\n");
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(swap_latency_format);
+
+static bool swap_latency_create_file(const char *name, umode_t mode,
+		const struct file_operations *fops)
+{
+	return !IS_ERR_OR_NULL(debugfs_create_file(name, mode,
+			swap_latency_debugfs_root, NULL, fops));
+}
+
+static int __init swap_latency_init(void)
+{
+	unsigned int i;
+
+	for (i = 0; i < SWAP_LATENCY_SCOPE_COUNT; i++) {
+		spin_lock_init(&swap_latency_scopes[i].lock);
+		INIT_HLIST_HEAD(&swap_latency_scopes[i].scopes);
+	}
+	for (i = 0; i < SWAP_LATENCY_RETRY_COUNT; i++) {
+		spin_lock_init(&swap_latency_retries[i].lock);
+		INIT_HLIST_HEAD(&swap_latency_retries[i].retries);
+	}
+	swap_latency_debugfs_root = debugfs_create_dir(SWAP_LATENCY_DIR_NAME,
+			NULL);
+	if (IS_ERR_OR_NULL(swap_latency_debugfs_root)) {
+		pr_warn("swap_latency: debugfs interface unavailable\n");
+		swap_latency_debugfs_root = NULL;
+		return 0;
+	}
+	if (swap_latency_create_file("enable", 0600,
+			&swap_latency_enable_fops) &&
+		swap_latency_create_file("buffer_size_mb", 0600,
+			&swap_latency_buffer_mb_fops) &&
+		swap_latency_create_file("reset", 0200,
+			&swap_latency_reset_fops) &&
+		swap_latency_create_file("log", 0400,
+			&swap_latency_log_fops) &&
+		swap_latency_create_file("format", 0400,
+			&swap_latency_format_fops))
+		return 0;
+	pr_err("swap_latency: failed to create complete debugfs interface\n");
+	debugfs_remove_recursive(swap_latency_debugfs_root);
+	swap_latency_debugfs_root = NULL;
+	return 0;
+}
+
+late_initcall(swap_latency_init);
