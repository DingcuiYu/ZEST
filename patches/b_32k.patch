+	seq_puts(m,
+		"\n# target checkpoint completion-batch source=1 device-cache flush attribution\n");
+	seq_puts(m,
+		"# Auxiliary target-waiter view; this is not the physical-checkpoint execution denominator.\n");
+	seq_printf(m, "association_records=%llu\n",
+		stats->checkpoint_assoc_records);
+	seq_printf(m, "association_invalid_records=%llu\n",
