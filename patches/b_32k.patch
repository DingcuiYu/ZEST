+@dataclass(frozen=True)
+class Header:
+    magic: bytes
+    version: int
+    header_size: int
+    record_size: int
+    endian: int
+    buffer_bytes: int
+    capacity: int
+    records: int
+    dropped: int
+    session: int
+    start_ns: int
+    stop_ns: int
+    reserved_q0: int
+    reserved_q1: int
+    stopped_full: int
+    tgid_filter: int
+    enabled: int
+    reserved0: int
+    kernel_release: str
+
+    @classmethod
+    def unpack(cls, data: bytes) -> "Header":
+        fields = HEADER_STRUCT.unpack(data)
+        kernel_release = fields[18].split(b"\0", 1)[0].decode(
+            "utf-8", errors="replace"
+        )
+        return cls(
+            magic=fields[0],
+            version=fields[1],
+            header_size=fields[2],
+            record_size=fields[3],
+            endian=fields[4],
+            buffer_bytes=fields[5],
+            capacity=fields[6],
+            records=fields[7],
+            dropped=fields[8],
+            session=fields[9],
+            start_ns=fields[10],
+            stop_ns=fields[11],
+            reserved_q0=fields[12],
+            reserved_q1=fields[13],
+            stopped_full=fields[14],
+            tgid_filter=fields[15],
+            enabled=fields[16],
+            reserved0=fields[17],
+            kernel_release=kernel_release,
+        )
