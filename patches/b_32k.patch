+def print_counter(counter: Counter, empty: str = "none") -> str:
+    if not counter:
+        return empty
+    return ", ".join(
+        "{}={}".format(key, value)
+        for key, value in sorted(counter.items(), key=lambda item: str(item[0]))
+    )
