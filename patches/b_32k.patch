+	unsigned long base = swap_32kchunk_base(sis, offset);
+	unsigned int type = swp_type(folio->swap);
+	unsigned int index = swap_32kchunk_index(sis, offset);
+	sector_t sector = swap_page_sector(&folio->page) -
