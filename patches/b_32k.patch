+@dataclass(frozen=True)
+class ParseInfo:
+    file_size: int
+    available_records: int
+    parsed_records: int
+    trailing_bytes: int
+
+
+def decode_new_dev(encoded: int) -> Tuple[int, int]:
+    """Decode Linux new_encode_dev() into major and minor numbers."""
+    major = (encoded & 0xFFF00) >> 8
+    minor = (encoded & 0xFF) | ((encoded >> 12) & 0xFFF00)
+    return major, minor
+
+
+def read_header(path: Path) -> Tuple[Header, int]:
+    try:
+        file_size = path.stat().st_size
+    except OSError as error:
+        raise TraceFormatError("cannot stat {}: {}".format(path, error))
+    if file_size < HEADER_SIZE:
+        raise TraceFormatError(
+            "file is {} bytes; at least {} bytes are required".format(
+                file_size, HEADER_SIZE
+            )
+        )
+
+    try:
+        with path.open("rb") as stream:
+            data = stream.read(HEADER_SIZE)
+    except OSError as error:
+        raise TraceFormatError("cannot read {}: {}".format(path, error))
+
+    if len(data) != HEADER_SIZE:
+        raise TraceFormatError("short read while reading the trace header")
+    header = Header.unpack(data)
+
+    if header.magic != b"F2FSLAT\0":
+        raise TraceFormatError("bad header magic {!r}".format(header.magic))
+    if header.version not in FORMAT_LAYOUTS:
+        raise TraceFormatError(
+            "unsupported format version {}; supported versions are {}".format(
+                header.version, ", ".join(map(str, sorted(FORMAT_LAYOUTS)))
+            )
+        )
+    if header.header_size != HEADER_SIZE:
+        raise TraceFormatError(
+            "unsupported header size {}; expected {}".format(
+                header.header_size, HEADER_SIZE
+            )
+        )
+    expected_record_size = FORMAT_LAYOUTS[header.version][0]
+    if header.record_size != expected_record_size:
+        raise TraceFormatError(
+            "format v{} requires record size {}; header declares {}".format(
+                header.version, expected_record_size, header.record_size
+            )
+        )
+    if header.endian != ENDIAN_MARKER:
+        raise TraceFormatError(
+            "bad endian marker 0x{:08x}; only little-endian logs are supported".format(
+                header.endian
+            )
+        )
+    return header, file_size
+
+
+def header_warnings(header: Header, file_size: int) -> Tuple[List[str], ParseInfo]:
+    warnings = []  # type: List[str]
+
+    payload_bytes = file_size - HEADER_SIZE
+    available_records, trailing_bytes = divmod(
+        payload_bytes, header.record_size
+    )
+    parse_records = min(header.records, header.capacity, available_records)
+
+    if header.buffer_bytes < HEADER_SIZE:
+        warnings.append(
+            "header buffer_bytes={} is smaller than the header".format(
+                header.buffer_bytes
+            )
+        )
+    else:
+        expected_capacity = (
+            header.buffer_bytes - HEADER_SIZE
+        ) // header.record_size
+        if header.capacity != expected_capacity:
+            warnings.append(
+                "capacity={} does not match buffer_bytes (expected {})".format(
+                    header.capacity, expected_capacity
+                )
+            )
+
+    if header.records > header.capacity:
+        warnings.append(
+            "header records={} exceeds capacity={}; only {} records will be parsed".format(
+                header.records, header.capacity, parse_records
+            )
+        )
+    if header.records > available_records:
+        warnings.append(
+            "trace is truncated: header declares {} records but the file contains {}"
+            .format(header.records, available_records)
+        )
+    elif available_records > header.records and file_size != header.buffer_bytes:
+        warnings.append(
+            "file has {} complete records after the {} declared records; extras are ignored"
+            .format(available_records - header.records, header.records)
+        )
+    if trailing_bytes:
+        warnings.append(
+            "file has {} trailing byte(s) that do not form a complete record".format(
+                trailing_bytes
+            )
+        )
+    if header.enabled:
+        warnings.append(
+            "header enabled={} (dump should be taken only after enable=0)".format(
+                header.enabled
+            )
+        )
+    if header.stopped_full:
+        warnings.append(
+            "stopped_full=1: the buffer filled and tracing auto-disabled; the session tail is missing and the final-slot setup may include synchronous dmesg pr_info overhead"
+        )
+    if header.dropped:
+        warnings.append(
+            "dropped={}: at least one reservation was not recorded".format(
+                header.dropped
+            )
+        )
+    if not header.stop_ns:
+        warnings.append("stop_ns=0: the session may not have been cleanly stopped")
+    if parse_records == 0:
+        warnings.append("the trace contains no declared records")
+
+    return warnings, ParseInfo(
+        file_size=file_size,
+        available_records=available_records,
+        parsed_records=parse_records,
+        trailing_bytes=trailing_bytes,
+    )
+
+
+def record_structure_errors(
+    fields: Tuple[object, ...], index: int, header: Header
+) -> List[str]:
+    reasons = []  # type: List[str]
+    if fields[0] != RECORD_MAGIC:
+        return ["bad_magic"]
+    if fields[1] != header.version:
+        reasons.append("bad_version")
+    if fields[4] != header.record_size:
+        reasons.append("bad_size")
+    allowed_types = (RECORD_FSYNC, RECORD_FLUSH)
+    if header.version >= 3:
+        allowed_types += (RECORD_CHECKPOINT,)
+    if header.version >= 6:
+        allowed_types += (RECORD_BALANCE_CHECKPOINT,)
+    if fields[2] not in allowed_types:
+        reasons.append("bad_type")
+    if fields[5] != index:
+        reasons.append("bad_seq")
+    if fields[6] != header.session:
+        reasons.append("bad_session")
+    return reasons
+
+
+def collect_flag_counts(collector: Collector, flags: int) -> None:
+    flag_counters = (
+        ("flag_datasync", FLAG_DATASYNC),
+        ("flag_directory", FLAG_DIRECTORY),
+        ("flag_atomic", FLAG_ATOMIC),
+        ("flag_data_writeback", FLAG_DATA_WRITEBACK),
+        ("flag_data_wait", FLAG_DATA_WAIT),
+        ("flag_data_wait_skipped_eio", FLAG_DATA_WAIT_SKIPPED_EIO),
+        ("flag_node_submit", FLAG_NODE_SUBMIT),
+        ("flag_node_wait", FLAG_NODE_WAIT),
+        ("flag_logical_flush", FLAG_LOGICAL_FLUSH),
+        ("flag_checkpoint", FLAG_CHECKPOINT),
+        ("flag_cp_disabled", FLAG_CP_DISABLED),
+        ("flag_noop_after_data", FLAG_NOOP_AFTER_DATA),
+        ("flag_error", FLAG_ERROR),
+        ("flag_mount_nobarrier", FLAG_MOUNT_NOBARRIER),
+        ("flag_flush_merge", FLAG_FLUSH_MERGE),
+        ("flag_multi_device", FLAG_MULTI_DEVICE),
+        ("flag_blkzoned", FLAG_BLKZONED),
+        ("flag_physical_flush", FLAG_PHYSICAL_FLUSH),
+        ("flag_flush_device_cache", FLAG_FLUSH_DEVICE_CACHE),
+        ("flag_strict_atomic", FLAG_STRICT_ATOMIC),
+        ("flag_fsync_nobarrier", FLAG_FSYNC_NOBARRIER),
+        ("flag_readonly", FLAG_READONLY),
+        ("flag_cp_batch_assoc", FLAG_CP_BATCH_ASSOC),
+        ("flag_flush_mount_dev", FLAG_FLUSH_MOUNT_DEV),
+        ("flag_data_breakdown_valid", FLAG_DATA_BREAKDOWN_VALID),
+        ("flag_data_breakdown_error", FLAG_DATA_BREAKDOWN_ERROR),
+        ("flag_cp_exec_valid", FLAG_CP_EXEC_VALID),
+        ("flag_balance_cp_waiter", FLAG_BALANCE_CP_WAITER),
+    )
+    for name, bit in flag_counters:
+        if flags & bit:
+            collector.counts[name] += 1
+
+
+def collect_data_submit_breakdown(
+    collector: Collector,
+    flags: int,
+    values: Sequence[object],
+    data_submit_ns: int,
+) -> None:
+    if collector.format_version < 2:
+        collector.counts["data_breakdown_unsupported_records"] += 1
+        return
+
+    collector.counts["data_breakdown_eligible_records"] += 1
+    active_fields = DATA_BREAKDOWN_FIELDS
+    if collector.format_version >= 3:
+        active_fields += DATA_V3_DETAIL_FIELDS
+    if collector.format_version >= 4:
+        active_fields += DATA_V4_ADDITIONAL_FIELDS
+    if collector.format_version >= 5:
+        active_fields += DATA_V5_ADDITIONAL_FIELDS
+    extension = tuple(int(value) for value in values[VALUE_DATA_ALLOCATE_NS:])
+    valid_flag = bool(flags & FLAG_DATA_BREAKDOWN_VALID)
+    error_flag = bool(flags & FLAG_DATA_BREAKDOWN_ERROR)
+    if not valid_flag:
+        if error_flag or any(extension):
+            collector.counts["data_breakdown_invalid_records"] += 1
+            collector.invalid_stage_reasons[
+                "data_breakdown_uncommitted_values_or_error"
+            ] += 1
+        else:
+            collector.counts["data_breakdown_unavailable_records"] += 1
+        return
+    if error_flag:
+        collector.counts["data_breakdown_invalid_records"] += 1
+        collector.invalid_stage_reasons[
+            "data_breakdown_valid_and_error_flags"
+        ] += 1
+        return
+
+    samples = []  # type: List[Tuple[str, int, int, str]]
+    invalid = False
+    for metric_name, value_index, count_index, call_name in active_fields:
+        elapsed = int(values[value_index])
+        calls = int(values[count_index])
+        samples.append((metric_name, elapsed, calls, call_name))
+        if elapsed and not calls:
+            collector.invalid_stage_reasons[
+                "data_{}_time_without_call".format(call_name)
+            ] += 1
+            invalid = True
+
+    submit_detail_samples = []  # type: List[Tuple[str, int, int, str]]
+    submit_page_other = None  # type: Optional[int]
+    detail_invalid = False
+    if collector.format_version >= 5:
+        submit_page_ns = int(values[VALUE_DATA_SUBMIT_PAGE_NS])
+        submit_page_calls = int(values[VALUE_DATA_SUBMIT_PAGE_COUNT])
+        for metric_name, value_index, count_index, call_name in (
+            DATA_SUBMIT_PAGE_DETAIL_FIELDS
+        ):
+            elapsed = int(values[value_index])
+            calls = int(values[count_index])
+            submit_detail_samples.append(
+                (metric_name, elapsed, calls, call_name)
+            )
+            if elapsed and not calls:
+                collector.invalid_stage_reasons[
+                    "data_{}_time_without_call".format(call_name)
+                ] += 1
+                detail_invalid = True
+
+        submit_detail_ns = sum(
+            sample[1] for sample in submit_detail_samples
+        )
+        io_rwsem_calls = submit_detail_samples[0][2]
+        if io_rwsem_calls != submit_page_calls:
+            collector.invalid_stage_reasons[
+                "data_submit_page_io_rwsem_calls_mismatch_parent"
+            ] += 1
+            detail_invalid = True
+        if not submit_page_calls and any(
+            sample[2] for sample in submit_detail_samples
+        ):
+            collector.invalid_stage_reasons[
+                "data_submit_page_detail_call_without_parent"
+            ] += 1
+            detail_invalid = True
+        if submit_detail_ns > submit_page_ns:
+            collector.invalid_stage_reasons[
+                "data_submit_page_detail_sum_exceeds_parent"
+            ] += 1
+            detail_invalid = True
+        if detail_invalid:
+            collector.counts["submit_page_detail_invalid_records"] += 1
+            invalid = True
+        else:
+            submit_page_other = submit_page_ns - submit_detail_ns
+
+    component_ns = sum(sample[1] for sample in samples)
+    if component_ns > data_submit_ns:
+        collector.invalid_stage_reasons[
+            "data_breakdown_sum_exceeds_data_submit"
+        ] += 1
+        invalid = True
+    if invalid:
+        collector.counts["data_breakdown_invalid_records"] += 1
+        return
+
+    collector.counts["data_breakdown_valid_records"] += 1
+    if collector.format_version >= 3:
+        collector.counts["data_detail_valid_records"] += 1
+    collector.counts["data_breakdown_component_ns_total"] += component_ns
+    collector.metrics["data_submit_breakdown_total"].add(data_submit_ns)
+    for metric_name, elapsed, calls, call_name in samples:
+        collector.metrics[metric_name].add(elapsed)
+        collector.counts[
+            "data_{}_calls".format(call_name)
+        ] += calls
+        if calls:
+            collector.counts[
+                "data_{}_records_with_call".format(call_name)
+            ] += 1
+    collector.metrics["data_submit_other"].add(
+        data_submit_ns - component_ns
+    )
+    if collector.format_version >= 5:
+        collector.counts["submit_page_detail_valid_records"] += 1
+        for metric_name, elapsed, calls, call_name in submit_detail_samples:
+            collector.metrics[metric_name].add(elapsed)
+            collector.counts[
+                "data_{}_calls".format(call_name)
+            ] += calls
+            if calls:
+                collector.counts[
+                    "data_{}_records_with_call".format(call_name)
+                ] += 1
+        collector.metrics["data_submit_page_other"].add(
+            int(submit_page_other)
+        )
+
+
+def collect_fsync(collector: Collector, fields: Tuple[object, ...]) -> None:
+    flags = int(fields[3])
+    seq = int(fields[5])
+    start_ns = int(fields[7])
+    end_ns = int(fields[8])
+    mount_dev = int(fields[14])
+    ret = int(fields[15])
+    datasync = int(fields[19])
+    cp_reason = int(fields[20])
+    node_submit_count = int(fields[21])
+    values = fields[23:]
+    aux = int(values[VALUE_AUX])
+
+    collector.counts["fsync_records"] += 1
+    collector.fsync_inodes.add(int(fields[11]))
+    collect_flag_counts(collector, flags)
+    for phase, flag, _metric_name in FSYNC_STAGE_OCCURRENCE:
+        if flags & flag:
+            collector.fsync_stage_presence[phase] += 1
+    if flags & FLAG_DATASYNC:
+        collector.counts["fdatasync_records"] += 1
+    if flags & FLAG_ERROR or ret:
+        collector.counts["fsync_errors"] += 1
+    if flags & FLAG_CHECKPOINT:
+        collector.counts["checkpoint_records"] += 1
+    if flags & FLAG_NOOP_AFTER_DATA:
+        collector.counts["noop_after_data_records"] += 1
+    if flags & FLAG_LOGICAL_FLUSH:
+        collector.counts["logical_flush_count"] += 1
+
+    collector.checkpoint_reasons[cp_reason] += 1
+    if cp_reason not in CP_REASON_NAMES:
+        collector.consistency_reasons["unknown_checkpoint_reason"] += 1
+    checkpoint_flag = bool(flags & FLAG_CHECKPOINT)
+    checkpoint_needed = cp_reason != CP_NO_NEEDED
+    if checkpoint_needed and not checkpoint_flag:
+        collector.consistency_reasons["checkpoint_reason_without_flag"] += 1
+    elif checkpoint_flag and not checkpoint_needed:
+        collector.consistency_reasons["checkpoint_flag_without_reason"] += 1
+    if flags & FLAG_CP_BATCH_ASSOC and not checkpoint_flag:
+        collector.consistency_reasons[
+            "checkpoint_batch_assoc_without_checkpoint"
+        ] += 1
+    if flags & FLAG_FLUSH_MOUNT_DEV:
+        collector.consistency_reasons["flush_mount_dev_on_fsync"] += 1
+
+    mode_name = FSYNC_MODE_NAMES.get(aux, "unknown_{}".format(aux))
+    collector.fsync_modes[mode_name] += 1
+    if aux not in FSYNC_MODE_NAMES:
+        collector.consistency_reasons["unknown_fsync_mode"] += 1
+    if bool(datasync) != bool(flags & FLAG_DATASYNC):
+        collector.consistency_reasons["datasync_field_flag_mismatch"] += 1
+    if bool(ret) != bool(flags & FLAG_ERROR):
+        collector.consistency_reasons["fsync_ret_error_flag_mismatch"] += 1
+    if aux == 2 and not (flags & FLAG_FSYNC_NOBARRIER):
+        collector.consistency_reasons["nobarrier_mode_flag_missing"] += 1
+    if aux != 2 and flags & FLAG_FSYNC_NOBARRIER:
+        collector.consistency_reasons["nobarrier_mode_flag_unexpected"] += 1
+
+    total = collector.checked_delta(end_ns, start_ns, "fsync_total")
+    if total is not None:
+        collector.metrics["fsync_total"].add(total)
+
+    accounted = 0
+    if flags & FLAG_DATA_WRITEBACK:
+        value = collector.checked_delta(
+            int(values[VALUE_DATA_SUBMIT_END_NS]),
+            int(values[VALUE_DATA_SUBMIT_BEGIN_NS]),
+            "data_submit",
+        )
+        if value is not None:
+            collector.metrics["data_submit"].add(value)
+            collect_data_submit_breakdown(
+                collector, flags, values, value
+            )
+            accounted += value
+        elif collector.format_version >= 2:
+            collector.counts["data_breakdown_eligible_records"] += 1
+            collector.counts["data_breakdown_invalid_records"] += 1
+            collector.invalid_stage_reasons[
+                "data_breakdown_invalid_parent_data_submit"
+            ] += 1
+    elif collector.format_version >= 2:
+        extension = tuple(
+            int(item) for item in values[VALUE_DATA_ALLOCATE_NS:]
+        )
+        if flags & (FLAG_DATA_BREAKDOWN_VALID | FLAG_DATA_BREAKDOWN_ERROR):
+            collector.consistency_reasons[
+                "data_breakdown_flag_without_data_writeback"
+            ] += 1
+        if any(extension):
+            collector.consistency_reasons[
+                "data_breakdown_values_without_data_writeback"
+            ] += 1
+
+    if flags & FLAG_DATA_WAIT and flags & FLAG_DATA_WAIT_SKIPPED_EIO:
+        collector.consistency_reasons[
+            "data_wait_and_skipped_eio_flags"
+        ] += 1
+    if (flags & (FLAG_DATA_WAIT | FLAG_DATA_WAIT_SKIPPED_EIO)) and not (
+        flags & FLAG_DATA_WRITEBACK
+    ):
+        collector.consistency_reasons[
+            "data_wait_state_without_data_writeback"
+        ] += 1
+
+    if flags & FLAG_DATA_WAIT:
+        if collector.format_version >= 2:
+            value = int(values[VALUE_DATA_WAIT_END_OR_TOTAL_NS])
+            if total is not None and value > total:
+                collector.invalid_stage_reasons[
+                    "data_wait_total_exceeds_fsync"
+                ] += 1
+                value = None
+        else:
+            value = collector.checked_delta(
+                int(values[VALUE_DATA_WAIT_END_OR_TOTAL_NS]),
+                int(values[VALUE_DATA_SUBMIT_END_NS]),
+                "data_wait",
+            )
+        if value is not None:
+            collector.metrics["data_wait"].add(value)
+            accounted += value
+    elif collector.format_version >= 2 and int(
+        values[VALUE_DATA_WAIT_END_OR_TOTAL_NS]
+    ):
+        collector.consistency_reasons[
+            "data_wait_total_without_wait_flag"
+        ] += 1
+
+    if flags & FLAG_NODE_SUBMIT:
+        if node_submit_count == 0:
+            collector.invalid_stage_reasons["node_submit_zero_count"] += 1
+        else:
+            value = collector.checked_accumulated(
+                int(values[VALUE_NODE_SUBMIT_TOTAL_NS]),
+                int(values[VALUE_NODE_SUBMIT_FIRST_BEGIN_NS]),
+                int(values[VALUE_NODE_SUBMIT_LAST_END_NS]),
+                "node_submit",
+            )
+            if value is not None:
+                collector.metrics["node_submit"].add(value)
+                accounted += value
+    elif node_submit_count:
+        collector.consistency_reasons["node_count_without_flag"] += 1
+
+    if flags & FLAG_NODE_WAIT:
+        value = collector.checked_accumulated(
+            int(values[VALUE_NODE_WAIT_TOTAL_NS]),
+            int(values[VALUE_NODE_WAIT_FIRST_BEGIN_NS]),
+            int(values[VALUE_NODE_WAIT_LAST_END_NS]),
+            "node_wait",
+        )
+        if value is not None:
+            collector.metrics["node_wait"].add(value)
+            accounted += value
+
+    if flags & FLAG_LOGICAL_FLUSH:
+        value = collector.checked_delta(
+            int(values[VALUE_LOGICAL_FLUSH_END_NS]),
+            int(values[VALUE_LOGICAL_FLUSH_BEGIN_NS]),
+            "logical_flush",
+        )
+        if value is not None:
+            collector.metrics["logical_flush_wait"].add(value)
+            accounted += value
+
+    if flags & FLAG_CHECKPOINT:
+        value = collector.checked_delta(
+            int(values[VALUE_CHECKPOINT_END_NS]),
+            int(values[VALUE_CHECKPOINT_BEGIN_NS]),
+            "checkpoint",
+        )
+        if value is not None:
+            collector.metrics["checkpoint"].add(value)
+            accounted += value
+            batch_id = int(values[VALUE_CP_BATCH_ID])
+            device_flush_ns = int(values[VALUE_CP_DEVICE_FLUSH_NS])
+            device_flush_max_ns = int(
+                values[VALUE_CP_DEVICE_FLUSH_MAX_NS]
+            )
+            device_flush_count = int(values[VALUE_CP_DEVICE_FLUSH_COUNT])
+            device_flush_errors = int(values[VALUE_CP_DEVICE_FLUSH_ERRORS])
+            execution_begin_ns = int(values[VALUE_CP_EXECUTION_BEGIN_NS])
+            execution_end_ns = int(values[VALUE_CP_EXECUTION_END_NS])
+            association_valid = bool(flags & FLAG_CP_BATCH_ASSOC)
+            execution_valid = bool(flags & FLAG_CP_EXEC_VALID)
+
+            if association_valid and flags & (FLAG_NODE_SUBMIT | FLAG_NODE_WAIT):
+                collector.consistency_reasons[
+                    "checkpoint_batch_assoc_overlaps_node_fields"
+                ] += 1
+                association_valid = False
+            if association_valid and batch_id == 0:
+                collector.consistency_reasons[
+                    "checkpoint_batch_assoc_zero_id"
+                ] += 1
+                association_valid = False
+            if association_valid and device_flush_errors > device_flush_count:
+                collector.consistency_reasons[
+                    "checkpoint_flush_errors_exceed_count"
+                ] += 1
+                association_valid = False
+            if association_valid and device_flush_max_ns > device_flush_ns:
+                collector.consistency_reasons[
+                    "checkpoint_flush_max_exceeds_total"
+                ] += 1
+                association_valid = False
+            if association_valid and device_flush_ns > value:
+                collector.consistency_reasons[
+                    "checkpoint_flush_total_exceeds_wall"
+                ] += 1
+                association_valid = False
+            if association_valid and device_flush_count == 0 and (
+                device_flush_ns or device_flush_max_ns or device_flush_errors
+            ):
+                collector.consistency_reasons[
+                    "checkpoint_zero_flush_count_has_values"
+                ] += 1
+                association_valid = False
+            if execution_valid:
+                if collector.format_version < 3:
+                    collector.consistency_reasons[
+                        "checkpoint_exec_flag_before_v3"
+                    ] += 1
+                    execution_valid = False
+                elif not association_valid:
+                    collector.consistency_reasons[
+                        "checkpoint_exec_without_valid_batch_assoc"
+                    ] += 1
+                    execution_valid = False
+                elif (
+                    execution_begin_ns == 0
+                    or execution_end_ns <= execution_begin_ns
+                    or execution_begin_ns
+                    < int(values[VALUE_CHECKPOINT_BEGIN_NS])
+                    or execution_end_ns
+                    > int(values[VALUE_CHECKPOINT_END_NS])
+                    or device_flush_ns
+                    > execution_end_ns - execution_begin_ns
+                ):
+                    collector.consistency_reasons[
+                        "checkpoint_exec_interval_invalid"
+                    ] += 1
+                    execution_valid = False
+            elif execution_begin_ns or execution_end_ns:
+                collector.consistency_reasons[
+                    "checkpoint_exec_values_without_flag"
+                ] += 1
+            if (
+                collector.format_version >= 3
+                and association_valid
+                and device_flush_count
+                and not execution_valid
+            ):
+                collector.consistency_reasons[
+                    "checkpoint_flush_without_exec"
+                ] += 1
+                association_valid = False
+            if not (flags & FLAG_CP_BATCH_ASSOC) and any(
+                (
+                    batch_id,
+                    device_flush_ns,
+                    device_flush_max_ns,
+                    device_flush_count,
+                    device_flush_errors,
+                )
+            ):
+                collector.consistency_reasons[
+                    "checkpoint_assoc_values_without_flag"
+                ] += 1
+
+            collector.target_checkpoints.append(
+                TargetCheckpoint(
+                    seq=seq,
+                    mount_dev=mount_dev,
+                    begin_ns=int(values[VALUE_CHECKPOINT_BEGIN_NS]),
+                    end_ns=int(values[VALUE_CHECKPOINT_END_NS]),
+                    wall_ns=value,
+                    batch_id=batch_id,
+                    device_flush_ns=device_flush_ns,
+                    device_flush_max_ns=device_flush_max_ns,
+                    device_flush_count=device_flush_count,
+                    device_flush_errors=device_flush_errors,
+                    execution_begin_ns=execution_begin_ns,
+                    execution_end_ns=execution_end_ns,
+                    execution_valid=execution_valid,
+                    association_valid=association_valid,
+                )
+            )
+
+    if total is not None:
+        if accounted > total:
+            collector.consistency_reasons["accounted_exceeds_fsync_total"] += 1
+        collector.metrics["unaccounted"].add(max(total - accounted, 0))
+
+
+def collect_flush(collector: Collector, fields: Tuple[object, ...]) -> None:
+    flags = int(fields[3])
+    start_ns = int(fields[7])
+    end_ns = int(fields[8])
+    ret = int(fields[15])
+    values = fields[23:]
+    source = int(values[VALUE_AUX])
+    batch_id = int(values[VALUE_FLUSH_CP_BATCH_ID])
+    mount_dev = int(values[VALUE_FLUSH_MOUNT_DEV])
+    source_name = FLUSH_SOURCE_NAMES.get(source, "unknown_{}".format(source))
+    valid = True
+
+    collector.counts["flush_records"] += 1
+    collect_flag_counts(collector, flags)
+
+    if not (flags & FLAG_PHYSICAL_FLUSH):
+        collector.consistency_reasons["physical_flush_flag_missing"] += 1
+        valid = False
+    if source not in FLUSH_SOURCE_NAMES:
+        collector.consistency_reasons["unknown_flush_source"] += 1
+        valid = False
+    if (source == 1) != bool(flags & FLAG_FLUSH_DEVICE_CACHE):
+        collector.consistency_reasons["flush_source_flag_mismatch"] += 1
+        valid = False
+    if bool(ret) != bool(flags & FLAG_ERROR):
+        collector.consistency_reasons["flush_ret_error_flag_mismatch"] += 1
+        valid = False
+    if flags & FLAG_CP_BATCH_ASSOC:
+        if source != 1:
+            collector.consistency_reasons[
+                "checkpoint_batch_assoc_on_non_device_flush"
+            ] += 1
+            valid = False
+        if batch_id == 0:
+            collector.consistency_reasons[
+                "flush_checkpoint_batch_assoc_zero_id"
+            ] += 1
+            valid = False
+    elif batch_id:
+        collector.consistency_reasons[
+            "flush_checkpoint_batch_id_without_flag"
+        ] += 1
+        valid = False
+    if collector.format_version >= 2 and any(
+        int(item) for item in values[VALUE_DATA_ALLOCATE_NS:]
+    ):
+        collector.consistency_reasons[
+            "data_breakdown_values_on_flush_record"
+        ] += 1
+        valid = False
+    if flags & (FLAG_DATA_BREAKDOWN_VALID | FLAG_DATA_BREAKDOWN_ERROR):
+        collector.consistency_reasons[
+            "data_breakdown_flag_on_flush_record"
+        ] += 1
+        valid = False
+    if flags & FLAG_CP_EXEC_VALID:
+        collector.consistency_reasons[
+            "checkpoint_exec_flag_on_flush_record"
+        ] += 1
+        valid = False
+    allowed_flags = (
+        FLAG_ERROR
+        | FLAG_MOUNT_NOBARRIER
+        | FLAG_FLUSH_MERGE
+        | FLAG_MULTI_DEVICE
+        | FLAG_BLKZONED
+        | FLAG_PHYSICAL_FLUSH
+        | FLAG_FLUSH_DEVICE_CACHE
+        | FLAG_FSYNC_NOBARRIER
+        | FLAG_CP_BATCH_ASSOC
+        | FLAG_FLUSH_MOUNT_DEV
+    )
+    if flags & ~allowed_flags:
+        collector.consistency_reasons[
+            "unexpected_flags_on_flush_record"
+        ] += 1
+        valid = False
+    if (
+        collector.format_version >= 2
+        and source == 1
+        and not (flags & FLAG_FLUSH_MOUNT_DEV)
+    ):
+        collector.consistency_reasons[
+            "device_flush_missing_mount_dev"
+        ] += 1
+        valid = False
+
+    if not valid:
+        collector.counts["semantically_invalid_flush_records"] += 1
+        return
+
+    collector.counts["physical_explicit_flush_count"] += 1
+    collector.flush_sources[source_name] += 1
+    if ret or flags & FLAG_ERROR:
+        collector.counts["flush_errors"] += 1
+
+    value = collector.checked_delta(end_ns, start_ns, "physical_flush")
+    if value is None:
+        return
+    collector.metrics["explicit_physical_flush"].add(value)
+    collector.physical_inos.append(int(fields[11]))
+    collector.physical_latencies.append(value)
+    collector.physical_sources.append(source if source in (0, 1) else 255)
+    if source == 0:
+        collector.metrics["explicit_fsync_flush"].add(value)
+    elif source == 1:
+        collector.metrics["device_cache_flush"].add(value)
+        if flags & FLAG_FLUSH_MOUNT_DEV:
+            collector.device_flush_intervals[mount_dev].append(
+                (start_ns, end_ns, batch_id)
+            )
+        if flags & FLAG_CP_BATCH_ASSOC and batch_id:
+            collector.metrics["checkpoint_batch_device_flush"].add(value)
+            if collector.format_version < 3:
+                collector.metrics[
+                    "checkpoint_associated_device_flush"
+                ].add(value)
+            collector.device_flush_batches[batch_id].add(
+                value,
+                bool(ret or flags & FLAG_ERROR),
+                mount_dev,
+                start_ns,
+                end_ns,
+            )
+
+
+def collect_physical_checkpoint(
+    collector: Collector, fields: Tuple[object, ...]
+) -> None:
+    flags = int(fields[3])
+    seq = int(fields[5])
+    start_ns = int(fields[7])
+    end_ns = int(fields[8])
+    mount_dev = int(fields[14])
+    ret = int(fields[15])
+    values = fields[23:]
+    batch_id = int(values[VALUE_CP_BATCH_ID])
+    flush_ns = int(values[VALUE_CP_DEVICE_FLUSH_NS])
+    flush_max_ns = int(values[VALUE_CP_DEVICE_FLUSH_MAX_NS])
+    flush_count = int(values[VALUE_CP_DEVICE_FLUSH_COUNT])
+    flush_errors = int(values[VALUE_CP_DEVICE_FLUSH_ERRORS])
+    execution_ns = end_ns - start_ns if end_ns >= start_ns else 0
+    valid = True
+
+    collector.counts["physical_checkpoint_records"] += 1
+    collect_flag_counts(collector, flags)
+    if ret or flags & FLAG_ERROR:
+        collector.counts["physical_checkpoint_errors"] += 1
+    required_flags = (
+        FLAG_CHECKPOINT | FLAG_CP_BATCH_ASSOC | FLAG_CP_EXEC_VALID
+    )
+    allowed_flags = (
+        required_flags
+        | FLAG_ERROR
+        | FLAG_MOUNT_NOBARRIER
+        | FLAG_FLUSH_MERGE
+        | FLAG_MULTI_DEVICE
+        | FLAG_BLKZONED
+        | FLAG_FSYNC_NOBARRIER
+    )
+    if (flags & required_flags) != required_flags:
+        collector.consistency_reasons[
+            "physical_checkpoint_required_flags_missing"
+        ] += 1
+        valid = False
+    if flags & ~allowed_flags:
+        collector.consistency_reasons[
+            "physical_checkpoint_unexpected_flags"
+        ] += 1
+        valid = False
+    if batch_id == 0:
+        collector.consistency_reasons[
+            "physical_checkpoint_zero_batch_id"
+        ] += 1
+        valid = False
+    if (
+        start_ns == 0
+        or end_ns <= start_ns
+        or int(values[VALUE_CP_EXECUTION_BEGIN_NS]) != start_ns
+        or int(values[VALUE_CP_EXECUTION_END_NS]) != end_ns
+    ):
+        collector.consistency_reasons[
+            "physical_checkpoint_exec_interval_invalid"
+        ] += 1
+        valid = False
+    if (
+        flush_errors > flush_count
+        or flush_max_ns > flush_ns
+        or flush_ns > execution_ns
+        or (
+            flush_count == 0
+            and (flush_ns or flush_max_ns or flush_errors)
+        )
+    ):
+        collector.consistency_reasons[
+            "physical_checkpoint_flush_aggregate_invalid"
+        ] += 1
+        valid = False
+    if any(int(item) for item in values[VALUE_DATA_ALLOCATE_NS:]):
+        collector.consistency_reasons[
+            "data_breakdown_values_on_checkpoint_record"
+        ] += 1
+        valid = False
+    if bool(ret) != bool(flags & FLAG_ERROR):
+        collector.consistency_reasons[
+            "physical_checkpoint_ret_error_flag_mismatch"
+        ] += 1
+        valid = False
+
+    collector.physical_checkpoints.append(
+        PhysicalCheckpoint(
+            seq=seq,
+            mount_dev=mount_dev,
+            batch_id=batch_id,
+            begin_ns=start_ns,
+            end_ns=end_ns,
+            execution_ns=execution_ns,
+            device_flush_ns=flush_ns,
+            device_flush_max_ns=flush_max_ns,
+            device_flush_count=flush_count,
+            device_flush_errors=flush_errors,
+            error=bool(ret or flags & FLAG_ERROR),
+            valid=valid,
+        )
+    )
+
+
+def collect_balance_checkpoint(
+    collector: Collector,
+    fields: Tuple[object, ...],
+    parent_fields: Optional[Tuple[object, ...]],
+) -> None:
+    flags = int(fields[3])
+    seq = int(fields[5])
+    start_ns = int(fields[7])
+    end_ns = int(fields[8])
+    ino = int(fields[11])
+    mount_dev = int(fields[14])
+    ret = int(fields[15])
+    tgid = int(fields[17])
+    datasync = int(fields[19])
+    values = fields[23:]
+    parent_seq = int(values[VALUE_BALANCE_PARENT_FSYNC_SEQ])
+    sync_begin_ns = int(values[VALUE_BALANCE_SYNC_BEGIN_NS])
+    sync_end_ns = int(values[VALUE_BALANCE_SYNC_END_NS])
+    batch_id = int(values[VALUE_BALANCE_CP_BATCH_ID])
+    execution_begin_ns = int(values[VALUE_BALANCE_EXECUTION_BEGIN_NS])
+    execution_end_ns = int(values[VALUE_BALANCE_EXECUTION_END_NS])
+    flush_ns = int(values[VALUE_BALANCE_DEVICE_FLUSH_NS])
+    flush_max_ns = int(values[VALUE_BALANCE_DEVICE_FLUSH_MAX_NS])
+    flush_count = int(values[VALUE_BALANCE_DEVICE_FLUSH_COUNT])
+    flush_errors = int(values[VALUE_BALANCE_DEVICE_FLUSH_ERRORS])
+    balance_call_index = int(values[VALUE_BALANCE_CALL_INDEX])
+    dispatch = int(values[VALUE_BALANCE_DISPATCH])
+    batch_waiters = int(values[VALUE_BALANCE_BATCH_WAITER_COUNT])
+    selected_waiters = int(values[VALUE_BALANCE_SELECTED_WAITERS])
+    trigger_kind = int(values[VALUE_BALANCE_TRIGGER_KIND])
+    parent_fsync_ns = 0
+    parent_balance_ns = 0
+    valid = True
+
+    collector.counts["balance_checkpoint_records"] += 1
+    collect_flag_counts(collector, flags)
+    required_flags = FLAG_CHECKPOINT | FLAG_BALANCE_CP_WAITER
+    allowed_flags = (
+        required_flags
+        | FLAG_CP_BATCH_ASSOC
+        | FLAG_CP_EXEC_VALID
+        | FLAG_ERROR
+        | FLAG_MOUNT_NOBARRIER
+        | FLAG_FLUSH_MERGE
+        | FLAG_MULTI_DEVICE
+        | FLAG_BLKZONED
+        | FLAG_FSYNC_NOBARRIER
+    )
+    if (flags & required_flags) != required_flags:
+        collector.consistency_reasons[
+            "balance_checkpoint_required_flags_missing"
+        ] += 1
+        valid = False
+    if flags & ~allowed_flags:
+        collector.consistency_reasons[
+            "balance_checkpoint_unexpected_flags"
+        ] += 1
+        valid = False
+    if bool(flags & FLAG_CP_BATCH_ASSOC) != bool(batch_id):
+        collector.consistency_reasons[
+            "balance_checkpoint_batch_assoc_mismatch"
+        ] += 1
+        valid = False
+    if parent_seq >= seq:
+        collector.consistency_reasons[
+            "balance_checkpoint_parent_seq_not_before_child"
+        ] += 1
+        valid = False
+    if ret or flags & FLAG_ERROR:
+        collector.counts["balance_checkpoint_errors"] += 1
+    if bool(ret) != bool(flags & FLAG_ERROR):
+        collector.consistency_reasons[
+            "balance_checkpoint_ret_error_flag_mismatch"
+        ] += 1
+        valid = False
+    if trigger_kind != BALANCE_TRIGGER_F2FS_BALANCE:
+        collector.consistency_reasons[
+            "balance_checkpoint_unknown_trigger_kind"
+        ] += 1
+        valid = False
+    if start_ns != sync_begin_ns or end_ns != sync_end_ns:
+        collector.consistency_reasons[
+            "balance_checkpoint_common_sync_interval_mismatch"
+        ] += 1
+        valid = False
+    if sync_begin_ns == 0 or sync_end_ns < sync_begin_ns:
+        collector.consistency_reasons[
+            "balance_checkpoint_sync_interval_invalid"
+        ] += 1
+        valid = False
+        sync_wait_ns = 0
+    else:
+        sync_wait_ns = sync_end_ns - sync_begin_ns
+
+    execution_present = bool(execution_begin_ns or execution_end_ns)
+    if bool(flags & FLAG_CP_EXEC_VALID) != execution_present:
+        collector.consistency_reasons[
+            "balance_checkpoint_exec_flag_fields_mismatch"
+        ] += 1
+        valid = False
+    if execution_present:
+        if (
+            execution_begin_ns == 0
+            or execution_end_ns <= execution_begin_ns
+            or execution_begin_ns < sync_begin_ns
+            or execution_end_ns > sync_end_ns
+            or batch_id == 0
+        ):
+            collector.consistency_reasons[
+                "balance_checkpoint_execution_interval_invalid"
+            ] += 1
+            valid = False
+        execution_ns = (
+            execution_end_ns - execution_begin_ns
+            if execution_end_ns >= execution_begin_ns
+            else 0
+        )
+        if flush_ns > execution_ns:
+            collector.consistency_reasons[
+                "balance_checkpoint_flush_exceeds_execution"
+            ] += 1
+            valid = False
+    elif flush_ns or flush_max_ns or flush_count or flush_errors:
+        collector.consistency_reasons[
+            "balance_checkpoint_flush_without_execution"
+        ] += 1
+        valid = False
+
+    if (
+        flush_errors > flush_count
+        or flush_max_ns > flush_ns
+        or (
+            flush_count == 0
+            and (flush_ns or flush_max_ns or flush_errors)
+        )
+    ):
+        collector.consistency_reasons[
+            "balance_checkpoint_flush_aggregate_invalid"
+        ] += 1
+        valid = False
+    if selected_waiters > batch_waiters:
+        collector.consistency_reasons[
+            "balance_checkpoint_selected_exceeds_batch_waiters"
+        ] += 1
+        valid = False
+    if any(int(item) for item in values[15:]):
+        collector.consistency_reasons[
+            "unexpected_tail_values_on_balance_checkpoint"
+        ] += 1
+        valid = False
+
+    if batch_id == 0:
+        collector.counts["balance_checkpoint_early_return_records"] += 1
+    elif not execution_present:
+        collector.counts["balance_checkpoint_noop_batch_records"] += 1
+    if dispatch:
+        collector.counts["balance_checkpoint_dispatch_nonzero_records"] += 1
+    if balance_call_index:
+        collector.counts[
+            "balance_checkpoint_call_index_nonzero_records"
+        ] += 1
+    else:
+        collector.consistency_reasons[
+            "balance_checkpoint_zero_call_index"
+        ] += 1
+        valid = False
+    if batch_waiters:
+        collector.counts[
+            "balance_checkpoint_batch_waiter_metadata_records"
+        ] += 1
+    if selected_waiters:
+        collector.counts[
+            "balance_checkpoint_selected_waiter_metadata_records"
+        ] += 1
+
+    if parent_fields is None:
+        collector.consistency_reasons[
+            "balance_checkpoint_parent_unavailable"
+        ] += 1
+        valid = False
+    else:
+        parent_flags = int(parent_fields[3])
+        parent_start_ns = int(parent_fields[7])
+        parent_end_ns = int(parent_fields[8])
+        parent_tgid = int(parent_fields[17])
+        parent_datasync = int(parent_fields[19])
+        parent_values = parent_fields[23:]
+        parent_balance_calls = int(
+            parent_values[VALUE_DATA_BALANCE_GC_COUNT]
+        )
+
+        if int(parent_fields[2]) != RECORD_FSYNC:
+            collector.consistency_reasons[
+                "balance_checkpoint_parent_not_fsync"
+            ] += 1
+            valid = False
+        if parent_tgid != tgid or parent_datasync != datasync:
+            collector.consistency_reasons[
+                "balance_checkpoint_parent_task_mismatch"
+            ] += 1
+            valid = False
+        if int(parent_fields[11]) != ino or int(parent_fields[14]) != mount_dev:
+            collector.consistency_reasons[
+                "balance_checkpoint_parent_identity_mismatch"
+            ] += 1
+            valid = False
+        if parent_start_ns == 0 or parent_end_ns < parent_start_ns:
+            collector.consistency_reasons[
+                "balance_checkpoint_parent_fsync_interval_invalid"
+            ] += 1
+            valid = False
+        else:
+            parent_fsync_ns = parent_end_ns - parent_start_ns
+        if not (parent_flags & FLAG_DATA_BREAKDOWN_VALID) or (
+            parent_flags & FLAG_DATA_BREAKDOWN_ERROR
+        ):
+            collector.consistency_reasons[
+                "balance_checkpoint_parent_breakdown_invalid"
+            ] += 1
+            valid = False
+        parent_data_begin_ns = int(
+            parent_values[VALUE_DATA_SUBMIT_BEGIN_NS]
+        )
+        parent_data_end_ns = int(parent_values[VALUE_DATA_SUBMIT_END_NS])
+        if (
+            not (parent_flags & FLAG_DATA_WRITEBACK)
+            or parent_data_begin_ns == 0
+            or parent_data_end_ns < parent_data_begin_ns
+            or sync_begin_ns < parent_data_begin_ns
+            or sync_end_ns > parent_data_end_ns
+        ):
+            collector.consistency_reasons[
+                "balance_checkpoint_sync_outside_parent_data_submit"
+            ] += 1
+            valid = False
+        parent_balance_ns = int(parent_values[VALUE_DATA_BALANCE_GC_NS])
+        if parent_balance_ns and not parent_balance_calls:
+            collector.consistency_reasons[
+                "balance_checkpoint_parent_balance_time_without_call"
+            ] += 1
+            valid = False
+        if parent_balance_calls == 0:
+            collector.consistency_reasons[
+                "balance_checkpoint_parent_has_no_balance_call"
+            ] += 1
+            valid = False
+        if balance_call_index and balance_call_index > parent_balance_calls:
+            collector.consistency_reasons[
+                "balance_checkpoint_call_index_exceeds_parent_count"
+            ] += 1
+            valid = False
+        if parent_balance_ns > parent_fsync_ns or sync_wait_ns > parent_balance_ns:
+            collector.consistency_reasons[
+                "balance_checkpoint_parent_denominator_invalid"
+            ] += 1
+            valid = False
+
+    if valid:
+        collector.counts["balance_checkpoint_semantically_valid_records"] += 1
+    else:
+        collector.counts["balance_checkpoint_semantically_invalid_records"] += 1
+    collector.balance_checkpoints.add(
+        parent_seq=parent_seq,
+        mount_dev=mount_dev,
+        sync_wait_ns=sync_wait_ns,
+        batch_id=batch_id,
+        execution_begin_ns=execution_begin_ns,
+        execution_end_ns=execution_end_ns,
+        device_flush_ns=flush_ns,
+        device_flush_max_ns=flush_max_ns,
+        device_flush_count=flush_count,
+        device_flush_errors=flush_errors,
+        call_index=balance_call_index,
+        parent_fsync_ns=parent_fsync_ns,
+        parent_balance_ns=parent_balance_ns,
+        valid=valid,
+    )
+
+
+def parse_records(
+    path: Path,
+    header: Header,
+    info: ParseInfo,
+    progress: bool = False,
+) -> Collector:
+    collector = Collector(
+        format_version=header.version, parsed_records=info.parsed_records
+    )
+    record_struct = FORMAT_LAYOUTS[header.version][2]
+
+    try:
+        with path.open("rb") as stream:
+            with mmap.mmap(stream.fileno(), 0, access=mmap.ACCESS_READ) as image:
+                for index in range(info.parsed_records):
+                    offset = header.header_size + index * header.record_size
+                    fields = record_struct.unpack_from(image, offset)
+                    reasons = record_structure_errors(fields, index, header)
+                    if reasons:
+                        collector.invalid_record(reasons)
+                        continue
+
+                    collector.counts["valid_records"] += 1
+                    collector.reserve.add(int(fields[9]))
+                    collector.write.add(int(fields[10]))
+
+                    dev = decode_new_dev(int(fields[14]))
+                    record_type = int(fields[2])
+                    if record_type == RECORD_FSYNC:
+                        collector.devices[(dev[0], dev[1], "fsync_summary")] += 1
+                        collect_fsync(collector, fields)
+                    elif record_type == RECORD_FLUSH:
+                        source = int(fields[23 + VALUE_AUX])
+                        source_name = FLUSH_SOURCE_NAMES.get(
+                            source, "unknown_{}".format(source)
+                        )
+                        collector.devices[
+                            (dev[0], dev[1], "physical_" + source_name)
+                        ] += 1
+                        collect_flush(collector, fields)
+                    elif record_type == RECORD_CHECKPOINT:
+                        collector.devices[
+                            (dev[0], dev[1], "physical_checkpoint")
+                        ] += 1
+                        collect_physical_checkpoint(collector, fields)
+                    elif record_type == RECORD_BALANCE_CHECKPOINT:
+                        parent_seq = int(
+                            fields[
+                                23 + VALUE_BALANCE_PARENT_FSYNC_SEQ
+                            ]
+                        )
+                        parent_fields = None
+                        if parent_seq < info.parsed_records:
+                            parent_offset = (
+                                header.header_size
+                                + parent_seq * header.record_size
+                            )
+                            candidate = record_struct.unpack_from(
+                                image, parent_offset
+                            )
+                            if not record_structure_errors(
+                                candidate, parent_seq, header
+                            ):
+                                parent_fields = candidate
+                        collector.devices[
+                            (dev[0], dev[1], "balance_checkpoint")
+                        ] += 1
+                        collect_balance_checkpoint(
+                            collector, fields, parent_fields
+                        )
+                    else:
+                        # record_structure_errors() rejects unknown types;
+                        # keep this explicit guard so a future type cannot be
+                        # silently interpreted as a physical checkpoint.
+                        collector.invalid_record(["unhandled_type"])
+
+                    if progress and (index + 1) % 1_000_000 == 0:
+                        print(
+                            "parsed {}/{} records".format(
+                                index + 1, info.parsed_records
+                            ),
+                            file=sys.stderr,
+                            flush=True,
+                        )
+    except (OSError, ValueError, struct.error) as error:
+        raise TraceFormatError("failed while parsing records: {}".format(error))
+
+    return collector
+
+
+def collect_matched_inode_flushes(collector: Collector) -> None:
+    """Cross-check source=fsync flush inodes after all summaries are known."""
+    metric = collector.metrics["matched_inode_flush"]
+    for ino, latency, source in zip(
+        collector.physical_inos,
+        collector.physical_latencies,
+        collector.physical_sources,
+    ):
+        if source != 0 or ino not in collector.fsync_inodes:
+            continue
+        metric.add(int(latency))
+        source_name = FLUSH_SOURCE_NAMES.get(
+            int(source), "unknown_{}".format(int(source))
+        )
+        collector.matched_flush_sources[source_name] += 1
+    collector.physical_inos = array("Q")
+    collector.physical_latencies = array("Q")
+    collector.physical_sources = array("B")
+
+
+def merge_intervals(
+    intervals: Sequence[Tuple[int, int, int]],
+) -> List[Tuple[int, int]]:
+    merged = []  # type: List[Tuple[int, int]]
+    for begin_ns, end_ns, _batch_id in sorted(
+        intervals, key=lambda interval: (interval[0], interval[1])
+    ):
+        if end_ns <= begin_ns:
+            continue
+        if not merged or begin_ns > merged[-1][1]:
+            merged.append((begin_ns, end_ns))
+        else:
+            merged[-1] = (merged[-1][0], max(merged[-1][1], end_ns))
+    return merged
+
+
+def clipped_interval_union_ns(
+    intervals: Sequence[Tuple[int, int]],
+    starts: Sequence[int],
+    begin_ns: int,
+    end_ns: int,
+) -> int:
+    if not intervals or end_ns <= begin_ns:
+        return 0
+
+    index = bisect_left(starts, begin_ns)
+    if index > 0 and intervals[index - 1][1] > begin_ns:
+        index -= 1
+
+    total = 0
+    while index < len(intervals):
+        interval_begin, interval_end = intervals[index]
+        if interval_begin >= end_ns:
+            break
+        clipped_begin = max(interval_begin, begin_ns)
+        clipped_end = min(interval_end, end_ns)
+        if clipped_end > clipped_begin:
+            total += clipped_end - clipped_begin
+        index += 1
+    return total
+
+
+def collect_physical_checkpoint_associations(
+    collector: Collector,
+) -> Dict[int, PhysicalCheckpoint]:
+    physical_by_batch = {}  # type: Dict[int, PhysicalCheckpoint]
+    conflicting_batch_ids = set()  # type: Set[int]
+    duplicate_batch_counts = Counter()
+    invalid_batch_ids = array("Q")
+    empty_flush_stats = BatchFlushStats()
+
+    for checkpoint in collector.physical_checkpoints:
+        batch_id = checkpoint.batch_id
+        if not batch_id:
+            continue
+        if batch_id in conflicting_batch_ids:
+            duplicate_batch_counts[batch_id] += 1
+        elif batch_id in physical_by_batch:
+            conflicting_batch_ids.add(batch_id)
+            duplicate_batch_counts[batch_id] = 2
+            del physical_by_batch[batch_id]
+        else:
+            physical_by_batch[batch_id] = checkpoint
+
+    if conflicting_batch_ids:
+        collector.consistency_reasons[
+            "physical_checkpoint_duplicate_batch_id"
+        ] += len(conflicting_batch_ids)
+        collector.counts["physical_checkpoint_invalid_records"] += sum(
+            duplicate_batch_counts.values()
+        )
+
+    for batch_id, checkpoint in physical_by_batch.items():
+        if not checkpoint.valid:
+            collector.counts["physical_checkpoint_invalid_records"] += 1
+            invalid_batch_ids.append(batch_id)
+            continue
+
+        observed = collector.device_flush_batches.get(
+            batch_id, empty_flush_stats
+        )
+        mismatch = (
+            observed.total_ns != checkpoint.device_flush_ns
+            or observed.max_ns != checkpoint.device_flush_max_ns
+            or observed.count != checkpoint.device_flush_count
+            or observed.errors != checkpoint.device_flush_errors
+        )
+        if mismatch:
+            collector.consistency_reasons[
+                "physical_checkpoint_type2_aggregate_mismatch"
+            ] += 1
+        if observed.mount_devs and observed.mount_devs != {
+            checkpoint.mount_dev
+        }:
+            collector.consistency_reasons[
+                "physical_checkpoint_type2_mount_mismatch"
+            ] += 1
+            mismatch = True
+
+        if any(
+            begin_ns < checkpoint.begin_ns
+            or end_ns > checkpoint.end_ns
+            or end_ns < begin_ns
+            for begin_ns, end_ns, mount_dev in observed.intervals
+            if mount_dev == checkpoint.mount_dev
+        ):
+            collector.consistency_reasons[
+                "physical_checkpoint_flush_outside_execution"
+            ] += 1
+            mismatch = True
+        if mismatch:
+            collector.counts["physical_checkpoint_invalid_records"] += 1
+            invalid_batch_ids.append(batch_id)
+            continue
+
+        collector.counts["physical_checkpoint_valid_records"] += 1
+        collector.counts[
+            "physical_checkpoint_source1_attempts"
+        ] += checkpoint.device_flush_count
+        collector.counts[
+            "physical_checkpoint_source1_errors"
+        ] += checkpoint.device_flush_errors
+        collector.metrics["physical_checkpoint_execution"].add(
+            checkpoint.execution_ns
+        )
+        collector.metrics["physical_checkpoint_device_flush"].add(
+            checkpoint.device_flush_ns
+        )
+        share_ppm = (
+            checkpoint.device_flush_ns
+            * 1_000_000
+            // checkpoint.execution_ns
+        )
+        collector.metrics[
+            "physical_checkpoint_device_flush_share_ppm"
+        ].add(share_ppm)
+        if checkpoint.device_flush_count:
+            collector.counts[
+                "physical_checkpoint_batches_with_device_flush"
+            ] += 1
+            collector.metrics[
+                "physical_checkpoint_device_flush_share_nonzero_ppm"
+            ].add(share_ppm)
+
+    for batch_id in invalid_batch_ids:
+        del physical_by_batch[batch_id]
+
+    missing_ids = sum(
+        1 for checkpoint in collector.physical_checkpoints
+        if checkpoint.batch_id == 0
+    )
+    if missing_ids:
+        collector.counts["physical_checkpoint_invalid_records"] += missing_ids
+    return physical_by_batch
+
+
+def collect_checkpoint_associations(
+    collector: Collector,
+    physical_batches: Dict[int, PhysicalCheckpoint],
+) -> None:
+    ordered_intervals = {}  # type: Dict[int, List[Tuple[int, int]]]
+    interval_starts = {}  # type: Dict[int, List[int]]
+    target_batch_ids = set()  # type: Set[int]
+    target_physical_batch_ids = set()  # type: Set[int]
+    all_target_batch_ids = set()  # type: Set[int]
+    batch_reports = {}  # type: Dict[int, Tuple[int, int, int, int, int]]
+    exec_reports = {}  # type: Dict[int, Tuple[bool, int, int]]
+    conflicting_batch_ids = set()  # type: Set[int]
+    exec_conflicting_batch_ids = set()  # type: Set[int]
+    empty_flush_stats = BatchFlushStats()
+
+    for mount_dev, intervals in collector.device_flush_intervals.items():
+        ordered = merge_intervals(intervals)
+        ordered_intervals[mount_dev] = ordered
+        interval_starts[mount_dev] = [interval[0] for interval in ordered]
+
+    for checkpoint in collector.target_checkpoints:
+        if not checkpoint.association_valid:
+            continue
+        report = (
+            checkpoint.device_flush_ns,
+            checkpoint.device_flush_max_ns,
+            checkpoint.device_flush_count,
+            checkpoint.device_flush_errors,
+            checkpoint.mount_dev,
+        )
+        batch_id = checkpoint.batch_id
+        execution_report = (
+            checkpoint.execution_valid,
+            checkpoint.execution_begin_ns,
+            checkpoint.execution_end_ns,
+        )
+        all_target_batch_ids.add(batch_id)
+        previous = batch_reports.get(batch_id)
+        if previous is None:
+            batch_reports[batch_id] = report
+        elif previous != report:
+            conflicting_batch_ids.add(batch_id)
+        previous_execution = exec_reports.get(batch_id)
+        if previous_execution is None:
+            exec_reports[batch_id] = execution_report
+        elif previous_execution != execution_report:
+            exec_conflicting_batch_ids.add(batch_id)
+
+    if conflicting_batch_ids:
+        collector.consistency_reasons[
+            "checkpoint_batch_result_mismatch_between_waiters"
+        ] += len(conflicting_batch_ids)
+
+    if exec_conflicting_batch_ids:
+        collector.consistency_reasons[
+            "checkpoint_exec_mismatch_between_waiters"
+        ] += len(exec_conflicting_batch_ids)
+
+    if collector.format_version >= 3:
+        for batch_id, execution_report in exec_reports.items():
+            if batch_id in exec_conflicting_batch_ids:
+                continue
+            execution_valid, execution_begin, execution_end = execution_report
+            physical = physical_batches.get(batch_id)
+            batch_report = batch_reports.get(batch_id)
+            target_mount_dev = (
+                batch_report[4]
+                if batch_report is not None
+                and batch_id not in conflicting_batch_ids
+                else None
+            )
+            mismatch = False
+            if execution_valid:
+                mismatch = (
+                    physical is None
+                    or physical.begin_ns != execution_begin
+                    or physical.end_ns != execution_end
+                    or physical.mount_dev != target_mount_dev
+                )
+            elif physical is not None:
+                mismatch = True
+            if mismatch:
+                collector.consistency_reasons[
+                    "checkpoint_exec_type3_mismatch"
+                ] += 1
+
+    type2_mismatch_batch_ids = set()  # type: Set[int]
+    for batch_id, report in batch_reports.items():
+        if batch_id in conflicting_batch_ids:
+            continue
+        total_ns, max_ns, count, errors, mount_dev = report
+        observed = collector.device_flush_batches.get(
+            batch_id, empty_flush_stats
+        )
+        mismatch = (
+            observed.total_ns != total_ns
+            or observed.max_ns != max_ns
+            or observed.count != count
+            or observed.errors != errors
+        )
+        if mismatch:
+            collector.consistency_reasons[
+                "checkpoint_batch_result_type2_mismatch"
+            ] += 1
+        if observed.mount_devs and observed.mount_devs != {mount_dev}:
+            collector.consistency_reasons[
+                "checkpoint_batch_mount_device_mismatch"
+            ] += 1
+            mismatch = True
+        if mismatch:
+            type2_mismatch_batch_ids.add(batch_id)
+
+    for checkpoint in collector.target_checkpoints:
+        if not checkpoint.association_valid:
+            collector.counts["checkpoint_assoc_unavailable_records"] += 1
+            continue
+        if checkpoint.batch_id in conflicting_batch_ids:
+            collector.counts["checkpoint_assoc_unavailable_records"] += 1
+            collector.counts["checkpoint_assoc_conflicting_records"] += 1
+            continue
+        if checkpoint.batch_id in type2_mismatch_batch_ids:
+            collector.counts["checkpoint_assoc_unavailable_records"] += 1
+            collector.counts["checkpoint_assoc_type2_mismatch_records"] += 1
+            continue
+        observed = collector.device_flush_batches.get(
+            checkpoint.batch_id, empty_flush_stats
+        )
+        if any(
+            begin_ns < checkpoint.begin_ns
+            or end_ns > checkpoint.end_ns
+            or end_ns < begin_ns
+            for begin_ns, end_ns, mount_dev in observed.intervals
+            if mount_dev == checkpoint.mount_dev
+        ):
+            collector.consistency_reasons[
+                "checkpoint_batch_flush_outside_waiter_wall"
+            ] += 1
+            collector.counts["checkpoint_assoc_unavailable_records"] += 1
+            collector.counts["checkpoint_assoc_type2_mismatch_records"] += 1
+            continue
+
+        collector.counts["checkpoint_assoc_records"] += 1
+        collector.counts["checkpoint_assoc_wall_ns_total"] += checkpoint.wall_ns
+        target_batch_ids.add(checkpoint.batch_id)
+        intervals = ordered_intervals.get(checkpoint.mount_dev, [])
+        starts = interval_starts.get(checkpoint.mount_dev, [])
+        overlap_ns = clipped_interval_union_ns(
+            intervals, starts, checkpoint.begin_ns, checkpoint.end_ns
+        )
+        completion_intervals = merge_intervals(
+            [
+                (begin_ns, end_ns, checkpoint.batch_id)
+                for begin_ns, end_ns, mount_dev in observed.intervals
+                if mount_dev == checkpoint.mount_dev
+            ]
+        )
+        completion_overlap_ns = clipped_interval_union_ns(
+            completion_intervals,
+            [item[0] for item in completion_intervals],
+            checkpoint.begin_ns,
+            checkpoint.end_ns,
+        )
+        other_overlap_ns = max(overlap_ns - completion_overlap_ns, 0)
+
+        collector.counts[
+            "checkpoint_batch_flush_ns_per_waiter_total"
+        ] += checkpoint.device_flush_ns
+        collector.counts[
+            "checkpoint_overlap_ns_per_waiter_total"
+        ] += overlap_ns
+        collector.counts[
+            "checkpoint_other_overlap_ns_per_waiter_total"
+        ] += other_overlap_ns
+
+        if checkpoint.device_flush_count:
+            collector.counts["checkpoint_records_with_batch_flush"] += 1
+            collector.metrics["checkpoint_batch_flush"].add(
+                checkpoint.device_flush_ns
+            )
+        if overlap_ns:
+            collector.counts["checkpoint_records_with_flush_overlap"] += 1
+            collector.metrics["checkpoint_flush_overlap"].add(overlap_ns)
+        if other_overlap_ns:
+            collector.counts[
+                "checkpoint_records_with_other_flush_overlap"
+            ] += 1
+            collector.metrics["checkpoint_other_flush_overlap"].add(
+                other_overlap_ns
+            )
+
+        if overlap_ns < completion_overlap_ns:
+            collector.consistency_reasons[
+                "checkpoint_completion_overlap_exceeds_all_wall_overlap"
+            ] += 1
+        if checkpoint.wall_ns:
+            collector.metrics["checkpoint_batch_flush_share_ppm"].add(
+                checkpoint.device_flush_ns * 1_000_000 // checkpoint.wall_ns
+            )
+            collector.metrics["checkpoint_flush_overlap_share_ppm"].add(
+                overlap_ns * 1_000_000 // checkpoint.wall_ns
+            )
+            collector.metrics[
+                "checkpoint_other_flush_overlap_share_ppm"
+            ].add(other_overlap_ns * 1_000_000 // checkpoint.wall_ns)
+        else:
+            collector.consistency_reasons[
+                "checkpoint_zero_wall_for_flush_share"
+            ] += 1
+
+    collector.counts["checkpoint_assoc_unique_batches"] = len(target_batch_ids)
+    collector.counts["checkpoint_assoc_merged_waiter_records"] = max(
+        collector.counts["checkpoint_assoc_records"] - len(target_batch_ids), 0
+    )
+
+    if collector.format_version >= 3:
+        for batch_id in target_batch_ids:
+            execution_report = exec_reports.get(batch_id)
+            physical = physical_batches.get(batch_id)
+            if (
+                execution_report is None
+                or batch_id in exec_conflicting_batch_ids
+            ):
+                collector.counts[
+                    "target_physical_checkpoint_unavailable_batches"
+                ] += 1
+                continue
+            execution_valid, execution_begin, execution_end = execution_report
+            if not execution_valid:
+                collector.counts[
+                    "target_physical_checkpoint_unavailable_batches"
+                ] += 1
+                if physical is None:
+                    collector.counts[
+                        "target_physical_checkpoint_no_execution_batches"
+                    ] += 1
+                continue
+            batch_report = batch_reports.get(batch_id)
+            target_mount_dev = (
+                batch_report[4]
+                if batch_report is not None
+                and batch_id not in conflicting_batch_ids
+                else None
+            )
+            if (
+                physical is None
+                or physical.begin_ns != execution_begin
+                or physical.end_ns != execution_end
+                or physical.mount_dev != target_mount_dev
+            ):
+                collector.counts[
+                    "target_physical_checkpoint_unavailable_batches"
+                ] += 1
+                continue
+
+            target_physical_batch_ids.add(batch_id)
+            collector.counts[
+                "target_physical_checkpoint_valid_batches"
+            ] += 1
+            collector.counts[
+                "target_physical_checkpoint_source1_attempts"
+            ] += physical.device_flush_count
+            collector.counts[
+                "target_physical_checkpoint_source1_errors"
+            ] += physical.device_flush_errors
+            if physical.error:
+                collector.counts[
+                    "target_physical_checkpoint_errors"
+                ] += 1
+            collector.metrics[
+                "target_physical_checkpoint_execution"
+            ].add(physical.execution_ns)
+            collector.metrics[
+                "target_physical_checkpoint_device_flush"
+            ].add(physical.device_flush_ns)
+            share_ppm = (
+                physical.device_flush_ns
+                * 1_000_000
+                // physical.execution_ns
+            )
+            collector.metrics[
+                "target_physical_checkpoint_device_flush_share_ppm"
+            ].add(share_ppm)
+            if physical.device_flush_count:
+                collector.counts[
+                    "target_physical_checkpoint_batches_with_device_flush"
+                ] += 1
+                collector.metrics[
+                    "target_physical_checkpoint_device_flush_share_nonzero_ppm"
+                ].add(share_ppm)
+
+    for batch_id in target_batch_ids:
+        observed = collector.device_flush_batches.get(
+            batch_id, empty_flush_stats
+        )
+        collector.counts["checkpoint_assoc_source1_records"] += observed.count
+        collector.counts[
+            "checkpoint_assoc_unique_batch_flush_ns"
+        ] += observed.total_ns
+        collector.counts[
+            "checkpoint_assoc_source1_errors"
+        ] += observed.errors
+
+    if collector.format_version >= 3:
+        for intervals in collector.device_flush_intervals.values():
+            for begin_ns, end_ns, batch_id in intervals:
+                if (
+                    batch_id in target_physical_batch_ids
+                    and end_ns >= begin_ns
+                ):
+                    collector.metrics[
+                        "checkpoint_associated_device_flush"
+                    ].add(end_ns - begin_ns)
+
+    association_ids = (
+        set(physical_batches)
+        if collector.format_version >= 3
+        else all_target_batch_ids
+    )
+    orphan_batches = set(collector.device_flush_batches) - association_ids
+    if orphan_batches:
+        collector.consistency_reasons[
+            "associated_source1_batch_without_valid_checkpoint"
+        ] += len(orphan_batches)
+
+
+def add_share_ppm(
+    collector: Collector, metric_name: str, numerator: int, denominator: int
+) -> None:
+    if denominator:
+        collector.metrics[metric_name].add(
+            numerator * 1_000_000 // denominator
+        )
+
+
+def collect_balance_checkpoint_associations(
+    collector: Collector,
+    physical_batches: Dict[int, PhysicalCheckpoint],
+) -> None:
+    if collector.format_version < 6:
+        return
+
+    records = collector.balance_checkpoints
+    if not len(records):
+        return
+    last_call_indices = array("Q", [0]) * collector.parsed_records
+    last_call_batch_ids = array("Q", [0]) * collector.parsed_records
+    duplicate_parents = bytearray((collector.parsed_records + 7) // 8)
+    for index in range(len(records)):
+        if not records.valid[index]:
+            continue
+        parent_seq = int(records.parent_seqs[index])
+        call_index = int(records.call_indices[index])
+        batch_id = int(records.batch_ids[index])
+        previous_call = int(last_call_indices[parent_seq])
+        previous_batch = int(last_call_batch_ids[parent_seq])
+        if previous_call and call_index <= previous_call:
+            byte_index = parent_seq >> 3
+            mask = 1 << (parent_seq & 7)
+            if not duplicate_parents[byte_index] & mask:
+                duplicate_parents[byte_index] |= mask
+                collector.counts[
+                    "balance_checkpoint_duplicate_parent_fsyncs"
+                ] += 1
+            reason = (
+                "balance_checkpoint_duplicate_parent_call_batch"
+                if call_index == previous_call and batch_id == previous_batch
+                else "balance_checkpoint_nonmonotonic_parent_call_index"
+            )
+            collector.consistency_reasons[reason] += 1
+        if call_index > previous_call:
+            last_call_indices[parent_seq] = call_index
+            last_call_batch_ids[parent_seq] = batch_id
+    del last_call_indices
+    del last_call_batch_ids
+
+    batch_reports = {}  # type: Dict[int, Tuple[int, int, int, int, int, int, int]]
+    conflicting_batches = set()  # type: Set[int]
+
+    for index in range(len(records)):
+        if not records.valid[index]:
+            continue
+        parent_seq = int(records.parent_seqs[index])
+        if duplicate_parents[parent_seq >> 3] & (1 << (parent_seq & 7)):
+            continue
+        execution_begin_ns = int(records.execution_begin_ns[index])
+        execution_end_ns = int(records.execution_end_ns[index])
+        if not execution_begin_ns and not execution_end_ns:
+            continue
+        batch_id = int(records.batch_ids[index])
+        report = (
+            int(records.mount_devs[index]),
+            execution_begin_ns,
+            execution_end_ns,
+            int(records.device_flush_ns[index]),
+            int(records.device_flush_max_ns[index]),
+            int(records.device_flush_counts[index]),
+            int(records.device_flush_errors[index]),
+        )
+        previous = batch_reports.get(batch_id)
+        if previous is None:
+            batch_reports[batch_id] = report
+        elif previous != report:
+            conflicting_batches.add(batch_id)
+
+    if conflicting_batches:
+        collector.consistency_reasons[
+            "balance_checkpoint_batch_result_mismatch_between_waiters"
+        ] += len(conflicting_batches)
+
+    parent_seen = bytearray((collector.parsed_records + 7) // 8)
+    parent_ids = array("Q")
+    parent_sync_totals = array("Q", [0]) * collector.parsed_records
+    parent_execution_totals = (
+        array("Q", [0]) * collector.parsed_records
+    )
+    parent_flush_totals = array("Q", [0]) * collector.parsed_records
+    parent_balance_denominators = (
+        array("Q", [0]) * collector.parsed_records
+    )
+    parent_fsync_denominators = (
+        array("Q", [0]) * collector.parsed_records
+    )
+    associated_waiters = array("B", [0]) * len(records)
+    attributed_execution_ns = array("Q", [0]) * len(records)
+    invalid_aggregate_parents = bytearray(
+        (collector.parsed_records + 7) // 8
+    )
+    target_batch_ids = set()  # type: Set[int]
+
+    for index in range(len(records)):
+        if not records.valid[index]:
+            continue
+
+        parent_seq = int(records.parent_seqs[index])
+        if duplicate_parents[parent_seq >> 3] & (1 << (parent_seq & 7)):
+            collector.counts[
+                "balance_checkpoint_association_invalid_waiters"
+            ] += 1
+            collector.counts[
+                "balance_checkpoint_duplicate_parent_waiters"
+            ] += 1
+            continue
+        sync_wait_ns = int(records.sync_wait_ns[index])
+        batch_id = int(records.batch_ids[index])
+        execution_begin_ns = int(records.execution_begin_ns[index])
+        execution_end_ns = int(records.execution_end_ns[index])
+        flush_ns = int(records.device_flush_ns[index])
+        flush_count = int(records.device_flush_counts[index])
+        flush_errors = int(records.device_flush_errors[index])
+        parent_fsync_ns = int(records.parent_fsync_ns[index])
+        parent_balance_ns = int(records.parent_balance_ns[index])
+        execution_present = bool(execution_begin_ns or execution_end_ns)
+        execution_ns = 0
+
+        if execution_present:
+            physical = physical_batches.get(batch_id)
+            report = batch_reports.get(batch_id)
+            expected = (
+                int(records.mount_devs[index]),
+                execution_begin_ns,
+                execution_end_ns,
+                flush_ns,
+                int(records.device_flush_max_ns[index]),
+                flush_count,
+                flush_errors,
+            )
+            if batch_id in conflicting_batches:
+                collector.counts[
+                    "balance_checkpoint_association_invalid_waiters"
+                ] += 1
+                collector.counts[
+                    "balance_checkpoint_conflicting_batch_waiters"
+                ] += 1
+                continue
+            if report != expected or physical is None:
+                collector.consistency_reasons[
+                    "balance_checkpoint_type3_missing_or_invalid"
+                ] += 1
+                collector.counts[
+                    "balance_checkpoint_association_invalid_waiters"
+                ] += 1
+                continue
+            mismatch = (
+                physical.mount_dev != expected[0]
+                or physical.begin_ns != execution_begin_ns
+                or physical.end_ns != execution_end_ns
+                or physical.device_flush_ns != flush_ns
+                or physical.device_flush_max_ns != expected[4]
+                or physical.device_flush_count != flush_count
+                or physical.device_flush_errors != flush_errors
+            )
+            if mismatch:
+                collector.consistency_reasons[
+                    "balance_checkpoint_type3_result_mismatch"
+                ] += 1
+                collector.counts[
+                    "balance_checkpoint_association_invalid_waiters"
+                ] += 1
+                continue
+            execution_ns = physical.execution_ns
+            if execution_ns > sync_wait_ns:
+                collector.consistency_reasons[
+                    "balance_checkpoint_execution_exceeds_waiter_wall"
+                ] += 1
+                collector.counts[
+                    "balance_checkpoint_association_invalid_waiters"
+                ] += 1
+                continue
+        elif batch_id and batch_id in physical_batches:
+            collector.consistency_reasons[
+                "balance_checkpoint_no_execution_has_type3"
+            ] += 1
+            collector.counts[
+                "balance_checkpoint_association_invalid_waiters"
+            ] += 1
+            continue
+        associated_waiters[index] = 1
+        attributed_execution_ns[index] = execution_ns
+        byte_index = parent_seq >> 3
+        mask = 1 << (parent_seq & 7)
+        if not parent_seen[byte_index] & mask:
+            parent_seen[byte_index] |= mask
+            parent_ids.append(parent_seq)
+            parent_balance_denominators[parent_seq] = parent_balance_ns
+            parent_fsync_denominators[parent_seq] = parent_fsync_ns
+        elif (
+            parent_balance_denominators[parent_seq] != parent_balance_ns
+            or parent_fsync_denominators[parent_seq] != parent_fsync_ns
+        ):
+            collector.consistency_reasons[
+                "balance_checkpoint_parent_denominator_mismatch"
+            ] += 1
+        parent_sync_totals[parent_seq] += sync_wait_ns
+        parent_execution_totals[parent_seq] += execution_ns
+        parent_flush_totals[parent_seq] += flush_ns
+
+    for parent_seq in parent_ids:
+        sync_wait_ns = int(parent_sync_totals[parent_seq])
+        execution_ns = int(parent_execution_totals[parent_seq])
+        flush_ns = int(parent_flush_totals[parent_seq])
+        parent_balance_ns = int(
+            parent_balance_denominators[parent_seq]
+        )
+        parent_fsync_ns = int(parent_fsync_denominators[parent_seq])
+        if (
+            sync_wait_ns > parent_balance_ns
+            or execution_ns > sync_wait_ns
+            or flush_ns > execution_ns
+        ):
+            collector.consistency_reasons[
+                "balance_checkpoint_parent_aggregate_invalid"
+            ] += 1
+            collector.counts[
+                "balance_checkpoint_invalid_parent_share_records"
+            ] += 1
+            invalid_aggregate_parents[parent_seq >> 3] |= (
+                1 << (parent_seq & 7)
+            )
+            continue
+        collector.counts["balance_checkpoint_unique_parents"] += 1
+        collector.metrics[
+            "balance_checkpoint_parent_sync_wait_wall"
+        ].add(sync_wait_ns)
+        if execution_ns:
+            collector.counts[
+                "balance_checkpoint_parents_with_execution"
+            ] += 1
+        else:
+            collector.counts[
+                "balance_checkpoint_parents_without_execution"
+            ] += 1
+        add_share_ppm(
+            collector,
+            "balance_checkpoint_sync_wait_parent_balance_share_ppm",
+            sync_wait_ns,
+            parent_balance_ns,
+        )
+        add_share_ppm(
+            collector,
+            "balance_checkpoint_execution_parent_balance_share_ppm",
+            execution_ns,
+            parent_balance_ns,
+        )
+        add_share_ppm(
+            collector,
+            "balance_checkpoint_sync_wait_parent_fsync_share_ppm",
+            sync_wait_ns,
+            parent_fsync_ns,
+        )
+        add_share_ppm(
+            collector,
+            "balance_checkpoint_flush_parent_balance_share_ppm",
+            flush_ns,
+            parent_balance_ns,
+        )
+        add_share_ppm(
+            collector,
+            "balance_checkpoint_execution_parent_fsync_share_ppm",
+            execution_ns,
+            parent_fsync_ns,
+        )
+        add_share_ppm(
+            collector,
+            "balance_checkpoint_flush_parent_fsync_share_ppm",
+            flush_ns,
+            parent_fsync_ns,
+        )
+        if execution_ns:
+            add_share_ppm(
+                collector,
+                "balance_checkpoint_flush_execution_share_ppm",
+                flush_ns,
+                execution_ns,
+            )
+        collector.counts[
+            "balance_checkpoint_parent_sync_wait_ns_total"
+        ] += sync_wait_ns
+        collector.counts[
+            "balance_checkpoint_parent_execution_ns_total"
+        ] += execution_ns
+        collector.counts[
+            "balance_checkpoint_parent_flush_ns_total"
+        ] += flush_ns
+        collector.counts[
+            "balance_checkpoint_triggering_parent_balance_ns_total"
+        ] += parent_balance_ns
+        collector.counts[
+            "balance_checkpoint_triggering_parent_fsync_ns_total"
+        ] += parent_fsync_ns
+
+    for index in range(len(records)):
+        if not associated_waiters[index]:
+            continue
+        parent_seq = int(records.parent_seqs[index])
+        if invalid_aggregate_parents[parent_seq >> 3] & (
+            1 << (parent_seq & 7)
+        ):
+            collector.counts[
+                "balance_checkpoint_association_invalid_waiters"
+            ] += 1
+            collector.counts[
+                "balance_checkpoint_invalid_parent_waiters"
+            ] += 1
+            continue
+
+        sync_wait_ns = int(records.sync_wait_ns[index])
+        execution_ns = int(attributed_execution_ns[index])
+        flush_ns = int(records.device_flush_ns[index])
+        flush_count = int(records.device_flush_counts[index])
+        flush_errors = int(records.device_flush_errors[index])
+        collector.counts["balance_checkpoint_association_valid_waiters"] += 1
+        if execution_ns:
+            collector.counts[
+                "balance_checkpoint_waiters_with_execution"
+            ] += 1
+            target_batch_ids.add(int(records.batch_ids[index]))
+        else:
+            collector.counts[
+                "balance_checkpoint_waiters_without_execution"
+            ] += 1
+
+        collector.metrics["balance_checkpoint_sync_wait_wall"].add(
+            sync_wait_ns
+        )
+        collector.metrics[
+            "balance_checkpoint_attributed_physical_execution"
+        ].add(execution_ns)
+        collector.metrics["balance_checkpoint_wait_minus_execution"].add(
+            sync_wait_ns - execution_ns
+        )
+        collector.metrics["balance_checkpoint_device_flush"].add(flush_ns)
+        collector.counts[
+            "balance_checkpoint_source1_attempts_per_waiter"
+        ] += flush_count
+        collector.counts[
+            "balance_checkpoint_source1_errors_per_waiter"
+        ] += flush_errors
+
+    collector.counts[
+        "balance_checkpoint_unique_execution_batches"
+    ] = len(target_batch_ids)
+    collector.counts[
+        "balance_checkpoint_merged_extra_waiters"
+    ] = max(
+        collector.counts["balance_checkpoint_waiters_with_execution"]
+        - len(target_batch_ids),
+        0,
+    )
+
+    for batch_id in target_batch_ids:
+        physical = physical_batches[batch_id]
+        collector.metrics[
+            "balance_checkpoint_unique_physical_execution"
+        ].add(physical.execution_ns)
+        collector.metrics["balance_checkpoint_unique_device_flush"].add(
+            physical.device_flush_ns
+        )
+        add_share_ppm(
+            collector,
+            "balance_checkpoint_unique_flush_execution_share_ppm",
+            physical.device_flush_ns,
+            physical.execution_ns,
+        )
+        collector.counts[
+            "balance_checkpoint_unique_source1_attempts"
+        ] += physical.device_flush_count
+        collector.counts[
+            "balance_checkpoint_unique_source1_errors"
+        ] += physical.device_flush_errors
+
