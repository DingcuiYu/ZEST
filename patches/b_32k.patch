+            ),
+            "swapout_atomic_lifecycle": (
+                "The v2 submit_state is an atomic hand-off protocol. State "
+                "async_endio_before_return_marker means end_io changed the "
+                "state before the post-submit caller marker; "
+                "async_endio_after_return_marker means it observed the marker "
