+    def invalid_record(self, reasons: Sequence[str]) -> None:
+        self.counts["invalid_records"] += 1
+        self.invalid_record_reasons.update(reasons)
+
+    def checked_delta(self, end: int, begin: int, name: str) -> Optional[int]:
+        if begin == 0 or end == 0:
+            self.invalid_stage_reasons[name + "_missing_timestamp"] += 1
+            return None
+        if end < begin:
+            self.invalid_stage_reasons[name + "_reversed_timestamp"] += 1
+            return None
+        return end - begin
+
+    def checked_accumulated(
+        self, total: int, begin: int, end: int, name: str
+    ) -> Optional[int]:
+        envelope = self.checked_delta(end, begin, name)
+        if envelope is None:
+            return None
+        if total > envelope:
+            self.invalid_stage_reasons[name + "_total_exceeds_envelope"] += 1
+            return None
+        return total
