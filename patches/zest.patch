+/*
+ * zest-znswap:  Returns true iff @folio is swapped to the ZEST swapfile AND the 
+ * freelist currently holds more than zest_cache_retain_min_free free zones -- i.e. 
+ * there is physical headroom to keep swapped-in clean pages' slots instead of 
+ * trimming them under the kernel's device-agnostic vm_swap_full() heuristic.
+ */
+bool __zest_swap_retain_cache(struct folio *folio);
