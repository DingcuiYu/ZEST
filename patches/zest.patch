+def _build_argument_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        description=(
+            "流式分析 SWPLAT raw 中的 swap-in/swap-out 路径组合与 "
+            "call/kernel/device 延迟，并保留 swap-in flag accounting 及 "
+            "VM_FAULT_MAJOR；同时输出 ZEST staging/flush/read 插桩摘要；"
+            "ZEST 摘要另含 submit 延迟；不依赖 ADB，也不会修改 raw。"
+        )
+    )
+    parser.add_argument("raw", type=Path, help="SWPLAT .raw 文件路径")
+    parser.add_argument(
+        "-o",
+        "--output",
+        type=Path,
+        help=(
+            "JSON 输出路径；默认与 raw 同目录并添加 "
+            "_path_accounting.json。使用 '-' 只输出 JSON 到 stdout。"
+        ),
+    )
+    parser.add_argument(
+        "--tgid",
+        action="append",
+        type=_parse_nonnegative_int,
+        default=[],
+        help="只统计指定 TGID，可重复；同类多个值按 OR 处理",
+    )
+    parser.add_argument(
+        "--pid",
+        action="append",
+        type=_parse_nonnegative_int,
+        default=[],
+        help="只统计指定 PID，可重复；同类多个值按 OR 处理",
+    )
+    parser.add_argument(
+        "--comm",
+        action="append",
+        default=[],
+        help="只统计精确匹配的 16-byte task comm，可重复",
+    )
+    parser.add_argument(
+        "--quiet",
+        action="store_true",
+        help="不显示扫描进度和人类可读摘要",
+    )
+    return parser
+
+
+def main() -> int:
+    parser = _build_argument_parser()
+    args = parser.parse_args()
+    raw_path = args.raw.expanduser()
+    if not raw_path.is_file():
+        parser.error(f"raw 文件不存在或不是普通文件: {raw_path}")
+
+    output_to_stdout = str(args.output) == "-" if args.output else False
+    output_path = None
+    if not output_to_stdout:
+        output_path = (
+            args.output.expanduser()
+            if args.output is not None
+            else _default_output_path(raw_path)
+        )
+
+    try:
+        if not args.quiet and not output_to_stdout:
+            print(f"正在扫描 {raw_path.resolve()} ...", file=sys.stderr)
+        analysis = analyze_raw(
+            raw_path=raw_path,
+            tgids=set(args.tgid),
+            pids=set(args.pid),
+            comms=set(args.comm),
+            show_progress=not args.quiet and not output_to_stdout,
+        )
+    except (OSError, ValueError, struct.error) as exc:
+        print(f"错误: {exc}", file=sys.stderr)
+        return 1
+
+    rendered = json.dumps(analysis, ensure_ascii=False, indent=2)
+    if output_to_stdout:
+        print(rendered)
+        return 0
+
+    try:
+        output_path.parent.mkdir(parents=True, exist_ok=True)
+        output_path.write_text(rendered + "\n", encoding="utf-8")
+    except OSError as exc:
+        print(f"写入 JSON 失败: {exc}", file=sys.stderr)
+        return 1
+
+    if not args.quiet:
+        _print_summary(analysis, output_path)
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
