+def _print_zest_summary(analysis: dict) -> None:
+    zest = analysis["zest_instrumentation"]
+    print("\n  ZEST instrumentation:")
+    print(
+        f"    marker_present={str(zest['present']).lower()}, "
+        f"marker_records={zest['marker_records']:,}, "
+        f"marker_devices={len(zest['marker_devices']):,}"
+    )
+    _print_zest_layer_summary(
+        "staging swap-out (logical/early-ack)",
+        zest["swapout"]["staging"],
+    )
+    _print_zest_layer_summary(
+        "flush bio (SWAP_LATENCY_F_ZEST_FLUSH)",
+        zest["swapout"]["flush"],
+    )
+    _print_zest_layer_summary(
+        "read bio (device-correlated)",
+        zest["swapin"]["read"],
+    )
+    print(
+        "    read candidates without a ZEST marker: "
+        f"{zest['swapin']['unresolved_read_candidates']:,} "
+        "(not attributed)"
+    )
