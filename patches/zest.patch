+struct zest_chunk_read_cookie {
+	struct swap_info_struct *si;
+	struct swap_info_ext *sie;
+	struct zest_swap_chunk_desc *desc;
+};
+
+bool swap_zest_chunk_members(struct swap_info_struct *si, unsigned long slot,
+			swp_entry_t entries[ZEST_SWAP_CHUNK_PAGES], unsigned int *index,
+			unsigned int *valid_mask)
+{
+	struct swap_info_ext *sie = to_swap_info_ext(si);
+	unsigned int c, i;
+
+	if (!sie || slot == 0 || slot >= si->max)
+		return false;
+	c = slot / ZEST_SWAP_CHUNK_PAGES;
+	if (c == UINT_MAX || c >= sie->zest_chunk_nr)
+		return false;
+	/* The allocation bitmap is the publication point; reject readers until
+	 * all eight entries and the valid mask have been committed. */
+	if (!test_bit(c, sie->zest_chunk_alloc))
+		return false;
+	smp_rmb();
+	spin_lock(&sie->zest_chunks[c].read_lock);
+	if (!sie->zest_chunks[c].usable ||
+	    !test_bit(c, sie->zest_chunk_alloc)) {
+		spin_unlock(&sie->zest_chunks[c].read_lock);
+		return false;
+	}
+	for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++)
+		entries[i] = READ_ONCE(sie->zest_chunks[c].slots[i]);
+	if (index)
+		*index = slot % ZEST_SWAP_CHUNK_PAGES;
+	if (valid_mask)
+		*valid_mask = READ_ONCE(sie->zest_chunks[c].valid_mask);
+	spin_unlock(&sie->zest_chunks[c].read_lock);
+	return true;
+}
+EXPORT_SYMBOL_GPL(swap_zest_chunk_members);
+
+int swap_zest_chunk_read_begin(struct swap_info_struct *si, unsigned long slot,
+		void **cookie)
+{
+	struct swap_info_ext *sie = to_swap_info_ext(si);
+	struct zest_chunk_read_cookie *c;
+	unsigned int chunk;
+
+	if (cookie)
+		*cookie = NULL;
+	if (!sie || slot == 0 || slot >= si->max)
+		return -EINVAL;
+	chunk = slot / ZEST_SWAP_CHUNK_PAGES;
+	if (chunk == UINT_MAX || chunk >= sie->zest_chunk_nr)
+		return -ENOENT;
+	if (!test_bit(chunk, sie->zest_chunk_alloc))
+		return -ENOENT;
+	smp_rmb();
+	spin_lock(&sie->zest_chunks[chunk].read_lock);
+	if (!sie->zest_chunks[chunk].usable ||
+	    !test_bit(chunk, sie->zest_chunk_alloc)) {
+		spin_unlock(&sie->zest_chunks[chunk].read_lock);
+		return -ENOENT;
+	}
+	if (sie->zest_chunks[chunk].read_inflight) {
+		spin_unlock(&sie->zest_chunks[chunk].read_lock);
+		wait_event(sie->zest_chunks[chunk].read_wait,
+			!READ_ONCE(sie->zest_chunks[chunk].read_inflight));
+		return 0;
+	}
+	sie->zest_chunks[chunk].read_inflight = true;
+	spin_unlock(&sie->zest_chunks[chunk].read_lock);
+	c = kmalloc(sizeof(*c), GFP_NOIO);
+	if (!c) {
+		spin_lock(&sie->zest_chunks[chunk].read_lock);
+		sie->zest_chunks[chunk].read_inflight = false;
+		spin_unlock(&sie->zest_chunks[chunk].read_lock);
+		wake_up_all(&sie->zest_chunks[chunk].read_wait);
+		return -ENOMEM;
+	}
+	c->si = si;
+	c->sie = sie;
+	c->desc = &sie->zest_chunks[chunk];
+	if (cookie)
+		*cookie = c;
+	return 1;
+}
+EXPORT_SYMBOL_GPL(swap_zest_chunk_read_begin);
+
+void swap_zest_chunk_read_end(void *cookie)
+{
+	struct zest_chunk_read_cookie *c = cookie;
+	bool release = false;
+	if (!c)
+		return;
+	/* A final slot free may have reached valid_mask==0 while this leader was
+	 * reading.  Keep the descriptor reserved until now, then return its full
+	 * eight-slot capacity atomically with respect to a new allocator. */
+	spin_lock(&c->si->lock);
+	spin_lock(&c->desc->read_lock);
+	c->desc->read_inflight = false;
+	if (c->desc->release_pending && !c->desc->valid_mask) {
+		c->desc->release_pending = false;
+		clear_bit(c->desc - c->sie->zest_chunks, c->sie->zest_chunk_alloc);
+		c->sie->zest_chunk_free++;
+		release = true;
+	}
+	spin_unlock(&c->desc->read_lock);
+	spin_unlock(&c->si->lock);
+	wake_up_all(&c->desc->read_wait);
+	if (release)
+		atomic_long_add(ZEST_SWAP_CHUNK_PAGES, &nr_swap_pages);
+	kfree(c);
+}
+EXPORT_SYMBOL_GPL(swap_zest_chunk_read_end);
