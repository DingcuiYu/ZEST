+/* Gather eight independent base-page anonymous folios for Zest's strict
+ * chunk allocator.  Peers are selected from the same isolated list and
+ * returned there on any failure; no partial swap-cache transaction escapes. */
+static bool zest_add_anon_folios_to_swap_chunk(struct folio *first,
+		struct list_head *folio_list, struct list_head *ret_folios,
+		struct scan_control *sc, struct reclaim_stat *stat,
+		unsigned int *pgactivate)
+{
+	struct folio *folios[ZEST_SWAP_CHUNK_PAGES] = { first };
+	struct folio *folio, *next;
+	LIST_HEAD(selected);
+	unsigned int valid_mask = 0;
+	int nr = 1;
+	bool added = false;
+	bool all_unmapped = true;
+	int i;
+
+	list_for_each_entry_safe(folio, next, folio_list, lru) {
+		if (nr == ZEST_SWAP_CHUNK_PAGES)
+			break;
+		if (folio_test_large(folio) || !folio_test_anon(folio) ||
+		    !folio_test_swapbacked(folio) || folio_test_swapcache(folio) ||
+		    folio_test_active(folio) || folio_test_writeback(folio) ||
+		    folio_memcg(folio) != folio_memcg(first))
+			continue;
+		if (!folio_trylock(folio))
+			continue;
+		if (!folio_test_uptodate(folio) || !folio_evictable(folio) ||
+		    folio_maybe_dma_pinned(folio) ||
+		    (!sc->may_unmap && folio_mapped(folio))) {
+			folio_unlock(folio);
+			continue;
+		}
+		list_move_tail(&folio->lru, &selected);
+		folios[nr++] = folio;
+	}
+
+	if (nr == ZEST_SWAP_CHUNK_PAGES) {
+		added = add_to_swap_chunk(folios, &valid_mask);
+		if (!added)
+			zest_account_chunk_grouping_fail();
+	} else {
+		/* Prefer another swap backend for an unmatched group.  Calling the
+		 * ordinary allocator first preserves normal multi-backend behaviour;
+		 * only a swap set consisting solely of this strict Zest backend may
+		 * consume an underfilled chunk reservation. */
+		if (add_to_swap(first)) {
+			valid_mask = 1u;
+			added = true;
+		} else if (swap_zest_only_backend()) {
+			added = add_to_swap_chunk(folios, &valid_mask);
+			if (added)
+				zest_account_chunk_underfilled();
+			else
+				zest_account_chunk_grouping_fail();
+		}
+	}
+	if (added) {
+		for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++) {
+			if (!(valid_mask & (1u << i)))
+				continue;
+			if (!folio_mapped(folios[i]))
+				continue;
+			try_to_unmap(folios[i], TTU_BATCH_FLUSH);
+			if (folio_mapped(folios[i]))
+				all_unmapped = false;
+		}
+	}
+	if (added && !all_unmapped) {
+		/* Keep the operation transactional: a partially unmapped group must
+		 * not leave swap-cache ownership behind without a writeable chunk. */
+		for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++) {
+			if ((valid_mask & (1u << i)) &&
+			    folio_test_swapcache(folios[i])) {
+				delete_from_swap_cache(folios[i]);
+				folio_mark_dirty(folios[i]);
+			}
+		}
+		added = false;
+	}
+	/* A complete transaction leaves peers in the isolated batch for normal
+	 * reclaim processing.  If fewer than eight pages were available, those
+	 * peers were not part of any swap transaction; reactivate them directly
+	 * so this reclaim pass does not immediately retry the same underfilled
+	 * group. */
+	if (nr != ZEST_SWAP_CHUNK_PAGES && ret_folios) {
+		list_for_each_entry_safe(folio, next, &selected, lru) {
+			list_move_tail(&folio->lru, ret_folios);
+			folio_set_active(folio);
+			if (stat)
+				stat->nr_activate[0]++;
+			if (pgactivate)
+				(*pgactivate)++;
+			count_memcg_folio_events(folio, PGACTIVATE, 1);
+		}
+	} else {
+		list_splice_init(&selected, folio_list);
+	}
+	while (--nr > 0)
+		folio_unlock(folios[nr]);
+	return added;
+}
