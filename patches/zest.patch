+def _print_summary(analysis: dict, output_path: Optional[Path]) -> None:
+    header = analysis["header"]
+    records = analysis["records"]
+    paths = analysis["path_accounting"]["swapin"]
+    percentages = analysis["path_percentages"]["swapin"]
+    major = analysis["major_fault_accounting"]["swapin"]
+    major_by_path = major["by_path"]
+    major_percentages = major["percent_within_each_path"]
