diff --git a/block/Kconfig b/block/Kconfig
index f1364d1c0d93eb64b0aefae3a915fedbee105a63..66f007331463d99ae77410af4aad49b85abbb807 100644
--- a/block/Kconfig
+++ b/block/Kconfig
@@ -88,6 +88,24 @@ config BLK_DEV_ZONED
 
 	Say yes here if you have a ZAC, ZBC, or ZNS storage device.
 
+# zest1: backport of upstream zone write plugging (6.10+) gated behind a
+# compile-time switch. When disabled, the kernel uses the original 6.6
+# zone write locking path (no behavioral change). When enabled, sequential
+# write ordering is done at the bio layer (no scheduler tag occupation) and
+# the zoned device no longer requires the mq-deadline scheduler.
+config BLK_ZONE_WRITE_PLUGGING
+	bool "Zone write plugging (backport)"
+	default n
+	depends on BLK_DEV_ZONED
+	help
+	  Backport of the upstream zone write plugging mechanism. Sequential
+	  write ordering for zoned block devices is performed at the bio level
+	  instead of via per-zone write locking in the I/O scheduler. Plugged
+	  write bios do not hold scheduler tags, which avoids tag-quota
+	  contention and removes the dependency on the mq-deadline scheduler.
+
+	  If unsure, say N (the original zone write locking path is used).
+
 config BLK_DEV_THROTTLING
 	bool "Block layer bio throttling support"
 	depends on BLK_CGROUP
