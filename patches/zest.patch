+/* zest1: zone write plugging (backport). See block/blk-zoned.c. */
+#ifdef CONFIG_BLK_ZONE_WRITE_PLUGGING
+/* Moved here (from blk-merge.c) so blk-zoned.c can merge plugged bios. */
+enum bio_merge_status {
+	BIO_MERGE_OK,
+	BIO_MERGE_NONE,
+	BIO_MERGE_FAILED,
+};
+enum bio_merge_status bio_attempt_back_merge(struct request *req,
+		struct bio *bio, unsigned int nr_segs);
+
+bool blk_zone_plug_bio(struct bio *bio, unsigned int nr_segs);
+
+static inline bool bio_zone_write_plugging(struct bio *bio)
+{
+	return bio_flagged(bio, BIO_ZONE_WRITE_PLUGGING);
+}
+
+void blk_zone_write_plug_bio_merged(struct bio *bio);
+void blk_zone_write_plug_init_request(struct request *rq);
+
+static inline void blk_zone_update_request_bio(struct request *rq,
+					       struct bio *bio)
+{
+	/*
+	 * For zone append requests, the request sector indicates the location
+	 * at which the BIO data was written. Return this value to the BIO
+	 * issuer through the BIO iter sector. For plugged zone writes, which
+	 * include emulated zone append, we need to ensure that the BIO issuer
+	 * sees the correct write position.
