+/*
+ * Registry entry. zest_init_for_swapfile populates everything below
+ * and zest_release_for_swapfile tears it down.
+ */
+struct zest_info {
+	struct f2fs_sb_info	*sbi;
+	struct swap_info_struct	*sis;
+	struct block_device	*bdev;
+
+	//zest3: L2P map -- index = swap slot in [0, nr_slots),
+	//value = 512B sector on bdev, ZEST_INVALID_SECTOR means unmapped.
+	//Allocated and filled with the invalid sentinel because sector 0 can
+	//be a valid physical address on some devices.
+	sector_t		*l2p;
+	unsigned long		nr_slots;	/* == sis->max at init time */
+	//zest3: zone array, kvzalloc'd. Sorted by start_sector ascending,
+	//covers the swap-visible zones PLUS the auto-reserved over-provisioning
+	//(OP) zones. cur_zone is the allocator cursor cycling through zones
+	//circularly.
+	unsigned int		nr_zones;
+	unsigned int		zone_cap;
+	struct zest_zone	*zones;
+	unsigned int		cur_zone;
+
+	mempool_t *read_batch_pool;
+	struct bio_set read_bioset;
+	bool read_bioset_ready;
+	//zest3: over-provisioning region, in F2FS blocks, on the swapfile
+	//inode just past the swap-visible size [op_start_lblk, +op_nr_blocks).
+	//Reserved at swapon via f2fs_zest_reserve_op_section() and kept across
+	//swapoff (freed only when the swapfile is deleted). op_nr_blocks==0
+	//means "no OP headroom" (degraded but functional).
+	unsigned int		op_start_lblk;
+	unsigned int		op_nr_blocks;
+
+	//zest-wbuf: io_lock is GONE. The old mutex serialized allocate-wp +
+	//build-bio + submit_bio so writes reached the zoned device in write-
+	//pointer order. That ordering is now provided by the single CPU7-bound
+	//wbuf kthread, the sole host writer of cur_zone / wp_blocks; the swap-out
+	//path only copies into RAM and never submits a device write.
+
+	//zest-wbuf: RAM write-staging buffer ring (replaces the folio-packing
+	//wbio). Swap-out memcpy's into the FILLING buffer and acks immediately;
+	//a full/sealed buffer is flushed to the device by the FIFO wbuf kthread as
+	//a sequence of 256 KiB target-sized bios, with the zone write pointer
+	//allocated only at flush time. io_lock is GONE from the write path:
+	//device-write submission ordering is provided by the single wbuf kthread.
+	//  - buf_lock guards wbuf_cur, each buffer's `fill`, and the FILLING->
+	//    FLUSHING seal. Tiny critical section: no memcpy, no submit under it.
+	//  - wb->copied is a lockless atomic (producer adds after its memcpy);
+	//    the flush worker waits copied >= sealed_fill before building the bio.
+	//  - writers that need a fresh buffer but find none FREE wait on
+	//    wbuf_free_wait (bounded) then reject (folio re-dirtied) -- the
+	//    pressure valve, equivalent to the old "no free zone" reject.
+	struct zest_wbuf	wbufs[ZEST_WBUF_COUNT];
+	unsigned int		wbuf_cap;	/* pages per buffer (all equal) */
+	unsigned int		wbuf_cur;	/* index of the FILLING buffer */
+	spinlock_t		buf_lock;	/* guards wbuf_cur, fill, state/seal */
+	wait_queue_head_t	wbuf_free_wait;	/* writers wait for a FREE buffer */
+	struct list_head	wbuf_flush_list;	/* sealed buffers in submission order */
+	wait_queue_head_t	wbuf_wait;	/* wbuf kthread waits for sealed buffers */
+	wait_queue_head_t	wbuf_drain_wait;	/* teardown waits for batch drain */
+	atomic_t		wbuf_pending;	/* queued plus actively flushing buffers */
+	struct task_struct	*wbuf_thread;	/* CPU7-bound FIFO flush executor */
+
+	//zest-gc: write telemetry (ALWAYS counted, independent of the switch).
+	//bio_count = number of submitted bios across host flush + GC (for avg bio size).
+	//host_wb_bytes / gc_wb_bytes = device bytes written by the host buffer flush
+	//vs GC relocation, summed by bio->bi_iter.bi_size per submit. Surfaced via
+	///sys/kernel/zest/stats as: avg_bio_kb = (host+gc)/bio_count (coalescing),
+	//total_write_kb = host+gc, write_amp = (host+gc)/host (GC write overhead).
+	atomic64_t		bio_count;
+	atomic64_t		host_wb_bytes;
+	atomic64_t		gc_wb_bytes;
+	//zest-read: device-backed read BIO count and bytes, used for average
+	//read BIO size telemetry.
+	atomic64_t		read_bio_count;
+	atomic64_t		read_bio_bytes;
+
+	//zest-wbuf: flush-size telemetry. flush_count = number of buffer flushes,
+	//flush_pages = total pages flushed. avg flush size = flush_pages/flush_count
+	//(in pages); surfaced via /sys/kernel/zest/stats to diagnose whether flushes
+	//actually reach the buffer cap (big bios) or are dribbling out small.
+	atomic64_t		flush_count;
+	atomic64_t		flush_pages;
+
+	//zest3: freelist of zones with wp_blocks == 0 (EMPTY). GC returns
+	//zones here after reset; swap-out pops when cur_zone fills.
+	struct list_head	freelist;
+	spinlock_t		freelist_lock;
+	//zest-gc: O(1) freelist depth, kept in sync with adds/removes under
+	//freelist_lock. Read locklessly by the GC trigger / kthread loop.
+	atomic_t		nr_free_zones;
+
+	//zest-gc: sole consistency point for the logical maps. Guards every
+	//transition of l2p[], each zone->rmap[], and zone valid_blocks. A
+	//spinlock (not a mutex) so the swap-slot-free hook -- which runs under
+	//swap_info_struct::lock (atomic) -- can participate. All users must use
+	//spin_lock_bh()/spin_unlock_bh(): chunk BIO completions run in softirq
+	//context, and plain spin_lock() in a reclaim path could self-deadlock when
+	//a completion interrupts the lock holder. NEVER held across a sleeping
+	//call (no bio_alloc / submit_bio / mutex under it).
+	spinlock_t		map_lock;
+
+	//zest-gc: GC write frontier zone index, independent of the host's
+	//cur_zone so GC migration writes pack into their own zone. Touched only
+	//by the single GC executor (gc_thread) -> no lock needed. ZEST_NO_ZONE
+	//means no frontier is open yet (one is popped from the freelist on the
+	//next GC write).
+	unsigned int		gc_cur_zone;
+
+	//zest-gc: preallocated migration buffer (ZEST_GC_BUF_PAGES entries),
+	//owned solely by gc_thread. Reserved at swapon so GC never allocates
+	//pages on the reclaim/writeback path. Single executor => no locking.
+	struct zest_gc_ent	*gc_buf;
+	unsigned int		gc_buf_nr;
+	//zest-ra: gc_buf page backing-store bookkeeping. When gc_buf_contig, all
+	//gc_buf[i].page come from one high-order run (gc_buf_base, gc_buf_order) so
+	//GC writes coalesce into big bios (matching the host flush). On the per-page
+	//fallback gc_buf_base==NULL and each page is freed individually. Set at
+	//swapon (unconditional -- NOT gated by the ra switch).
+	struct page		*gc_buf_base;
+	unsigned int		gc_buf_order;
+	bool			gc_buf_contig;
+
+	//zest-gc: the single GC executor and its two wait queues:
+	//  gc_wait      -- gc_thread sleeps here until kicked (freelist low).
+	//  gc_done_wait -- swap-out writers blocked on an empty freelist sleep
+	//                  here; GC wakes them each time it frees a zone.
+	struct task_struct	*gc_thread;
+	wait_queue_head_t	gc_wait;
+	wait_queue_head_t	gc_done_wait;
+	atomic_t		gc_kick;	/* wake/reevaluate request */
+	atomic_t		gc_reset_kick;	/* direct reset request from slot frees */
+
+	//zest-gc: stats, surfaced via /sys/kernel/zest/stats.
+	atomic64_t		gc_runs;		/* GC cycles run */
+	atomic64_t		gc_moved_blocks;	/* blocks relocated */
+	atomic64_t		gc_zones_reclaimed;	/* victims reset+freed */
+	atomic64_t		gc_direct;		/* FULL zones reset without migration */
+	atomic64_t		gc_aborts_stale;	/* commits dropped: l2p moved */
+	atomic64_t		gc_normal;		/* normal-level attempts */
+	atomic64_t		gc_fixed;		/* fixed threshold/target attempts */
+	atomic64_t		gc_boost;		/* boost-level attempts */
+	atomic64_t		gc_emergency;		/* emergency-level attempts */
+	atomic64_t		gc_success;		/* successfully reclaimed zones */
+	atomic64_t		gc_no_victim;		/* attempts with no profitable victim */
+	atomic64_t		gc_enospc;		/* attempts that ran out of frontier */
+	atomic64_t		gc_io_errors;		/* other GC errors */
+	atomic64_t		gc_backoff;		/* scheduler rounds that backed off */
+	atomic64_t		gc_config_generation;
+	atomic_t		gc_last_free_zones;	/* last observed free-zone count */
+	atomic_t		gc_last_level;	/* enum zest_gc_level */
+	atomic64_t		gc_victim_valid_ratio;	/* sum of logical valid ratios (%) */
+
+	atomic64_t		gc_victim_count;	/* number of selected victims */
+
+	//zest3: captured mkswap header (slot 0). PAGE_SIZE kmalloc'd
+	//buffer; populated at init then immutable. Serves the (defensive)
+	//slot-0 read path. Allowing init to copy the header lets us reset
+	//the zone that originally held it.
+	void			*mkswap_header;
+
+	atomic64_t		nr_writes;
+	atomic64_t		nr_reads;
+	atomic64_t		nr_write_rejects;	//zest3
+
+	atomic64_t	chunk_alloc_success;
+	atomic64_t	chunk_alloc_fail;
+	atomic64_t	chunk_grouping_fail;
+	atomic64_t	chunk_underfilled;
+	atomic64_t	chunk_duplicate_fault_merged;
+	atomic64_t	chunk_read_groups;
+	atomic64_t	chunk_members_requested;
+	atomic64_t	chunk_member_cache_hits;
+	atomic64_t	chunk_member_bio_submitted;
+	atomic64_t	chunk_member_read_errors;
+	atomic64_t	chunk_read_from_wbuf;
+	atomic64_t	chunk_read_from_device;
+
+	//zest3.1: L2P out-of-bounds FATAL latch. Tripped the first time a swap
+	//slot index >= nr_slots reaches the hot path (which would otherwise
+	//index l2p[] past its end -> heap corruption). Once set, this swapfile
+	//rejects every further swap-in/out without touching l2p[] or submitting
+	//a bio. Mirrored into the subsystem-wide zest_fatal* globals so it stays
+	//readable via /sys/kernel/zest/fatal even after swapoff frees this zi.
+	atomic_t		fatal;		/* 0=ok, 1=permanently tripped */
+	atomic64_t		fatal_count;	/* # of OOB events observed */
+	atomic64_t		fatal_slot;	/* last offending slot index */
+	atomic_t		fatal_nr;	/* last offending nr_pages */
+};
+
+//zest3.1: subsystem-wide mirror of the per-swapfile FATAL latch. Lives in
+//zest_main.c, outlives any individual zest_info, and backs the read-only
+///sys/kernel/zest/fatal node so the latch is observable until module unload
+/// reboot (not just until swapoff).
+extern atomic_t		zest_fatal;
+extern atomic64_t	zest_fatal_count;
+extern atomic64_t	zest_fatal_slot;
+extern atomic_t		zest_fatal_nr;
