+/* Master static branch. Toggle via /sys/kernel/zest/enable. */
+DEFINE_STATIC_KEY_FALSE(zest_enabled_key);
+
+/* /sys/kernel/zest/swapfile_sync; applies to subsequent ZEST swap faults. */
+bool swapfile_sync;
+
+/* Global stats. Defined here, declared in zest_internal.h. */
+struct zest_global_stats zest_stats;
+
+unsigned int zest_readahead_window_bytes = 32u << 10;
+/* Keep the existing sector layout as the default.  The complete chunk data
+ * path is an explicit opt-in and must not silently alter an established
+ * on-device layout. */
+unsigned int zest_layout_mode = ZEST_LAYOUT_LEGACY_SECTOR;
+/* Kept for ABI/source compatibility with older debug tooling. */
+unsigned int zest_readahead_mode = ZEST_LAYOUT_LEGACY_SECTOR;
+atomic_t zest_readahead_latched = ATOMIC_INIT(0);
+atomic64_t zest_ra_attempts = ATOMIC64_INIT(0);
+atomic64_t zest_ra_requested = ATOMIC64_INIT(0);
+atomic64_t zest_ra_submitted = ATOMIC64_INIT(0);
+atomic64_t zest_ra_cache_hits = ATOMIC64_INIT(0);
+atomic64_t zest_ra_fault_hits = ATOMIC64_INIT(0);
+atomic64_t zest_ra_skipped_invalid = ATOMIC64_INIT(0);
+atomic64_t zest_ra_boundary_stops = ATOMIC64_INIT(0);
+atomic64_t zest_ra_io_errors = ATOMIC64_INIT(0);
+
+//zest-znswap: swap-cache retention threshold in free zones (see
+//ZEST_CACHE_RETAIN_MIN_FREE). Tunable via /sys/kernel/zest/cache_retain_min_free.
+unsigned int zest_cache_retain_min_free = ZEST_CACHE_RETAIN_MIN_FREE;
+
+/* zest3.1: subsystem-wide FATAL latch mirror. See zest_internal.h. */
+atomic_t   zest_fatal       = ATOMIC_INIT(0);
+atomic64_t zest_fatal_count = ATOMIC64_INIT(0);
+atomic64_t zest_fatal_slot  = ATOMIC64_INIT(0);
+atomic_t   zest_fatal_nr    = ATOMIC_INIT(0);
