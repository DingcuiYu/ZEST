+def _print_zest_layer_summary(label: str, layer: dict) -> None:
+    latency = layer["latency"]
+    print(
+        f"    {label}: records={layer['record_count']:,}, "
+        f"io_bytes={layer['io_bytes']:,}, "
+        f"min/max_io_bytes={layer['min_io_bytes']:,}/"
+        f"{layer['max_io_bytes']:,}, "
+        f"nr_pages={layer['nr_pages']:,}, "
+        f"avg_io_bytes={layer['average_io_bytes']:.2f}, "
+        f"submit_valid={layer['submit_valid_records']:,}, "
+        "errors="
+        f"{layer['error_records']:,}, "
+        f"untracked={layer['untracked_records']:,}, "
+        f"device_valid={layer['device_valid_records']:,}"
+    )
+    for family in _ZEST_LATENCY_FAMILIES:
+        metric = latency[family]
+        percentiles = metric["percentiles_ms"]
+        print(
+            f"      {family:<6} samples={metric['count']:,} "
+            f"avg={metric['average_ms']:.6f}ms "
+            f"p99={percentiles['p99']:.6f}ms "
+            f"max={metric['max_ms']:.6f}ms"
+        )
+
