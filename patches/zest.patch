+//zest: physical zone-sector readahead front-end.  Candidate slots are
+//collected from ZEST's reverse map, then fed through the normal swap-cache
+//and asynchronous swap_readpage paths so GC/inflight-read synchronization is
+//shared with demand faults.
+static struct page *zest_swapin_readahead(swp_entry_t fentry, gfp_t gfp_mask,
+						  struct vm_fault *vmf)
+{
+	struct swap_info_struct *sis = swp_swap_info(fentry);
+	struct blk_plug plug;
+	struct swap_iocb *splug = NULL;
+	unsigned long *slots;
+	unsigned int window, nr, i;
+	struct page *page;
+	bool allocated, demand_allocated;
+
+	if (!sis || !zest_should_intercept(sis))
+		return NULL;
+
+	atomic64_inc(&zest_ra_attempts);
+	if (zest_swap_chunk_mode(sis)) {
+		void *cookie = NULL;
+		swp_entry_t entries[ZEST_CHUNK_PAGES];
+		unsigned int fault_idx, valid_mask, i;
+		unsigned int requested = 0, hits = 0, bios = 0, errors = 0;
+		bool fault_alloc_failed = false;
+		int leader;
+
+		/* Elect the leader before creating any demand folio.  Waiters simply
+		 * retry the ordinary swap-cache lookup after the leader publishes all
+		 * members. */
+		leader = swap_zest_chunk_read_begin(sis, swp_offset(fentry), &cookie);
+		if (leader <= 0) {
+			if (leader == 0)
+				zest_account_chunk_duplicate_fault();
+			return read_swap_cache_async(fentry, gfp_mask,
+				vmf ? vmf->vma : NULL, vmf ? vmf->address : 0, NULL);
+		}
+		if (!swap_zest_chunk_members(sis, swp_offset(fentry), entries,
+				&fault_idx, &valid_mask)) {
+			swap_zest_chunk_read_end(cookie);
+			return read_swap_cache_async(fentry, gfp_mask,
+				vmf ? vmf->vma : NULL, vmf ? vmf->address : 0, NULL);
+		}
+		if (fault_idx >= ZEST_CHUNK_PAGES ||
+		    !(valid_mask & (1u << fault_idx))) {
+			swap_zest_chunk_read_end(cookie);
+			return read_swap_cache_async(fentry, gfp_mask,
+				vmf ? vmf->vma : NULL, vmf ? vmf->address : 0, NULL);
+		}
+		page = NULL;
+		blk_start_plug(&plug);
+		for (i = 0; i < ZEST_CHUNK_PAGES; i++) {
+			bool new_page = false;
+			struct page *member;
+			if (!(valid_mask & (1u << i)))
+				continue;
+			requested++;
+			member = __read_swap_cache_async(entries[i], gfp_mask,
+					vmf ? vmf->vma : NULL, vmf ? vmf->address : 0,
+					&new_page);
+			if (!member) {
+				errors++;
+				if (i == fault_idx)
+					fault_alloc_failed = true;
+				continue;
+			}
+			if (i == fault_idx)
