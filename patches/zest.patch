+/* -------------------------------------------------------------- */
+/* Registry                                                       */
+/* -------------------------------------------------------------- */
+
+//ZEST allows exactly one zest-enabled swapfile, which this mutex lock guarantee.
+static DEFINE_MUTEX(zest_singleton_mutex); 
+
+// A single RCU-published pointer serves every runtime path with no lock:
+//  - hot path: rcu_dereference_raw(); lifetime is guaranteed because 
+//	  f2fs_swap_deactivate -> zest_release_for_swapfile
+//    runs only after try_to_unuse() has quiesced all swap I/O, so no
+//    swap-in/out can deref a freed zi.
+//  - stats/monitoring: rcu_read_lock() + rcu_dereference().
+static struct zest_info __rcu *zest_singleton;
+
+//Returns the zest_info if @sis is the only zest-enabled swapfile, else NULL.
+static __always_inline struct zest_info *zest_current(struct swap_info_struct *sis)
+{
+	struct zest_info *zi = rcu_dereference_raw(zest_singleton);
+
+	return (zi && zi->sis == sis) ? zi : NULL;
+}
+
+//Check if ZEST is in use
+bool __zest_should_intercept(struct swap_info_struct *sis)
+{
+	return zest_current(sis) != NULL;
+}
+
+bool zest_swap_chunk_mode(struct swap_info_struct *sis)
+{
+	return zest_should_intercept(sis) &&
+		READ_ONCE(zest_layout_mode) == ZEST_LAYOUT_CHUNK32K;
+}
+EXPORT_SYMBOL_GPL(zest_swap_chunk_mode);
+
+bool zest_chunk_layout_active(void)
+{
+	return static_branch_unlikely(&zest_enabled_key) &&
+		READ_ONCE(zest_layout_mode) == ZEST_LAYOUT_CHUNK32K;
+}
+EXPORT_SYMBOL_GPL(zest_chunk_layout_active);
+
+void zest_account_chunk_alloc(bool success)
+{
+	struct zest_info *zi;
+
+	rcu_read_lock();
+	zi = rcu_dereference_raw(zest_singleton);
+	if (zi)
+		atomic64_inc(success ? &zi->chunk_alloc_success :
+			&zi->chunk_alloc_fail);
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(zest_account_chunk_alloc);
+
+void zest_account_chunk_grouping_fail(void)
+{
+	struct zest_info *zi;
+
+	rcu_read_lock();
+	zi = rcu_dereference_raw(zest_singleton);
+	if (zi)
+		atomic64_inc(&zi->chunk_grouping_fail);
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(zest_account_chunk_grouping_fail);
+
+void zest_account_chunk_underfilled(void)
+{
+	struct zest_info *zi;
+
+	rcu_read_lock();
+	zi = rcu_dereference_raw(zest_singleton);
+	if (zi)
+		atomic64_inc(&zi->chunk_underfilled);
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(zest_account_chunk_underfilled);
+
+void zest_account_chunk_duplicate_fault(void)
+{
+	struct zest_info *zi;
+
+	rcu_read_lock();
+	zi = rcu_dereference_raw(zest_singleton);
+	if (zi)
+		atomic64_inc(&zi->chunk_duplicate_fault_merged);
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(zest_account_chunk_duplicate_fault);
+
+void zest_account_chunk_read_group(unsigned int members, unsigned int hits,
+		unsigned int bios, unsigned int errors)
+{
+	struct zest_info *zi;
+	rcu_read_lock();
+	zi = rcu_dereference_raw(zest_singleton);
+	if (zi) {
+		atomic64_inc(&zi->chunk_read_groups);
+		atomic64_add(members, &zi->chunk_members_requested);
+		atomic64_add(hits, &zi->chunk_member_cache_hits);
+		atomic64_add(bios, &zi->chunk_member_bio_submitted);
+		atomic64_add(errors, &zi->chunk_member_read_errors);
+	}
+	rcu_read_unlock();
+}
+EXPORT_SYMBOL_GPL(zest_account_chunk_read_group);
+
+/* -------------------------------------------------------------- */
+/* Statistics                                                     */
+/* -------------------------------------------------------------- */
+
+//zest-gc: read the (single) swapfile's GC counters for the subsystem-wide
+///sys/kernel/zest/stats node.
+void zest_gc_collect_stats(struct zest_gc_stats_sum *s)
+{
+	struct zest_info *zi;
+
+	memset(s, 0, sizeof(*s));
+	//zest: lockless via RCU -- single swapfile, no iteration. Safe to poll
+	//at high frequency for runtime monitoring; synchronize_rcu() in the
+	//release path waits out any reader here before zi is freed.
+	rcu_read_lock();
+	zi = rcu_dereference(zest_singleton);
+	if (zi) {
+		s->runs       = atomic64_read(&zi->gc_runs);
+		s->moved      = atomic64_read(&zi->gc_moved_blocks);
+		s->reclaimed  = atomic64_read(&zi->gc_zones_reclaimed);
+		s->gc_direct  = atomic64_read(&zi->gc_direct);
+		s->aborts     = atomic64_read(&zi->gc_aborts_stale);
+		s->free_zones = atomic_read(&zi->nr_free_zones);
+		s->nr_swapfiles = 1;
+		//zest-wbuf: flush-size telemetry.
+		s->flush_count = atomic64_read(&zi->flush_count);
+		s->flush_pages = atomic64_read(&zi->flush_pages);
+		s->wbuf_cap = zi->wbuf_cap;
+		//zest-gc: bio-size telemetry (host flush + GC writes).
+		s->bio_count = atomic64_read(&zi->bio_count);
+		s->host_wb_bytes = atomic64_read(&zi->host_wb_bytes);
+		s->gc_wb_bytes = atomic64_read(&zi->gc_wb_bytes);
+		s->read_bio_count = atomic64_read(&zi->read_bio_count);
+		s->read_bio_bytes = atomic64_read(&zi->read_bio_bytes);
+		s->gc_normal = atomic64_read(&zi->gc_normal);
+		s->gc_fixed = atomic64_read(&zi->gc_fixed);
+		s->gc_boost = atomic64_read(&zi->gc_boost);
+		s->gc_emergency = atomic64_read(&zi->gc_emergency);
+		s->gc_success = atomic64_read(&zi->gc_success);
+		s->gc_no_victim = atomic64_read(&zi->gc_no_victim);
+		s->gc_enospc = atomic64_read(&zi->gc_enospc);
+		s->gc_io_errors = atomic64_read(&zi->gc_io_errors);
+		s->gc_backoff = atomic64_read(&zi->gc_backoff);
+		s->gc_config_generation = atomic64_read(&zi->gc_config_generation);
+		s->gc_last_free_zones = atomic_read(&zi->gc_last_free_zones);
+		s->gc_last_level = atomic_read(&zi->gc_last_level);
+		s->gc_victim_valid_ratio = atomic64_read(&zi->gc_victim_valid_ratio);
+		s->gc_victim_count = atomic64_read(&zi->gc_victim_count);
+		s->nr_write_rejects = atomic64_read(&zi->nr_write_rejects);
+		s->chunk_alloc_success = atomic64_read(&zi->chunk_alloc_success);
+		s->chunk_alloc_fail = atomic64_read(&zi->chunk_alloc_fail);
+		s->chunk_grouping_fail = atomic64_read(&zi->chunk_grouping_fail);
+		s->chunk_underfilled = atomic64_read(&zi->chunk_underfilled);
+		s->chunk_duplicate_fault_merged =
+			atomic64_read(&zi->chunk_duplicate_fault_merged);
+		s->chunk_read_groups = atomic64_read(&zi->chunk_read_groups);
+		s->chunk_members_requested = atomic64_read(&zi->chunk_members_requested);
+		s->chunk_member_cache_hits = atomic64_read(&zi->chunk_member_cache_hits);
+		s->chunk_member_bio_submitted = atomic64_read(&zi->chunk_member_bio_submitted);
+		s->chunk_member_read_errors = atomic64_read(&zi->chunk_member_read_errors);
+		s->chunk_read_from_wbuf = atomic64_read(&zi->chunk_read_from_wbuf);
+		s->chunk_read_from_device = atomic64_read(&zi->chunk_read_from_device);
+	}
+	rcu_read_unlock();
+}
+
+/*
+ * Return the backing size visible to the allocator for a ZEST allocation.
+ * ksize() covers kmalloc/slab objects; kvmalloc() may instead return a
+ * vmalloc mapping, whose size is recorded by the vmalloc area.
+ */
+static u64 zest_alloc_size(const void *ptr)
+{
+	struct vm_struct *area;
+
+	if (!ptr)
+		return 0;
+
+	if (is_vmalloc_addr(ptr)) {
+		area = find_vm_area(ptr);
+		return area ? get_vm_area_size(area) : 0;
+	}
+
+	return ksize(ptr);
+}
+
+static u64 zest_mempool_reserve_size(const mempool_t *pool,
+					     size_t element_size)
+{
+	if (!pool || !pool->elements || pool->min_nr <= 0)
+		return 0;
+
+	return zest_alloc_size(pool->elements) +
+		(u64)pool->min_nr * kmalloc_size_roundup(element_size);
+}
+
+static u64 zest_slab_pool_size(const mempool_t *pool)
+{
+	struct kmem_cache *slab;
+
+	if (!pool || !pool->elements || pool->min_nr <= 0)
+		return 0;
+
+	slab = pool->pool_data;
+	if (!slab)
+		return zest_alloc_size(pool->elements);
+
+	return zest_alloc_size(pool->elements) +
+		(u64)pool->min_nr * kmem_cache_size(slab);
+}
+
+static u64 zest_task_memory(const struct task_struct *task)
+{
+	u64 bytes;
+
+	if (!task)
+		return 0;
+
+	bytes = zest_alloc_size(task) + zest_alloc_size(task_stack_page(task));
+#ifdef CONFIG_SHADOW_CALL_STACK
+	bytes += zest_alloc_size(task_scs(task));
+#endif
+	/* worker_private is the private struct kthread allocation. */
+	bytes += zest_alloc_size(task->worker_private);
+	return bytes;
+}
+
+static void zest_report_memory(struct zest_info *zi)
+{
+	u64 info_b, l2p_b, zones_b, rmap_b = 0;
+	u64 wbuf_data_b = 0, wbuf_meta_b = 0;
+	u64 gcbuf_data_b, gcbuf_meta_b, hdr_b;
+	u64 batch_pool_b, bio_pool_b, threads_b = 0, total;
+	unsigned int i, thread_count = 0;
+
+	if (!zi)
+		return;
+
+	/* zi includes embedded wbuf descriptors and the embedded bio_set. */
+	info_b = zest_alloc_size(zi);
+	l2p_b = zest_alloc_size(zi->l2p);
+	zones_b = zest_alloc_size(zi->zones);
+	for (i = 0; i < zi->nr_zones; i++)
+		rmap_b += zest_alloc_size(zi->zones[i].rmap);
+
+	for (i = 0; i < ZEST_WBUF_COUNT; i++) {
+		struct zest_wbuf *wb = &zi->wbufs[i];
+
+		if (wb->pages)
+			wbuf_data_b += (u64)wb->cap * PAGE_SIZE;
+		wbuf_meta_b += zest_alloc_size(wb->pages);
+		wbuf_meta_b += zest_alloc_size(wb->bslot);
+	}
+
+	gcbuf_meta_b = zest_alloc_size(zi->gc_buf);
+	gcbuf_data_b = (u64)zi->gc_buf_nr * PAGE_SIZE;
+	hdr_b = zest_alloc_size(zi->mkswap_header);
+
+	batch_pool_b = zest_alloc_size(zi->read_batch_pool);
+	if (zi->read_batch_pool)
+		batch_pool_b += zest_mempool_reserve_size(zi->read_batch_pool,
+							 sizeof(struct zest_read_batch));
+	bio_pool_b = zest_slab_pool_size(&zi->read_bioset.bio_pool) +
+		zest_slab_pool_size(&zi->read_bioset.bvec_pool);
+
+	if (zi->wbuf_thread) {
+		threads_b += zest_task_memory(zi->wbuf_thread);
+		thread_count++;
+	}
+	if (zi->gc_thread) {
+		threads_b += zest_task_memory(zi->gc_thread);
+		thread_count++;
+	}
+
+	total = info_b + l2p_b + zones_b + rmap_b +
+		wbuf_data_b + wbuf_meta_b + gcbuf_data_b + gcbuf_meta_b +
+		hdr_b + batch_pool_b + bio_pool_b + threads_b;
+
+	pr_notice("zest-mem: info=%lluB l2p=%lluB zones=%lluB(cap=%u nr=%u) "
+		  "rmap=%lluB wbuf_data=%lluB wbuf_meta=%lluB "
+			"gc_data=%lluB gc_meta=%lluB header=%lluB "
+		  "read_batch_reserve=%lluB read_bio_reserve=%lluB "
+		  "threads=%lluB(n=%u) | owned_total=%lluB (%lluKiB)\n",
+		  info_b, l2p_b, zones_b, zi->zone_cap, zi->nr_zones,
+		  rmap_b, wbuf_data_b, wbuf_meta_b,
+		  gcbuf_data_b, gcbuf_meta_b, hdr_b,
+		batch_pool_b, bio_pool_b, threads_b, thread_count,
+		  total, total >> 10);
+	pr_notice("zest-mem: allocator-visible ZEST-owned backing; excludes "
+		  "SLAB/VMAP/KASAN metadata, global bio caches, in-flight pool "
+		  "overflow, block requests, DMA mappings, kthread full names, and "
+		  "swap-latency tracing\n");
+}
+
+//Redirect counters (called from F2FS segment.c, gc.c) 
+void zest_account_redirect_data(void)
+{
+	atomic64_inc(&zest_stats.redirect_data);
+}
+
+void zest_account_redirect_node(void)
+{
+	atomic64_inc(&zest_stats.redirect_node);
+}
+
+/* -------------------------------------------------------------- */
+/* ZEST-ZNSwap                                                    */
+/* -------------------------------------------------------------- */
+//If the swapfile is the ZEST swapfile and the freelist still holds STRICTLY MORE
+//than zest_cache_retain_min_free free zones, tell mm to keep the slot (return
+//true) instead of trimming under vm_swap_full().
+bool __zest_swap_retain_cache(struct folio *folio)
+{
+	struct swap_info_struct *sis = swp_swap_info(folio->swap);
+	struct zest_info *zi;
+
+	if (!sis)
+		return false;
+	zi = zest_current(sis);
+	if (!zi)
+		return false;
+	/* Strict 32 KiB logical chunks must not retain individual swap-cache
+	 * members: keeping one folio alive pins the whole descriptor's capacity
+	 * and lets a single process consume an excessive amount of swap cache. */
+	if (zest_swap_chunk_mode(sis))
+		return false;
+	return atomic_read(&zi->nr_free_zones) >
+	       READ_ONCE(zest_cache_retain_min_free);
+}
+
+/* -------------------------------------------------------------- */
+/* ZEST: bio completion + helpers                                */
+/* -------------------------------------------------------------- */
+
+//Trip the permanent L2P-OOB FATAL latch.
+//
+//Records the offending (slot, nr_pages) on both the per-swapfile zest_info
+//and the subsystem-wide mirror (so /sys/kernel/zest/fatal survives swapoff),
+//latches `fatal` so all subsequent interceptions reject immediately, then
+//shouts via pr_emerg_ratelimited. With CONFIG_PSTORE_CONSOLE=y that emerg
+//line is captured into the pstore Console record (ramoops / efi-pstore) for
+//post-reboot forensics. We deliberately do NOT BUG()/panic: the caller exits
+//the page safely so the rest of the system keeps running and the latch can be
+//read out live via sysfs.
+//
+//`fatal` (the latch) is set last so any reader that observes fatal==1 also
+//observes the matching count/slot/nr that were stored just before it.
+static void zest_fatal_trip(struct zest_info *zi, unsigned long slot,
+			    unsigned int nr_pages)
+{
+	atomic64_inc(&zi->fatal_count);
+	atomic64_set(&zi->fatal_slot, slot);
+	atomic_set(&zi->fatal_nr, nr_pages);
+	smp_wmb();
+	atomic_set(&zi->fatal, 1);
+
+	atomic64_inc(&zest_fatal_count);
+	atomic64_set(&zest_fatal_slot, slot);
+	atomic_set(&zest_fatal_nr, nr_pages);
+	smp_wmb();
+	atomic_set(&zest_fatal, 1);
+
+	pr_emerg_ratelimited("zest: FATAL L2P OOB slot=%lu nr=%u nr_slots=%lu\n",
+			     slot, nr_pages, zi->nr_slots);
+}
+
+//Binary search through zi->zones[] for the zone containing a 
+//given 512B sector. Returns zi->nr_zones if not found (caller should
+//tolerate; this should never happen for a sector we ourselves handed
+//out via the allocator).
+static unsigned int zest_find_zone_for_sector(struct zest_info *zi,
+					       sector_t sector)
+{
+	unsigned int lo = 0, hi = zi->nr_zones;
+
+	while (lo < hi) {
+		unsigned int mid = lo + (hi - lo) / 2;
+		struct zest_zone *z = &zi->zones[mid];
+		sector_t zone_end =
+			z->start_sector + ((sector_t)z->nr_blocks <<
+				(PAGE_SHIFT - 9));
+
+		if (sector < z->start_sector)
+			hi = mid;
+		else if (sector >= zone_end)
+			lo = mid + 1;
+		else
+			return mid;
+	}
+	return zi->nr_zones;
+}
+
+//Block offset of @sector within zone @z.
+static inline unsigned int zest_blk_in_zone(const struct zest_zone *z,
+					    sector_t sector)
+{
+	return (unsigned int)((sector - z->start_sector) >> (PAGE_SHIFT - 9));
+}
+
+//Invalidate the L2P -> physical mapping that @sector currently backs. 
+//MUST be called with zi->map_lock held.
+static void zest_map_invalidate_sector(struct zest_info *zi, sector_t sector,
+				       u32 expected_slot)
+{
+	unsigned int z_idx = zest_find_zone_for_sector(zi, sector);
+	struct zest_zone *z;
+
+	if (z_idx >= zi->nr_zones)
+		return;
+	z = &zi->zones[z_idx];
+	
+	unsigned int blk = zest_blk_in_zone(z, sector);
+	if (blk >= z->nr_blocks) {
+		zest_fatal_trip(zi, sector, 1);
+		return;
+	}
+
+	if (z->rmap[blk] != expected_slot) {
+		zest_fatal_trip(zi, sector, 1);
+		return;
+	}
+	if (z->rmap[blk] != ZEST_INVALID_SLOT) {
+		z->rmap[blk] = ZEST_INVALID_SLOT;
+		atomic_dec(&z->valid_blocks);
+	}
+	
+}
+
+//zest-read: single-page swap read completion. Marks the folio uptodate and unlocks it.
+static void zest_end_swap_bio_read(struct bio *bio)
+{
+	struct folio *folio = bio_first_folio_all(bio);
+	struct zest_zone *z = bio->bi_private;
+
+	if (bio->bi_status) {
+		if (folio_test_readahead(folio))
+			atomic64_inc(&zest_ra_io_errors);
+		pr_alert("zest: read-error on swap-device (%u:%u:%llu) bi status %d\n",
+				     MAJOR(bio_dev(bio)), MINOR(bio_dev(bio)),
+				     (unsigned long long)bio->bi_iter.bi_sector, bio->bi_status);
+	} else {
+		folio_mark_uptodate(folio);
+	}
+	folio_unlock(folio);
+	if (z)
+		atomic_dec(&z->inflight_reads);
+	bio_put(bio);
+}
+
+static void zest_end_swap_bio_read_traced(struct bio *bio)
+{
+	struct zest_read_io *io = bio->bi_private;
+	void *latency = io->latency_io;
+
+	swap_latency_async_io_complete(latency, bio->bi_status);
+
+	struct folio *folio = bio_first_folio_all(bio);
+	struct zest_zone *z = io->z;
+
+	if (bio->bi_status) {
+		if (folio_test_readahead(folio))
+			atomic64_inc(&zest_ra_io_errors);
+		pr_alert("zest: read-error on swap-device (%u:%u:%llu) bi status %d\n",
+				     MAJOR(bio_dev(bio)), MINOR(bio_dev(bio)),
+				     (unsigned long long)bio->bi_iter.bi_sector, bio->bi_status);
+	} else {
+		folio_mark_uptodate(folio);
+	}
+	folio_unlock(folio);
+	if (z)
+		atomic_dec(&z->inflight_reads);
+	
+	swap_latency_async_io_put(latency);
+	kfree(io);
+	bio_put(bio);
+}
+//zest-read: multi-page swap read completion. Marks the folio uptodate and unlocks it.
+static void zest_read_folio_finish(struct zest_read_batch *batch)
+{
+	if (batch->status) {
+		pr_alert("zest: multi-page swap read failed status=%d\n",
+					batch->status);
+	} else {
+		folio_mark_uptodate(batch->folio);
+		count_vm_events(PSWPIN, folio_nr_pages(batch->folio));
+	}
+	folio_unlock(batch->folio);
+	mempool_free(batch, batch->pool);
+}
+
+static void zest_end_swap_batch_read(struct bio *bio)
+{
+	struct zest_read_batch_ctx *ctx = bio->bi_private;
+	struct zest_read_batch *batch = ctx->batch;
+
+	if (bio->bi_status)
+	{
+		pr_alert("zest: read-error on swap-device (%u:%u:%llu) bi status %d\n", MAJOR(bio_dev(bio)), MINOR(bio_dev(bio)), (unsigned long long)bio->bi_iter.bi_sector, bio->bi_status);
+
+		cmpxchg(&batch->status, BLK_STS_OK, bio->bi_status);
+	}
+
+	if (ctx->zone)
+	{
+		unsigned int nr;
+		for(nr = ctx->nr_slots ; nr > 0; nr--)
+			atomic_dec(&ctx->zone->inflight_reads);
+	}
+
+	if (ctx->latency_io) {
+		swap_latency_async_io_complete(ctx->latency_io, bio->bi_status);
+		swap_latency_async_io_put(ctx->latency_io);
+	}
+
+	if (atomic_dec_and_test(&batch->pending)) {
+		zest_read_folio_finish(batch);
+	}
+
+	bio_put(bio);
+}
+
+//zest-read: account one device-backed read BIO using its final size before
+//submit. This measures the BIO built by Zest, not later request-queue merging.
+static __always_inline void zest_account_read_bio(struct zest_info *zi,
+						struct bio *bio)
+{
+	atomic64_add(bio->bi_iter.bi_size, &zi->read_bio_bytes);
+	atomic64_inc(&zi->read_bio_count);
+}
+
+static void zest_submit_batch_read_async(struct folio *folio, struct swap_info_struct *sis, struct zest_info *zi, struct zest_read_batch *batch, sector_t sector, unsigned int nr_slot, struct zest_zone* zone, unsigned int folio_off, bool direct)
+{
+	void *latency_io = NULL;
+	struct zest_read_batch_ctx *ctx;
+	struct zest_read_batch_io *io;
+	struct bio *bio = bio_alloc_bioset(zi->bdev, 1, REQ_OP_READ, GFP_KERNEL, &zi->read_bioset);
+	io = container_of(bio, struct zest_read_batch_io, bio);
+	ctx = &io->ctx;
+	ctx->zone = zone;
+	ctx->nr_slots = nr_slot;
+	ctx->batch = batch;
+	ctx->latency_io = NULL;
+
+	bio->bi_iter.bi_sector = sector;
+	bio->bi_end_io = zest_end_swap_batch_read;
+	bio_add_folio_nofail(bio, folio, (size_t)nr_slot << PAGE_SHIFT, folio_off);
+	bio->bi_private  = ctx;
+	atomic_inc(&batch->pending);
+
+	latency_io = swap_latency_io_begin(NULL, folio, sis, false, false,
+			direct, bio->bi_iter.bi_sector, bio->bi_iter.bi_size);
+		ctx->latency_io = latency_io;
+
+	if(!latency_io)
+	{
+		swap_latency_target_mark(NULL, folio, SWAP_LATENCY_F_UNTRACKED_IO,
+                SWAP_LATENCY_BACKEND_BLOCK_DEVICE);
+	}
+
+	zest_account_read_bio(zi, bio);
+	submit_bio(bio);
+	if (latency_io)
+		swap_latency_submit_end(latency_io);
+
+	atomic64_inc(&zi->nr_reads);
+	pr_debug("zest: async read sector: [%llu,%llu]\n",
+                  (unsigned long long)sector, (unsigned long long)(sector + ((sector_t)nr_slot << (PAGE_SHIFT - 9))));
+}
+
+static void zest_submit_batch_read_sync(struct folio *folio, struct swap_info_struct *sis, struct zest_info *zi, struct zest_read_batch *batch, sector_t sector, unsigned int nr_slot, struct zest_zone* zone, unsigned int folio_off, bool direct)
+{
+	void *latency_io = NULL;
+	struct zest_read_batch_ctx *ctx;
+	struct zest_read_batch_io *io;
+	struct bio *bio = bio_alloc_bioset(zi->bdev, 1, REQ_OP_READ, GFP_KERNEL, &zi->read_bioset);
+	int ret;
+	io = container_of(bio, struct zest_read_batch_io, bio);
+	ctx = &io->ctx;
+	ctx->zone = zone;
+	ctx->nr_slots = nr_slot;
+	ctx->batch = batch;
+	
+
+	bio->bi_iter.bi_sector = sector;
+	bio_add_folio_nofail(bio, folio, (size_t)nr_slot << PAGE_SHIFT, folio_off);
+	atomic_inc(&batch->pending);
+
+	latency_io = swap_latency_io_begin(NULL, folio, sis, false, true,
+			direct, bio->bi_iter.bi_sector, bio->bi_iter.bi_size);
+
+	if(!latency_io)
+	{
+		swap_latency_target_mark(NULL, folio, SWAP_LATENCY_F_UNTRACKED_IO,
+                SWAP_LATENCY_BACKEND_BLOCK_DEVICE);
+	}
+
+	zest_account_read_bio(zi, bio);
+	ret = submit_bio_wait(bio);
+	if (ret)
+		cmpxchg(&batch->status, BLK_STS_OK, bio->bi_status);
+	if (zone) {
+		unsigned int nr;
+
+		for (nr = ctx->nr_slots; nr > 0; nr--)
+			atomic_dec(&zone->inflight_reads);
+	}
+	if (latency_io)
+		swap_latency_sync_io_end(latency_io, bio->bi_status);
+	if (atomic_dec_and_test(&batch->pending))
+		zest_read_folio_finish(batch);
+	bio_put(bio);
+
+
+	atomic64_inc(&zi->nr_reads);
+	pr_debug("zest: read sector: [%llu,%llu]\n",
+                  (unsigned long long)sector, (unsigned long long)(sector + ((sector_t)nr_slot << (PAGE_SHIFT - 9))));
+}
+
+/**
+ * ZEST: write buffer flush worker.
+ * Run by the CPU7-bound FIFO wbuf kthread so flushes and device submits stay
+ * in write-pointer order. This replaces the io_lock that used to serialize the
+ * write path.
+ * Steps:
+ * 1. Wait for every claimed page's memcpy to finish;
+ * 2. Lay the n pages out on the device, splitting across at most one zone boundary (buffer cap <= zone size) into <=2 segments;
+ * 3. Submit ordinary contiguous flush bios asynchronously, then wait for the
+ *    batch;
+ * 4. Commit each page under map_lock only after every write succeeded and l2p[slot]
+ *    still == BUF|gidx, or the page is
+ * 	  freed or re-staged in-flight, just left unmapped for GC.
+ * 5. Recycle the buffer (FREE) and wake writers waiting for the free write buffer.
+ */
+static int zest_report_cb(struct blk_zone *zone, unsigned int idx,
+			  void *data);
+
+//zest-wbuf: one completion group for all flush bios in a sealed buffer.
+struct zest_wbuf_io {
+	atomic_t	pending;
+	blk_status_t	status;
+	struct completion done;
+};
+
+struct zest_wbuf_bio_ctx {
+	struct zest_wbuf_io *flush;
+	void *latency_io;
+};
+
+static void zest_wbuf_io_end(struct zest_wbuf_io *io, struct bio *bio)
+{
+	if (bio->bi_status) {
+		cmpxchg(&io->status, BLK_STS_OK, bio->bi_status);
+		pr_alert("zest-wbuf: flush write-error sector=%llu status=%d\n",
+			 (unsigned long long)bio->bi_iter.bi_sector,
+			 bio->bi_status);
+	}
+
+	if (atomic_dec_and_test(&io->pending))
+		complete(&io->done);
+}
+
+static void zest_wbuf_bio_endio(struct bio *bio)
+{
+	struct zest_wbuf_io *io = bio->bi_private;
+
+	zest_wbuf_io_end(io, bio);
+	bio_put(bio);
+}
+
+static void zest_wbuf_bio_endio_traced(struct bio *bio)
+{
+	struct zest_wbuf_bio_ctx *ctx = bio->bi_private;
+	void *latency = ctx->latency_io;
+
+	if (unlikely(latency))
+		swap_latency_async_io_complete(latency, bio->bi_status);
+	zest_wbuf_io_end(ctx->flush, bio);
+	if (unlikely(latency))
+		swap_latency_async_io_put(latency);
+	kfree(ctx);
+	bio_put(bio);
+}
+
+//zest-wbuf: Build the latency record for one flush bio.
+static void zest_wbuf_submit_bio(struct zest_info *zi, struct zest_wbuf_io *io, struct bio *bio, unsigned int first,
+		struct zest_wbuf *wb)
+{
+	struct swap_latency_call latency = {};
+	struct zest_wbuf_bio_ctx *ctx = NULL;
+	void *latency_io = NULL;
+	u32 slot = ZEST_INVALID_SLOT;
+
+	if (wb && first < wb->cap)
+		slot = wb->bslot[first];
+
+	/* Keep the existing always-on write telemetry next to submission. */
+	atomic64_add(bio->bi_iter.bi_size, &zi->host_wb_bytes);
+	atomic64_inc(&zi->bio_count);
+
+	/* Both callbacks share the flush batch completion. */
+	atomic_inc(&io->pending);
+	bio->bi_private = io;
+	bio->bi_end_io = zest_wbuf_bio_endio;
+	/*
+	 * swap_latency_call_prepare() is a no-op when tracing is disabled.  Use
+	 * the first staged slot only as a representative swap entry for this
+	 * flush-bio record; no folio matching is attempted by the raw API.
+	 */
+	swap_latency_call_prepare(&latency, SWAP_LATENCY_RECORD_SWAPOUT, 0);
+	if (latency.call_begin_ns) {
+		swp_entry_t entry = swp_entry(zi->sis->type,
+				slot == ZEST_INVALID_SLOT ? 0 : slot);
+
+		swap_latency_call_start(&latency, entry, zi->sis, 0);
+	}
+	if (latency.record) {
+		/* Keep this worker record separate from the root swap_writepage() record. */
+		swap_latency_call_mark(&latency,
+			SWAP_LATENCY_F_ZEST_FLUSH,
+			SWAP_LATENCY_BACKEND_BLOCK_DEVICE);
+		swap_latency_swapout_helper_enter(&latency,
+			SWAP_LATENCY_SWAPOUT_HELPER_BDEV_ASYNC);
+		/*
+		 * A failed optional allocation must not affect the real flush.  The
+		 * flush record is closed as untracked below; no async token is created
+		 * in that case.
+		 */
+		ctx = kzalloc(sizeof(*ctx), GFP_NOIO);
+		if (ctx) {
+			latency_io = swap_latency_io_begin_raw(&latency, zi->sis,
+				true, false, false, bio->bi_iter.bi_sector,
+				bio->bi_iter.bi_size);
+			if (latency_io) {
+				ctx->flush = io;
+				ctx->latency_io = latency_io;
+				bio->bi_private = ctx;
+				bio->bi_end_io = zest_wbuf_bio_endio_traced;
+			} else {
+				kfree(ctx);
+				ctx = NULL;
+			}
+		}
+		if (!latency_io)
+			swap_latency_call_mark(&latency,
+				SWAP_LATENCY_F_UNTRACKED_IO,
+				SWAP_LATENCY_BACKEND_UNKNOWN);
+	}
+
+	submit_bio(bio);
+	if (latency_io)
+		swap_latency_submit_end(latency_io);
+	/* The call reference is independent of the bio token reference. */
+	swap_latency_call_end(&latency, 0);
+}
+
+//zest-wbuf: drop the submission bias and wait for every bio in one flush.
+static bool zest_wbuf_wait_io(struct zest_wbuf_io *io)
+{
+	if (atomic_dec_and_test(&io->pending))
+		complete(&io->done);
+	wait_for_completion_io(&io->done);
+
+	return READ_ONCE(io->status) == BLK_STS_OK;
+}
+
+
+//zest-wbuf: free one buffer's backing pages + metadata. Safe on partial/NULL
+//(init error path and release both call it).
+static void zest_wbuf_free_one(struct zest_wbuf *wb)
+{
+	if (wb->pages) {
+		if (wb->contig) {
+			if (wb->base)
+				__free_pages(wb->base, wb->order);
+		} else {
+			unsigned int i;
+
+			for (i = 0; i < wb->cap; i++)
+				if (wb->pages[i])
+					__free_page(wb->pages[i]);
+		}
+		kvfree(wb->pages);
+		wb->pages = NULL;
+	}
+	kvfree(wb->bslot);
+	wb->bslot = NULL;	
+	wb->base = NULL;
+}
+
+//zest-wbuf: allocate one buffer. contig=true: one PHYSICALLY-CONTIGUOUS run of
+//(1<<order) pages (fast path -> bio_add_page coalesces into big segments).
+//contig=false: @want individual pages (fragmented fallback; functional, small
+//segments). Returns 0 / -ENOMEM; on failure leave it freeable via free_one.
+static int zest_wbuf_alloc_one(struct zest_wbuf *wb, bool contig,
+			       unsigned int order, unsigned int want)
+{
+	unsigned int cap = contig ? (1u << order) : want;
+	unsigned int i;
+
+	wb->cap = cap;
+	//kvcalloc (NULL-init): on a partial fragmented alloc, free_one must see
+	//NULL for not-yet-allocated entries rather than garbage.
+	wb->pages = kvcalloc(cap, sizeof(*wb->pages), GFP_KERNEL);
+	if (!wb->pages)
+		return -ENOMEM;
+	wb->bslot = kvmalloc_array(cap, sizeof(*wb->bslot), GFP_KERNEL);
+	if (!wb->bslot)
+		return -ENOMEM;
+	memset(wb->bslot, 0xff, (size_t)cap * sizeof(*wb->bslot));
+
+	if (contig) {
+		//__GFP_NORETRY|__GFP_NOWARN: fail fast so the caller can try a
+		//smaller order instead of stalling in compaction/OOM.
+		wb->base = alloc_pages(GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN,
+				       order);
+		if (!wb->base)
+			return -ENOMEM;
+		wb->order  = order;
+		wb->contig = true;
+		for (i = 0; i < cap; i++)
+			wb->pages[i] = wb->base + i;
+	} else {
+		wb->base   = NULL;
+		wb->order  = 0;
+		wb->contig = false;
+		for (i = 0; i < cap; i++) {
+			wb->pages[i] = alloc_page(GFP_KERNEL);
+			if (!wb->pages[i])
+				return -ENOMEM;
+		}
+	}
+	wb->cap = cap;
+	return 0;
+}
+
+//zest-wbuf: Allocate the whole write buffer ring. Try ZEST_WBUF_COUNT 
+//runs to find physically contiguous memory space at the requested 4 MiB
+//order. A fragmented fallback still allocates the exact same byte capacity.
+//All buffers share one capacity and it is always a divisor of (or <=) the zone size.
+static int zest_wbuf_pool_alloc(struct zest_info *zi)
+{
+	unsigned int target = ZEST_WBUF_BYTES >> PAGE_SHIFT;
+	int min_order = get_order(ZEST_WBUF_BYTES);
+	int order, i;
+
+	for (order = get_order(ZEST_WBUF_BYTES); order >= min_order; order--) {
+		bool ok = true;
+
+		for (i = 0; i < (int)ZEST_WBUF_COUNT; i++) {
+			if (zest_wbuf_alloc_one(&zi->wbufs[i], true,
+						(unsigned int)order, 0)) {
+				ok = false;
+				break;
+			}
+		}
+		if (ok) {
+			zi->wbuf_cap = 1u << order;
+			pr_notice("zest-wbuf: %u contiguous buffers x %u pages (%u KiB each)\n",
+				  ZEST_WBUF_COUNT, zi->wbuf_cap,
+				  (zi->wbuf_cap << PAGE_SHIFT) >> 10);
+			return 0;
+		}
+		for (i = 0; i < (int)ZEST_WBUF_COUNT; i++)
+			zest_wbuf_free_one(&zi->wbufs[i]);
+		pr_warn("zest-wbuf: contiguous alloc failed at order %d (%u KiB); trying smaller\n",
+			order, (unsigned int)(((1u << order) << PAGE_SHIFT) >> 10));
+	}
+
+	pr_warn("zest-wbuf: contiguous 4 MiB allocation failed; using FRAGMENTED buffers (small segments -> reduced write bandwidth)\n");
+	for (i = 0; i < (int)ZEST_WBUF_COUNT; i++) {
+		if (zest_wbuf_alloc_one(&zi->wbufs[i], false, 0, target)) {
+			for (; i >= 0; i--)
+				zest_wbuf_free_one(&zi->wbufs[i]);
+			return -ENOMEM;
+		}
+	}
+	zi->wbuf_cap = target;
+	pr_warn("zest-wbuf: fragmented fallback ok: %u buffers x %u pages\n",
+		ZEST_WBUF_COUNT, zi->wbuf_cap);
+	return 0;
+}
+
+static void zest_wbuf_pool_free(struct zest_info *zi)
+{
+	unsigned int i;
+
+	for (i = 0; i < ZEST_WBUF_COUNT; i++)
+		zest_wbuf_free_one(&zi->wbufs[i]);
+}
+
+//zest-wbuf: seal the FILLING buffer @wb (caller holds zi->buf_lock): snapshot
+//its fill, flip to FLUSHING, and queue it on the FIFO kthread list. No-op if
+//not FILLING.
+static void zest_wbuf_seal_locked(struct zest_info *zi, struct zest_wbuf *wb)
+{
+	if (wb->state != ZEST_WBUF_FILLING)
+		return;
+	wb->sealed_fill = wb->fill;
+	if (wb->sealed_fill) {
+		wb->state = ZEST_WBUF_FLUSHING;
+		list_add_tail(&wb->flush_node, &zi->wbuf_flush_list);
+		atomic_inc(&zi->wbuf_pending);
+		wake_up(&zi->wbuf_wait);
+	} else {
+		//Empty: straight to FREE.
+		wb->state = ZEST_WBUF_FREE;
+		wake_up_all(&zi->wbuf_free_wait);
+	}
+}
+
+//zest-wbuf: return index of a FREE buffer, or -1 if there is no free ones. 
+// Caller holds zi->buf_lock.
+static int zest_wbuf_pick_free_locked(struct zest_info *zi)
+{
+	unsigned int i;
+
+	for (i = 0; i < ZEST_WBUF_COUNT; i++)
+		if (zi->wbufs[i].state == ZEST_WBUF_FREE)
+			return (int)i;
+	return -1;
+}
+
+//zest-wbuf: lockless wait-condition for writers blocked on a free buffer. The
+//authoritative re-check happens under buf_lock in the claim loop.
+static bool zest_wbuf_any_free(struct zest_info *zi)
+{
+	unsigned int i;
+
+	for (i = 0; i < ZEST_WBUF_COUNT; i++)
+		if (READ_ONCE(zi->wbufs[i].state) == ZEST_WBUF_FREE)
+			return true;
+	return false;
+}
+
+
+//zest-wbuf: pop a fresh zone for the flush write frontier.
+static struct zest_zone *zest_wbuf_pop_zone(struct zest_info *zi)
+{
+	struct zest_zone *z;
+	unsigned int waits = 0;
+
+	for (;;) {
+		if (unlikely(atomic_read(&zi->fatal)))
+			return NULL;
+
+		spin_lock(&zi->freelist_lock);
+		if (atomic_read(&zi->nr_free_zones) > ZEST_GC_RESERVE) {
+			z = list_first_entry(&zi->freelist, struct zest_zone,
+					     free_node);
+			list_del_init(&z->free_node);
+			atomic_dec(&zi->nr_free_zones);
+			spin_unlock(&zi->freelist_lock);
+			return z;
+		}
+		spin_unlock(&zi->freelist_lock);
+
+		//No room: kick GC and wait (re-kicking every 200ms so a genuinely
+		//full device self-resolves once mm pressure frees swap slots and GC
+			//can reclaim a zone). The CPU7-bound wbuf kthread is single-threaded, so a
+		//stall here naturally backpressures: buffers stay FLUSHING, writers
+		//find no FREE buffer and reject -> mm reclaims/kills -> slots free.
+		zest_gc_kick(zi);
+		pr_warn_ratelimited("zest-wbuf: flush waiting for a free zone (free=%d, gc=%s)\n",
+				    atomic_read(&zi->nr_free_zones),
+				    zi->gc_thread ? "on" : "off");
+		wait_event_timeout(zi->gc_done_wait,
+			atomic_read(&zi->nr_free_zones) > ZEST_GC_RESERVE ||
+			atomic_read(&zi->fatal), HZ / 5);
+		if (++waits >= ZEST_GC_WAIT_MAX)
+			return NULL;
+	}
+}
+
+//zest-wbuf: refresh the software frontier after a failed write.  Going
+//through blkdev_report_zones() is deliberate: when zone write plugging is
+//active it also clears BLK_ZONE_WPLUG_NEED_WP_UPDATE from the device report.
+static int zest_wbuf_refresh_zone_wp(struct zest_info *zi,
+				     struct zest_zone *z)
+{
+	struct blk_zone hw = {};
+	sector_t zone_len = (sector_t)z->zone_len_blocks << (PAGE_SHIFT - 9);
+	sector_t capacity_len = (sector_t)z->nr_blocks << (PAGE_SHIFT - 9);
+	sector_t block_sectors = 1ULL << (PAGE_SHIFT - 9);
+	sector_t wp_offset;
+	unsigned int noio_flag;
+	int ret;
+
+	noio_flag = memalloc_noio_save();
+	ret = blkdev_report_zones(zi->bdev, z->start_sector, 1,
+				  zest_report_cb, &hw);
+	memalloc_noio_restore(noio_flag);
+	if (ret != 1) {
+		pr_alert("zest-wbuf: report failed zone=%ld start=%llu ret=%d\n",
+			 z - zi->zones, (unsigned long long)z->start_sector, ret);
+		return ret < 0 ? ret : -EIO;
+	}
+	if (hw.start != z->start_sector || hw.len != zone_len ||
+	    (hw.capacity && hw.capacity != capacity_len) ||
+	    hw.wp < hw.start || hw.wp - hw.start > capacity_len) {
+		pr_alert("zest-wbuf: invalid report zone=%ld start=%llu len=%llu wp=%llu\n",
+			 z - zi->zones, (unsigned long long)hw.start,
+			 (unsigned long long)hw.len, (unsigned long long)hw.wp);
+		return -EIO;
+	}
+
+	wp_offset = hw.wp - hw.start;
+	if (wp_offset & (block_sectors - 1)) {
+		pr_alert("zest-wbuf: unaligned WP zone=%ld wp=%llu\n",
+			 z - zi->zones, (unsigned long long)hw.wp);
+		return -EIO;
+	}
+
+	z->wp_blocks = wp_offset >> (PAGE_SHIFT - 9);
+	pr_warn("zest-wbuf: refreshed zone=%ld WP=%u/%u after write error\n",
+		z - zi->zones, z->wp_blocks, z->nr_blocks);
+	return 0;
+}
+
+//zest-wbuf: never reuse a zone that received a failed target write.  A
+//successful finish makes its remaining range invalid space for normal GC;
+//the staged buffer has not entered L2P/rmap and will be rewritten elsewhere.
+static void zest_wbuf_finish_failed_zone(struct zest_info *zi,
+					 struct zest_zone *z)
+{
+	sector_t zone_len = (sector_t)z->zone_len_blocks << (PAGE_SHIFT - 9);
+	int ret;
+
+	ret = zest_wbuf_refresh_zone_wp(zi, z);
+	if (!ret && z->wp_blocks < z->nr_blocks) {
+		ret = blkdev_zone_mgmt(zi->bdev, REQ_OP_ZONE_FINISH,
+					   z->start_sector, zone_len, GFP_NOFS);
+		if (ret) {
+			pr_alert("zest-wbuf: finish failed zone=%ld err=%d\n",
+				 z - zi->zones, ret);
+			/*
+			 * Re-report even when the finish failed: it may clear a wplug
+			 * error state installed by the failed management BIO.
+			 */
+			zest_wbuf_refresh_zone_wp(zi, z);
+		}
+	}
+
+	if (!ret) {
+		z->wp_blocks = z->nr_blocks;
+		return;
+	}
+
+	/*
+	 * Do not allocate from an indeterminate zone.  Marking it FULL makes
+	 * it a GC reset candidate; existing rmap entries remain authoritative.
+	 */
+	pr_alert("zest-wbuf: quarantining zone=%ld after recovery failure\n",
+		 z - zi->zones);
+	z->wp_blocks = z->nr_blocks;
+}
+
+static void zest_wbuf_flush_buffer(struct zest_wbuf *wb)
+{
+	struct zest_info *zi = wb->zi;
+	unsigned int n = wb->sealed_fill;
+	struct {
+		struct zest_zone *z;
+		sector_t	base;	/* device sector of the segment's first page */
+		unsigned int	first;	/* local buffer page index of segment start */
+		unsigned int	cnt;	/* pages in this segment */
+	} seg[2];
+	unsigned int nseg, placed;
+	struct bio *bio = NULL;
+	struct zest_zone *z;
+	unsigned int s, k, retry = 0;
+	unsigned int spins = 0;
+	bool seg_submitted[2] = {};
+	/* Keep ordinary staging BIOs bounded for block-layer fairness. */
+	unsigned int bio_limit = ZEST_WBUF_BIO_BYTES;
+	bool flush_waited;
+	struct zest_wbuf_io flush;
+
+	if (unlikely(!n))
+		goto recycle;
+
+	//(1) Wait for all in-flight memcpys to complete. Do not let this kthread
+	//busy-wait indefinitely ahead of the normal-priority writers doing the copies.
+	while (atomic_read(&wb->copied) < n) {
+		cpu_relax();
+		if (++spins == ZEST_WBUF_COPY_SPINS) {
+			spins = 0;
+			cond_resched();
+		}
+	}
+	smp_rmb();
+
+	if (unlikely(atomic_read(&zi->fatal)))
+		goto recycle;
+
+
+layout:
+	nseg = 0;
+	placed = 0;
+	flush_waited = false;
+	memset(seg_submitted, 0, sizeof(seg_submitted));
+	/* Initialise the completion bias before laying out the target zones so
+	 * an allocation/frontier failure can take the common write_error path
+	 * even when no BIO has been submitted yet. */
+	atomic_set(&flush.pending, 1);
+	flush.status = BLK_STS_OK;
+	init_completion(&flush.done);
+
+	//(2) layout. zi->cur_zone is advanced here; the single-threaded wbuf kthread
+	//is the sole host zone-allocator, so no lock guards cur_zone /
+	//wp_blocks beyond freelist_lock on the pop.
+	z = &zi->zones[zi->cur_zone];
+	if (z->wp_blocks >= z->nr_blocks) {
+		z = zest_wbuf_pop_zone(zi);
+		if (!z)
+			goto write_error;
+		zi->cur_zone = z - zi->zones;
+	}
+	{
+		unsigned int room = z->nr_blocks - z->wp_blocks;
+		unsigned int c0 = min(n, room);
+		seg[nseg].z = z;
+		seg[nseg].base = z->start_sector +
+					((sector_t)z->wp_blocks << (PAGE_SHIFT - 9));
+		seg[nseg].first = 0;
+		seg[nseg].cnt = c0;
+		z->wp_blocks += c0;
+		nseg++;
+		placed = c0;
+	}
+	
+	if (placed < n) {
+		//First zone filled to its end (FULL, no pad); continue in a
+		//fresh zone. cap <= zone size => exactly one extra segment.
+		unsigned int c1 = n - placed;
+
+		z = zest_wbuf_pop_zone(zi);
+		if (!z)
+			goto write_error;
+		zi->cur_zone = z - zi->zones;
+		seg[nseg].z = z;
+		seg[nseg].base = z->start_sector;	//fresh zone -> wp 0
+		seg[nseg].first = placed;
+		seg[nseg].cnt = c1;
+		z->wp_blocks += c1;
+		nseg++;
+		placed = n;
+	}
+
+	//(3) Submit ordinary contiguous flush bios, then wait for the full flush
+	//batch before publishing L2P/rmap. The single FIFO kthread is the only
+	//wbuf submitter.
+	for (s = 0; s < nseg; s++) {
+		unsigned int bio_first = 0;
+
+		atomic_inc(&seg[s].z->inflight_writes);
+		bio = NULL;
+		for (k = 0; k < seg[s].cnt; k++) {
+			//Device position -> source page. 
+			unsigned int pos = seg[s].first + k;
+			struct page *pg = wb->pages[pos];
+
+			if (bio && !bio_add_page(bio, pg, PAGE_SIZE, 0)) {
+				seg_submitted[s] = true;
+				zest_wbuf_submit_bio(zi, &flush, bio, bio_first, wb);
+				bio = NULL;
+			}
+			if (!bio) {
+				bio = bio_alloc(zi->bdev,
+					min(seg[s].cnt - k,
+					    min((unsigned int)BIO_MAX_VECS,
+						ZEST_WBUF_BIO_PAGES)),
+					REQ_OP_WRITE | REQ_SWAP,
+					GFP_NOIO);
+				if (!bio) {
+					pr_alert("zest-wbuf: bio allocation failed\n");
+					goto write_error;
+				}
+				bio->bi_iter.bi_sector = seg[s].base +
+						((sector_t)k << (PAGE_SHIFT - 9));
+				bio_first = pos;
+				/* __bio_add_page() is the infallible new-segment helper; the
+				 * BIO was allocated with enough vector capacity. */
+				__bio_add_page(bio, pg, PAGE_SIZE, 0);
+			}
+			if (bio->bi_iter.bi_size >= bio_limit) {
+				seg_submitted[s] = true;
+				zest_wbuf_submit_bio(zi, &flush, bio, bio_first, wb);
+				bio = NULL;
+			}
+		}
+		if (bio) {
+			seg_submitted[s] = true;
+			zest_wbuf_submit_bio(zi, &flush, bio, bio_first, wb);
+			bio = NULL;
+		}
+	}
+	flush_waited = true;
+	if (!zest_wbuf_wait_io(&flush))
+		goto write_error;
+
+	//(4) commit. Device writes are durable now; publish l2p BUF->sector for
+	//pages whose slot still points here. inflight_writes held until after this.
+	spin_lock_bh(&zi->map_lock);
+	{
+		for (s = 0; s < nseg; s++) {
+			for (k = 0; k < seg[s].cnt; k++) {
+				unsigned int pos = seg[s].first + k;
+				unsigned int li = pos;
+				u32 slot = wb->bslot[li];
+				sector_t want = zest_l2p_mk_buf(wb->gbase + li);
+				sector_t sec = seg[s].base +
+					       ((sector_t)k << (PAGE_SHIFT - 9));
+
+					if (slot == ZEST_INVALID_SLOT)
+						continue;
+					if (slot >= zi->nr_slots) {
+						zest_fatal_trip(zi, slot, 1);
+						continue;
+					}
+					if (READ_ONCE(zi->l2p[slot]) != want)
+					continue;	//freed / re-staged in-flight -> dead
+				seg[s].z->rmap[zest_blk_in_zone(seg[s].z, sec)] = slot;
+				atomic_inc(&seg[s].z->valid_blocks);
+				WRITE_ONCE(zi->l2p[slot], sec);
+			}
+		}
+	}
+	spin_unlock_bh(&zi->map_lock);
+	for (s = 0; s < nseg; s++)
+		atomic_dec(&seg[s].z->inflight_writes);
+
+	atomic64_inc(&zi->flush_count);
+	atomic64_add(n, &zi->flush_pages);
+
+	pr_debug("zest-wbuf: flushed %u pages in %u seg(s) cur_zone=%u\n",
+		 n, nseg, zi->cur_zone);
+	goto recycle;
+
+write_error:
+	/*
+	 * Do not report, finish, or recycle a zone while one of its writes is still
+	 * in flight. None of this buffer's mappings was committed, so retire the
+	 * submitted zones before retrying the full staging buffer at a new frontier.
+	 */
+	if (!flush_waited) {
+		zest_wbuf_wait_io(&flush);
+		flush_waited = true;
+	}
+	for (s = 0; s < nseg; s++) {
+		if (seg_submitted[s]) {
+			zest_wbuf_finish_failed_zone(zi, seg[s].z);
+			atomic_dec(&seg[s].z->inflight_writes);
+		} else {
+			/* The software reservation was never submitted.  Return it to
+			 * the zone frontier; quarantining an untouched zone would waste
+			 * capacity and make a transient bio allocation failure permanent. */
+			if (WARN_ON_ONCE(seg[s].z->wp_blocks < seg[s].cnt))
+				seg[s].z->wp_blocks = 0;
+			else
+				seg[s].z->wp_blocks -= seg[s].cnt;
+		}
+	}
+
+	if (retry++ < ZEST_WBUF_FLUSH_RETRY_MAX) {
+		pr_warn("zest-wbuf: retrying %u staged pages on a fresh zone\n", n);
+		goto layout;
+	}
+
+	pr_emerg("zest-wbuf: retry failed; retaining %u staged pages in RAM\n",
+		 n);
+
+	/*
+	 * Keep state == FLUSHING and the BUF mappings intact.  Readers continue
+	 * to copy from wb->pages while writers receive normal ring backpressure.
+	 */
+	zest_gc_kick(zi);
+	return;
+
+recycle:
+	//(5) recycle and wake any writer blocked on a free buffer.
+	spin_lock(&zi->buf_lock);
+	wb->fill = 0;
+	wb->sealed_fill = 0;
+	atomic_set(&wb->copied, 0);
+	wb->state = ZEST_WBUF_FREE;
+	spin_unlock(&zi->buf_lock);
+	wake_up_all(&zi->wbuf_free_wait);
+
+	//A flush just consumed free zone(s); nudge GC to refill the freelist.
+	zest_gc_kick(zi);
+}
+
+//zest-wbuf: the sole FIFO executor for sealed write buffers. A pending count
+//covers both list-resident and active buffers so swapoff can drain the thread.
+static int zest_wbuf_threadfn(void *data)
+{
+	struct zest_info *zi = data;
+
+	while (!kthread_should_stop()) {
+		struct zest_wbuf *wb = NULL;
+
+		wait_event_interruptible(zi->wbuf_wait,
+			kthread_should_stop() || atomic_read(&zi->wbuf_pending));
+		if (kthread_should_stop())
+			break;
+
+		spin_lock(&zi->buf_lock);
+		if (!list_empty(&zi->wbuf_flush_list)) {
+			wb = list_first_entry(&zi->wbuf_flush_list,
+					      struct zest_wbuf, flush_node);
+			list_del_init(&wb->flush_node);
+		}
+		spin_unlock(&zi->buf_lock);
+
+		if (!wb)
+			continue;
+
+		zest_wbuf_flush_buffer(wb);
+		if (atomic_dec_and_test(&zi->wbuf_pending))
+			wake_up_all(&zi->wbuf_drain_wait);
+		cond_resched();
+	}
+
+	return 0;
+}
+
+static int zest_wbuf_thread_start(struct zest_info *zi)
+{
+	struct task_struct *t;
+
+	t = kthread_create(zest_wbuf_threadfn, zi, "zest-wbuf/%pg", zi->bdev);
+	if (IS_ERR(t))
+		return PTR_ERR(t);
+	if (!cpu_possible(7)) {
+		kthread_stop(t);
+		return -ENODEV;
+	}
+	kthread_bind(t, 7);
+	wake_up_process(t);
+	zi->wbuf_thread = t;
+	return 0;
+}
+
+static void zest_wbuf_thread_stop(struct zest_info *zi)
+{
+	if (!zi->wbuf_thread)
+		return;
+
+	wait_event(zi->wbuf_drain_wait, !atomic_read(&zi->wbuf_pending));
+	kthread_stop(zi->wbuf_thread);
+	zi->wbuf_thread = NULL;
+}
+
+
+//zest-gc: free the preallocated GC migration buffer.
+static void zest_gc_buf_free(struct zest_info *zi)
+{
+	unsigned int e;
+
+	if (!zi->gc_buf)
+		return;
+	//zest-gc: free the page backing store as a unit on the contiguous path,
+	//page-by-page on the fragmented fallback.
+	if (zi->gc_buf_contig) {
+		if (zi->gc_buf_base)
+			__free_pages(zi->gc_buf_base, zi->gc_buf_order);
+		zi->gc_buf_base = NULL;
+		zi->gc_buf_contig = false;
+	} else {
+		for (e = 0; e < zi->gc_buf_nr; e++)
+			if (zi->gc_buf[e].page)
+				__free_page(zi->gc_buf[e].page);
+	}
+	kvfree(zi->gc_buf);
+	zi->gc_buf = NULL;
+	zi->gc_buf_nr = 0;
+}
+
+/* -------------------------------------------------------------- */
+/* zest3: init-time helpers                                       */
+/* -------------------------------------------------------------- */
+
+//zest-init: discover every physical zone the swapfile occupies.
+//
+//Each swap_extent.start_block is in PAGE-sized blocks. Convert to
+//bdev 512B sectors via << (PAGE_SHIFT - 9). An extent may span multiple
+//zones; round down to a zone boundary and step by zone_sectors.
+//Duplicates (two extents in the same zone) are collapsed by sort+dedup.
+//zest3: shared state for building zi->zones[] from both the swap extents and
+//the OP-region walk.
+struct zest_zone_build {
+	struct zest_info	*zi;
+	struct zest_zone	*tmp;
+	unsigned int		cap;
+	unsigned int		n;
+	sector_t		zone_sectors;
+	unsigned int		blocks_per_zone;
+};
+
+//zest-init: sort comparator on start_sector ascending.
+static int zest_zone_cmp(const void *a, const void *b)
+{
+	const struct zest_zone *za = a, *zb = b;
+
+	if (za->start_sector < zb->start_sector)
+		return -1;
+	if (za->start_sector > zb->start_sector)
+		return 1;
+	return 0;
+}
+
+//zest-init: append every zone touched by [local_blk, local_blk+nr_pages) (device-
+//local F2FS blocks) into the build array. Rounds down to the zone boundary and
+//steps by zone_sectors; sort+dedup later collapses duplicates.
+static int zest_add_extent_zones(struct zest_zone_build *b,
+				  unsigned int local_blk, unsigned int nr_pages)
+{
+	sector_t s = (sector_t)local_blk << (PAGE_SHIFT - 9);
+	sector_t e = s + ((sector_t)nr_pages << (PAGE_SHIFT - 9));
+	sector_t z = (s / b->zone_sectors) * b->zone_sectors;
+
+	for (; z < e; z += b->zone_sectors) {
+		if (b->n >= b->cap) {
+			pr_alert("zest: zone array overflow (cap=%u)\n",
+				  b->cap);
+			return -ENOSPC;
+		}
+		b->tmp[b->n].start_sector = z;
+		b->tmp[b->n].nr_blocks    = b->blocks_per_zone;
+		b->tmp[b->n].zone_len_blocks = b->blocks_per_zone;
+		b->tmp[b->n].wp_blocks    = 0;
+		atomic_set(&b->tmp[b->n].valid_blocks, 0);
+		b->n++;
+	}
+	return 0;
+}
+
+//zest-init: f2fs_zest_walk_op_extents() callback. pblk is a global F2FS block
+//address; convert to device-local then add its zones.
+static int zest_op_extent_cb(unsigned int pblk, unsigned int len, void *data)
+{
+	struct zest_zone_build *b = data;
+	unsigned int local_blk =
+		f2fs_zest_blkaddr_to_dev_local(b->zi->sbi, pblk);
+
+	if (local_blk == (unsigned int)-1) {
+		pr_alert("zest: OP pblk %u not on zoned dev\n", pblk);
+		return -EIO;
+	}
+	return zest_add_extent_zones(b, local_blk, len);
+}
+
+//zest-init: setup zone resources
+static int zest_discover_zones(struct zest_info *zi)
+{
+	struct swap_info_struct *sis = zi->sis;
+	struct f2fs_sb_info *sbi = zi->sbi;
+	struct inode *inode = sis->swap_file->f_mapping->host;
+	sector_t zone_sectors = bdev_zone_sectors(zi->bdev);
+	struct zest_zone_build b;
+	unsigned int ext_cnt = 0, i, w;
+	struct rb_node *rb;
+	int ret;
+
+	if (!zone_sectors) {
+		pr_alert("zest: bdev_zone_sectors=0 (not zoned?)\n");
+		return -EINVAL;
+	}
+
+	b.zi = zi;
+	b.zone_sectors = zone_sectors;
+	b.blocks_per_zone = zone_sectors >> (PAGE_SHIFT - 9);
+	if (!b.blocks_per_zone) {
+		pr_alert("zest: zone size is smaller than one PAGE-sized block\n");
+		return -EINVAL;
+	}
+	b.n = 0;
+
+	//cap: worst-case distinct zones across swap + OP regions, plus one
+	//boundary zone per swap extent, plus slack. Tiny in practice
+	//(GiB-sized zones), so be generous and safe.
+	for (rb = rb_first(&sis->swap_extent_root); rb; rb = rb_next(rb))
+		ext_cnt++;
+	b.cap = (sis->max + zi->op_nr_blocks) / b.blocks_per_zone
+		+ ext_cnt + 16;
+
+	b.tmp = kvmalloc_array(b.cap, sizeof(*b.tmp), GFP_KERNEL);
+	if (!b.tmp)
+		return -ENOMEM;
+
+	pr_notice("zest: discovering zone_sectors=%llu blocks_per_zone=%u swap_max=%u op_blocks=%u cap=%u\n",
+		  (unsigned long long)zone_sectors, b.blocks_per_zone,
+		  (unsigned int)sis->max, zi->op_nr_blocks, b.cap);
+
+	//swap-visible zones, from the swap extent rbtree.
+	for (rb = rb_first(&sis->swap_extent_root); rb; rb = rb_next(rb)) {
+		struct swap_extent *se =
+			rb_entry(rb, struct swap_extent, rb_node);
+		unsigned int local_blk =
+			f2fs_zest_blkaddr_to_dev_local(sbi, se->start_block);
+
+		if (local_blk == (unsigned int)-1) {
+			kvfree(b.tmp);
+			pr_alert("zest: block %llu not on zoned dev\n",
+				  (unsigned long long)se->start_block);
+			return -EIO;
+		}
+		ret = zest_add_extent_zones(&b, local_blk, se->nr_pages);
+		if (ret) {
+			kvfree(b.tmp);
+			return ret;
+		}
+	}
+	pr_notice("zest: swap-region added %u zone entries (pre-dedup)\n", b.n);
+
+	//OP zones, from the reserved tail of the swapfile inode.
+	if (zi->op_nr_blocks) {
+		unsigned int before = b.n;
+
+		ret = f2fs_zest_walk_op_extents(inode, zi->op_start_lblk,
+						zi->op_start_lblk +
+						zi->op_nr_blocks,
+						zest_op_extent_cb, &b);
+		if (ret) {
+			kvfree(b.tmp);
+			pr_alert("zest: OP extent walk failed: %d\n", ret);
+			return ret;
+		}
+		pr_notice("zest: OP-region added %u zone entries (pre-dedup)\n",
+			  b.n - before);
+	}
+
+	sort(b.tmp, b.n, sizeof(*b.tmp), zest_zone_cmp, NULL);
+
+	w = 0;
+	for (i = 0; i < b.n; i++) {
+		if (w == 0 ||
+		    b.tmp[w - 1].start_sector != b.tmp[i].start_sector)
+			b.tmp[w++] = b.tmp[i];
+	}
+	if (!w) {
+		kvfree(b.tmp);
+		pr_alert("zest: no physical zones cover the swapfile\n");
+		return -EINVAL;
+	}
+
+	zi->zones    = b.tmp;
+	zi->nr_zones = w;
+	zi->zone_cap = b.cap;
+	pr_notice("zest: %u zones discovered (deduped from %u), %u blocks/zone\n",
+		  w, b.n, b.blocks_per_zone);
+	return 0;
+}
+
+//zest-init: Capture the mkswap header (slot 0) into a kmalloc'd page, so we can reset 
+//every zone safely, including the one that physically holds the header block.
+static int zest_capture_mkswap_header(struct zest_info *zi)
+{
+	struct file *file = zi->sis->swap_file;
+	struct address_space *mapping;
+	struct page *page;
+	void *kaddr, *buf;
+
+	if (!file) {
+		pr_alert("zest: capture_mkswap: sis->swap_file is NULL\n");
+		return -EINVAL;
+	}
+	mapping = file->f_mapping;
+
+	buf = kmalloc(PAGE_SIZE, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	page = read_mapping_page(mapping, 0, file);
+	if (IS_ERR(page)) {
+		int err = PTR_ERR(page);
+
+		kfree(buf);
+		pr_alert("zest: read_mapping_page slot 0 failed: %d\n", err);
+		return err;
+	}
+
+	kaddr = kmap_local_page(page);
+	memcpy(buf, kaddr, PAGE_SIZE);
+	kunmap_local(kaddr);
+	put_page(page);
+
+	zi->mkswap_header = buf;
+	pr_notice("zest: mkswap header captured from page-cache (no flash read)\n");
+	return 0;
+}
+
+//zest-init: blkdev_report_zones callback. Copy the reported blk_zone into 
+//caller-supplied storage. Returns 0 so the report walk completes.
+static int zest_report_cb(struct blk_zone *zone, unsigned int idx,
+			    void *data)
+{
+	struct blk_zone *dst = data;
+
+	*dst = *zone;
+	return 0;
+}
+
+//zest-init: Walk zi->zones[] and reset every zone that isn't already EMPTY.
+static int zest_reset_nonempty_zones(struct zest_info *zi)
+{
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < zi->nr_zones; i++) {
+		struct zest_zone *z = &zi->zones[i];
+		struct blk_zone hw = {};
+		sector_t capacity;
+		unsigned int capacity_blocks, zone_len_blocks;
+
+		ret = blkdev_report_zones(zi->bdev, z->start_sector, 1,
+					  zest_report_cb, &hw);
+		if (ret < 0) {
+			pr_alert("zest: report zone %u failed: %d\n", i,
+				  ret);
+			return ret;
+		}
+		if (ret == 0 || hw.start != z->start_sector) {
+			pr_alert("zest: report zone %u start mismatch (got=%llu expect=%llu)\n",
+				  i, (unsigned long long)hw.start,
+				  (unsigned long long)z->start_sector);
+			return -EIO;
+		}
+		if (!hw.len || hw.len & ((1ULL << (PAGE_SHIFT - 9)) - 1)) {
+			pr_alert("zest: zone %u has unaligned/empty length=%llu\n", i,
+				 (unsigned long long)hw.len);
+			return -EINVAL;
+		}
+		zone_len_blocks = hw.len >> (PAGE_SHIFT - 9);
+		capacity = hw.capacity ? hw.capacity : hw.len;
+		if (capacity > hw.len ||
+		    capacity & ((1ULL << (PAGE_SHIFT - 9)) - 1) ||
+		    capacity >> (PAGE_SHIFT - 9) > UINT_MAX) {
+			pr_alert("zest: zone %u has invalid capacity=%llu len=%llu\n", i,
+				 (unsigned long long)capacity,
+				 (unsigned long long)hw.len);
+			return -EINVAL;
+		}
+		capacity_blocks = capacity >> (PAGE_SHIFT - 9);
+		if (!capacity_blocks) {
+			pr_alert("zest: zone %u has zero usable capacity\n", i);
+			return -EOPNOTSUPP;
+		}
+		z->zone_len_blocks = zone_len_blocks;
+		z->nr_blocks = capacity_blocks;
+
+		if (hw.cond == BLK_ZONE_COND_EMPTY) {
+			pr_notice("zest: zone %u zid %llu already EMPTY, skip reset (start=%llu, len=%llu)\n",
+				  i, (unsigned long long)z->start_sector/2162688, (unsigned long long)z->start_sector, (unsigned long long)z->nr_blocks << (PAGE_SHIFT - 9));
+			continue;
+		}
+
+		//zest-wbuf: reset zone 0 too (previously special-cased to keep the
+		//mkswap header's on-device write pointer). The header is already
+		//captured to zi->mkswap_header (slot-0 reads come from RAM) AND
+		//sys_swapon validated it from the file before this hook ran, so the
+		//on-device copy is no longer needed this session. Resetting it makes
+		//EVERY zone start at wp=0, so a full-buffer flush is zone-aligned and
+		//the <=2-bio split only ever triggers at a true zone tail. (Re-swapon
+		//re-runs mkswap, so wiping the signature here is fine.)
+		ret = blkdev_zone_mgmt(zi->bdev, REQ_OP_ZONE_RESET, z->start_sector,
+					hw.len, GFP_NOFS);
+		if (ret) {
+			pr_alert("zest: zone %u reset failed: %d\n", i,
+				  ret);
+			return ret;
+		}
+		pr_notice("zest: zone %u reset zid %llu start=%llu hw.len=%llu zoneelen=%llu cond %u -> EMPTY\n",
+			  i, (unsigned long long)z->start_sector/2162688,(unsigned long long)z->start_sector, (unsigned long long)hw.len, (unsigned long long)z->nr_blocks << (PAGE_SHIFT - 9), hw.cond);
+	}
+	return 0;
+}
+
+/* -------------------------------------------------------------- */
+/* Swap I/O entry points called from mm/page_io.c                 */
+/* (bodies defined after the lifecycle section)                   */
+/* -------------------------------------------------------------- */
+
+void zest_swap_writepage(struct page *page, struct writeback_control *wbc,
+			 struct swap_info_struct *sis);
+void zest_swap_readpage(struct folio *folio, struct swap_info_struct *sis, bool synchronous);
+
+/* -------------------------------------------------------------- */
+/* Lifecycle entry points                                         */
+/* -------------------------------------------------------------- */
+
+/*
+ * zest-init: swapon takeover.
+ *
+ * Preconditions (caller-enforced by f2fs_swap_activate):
+ *   - sbi->zest_enable == 1
+ *   - check_swap_activate() returned successfully, so
+ *     sis->swap_extent_root is populated and sis->max/pages/highest_bit
+ *     have been set to the full (16 GiB) capacity.
+ *   - Every block on the swapfile has been migrated onto zoned sections
+ *     (because we inverted f2fs_valid_pinned_area under zest_enable).
+ *
+ * Steps:
+ *   1. Walk swap_extent rbtree; every extent must resolve to the same
+ *      zoned bdev. Multi-zoned-dev configurations are rejected for now.
+ *   2. Halve the swap subsystem's visible capacity.
+ *      sis->{max,pages,highest_bit} get shrunk. swap_map / cluster_info
+ *      backing memory was sized by mm/swapfile.c off the *local*
+ *      maxpages variable BEFORE this callback, so it's oversized (~16 MB
+ *      wasted for an 8 GiB OP half) but not corrupted. Allocator paths
+ *      never index past sis->highest_bit.
+ *   3. Re-seed percpu cluster_next cursors with random offsets within
+ *      the new [1, highest_bit] range. mm/swapfile.c seeded them off
+ *      the original highest_bit before our callback fired, so some
+ *      cursors may currently sit in the upper (now-invalid) half.
+ *      Scanner would self-correct via wrap, but re-seeding cleans up
+ *      first-scan behavior.
+ *   4. Publish the singleton: __zest_should_intercept(sis) now returns true.
+ *   5. Auto-enable the global static branch so the swap I/O hot path
+ *      in page_io.c is no longer patched out.
+ *
+ * Context: sys_swapon syscall context (sleepable). The inode_lock on
+ * the swap file is held by the caller -- this is a mutex (sleepable)
+ * and does not bar GFP_KERNEL: direct reclaim from a 40-byte slab
+ * allocation will not re-enter this swap inode. mm/swapfile.c's own
+ * swap_map allocation at swapon time uses GFP_KERNEL by the same
+ * reasoning.
+ */
+int zest_init_for_swapfile(struct f2fs_sb_info *sbi,
+			   struct swap_info_struct *sis)
+{
+	struct zest_info *zi;
+	struct rb_node *rb;
+	struct block_device *zbdev = NULL;
+	struct inode *swap_inode;
+	unsigned int swap_blocks;
+	int ret = 0;	//zest3
+
+	//zest: only one zest-enabled swapfile is allowed. Fast-fail here (racy
+	//read is fine); the authoritative claim+recheck is under the mutex at
+	//the publish point below.
+	if (rcu_access_pointer(zest_singleton)) {
+		pr_warn("zest: init: refusing 2nd zest swapfile; one already active (sis=%p)\n",
+			sis);
+		return -EBUSY;
+	}
+
+	/* Step 1: every extent on the same zoned bdev. */
+	for (rb = rb_first(&sis->swap_extent_root); rb; rb = rb_next(rb)) {
+		struct swap_extent *se =
+			rb_entry(rb, struct swap_extent, rb_node);
+		struct block_device *bd =
+			f2fs_zest_lookup_zoned_bdev(sbi, se->start_block);
+
+		if (!bd) {
+			pr_err("zest: init: extent start_block=%llu not on zoned dev\n",
+				(unsigned long long)se->start_block);
+			return -EINVAL;
+		}
+		if (!zbdev) {
+			zbdev = bd;
+		} else if (zbdev != bd) {
+			pr_err("zest: init: extents span multiple zoned devs, not supported\n");
+			return -EOPNOTSUPP;
+		}
+	}
+	if (!zbdev) {
+		pr_err("zest: init: empty swap_extent_root\n");
+		return -EINVAL;
+	}
+	/* Reverse maps and staging metadata store swap slots as u32. */
+	if (sis->max > UINT_MAX) {
+		pr_err("zest: init: swapfile has too many slots for 32-bit rmap (%u)\n",
+			sis->max);
+		return -EOPNOTSUPP;
+	}
+	/* Logical chunks impose no physical queue, zone alignment, or migration
+	 * window constraints; PAGE_SIZE validation is performed by swap setup. */
+	zi = kzalloc(sizeof(*zi), GFP_KERNEL);
+	if (!zi)
+		return -ENOMEM;
+
+	spin_lock_init(&zi->freelist_lock);		//zest3
+	INIT_LIST_HEAD(&zi->freelist);			//zest3
+	//zest-gc: logical-map lock, GC frontier, freelist depth, GC thread.
+	spin_lock_init(&zi->map_lock);
+	zi->gc_cur_zone = ZEST_NO_ZONE;
+	zi->gc_buf = NULL;
+	zi->gc_buf_nr = 0;
+	atomic_set(&zi->nr_free_zones, 0);
+	init_waitqueue_head(&zi->gc_wait);
+	init_waitqueue_head(&zi->gc_done_wait);
+	atomic_set(&zi->gc_kick, 0);
+	atomic_set(&zi->gc_reset_kick, 0);
+	zi->gc_thread = NULL;
+	atomic64_set(&zi->gc_runs, 0);
+	atomic64_set(&zi->gc_moved_blocks, 0);
+	atomic64_set(&zi->gc_zones_reclaimed, 0);
+	atomic64_set(&zi->gc_direct, 0);
+	atomic64_set(&zi->gc_aborts_stale, 0);
+	atomic64_set(&zi->gc_normal, 0);
+	atomic64_set(&zi->gc_fixed, 0);
+	atomic64_set(&zi->gc_boost, 0);
+	atomic64_set(&zi->gc_emergency, 0);
+	atomic64_set(&zi->gc_success, 0);
+	atomic64_set(&zi->gc_no_victim, 0);
+	atomic64_set(&zi->gc_enospc, 0);
+	atomic64_set(&zi->gc_io_errors, 0);
+	atomic64_set(&zi->gc_backoff, 0);
+	atomic64_set(&zi->gc_config_generation, 0);
+	atomic_set(&zi->gc_last_free_zones, 0);
+	atomic_set(&zi->gc_last_level, ZEST_GC_NORMAL);
+	atomic64_set(&zi->gc_victim_valid_ratio, 0);
+	atomic64_set(&zi->gc_victim_count, 0);
+	zi->sbi  = sbi;
+	zi->sis  = sis;
+	zi->bdev = zbdev;
+
+	//zest-wbuf: write-staging buffer ring plus its dedicated FIFO kthread.
+	//The CPU7-bound thread serializes host flush submission and replaces the
+	//old io_lock on the write path.
+	spin_lock_init(&zi->buf_lock);
+	init_waitqueue_head(&zi->wbuf_free_wait);
+	INIT_LIST_HEAD(&zi->wbuf_flush_list);
+	init_waitqueue_head(&zi->wbuf_wait);
+	init_waitqueue_head(&zi->wbuf_drain_wait);
+	atomic_set(&zi->wbuf_pending, 0);
+	zi->wbuf_thread = NULL;
+	atomic64_set(&zi->flush_count, 0);
+	atomic64_set(&zi->flush_pages, 0);
+	atomic64_set(&zi->bio_count, 0);
+	atomic64_set(&zi->host_wb_bytes, 0);
+	atomic64_set(&zi->gc_wb_bytes, 0);
+	atomic64_set(&zi->read_bio_count, 0);
+	atomic64_set(&zi->read_bio_bytes, 0);
+	ret = zest_wbuf_pool_alloc(zi);
+	if (ret) {
+		pr_alert("zest-wbuf: buffer pool alloc failed: %d\n", ret);
+		goto err;
+	}
+	{
+		unsigned int bi;
+
+		for (bi = 0; bi < ZEST_WBUF_COUNT; bi++) {
+			struct zest_wbuf *wb = &zi->wbufs[bi];
+
+			wb->zi = zi;
+			wb->gbase = bi * zi->wbuf_cap;
+			wb->fill = 0;
+			wb->sealed_fill = 0;
+			atomic_set(&wb->copied, 0);
+			//Buffer 0 is the initial FILLING cur; the rest start FREE.
+			wb->state = (bi == 0) ? ZEST_WBUF_FILLING : ZEST_WBUF_FREE;
+			INIT_LIST_HEAD(&wb->flush_node);
+		}
+		zi->wbuf_cur = 0;
+		pr_notice("zest-wbuf: ring ready: %u buffers, cap=%u pages, gidx<%u\n",
+			  ZEST_WBUF_COUNT, zi->wbuf_cap,
+			  ZEST_WBUF_COUNT * zi->wbuf_cap);
+	}
+
+	atomic64_set(&zi->nr_writes, 0);
+	atomic64_set(&zi->nr_reads, 0);
+	atomic64_set(&zi->nr_write_rejects, 0);		//zest3
+	atomic_set(&zi->fatal, 0);			//zest3.1
+	atomic64_set(&zi->fatal_count, 0);		//zest3.1
+	atomic64_set(&zi->fatal_slot, 0);		//zest3.1
+	atomic_set(&zi->fatal_nr, 0);			//zest3.1
+
+	//zest3: NO sis->max halving anymore. swap sees exactly the swap-visible
+	//capacity (the mkswap'd file size), and over-provisioning comes from a
+	//separate auto-reserved region appended to the swapfile inode (approach
+	//C). This is what fixes the cluster-allocator OOB: the modern per-cluster
+	//allocator hands out slots from free_clusters covering the *full*
+	//maxpages; if we shrank sis->max it would still allocate the hidden upper
+	//half, beyond a halved l2p[] -> heap corruption -> get_swap_pages
+	//hardlockup. With sis->max untouched and l2p sized to it, that is gone by
+	//construction.
+	swap_blocks = sis->max;
+
+	//zest3 Step 2: auto-reserve the OP region by extending the swapfile inode
+	//with extra pinned zoned sections (reuses the fallocate pinning path).
+	//OP size is derived from sbi->zest_op_ratio inside the f2fs glue (which
+	//has the full sbi type; here sbi is opaque). Best-effort: OP=0 is
+	//functional (no GC headroom), so never abort swapon on reserve failure.
+	//Reuse-aware across swapon cycles.
+	swap_inode = sis->swap_file->f_mapping->host;
+	ret = f2fs_zest_reserve_op_section(swap_inode, swap_blocks,
+					   &zi->op_start_lblk, &zi->op_nr_blocks);
+	if (ret)
+		pr_alert("zest: OP reserve returned %d; continuing with op_nr_blocks=%u\n",
+			  ret, zi->op_nr_blocks);
+	ret = 0;	//OP is best-effort; do not fail swapon
+
+	//zest3 Step 3: allocate L→P map sized to the FULL swap-visible capacity.
+	//Typical phone: ~2M slots * 8B = ~16 MiB. kvzalloc falls back to vmalloc
+	//if contiguous memory isn't available.
+	zi->nr_slots = sis->max;
+	zi->l2p = kvmalloc_array(zi->nr_slots, sizeof(*zi->l2p), GFP_KERNEL);
+	if (!zi->l2p) {
+		ret = -ENOMEM;
+		pr_alert("zest: l2p alloc failed nr_slots=%lu\n",
+			  zi->nr_slots);
+		goto err;
+	}
+	memset(zi->l2p, 0xff, zi->nr_slots * sizeof(*zi->l2p));
+	pr_notice("zest: l2p alloc nr_slots=%lu bytes=%lu\n",
+		  zi->nr_slots,
+		  (unsigned long)(zi->nr_slots * sizeof(*zi->l2p)));
+	
+	zi->read_batch_pool =
+	mempool_create_kmalloc_pool(ZEST_READ_POOL_SIZE,
+				   sizeof(struct zest_read_batch));
+	if (!zi->read_batch_pool)
+	{
+		ret = -ENOMEM;
+		pr_alert("zest: read I/O batch pool alloc failed size=%u\n",
+			  ZEST_READ_POOL_SIZE);
+		goto err;
+	}
+
+	ret = bioset_init(&zi->read_bioset,
+			ZEST_READ_POOL_SIZE,
+			offsetof(struct zest_read_batch_io, bio),
+			BIOSET_NEED_BVECS);
+	if (ret)
+	{
+		pr_alert("zest: read bioset alloc failed size=%u\n",
+			  ZEST_READ_POOL_SIZE);
+		goto err;
+	}
+	zi->read_bioset_ready = true;
+	
+	//zest: enumerate zones (swap-visible region + OP region).
+	ret = zest_discover_zones(zi);
+	if (ret)
+		goto err;
+
+	//zest3 Step 3c: snapshot mkswap header from F2FS page cache.
+	ret = zest_capture_mkswap_header(zi);
+	if (ret)
+		goto err;
+
+	//zest3 Step 3c.1: flush + invalidate swapfile page cache before
+	//resetting zones. mkswap may have left dirty pages (especially
+	//the header at page 0). Without this, F2FS writeback would write
+	//them back AFTER zone reset, creating an unexpected IMP_OPEN zone.
+	{
+		struct address_space *mapping = zi->sis->swap_file->f_mapping;
+
+		filemap_write_and_wait(mapping);
+		invalidate_mapping_pages(mapping, 0, -1);
+	}
+
+	//zest3 Step 3d: reset any zone that isn't already EMPTY. After
+	//this, every zone in zi->zones[] starts at wp=0 device-side and
+	//ZEST owns the write pointer.
+	ret = zest_reset_nonempty_zones(zi);
+	if (ret)
+		goto err;
+
+	//zest-gc Step 3d.1: allocate a per-zone reverse map (rmap), sized to
+	//the zone capacity in blocks. Index = block offset within the zone,
+	//value = swap slot, ZEST_INVALID_SLOT == free. Maintained in lockstep
+	//with l2p[] under zi->map_lock. Total memory ~= sum(nr_blocks)*4B, on the order
+	//of the l2p map itself.
+	{
+		unsigned int zi_i;
+
+		for (zi_i = 0; zi_i < zi->nr_zones; zi_i++) {
+			struct zest_zone *z = &zi->zones[zi_i];
+
+			z->rmap = kvmalloc_array(z->nr_blocks, sizeof(u32),
+					       GFP_KERNEL);
+			if (!z->rmap) {
+				ret = -ENOMEM;
+				pr_notice("zest-gc: rmap alloc failed zone=%u nr_blocks=%u\n",
+					  zi_i, z->nr_blocks);
+				goto err;
+			}
+			memset(z->rmap, 0xff, (size_t)z->nr_blocks * sizeof(u32));
+			z->is_gc_front = false;
+		}
+	}
+
+	//zest-gc Step 3d.2: preallocate the GC migration buffer (512 KiB worth of
+	//pages) once, up front, so GC never allocates on the reclaim path. Owned
+	//solely by gc_thread. Best-effort: if it fails GC is disabled (gc_thread
+	//never starts) and swap-out falls back to reject under pressure.
+	{
+		unsigned int e;
+		int order = get_order((size_t)ZEST_GC_BUF_PAGES << PAGE_SHIFT);
+		struct page *base;
+
+		zi->gc_buf = kvmalloc_array(ZEST_GC_BUF_PAGES,
+					    sizeof(*zi->gc_buf), GFP_KERNEL);
+		if (zi->gc_buf) {
+			//zest-gc: prefer ONE physically-contiguous run (allocated now,
+			//while memory is unfragmented) so GC writes coalesce into big
+			//bios like the host flush .
+			base = alloc_pages(GFP_KERNEL | __GFP_NORETRY | __GFP_NOWARN,
+					   order);
+			if (base) {
+				zi->gc_buf_base  = base;
+				zi->gc_buf_order = (unsigned int)order;
+				zi->gc_buf_contig = true;
+				for (e = 0; e < ZEST_GC_BUF_PAGES; e++)
+					zi->gc_buf[e].page = base + e;
+				zi->gc_buf_nr = ZEST_GC_BUF_PAGES;
+				pr_notice("zest-gc: contiguous migration buffer %u pages (order %d)\n",
+					  ZEST_GC_BUF_PAGES, order);
+			} else {
+				zi->gc_buf_contig = false;
+				for (e = 0; e < ZEST_GC_BUF_PAGES; e++) {
+					zi->gc_buf[e].page = alloc_page(GFP_KERNEL);
+					if (!zi->gc_buf[e].page)
+						break;
+				}
+				zi->gc_buf_nr = e;	/* usable entries */
+				pr_notice("zest-gc: fragmented migration buffer %u/%u pages (no contiguous run)\n",
+					  e, ZEST_GC_BUF_PAGES);
+			}
+		} else {
+			zi->gc_buf_nr = 0;
+			pr_notice("zest-gc: buffer array alloc failed; GC disabled\n");
+		}
+	}
+
+	//zest3 Step 3e: initialize per-zone fields and populate freelist.
+	//All zones start EMPTY (wp_blocks=0 after reset). Add every zone
+	//to the freelist, then pop the first one as cur_zone.
+	{
+		unsigned int zi_i;
+		unsigned int nr_free = 0;
+
+        //skip zone 0
+		for (zi_i = 0; zi_i < zi->nr_zones; zi_i++) {
+			INIT_LIST_HEAD(&zi->zones[zi_i].free_node);
+			/* Ordinary wbuf flushing may span zone boundaries and does not
+			 * impose a logical 32KiB capacity/alignment requirement. */
+			atomic_set(&zi->zones[zi_i].inflight_reads, 0);
+			atomic_set(&zi->zones[zi_i].inflight_writes, 0);
+			if(zi_i > 0){
+				list_add_tail(&zi->zones[zi_i].free_node,
+				      &zi->freelist);
+				nr_free++;
+			}
+		}
+		zi->cur_zone = 0;
+		atomic_set(&zi->nr_free_zones, nr_free);
+	}
+
+	ret = zest_wbuf_thread_start(zi);
+	if (ret) {
+		pr_alert("zest-wbuf: thread start failed: %d\n", ret);
+		goto err;
+	}
+
+	/* Step 4: claim the singleton slot (only one zest swapfile allowed).
+	 * Recheck under the mutex closes the race with a concurrent swapon that
+	 * passed the fast-fail check above. On loss, fall through to err: which
+	 * frees zi and returns -EBUSY. */
+	mutex_lock(&zest_singleton_mutex);
+	if (rcu_access_pointer(zest_singleton)) {
+		mutex_unlock(&zest_singleton_mutex);
+		pr_warn("zest: refusing 2nd zest swapfile; one already active (sis=%p)\n",
+			sis);
+		ret = -EBUSY;
+		goto err;
+	}
+	atomic_set(&zest_readahead_latched, 1);
+	rcu_assign_pointer(zest_singleton, zi);
+	/* Step 5: ensure global static branch is on (under the same mutex so it
+	 * stays consistent with the singleton state). */
+	if (!static_branch_unlikely(&zest_enabled_key)) {
+		static_branch_enable(&zest_enabled_key);
+		pr_notice("zest: static branch auto-enabled by swapon\n");
+	}
+	mutex_unlock(&zest_singleton_mutex);
+
+	pr_notice("zest: registered sis=%p bdev=%pg\n", sis, zbdev);
+	pr_notice("zest: init complete: nr_slots=%lu nr_zones=%u\n",
+		  zi->nr_slots, zi->nr_zones);
+
+	//zest-gc Step 6: start the GC executor thread, but only if the
+	//migration buffer was allocated -- without it GC cannot relocate, and
+	//swap-out simply falls back to reject under pressure (no block-wait).
+	if (zi->gc_buf_nr && zest_gc_thread_start(zi))
+		pr_notice("zest-gc: GC thread start failed; running without GC\n");
+	zest_report_memory(zi);		//zest-ra: log resident allocation
+
+	return 0;
+
+err:
+	zest_wbuf_thread_stop(zi);
+	if (zi->zones) {
+		unsigned int zi_i;
+
+		for (zi_i = 0; zi_i < zi->nr_zones; zi_i++)
+			kvfree(zi->zones[zi_i].rmap);
+	}
+	zest_gc_buf_free(zi);
+	kfree(zi->mkswap_header);
+	kvfree(zi->zones);
+	kvfree(zi->l2p);
+	if (zi->read_bioset_ready)
+		bioset_exit(&zi->read_bioset);
+	if (zi->read_batch_pool)
+		mempool_destroy(zi->read_batch_pool);
+	zest_wbuf_pool_free(zi);
+	kfree(zi);
+	pr_alert("zest: init aborted: %d\n", ret);
+	return ret;
+}
+
+/*
+ * swapoff release. Unpublish the singleton under the cold-path mutex,
+ * then synchronize_rcu() to wait out any in-flight stats reader before
+ * tearing zi down. Swap I/O is already quiesced here (f2fs_swap_deactivate
+ * runs after try_to_unuse()), so the lockless hot path cannot race the free.
+ */
+void zest_release_for_swapfile(struct f2fs_sb_info *sbi)
+{
+	struct zest_info *zi;
+	unsigned int i;
+
+	mutex_lock(&zest_singleton_mutex);
+	zi = rcu_dereference_protected(zest_singleton,
+				       lockdep_is_held(&zest_singleton_mutex));
+	if (zi && zi->sbi == sbi) {
+		rcu_assign_pointer(zest_singleton, NULL);
+		/* No swapfile intercepted anymore: drop the static branch. */
+		if (static_branch_unlikely(&zest_enabled_key)) {
+			static_branch_disable(&zest_enabled_key);
+			pr_notice("zest: static branch auto-disabled (no swapfile)\n");
+		}
+	} else {
+		zi = NULL;
+	}
+	mutex_unlock(&zest_singleton_mutex);
+
+	if (!zi) {
+		pr_notice("zest: release: no entry matched (sbi=%p)\n", sbi);
+		return;
+	}
+
+	//Wait out any in-flight stats reader  before freeing zi.
+	synchronize_rcu();
+
+	/* Wbuf can wait for GC to replenish a zone, so drain it first. */
+	zest_wbuf_thread_stop(zi);
+	zest_gc_thread_stop(zi);
+
+	pr_notice("zest: release sis=%p bdev=%pg writes=%lld reads=%lld rejects=%lld gc_runs=%lld gc_moved=%lld gc_reclaimed=%lld\n",
+		zi->sis, zi->bdev,
+		(long long)atomic64_read(&zi->nr_writes),
+		(long long)atomic64_read(&zi->nr_reads),
+		(long long)atomic64_read(&zi->nr_write_rejects),
+		(long long)atomic64_read(&zi->gc_runs),
+		(long long)atomic64_read(&zi->gc_moved_blocks),
+		(long long)atomic64_read(&zi->gc_zones_reclaimed));
+
+	for (i = 0; i < zi->nr_zones; i++) {
+		struct zest_zone *z = &zi->zones[i];
+		sector_t len = (sector_t)z->zone_len_blocks
+				<< (PAGE_SHIFT - 9);
+		int rret;
+
+		if (z->wp_blocks == 0)
+			continue;
+		smp_mb();
+		while (atomic_read(&z->inflight_reads) > 0 ||
+		       atomic_read(&z->inflight_writes) > 0)
+			cpu_relax();
+		rret = blkdev_zone_mgmt(zi->bdev, REQ_OP_ZONE_RESET,
+					z->start_sector, len,
+					GFP_NOFS);
+		if (rret)
+			pr_alert("zest: release: zone %u reset failed: %d\n",
+				  i, rret);
+		else
+			pr_notice("zest: release: zone %u reset (was wp=%u)\n",
+				  i, z->wp_blocks);
+	}
+
+	for (i = 0; i < zi->nr_zones; i++)
+		kvfree(zi->zones[i].rmap);
+	zest_gc_buf_free(zi);
+	
+	kfree(zi->mkswap_header);
+	kvfree(zi->zones);
+	kvfree(zi->l2p);
+	if (zi->read_bioset_ready)
+		bioset_exit(&zi->read_bioset);
+	if (zi->read_batch_pool)
+		mempool_destroy(zi->read_batch_pool);
+	zest_wbuf_pool_free(zi);
+	kfree(zi);
+	/* Keep layout writes blocked until every Zest worker, zone context and
+	 * backing allocation has been torn down; only then is swapoff complete. */
+	atomic_set(&zest_readahead_latched, 0);
+}
+
+/* -------------------------------------------------------------- */
+/* Swap I/O implementations                                       */
+/* -------------------------------------------------------------- */
+
+/* Logical chunk mode uses the ordinary per-page wbuf/L2P path below; the
+ * swap-layer descriptor and group orchestration live in mm/swap_state.c. */
+
+/**
+ * ZEST: swap-out path
+ * Called from __swap_writepage (mm/page_io.c).
+ */
+void zest_swap_writepage(struct page *page, struct writeback_control *wbc,
+			 struct swap_info_struct *sis)
+{
+	struct folio *folio = page_folio(page);
+	struct zest_info *zi = zest_current(sis);
+	unsigned int nr_pages, done;
+	unsigned long slot_start;
+
+	if (unlikely(!zi)) {
+		WARN_ONCE(1, "zest: writepage with no zi for sis=%p\n", sis);
+		folio_mark_dirty(folio);
+		folio_clear_reclaim(folio);
+		folio_unlock(folio);
+		return;
+	}
+	nr_pages   = folio_nr_pages(folio);
+	slot_start = swp_offset(folio->swap);
+
+
+	if (unlikely(atomic_read(&zi->fatal) || slot_start >= zi->nr_slots ||
+		     nr_pages > zi->nr_slots - slot_start)) {
+		if (slot_start >= zi->nr_slots ||
+		    nr_pages > zi->nr_slots - slot_start)
+			zest_fatal_trip(zi, slot_start, nr_pages);
+		folio_mark_dirty(folio);
+		folio_clear_reclaim(folio);
+		folio_unlock(folio);
+		return;
+	}
+
+	//Mark the whole folio under writeback up front; we end it once every page is staged (possibly across more than one buffer). Each page's data is in the buffer before we end writeback, so mm may free the page afterwards.
+	folio_start_writeback(folio);
+
+	done = 0;
+	while (done < nr_pages) {
+		struct zest_wbuf *wb;
+		unsigned int g, c, k;
+
+		//--- claim a run of buffer pages (buf_lock) ---
+		spin_lock(&zi->buf_lock);
+		wb = &zi->wbufs[zi->wbuf_cur];
+		//Check if current write buffer is full or was sealed.
+		if (wb->state != ZEST_WBUF_FILLING || wb->fill == wb->cap) {
+			int next;
+
+			//Seal the write buffer if it is not sealed (FILLING) 
+			//and switch to a FREE buffer.
+			if (wb->state == ZEST_WBUF_FILLING)
+				zest_wbuf_seal_locked(zi, wb);
+			next = zest_wbuf_pick_free_locked(zi);
+			if (next < 0) {
+				spin_unlock(&zi->buf_lock);
+				//Pressure valve: no FREE buffer. Wait bounded, else
+				//reject (the remaining pages are not acked).
+				if (!wait_event_timeout(zi->wbuf_free_wait,
+						zest_wbuf_any_free(zi) ||
+						atomic_read(&zi->fatal),
+						HZ / 5))
+					goto reject;
+				if (atomic_read(&zi->fatal))
+					goto reject;
+				continue;
+			}
+			wb = &zi->wbufs[next];
+			wb->state = ZEST_WBUF_FILLING;
+			wb->fill = 0;
+			atomic_set(&wb->copied, 0);
+			zi->wbuf_cur = (unsigned int)next;
+		}
+		g = wb->fill;
+		c = min(nr_pages - done, wb->cap - g);
+		wb->fill += c;
+		for (k = 0; k < c; k++)
+			wb->bslot[g + k] = (u32)(slot_start + done + k);
+		spin_unlock(&zi->buf_lock);
+
+		// Copy folio pages to buffer pages
+		for (k = 0; k < c; k++) {
+			void *dst = page_address(wb->pages[g + k]);
+			void *src = kmap_local_folio(folio,
+				(size_t)(done + k) << PAGE_SHIFT);
+
+			memcpy(dst, src, PAGE_SIZE);
+			kunmap_local(src);
+		}
+
+		// Invalidate the old mapping and set new L2P = BUF.
+	// An old *device* sector is dead now -> invalidate it.
+	// An old *BUF* entry is left alone -> flush's commit skips it via the l2p mismatch.
+		spin_lock_bh(&zi->map_lock);
+		for (k = 0; k < c; k++) {
+			unsigned long slot = slot_start + done + k;
+			sector_t old = zi->l2p[slot];
+
+			if (old != ZEST_INVALID_SECTOR && !zest_l2p_is_buf(old))
+				zest_map_invalidate_sector(zi, old, slot);
+			WRITE_ONCE(zi->l2p[slot],
+				   zest_l2p_mk_buf(wb->gbase + g + k));
+		}
+		spin_unlock_bh(&zi->map_lock);
+
+		// Announce completion: publish the data before bumping copied so
+		// the flush worker (smp_rmb after its wait) sees a fully-written page.
+		smp_wmb();
+		atomic_add(c, &wb->copied);
+		done += c;
+	}
+
+	count_vm_events(PSWPOUT, nr_pages);
+	folio_end_writeback(folio);
+	folio_unlock(folio);
+
+	atomic64_inc(&zi->nr_writes);
+	pr_debug("zest-wbuf: staged slot=%lu nr=%u\n", slot_start, nr_pages);
+	zest_gc_kick(zi);
+	return;
+
+reject:
+	//No buffer space. End the (not-yet-acked) folio writeback and re-dirty so mm retries the WHOLE folio later. Any leading pages already staged keep valid BUF mappings (reads still served from the buffer); the retry simply re-stages them into fresh buffer pages and the stale copies become dead space their flush skips. No data is lost.
+	atomic64_inc(&zi->nr_write_rejects);
+	zest_gc_kick(zi);
+	pr_alert_ratelimited("zest-wbuf: reject slot=%lu nr=%u done=%u (no free buffer)\n",
+			     slot_start, nr_pages, done);
+	folio_end_writeback(folio);
+	folio_mark_dirty(folio);
+	folio_clear_reclaim(folio);
+	folio_unlock(folio);
+}
+
+
+/**
+ * ZEST: swap-in path
+ * Called from swap_readpage (mm/page_io.c).
+ * Folio enters locked. On exit:
+ *   - served data inline (header memcpy or defensive zero), marked uptodate, unlocked;
+ *   - the normal path submits asynchronously and completes in end_io;
+ *   - swapfile_sync uses a separate synchronous implementation.
+ * Inflight reads protocol:
+ *   1. READ_ONCE l2p[slot] → sector
+ *   2. Find zone → atomic_inc(&zone->inflight_reads)
+ *   3. Re-read l2p[slot]: if changed, atomic_dec + retry
+ *   4. Submit bio; its completion path drops inflight_reads
+ *   GC waits for inflight_reads == 0 before resetting a zone.
+ */
+static void __zest_read_single_page_sync(struct folio *folio,
+					 struct swap_info_struct *sis, bool synchronous)
+{
+	struct zest_info *zi = zest_current(sis);
+	unsigned long slot;
+	sector_t sector;
+	struct zest_zone *z;
+	unsigned int z_idx;
+	struct bio *bio;
+	void *kaddr;
+
+	void *latency_io;
+	int ret;
+	if (unlikely(!zi)) {
+		WARN_ONCE(1, "zest: readpage with no zi for sis=%p\n", sis);
+		folio_unlock(folio);
+		return;
+	}
+	slot = swp_offset(folio->swap);
+
+	if (unlikely(atomic_read(&zi->fatal) || slot >= zi->nr_slots)) {
+		if (slot >= zi->nr_slots)
+			zest_fatal_trip(zi, slot, 1);
+		folio_unlock(folio);
+		return;
+	}
+
+	if (slot == 0 && zi->mkswap_header) {
+		kaddr = kmap_local_folio(folio, 0);
+		memcpy(kaddr, zi->mkswap_header, PAGE_SIZE);
+		kunmap_local(kaddr);
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		atomic64_inc(&zi->nr_reads);
+		if (zest_swap_chunk_mode(sis))
+			atomic64_inc(&zi->chunk_read_from_wbuf);
+		pr_debug("zest: read slot=0 from header cache\n");
+		return;
+	}
+
+retry:
+	sector = READ_ONCE(zi->l2p[slot]);
+
+	if (sector == ZEST_INVALID_SECTOR) {
+		pr_warn_ratelimited("zest: read slot=%lu unmapped (unexpected), zeroed\n",
+				    slot);
+		folio_zero_range(folio, 0, folio_size(folio));
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		atomic64_inc(&zi->nr_reads);
+		return;
+	}
+
+	if (zest_l2p_is_buf(sector)) {
+		u32 gidx = zest_l2p_gidx(sector);
+		struct zest_wbuf *wb = &zi->wbufs[gidx / zi->wbuf_cap];
+		struct page *src = wb->pages[gidx % zi->wbuf_cap];
+
+		kaddr = kmap_local_folio(folio, 0);
+		memcpy(kaddr, page_address(src), PAGE_SIZE);
+		kunmap_local(kaddr);
+		smp_rmb();
+		if (READ_ONCE(zi->l2p[slot]) != sector)
+			goto retry;
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		count_vm_events(PSWPIN, folio_nr_pages(folio));
+		atomic64_inc(&zi->nr_reads);
+		if (zest_swap_chunk_mode(sis))
+			atomic64_inc(&zi->chunk_read_from_wbuf);
+		pr_debug("zest-wbuf: read slot=%lu from buffer gidx=%u\n",
+			 slot, gidx);
+		return;
+	}
+
+	z_idx = zest_find_zone_for_sector(zi, sector);
+	z = z_idx < zi->nr_zones ? &zi->zones[z_idx] : NULL;
+	if(z)
+	{
+		atomic_inc(&z->inflight_reads);
+		smp_mb();
+		if (READ_ONCE(zi->l2p[slot]) != sector) {
+			atomic_dec(&z->inflight_reads);
+			goto retry;
+		}
+	}
+	
+	bio = bio_alloc(zi->bdev, 1, REQ_OP_READ | REQ_SWAP, GFP_KERNEL);
+	bio->bi_iter.bi_sector = sector;
+	bio_add_folio_nofail(bio, folio, folio_size(folio), 0);
+
+	/*
+	 * Keep this task valid during swap readpage because the oom killer may
+	 * attempt to access it in the page fault retry time check.
+	 */
+	get_task_struct(current);
+	count_vm_events(PSWPIN, folio_nr_pages(folio));
+	latency_io = swap_latency_io_begin(NULL, folio, sis, false, true, synchronous, bio->bi_iter.bi_sector, bio->bi_iter.bi_size);
+	if (!latency_io) {
+		swap_latency_target_mark(NULL, folio, SWAP_LATENCY_F_UNTRACKED_IO,
+	                SWAP_LATENCY_BACKEND_BLOCK_DEVICE);
+	}
+	zest_account_read_bio(zi, bio);
+	ret = submit_bio_wait(bio);
+	if (ret) {
+		pr_alert("zest: read-error on swap-device (%u:%u:%llu) status %d\n",
+			 MAJOR(bio_dev(bio)), MINOR(bio_dev(bio)),
+			 (unsigned long long)sector, ret);
+	} else {
+		folio_mark_uptodate(folio);
+	}
+	if (z)
+		atomic_dec(&z->inflight_reads);
+	if (latency_io)
+		swap_latency_sync_io_end(latency_io, bio->bi_status);
+	bio_put(bio);
+	folio_unlock(folio);
+
+	atomic64_inc(&zi->nr_reads);
+	if (zest_swap_chunk_mode(sis))
+		atomic64_inc(&zi->chunk_read_from_device);
+	put_task_struct(current);
+
+	pr_debug("zest: read slot=%lu sector=%llu\n",
+                  slot, (unsigned long long)sector);
+}
+
+static void __zest_read_single_page_async(struct folio *folio,
+					  struct swap_info_struct *sis, bool synchronous)
+{
+	struct zest_info *zi = zest_current(sis);
+	unsigned long slot;
+	sector_t sector;
+	struct zest_zone *z;
+	unsigned int z_idx;
+	struct bio *bio;
+	struct zest_read_io *io = NULL;
+	void *latency_io = NULL;
+	void *kaddr;
+
+	if (unlikely(!zi)) {
+		WARN_ONCE(1, "zest: readpage with no zi for sis=%p\n", sis);
+		folio_unlock(folio);
+		return;
+	}
+	slot = swp_offset(folio->swap);
+
+	if (unlikely(atomic_read(&zi->fatal) || slot >= zi->nr_slots)) {
+		if (slot >= zi->nr_slots)
+			zest_fatal_trip(zi, slot, 1);
+		folio_unlock(folio);
+		return;
+	}
+
+	if (slot == 0 && zi->mkswap_header) {
+		kaddr = kmap_local_folio(folio, 0);
+		memcpy(kaddr, zi->mkswap_header, PAGE_SIZE);
+		kunmap_local(kaddr);
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		atomic64_inc(&zi->nr_reads);
+		pr_debug("zest: read slot=0 from header cache\n");
+		return;
+	}
+
+retry:
+	sector = READ_ONCE(zi->l2p[slot]);
+
+	if (sector == ZEST_INVALID_SECTOR) {
+		pr_warn_ratelimited("zest: read slot=%lu unmapped (unexpected), zeroed\n",
+				    slot);
+		folio_zero_range(folio, 0, folio_size(folio));
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		atomic64_inc(&zi->nr_reads);
+		return;
+	}
+
+	if (zest_l2p_is_buf(sector)) {
+		u32 gidx = zest_l2p_gidx(sector);
+		struct zest_wbuf *wb = &zi->wbufs[gidx / zi->wbuf_cap];
+		struct page *src = wb->pages[gidx % zi->wbuf_cap];
+
+		kaddr = kmap_local_folio(folio, 0);
+		memcpy(kaddr, page_address(src), PAGE_SIZE);
+		kunmap_local(kaddr);
+		smp_rmb();
+		if (READ_ONCE(zi->l2p[slot]) != sector)
+			goto retry;
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		count_vm_events(PSWPIN, folio_nr_pages(folio));
+		atomic64_inc(&zi->nr_reads);
+		if (zest_swap_chunk_mode(sis))
+			atomic64_inc(&zi->chunk_read_from_wbuf);
+		pr_debug("zest-wbuf: read slot=%lu from buffer gidx=%u\n",
+			 slot, gidx);
+		return;
+	}
+
+	z_idx = zest_find_zone_for_sector(zi, sector);
+	z = z_idx < zi->nr_zones ? &zi->zones[z_idx] : NULL;
+	if (z) {
+		atomic_inc(&z->inflight_reads);
+		smp_mb();
+		if (READ_ONCE(zi->l2p[slot]) != sector) {
+			atomic_dec(&z->inflight_reads);
+			goto retry;
+		}
+	}
+
+	bio = bio_alloc(zi->bdev, 1, REQ_OP_READ | REQ_SWAP, GFP_KERNEL);
+	bio->bi_iter.bi_sector = sector;
+	bio->bi_private = z;
+	bio->bi_end_io = zest_end_swap_bio_read;
+	bio_add_folio_nofail(bio, folio, folio_size(folio), 0);
+	count_vm_events(PSWPIN, folio_nr_pages(folio));
+
+
+	latency_io = swap_latency_io_begin(NULL, folio, sis, false, false,
+			synchronous, bio->bi_iter.bi_sector, bio->bi_iter.bi_size);
+	if (latency_io) {
+		io = kmalloc(sizeof(*io), GFP_KERNEL);
+		io->z = z;
+		io->latency_io = latency_io;
+		bio->bi_private = io;
+		bio->bi_end_io = zest_end_swap_bio_read_traced;
+	}
+	else{
+		swap_latency_target_mark(NULL, folio, SWAP_LATENCY_F_UNTRACKED_IO,
+				SWAP_LATENCY_BACKEND_BLOCK_DEVICE);
+	}
+
+	zest_account_read_bio(zi, bio);
+	submit_bio(bio);
+	if (latency_io)
+		swap_latency_submit_end(latency_io);
+
+	atomic64_inc(&zi->nr_reads);
+	if (zest_swap_chunk_mode(sis))
+		atomic64_inc(&zi->chunk_read_from_device);
+	pr_debug("zest: async read slot=%lu sector=%llu\n",
+		 slot, (unsigned long long)sector);
+}
+
+static void __zest_batch_read(struct folio *folio,
+			      struct swap_info_struct *sis, bool synchronous, bool sync)
+{
+	struct zest_info *zi = zest_current(sis);
+	unsigned long first_slot, last_slot;
+	unsigned int nr;
+	void *kaddr;
+
+	if (unlikely(!zi)) {
+		WARN_ONCE(1, "zest: readpage with no zi for sis=%p\n", sis);
+		folio_unlock(folio);
+		return;
+	}
+
+	first_slot = swp_offset(folio->swap);
+	nr = folio_nr_pages(folio);
+	last_slot = first_slot + nr - 1;
+
+	if (first_slot == 0 && zi->mkswap_header) {
+		if(nr != 1)
+		{
+			WARN_ONCE(1, "zest: read swap header but target huge page?\n");
+		}
+		kaddr = kmap_local_folio(folio, 0);
+		memcpy(kaddr, zi->mkswap_header, PAGE_SIZE);
+		kunmap_local(kaddr);
+		folio_mark_uptodate(folio);
+		folio_unlock(folio);
+		atomic64_inc(&zi->nr_reads);
+		pr_debug("zest: read slot=0 from header cache\n");
+		return;
+	}
+
+	//L2P bounds + FATAL latch.
+	if (unlikely(atomic_read(&zi->fatal) || first_slot >= zi->nr_slots ||
+		     nr > zi->nr_slots - first_slot)) {
+		if (first_slot >= zi->nr_slots ||
+		    nr > zi->nr_slots - first_slot)
+			zest_fatal_trip(zi, first_slot, nr);
+		folio_unlock(folio);
+		return;
+	}
+
+	unsigned long slot = first_slot;
+	struct zest_zone *current_zone = NULL;
+	unsigned int run_nr_slots = 0;
+	sector_t run_first_sector = ZEST_INVALID_SECTOR;
+	unsigned long run_first_slot = first_slot;
+	struct zest_read_batch *batch = mempool_alloc(zi->read_batch_pool,  GFP_KERNEL);
+	batch->folio = folio;
+	batch->pool = zi->read_batch_pool;
+	atomic_set(&batch->pending, 1);
+	batch->status = BLK_STS_OK;
+	
+	sector_t sector;
+	while(slot <= last_slot){
+retry:
+		sector = READ_ONCE(zi->l2p[slot]);
+
+		if (sector == ZEST_INVALID_SECTOR) {
+			pr_warn_ratelimited("zest: read slot=%lu unmapped (unexpected), zeroed\n", slot);
+			folio_zero_range(folio, (size_t)(slot - first_slot) << PAGE_SHIFT, PAGE_SIZE);
+			slot++;
+			continue;
+		}
+
+		//If this sector is still staged in write buffer, serve it straight from the buffer (a memcpy, no bio).
+		if (zest_l2p_is_buf(sector)) {
+			u32 gidx = zest_l2p_gidx(sector);
+			struct zest_wbuf *wb = &zi->wbufs[gidx / zi->wbuf_cap];
+			struct page *src = wb->pages[gidx % zi->wbuf_cap];
+			void *dst;
+
+			dst = kmap_local_folio(folio, (size_t)(slot - first_slot) << PAGE_SHIFT);
+			memcpy(dst, page_address(src), PAGE_SIZE);
+			kunmap_local(dst);
+
+			//Double-check if this data has been swapped out or invalidated.
+			smp_rmb();
+			if (READ_ONCE(zi->l2p[slot]) != sector)
+				goto retry;
+			slot++;
+			continue;
+		}
+
+		unsigned int z_idx = zest_find_zone_for_sector(zi, sector);
+		struct zest_zone *z = z_idx < zi->nr_zones ? &zi->zones[z_idx] : NULL;
+
+		/* Prevent GC reset the zone while the read is inflight.  A sector
+		 * outside the reported zone map is treated as an invalid mapping;
+		 * keep the NULL case safe so the fatal/error path can complete the
+		 * folio without dereferencing a missing zone. */
+		if (z)
+			atomic_inc(&z->inflight_reads);
+
+		smp_mb();
+		/* If GC has already relocated this slot, the current sector is
+		 * mismatched with the old one. Retry against the new location. */
+		if (READ_ONCE(zi->l2p[slot]) != sector) {
+			if (z)
+				atomic_dec(&z->inflight_reads);
+			goto retry;
+		}
+
+		if(current_zone == NULL)
+		{
+			run_first_sector = sector;
+			run_first_slot = slot;
+			current_zone = z;
+			run_nr_slots = 1;
+		}
+		else if(current_zone == z && sector == run_first_sector + ((sector_t)(run_nr_slots << (PAGE_SHIFT - 9))) && slot == run_first_slot + run_nr_slots)
+		{
+			run_nr_slots++;
+		}
+		else
+		{
+			if (sync)
+				zest_submit_batch_read_sync(folio, sis, zi, batch,
+					run_first_sector, run_nr_slots, current_zone,
+					(run_first_slot - first_slot) << PAGE_SHIFT, synchronous);
+			else
+				zest_submit_batch_read_async(folio, sis, zi, batch,
+					run_first_sector, run_nr_slots, current_zone,
+					(run_first_slot - first_slot) << PAGE_SHIFT, synchronous);
+			run_first_sector = sector;
+			run_first_slot = slot;
+			current_zone = z;
+			run_nr_slots = 1;
+		}
+		slot++;
+
+	}
+
+	if(run_nr_slots)
+	{
+		if (sync)
+			zest_submit_batch_read_sync(folio, sis, zi, batch,
+				run_first_sector, run_nr_slots, current_zone,
+				(run_first_slot - first_slot) << PAGE_SHIFT, synchronous);
+		else
+			zest_submit_batch_read_async(folio, sis, zi, batch,
+				run_first_sector, run_nr_slots, current_zone,
+				(run_first_slot - first_slot) << PAGE_SHIFT, synchronous);
+	}
+	else
+	{
+		pr_debug("zest: read [%lu, %lu] without real I/O.\n",
+          first_slot, last_slot);
+	}
+
+	/*
+	* Drop the submit-side bias. If all bios already completed, finish here;
+	* otherwise the last endio finishes the folio.
+	*/
+	if (atomic_dec_and_test(&batch->pending))
+		zest_read_folio_finish(batch);
+}
+
+static void __zest_batch_read_async(struct folio *folio,
+				    struct swap_info_struct *sis, bool synchronous)
+{
+	__zest_batch_read(folio, sis, synchronous, false);
+}
+
+static void __zest_batch_read_sync(struct folio *folio,
+				   struct swap_info_struct *sis, bool synchronous)
+{
+	__zest_batch_read(folio, sis, synchronous, true);
+}
+
+
+void zest_swap_readpage(struct folio *folio, struct swap_info_struct *sis, bool synchronous)
+{
+	/* Logical chunk mode uses the same independent per-slot reader as legacy;
+	 * grouping and leader/wait semantics live in mm/swap_state.c. */
+	if (READ_ONCE(swapfile_sync) && !zest_swap_chunk_mode(sis)) {
+		if (folio_nr_pages(folio) == 1)
+			return __zest_read_single_page_sync(folio, sis, synchronous);
+		return __zest_batch_read_sync(folio, sis, synchronous);
+	}
+
+	if (folio_nr_pages(folio) == 1)
+		return __zest_read_single_page_async(folio, sis, synchronous);
+	return __zest_batch_read_async(folio, sis, synchronous);
+}
+
+
+/* -------------------------------------------------------------- */
+/* ZEST: garbage collection                                    */
+/* -------------------------------------------------------------- */
+
+//zest-gc: swap-slot-free hook (see zest.h). Drop L2P/rmap and decrement
+//valid_blocks for each freed slot so GC accounting is exact. Atomic
+//context (caller holds swap_info_struct::lock); takes only map_lock.
+void zest_swap_slot_free(struct swap_info_struct *sis, unsigned long offset,
+			 unsigned int nr)
+{
+	struct zest_info *zi = zest_current(sis);
+	unsigned int i;
+	unsigned int freed = 0;
+	bool any_empty = false;
+
+	if (unlikely(!zi) || unlikely(atomic_read(&zi->fatal)))
+		return;
+
+	if (unlikely(offset >= zi->nr_slots || nr > zi->nr_slots - offset)) {
+		zest_fatal_trip(zi, offset, nr);
+		return;
+	}
+
+	spin_lock_bh(&zi->map_lock);
+	for (i = 0; i < nr; i++) {
+		sector_t old = zi->l2p[offset + i];
+		unsigned int zidx, blk;
+
+		if (old == ZEST_INVALID_SECTOR)
+			continue;
+		if (!zest_l2p_is_buf(old)) {
+			zidx = zest_find_zone_for_sector(zi, old);
+			if (zidx >= zi->nr_zones) {
+				zest_fatal_trip(zi, old, 1);
+				continue;
+			}
+			blk = zest_blk_in_zone(&zi->zones[zidx], old);
+			if (blk >= zi->zones[zidx].nr_blocks ||
+			    (zi->zones[zidx].rmap[blk] != ZEST_INVALID_SLOT &&
+			     zi->zones[zidx].rmap[blk] != offset + i)) {
+				zest_fatal_trip(zi, old, 1);
+				continue;
+			}
+			{
+				int old_valid = atomic_read(&zi->zones[zidx].valid_blocks);
+
+				zest_map_invalidate_sector(zi, old, offset + i);
+				if (old_valid == 1 &&
+				    atomic_read(&zi->zones[zidx].valid_blocks) == 0 &&
+				    READ_ONCE(zi->zones[zidx].wp_blocks) ==
+						zi->zones[zidx].nr_blocks)
+					any_empty = true;
+			}
+		}
+		WRITE_ONCE(zi->l2p[offset + i], ZEST_INVALID_SECTOR);
+		freed++;
+	}
+	spin_unlock_bh(&zi->map_lock);
+
+	if (freed)
+		pr_debug("zest: slot_free offset=%lu nr=%u freed=%u\n",
+			 offset, nr, freed);
+	if (any_empty) {
+		atomic_set(&zi->gc_reset_kick, 1);
+		wake_up_all(&zi->gc_wait);
+	}
+}
+
+/*
+ * Snapshot valid swap slots physically following @fault_slot in the same
+ * zone.  The returned slots are only hints: swap cache insertion and the
+ * read path revalidate the swap entry and its L2P mapping after this lock is
+ * dropped.  No sleeping operation is permitted while map_lock is held.
+ */
+int zest_collect_readahead_slots(struct swap_info_struct *sis,
+				 unsigned long fault_slot,
+				 unsigned int window_bytes,
+				 unsigned long *slots,
+				 unsigned int max_slots)
+{
+	struct zest_info *zi;
+	sector_t fault_sector;
+	unsigned int zidx, blk, end, n = 0;
+	struct zest_zone *z;
+
+	if (!slots || !max_slots || !window_bytes)
+		return 0;
+	if (window_bytes > (1u << 20) || (window_bytes & (PAGE_SIZE - 1)))
+		return -EINVAL;
+	rcu_read_lock();
+	zi = zest_current(sis);
+	if (!zi || atomic_read(&zi->fatal) || fault_slot >= zi->nr_slots) {
+		rcu_read_unlock();
+		return zi ? 0 : -ENODEV;
+	}
+	spin_lock_bh(&zi->map_lock);
+	fault_sector = READ_ONCE(zi->l2p[fault_slot]);
+	spin_unlock_bh(&zi->map_lock);
+	if (fault_sector == ZEST_INVALID_SECTOR ||
+	    zest_l2p_is_buf(fault_sector) ||
+	    !IS_ALIGNED(fault_sector, 1ULL << (PAGE_SHIFT - 9))) {
+		rcu_read_unlock();
+		return 0;
+	}
+
+	/* Readahead candidates are physical hints for legacy sector-window mode.
+	 * Logical chunk mode does its grouping in swap_state.c from the descriptor,
+	 * so this helper must never infer members from slot arithmetic. */
+	zidx = zest_find_zone_for_sector(zi, fault_sector);
+	if (zidx >= zi->nr_zones) {
+		rcu_read_unlock();
+		return 0;
+	}
+	z = &zi->zones[zidx];
+	blk = zest_blk_in_zone(z, fault_sector);
+	if (blk >= z->nr_blocks) {
+		rcu_read_unlock();
+		return 0;
+	}
+	if (blk == z->nr_blocks - 1) {
+		atomic64_inc(&zest_ra_boundary_stops);
+		rcu_read_unlock();
+		return 0;
+	}
+	{
+		unsigned int window_pages = window_bytes >> PAGE_SHIFT;
+		unsigned int remaining = z->nr_blocks - (blk + 1);
+
+		if (window_pages > remaining)
+			atomic64_inc(&zest_ra_boundary_stops);
+		end = blk + 1 + min(window_pages, remaining);
+	}
+	if (end <= blk + 1) {
+		rcu_read_unlock();
+		return 0;
+	}
+
+	spin_lock_bh(&zi->map_lock);
+	for (blk++; blk < end && n < max_slots; blk++) {
+		u32 slot = READ_ONCE(z->rmap[blk]);
+		sector_t sector;
+		unsigned int k;
+
+		if (slot == ZEST_INVALID_SLOT || slot >= zi->nr_slots ||
+		    slot == fault_slot) {
+			atomic64_inc(&zest_ra_skipped_invalid);
+			continue;
+		}
+		sector = z->start_sector + ((sector_t)blk << (PAGE_SHIFT - 9));
+		if (READ_ONCE(zi->l2p[slot]) != sector) {
+			atomic64_inc(&zest_ra_skipped_invalid);
+			continue;
+		}
+		for (k = 0; k < n; k++)
+			if (slots[k] == slot)
+				break;
+		if (k != n)
+			continue;
+		slots[n++] = slot;
+	}
+	spin_unlock_bh(&zi->map_lock);
+	rcu_read_unlock();
+	return n;
+
+}
+
+//zest-gc: victim zone selection. Among FULL zones (wp_blocks == nr_blocks) that
+//are neither the host write frontier (cur_zone) nor the GC write frontier
+//(gc_cur_zone) nor on the freelist (wp_blocks == 0 already excludes those),
+//pick the one with the fewest valid_blocks. 
+//Returns its index, or ZEST_NO_ZONE if there is no profitable victim.
+static unsigned int zest_gc_pick_victim(struct zest_info *zi,
+					       enum zest_gc_level level,
+					       unsigned int valid_thresh)
+{
+	unsigned int best = ZEST_NO_ZONE;
+	unsigned int best_valid = UINT_MAX;
+	unsigned int best_blocks = UINT_MAX;
+	unsigned int i;
+
+	for (i = 0; i < zi->nr_zones; i++) {
+		struct zest_zone *z = &zi->zones[i];
+		unsigned int v;
+
+		if (i == zi->cur_zone || i == zi->gc_cur_zone)
+			continue;
+		if (z->is_gc_front)
+			continue;
+		if (z->wp_blocks != z->nr_blocks)	/* not FULL (EMPTY/free or partial) */
+			continue;
+		v = atomic_read(&z->valid_blocks);
+		if (valid_thresh && level != ZEST_GC_EMERGENCY &&
+		    (u64)v * 100 >=
+				(u64)z->nr_blocks * valid_thresh)
+			continue;
+		if (v < best_valid ||
+		    (v == best_valid &&
+		     (unsigned int)atomic_read(&z->valid_blocks) < best_blocks)) {
+			best_valid = v;
+			best_blocks = atomic_read(&z->valid_blocks);
+			best = i;
+		}
+	}
+
+	if (best == ZEST_NO_ZONE)
+		return ZEST_NO_ZONE;
+	//No reclaim benefit if the cheapest FULL zone is entirely valid: we'd
+	//copy nr_blocks blocks just to free and re-consume one zone. Skip.
+	if ((u64)best_valid >= zi->zones[best].nr_blocks)
+		return ZEST_NO_ZONE;
+	return best;
+}
+
+//zest-gc: Advance gc_cur_zone if needed.
+static struct zest_zone *zest_gc_frontier(struct zest_info *zi)
+{
+	struct zest_zone *z;
+
+	if (zi->gc_cur_zone != ZEST_NO_ZONE) {
+		z = &zi->zones[zi->gc_cur_zone];
+		if (z->wp_blocks < z->nr_blocks)
+			return z;
+		//Frontier full: it becomes an ordinary FULL zone (a future
+		//victim). Already at wp==nr_blocks on the device -> no padding.
+		z->is_gc_front = false;
+		zi->gc_cur_zone = ZEST_NO_ZONE;
+	}
+
+	spin_lock(&zi->freelist_lock);
+	if (list_empty(&zi->freelist)) {
+		spin_unlock(&zi->freelist_lock);
+		return NULL;
+	}
+	z = list_first_entry(&zi->freelist, struct zest_zone, free_node);
+	list_del_init(&z->free_node);
+	atomic_dec(&zi->nr_free_zones);
+	spin_unlock(&zi->freelist_lock);
+	z->is_gc_front = true;
+	zi->gc_cur_zone = z - zi->zones;
+	return z;
+}
+
+struct zest_gc_io {
+	atomic_t	pending;
+	blk_status_t	status;
+	struct completion done;
+	struct zest_zone *read_zone;
+};
+
+static void zest_gc_bio_endio(struct bio *bio)
+{
+	struct zest_gc_io *io = bio->bi_private;
+
+	if (bio->bi_status)
+		cmpxchg(&io->status, BLK_STS_OK, bio->bi_status);
+	if (io->read_zone)
+		atomic_dec(&io->read_zone->inflight_reads);
+	if (atomic_dec_and_test(&io->pending))
+		complete(&io->done);
+	bio_put(bio);
+}
+
+static void zest_gc_submit_bio(struct zest_gc_io *io, struct bio *bio)
+{
+	atomic_inc(&io->pending);
+	bio->bi_private = io;
+	bio->bi_end_io = zest_gc_bio_endio;
+	submit_bio(bio);
+}
+
+static int zest_gc_wait_io(struct zest_gc_io *io)
+{
+	if (atomic_dec_and_test(&io->pending))
+		complete(&io->done);
+	wait_for_completion(&io->done);
+	return blk_status_to_errno(READ_ONCE(io->status));
+}
+
+//zest-gc: add one write to the current GC batch without waiting for it.
+static void zest_gc_submit_write(struct zest_info *zi, struct zest_gc_io *io,
+				 struct bio *bio)
+{
+	atomic64_add(bio->bi_iter.bi_size, &zi->gc_wb_bytes);
+	atomic64_inc(&zi->bio_count);
+	zest_gc_submit_bio(io, bio);
+}
+
+//zest-gc: batch-read @n victim valid pages into their buffer pages. The
+//migration batch is capped at 128 pages (512 KiB total); gc_buf[j] was tagged
+//with the victim block (.vblk) it should hold. Reads are scattered and
+//independent, so submit them asynchronously without a long-lived plug before
+//waiting for the batch. This leaves foreground reads an opportunity to enter
+//the scheduler between GC batches.
+static int zest_gc_batch_read(struct zest_info *zi, struct zest_zone *victim,
+			      unsigned int n)
+{
+	struct zest_gc_io io;
+	unsigned int j;
+	int err = 0;
+
+	atomic_set(&io.pending, 1);
+	io.status = BLK_STS_OK;
+	io.read_zone = victim;
+	init_completion(&io.done);
+
+	for (j = 0; j < n; j++) {
+		struct bio *bio = bio_alloc(zi->bdev, 1,
+					      REQ_OP_READ | REQ_SWAP, GFP_NOIO);
+		sector_t s = victim->start_sector +
+			((sector_t)zi->gc_buf[j].vblk << (PAGE_SHIFT - 9));
+
+		if (!bio) {
+			err = -ENOMEM;
+			break;
+		}
+		bio->bi_iter.bi_sector = s;
+		__bio_add_page(bio, zi->gc_buf[j].page, PAGE_SIZE, 0);
+		atomic_inc(&victim->inflight_reads);
+		zest_account_read_bio(zi, bio);
+		zest_gc_submit_bio(&io, bio);
+	}
+
+	/* Always drain already-submitted bios before returning: their end_io
+	 * callbacks reference this stack context. */
+	{
+		int wait_err = zest_gc_wait_io(&io);
+		return err ? err : wait_err;
+	}
+}
+
+/* Historical physical-chunk GC helpers are excluded.  GC always migrates
+ * independent blocks and updates each slot's L2P/rmap entry separately. */
+
+//zest-gc: batch-write the @n buffer pages to consecutive gc zones. The
+//submission batch is capped at 128 pages (512 KiB).
+static int zest_gc_batch_write(struct zest_info *zi, sector_t base,
+			       unsigned int n)
+{
+	struct zest_gc_io io;
+	struct bio *bio = NULL;
+	unsigned int i;
+	unsigned int bio_limit = ZEST_WBUF_BIO_BYTES;
+	int err = 0;
+	int wait_err;
+
+	atomic_set(&io.pending, 1);
+	io.status = BLK_STS_OK;
+	/* Write BIOs do not target a victim read zone.  Keep the endio
+	 * callback's optional inflight-read accounting explicit. */
+	io.read_zone = NULL;
+	init_completion(&io.done);
+
+	for (i = 0; i < n; i++) {
+		if (bio && bio->bi_iter.bi_size >= bio_limit) {
+			zest_gc_submit_write(zi, &io, bio);
+			bio = NULL;
+		}
+		if (bio && !bio_add_page(bio, zi->gc_buf[i].page, PAGE_SIZE, 0)) {
+			zest_gc_submit_write(zi, &io, bio);
+			bio = NULL;
+		}
+		if (!bio) {
+			bio = bio_alloc(zi->bdev,
+				min(n - i, (unsigned int)BIO_MAX_VECS),
+				REQ_OP_WRITE | REQ_SWAP, GFP_NOIO);
+			if (!bio) {
+				err = -ENOMEM;
+				break;
+			}
+			bio->bi_iter.bi_sector = base +
+				((sector_t)i << (PAGE_SHIFT - 9));
+			__bio_add_page(bio, zi->gc_buf[i].page, PAGE_SIZE, 0);
+		}
+	}
+	if (bio)
+		zest_gc_submit_write(zi, &io, bio);
+
+	wait_err = zest_gc_wait_io(&io);
+	return err ? err : wait_err;
+}
+
+/* Historical physical-chunk victim evacuation; see the ordinary block GC
+ * implementation below. */
+
+//zest-gc: evacuate ONE victim zone with the foreground batched flow, modeled on
+//f2fs do_garbage_collect: pick a victim, then repeat
+//{ gather a buffer-sized batch of still-valid pages bounded by the gc cur zone's
+//remaining space -> batch-read -> batch-write to the gc cur zone -> under map_lock
+//verify-and-commit each (l2p unchanged => repoint; else drop the copy) } until
+//the zone is fully scanned; then drain inflight reads, RESET the victim zone and
+//return it to the freelist. 
+//Returns 0 on reclaim, 
+// -ENODATA if there is no profitable victim,
+// -ENOSPC if the gc cur zone ran out of space mid-evacuation,
+//else a negative errno.
+int zest_gc_run_one_mode(struct zest_info *zi, enum zest_gc_level level,
+				  unsigned int valid_thresh)
+{
+	unsigned int vidx;
+	struct zest_zone *victim;
+	unsigned int scan = 0;
+	unsigned int moved = 0, aborted = 0;
+	sector_t len;
+	int err = 0;
+
+	atomic_set(&zi->gc_last_level, level);
+	atomic_set(&zi->gc_last_free_zones,
+			atomic_read(&zi->nr_free_zones));
+	if (level == ZEST_GC_NORMAL)
+		atomic64_inc(&zi->gc_normal);
+	else if (level == ZEST_GC_BOOST)
+		atomic64_inc(&zi->gc_boost);
+	else if (level == ZEST_GC_EMERGENCY)
+		atomic64_inc(&zi->gc_emergency);
+	else
+		atomic64_inc(&zi->gc_fixed);
+
+	if (unlikely(atomic_read(&zi->fatal))) {
+		atomic64_inc(&zi->gc_io_errors);
+		return -EIO;
+	}
+	if (unlikely(!zi->gc_buf_nr)) {
+		atomic64_inc(&zi->gc_no_victim);
+		return -ENODATA;
+	}
+
+	vidx = zest_gc_pick_victim(zi, level, valid_thresh);
+	if (vidx == ZEST_NO_ZONE) {
+		atomic64_inc(&zi->gc_no_victim);
+		return -ENODATA;
+	}
+	victim = &zi->zones[vidx];
+	atomic64_inc(&zi->gc_victim_count);
+	if (victim->nr_blocks) {
+		atomic64_add((u64)atomic_read(&victim->valid_blocks) * 100 /
+				victim->nr_blocks, &zi->gc_victim_valid_ratio);
+	}
+
+	atomic64_inc(&zi->gc_runs);
+	pr_debug("zest-gc: victim zone=%u valid=%u nr_blocks=%u free_zones=%d\n",
+		  vidx, atomic_read(&victim->valid_blocks), victim->nr_blocks,
+		  atomic_read(&zi->nr_free_zones));
+	//Drain in-flight DATA writes to the victim before reading it.
+	//This waits out the tail writes that were still in flight when it
+	//rotated out of cur_zone.
+	smp_mb();
+	while (atomic_read(&victim->inflight_writes) > 0)
+		cpu_relax();
+
+	while (scan < victim->nr_blocks) {
+		struct zest_zone *fz;
+		unsigned int room, cap, n, wp0, j;
+		sector_t base;
+
+		fz = zest_gc_frontier(zi);
+		if (!fz) {
+			err = -ENOSPC;
+			break;
+		}
+		room = fz->nr_blocks - fz->wp_blocks;
+		cap = min(zi->gc_buf_nr, room);
+		{
+			struct zest_gc_config cfg;
+			f2fs_zest_gc_get_config(zi->sbi, &cfg);
+			if (cfg.migration_window_pages)
+				cap = min(cap, cfg.migration_window_pages);
+		}
+		if (!cap) {
+			err = -EINVAL;
+			break;
+		}
+
+		n = 0;
+		while (scan < victim->nr_blocks && n < cap) {
+			u32 rv = READ_ONCE(victim->rmap[scan]);
+
+			if (rv != ZEST_INVALID_SLOT) {
+				zi->gc_buf[n].slot = rv;
+				zi->gc_buf[n].vblk = scan;
+				n++;
+			}
+			scan++;
+		}
+		if (n == 0)
+			continue;
+
+		err = zest_gc_batch_read(zi, victim, n);
+		if (err) {
+			pr_warn_ratelimited("zest-gc: batch read failed err=%d\n",
+					    err);
+			break;
+		}
+
+		//Reserve the contiguous frontier run (gc_thread-only wp), then
+		//write the whole batch out sequentially.
+		wp0 = fz->wp_blocks;
+		base = fz->start_sector + ((sector_t)wp0 << (PAGE_SHIFT - 9));
+		fz->wp_blocks += n;
+
+		err = zest_gc_batch_write(zi, base, n);
+		if (err) {
+			pr_warn_ratelimited("zest-gc: batch write failed err=%d\n",
+					    err);
+			break;
+		}
+
+		//Verify-before-update under map_lock. Aborted entries leave dead
+		//space at their frontier sector (reclaimed at that zone's GC).
+	spin_lock_bh(&zi->map_lock);
+		for (j = 0; j < n; j++) {
+			unsigned int vblk = zi->gc_buf[j].vblk;
+			unsigned long slot = zi->gc_buf[j].slot;
+			sector_t old = victim->start_sector +
+				((sector_t)vblk << (PAGE_SHIFT - 9));
+			sector_t new = base + ((sector_t)j << (PAGE_SHIFT - 9));
+
+			if (slot >= zi->nr_slots)
+				continue;
+			if (zi->l2p[slot] == old) {
+				fz->rmap[wp0 + j] = (u32)slot;
+				atomic_inc(&fz->valid_blocks);
+				WRITE_ONCE(zi->l2p[slot], new);
+				victim->rmap[vblk] = ZEST_INVALID_SLOT;
+				atomic_dec(&victim->valid_blocks);
+				moved++;
+			} else {
+				aborted++;
+			}
+		}
+	spin_unlock_bh(&zi->map_lock);
+		cond_resched();
+	}
+	if (err) {
+		//Partial evacuation: committed blocks already moved (l2p
+		//repointed, victim valid decremented exactly); the victim keeps
+		//the rest and is NOT reset. Caller (thread) backs off / retries.
+		atomic64_add(moved, &zi->gc_moved_blocks);
+		atomic64_add(aborted, &zi->gc_aborts_stale);
+		if (err == -ENOSPC)
+			atomic64_inc(&zi->gc_enospc);
+		else
+			atomic64_inc(&zi->gc_io_errors);
+		return err;
+	}
+
+	//Drain readers that may still target the victim, then RESET it.
+	smp_mb();
+	while (atomic_read(&victim->inflight_reads) > 0)
+		cpu_relax();
+
+	len = (sector_t)victim->zone_len_blocks << (PAGE_SHIFT - 9);
+	err = blkdev_zone_mgmt(zi->bdev, REQ_OP_ZONE_RESET, victim->start_sector,
+			       len, GFP_NOFS);
+	if (err) {
+		pr_warn("zest-gc: victim zone=%u RESET failed err=%d\n", vidx, err);
+		atomic64_add(moved, &zi->gc_moved_blocks);
+		atomic64_add(aborted, &zi->gc_aborts_stale);
+		atomic64_inc(&zi->gc_io_errors);
+		return err;
+	}
+
+	//Victim is EMPTY: clear logical state and return it to the freelist.
+	spin_lock_bh(&zi->map_lock);
+	memset(victim->rmap, 0xff, (size_t)victim->nr_blocks * sizeof(u32));
+	atomic_set(&victim->valid_blocks, 0);
+	victim->wp_blocks = 0;
+	spin_unlock_bh(&zi->map_lock);
+
+	spin_lock(&zi->freelist_lock);
+	INIT_LIST_HEAD(&victim->free_node);
+	list_add_tail(&victim->free_node, &zi->freelist);
+	atomic_inc(&zi->nr_free_zones);
+	spin_unlock(&zi->freelist_lock);
+
+	//Wake any swap-out writer blocked on an empty freelist.
+	wake_up_all(&zi->gc_done_wait);
+
+	atomic64_add(moved, &zi->gc_moved_blocks);
+	atomic64_add(aborted, &zi->gc_aborts_stale);
+	atomic64_inc(&zi->gc_zones_reclaimed);
+	atomic64_inc(&zi->gc_success);
+	pr_debug("zest-gc: reclaimed zone=%u moved=%u aborted=%u free_zones=%d\n",
+		  vidx, moved, aborted, atomic_read(&zi->nr_free_zones));
+	return 0;
+}
+
+int zest_gc_run_one(struct zest_info *zi)
+{
+	return zest_gc_run_one_mode(zi, ZEST_GC_EMERGENCY, 100);
+}
+
+static unsigned int zest_gc_watermark(const struct zest_info *zi,
+					 unsigned int percent)
+{
+	u64 w = DIV_ROUND_UP((u64)zi->nr_zones * percent, 100u);
+
+	w = max_t(u64, w, ZEST_GC_RESERVE + 1u);
+	return min_t(u64, w, zi->nr_zones);
+}
+
+void zest_gc_kick(struct zest_info *zi)
+{
+	struct zest_gc_config cfg;
+
+	if (!zi->gc_thread)
+		return;
+	f2fs_zest_gc_get_config(zi->sbi, &cfg);
+	if (cfg.enabled && ((cfg.mode == ZEST_GC_MODE_FIXED &&
+			atomic_read(&zi->nr_free_zones) < cfg.threshold) ||
+			(cfg.mode != ZEST_GC_MODE_FIXED &&
+			 atomic_read(&zi->nr_free_zones) <
+			 zest_gc_watermark(zi, cfg.no_gc_percent)))) {
+		atomic_set(&zi->gc_kick, 1);
+		wake_up(&zi->gc_wait);
+	}
+}
+
+void zest_gc_kick_config(struct f2fs_sb_info *sbi)
+{
+	struct zest_info *zi;
+
+	rcu_read_lock();
+	zi = rcu_dereference_raw(zest_singleton);
+	if (zi && zi->sbi == sbi) {
+		atomic64_inc(&zi->gc_config_generation);
+		if (zi->gc_thread) {
+			atomic_set(&zi->gc_kick, 1);
+			wake_up(&zi->gc_wait);
+		}
+	}
+	rcu_read_unlock();
+}
+
+/* Reset FULL zones whose mappings have all been freed without first running
+ * migration.  Slot frees are the only producer of gc_reset_kick; consume the
+ * request before scanning so a new request arriving during the scan remains
+ * pending for the next iteration. */
+static void zest_gc_reset_empty(struct zest_info *zi)
+{
+	unsigned int i;
+
+	atomic_xchg(&zi->gc_reset_kick, 0);
+	for (i = 0; i < zi->nr_zones; i++) {
+		struct zest_zone *z = &zi->zones[i];
+		unsigned int len_blocks;
+
+		if (i == zi->cur_zone || i == zi->gc_cur_zone || z->is_gc_front)
+			continue;
+		if (READ_ONCE(z->wp_blocks) != z->nr_blocks)
+			continue;
+		if (atomic_read(&z->valid_blocks) != 0)
+			continue;
+
+		/* A slot-free-triggered candidate normally has no writes in flight,
+		 * but a prior GC migration may have left tail I/O outstanding. */
+		smp_mb();
+		while (atomic_read(&z->inflight_reads) > 0 ||
+		       atomic_read(&z->inflight_writes) > 0)
+			cpu_relax();
+		/* A tail write may have committed a new mapping while it was
+		 * draining; never reset such a zone. */
+		if (atomic_read(&z->valid_blocks) != 0)
+			continue;
+
+		len_blocks = z->zone_len_blocks;
+		if (blkdev_zone_mgmt(zi->bdev, REQ_OP_ZONE_RESET,
+				      z->start_sector,
+				      (sector_t)len_blocks << (PAGE_SHIFT - 9),
+				      GFP_NOFS))
+			continue;
+
+		spin_lock_bh(&zi->map_lock);
+		memset(z->rmap, 0xff, z->nr_blocks * sizeof(u32));
+		atomic_set(&z->valid_blocks, 0);
+		z->wp_blocks = 0;
+		spin_unlock_bh(&zi->map_lock);
+
+		spin_lock(&zi->freelist_lock);
+		INIT_LIST_HEAD(&z->free_node);
+		list_add_tail(&z->free_node, &zi->freelist);
+		atomic_inc(&zi->nr_free_zones);
+		spin_unlock(&zi->freelist_lock);
+
+		wake_up_all(&zi->gc_done_wait);
+		atomic64_inc(&zi->gc_direct);
+		atomic64_inc(&zi->gc_zones_reclaimed);
+	}
+}
+
+//zest-gc: the single GC executor.  Fixed mode restores the original
+//free-zone threshold/target policy; dynamic mode keeps the percentage based
+//normal/boost/emergency scheduler.  Blocking I/O and zone resets stay off
+//reclaim/writeback.
+static int zest_gc_threadfn(void *data)
+{
+	struct zest_info *zi = data;
+	unsigned int sleep_ms = 10;
+
+	while (!kthread_should_stop()) {
+		struct zest_gc_config cfg;
+		unsigned int free, no_gc, boost, emergency, budget;
+		enum zest_gc_level level;
+		bool progressed = false;
+
+		f2fs_zest_gc_get_config(zi->sbi, &cfg);
+		if (!cfg.enabled) {
+			wait_event_interruptible(zi->gc_wait,
+				kthread_should_stop() || atomic_read(&zi->gc_kick));
+			atomic_set(&zi->gc_kick, 0);
+			continue;
+		}
+		zest_gc_reset_empty(zi);
+		if (cfg.mode == ZEST_GC_MODE_FIXED) {
+			unsigned int threshold = max_t(unsigned int, cfg.threshold,
+						       ZEST_GC_RESERVE + 1);
+			unsigned int target = max_t(unsigned int, cfg.target, threshold);
+			threshold = min_t(unsigned int, threshold, zi->nr_zones);
+			target = min_t(unsigned int, target, zi->nr_zones);
+			/* Fixed mode is intentionally level-less.  Wake only below the
+			 * trigger and keep reclaiming until the target is reached. */
+			free = atomic_read(&zi->nr_free_zones);
+			if (free >= threshold &&
+			    !atomic_read(&zi->gc_reset_kick)) {
+				atomic_set(&zi->gc_kick, 0);
+				wait_event_interruptible(zi->gc_wait,
+					kthread_should_stop() ||
+					atomic_read(&zi->gc_kick) ||
+					atomic_read(&zi->gc_reset_kick));
+				atomic_set(&zi->gc_kick, 0);
+				continue;
+			}
+			while (!kthread_should_stop() &&
+			       atomic_read(&zi->nr_free_zones) < target) {
+				/* A zero threshold disables the dynamic victim filter and
+				 * restores the old greedy fixed-mode selector. */
+				int ret = zest_gc_run_one_mode(zi, ZEST_GC_FIXED, 0);
+				if (ret) {
+					atomic64_inc(&zi->gc_backoff);
+					break;
+				}
+				progressed = true;
+				cond_resched();
+			}
+			if (!progressed)
+				msleep(min_t(unsigned int,
+						cfg.max_sleep_ms ? cfg.max_sleep_ms : 1000,
+						1000));
+			atomic_set(&zi->gc_kick, 0);
+			continue;
+		}
+		if (!cfg.min_sleep_ms)
+			cfg.min_sleep_ms = 1;
+		if (sleep_ms < cfg.min_sleep_ms)
+			sleep_ms = cfg.min_sleep_ms;
+		if (sleep_ms > cfg.max_sleep_ms)
+			sleep_ms = cfg.max_sleep_ms;
+		free = atomic_read(&zi->nr_free_zones);
+		no_gc = zest_gc_watermark(zi, cfg.no_gc_percent);
+		boost = zest_gc_watermark(zi, cfg.boost_percent);
+		emergency = zest_gc_watermark(zi, cfg.emergency_percent);
+		if (free > no_gc && !atomic_read(&zi->gc_reset_kick)) {
+			sleep_ms = cfg.no_gc_sleep_ms;
+			atomic_set(&zi->gc_kick, 0);
+			wait_event_interruptible(zi->gc_wait,
+				kthread_should_stop() ||
+				atomic_read(&zi->gc_kick) ||
+				atomic_read(&zi->gc_reset_kick));
+			atomic_set(&zi->gc_kick, 0);
+			continue;
+		}
+		if (free <= emergency) {
+			level = ZEST_GC_EMERGENCY;
+			budget = max_t(unsigned int, 1, cfg.max_zones_per_round * 2);
+		} else if (free <= boost) {
+			level = ZEST_GC_BOOST;
+			budget = max_t(unsigned int, 1, cfg.max_zones_per_round);
+		} else {
+			level = ZEST_GC_NORMAL;
+			budget = 1;
+		}
+		while (!kthread_should_stop() && budget--) {
+			int ret = zest_gc_run_one_mode(zi, level,
+						cfg.valid_thresh_percent);
+			if (ret)
+				break;
+			progressed = true;
+			free = atomic_read(&zi->nr_free_zones);
+			if (free > no_gc)
+				break;
+			cond_resched();
+		}
+		if (progressed && level == ZEST_GC_NORMAL)
+			sleep_ms = min(cfg.max_sleep_ms,
+				       sleep_ms + cfg.min_sleep_ms);
+		else if (progressed)
+			sleep_ms = max(cfg.min_sleep_ms,
+				       sleep_ms > cfg.min_sleep_ms ?
+				       sleep_ms - cfg.min_sleep_ms : cfg.min_sleep_ms);
+		else if (!progressed)
+			atomic64_inc(&zi->gc_backoff);
+		if (!progressed)
+			sleep_ms = min(cfg.max_sleep_ms, sleep_ms + cfg.min_sleep_ms);
+		wait_event_interruptible_timeout(zi->gc_wait,
+			kthread_should_stop() || atomic_read(&zi->gc_kick) ||
+			atomic_read(&zi->gc_reset_kick),
+			msecs_to_jiffies(sleep_ms));
+		atomic_set(&zi->gc_kick, 0);
+	}
+	return 0;
+}
+
+int zest_gc_thread_start(struct zest_info *zi)
+{
+	struct task_struct *t;
+
+	t = kthread_create(zest_gc_threadfn, zi, "zest-gc/%pg", zi->bdev);
+	if (IS_ERR(t))
+		return PTR_ERR(t);
+	if (!cpu_possible(7)) {
+		kthread_stop(t);
+		return -ENODEV;
+	}
+	kthread_bind(t, 7);
+	wake_up_process(t);
+	zi->gc_thread = t;
+	return 0;
+}
+
+void zest_gc_thread_stop(struct zest_info *zi)
+{
+	if (zi->gc_thread) {
+		kthread_stop(zi->gc_thread);
+		zi->gc_thread = NULL;
+	}
+}
+
+/* -------------------------------------------------------------- */
+/* Module init                                                    */
+/* -------------------------------------------------------------- */
+
+static int __init zest_init(void)
+{
+	int ret;
+
+	atomic64_set(&zest_stats.redirect_data, 0);
+	atomic64_set(&zest_stats.redirect_node, 0);
+
+	ret = zest_swap_fault_stats_init();
+	if (ret)
+		pr_warn("swap fault stats init failed: %d (continuing degraded)\n",
+			ret);
+
+	ret = zest_sysfs_init();
+	if (ret) {
+		pr_err("sysfs init failed: %d\n", ret);
+		return ret;
+	}
+
+	pr_notice("ZEST loaded; disabled by default\n");
+	return 0;
+}
+
+fs_initcall(zest_init);
diff --git a/mm/zest/zest_swap_fault_stats.c b/mm/zest/zest_swap_fault_stats.c
new file mode 100644
index 0000000000000000000000000000000000000000..3fe81e5d0eff5a7e3722783107e229ec49666a89
--- /dev/null
+++ b/mm/zest/zest_swap_fault_stats.c
@@ -0,0 +1,334 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ZEST swap fault accounting.  This is deliberately independent from the
+ * swap-latency tracer: accounting remains enabled even when tracing is off.
+ */
+#define pr_fmt(fmt) "zest: " fmt
+
+#include <linux/atomic.h>
+#include <linux/hash.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/slab.h>
+#include <linux/sched.h>
+#include <linux/spinlock.h>
+#include <linux/vmalloc.h>
+#include <linux/zest.h>
+
+#include "zest_internal.h"
+
+#define ZEST_SWAP_FAULT_RETRY_BUFFER_BYTES (1U << 20)
+#define ZEST_SWAP_FAULT_HASH_BITS 10
+#define ZEST_SWAP_FAULT_HASH_SIZE (1U << ZEST_SWAP_FAULT_HASH_BITS)
+
+struct zest_swap_fault_retry {
+	struct hlist_node hash_node;
+	struct list_head fifo_node;
+	struct task_struct *task;
+	unsigned long entry;
+	unsigned long address;
+	u64 generation;
+	u32 index;
+	bool first_cache_hit;
+	bool in_use;
+};
+
+static atomic64_t page_faults = ATOMIC64_INIT(0);
+static atomic64_t swap_cache_hits = ATOMIC64_INIT(0);
+static atomic64_t swap_cache_misses = ATOMIC64_INIT(0);
+static atomic64_t async_retry_overflow = ATOMIC64_INIT(0);
+
+static DEFINE_SPINLOCK(retry_lock);
+static struct hlist_head retry_hash[ZEST_SWAP_FAULT_HASH_SIZE];
+static LIST_HEAD(retry_fifo);
+static struct zest_swap_fault_retry *retry_records;
+static unsigned int retry_capacity;
+static unsigned int retry_pending;
+static u64 retry_generation = 1;
+static bool retry_initialized;
+
+static unsigned int retry_bucket(struct task_struct *task,
+				unsigned long address, unsigned long entry)
+{
+	unsigned long key = (unsigned long)task ^ address ^ entry;
+
+	return hash_long(key, ZEST_SWAP_FAULT_HASH_BITS);
+}
+
+static void retry_release_locked(struct zest_swap_fault_retry *rec)
+{
+	if (!rec->in_use)
+		return;
+	if (!hlist_unhashed(&rec->hash_node))
+		hlist_del_init(&rec->hash_node);
+	if (!list_empty(&rec->fifo_node)) {
+		list_del_init(&rec->fifo_node);
+		if (retry_pending)
+			retry_pending--;
+	}
+	if (rec->task)
+		put_task_struct(rec->task);
+	rec->task = NULL;
+	rec->in_use = false;
+}
+
+static void retry_evict_oldest_locked(void)
+{
+	struct zest_swap_fault_retry *rec;
+
+	if (list_empty(&retry_fifo))
+		return;
+	rec = list_first_entry(&retry_fifo,
+				       struct zest_swap_fault_retry, fifo_node);
+	atomic64_inc(&async_retry_overflow);
+	retry_release_locked(rec);
+}
+
+static struct zest_swap_fault_retry *retry_alloc_locked(void)
+{
+	unsigned int i;
+
+	if (!retry_records || !retry_capacity) {
+		atomic64_inc(&async_retry_overflow);
+		return NULL;
+	}
+
+	for (i = 0; i < retry_capacity; i++) {
+		if (!retry_records[i].in_use)
+			return &retry_records[i];
+	}
+
+	/* FIFO eviction is safe only for records that are still pending. */
+	if (!list_empty(&retry_fifo)) {
+		retry_evict_oldest_locked();
+		for (i = 0; i < retry_capacity; i++)
+			if (!retry_records[i].in_use)
+				return &retry_records[i];
+	}
+
+	atomic64_inc(&async_retry_overflow);
+	return NULL;
+}
+
+static void retry_publish_locked(struct zest_swap_fault_retry *rec,
+					struct zest_swap_fault_call *call)
+{
+	unsigned int bucket;
+
+	if (!rec->task) {
+		rec->task = current;
+		get_task_struct(rec->task);
+	}
+	rec->entry = call->entry;
+	rec->address = call->address;
+	rec->generation = call->generation;
+	rec->first_cache_hit = call->first_cache_hit;
+	rec->in_use = true;
+	INIT_HLIST_NODE(&rec->hash_node);
+	INIT_LIST_HEAD(&rec->fifo_node);
+	bucket = retry_bucket(rec->task, rec->address, rec->entry);
+	hlist_add_head(&rec->hash_node, &retry_hash[bucket]);
+	list_add_tail(&rec->fifo_node, &retry_fifo);
+	retry_pending++;
+}
+
+static struct zest_swap_fault_retry *retry_find_locked(
+		struct task_struct *task, unsigned long address, unsigned long entry)
+{
+	struct zest_swap_fault_retry *rec;
+	unsigned int bucket = retry_bucket(task, address, entry);
+
+	hlist_for_each_entry(rec, &retry_hash[bucket], hash_node) {
+		if (rec->task == task && rec->address == address &&
+		    rec->entry == entry && rec->generation == retry_generation)
+			return rec;
+	}
+	return NULL;
+}
+
+static void retry_unpend_locked(struct zest_swap_fault_retry *rec)
+{
+	hlist_del_init(&rec->hash_node);
+	list_del_init(&rec->fifo_node);
+	if (retry_pending)
+		retry_pending--;
+}
+
+void zest_swap_fault_start(struct zest_swap_fault_call *call,
+			   swp_entry_t entry, unsigned long address,
+			   unsigned int fault_flags)
+{
+	struct zest_swap_fault_retry *rec = NULL;
+	unsigned long flags;
+
+	memset(call, 0, sizeof(*call));
+	call->entry = entry.val;
+	call->address = address;
+	call->retry_idx = -1;
+	call->tried = !!(fault_flags & FAULT_FLAG_TRIED);
+	call->active = true;
+
+	spin_lock_irqsave(&retry_lock, flags);
+	call->generation = retry_generation;
+	if (call->tried && retry_initialized)
+		rec = retry_find_locked(current, address, entry.val);
+	if (rec) {
+		call->retry_matched = true;
+		call->first_cache_hit = rec->first_cache_hit;
+		call->retry_idx = rec->index;
+		retry_unpend_locked(rec);
+	} else if (call->tried) {
+		/* A missing record usually means FIFO eviction or a concurrent reset. */
+		atomic64_inc(&async_retry_overflow);
+	}
+	spin_unlock_irqrestore(&retry_lock, flags);
+}
+EXPORT_SYMBOL_GPL(zest_swap_fault_start);
+
+void zest_swap_fault_cache_lookup(struct zest_swap_fault_call *call,
+				   bool cache_hit)
+{
+	unsigned long flags;
+
+	if (!call || !call->active || call->cache_lookup_done)
+		return;
+
+	spin_lock_irqsave(&retry_lock, flags);
+	if (call->generation == retry_generation) {
+		call->cache_lookup_done = true;
+		if (!call->retry_matched)
+			call->first_cache_hit = cache_hit;
+	}
+	spin_unlock_irqrestore(&retry_lock, flags);
+}
+EXPORT_SYMBOL_GPL(zest_swap_fault_cache_lookup);
+
+void zest_swap_fault_end(struct zest_swap_fault_call *call, vm_fault_t result)
+{
+	struct zest_swap_fault_retry *rec = NULL;
+	unsigned long flags;
+
+	if (!call || !call->active)
+		return;
+
+	spin_lock_irqsave(&retry_lock, flags);
+	if (call->retry_idx >= 0 && retry_records &&
+	    (unsigned int)call->retry_idx < retry_capacity)
+		rec = &retry_records[call->retry_idx];
+
+	if (call->generation != retry_generation) {
+		/* reset() invalidated this transaction and its old retry record. */
+		if (rec && rec->in_use && rec->generation == call->generation)
+			retry_release_locked(rec);
+		call->active = false;
+		spin_unlock_irqrestore(&retry_lock, flags);
+		return;
+	}
+	/* Commit a new logical fault only after the path is known not to have
+	 * aborted because of a page-table race.  Retry invocations already carry
+	 * the classification from their original call.
+	 */
+	if (!call->retry_matched && !call->counted &&
+	    call->cache_lookup_done && !call->canceled) {
+		atomic64_inc(&page_faults);
+		if (call->first_cache_hit)
+			atomic64_inc(&swap_cache_hits);
+		else
+			atomic64_inc(&swap_cache_misses);
+		call->counted = true;
+	}
+
+	if ((result & VM_FAULT_RETRY) && !call->canceled) {
+		if (rec && rec->in_use) {
+			/* Re-publish the matched record as the newest FIFO entry. */
+			retry_publish_locked(rec, call);
+		} else {
+			rec = retry_alloc_locked();
+			if (rec)
+				retry_publish_locked(rec, call);
+		}
+		if (rec)
+			call->retry_idx = rec->index;
+	} else if (rec && rec->in_use) {
+		retry_release_locked(rec);
+	}
+	call->active = false;
+	spin_unlock_irqrestore(&retry_lock, flags);
+}
+EXPORT_SYMBOL_GPL(zest_swap_fault_end);
+
+void zest_swap_fault_stats_snapshot(struct zest_swap_fault_stats *stats)
+{
+	unsigned long flags;
+
+	if (!stats)
+		return;
+	stats->page_faults = atomic64_read(&page_faults);
+	stats->swap_cache_hits = atomic64_read(&swap_cache_hits);
+	stats->swap_cache_misses = atomic64_read(&swap_cache_misses);
+	stats->async_retry_overflow = atomic64_read(&async_retry_overflow);
+	spin_lock_irqsave(&retry_lock, flags);
+	stats->async_retry_pending = retry_pending;
+	spin_unlock_irqrestore(&retry_lock, flags);
+}
+
+void zest_swap_fault_stats_reset(void)
+{
+	unsigned int i;
+	unsigned long flags;
+
+	spin_lock_irqsave(&retry_lock, flags);
+	retry_generation++;
+	for (i = 0; retry_records && i < retry_capacity; i++)
+		retry_release_locked(&retry_records[i]);
+	retry_pending = 0;
+	atomic64_set(&page_faults, 0);
+	atomic64_set(&swap_cache_hits, 0);
+	atomic64_set(&swap_cache_misses, 0);
+	atomic64_set(&async_retry_overflow, 0);
+	spin_unlock_irqrestore(&retry_lock, flags);
+}
+
+int zest_swap_fault_stats_init(void)
+{
+	unsigned int i;
+
+	spin_lock_init(&retry_lock);
+	for (i = 0; i < ZEST_SWAP_FAULT_HASH_SIZE; i++)
+		INIT_HLIST_HEAD(&retry_hash[i]);
+	INIT_LIST_HEAD(&retry_fifo);
+	retry_capacity = ZEST_SWAP_FAULT_RETRY_BUFFER_BYTES /
+			sizeof(struct zest_swap_fault_retry);
+	retry_records = vzalloc(array_size(retry_capacity,
+					   sizeof(struct zest_swap_fault_retry)));
+	if (!retry_records) {
+		retry_capacity = 0;
+		retry_initialized = false;
+		pr_warn("swap fault retry buffer unavailable; accounting degraded\n");
+		return -ENOMEM;
+	}
+	for (i = 0; i < retry_capacity; i++) {
+		retry_records[i].index = i;
+		INIT_HLIST_NODE(&retry_records[i].hash_node);
+		INIT_LIST_HEAD(&retry_records[i].fifo_node);
+	}
+	retry_initialized = true;
+	return 0;
+}
+
+void zest_swap_fault_stats_exit(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&retry_lock, flags);
+	while (!list_empty(&retry_fifo))
+		retry_release_locked(list_first_entry(&retry_fifo,
+						      struct zest_swap_fault_retry,
+						      fifo_node));
+	retry_pending = 0;
+	retry_initialized = false;
+	spin_unlock_irqrestore(&retry_lock, flags);
+	vfree(retry_records);
+	retry_records = NULL;
+	retry_capacity = 0;
+}
diff --git a/mm/zest/zest_sysfs.c b/mm/zest/zest_sysfs.c
new file mode 100644
index 0000000000000000000000000000000000000000..e86246973506c9605ef539d18d284690d7bf6780
--- /dev/null
+++ b/mm/zest/zest_sysfs.c
@@ -0,0 +1,469 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * ZEST sysfs: /sys/kernel/zest/
+ *
+ *   enable        rw     master switch (toggles zest_enabled_key)
+ *   swapfile_sync rw     synchronous legacy ZEST swap faults
+ *   stats         ro     subsystem statistics (Step 1: redirect counts)
+ *   swap_fault_stats ro  all-swap logical fault/cache statistics
+ *   swap_fault_stats_reset wo reset fault statistics and retry associations
+ */
+//zest1
+#define pr_fmt(fmt) "zest: " fmt
+
+#include <linux/kobject.h>
+#include <linux/sysfs.h>
+#include <linux/jump_label.h>
+#include <linux/printk.h>
+#include <linux/atomic.h>
+#include <linux/mm.h>		//zest-wbuf: PAGE_SHIFT for avg-flush-size in KiB
+#include <linux/math64.h>	//zest-gc: div64_u64 for avg_bio_kb
+#include <linux/zest.h>
+
+#include "zest_internal.h"
+
+static struct kobject *zest_kobj;
+
+/* -------------------------------------------------------------- */
+/* enable                                                          */
+/* -------------------------------------------------------------- */
+
+//zest2: enable becomes read-only. The static branch is now driven
+//by zest_init_for_swapfile / zest_release_for_swapfile based on whether
+//any swapfile is currently being intercepted. User writes are no longer
+//meaningful and would just cause skew between the static branch and
+//the registry. Keep the file for observability (cat /sys/kernel/zest/enable).
+static ssize_t enable_show(struct kobject *kobj, struct kobj_attribute *attr,
+			   char *buf)
+{
+	return sysfs_emit(buf, "%d\n",
+			  static_branch_unlikely(&zest_enabled_key) ? 1 : 0);
+}
+
+static struct kobj_attribute enable_attr = __ATTR_RO(enable);
+
+/* -------------------------------------------------------------- */
+/* swapfile_sync (rw)                                             */
+/* -------------------------------------------------------------- */
+
+static ssize_t swapfile_sync_show(struct kobject *kobj,
+					  struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%d\n", READ_ONCE(swapfile_sync) ? 1 : 0);
+}
+
+static ssize_t swapfile_sync_store(struct kobject *kobj,
+					   struct kobj_attribute *attr,
+					   const char *buf, size_t count)
+{
+	bool value;
+	int ret;
+
+	ret = kstrtobool(buf, &value);
+	if (ret)
+		return ret;
+	WRITE_ONCE(swapfile_sync, value);
+	return count;
+}
+
+static struct kobj_attribute swapfile_sync_attr =
+	__ATTR_RW(swapfile_sync);
+
+/* -------------------------------------------------------------- */
+/* stats (read-only)                                               */
+/* -------------------------------------------------------------- */
+
+static ssize_t stats_show(struct kobject *kobj, struct kobj_attribute *attr,
+			  char *buf)
+{
+	struct zest_gc_stats_sum gc;
+	u64 avg_pages, avg_kb, avg_bio_kb, avg_read_bio_kb;
+	u64 total_wb, write_amp_milli;
+	u64 avg_victim_valid_ratio;
+
+	zest_gc_collect_stats(&gc);
+
+	//zest-wbuf: average buffer-flush size. Compare avg_flush_kb against
+	//wbuf_cap_kb: ~= cap means full big flushes (good); much smaller means
+	//flushes are dribbling out and bandwidth suffers.
+	avg_pages = gc.flush_count ? gc.flush_pages / gc.flush_count : 0;
+	avg_kb = avg_pages << (PAGE_SHIFT - 10);
+
+	//zest: total device write = host buffer flush + GC relocation.
+	total_wb = gc.host_wb_bytes + gc.gc_wb_bytes;
+	//Average submitted bio size across both -- reflects bio_add_page coalescing
+	//(contiguous bios target 256 KiB; scattered bios may be smaller).
+	avg_bio_kb = gc.bio_count ? div64_u64(total_wb, gc.bio_count) >> 10 : 0;
+	//Average size of read BIOs submitted by Zest, in KiB.
+	avg_read_bio_kb = gc.read_bio_count ?
+		div64_u64(gc.read_bio_bytes, gc.read_bio_count) >> 10 : 0;
+	//Write amplification = total / host-data, x1000 fixed-point (1.000 = no GC
+	//overhead). Host bytes can be 0 before the first flush -> report 0.
+	write_amp_milli = gc.host_wb_bytes ?
+		div64_u64(total_wb * 1000ULL, gc.host_wb_bytes) : 0;
+	avg_victim_valid_ratio = gc.gc_victim_count ?
+		div64_u64(gc.gc_victim_valid_ratio, gc.gc_victim_count) : 0;
+
+	return sysfs_emit(buf,
+		"enabled: %d\n"
+		"redirect_data: %llu\n"
+		"redirect_node: %llu\n"
+		"fatal: %d\n"
+		"fatal_count: %llu\n"
+		"gc_swapfiles: %u\n"
+		"gc_free_zones: %ld\n"
+		"gc_runs: %llu\n"
+		"gc_moved_blocks: %llu\n"
+		"gc_zones_reclaimed: %llu\n"
+		"gc_direct: %llu\n"
+		"gc_aborts_stale: %llu\n"
+		"gc_normal: %llu\n"
+		"gc_fixed: %llu\n"
+		"gc_boost: %llu\n"
+		"gc_emergency: %llu\n"
+		"gc_success: %llu\n"
+		"gc_no_victim: %llu\n"
+		"gc_enospc: %llu\n"
+		"gc_io_errors: %llu\n"
+		"gc_backoff: %llu\n"
+		"gc_config_generation: %llu\n"
+		"gc_last_free_zones: %u\n"
+		"gc_last_level: %u\n"
+		"gc_victim_avg_valid_ratio: %llu\n"
+		"gc_victim_count: %llu\n"
+		"nr_write_rejects: %llu\n"
+		"wbuf_flushes: %llu\n"
+		"wbuf_flush_pages: %llu\n"
+		"wbuf_avg_flush_kb: %llu\n"
+		"wbuf_cap_kb: %u\n"
+		"avg_bio_kb: %llu\n"
+		"avg_read_bio_kb: %llu\n"
+		"host_wb_kb: %llu\n"
+		"gc_wb_kb: %llu\n"
+		"total_wb_kb: %llu\n"
+		"readahead_attempts: %llu\n"
+		"readahead_mode: %u\n"
+		"readahead_requested_pages: %llu\n"
+		"readahead_submitted_pages: %llu\n"
+		"readahead_cache_hits: %llu\n"
+		"readahead_fault_hits: %llu\n"
+		"readahead_skipped_invalid: %llu\n"
+		"readahead_boundary_stops: %llu\n"
+		"readahead_io_errors: %llu\n"
+		"chunk_alloc_success: %llu\n"
+		"chunk_alloc_fail: %llu\n"
+		"chunk_grouping_fail: %llu\n"
+		"chunk_underfilled: %llu\n"
+		"chunk_duplicate_fault_merged: %llu\n"
+		"chunk_read_groups: %llu\n"
+		"chunk_members_requested: %llu\n"
+		"chunk_member_cache_hits: %llu\n"
+		"chunk_member_bio_submitted: %llu\n"
+		"chunk_member_read_errors: %llu\n"
+		"chunk_read_from_wbuf: %llu\n"
+		"chunk_read_from_device: %llu\n"
+		"write_amp: %llu.%03llu\n",
+		static_branch_unlikely(&zest_enabled_key) ? 1 : 0,
+		(unsigned long long)atomic64_read(&zest_stats.redirect_data),
+		(unsigned long long)atomic64_read(&zest_stats.redirect_node),
+		atomic_read(&zest_fatal),
+		(unsigned long long)atomic64_read(&zest_fatal_count),
+		gc.nr_swapfiles,
+		gc.free_zones,
+		(unsigned long long)gc.runs,
+		(unsigned long long)gc.moved,
+		(unsigned long long)gc.reclaimed,
+		(unsigned long long)gc.gc_direct,
+		(unsigned long long)gc.aborts,
+		(unsigned long long)gc.gc_normal,
+		(unsigned long long)gc.gc_fixed,
+		(unsigned long long)gc.gc_boost,
+		(unsigned long long)gc.gc_emergency,
+		(unsigned long long)gc.gc_success,
+		(unsigned long long)gc.gc_no_victim,
+		(unsigned long long)gc.gc_enospc,
+		(unsigned long long)gc.gc_io_errors,
+		(unsigned long long)gc.gc_backoff,
+		(unsigned long long)gc.gc_config_generation,
+		gc.gc_last_free_zones,
+		gc.gc_last_level,
+		(unsigned long long)avg_victim_valid_ratio,
+		(unsigned long long)gc.gc_victim_count,
+		(unsigned long long)gc.nr_write_rejects,
+		(unsigned long long)gc.flush_count,
+		(unsigned long long)gc.flush_pages,
+		(unsigned long long)avg_kb,
+		gc.wbuf_cap << (PAGE_SHIFT - 10),
+		(unsigned long long)avg_bio_kb,
+		(unsigned long long)avg_read_bio_kb,
+		(unsigned long long)(gc.host_wb_bytes >> 10),
+		(unsigned long long)(gc.gc_wb_bytes >> 10),
+		(unsigned long long)(total_wb >> 10),
+		(unsigned long long)atomic64_read(&zest_ra_attempts),
+		READ_ONCE(zest_layout_mode),
+		(unsigned long long)atomic64_read(&zest_ra_requested),
+		(unsigned long long)atomic64_read(&zest_ra_submitted),
+		(unsigned long long)atomic64_read(&zest_ra_cache_hits),
+		(unsigned long long)atomic64_read(&zest_ra_fault_hits),
+		(unsigned long long)atomic64_read(&zest_ra_skipped_invalid),
+		(unsigned long long)atomic64_read(&zest_ra_boundary_stops),
+		(unsigned long long)atomic64_read(&zest_ra_io_errors),
+		(unsigned long long)gc.chunk_alloc_success,
+		(unsigned long long)gc.chunk_alloc_fail,
+		(unsigned long long)gc.chunk_grouping_fail,
+		(unsigned long long)gc.chunk_underfilled,
+		(unsigned long long)gc.chunk_duplicate_fault_merged,
+		(unsigned long long)gc.chunk_read_groups,
+		(unsigned long long)gc.chunk_members_requested,
+		(unsigned long long)gc.chunk_member_cache_hits,
+		(unsigned long long)gc.chunk_member_bio_submitted,
+		(unsigned long long)gc.chunk_member_read_errors,
+		(unsigned long long)gc.chunk_read_from_wbuf,
+		(unsigned long long)gc.chunk_read_from_device,
+		(unsigned long long)(write_amp_milli / 1000),
+		(unsigned long long)(write_amp_milli % 1000));
+}
+
+static struct kobj_attribute stats_attr = __ATTR_RO(stats);
+
+/* -------------------------------------------------------------- */
+/* swap fault statistics                                           */
+/* -------------------------------------------------------------- */
+
+static ssize_t swap_fault_stats_show(struct kobject *kobj,
+				      struct kobj_attribute *attr, char *buf)
+{
+	struct zest_swap_fault_stats stats;
+
+	zest_swap_fault_stats_snapshot(&stats);
+	return sysfs_emit(buf,
+		"page_faults: %llu\n"
+		"swap_cache_hits: %llu\n"
+		"swap_cache_misses: %llu\n"
+		"async_retry_pending: %llu\n"
+		"async_retry_overflow: %llu\n",
+		(unsigned long long)stats.page_faults,
+		(unsigned long long)stats.swap_cache_hits,
+		(unsigned long long)stats.swap_cache_misses,
+		(unsigned long long)stats.async_retry_pending,
+		(unsigned long long)stats.async_retry_overflow);
+}
+
+static struct kobj_attribute swap_fault_stats_attr =
+	__ATTR_RO(swap_fault_stats);
+
+static ssize_t swap_fault_stats_reset_store(struct kobject *kobj,
+					    struct kobj_attribute *attr,
+					    const char *buf, size_t count)
+{
+	bool value;
+	int ret;
+
+	ret = kstrtobool(buf, &value);
+	if (ret)
+		return ret;
+	if (value)
+		zest_swap_fault_stats_reset();
+	return count;
+}
+
+static struct kobj_attribute swap_fault_stats_reset_attr =
+	__ATTR_WO(swap_fault_stats_reset);
+
+/* -------------------------------------------------------------- */
+/* fatal (read-only) -- L2P out-of-bounds latch                    */
+/* -------------------------------------------------------------- */
+
+//zest3.1: surface the permanent L2P-OOB FATAL latch. Reads the subsystem-
+//wide mirror in zest_main.c so it stays valid even after swapoff frees the
+//per-swapfile zest_info. `cat /sys/kernel/zest/fatal` at any time -- no
+//reliance on dmesg not having scrolled. Pairs with pstore for cross-reboot.
+//
+//  fatal       1 once an out-of-bounds swap slot has ever been seen
+//  fatal_count number of OOB events observed (re-trips included)
+//  fatal_slot  last offending slot index
+//  fatal_nr    last offending nr_pages
+static ssize_t fatal_show(struct kobject *kobj, struct kobj_attribute *attr,
+			  char *buf)
+{
+	return sysfs_emit(buf,
+		"fatal: %d\n"
+		"fatal_count: %llu\n"
+		"fatal_slot: %llu\n"
+		"fatal_nr: %d\n",
+		atomic_read(&zest_fatal),
+		(unsigned long long)atomic64_read(&zest_fatal_count),
+		(unsigned long long)atomic64_read(&zest_fatal_slot),
+		atomic_read(&zest_fatal_nr));
+}
+
+static struct kobj_attribute fatal_attr = __ATTR_RO(fatal);
+
+/* -------------------------------------------------------------- */
+/* cache_retain_min_free (rw) -- ZNSwap-style swap-cache retention */
+/* -------------------------------------------------------------- */
+
+//zest-znswap: free-zone threshold above which the ZEST swapfile keeps
+//swapped-in clean pages' swap slots instead of trimming under vm_swap_full().
+//See ZEST_CACHE_RETAIN_MIN_FREE / __zest_swap_retain_cache(). Lower = retain
+//more aggressively (fewer rewrites, less zone headroom).
+static ssize_t cache_retain_min_free_show(struct kobject *kobj,
+					  struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", READ_ONCE(zest_cache_retain_min_free));
+}
+
+static ssize_t cache_retain_min_free_store(struct kobject *kobj,
+					   struct kobj_attribute *attr,
+					   const char *buf, size_t count)
+{
+	unsigned int val;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &val);
+	if (ret)
+		return ret;
+	WRITE_ONCE(zest_cache_retain_min_free, val);
+	return count;
+}
+
+static struct kobj_attribute cache_retain_min_free_attr =
+	__ATTR_RW(cache_retain_min_free);
+
+static ssize_t readahead_window_bytes_show(struct kobject *kobj,
+						 struct kobj_attribute *attr,
+						 char *buf)
+{
+	return sysfs_emit(buf, "%u\n", READ_ONCE(zest_readahead_window_bytes));
+}
+
+static ssize_t readahead_window_bytes_store(struct kobject *kobj,
+						  struct kobj_attribute *attr,
+						  const char *buf, size_t count)
+{
+	unsigned int val;
+	int ret = kstrtouint(buf, 0, &val);
+
+	if (ret)
+		return ret;
+	/* A zero window is useful for experiments which want no configurable
+	 * sector-window readahead.  Chunk mode still reads the fault's mandatory
+	 * 32 KiB logical group, but this value must not be allowed to select a
+	 * different chunk size. */
+	if (READ_ONCE(zest_layout_mode) == ZEST_LAYOUT_CHUNK32K && val)
+		return -EOPNOTSUPP;
+	if (val > (1u << 20) || (val && val < PAGE_SIZE) ||
+		(val & (PAGE_SIZE - 1)))
+		return -EINVAL;
+	WRITE_ONCE(zest_readahead_window_bytes, val);
+	return count;
+}
+
+static struct kobj_attribute readahead_window_bytes_attr =
+	__ATTR_RW(readahead_window_bytes);
+
+static ssize_t readahead_mode_show(struct kobject *kobj,
+					   struct kobj_attribute *attr, char *buf)
+{
+	return sysfs_emit(buf, "%u\n", READ_ONCE(zest_layout_mode));
+}
+
+static ssize_t readahead_mode_store(struct kobject *kobj,
+					    struct kobj_attribute *attr,
+					    const char *buf, size_t count)
+{
+	unsigned int val;
+	int ret = kstrtouint(buf, 0, &val);
+
+	if (ret)
+		return ret;
+	if (val > ZEST_RA_MODE_CHUNK32K)
+		return -EINVAL;
+	/* This knob changes the logical read layout.  Do not allow a live
+	 * swapfile to observe a mixture of sector and chunk semantics. */
+	if (static_branch_unlikely(&zest_enabled_key) ||
+	    atomic_read(&zest_readahead_latched))
+		return -EBUSY;
+	WRITE_ONCE(zest_layout_mode, val);
+	WRITE_ONCE(zest_readahead_mode, val);
+	return count;
+}
+
+static struct kobj_attribute readahead_mode_attr =
+	__ATTR_RW(readahead_mode);
+
+static struct kobj_attribute layout_mode_attr =
+	__ATTR(layout_mode, 0644, readahead_mode_show, readahead_mode_store);
+
+/* Explicitly named alias used by the chunk-layout interface.  Keep both the
+ * historical readahead_mode spelling and the shorter layout_mode spelling so
+ * existing userspace remains compatible while new tooling can discover the
+ * mode unambiguously. */
+static struct kobj_attribute zest_layout_mode_attr =
+	__ATTR(zest_layout_mode, 0644, readahead_mode_show, readahead_mode_store);
+
+static ssize_t effective_readahead_bytes_show(struct kobject *kobj,
+					       struct kobj_attribute *attr,
+					       char *buf)
+{
+	unsigned int bytes = READ_ONCE(zest_layout_mode) == ZEST_LAYOUT_CHUNK32K ?
+		ZEST_CHUNK_BYTES : READ_ONCE(zest_readahead_window_bytes);
+
+	return sysfs_emit(buf, "%u\n", bytes);
+}
+
+static struct kobj_attribute effective_readahead_bytes_attr =
+	__ATTR_RO(effective_readahead_bytes);
+
+
+
+
+/* -------------------------------------------------------------- */
+/* group                                                           */
+/* -------------------------------------------------------------- */
+
+static struct attribute *zest_attrs[] = {
+	&enable_attr.attr,
+	&swapfile_sync_attr.attr,
+	&stats_attr.attr,
+	&swap_fault_stats_attr.attr,
+	&swap_fault_stats_reset_attr.attr,
+	&fatal_attr.attr,
+	&cache_retain_min_free_attr.attr,
+	&readahead_window_bytes_attr.attr,
+	&readahead_mode_attr.attr,
+	&layout_mode_attr.attr,
+	&zest_layout_mode_attr.attr,
+	&effective_readahead_bytes_attr.attr,
+	NULL,
+};
+
+static const struct attribute_group zest_attr_group = {
+	.attrs = zest_attrs,
+};
+
+int zest_sysfs_init(void)
+{
+	int ret;
+
+	zest_kobj = kobject_create_and_add("zest", kernel_kobj);
+	if (!zest_kobj)
+		return -ENOMEM;
+
+	ret = sysfs_create_group(zest_kobj, &zest_attr_group);
+	if (ret) {
+		kobject_put(zest_kobj);
+		zest_kobj = NULL;
+		return ret;
+	}
+	return 0;
+}
+
+void zest_sysfs_exit(void)
+{
+	if (zest_kobj) {
+		sysfs_remove_group(zest_kobj, &zest_attr_group);
+		kobject_put(zest_kobj);
+		zest_kobj = NULL;
+	}
+}
