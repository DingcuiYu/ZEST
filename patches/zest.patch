diff --git a/include/linux/zest.h b/include/linux/zest.h
new file mode 100644
index 0000000000000000000000000000000000000000..ef7ba37ff7406ccd4364f125307c0bdfb165220f
--- /dev/null
+++ b/include/linux/zest.h
@@ -0,0 +1,369 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * ZEST: Zoned-storage swap layer for mobile F2FS
+ *
+ * Step 1: cold->warm redirect to free up open-zone budget for ZEST.
+ *
+ * The static branch keeps the fast path identical to upstream when
+ * disabled. Even when enabled, redirect is gated per-sb on
+ * sbi->zest_enable.
+ */
+//zest1
+#ifndef _LINUX_ZEST_H
+#define _LINUX_ZEST_H
+
+#include <linux/types.h>
+#include <linux/atomic.h>
+#include <linux/errno.h>
+#include <linux/jump_label.h>
+#include <linux/mm_types.h>
+
+struct page;
+struct folio;
+struct writeback_control;
+struct swap_info_struct;
+struct block_device;
+struct f2fs_sb_info;
+struct inode;
+
+/* Per-invocation state used by the swap fault statistics hooks.  The
+ * implementation keeps retry records private; this small object is embedded
+ * in do_swap_page() and is intentionally safe to use when ZEST is disabled.
+ */
+struct zest_swap_fault_call {
+	unsigned long entry;
+	unsigned long address;
+	u64 generation;
+	int retry_idx;
+	bool active;
+	bool retry_matched;
+	bool cache_lookup_done;
+	bool counted;
+	bool canceled;
+	bool first_cache_hit;
+	bool tried;
+};
+
+/* Readahead layout values are needed by generic mm files even when ZEST is
+ * compiled out; the corresponding variables become harmless static stubs. */
+enum zest_layout_mode {
+	ZEST_LAYOUT_LEGACY_SECTOR = 0,
+	ZEST_LAYOUT_CHUNK32K = 1,
+};
+/* Compatibility names for existing in-tree users. */
+#define ZEST_RA_MODE_SECTOR	ZEST_LAYOUT_LEGACY_SECTOR
+#define ZEST_RA_MODE_CHUNK32K	ZEST_LAYOUT_CHUNK32K
+#define ZEST_CHUNK_PAGES		8u
+
+enum zest_gc_mode {
+	ZEST_GC_MODE_FIXED = 0,
+	ZEST_GC_MODE_DYNAMIC = 1,
+};
+
+struct zest_gc_config {
+	bool enabled;
+	/* 0: fixed free-zone threshold/target, 1: percentage/adaptive mode */
+	unsigned int mode;
+	unsigned int threshold;
+	unsigned int target;
+	unsigned int no_gc_percent;
+	unsigned int boost_percent;
+	unsigned int emergency_percent;
+	unsigned int valid_thresh_percent;
+	unsigned int min_sleep_ms;
+	unsigned int max_sleep_ms;
+	unsigned int no_gc_sleep_ms;
+	unsigned int max_zones_per_round;
+	unsigned int migration_window_pages;
+};
+
+void f2fs_zest_gc_get_config(struct f2fs_sb_info *sbi,
+				struct zest_gc_config *cfg);
+void zest_gc_config_changed(struct f2fs_sb_info *sbi);
+
+#ifdef CONFIG_ZEST_SWAP
+
+DECLARE_STATIC_KEY_FALSE(zest_enabled_key);
+
+/* Runtime switch: make legacy ZEST swap faults use synchronous I/O. */
+extern bool swapfile_sync;
+
+/* Slow-path part of zest_should_intercept(). Forward-declared early. */
+bool __zest_should_intercept(struct swap_info_struct *sis);
+bool zest_swap_chunk_mode(struct swap_info_struct *sis);
+bool zest_chunk_layout_active(void);
+int zest_swap_layout_request(struct swap_info_struct *sis, unsigned int mode);
+void zest_swap_layout_destroy(struct swap_info_struct *sis);
+
+/*
+ * Hot-path predicate. Single static_branch test when disabled.
+ */
+static __always_inline bool zest_should_intercept(struct swap_info_struct *sis)
+{
+	if ((!static_branch_unlikely(&zest_enabled_key)))
+		return false;
+	return __zest_should_intercept(sis);
+}
+
+/* mm/page_io.c swap I/O hooks. */
+void zest_swap_writepage(struct page *page, struct writeback_control *wbc,
+			 struct swap_info_struct *sis);
+void zest_swap_readpage(struct folio *folio, struct swap_info_struct *sis, bool synchronous);
