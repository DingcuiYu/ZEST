+/* Add eight independent base-page folios as one logical Zest chunk.  The
+ * swap allocator and cache insertion are transactional: callers never see a
+ * partially published chunk. */
+bool add_to_swap_chunk(struct folio **folios, unsigned int *valid_mask)
+{
+	swp_entry_t entries[ZEST_SWAP_CHUNK_PAGES];
+	unsigned int mask = 0, inserted_mask = 0;
+	int i;
+
+	if (!folios || !valid_mask)
+		return false;
+	for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++) {
+		if (!folios[i])
+			continue;
+		if (!folio_test_locked(folios[i]) ||
+		    !folio_test_uptodate(folios[i]) ||
+		    folio_test_swapcache(folios[i]) ||
+		    folio_nr_pages(folios[i]) != 1)
+			return false;
+		mask |= 1u << i;
+	}
+	if (!mask || !folio_alloc_swap_chunk(folios, entries, &mask))
+		return false;
+	for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++) {
+		if (!(mask & (1u << i)))
+			continue;
+		if (add_to_swap_cache(folios[i], entries[i],
+				__GFP_HIGH | __GFP_NOMEMALLOC | __GFP_NOWARN,
+				NULL))
+			goto fail;
+		folio_mark_dirty(folios[i]);
+		inserted_mask |= 1u << i;
+	}
+	*valid_mask = mask;
+	return true;
+fail:
+	/* Delete inserted folios first; then release every reserved member
+	 * individually because an underfilled mask may contain holes. */
+	for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++) {
+		if (!(mask & (1u << i)))
+			continue;
+		if (inserted_mask & (1u << i))
+			delete_from_swap_cache(folios[i]);
+	}
+	abort_swap_zest_chunk(entries, mask, mask);
+	zest_account_chunk_alloc(false);
+	*valid_mask = 0;
+	return false;
+}
+
