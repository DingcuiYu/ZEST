+/* Roll back a chunk reservation when only a prefix of memcg charges or cache
+ * insertions succeeded.  Unlike swapcache_free_entries(), this helper knows
+ * exactly which members were charged and therefore never uncharges a hole. */
+void abort_swap_zest_chunk(swp_entry_t *entries, unsigned int valid_mask,
+			   unsigned int charged_mask)
+{
+	struct swap_info_struct *si;
+	unsigned int i;
+
+	if (!entries || !valid_mask)
+		return;
+	si = swp_swap_info(entries[0]);
+	if (!si || !(si->flags & SWP_USED))
+		return;
+	spin_lock(&si->lock);
+	for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++) {
+		unsigned long offset;
+		struct swap_cluster_info *ci;
+
+		if (!(valid_mask & (1u << i)))
+			continue;
+		offset = swp_offset(entries[i]);
+		if (READ_ONCE(si->swap_map[offset]) != SWAP_HAS_CACHE)
+			continue;
+		ci = lock_cluster(si, offset);
+		WRITE_ONCE(si->swap_map[offset], 0);
+		dec_cluster_info_page(si, ci, 1);
+		unlock_cluster(ci);
+		if (charged_mask & (1u << i))
+			mem_cgroup_uncharge_swap(entries[i], 1);
+		swap_range_free(si, offset, 1);
+	}
+	spin_unlock(&si->lock);
+}
+EXPORT_SYMBOL_GPL(abort_swap_zest_chunk);
