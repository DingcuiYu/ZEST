+/* True only when the active swap set contains this strict Zest backend and
+ * no other write-capable backend.  Underfilled chunks are safe to use only in
+ * this case, otherwise ordinary swap can absorb the unmatched folios. */
+bool swap_zest_only_backend(void)
+{
+	struct swap_info_struct *si;
+	unsigned int active = 0;
+	bool only = true;
