+/* Reserve and charge one complete Zest logical chunk.  @folios may contain
+ * NULL holes for the underfilled fallback; the physical eight-page reservation
+ * is still held until every valid member is released. */
+bool folio_alloc_swap_chunk(struct folio **folios, swp_entry_t *entries,
+				unsigned int *valid_mask)
+{
+	unsigned int mask = 0, charged = 0;
+	int i;
+
+	if (!folios || !entries || !valid_mask)
+		return false;
+	*valid_mask = 0;
+	for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++) {
+		entries[i].val = 0;
+		if (!folios[i])
+			continue;
+		if (folio_nr_pages(folios[i]) != 1 ||
+		    !folio_test_locked(folios[i]) ||
+		    !folio_test_uptodate(folios[i]) ||
+		    folio_test_swapcache(folios[i]))
+		{
+			zest_account_chunk_alloc(false);
+			return false;
+		}
+		mask |= 1u << i;
+	}
+	if (!mask) {
+		zest_account_chunk_alloc(false);
+		return false;
+	}
+	if (!get_swap_zest_chunk(entries))
+	{
+		zest_account_chunk_alloc(false);
+		return false;
+	}
+	/* Keep the complete physical/logical reservation, but release holes from
+	 * the swap map immediately.  Do this through the descriptor rollback
+	 * helper rather than swapcache_free_entries(): no memcg charge exists for
+	 * a hole, so the latter would attempt an unmatched uncharge.  The chunk
+	 * bitmap remains allocated until the last valid member is freed, so these
+	 * slots cannot be reused by another allocator in the meantime. */
+	{
+		unsigned int holes = ((1u << ZEST_SWAP_CHUNK_PAGES) - 1) & ~mask;
+
+		if (holes)
+			abort_swap_zest_chunk(entries, holes, 0);
+	}
+	for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++) {
+		if (!(mask & (1u << i)))
+			continue;
+		if (mem_cgroup_try_charge_swap(folios[i], entries[i]))
+			goto fail;
+		charged |= 1u << i;
+	}
+	*valid_mask = mask;
+	zest_account_chunk_alloc(true);
+	return true;
+fail:
+	abort_swap_zest_chunk(entries, mask, charged);
+	zest_account_chunk_alloc(false);
+	*valid_mask = 0;
+	return false;
+}
