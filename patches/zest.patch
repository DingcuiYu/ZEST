+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0
+
+"""Analyze SWPLAT paths, latency combinations, VM_FAULT_MAJOR, and ZEST I/O.
+
+The analyzer is intentionally independent from the ADB test runner.  It scans
+the binary trace in bounded-size batches, so multi-gigabyte raw files do not
+need to be loaded into memory.  Exact latency percentiles retain compact
+eight-byte samples for each selected record instead of retaining raw records.
+"""
+
+import argparse
+from array import array
+from bisect import bisect_right
+from collections import Counter
+import json
+import math
+from pathlib import Path
+import struct
+import sys
+from typing import Dict, List, Optional, Set
+
+
+_HEADER_LE = struct.Struct("<8sIIIIQQQQQQQIIII64s96s")
+_HEADER_BE = struct.Struct(">8sIIIIQQQQQQQIIII64s96s")
+# Raw format v3 stores finalized root/RVH scheduler deltas as four u64 time
+# values followed by eight u32 switch/CPU values.  Older raw containers are
+# intentionally rejected; extension versions below are type-tail versions,
+# not raw-format compatibility selectors.
+_TRACE_VERSION = 3
+_RECORD_LE = struct.Struct("<IHHII14QIiIIIIIiIIII16siI56s4Q8I")
+_RECORD_BE = struct.Struct(">IHHII14QIiIIIIIiIIII16siI56s4Q8I")
+_SWAPIN_EXT_LE = struct.Struct("<6QII")
+_SWAPIN_EXT_BE = struct.Struct(">6QII")
+_SWAPOUT_EXT_LE = struct.Struct("<5QIIII")
+_SWAPOUT_EXT_BE = struct.Struct(">5QIIII")
+
+_HEADER_MAGIC = b"SWPLAT\0\0"
+_RECORD_MAGIC = 0x52544C53
+_ENDIAN_MARKER = 0x01020304
+_VENDOR_EXT_VERSION = 1
+_SWAPOUT_EXT_VERSION = 2
+
+_TYPE_SWAPIN = 1
+_TYPE_SWAPOUT = 2
+
+_F_CACHE_HIT = 1 << 0
+_F_CACHE_MISS = 1 << 1
+_F_CACHE_INFLIGHT = 1 << 2
+_F_ZSWAP = 1 << 3
+_F_SYNC = 1 << 4
+_F_ASYNC = 1 << 5
+_F_BIO = 1 << 6
+_F_ERROR = 1 << 7
+_F_NO_IO = 1 << 8
+_F_FS_OPS = 1 << 9
+_F_BDEV = 1 << 10
+_F_SWAPFILE = 1 << 11
+_F_ZRAM = 1 << 12
+_F_BLOCK_DEVICE = 1 << 13
+_F_READ = 1 << 14
+_F_WRITE = 1 << 15
+_F_SUBMIT_VALID = 1 << 16
+_F_DEVICE_VALID = 1 << 17
+_F_CALL_VALID = 1 << 18
+_F_VENDOR_BYPASS = 1 << 19
+_F_RETRY = 1 << 20
+_F_DIRECT = 1 << 21
+_F_FREE_SWAP = 1 << 22
+_F_ARCH_ERROR = 1 << 23
+_F_UNTRACKED_IO = 1 << 24
+_F_SCHED_VALID = 1 << 25
+_F_RUN_DELAY_VALID = 1 << 26
+_F_SCHED_COUNTER_OVERFLOW = 1 << 27
+# A synthetic swap-out record for one physical ZEST flush bio.  This bit is
+# intentionally kept out of the legacy path/combination flags below: ZEST
+# records are reported in their own section, and adding the bit does not alter
+# the legacy path/combination names consumed by existing tools.
+_F_ZEST_FLUSH = 1 << 28
+
+_BACKEND_SWAPFILE = 2
+_BACKEND_BLOCK_DEVICE = 3
+
+_VENDOR_F_RVH_CALLED = 1 << 0
+_VENDOR_F_RVH_HANDLED = 1 << 1
+_VENDOR_F_VH_CALLED = 1 << 2
+_VENDOR_F_VH_HANDLED = 1 << 3
+_VENDOR_F_RVH_RETURN_UPTODATE = 1 << 4
+_VENDOR_F_RVH_RETURN_LOCKED = 1 << 5
+_VENDOR_F_VH_RETURN_UPTODATE = 1 << 6
+_VENDOR_F_VH_RETURN_LOCKED = 1 << 7
+_VENDOR_F_WAIT_VALID = 1 << 8
+_VENDOR_F_RVH_SCHED_VALID = 1 << 9
+_VENDOR_F_RVH_RUN_DELAY_VALID = 1 << 10
+_VENDOR_F_RVH_COUNTER_OVERFLOW = 1 << 11
+_VENDOR_KNOWN_FLAGS = (1 << 12) - 1
+
+_SWAPOUT_HELPERS = {
+    0: "none",
+    1: "fs_ops",
+    2: "bdev_sync",
+    3: "bdev_async",
+}
+_SWAPOUT_SUBMIT_STATES = {
+    0: "none",
+    1: "sync_active",
+    2: "sync_returned",
+    3: "async_active",
+    4: "async_returned_pending",
+    5: "async_endio_before_return_marker",
+    6: "async_endio_after_return_marker",
+}
+
+_SWAPOUT_E_HOOK_ENABLED = 1 << 0
+_SWAPOUT_E_HOOK_FLAGS_CHANGED = 1 << 1
+_SWAPOUT_E_QUEUE_SYNCHRONOUS = 1 << 2
+_SWAPOUT_E_BDEV_HAS_SUBMIT_BIO = 1 << 3
+_SWAPOUT_E_COMPLETION_IN_TASK = 1 << 4
+_SWAPOUT_E_COMPLETION_IN_SOFTIRQ = 1 << 5
+_SWAPOUT_E_STATE_ERROR = 1 << 6
+_SWAPOUT_E_KNOWN_FLAGS = (1 << 7) - 1
+
+_VM_FAULT_MAJOR = 0x000004
+_VM_FAULT_RETRY = 0x000400
+_SWP_FS_OPS = 1 << 8
+_SWP_SYNCHRONOUS_IO = 1 << 12
+
+_PATH_FLAGS = (
+    ("cache_hit", _F_CACHE_HIT),
+    ("cache_miss", _F_CACHE_MISS),
+    ("cache_inflight", _F_CACHE_INFLIGHT),
+    ("vendor_bypass", _F_VENDOR_BYPASS),
+    ("zswap", _F_ZSWAP),
+    ("no_io", _F_NO_IO),
+    ("untracked_io", _F_UNTRACKED_IO),
+    ("retry", _F_RETRY),
+    ("bio", _F_BIO),
+)
+
+# Keep _PATH_FLAGS unchanged: it defines the original public path-accounting
+# fields.  The richer combination below is used only by the new latency view.
+# Direction (swap-in/swap-out) is already a parent JSON key, so READ/WRITE and
+# validity bits are intentionally omitted from the combination name.
+_LATENCY_COMBINATION_FLAGS = (
+    ("cache_hit", _F_CACHE_HIT),
+    ("cache_miss", _F_CACHE_MISS),
+    ("cache_inflight", _F_CACHE_INFLIGHT),
+    ("vendor_bypass", _F_VENDOR_BYPASS),
+    ("zswap", _F_ZSWAP),
+    ("free_swap", _F_FREE_SWAP),
+    ("arch_error", _F_ARCH_ERROR),
+    ("fs_ops", _F_FS_OPS),
+    ("bio", _F_BIO),
+    ("no_io", _F_NO_IO),
+    ("untracked_io", _F_UNTRACKED_IO),
+    ("sync_bio", _F_SYNC),
+    ("async_bio", _F_ASYNC),
+    ("direct", _F_DIRECT),
+    ("bdev", _F_BDEV),
+    ("backend_zram", _F_ZRAM),
+    ("backend_swapfile", _F_SWAPFILE),
+    ("backend_block_device", _F_BLOCK_DEVICE),
+    ("retry", _F_RETRY),
+    ("error", _F_ERROR),
+)
+
+_LATENCY_FAMILIES = ("call", "kernel", "device")
+# ZEST's per-bio view also exposes submit_bio() duration.  Keep this separate
+# from the legacy family tuple so existing JSON and consumers do not change.
+_ZEST_LATENCY_FAMILIES = ("call", "kernel", "submit", "device")
+_LATENCY_PERCENTILES = (50, 75, 90, 95, 99, 99.9, 99.99, 99.999, 99.9999)
+_LATENCY_BUCKETS_MS = (
+    0.1,
+    0.25,
+    0.5,
+    1.0,
+    2.0,
+    5.0,
+    10.0,
+    20.0,
+    50.0,
+    100.0,
+    250.0,
+    500.0,
+    1000.0,
+)
+_LATENCY_TAIL_THRESHOLDS_MS = (1.0, 10.0, 100.0)
+_VENDOR_STATE_LATENCY_PHASES = (
+    "handled_hook_total",
+    "post_hook_folio_lock",
+    "vendor_end_to_end",
+)
+_VENDOR_HANDLED_STATES = ("complete_unlocked", "pending", "unknown")
+_SWAPOUT_LIFECYCLE_LATENCY_PHASES = (
+    "submit_call",
+    "post_submit_return_completion",
+)
+
+# The per-record swap-in correlation view is the single home for vendor hook
+# phase distributions.  rvh_hook is the primary synchronous vendor interval;
+# the remaining phases are auxiliary whole-path views.  Each phase pairs its
+# hook samples with the do_swap_page call latency of exactly the records that
+# carry that valid phase, plus the ratio 100*phase_ns/call_ns.
+_SWAPIN_JOINT_HOOK_PHASES = (
+    "rvh_hook",
+    "vh_hook",
+    "all_hook_chain",
+    "handled_hook_total",
+    "post_hook_folio_lock",
+    "vendor_end_to_end",
+)
+_SWAPIN_RATIO_BUCKETS_PERCENT = (
+    0.0,
+    1.0,
+    5.0,
+    10.0,
+    25.0,
+    50.0,
+    75.0,
+    90.0,
+    100.0,
+    200.0,
+)
+_SWAPIN_RATIO_TAIL_THRESHOLDS_PERCENT = (1.0, 10.0, 25.0, 50.0, 100.0)
+
+# Scheduling-impact decomposition of v3 root-call and RVH intervals.
+_SCHED_COMPONENTS = (
+    "wall",
+    "task_runtime",
+    "non_task_or_irq",
+    "runqueue_wait",
+    "blocked_or_unaccounted",
+)
+_SCHED_RATIO_COMPONENTS = _SCHED_COMPONENTS[1:]
+_SCHED_PARTITION_COMPONENTS = (
+    "task_runtime",
+    "runqueue_wait",
+    "blocked_or_unaccounted",
+)
+_SCHED_CS_BUCKETS = ("0", "1", "2", "3_5", "6_plus")
+_SCHED_SWITCH_CLASSES = (
+    "no_switch",
+    "voluntary_only",
+    "involuntary_only",
+    "both",
+)
+_SCHED_SWITCH_CLASS_CODES = {
+    name: index for index, name in enumerate(_SCHED_SWITCH_CLASSES)
+}
+_SCHED_INVALID_SWITCH_CLASS = 0xFF
+_SCHED_INVALID_RUNQUEUE_NS = (1 << 64) - 1
+_SCHED_INVALID_COMPONENT_NS = (1 << 64) - 1
+_SCHED_FIXED_TAIL_MS = (1.0, 10.0, 100.0)
+_SCHED_DYNAMIC_TAIL_PERCENTILES = (99.0, 99.9, 99.99)
+
+# State of the type-tail RVH evidence retained by the root/RVH joint view.
+# NOT_CALLED is a resolved state only when the current v1 extension is valid;
+# an absent, malformed, or inconsistent extension remains unresolved.
+_RVH_JOINT_EXTENSION_UNRESOLVED = 0
+_RVH_JOINT_NOT_CALLED = 1
+_RVH_JOINT_CALLED_INTERVAL_INVALID = 2
+_RVH_JOINT_CALLED_INTERVAL_VALID = 3
+_RVH_JOINT_STATES = {
+    _RVH_JOINT_EXTENSION_UNRESOLVED: "extension_unresolved",
+    _RVH_JOINT_NOT_CALLED: "not_called",
+    _RVH_JOINT_CALLED_INTERVAL_INVALID: "called_interval_invalid",
+    _RVH_JOINT_CALLED_INTERVAL_VALID: "called_interval_valid",
+}
+_RVH_CONTRIBUTION_BUCKETS = (
+    "zero",
+    "gt_0_le_10_percent",
+    "gt_10_lt_50_percent",
+    "ge_50_lt_80_percent",
+    "ge_80_percent",
+)
+
+_RECORD_BATCH_COUNT = 65536
+
+
+if (
+    _HEADER_LE.size != 256
+    or _RECORD_LE.size != 320
+    or _SWAPIN_EXT_LE.size != 56
+    or _SWAPOUT_EXT_LE.size != 56
+):
+    raise RuntimeError(
+        "SWPLAT layout mismatch: "
+        f"header={_HEADER_LE.size}, record_v3={_RECORD_LE.size}, "
+        f"swapin_ext={_SWAPIN_EXT_LE.size}, "
+        f"swapout_ext={_SWAPOUT_EXT_LE.size}"
+    )
+
+
+def _parse_nonnegative_int(value: str) -> int:
+    try:
+        parsed = int(value, 0)
+    except ValueError as exc:
+        raise argparse.ArgumentTypeError(f"不是整数: {value!r}") from exc
+    if parsed < 0:
+        raise argparse.ArgumentTypeError(f"必须是非负整数: {value!r}")
+    return parsed
+
+
+def _percentage(count: int, total: int) -> float:
+    if not total:
+        return 0.0
+    return round(count * 100.0 / total, 6)
+
+
+def _decode_comm(raw: bytes) -> str:
+    return raw.split(b"\0", 1)[0].decode("utf-8", errors="replace")
+
+
+def _record_matches_filters(
+    record: tuple,
+    tgids: Set[int],
+    pids: Set[int],
+    comms: Set[str],
+) -> bool:
+    if tgids and record[22] not in tgids:
+        return False
+    if pids and record[21] not in pids:
+        return False
+    if comms and _decode_comm(record[31]) not in comms:
+        return False
+    return True
+
+
+def _decode_swapin_extension(record: tuple, endian_name: str) -> dict:
+    """Decode the optional 56-byte vendor read-hook extension.
+
+    The extension is deliberately best-effort: a bad extension must not make
+    an otherwise valid root swap record disappear from the legacy accounting.
+    Individual invalid intervals are omitted from latency samples and exposed
+    through the returned quality booleans.
+    """
+    version = record[33]
+    if version == 0:
+        return {"present": False, "version": 0}
+    if version != _VENDOR_EXT_VERSION:
+        return {
+            "present": True,
+            "version": version,
+            "unknown_version": True,
+        }
+
+    ext_struct = (
+        _SWAPIN_EXT_LE if endian_name == "little" else _SWAPIN_EXT_BE
+    )
+    try:
+        (
+            rvh_begin,
+            rvh_end,
+            vh_begin,
+            vh_end,
+            wait_begin,
+            wait_end,
+            vendor_flags,
+            _reserved,
+        ) = ext_struct.unpack(record[34])
+    except struct.error:
+        return {
+            "present": True,
+            "version": version,
+            "malformed": True,
+        }
+
+    unknown_flags = vendor_flags & ~_VENDOR_KNOWN_FLAGS
+    invalid_timestamp = False
+    negative_intervals = set()
+    flag_consistency_error = False
+    rvh_flag_consistency_error = False
+
+    def decode_interval(name: str, begin: int, end: int, valid: bool):
+        nonlocal invalid_timestamp
+        if not valid:
+            return None
+        if end < begin:
+            negative_intervals.add(name)
+            invalid_timestamp = True
+            return None
+        if (
+            begin == 0
+            or begin < record[7]
+            or end > record[8]
+        ):
+            invalid_timestamp = True
+            return None
+        return end - begin
+
+    rvh_called = bool(vendor_flags & _VENDOR_F_RVH_CALLED)
+    rvh_handled = bool(vendor_flags & _VENDOR_F_RVH_HANDLED)
+    vh_called = bool(vendor_flags & _VENDOR_F_VH_CALLED)
+    vh_handled = bool(vendor_flags & _VENDOR_F_VH_HANDLED)
+    wait_valid = bool(vendor_flags & _VENDOR_F_WAIT_VALID)
+
+    if (rvh_handled and not rvh_called) or (vh_handled and not vh_called):
+        flag_consistency_error = True
+        if rvh_handled and not rvh_called:
+            rvh_flag_consistency_error = True
+    if not rvh_called and vendor_flags & (
+        _VENDOR_F_RVH_RETURN_UPTODATE | _VENDOR_F_RVH_RETURN_LOCKED
+    ):
+        flag_consistency_error = True
+        rvh_flag_consistency_error = True
+    if not vh_called and vendor_flags & (
+        _VENDOR_F_VH_RETURN_UPTODATE | _VENDOR_F_VH_RETURN_LOCKED
+    ):
+        flag_consistency_error = True
+    if not rvh_called and (rvh_begin or rvh_end):
+        flag_consistency_error = True
+        rvh_flag_consistency_error = True
+    if not rvh_called and vendor_flags & (
+        _VENDOR_F_RVH_SCHED_VALID
+        | _VENDOR_F_RVH_RUN_DELAY_VALID
+        | _VENDOR_F_RVH_COUNTER_OVERFLOW
+    ):
+        flag_consistency_error = True
+        rvh_flag_consistency_error = True
+    if (
+        vendor_flags & _VENDOR_F_RVH_RUN_DELAY_VALID
+        and not vendor_flags & _VENDOR_F_RVH_SCHED_VALID
+    ):
+        flag_consistency_error = True
+        rvh_flag_consistency_error = True
+    if (
+        vendor_flags & _VENDOR_F_RVH_COUNTER_OVERFLOW
+        and not vendor_flags & _VENDOR_F_RVH_SCHED_VALID
+    ):
+        flag_consistency_error = True
+        rvh_flag_consistency_error = True
+    if not vh_called and (vh_begin or vh_end):
+        flag_consistency_error = True
+    if not wait_valid and (wait_begin or wait_end):
+        flag_consistency_error = True
+
+    rvh_interval = decode_interval(
+        "rvh_hook", rvh_begin, rvh_end, rvh_called
+    )
+    vh_interval = decode_interval(
+        "vh_hook", vh_begin, vh_end, vh_called
+    )
+    wait_interval = decode_interval(
+        "post_hook_folio_lock", wait_begin, wait_end, wait_valid
+    )
+
+    handled_intervals = []
+    if rvh_handled and rvh_interval is not None:
+        handled_intervals.append((rvh_begin, rvh_end))
+    if vh_handled and vh_interval is not None:
+        handled_intervals.append((vh_begin, vh_end))
+    handled_interval_invalid = (
+        (rvh_handled and rvh_interval is None)
+        or (vh_handled and vh_interval is None)
+    )
+    handled_total = None
+    if handled_intervals and not handled_interval_invalid:
+        handled_total = (
+            max(end for _begin, end in handled_intervals)
+            - min(begin for begin, _end in handled_intervals)
+        )
+
+    hook_intervals = []
+    if rvh_interval is not None:
+        hook_intervals.append((rvh_begin, rvh_end))
+    if vh_interval is not None:
+        hook_intervals.append((vh_begin, vh_end))
+
+    hook_order_invalid = False
+    if rvh_interval is not None and vh_interval is not None:
+        if vh_begin < rvh_end:
+            invalid_timestamp = True
+            hook_order_invalid = True
+
+    all_hook_chain = None
+    called_interval_invalid = (
+        (rvh_called and rvh_interval is None)
+        or (vh_called and vh_interval is None)
+    )
+    if (
+        hook_intervals
+        and not hook_order_invalid
+        and not called_interval_invalid
+    ):
+        all_hook_chain = (
+            max(end for _begin, end in hook_intervals)
+            - min(begin for begin, _end in hook_intervals)
+        )
+
+    wait_order_invalid = False
+    if wait_interval is not None and hook_intervals:
+        if wait_begin < max(end for _begin, end in hook_intervals):
+            invalid_timestamp = True
+            wait_order_invalid = True
+
+    # End-to-end is intentionally a handled-path metric.  An unhandled RVH
+    # followed by a handled VH remains visible in all_hook_chain, while this
+    # interval begins at the callback that actually took ownership and extends
+    # through the post-hook folio wait when one was recorded.
+    end_to_end = None
+    if handled_intervals and not handled_interval_invalid:
+        handled_begin = min(begin for begin, _end in handled_intervals)
+        handled_end = max(end for _begin, end in handled_intervals)
+        if wait_valid:
+            if wait_interval is not None and not wait_order_invalid:
+                handled_end = wait_end
+            else:
+                handled_end = None
+        if handled_end is not None:
+            end_to_end = handled_end - handled_begin
+
+    rvh_uptodate = bool(vendor_flags & _VENDOR_F_RVH_RETURN_UPTODATE)
+    rvh_locked = bool(vendor_flags & _VENDOR_F_RVH_RETURN_LOCKED)
+    vh_uptodate = bool(vendor_flags & _VENDOR_F_VH_RETURN_UPTODATE)
+    vh_locked = bool(vendor_flags & _VENDOR_F_VH_RETURN_LOCKED)
+
+    # The explicit called argument avoids treating a stray return bit as a
+    # successful handled callback while still reporting its inconsistency.
+    rvh_state = (
+        "not_handled"
+        if not rvh_handled
+        else (
+            "unknown"
+            if not rvh_called
+            else (
+                "complete_unlocked"
+                if rvh_uptodate and not rvh_locked
+                else "pending"
+            )
+        )
+    )
+    vh_state = (
+        "not_handled"
+        if not vh_handled
+        else (
+            "unknown"
+            if not vh_called
+            else (
+                "complete_unlocked"
+                if vh_uptodate and not vh_locked
+                else "pending"
+            )
+        )
+    )
+
+    handled_states = [
+        state
+        for state in (rvh_state, vh_state)
+        if state != "not_handled"
+    ]
+    if not handled_states:
+        overall_handled_state = "none"
+    elif "unknown" in handled_states:
+        overall_handled_state = "unknown"
+    elif "pending" in handled_states:
+        overall_handled_state = "pending"
+    else:
+        overall_handled_state = "complete_unlocked"
+
+    return {
+        "present": True,
+        "version": version,
+        "flags": vendor_flags,
+        "unknown_flags": unknown_flags,
+        "negative_intervals": sorted(negative_intervals),
+        "rvh_called": rvh_called,
+        "rvh_handled": rvh_handled,
+        "vh_called": vh_called,
+        "vh_handled": vh_handled,
+        "wait_valid": wait_valid,
+        "rvh_interval_ns": rvh_interval,
+        "vh_interval_ns": vh_interval,
+        "all_hook_chain_ns": all_hook_chain,
+        "handled_total_ns": handled_total,
+        "wait_interval_ns": wait_interval,
+        "end_to_end_ns": end_to_end,
+        "rvh_state": rvh_state,
+        "vh_state": vh_state,
+        "rvh_return_uptodate": rvh_uptodate,
+        "rvh_return_locked": rvh_locked,
+        "vh_return_uptodate": vh_uptodate,
+        "vh_return_locked": vh_locked,
+        "overall_handled_state": overall_handled_state,
+        "invalid_timestamp": invalid_timestamp,
+        "flag_consistency_error": flag_consistency_error,
+        "rvh_flag_consistency_error": rvh_flag_consistency_error,
+    }
+
+
+def _decode_swapout_extension(record: tuple, endian_name: str) -> dict:
+    """Decode swap-out type-tail extension v2 inside a raw-v3 record.
+
+    A missing payload or a swap-in type-tail version does not invalidate the
+    root record.  Extension-only metrics remain unavailable and mode evidence
+    falls back to the diagnostic record.sis_flags snapshot.
+    """
+    version = record[33]
+    if version in (0, _VENDOR_EXT_VERSION):
+        return {"present": False, "version": version}
+    if version != _SWAPOUT_EXT_VERSION:
+        return {
+            "present": True,
+            "version": version,
+            "unknown_version": True,
+        }
+
+    ext_struct = (
+        _SWAPOUT_EXT_LE if endian_name == "little" else _SWAPOUT_EXT_BE
+    )
+    try:
+        (
+            hook_begin_ns,
+            hook_end_ns,
+            flags_before,
+            flags_after,
+            helper_begin_ns,
+            helper,
+            submit_state,
+            submit_return_cpu,
+            evidence_flags,
+        ) = ext_struct.unpack(record[34])
+    except struct.error:
+        return {
+            "present": True,
+            "version": version,
+            "malformed": True,
+        }
+
+    hook_enabled = bool(evidence_flags & _SWAPOUT_E_HOOK_ENABLED)
+    hook_probed = bool(hook_begin_ns or hook_end_ns)
+    flags_changed = bool(
+        evidence_flags & _SWAPOUT_E_HOOK_FLAGS_CHANGED
+    )
+    unknown_evidence = evidence_flags & ~_SWAPOUT_E_KNOWN_FLAGS
+    helper_name = _SWAPOUT_HELPERS.get(helper, f"unknown_{helper}")
+    submit_state_name = _SWAPOUT_SUBMIT_STATES.get(
+        submit_state, f"unknown_{submit_state}"
+    )
+    invalid_timestamp = False
+    flag_consistency_error = False
+    helper_consistency_error = False
+    state_consistency_error = False
+
+    hook_interval_ns = None
+    if hook_probed:
+        if (
+            hook_begin_ns == 0
+            or hook_end_ns == 0
+            or hook_end_ns < hook_begin_ns
+            or hook_begin_ns < record[7]
+            or hook_end_ns > record[8]
+        ):
+            invalid_timestamp = True
+        else:
+            hook_interval_ns = hook_end_ns - hook_begin_ns
+    elif flags_before or flags_after:
+        flag_consistency_error = True
+    if hook_enabled and not hook_probed:
+        flag_consistency_error = True
+
+    if flags_changed != (flags_before != flags_after):
+        flag_consistency_error = True
+
+    if helper in _SWAPOUT_HELPERS:
+        if helper == 0:
+            if helper_begin_ns:
+                helper_consistency_error = True
+        elif (
+            helper_begin_ns == 0
+            or helper_begin_ns < record[7]
+            or helper_begin_ns > record[8]
+        ):
+            invalid_timestamp = True
+            helper_consistency_error = True
+        elif hook_interval_ns is not None and helper_begin_ns < hook_end_ns:
+            invalid_timestamp = True
+            helper_consistency_error = True
+        if (helper == 0) == hook_probed:
+            helper_consistency_error = True
+
+    flags = record[3]
+    if helper == 0:
+        if submit_state != 0 or flags & _F_BIO:
+            helper_consistency_error = True
+    elif helper == 1:
+        if (
+            submit_state != 0
+            or not (flags & _F_FS_OPS)
+            or not (flags_after & _SWP_FS_OPS)
+        ):
+            helper_consistency_error = True
+    elif helper == 2:
+        if (
+            submit_state not in (1, 2)
+            or not (flags & _F_BIO)
+            or not (flags & _F_SYNC)
+            or flags & _F_ASYNC
+            or flags_after & _SWP_FS_OPS
+            or not (flags_after & _SWP_SYNCHRONOUS_IO)
+        ):
+            helper_consistency_error = True
+    elif helper == 3:
+        if (
+            submit_state not in (3, 4, 5, 6)
+            or not (flags & _F_BIO)
+            or not (flags & _F_ASYNC)
+            or flags & _F_SYNC
+            or flags_after & (
+                _SWP_FS_OPS | _SWP_SYNCHRONOUS_IO
+            )
+        ):
+            helper_consistency_error = True
+
+    # Active/pending states should not survive until record publication: the
+    # root reference and asynchronous BIO reference are both released first.
+    if submit_state in (1, 3, 4):
+        state_consistency_error = True
+    if evidence_flags & _SWAPOUT_E_STATE_ERROR:
+        state_consistency_error = True
+    if (
+        evidence_flags & _SWAPOUT_E_COMPLETION_IN_TASK
+        and evidence_flags & _SWAPOUT_E_COMPLETION_IN_SOFTIRQ
+    ):
+        state_consistency_error = True
+    if submit_state in (5, 6) and not (flags & _F_DEVICE_VALID):
+        state_consistency_error = True
+    if submit_state in (2, 5, 6) and not (flags & _F_SUBMIT_VALID):
+        state_consistency_error = True
+    if submit_state == 2 and not (flags & _F_DEVICE_VALID):
+        state_consistency_error = True
+    if submit_state not in (5, 6) and evidence_flags & (
+        _SWAPOUT_E_COMPLETION_IN_TASK |
+        _SWAPOUT_E_COMPLETION_IN_SOFTIRQ
+    ):
+        state_consistency_error = True
+    if submit_state not in _SWAPOUT_SUBMIT_STATES:
+        state_consistency_error = True
+
+    return {
+        "present": True,
+        "version": version,
+        "hook_begin_ns": hook_begin_ns,
+        "hook_end_ns": hook_end_ns,
+        "hook_interval_ns": hook_interval_ns,
+        "flags_before": flags_before,
+        "flags_after": flags_after,
+        "helper_begin_ns": helper_begin_ns,
+        "helper": helper,
+        "helper_name": helper_name,
+        "submit_state": submit_state,
+        "submit_state_name": submit_state_name,
+        "submit_return_cpu": submit_return_cpu,
+        "evidence_flags": evidence_flags,
+        "unknown_evidence_flags": unknown_evidence,
+        "hook_probed": hook_probed,
+        "hook_enabled": hook_enabled,
+        "flags_changed": flags_changed,
+        "queue_synchronous": bool(
+            evidence_flags & _SWAPOUT_E_QUEUE_SYNCHRONOUS
+        ),
+        "bdev_has_submit_bio": bool(
+            evidence_flags & _SWAPOUT_E_BDEV_HAS_SUBMIT_BIO
+        ),
+        "completion_in_task": bool(
+            evidence_flags & _SWAPOUT_E_COMPLETION_IN_TASK
+        ),
+        "completion_in_softirq": bool(
+            evidence_flags & _SWAPOUT_E_COMPLETION_IN_SOFTIRQ
+        ),
+        "state_error_flag": bool(
+            evidence_flags & _SWAPOUT_E_STATE_ERROR
+        ),
+        "unknown_helper": helper not in _SWAPOUT_HELPERS,
+        "unknown_submit_state": (
+            submit_state not in _SWAPOUT_SUBMIT_STATES
+        ),
+        "invalid_timestamp": invalid_timestamp,
+        "flag_consistency_error": flag_consistency_error,
+        "helper_consistency_error": helper_consistency_error,
+        "state_consistency_error": state_consistency_error,
+    }
+
+
+def _active_path_names(flags: int) -> List[str]:
+    return [name for name, mask in _PATH_FLAGS if flags & mask]
+
+
+def _latency_combination_name(flags: int) -> str:
+    names = [
+        name
+        for name, mask in _LATENCY_COMBINATION_FLAGS
+        if flags & mask
+    ]
+    return "+".join(names) if names else "none"
+
+
+def _io_mode_name(flags: int) -> str:
+    is_sync = bool(flags & _F_SYNC)
+    is_async = bool(flags & _F_ASYNC)
+    if is_sync and is_async:
+        return "both"
+    if is_sync:
+        return "sync"
+    if is_async:
+        return "async"
+    return "neither"
+
+
+def _account_swapout_mode_evidence(
+    record: tuple,
+    flags: int,
+    extension: dict,
+    counts: Counter,
+) -> None:
+    if (
+        extension.get("present")
+        and extension.get("version") == _SWAPOUT_EXT_VERSION
+        and not extension.get("malformed")
+        and extension.get("hook_interval_ns") is not None
+    ):
+        original_flags = extension["flags_before"]
+        source = "extension_v2_flags_before"
+    else:
+        original_flags = record[27]
+        source = "record_sis_flags_fallback"
+    original_mode = (
+        "sync"
+        if original_flags & _SWP_SYNCHRONOUS_IO
+        else "not_sync"
+    )
+    actual_mode = _io_mode_name(flags)
+    counts["overall"] += 1
+    counts[f"source_{source}"] += 1
+    counts[f"original_{original_mode}"] += 1
+    counts[f"actual_{actual_mode}"] += 1
+    counts[f"original_{original_mode}_actual_{actual_mode}"] += 1
+
+
+def _finalize_swapout_mode_evidence(counts: Counter) -> dict:
+    overall = counts["overall"]
+    cross_accounting = {
+        f"original_{original}_actual_{actual}": counts[
+            f"original_{original}_actual_{actual}"
+        ]
+        for original in ("sync", "not_sync")
+        for actual in ("sync", "async", "both", "neither")
+    }
+    key_evidence = counts["original_sync_actual_async"]
+    return {
+        "overall": overall,
+        "pre_hook_flags_source": {
+            "extension_v2_flags_before": counts[
+                "source_extension_v2_flags_before"
+            ],
+            "record_sis_flags_fallback": counts[
+                "source_record_sis_flags_fallback"
+            ],
+        },
+        "original_sis_flags": {
+            "synchronous_io": counts["original_sync"],
+            "not_synchronous_io": counts["original_not_sync"],
+        },
+        "actual_bio_mode": {
+            mode: counts[f"actual_{mode}"]
+            for mode in ("sync", "async", "both", "neither")
+        },
+        "cross_accounting": cross_accounting,
+        "original_sync_actual_async": key_evidence,
+        "original_sync_actual_async_percent_of_swapout": _percentage(
+            key_evidence, overall
+        ),
+    }
+
+
+def _new_latency_samples() -> Dict[str, array]:
+    # array('Q') uses eight bytes per sample instead of retaining millions of
+    # boxed Python integers while exact percentiles are calculated.
+    return {family: array("Q") for family in _LATENCY_FAMILIES}
+
+
+def _new_zest_record_group() -> dict:
+    """Create accumulators for one ZEST record layer.
+
+    ``io_bytes`` is always the explicit ``record.io_bytes`` field.  For the
+    staging layer this is normally zero because the original swap call has no
+    bio; ``nr_pages`` remains useful as the logical amount staged.  For a
+    flush/read bio, ``io_bytes`` is the actual aggregate bio size.
+    """
+    return {
+        "record_count": 0,
+        "io_bytes": 0,
+        "min_io_bytes": None,
+        "max_io_bytes": 0,
+        "nr_pages": 0,
+        "error_records": 0,
+        "untracked_records": 0,
+        "submit_valid_records": 0,
+        "device_valid_records": 0,
+        "invalid_kernel_records": 0,
+        "invalid_device_records": 0,
+        "latency_samples": {
+            family: array("Q") for family in _ZEST_LATENCY_FAMILIES
+        },
+    }
+
+
+def _is_zest_flush_record(record: tuple, flags: int) -> bool:
+    """Return whether a record carries the explicit ZEST flush marker."""
+    return record[2] == _TYPE_SWAPOUT and bool(flags & _F_ZEST_FLUSH)
+
+
+def _is_zest_staging_record(record: tuple, flags: int) -> bool:
+    """Identify the deferred logical ZEST swap-out record.
+
+    There is deliberately no separate staging bit in the v3 record format.
+    The current kernel marks the early-ack ZEST root record as an untracked
+    block-device operation.  Requiring the backend enum as well as both flags
+    avoids classifying FS_OPS/zswap records that also use UNTRACKED_IO.  The
+    explicit ZEST_FLUSH bit wins over this heuristic for worker records.
+    """
+    return (
+        record[2] == _TYPE_SWAPOUT
+        and not _is_zest_flush_record(record, flags)
+        and bool(flags & _F_UNTRACKED_IO)
+        and bool(flags & _F_BLOCK_DEVICE)
+        and not bool(flags & _F_BIO)
+        and record[25] == _BACKEND_BLOCK_DEVICE
+    )
+
+
+def _is_block_device_swapin_record(record: tuple, flags: int) -> bool:
+    """Return whether a swap-in record describes a real device-backed bio.
+
+    ZEST is installed by F2FS as a regular swapfile.  In that configuration
+    the root record keeps the normal ``SWAPFILE|BDEV`` backend classification,
+    even though the intercepted read is submitted to the underlying block
+    device.  A raw block-device swap area instead uses ``BLOCK_DEVICE|BDEV``;
+    accept both forms here and let the second-pass device correlation decide
+    whether a candidate belongs to ZEST.
+    """
+    return (
+        record[2] == _TYPE_SWAPIN
+        and bool(flags & _F_READ)
+        and bool(flags & _F_BIO)
+        and bool(flags & _F_BDEV)
+        and (
+            (
+                bool(flags & _F_BLOCK_DEVICE)
+                and record[25] == _BACKEND_BLOCK_DEVICE
+            )
+            or (
+                bool(flags & _F_SWAPFILE)
+                and record[25] == _BACKEND_SWAPFILE
+            )
+        )
+    )
+
+
+def _account_zest_record(record: tuple, flags: int, group: dict) -> None:
+    """Account one selected record in a ZEST layer."""
+    group["record_count"] += 1
+    io_bytes = record[16]
+    group["io_bytes"] += io_bytes
+    if group["min_io_bytes"] is None:
+        group["min_io_bytes"] = io_bytes
+    else:
+        group["min_io_bytes"] = min(group["min_io_bytes"], io_bytes)
+    group["max_io_bytes"] = max(group["max_io_bytes"], io_bytes)
+    group["nr_pages"] += record[28]
+    if record[20] != 0 or flags & _F_ERROR:
+        group["error_records"] += 1
+    if flags & _F_UNTRACKED_IO:
+        group["untracked_records"] += 1
+
+    submit_begin_ns = record[10]
+    submit_end_ns = record[11]
+    if flags & _F_SUBMIT_VALID and submit_begin_ns != 0:
+        if submit_end_ns >= submit_begin_ns:
+            group["submit_valid_records"] += 1
+            group["latency_samples"]["submit"].append(
+                submit_end_ns - submit_begin_ns
+            )
+
+    call_ns = record[8] - record[7]
+    group["latency_samples"]["call"].append(call_ns)
+
+    kernel_ns = record[9]
+    if kernel_ns <= call_ns:
+        group["latency_samples"]["kernel"].append(kernel_ns)
+    else:
+        group["invalid_kernel_records"] += 1
+
+    if flags & _F_DEVICE_VALID:
+        device_begin_ns = record[12]
+        device_end_ns = record[13]
+        if device_begin_ns != 0 and device_end_ns >= device_begin_ns:
+            group["device_valid_records"] += 1
+            group["latency_samples"]["device"].append(
+                device_end_ns - device_begin_ns
+            )
+        else:
+            group["invalid_device_records"] += 1
+
+
+def _merge_zest_record_groups(groups: List[dict]) -> dict:
+    """Merge groups accumulated per device into one public ZEST view."""
+    merged = _new_zest_record_group()
+    for group in groups:
+        for key in (
+            "record_count",
+            "io_bytes",
+            "nr_pages",
+            "error_records",
+            "untracked_records",
+            "submit_valid_records",
+            "device_valid_records",
+            "invalid_kernel_records",
+            "invalid_device_records",
+        ):
+            merged[key] += group[key]
+        if group["min_io_bytes"] is not None:
+            if merged["min_io_bytes"] is None:
+                merged["min_io_bytes"] = group["min_io_bytes"]
+            else:
+                merged["min_io_bytes"] = min(
+                    merged["min_io_bytes"], group["min_io_bytes"]
+                )
+            merged["max_io_bytes"] = max(
+                merged["max_io_bytes"], group["max_io_bytes"]
+            )
+        for family in _ZEST_LATENCY_FAMILIES:
+            merged["latency_samples"][family].extend(
+                group["latency_samples"][family]
+            )
+    return merged
+
+
+def _finalize_zest_record_group(group: dict) -> dict:
+    """Turn one internal ZEST accumulator into JSON-safe values."""
+    count = group["record_count"]
+    return {
+        "record_count": count,
+        "io_bytes": group["io_bytes"],
+        "min_io_bytes": (
+            group["min_io_bytes"] if group["min_io_bytes"] is not None else 0
+        ),
+        "max_io_bytes": group["max_io_bytes"] if count else 0,
+        "nr_pages": group["nr_pages"],
+        "average_io_bytes": round(
+            group["io_bytes"] / count, 6
+        ) if count else 0.0,
+        "error_records": group["error_records"],
+        "untracked_records": group["untracked_records"],
+        "submit_valid_records": group["submit_valid_records"],
+        "device_valid_records": group["device_valid_records"],
+        "invalid_kernel_records": group["invalid_kernel_records"],
+        "invalid_device_records": group["invalid_device_records"],
+        "latency": {
+            family: _latency_metric(
+                group["latency_samples"][family],
+                count,
+                coverage_name="coverage_percent_of_records",
+            )
+            for family in _ZEST_LATENCY_FAMILIES
+        },
+    }
+
+
+def _percentile(sorted_values: List[int], percent: float) -> float:
+    if not sorted_values:
+        return 0.0
+    if len(sorted_values) == 1:
+        return float(sorted_values[0])
+    rank = (len(sorted_values) - 1) * percent / 100.0
+    lower = math.floor(rank)
+    upper = math.ceil(rank)
+    if lower == upper:
+        return float(sorted_values[lower])
+    weight = rank - lower
+    return (
+        sorted_values[lower] * (1.0 - weight)
+        + sorted_values[upper] * weight
+    )
+
+
+def _latency_bucket_distribution(sorted_values: List[int]) -> dict:
+    total = len(sorted_values)
+    counts = []
+    previous_index = 0
+    for edge_ms in _LATENCY_BUCKETS_MS:
+        edge_ns = int(edge_ms * 1_000_000)
+        edge_index = bisect_right(sorted_values, edge_ns)
+        counts.append(edge_index - previous_index)
+        previous_index = edge_index
+    counts.append(total - previous_index)
+
+    labels = []
+    previous_edge = None
+    for edge_ms in _LATENCY_BUCKETS_MS:
+        if previous_edge is None:
+            labels.append(f"<= {edge_ms:g} ms")
+        else:
+            labels.append(
+                f"> {previous_edge:g} ms and <= {edge_ms:g} ms"
+            )
+        previous_edge = edge_ms
+    labels.append(f"> {_LATENCY_BUCKETS_MS[-1]:g} ms")
+
+    return {
+        label: {
+            "count": count,
+            "percent": _percentage(count, total),
+        }
+        for label, count in zip(labels, counts)
+    }
+
+
+def _tail_name(threshold_ms: float) -> str:
+    threshold_label = f"{threshold_ms:g}".replace(".", "_")
+    return f"gt_{threshold_label}ms"
+
+
+def _latency_tail_counts(sorted_values: List[int]) -> dict:
+    total = len(sorted_values)
+    tails = {}
+    for threshold_ms in _LATENCY_TAIL_THRESHOLDS_MS:
+        threshold_ns = int(threshold_ms * 1_000_000)
+        count = total - bisect_right(sorted_values, threshold_ns)
+        tails[_tail_name(threshold_ms)] = {
+            "count": count,
+            "percent_of_metric_samples": _percentage(count, total),
+        }
+    return tails
+
+
+def _percentile_key(percent: float) -> str:
+    return f"p{str(percent).replace('.', '_')}"
+
+
+def _empty_percentile_dict() -> dict:
+    return {
+        _percentile_key(percent): 0.0 for percent in _LATENCY_PERCENTILES
+    }
+
+
+def _latency_metric(
+    values_ns: array,
+    record_count: int,
+    coverage_name: str = "coverage_percent_of_combination",
+) -> dict:
+    sorted_values = sorted(values_ns)
+    count = len(sorted_values)
+    if not count:
+        return {
+            "count": 0,
+            coverage_name: 0.0,
+            "average_ms": 0.0,
+            "min_ms": 0.0,
+            "max_ms": 0.0,
+            "percentiles_ms": _empty_percentile_dict(),
+            "bucket_distribution": _latency_bucket_distribution([]),
+            "tail_counts": _latency_tail_counts([]),
+        }
+
+    percentile_values = {}
+    for percent in _LATENCY_PERCENTILES:
+        percentile_values[_percentile_key(percent)] = round(
+            _percentile(sorted_values, percent) / 1_000_000.0,
+            6,
+        )
+    return {
+        "count": count,
+        coverage_name: _percentage(count, record_count),
+        "average_ms": round(
+            sum(sorted_values) / count / 1_000_000.0,
+            6,
+        ),
+        "min_ms": round(sorted_values[0] / 1_000_000.0, 6),
+        "max_ms": round(sorted_values[-1] / 1_000_000.0, 6),
+        "percentiles_ms": percentile_values,
+        "bucket_distribution": _latency_bucket_distribution(
+            sorted_values
+        ),
+        "tail_counts": _latency_tail_counts(sorted_values),
+    }
+
+
+def _ratio_bucket_distribution(sorted_values: List[float]) -> dict:
+    total = len(sorted_values)
+    counts = []
+    previous_index = 0
+    for edge in _SWAPIN_RATIO_BUCKETS_PERCENT:
+        edge_index = bisect_right(sorted_values, edge)
+        counts.append(edge_index - previous_index)
+        previous_index = edge_index
+    counts.append(total - previous_index)
+
+    labels = []
+    previous_edge = None
+    for edge in _SWAPIN_RATIO_BUCKETS_PERCENT:
+        if previous_edge is None:
+            labels.append(f"<= {edge:g}%")
+        else:
+            labels.append(f"> {previous_edge:g}% and <= {edge:g}%")
+        previous_edge = edge
+    labels.append(f"> {_SWAPIN_RATIO_BUCKETS_PERCENT[-1]:g}%")
+    return {
+        label: {
+            "count": count,
+            "percent": _percentage(count, total),
+        }
+        for label, count in zip(labels, counts)
+    }
+
+
+def _ratio_tail_name(threshold_percent: float) -> str:
+    return f"gt_{threshold_percent:g}_percent".replace(".", "_")
+
+
+def _ratio_tail_counts(sorted_values: List[float]) -> dict:
+    total = len(sorted_values)
+    return {
+        _ratio_tail_name(threshold): {
+            "count": total
+            - bisect_right(sorted_values, threshold),
+            "percent_of_ratio_samples": _percentage(
+                total - bisect_right(sorted_values, threshold), total
+            ),
+        }
+        for threshold in _SWAPIN_RATIO_TAIL_THRESHOLDS_PERCENT
+    }
+
+
+def _ratio_metric(
+    values: array,
+    record_count: int,
+    coverage_name: str = "coverage_percent_of_records",
+    unit: str = "percent_of_do_swap_page_call",
+) -> dict:
+    sorted_values = sorted(float(value) for value in values)
+    count = len(sorted_values)
+    if not count:
+        return {
+            "unit": unit,
+            "count": 0,
+            coverage_name: 0.0,
+            "average_percent": 0.0,
+            "average_ratio": 0.0,
+            "min_percent": 0.0,
+            "min_ratio": 0.0,
+            "max_percent": 0.0,
+            "max_ratio": 0.0,
+            "percentiles_percent": _empty_percentile_dict(),
+            "percentiles_ratio": _empty_percentile_dict(),
+            "bucket_distribution": _ratio_bucket_distribution([]),
+            "tail_counts": _ratio_tail_counts([]),
+        }
+
+    percentiles = {}
+    ratio_percentiles = {}
+    for percent in _LATENCY_PERCENTILES:
+        key = _percentile_key(percent)
+        value = _percentile(sorted_values, percent)
+        percentiles[key] = round(value, 6)
+        ratio_percentiles[key] = round(value / 100.0, 9)
+    average_percent = sum(sorted_values) / count
+    min_percent = sorted_values[0]
+    max_percent = sorted_values[-1]
+    return {
+        "unit": unit,
+        "count": count,
+        coverage_name: _percentage(count, record_count),
+        "average_percent": round(average_percent, 6),
+        "average_ratio": round(average_percent / 100.0, 9),
+        "min_percent": round(min_percent, 6),
+        "min_ratio": round(min_percent / 100.0, 9),
+        "max_percent": round(max_percent, 6),
+        "max_ratio": round(max_percent / 100.0, 9),
+        "percentiles_percent": percentiles,
+        "percentiles_ratio": ratio_percentiles,
+        "bucket_distribution": _ratio_bucket_distribution(sorted_values),
+        "tail_counts": _ratio_tail_counts(sorted_values),
+    }
+
+
+def _new_swapin_joint_group() -> dict:
+    return {
+        "record_count": 0,
+        "call_samples": array("Q"),
+        "hook_samples": {
+            phase: array("Q") for phase in _SWAPIN_JOINT_HOOK_PHASES
+        },
+        "paired_call_samples": {
+            phase: array("Q") for phase in _SWAPIN_JOINT_HOOK_PHASES
+        },
+        "ratio_samples": {
+            phase: array("d") for phase in _SWAPIN_JOINT_HOOK_PHASES
+        },
+        "counts": Counter(),
+        "ratio_excluded_by_phase": Counter(),
+    }
+
+
+def _account_swapin_joint_group(
+    record: tuple,
+    extension: dict,
+    group: dict,
+) -> None:
+    group["record_count"] += 1
+    call_ns = record[8] - record[7]
+    group["call_samples"].append(call_ns)
+    if call_ns == 0:
+        group["counts"]["zero_call_duration"] += 1
+
+    if (
+        not extension.get("present")
+        or extension.get("version") != _VENDOR_EXT_VERSION
+        or extension.get("malformed")
+    ):
+        group["counts"]["records_without_vendor_hook"] += 1
+        group["counts"]["no_valid_vendor_extension"] += 1
+        for phase in _SWAPIN_JOINT_HOOK_PHASES:
+            group["counts"][f"{phase}_missing_or_invalid"] += 1
+        return
+    group["counts"]["vendor_extension_v1"] += 1
+
+    phase_values = {
+        "rvh_hook": extension.get("rvh_interval_ns"),
+        "vh_hook": extension.get("vh_interval_ns"),
+        "all_hook_chain": extension.get("all_hook_chain_ns"),
+        "handled_hook_total": extension.get("handled_total_ns"),
+        "post_hook_folio_lock": extension.get("wait_interval_ns"),
+        "vendor_end_to_end": extension.get("end_to_end_ns"),
+    }
+    negative_phases = set(extension.get("negative_intervals", ()))
+    valid_phase_count = 0
+    for phase, hook_ns in phase_values.items():
+        if hook_ns is None:
+            if phase in negative_phases:
+                group["counts"][f"{phase}_negative"] += 1
+            else:
+                group["counts"][f"{phase}_missing_or_invalid"] += 1
+            continue
+        if hook_ns < 0:
+            group["counts"][f"{phase}_negative"] += 1
+            continue
+        valid_phase_count += 1
+        group["hook_samples"][phase].append(hook_ns)
+        group["paired_call_samples"][phase].append(call_ns)
+        if call_ns == 0:
+            group["ratio_excluded_by_phase"][phase] += 1
+            continue
+        ratio_percent = hook_ns * 100.0 / call_ns
+        if not math.isfinite(ratio_percent) or ratio_percent < 0:
+            group["counts"][f"{phase}_invalid_ratio"] += 1
+            continue
+        group["ratio_samples"][phase].append(ratio_percent)
+    if not valid_phase_count:
+        group["counts"]["records_without_vendor_hook"] += 1
+
+
+def _account_swapin_joint(
+    record: tuple,
+    extension: dict,
+    path_combination: str,
+    data: dict,
+) -> None:
+    _account_swapin_joint_group(record, extension, data["overall"])
+    if path_combination not in data["by_path_combination"]:
+        data["by_path_combination"][
+            path_combination
+        ] = _new_swapin_joint_group()
+    _account_swapin_joint_group(
+        record,
+        extension,
+        data["by_path_combination"][path_combination],
+    )
+
+
+def _finalize_swapin_joint_group(group: dict) -> dict:
+    count = group["record_count"]
+    counts = group["counts"]
+    paired_counts = {
+        phase: len(group["paired_call_samples"][phase])
+        for phase in _SWAPIN_JOINT_HOOK_PHASES
+    }
+    hook_latency = {
+        phase: _latency_metric(
+            group["hook_samples"][phase],
+            paired_counts[phase],
+            coverage_name="coverage_percent_of_paired_records",
+        )
+        for phase in _SWAPIN_JOINT_HOOK_PHASES
+    }
+    ratio_latency = {
+        phase: _ratio_metric(
+            group["ratio_samples"][phase],
+            paired_counts[phase],
+            coverage_name="coverage_percent_of_paired_records",
+        )
+        for phase in _SWAPIN_JOINT_HOOK_PHASES
+    }
+    for phase in _SWAPIN_JOINT_HOOK_PHASES:
+        hook_latency[phase]["coverage_percent_of_group_records"] = (
+            _percentage(
+                len(group["hook_samples"][phase]), count
+            )
+        )
+        ratio_latency[phase]["coverage_percent_of_group_records"] = (
+            _percentage(
+                len(group["ratio_samples"][phase]), count
+            )
+        )
+    invalidity = {
+        name: value
+        for name, value in sorted(counts.items())
+        if name != "vendor_extension_v1"
+    }
+    return {
+        "record_count": count,
+        "vendor_extension_v1_records": counts["vendor_extension_v1"],
+        "do_swap_page_call_latency_distribution": _latency_metric(
+            group["call_samples"],
+            count,
+            coverage_name="coverage_percent_of_records",
+        ),
+        "vendor_hook_latency_distribution": hook_latency,
+        "paired_do_swap_page_call_latency_distribution": {
+            phase: _latency_metric(
+                group["paired_call_samples"][phase],
+                paired_counts[phase],
+                coverage_name="coverage_percent_of_paired_records",
+            )
+            for phase in _SWAPIN_JOINT_HOOK_PHASES
+        },
+        "vendor_hook_to_do_swap_page_ratio_distribution": ratio_latency,
+        "primary_vendor_hook_phase": "rvh_hook",
+        "paired_record_counts": paired_counts,
+        "ratio_excluded_zero_call_by_phase": {
+            phase: group["ratio_excluded_by_phase"][phase]
+            for phase in _SWAPIN_JOINT_HOOK_PHASES
+        },
+        "vendor_hook_coverage_percent_of_records": {
+            phase: _percentage(paired_counts[phase], count)
+            for phase in _SWAPIN_JOINT_HOOK_PHASES
+        },
+        "quality": invalidity,
+    }
+
+
+def _finalize_swapin_joint(data: dict, selected_swapin: int) -> dict:
+    overall = _finalize_swapin_joint_group(data["overall"])
+    by_path = {}
+    ordered = sorted(
+        data["by_path_combination"],
+        key=lambda name: (
+            -data["by_path_combination"][name]["record_count"], name
+        ),
+    )
+    for name in ordered:
+        group = _finalize_swapin_joint_group(
+            data["by_path_combination"][name]
+        )
+        group["percent_of_swapin"] = _percentage(
+            group["record_count"], selected_swapin
+        )
+        by_path[name] = group
+    overall["by_path_combination"] = by_path
+    overall["overall_swapin"] = selected_swapin
+    return {"swapin": overall}
+
+
+def _swapout_hook_flag_mode(flags: int) -> str:
+    sync = "sync" if flags & _SWP_SYNCHRONOUS_IO else "not_sync"
+    fs_ops = "fs_ops" if flags & _SWP_FS_OPS else "not_fs_ops"
+    return f"{sync}+{fs_ops}"
+
+
+def _new_swapout_hook_data() -> dict:
+    return {
+        "counts": Counter(),
+        "flags_before_values": Counter(),
+        "flags_after_values": Counter(),
+        "cross": Counter(),
+        "trace_site_samples": array("Q"),
+        "enabled_samples": array("Q"),
+        "transition_samples": {},
+        "helper_samples": {},
+        "combination_samples": {},
+        "combination_counts": Counter(),
+    }
+
+
+def _account_swapout_hook(
+    extension: dict,
+    combination: str,
+    data: dict,
+) -> None:
+    if (
+        not extension.get("present")
+        or extension.get("version") != _SWAPOUT_EXT_VERSION
+        or extension.get("malformed")
+    ):
+        return
+
+    counts = data["counts"]
+    counts["extension_version_2"] += 1
+    helper_name = extension["helper_name"]
+    counts[f"helper_{helper_name}"] += 1
+    data["combination_counts"][combination] += 1
+    if not extension["hook_probed"]:
+        counts["hook_not_probed"] += 1
+        return
+
+    counts["hook_probed"] += 1
+    if extension["hook_enabled"]:
+        counts["hook_enabled"] += 1
+    else:
+        counts["hook_disabled"] += 1
+    if extension["flags_changed"]:
+        counts["flags_changed"] += 1
+    else:
+        counts["flags_unchanged"] += 1
+
+    flags_before = extension["flags_before"]
+    flags_after = extension["flags_after"]
+    before_mode = _swapout_hook_flag_mode(flags_before)
+    after_mode = _swapout_hook_flag_mode(flags_after)
+    transition = f"{before_mode}->{after_mode}"
+    cross = f"before={before_mode}|after={after_mode}|helper={helper_name}"
+    data["flags_before_values"][flags_before] += 1
+    data["flags_after_values"][flags_after] += 1
+    counts[f"before_{before_mode}"] += 1
+    counts[f"after_{after_mode}"] += 1
+    counts[f"transition_{transition}"] += 1
+    data["cross"][cross] += 1
+
+    hook_ns = extension["hook_interval_ns"]
+    if hook_ns is None:
+        return
+    data["trace_site_samples"].append(hook_ns)
+    if not extension["hook_enabled"]:
+        return
+    data["enabled_samples"].append(hook_ns)
+    data["transition_samples"].setdefault(
+        transition, array("Q")
+    ).append(hook_ns)
+    data["helper_samples"].setdefault(
+        helper_name, array("Q")
+    ).append(hook_ns)
+    data["combination_samples"].setdefault(
+        combination, array("Q")
+    ).append(hook_ns)
+
+
+def _format_flag_value_counter(counter: Counter) -> dict:
+    return {
+        f"0x{value:016x}": count
+        for value, count in sorted(
+            counter.items(), key=lambda item: (-item[1], item[0])
+        )
+    }
+
+
+def _finalize_swapout_vendor_hook(
+    data: dict,
+    selected_swapout: int,
+) -> dict:
+    counts = data["counts"]
+    extension_count = counts["extension_version_2"]
+    hook_probed = counts["hook_probed"]
+    enabled = counts["hook_enabled"]
+    flag_modes = (
+        "sync+fs_ops",
+        "sync+not_fs_ops",
+        "not_sync+fs_ops",
+        "not_sync+not_fs_ops",
+    )
+    transitions = {
+        f"{before}->{after}": counts[f"transition_{before}->{after}"]
+        for before in flag_modes
+        for after in flag_modes
+    }
+    transition_counts = Counter()
+    for key, value in counts.items():
+        if key.startswith("transition_"):
+            transition_counts[key[len("transition_"):]] = value
+    helper_counts = Counter({
+        key[len("helper_"):]: value
+        for key, value in counts.items()
+        if key.startswith("helper_")
+    })
+    return {
+        "swapout": {
+            "overall": selected_swapout,
+            "extension_version_2": {
+                "count": extension_count,
+                "percent_of_swapout": _percentage(
+                    extension_count, selected_swapout
+                ),
+            },
+            "hook_probed": {
+                "count": hook_probed,
+                "percent_of_extension_v2": _percentage(
+                    hook_probed, extension_count
+                ),
+            },
+            "hook_not_probed": counts["hook_not_probed"],
+            "hook_enabled": {
+                "count": enabled,
+                "percent_of_probed": _percentage(
+                    enabled, hook_probed
+                ),
+            },
+            "hook_disabled": counts["hook_disabled"],
+            "flags_changed": {
+                "count": counts["flags_changed"],
+                "percent_of_probed": _percentage(
+                    counts["flags_changed"], hook_probed
+                ),
+            },
+            "flags_unchanged": counts["flags_unchanged"],
+            "flags_before_modes": {
+                mode: counts[f"before_{mode}"] for mode in flag_modes
+            },
+            "flags_after_modes": {
+                mode: counts[f"after_{mode}"] for mode in flag_modes
+            },
+            "flags_before_values": _format_flag_value_counter(
+                data["flags_before_values"]
+            ),
+            "flags_after_values": _format_flag_value_counter(
+                data["flags_after_values"]
+            ),
+            "before_after_transitions": transitions,
+            "flags_before_after_helper_cross_accounting": (
+                _ordered_counter(data["cross"])
+            ),
+            "latency": {
+                "hook": _latency_metric(
+                    data["enabled_samples"],
+                    enabled,
+                    coverage_name="coverage_percent_of_enabled",
+                ),
+                "trace_site_interval": _latency_metric(
+                    data["trace_site_samples"],
+                    hook_probed,
+                    coverage_name="coverage_percent_of_probed",
+                ),
+                "by_before_after_transition": _latency_by_key(
+                    data["transition_samples"],
+                    transition_counts,
+                    hook_probed,
+                    "percent_of_probed",
+                ),
+                "by_helper": _latency_by_key(
+                    data["helper_samples"],
+                    helper_counts,
+                    extension_count,
+                    "percent_of_extension_v2",
+                ),
+                "by_path_combination": _latency_by_key(
+                    data["combination_samples"],
+                    data["combination_counts"],
+                    selected_swapout,
+                    "percent_of_swapout",
+                ),
+            },
+        }
+    }
+
+
+def _latency_by_key(
+    samples: dict,
+    counts: Counter,
+    total: int,
+    total_percentage_name: str,
+) -> dict:
+    result = {}
+    for name in sorted(counts, key=lambda key: (-counts[key], key)):
+        count = counts[name]
+        result[name] = {
+            "record_count": count,
+            total_percentage_name: _percentage(count, total),
+            "latency": _latency_metric(
+                samples.get(name, array("Q")),
+                count,
+                coverage_name="coverage_percent_of_group",
+            ),
+        }
+    return result
+
+
+def _new_swapout_lifecycle_group() -> dict:
+    return {
+        "record_count": 0,
+        "extension_v2_count": 0,
+        "helpers": Counter(),
+        "states": Counter(),
+        "evidence": Counter(),
+        "timestamp_relationships": Counter(),
+        "cpu": Counter(),
+        "completion_context": Counter(),
+        "latency": {
+            phase: array("Q")
+            for phase in _SWAPOUT_LIFECYCLE_LATENCY_PHASES
+        },
+    }
+
+
+def _relation(left: int, right: int) -> str:
+    if left < right:
+        return "before"
+    if left > right:
+        return "after"
+    return "at"
+
+
+def _account_swapout_lifecycle_group(
+    record: tuple,
+    flags: int,
+    extension: dict,
+    group: dict,
+) -> None:
+    group["record_count"] += 1
+    extension_v2 = (
+        extension.get("present")
+        and extension.get("version") == _SWAPOUT_EXT_VERSION
+        and not extension.get("malformed")
+    )
+    if extension_v2:
+        group["extension_v2_count"] += 1
+        helper_name = extension["helper_name"]
+        state_name = extension["submit_state_name"]
+    else:
+        helper_name = "extension_unavailable"
+        state_name = "extension_unavailable"
+    group["helpers"][helper_name] += 1
+    group["states"][state_name] += 1
+
+    evidence = group["evidence"]
+    if extension_v2:
+        for name in (
+            "queue_synchronous",
+            "bdev_has_submit_bio",
+            "state_error_flag",
+        ):
+            if extension[name]:
+                evidence[name] += 1
+
+        if extension["submit_state"] == 5:
+            evidence["completion_before_submit_return_marker"] += 1
+        elif extension["submit_state"] == 6:
+            evidence["completion_after_submit_return_marker"] += 1
+        elif extension["submit_state"] == 4:
+            evidence["completion_pending_at_record_publish"] += 1
+        if extension["submit_state"] in (5, 6):
+            evidence["async_completion_observed"] += 1
+        if helper_name == "bdev_async":
+            evidence["async_helper_selected"] += 1
+        elif helper_name == "bdev_sync":
+            evidence["sync_helper_selected"] += 1
+
+    call_end_ns = record[8]
+    submit_begin_ns = record[10]
+    submit_end_ns = record[11]
+    device_end_ns = record[13]
+    submit_valid = bool(flags & _F_SUBMIT_VALID) and (
+        submit_begin_ns != 0 and submit_end_ns >= submit_begin_ns
+    )
+    device_valid = bool(flags & _F_DEVICE_VALID) and (
+        record[12] != 0 and device_end_ns >= record[12]
+    )
+    relationships = group["timestamp_relationships"]
+    if submit_valid:
+        relationships["submit_interval_valid"] += 1
+        group["latency"]["submit_call"].append(
+            submit_end_ns - submit_begin_ns
+        )
+        submit_call_relation = _relation(submit_end_ns, call_end_ns)
+        relationships[
+            f"submit_end_{submit_call_relation}_call_end"
+        ] += 1
+
+    if device_valid:
+        relationships["device_interval_valid"] += 1
+        device_call_relation = _relation(device_end_ns, call_end_ns)
+        relationships[
+            f"device_end_{device_call_relation}_call_end"
+        ] += 1
+        if submit_valid:
+            device_submit_relation = _relation(
+                device_end_ns, submit_end_ns
+            )
+            relationships[
+                f"device_end_{device_submit_relation}_submit_end"
+            ] += 1
+            if device_end_ns > submit_end_ns:
+                group["latency"][
+                    "post_submit_return_completion"
+                ].append(device_end_ns - submit_end_ns)
+
+    cpu = group["cpu"]
+    if submit_valid and extension_v2:
+        submit_cpu = record[29]
+        return_cpu = extension["submit_return_cpu"]
+        same = "same" if submit_cpu == return_cpu else "different"
+        cpu[f"submit_to_return_{same}_cpu"] += 1
+        cpu[f"submit_to_return_pair_{submit_cpu}->{return_cpu}"] += 1
+    if device_valid:
+        submit_cpu = record[29]
+        complete_cpu = record[30]
+        same = "same" if submit_cpu == complete_cpu else "different"
+        cpu[f"submit_to_complete_{same}_cpu"] += 1
+        cpu[f"submit_to_complete_pair_{submit_cpu}->{complete_cpu}"] += 1
+        if extension_v2 and extension["submit_state"] in (5, 6):
+            return_cpu = extension["submit_return_cpu"]
+            same = "same" if return_cpu == complete_cpu else "different"
+            cpu[f"return_to_complete_{same}_cpu"] += 1
+            cpu[
+                f"return_to_complete_pair_{return_cpu}->{complete_cpu}"
+            ] += 1
+
+    if extension_v2 and extension["submit_state"] in (5, 6):
+        in_task = extension["completion_in_task"]
+        in_softirq = extension["completion_in_softirq"]
+        if in_task and in_softirq:
+            context = "task_and_softirq"
+        elif in_task:
+            context = "task_only"
+        elif in_softirq:
+            context = "softirq_only"
+        else:
+            # in_task() and in_serving_softirq() both false at end_io
+            # means hard interrupt context (device IRQ completion).
+            context = "hardirq"
+        group["completion_context"][context] += 1
+
+
+def _account_swapout_lifecycle(
+    record: tuple,
+    flags: int,
+    extension: dict,
+    combination: str,
+    data: dict,
+) -> None:
+    _account_swapout_lifecycle_group(
+        record, flags, extension, data["overall"]
+    )
+    if combination not in data["by_combination"]:
+        data["by_combination"][
+            combination
+        ] = _new_swapout_lifecycle_group()
+    group = data["by_combination"][combination]
+    _account_swapout_lifecycle_group(record, flags, extension, group)
+
+
+def _finalize_cpu_accounting(counter: Counter) -> dict:
+    result = {
+        name: counter[name]
+        for name in (
+            "submit_to_return_same_cpu",
+            "submit_to_return_different_cpu",
+            "submit_to_complete_same_cpu",
+            "submit_to_complete_different_cpu",
+            "return_to_complete_same_cpu",
+            "return_to_complete_different_cpu",
+        )
+    }
+    for prefix, output_name in (
+        ("submit_to_return_pair_", "submit_to_return_pairs"),
+        ("submit_to_complete_pair_", "submit_to_complete_pairs"),
+        ("return_to_complete_pair_", "return_to_complete_pairs"),
+    ):
+        pairs = Counter({
+            key[len(prefix):]: value
+            for key, value in counter.items()
+            if key.startswith(prefix)
+        })
+        result[output_name] = _ordered_counter(pairs)
+    return result
+
+
+def _finalize_swapout_lifecycle_group(group: dict) -> dict:
+    count = group["record_count"]
+    extension_v2_count = group["extension_v2_count"]
+    helpers = group["helpers"]
+    states = group["states"]
+    evidence = group["evidence"]
+    contexts = (
+        "task_only",
+        "softirq_only",
+        "task_and_softirq",
+        "hardirq",
+    )
+    return {
+        "record_count": count,
+        "extension_version_2_records": extension_v2_count,
+        "helper_accounting": {
+            **{name: helpers[name] for name in _SWAPOUT_HELPERS.values()},
+            "extension_unavailable": helpers["extension_unavailable"],
+            "unknown": sum(
+                value
+                for name, value in helpers.items()
+                if name.startswith("unknown_")
+            ),
+        },
+        "submit_state_accounting": {
+            **{
+                name: states[name]
+                for name in _SWAPOUT_SUBMIT_STATES.values()
+            },
+            "extension_unavailable": states["extension_unavailable"],
+            "unknown": sum(
+                value
+                for name, value in states.items()
+                if name.startswith("unknown_")
+            ),
+        },
+        "atomic_lifecycle_evidence": {
+            name: evidence[name]
+            for name in (
+                "sync_helper_selected",
+                "async_helper_selected",
+                "async_completion_observed",
+                "completion_before_submit_return_marker",
+                "completion_after_submit_return_marker",
+                "completion_pending_at_record_publish",
+                "state_error_flag",
+            )
+        },
+        "queue_evidence": {
+            "queue_synchronous": evidence["queue_synchronous"],
+            "bdev_has_submit_bio": evidence["bdev_has_submit_bio"],
+        },
+        "timestamp_relationships": {
+            name: group["timestamp_relationships"][name]
+            for name in (
+                "submit_interval_valid",
+                "device_interval_valid",
+                "submit_end_before_call_end",
+                "submit_end_at_call_end",
+                "submit_end_after_call_end",
+                "device_end_before_submit_end",
+                "device_end_at_submit_end",
+                "device_end_after_submit_end",
+                "device_end_before_call_end",
+                "device_end_at_call_end",
+                "device_end_after_call_end",
+            )
+        },
+        "cpu_accounting": _finalize_cpu_accounting(group["cpu"]),
+        "completion_context": {
+            name: group["completion_context"][name]
+            for name in contexts
+        },
+        "latency": {
+            phase: _latency_metric(
+                group["latency"][phase],
+                count,
+                coverage_name="coverage_percent_of_group",
+            )
+            for phase in _SWAPOUT_LIFECYCLE_LATENCY_PHASES
+        },
+    }
+
+
+def _finalize_swapout_lifecycle(
+    data: dict,
+    selected_swapout: int,
+) -> dict:
+    overall_group = _finalize_swapout_lifecycle_group(data["overall"])
+    extension_count = overall_group["extension_version_2_records"]
+    ordered_combinations = sorted(
+        data["by_combination"],
+        key=lambda name: (
+            -data["by_combination"][name]["record_count"], name
+        ),
+    )
+    by_combination = {}
+    for name in ordered_combinations:
+        finalized = _finalize_swapout_lifecycle_group(
+            data["by_combination"][name]
+        )
+        finalized["percent_of_swapout"] = _percentage(
+            finalized["record_count"], selected_swapout
+        )
+        finalized["percent_of_extension_v2"] = _percentage(
+            finalized["extension_version_2_records"], extension_count
+        )
+        by_combination[name] = finalized
+    return {
+        "swapout": {
+            "overall": selected_swapout,
+            "extension_version_2": {
+                "count": extension_count,
+                "percent_of_swapout": _percentage(
+                    extension_count, selected_swapout
+                ),
+            },
+            **{
+                key: value
+                for key, value in overall_group.items()
+                if key not in (
+                    "record_count",
+                    "extension_version_2_records",
+                )
+            },
+            "by_path_combination": by_combination,
+        }
+    }
+
+
+def _vendor_state_accounting(
+    counts: Counter,
+    prefix: str,
+    handled_count: int,
+) -> dict:
+    return {
+        state: {
+            "count": counts[f"{prefix}_{state}"],
+            "percent_of_handled": _percentage(
+                counts[f"{prefix}_{state}"], handled_count
+            ),
+        }
+        for state in _VENDOR_HANDLED_STATES
+    }
+
+
+def _finalize_vendor_hook_accounting(
+    counts: Counter,
+    selected_swapin: int,
+) -> dict:
+    rvh_called = counts["rvh_called"]
+    rvh_handled = counts["rvh_handled"]
+    vh_called = counts["vh_called"]
+    vh_handled = counts["vh_handled"]
+    handled_records = counts["handled_records"]
+    extension_records = counts["extension_version_1"]
+
+    return {
+        "swapin": {
+            "overall": selected_swapin,
+            "extension_version_1": {
+                "count": extension_records,
+                "percent_of_swapin": _percentage(
+                    extension_records, selected_swapin
+                ),
+            },
+            "rvh": {
+                "called": rvh_called,
+                "percent_called_of_extension": _percentage(
+                    rvh_called, extension_records
+                ),
+                "handled": rvh_handled,
+                "percent_handled_of_called": _percentage(
+                    rvh_handled, rvh_called
+                ),
+                "return_uptodate": counts["rvh_return_uptodate"],
+                "return_locked": counts["rvh_return_locked"],
+                "handled_return_state": _vendor_state_accounting(
+                    counts, "rvh", rvh_handled
+                ),
+            },
+            "vh": {
+                "called": vh_called,
+                "percent_called_of_extension": _percentage(
+                    vh_called, extension_records
+                ),
+                "handled": vh_handled,
+                "percent_handled_of_called": _percentage(
+                    vh_handled, vh_called
+                ),
+                "return_uptodate": counts["vh_return_uptodate"],
+                "return_locked": counts["vh_return_locked"],
+                "handled_return_state": _vendor_state_accounting(
+                    counts, "vh", vh_handled
+                ),
+            },
+            "handled_records": {
+                "count": handled_records,
+                "percent_of_swapin": _percentage(
+                    handled_records, selected_swapin
+                ),
+                "return_state": _vendor_state_accounting(
+                    counts, "handled", handled_records
+                ),
+            },
+            "post_hook_folio_lock_wait": {
+                "count": counts["wait_valid"],
+                "percent_of_swapin": _percentage(
+                    counts["wait_valid"], selected_swapin
+                ),
+                "percent_of_handled": _percentage(
+                    counts["wait_valid"], handled_records
+                ),
+            },
+        }
+    }
+
+
+def _finalize_vendor_state_latency(
+    state_samples: dict,
+    counts: Counter,
+) -> dict:
+    """State-conditioned hook distributions for the joint swap-in view.
+
+    The per-phase overall distributions live in
+    swapin_record_joint_analysis; this adds only what that view cannot
+    express: the same phases split by the handled-return folio state.
+    """
+    by_state = {}
+    for state in _VENDOR_HANDLED_STATES:
+        state_count = counts[f"handled_{state}"]
+        by_state[state] = {
+            "record_count": state_count,
+            "percent_of_handled_records": _percentage(
+                state_count, counts["handled_records"]
+            ),
+            "latency": {
+                phase: _latency_metric(
+                    state_samples[state][phase],
+                    state_count,
+                    coverage_name="coverage_percent_of_state",
+                )
+                for phase in _VENDOR_STATE_LATENCY_PHASES
+            },
+        }
+
+    for phase in _VENDOR_STATE_LATENCY_PHASES:
+        all_state_tail_counts = {
+            tail_name: sum(
+                by_state[state]["latency"][phase]["tail_counts"][
+                    tail_name
+                ]["count"]
+                for state in _VENDOR_HANDLED_STATES
+            )
+            for tail_name in map(
+                _tail_name, _LATENCY_TAIL_THRESHOLDS_MS
+            )
+        }
+        for state in _VENDOR_HANDLED_STATES:
+            for tail_name, tail in by_state[state]["latency"][phase][
+                "tail_counts"
+            ].items():
+                tail["percent_of_all_handled_state_tail"] = _percentage(
+                    tail["count"], all_state_tail_counts[tail_name]
+                )
+
+    return by_state
+
+
+def _account_vendor_extension(
+    extension: dict,
+    counts: Counter,
+    state_samples: dict,
+) -> None:
+    if (
+        not extension.get("present")
+        or extension.get("version") != _VENDOR_EXT_VERSION
+        or extension.get("malformed")
+    ):
+        return
+
+    counts["extension_version_1"] += 1
+    for hook in ("rvh", "vh"):
+        if extension[f"{hook}_called"]:
+            counts[f"{hook}_called"] += 1
+        if extension[f"{hook}_handled"]:
+            counts[f"{hook}_handled"] += 1
+            state = extension[f"{hook}_state"]
+            counts[f"{hook}_{state}"] += 1
+            if extension[f"{hook}_return_uptodate"]:
+                counts[f"{hook}_return_uptodate"] += 1
+            if extension[f"{hook}_return_locked"]:
+                counts[f"{hook}_return_locked"] += 1
+
+    overall_state = extension["overall_handled_state"]
+    if overall_state != "none":
+        counts["handled_records"] += 1
+        counts[f"handled_{overall_state}"] += 1
+    if extension["wait_valid"]:
+        counts["wait_valid"] += 1
+
+    if overall_state in _VENDOR_HANDLED_STATES:
+        phase_values = {
+            "handled_hook_total": extension["handled_total_ns"],
+            "post_hook_folio_lock": extension["wait_interval_ns"],
+            "vendor_end_to_end": extension["end_to_end_ns"],
+        }
+        for phase in _VENDOR_STATE_LATENCY_PHASES:
+            value = phase_values[phase]
+            if value is not None:
+                state_samples[overall_state][phase].append(value)
+
+
+def _cs_bucket(count: int) -> str:
+    if count <= 2:
+        return str(count)
+    if count <= 5:
+        return "3_5"
+    return "6_plus"
+
+
+def _sched_switch_class(nvcsw: int, nivcsw: int) -> str:
+    if nvcsw and nivcsw:
+        return "both"
+    if nvcsw:
+        return "voluntary_only"
+    if nivcsw:
+        return "involuntary_only"
+    return "no_switch"
+
+
+def _new_sched_phase() -> dict:
+    return {
+        "candidate_records": 0,
+        "sched_valid": 0,
+        "run_delay_valid": 0,
+        "samples": {
+            component: array("Q") for component in _SCHED_COMPONENTS
+        },
+        "ratio_samples": {
+            component: array("d")
+            for component in _SCHED_RATIO_COMPONENTS
+        },
+        "ratio_component_sums_ns": Counter(),
+        "ratio_wall_sums_ns": Counter(),
+        "context_switches": Counter(),
+        "endpoint_cpu_change": Counter(),
+        # These arrays are aligned by index and retain only compact values
+        # needed for same-record tail attribution.
+        "tail_wall_ns": array("Q"),
+        "tail_task_runtime_ns": array("Q"),
+        "tail_non_task_ns": array("Q"),
+        "tail_runqueue_ns": array("Q"),
+        "tail_blocked_ns": array("Q"),
+        "tail_switch_class": array("B"),
+        "tail_endpoint_cpu_changed": array("B"),
+        "quality": Counter(),
+    }
+
+
+def _new_sched_rvh_joint() -> dict:
+    return {
+        "record_count": 0,
+        # Arrays are aligned by selected swap-in record with a valid root
+        # scheduler interval.  Missing run-delay values use the u64 sentinel.
+        "root_wall_ns": array("Q"),
+        "root_runqueue_ns": array("Q"),
+        "rvh_state": array("B"),
+        "rvh_wall_ns": array("Q"),
+        "rvh_runqueue_ns": array("Q"),
+        "quality": Counter(),
+    }
+
+
+def _new_sched_group(include_rvh: bool, include_joint: bool = False) -> dict:
+    phases = {"root_call": _new_sched_phase()}
+    if include_rvh:
+        phases["rvh_hook"] = _new_sched_phase()
+    return {
+        "record_count": 0,
+        "format_v3_records": 0,
+        "phases": phases,
+        "root_rvh_joint": (
+            _new_sched_rvh_joint() if include_joint else None
+        ),
+        "by_path_combination": {},
+    }
+
+
+def _account_sched_component(
+    phase: dict,
+    component: str,
+    value_ns: int,
+    wall_ns: int,
+) -> None:
+    phase["samples"][component].append(value_ns)
+    if wall_ns:
+        phase["ratio_samples"][component].append(
+            value_ns * 100.0 / wall_ns
+        )
+        phase["ratio_component_sums_ns"][component] += value_ns
+        phase["ratio_wall_sums_ns"][component] += wall_ns
+    else:
+        phase["quality"][f"zero_wall_ratio_excluded_{component}"] += 1
+
+
+def _account_sched_phase(
+    phase: dict,
+    wall_ns: int,
+    exec_ns: int,
+    run_delay_ns: int,
+    nvcsw: int,
+    nivcsw: int,
+    begin_cpu: int,
+    end_cpu: int,
+    sched_valid: bool,
+    run_delay_valid: bool,
+    counter_overflow: bool,
+) -> int:
+    phase["candidate_records"] += 1
+    quality = phase["quality"]
+    if run_delay_valid and not sched_valid:
+        quality["run_delay_valid_without_sched_valid"] += 1
+    if counter_overflow and not sched_valid:
+        quality["counter_overflow_without_sched_valid"] += 1
+    if not sched_valid:
+        quality["missing_sched_valid"] += 1
+        return _SCHED_INVALID_RUNQUEUE_NS
+
+    phase["sched_valid"] += 1
+    phase["samples"]["wall"].append(wall_ns)
+
+    switch_code = _SCHED_INVALID_SWITCH_CLASS
+    if counter_overflow:
+        quality["context_switch_counter_overflow"] += 1
+    else:
+        cs = phase["context_switches"]
+        switch_class = _sched_switch_class(nvcsw, nivcsw)
+        switch_code = _SCHED_SWITCH_CLASS_CODES[switch_class]
+        cs["valid_records"] += 1
+        cs["voluntary_total"] += nvcsw
+        cs["involuntary_total"] += nivcsw
+        cs[f"voluntary_{_cs_bucket(nvcsw)}"] += 1
+        cs[f"involuntary_{_cs_bucket(nivcsw)}"] += 1
+        cs[f"class_{switch_class}"] += 1
+
+    endpoint_cpu_changed = begin_cpu != end_cpu
+    phase["endpoint_cpu_change"]["valid_records"] += 1
+    phase["endpoint_cpu_change"][
+        "changed" if endpoint_cpu_changed else "same_cpu"
+    ] += 1
+
+    exec_valid = exec_ns <= wall_ns
+    non_task_ns = None
+    if not exec_valid:
+        quality["task_runtime_exceeds_wall"] += 1
+    else:
+        non_task_ns = wall_ns - exec_ns
+        _account_sched_component(
+            phase, "task_runtime", exec_ns, wall_ns
+        )
+        _account_sched_component(
+            phase, "non_task_or_irq", non_task_ns, wall_ns
+        )
+
+    accepted_runqueue_ns = _SCHED_INVALID_RUNQUEUE_NS
+    blocked_ns = _SCHED_INVALID_COMPONENT_NS
+    if not run_delay_valid:
+        quality["run_delay_unavailable"] += 1
+    elif run_delay_ns > wall_ns:
+        quality["runqueue_wait_exceeds_wall"] += 1
+    else:
+        phase["run_delay_valid"] += 1
+        accepted_runqueue_ns = run_delay_ns
+        _account_sched_component(
+            phase, "runqueue_wait", run_delay_ns, wall_ns
+        )
+        if non_task_ns is None:
+            quality["blocked_residual_missing_task_runtime"] += 1
+        elif run_delay_ns > non_task_ns:
+            quality["runqueue_wait_exceeds_non_task"] += 1
+        else:
+            blocked_ns = non_task_ns - run_delay_ns
+            _account_sched_component(
+                phase,
+                "blocked_or_unaccounted",
+                blocked_ns,
+                wall_ns,
+            )
+
+    phase["tail_wall_ns"].append(wall_ns)
+    phase["tail_task_runtime_ns"].append(
+        exec_ns if exec_valid else _SCHED_INVALID_COMPONENT_NS
+    )
+    phase["tail_non_task_ns"].append(
+        non_task_ns if non_task_ns is not None else _SCHED_INVALID_COMPONENT_NS
+    )
+    phase["tail_runqueue_ns"].append(accepted_runqueue_ns)
+    phase["tail_blocked_ns"].append(blocked_ns)
+    phase["tail_switch_class"].append(switch_code)
+    phase["tail_endpoint_cpu_changed"].append(
+        1 if endpoint_cpu_changed else 0
+    )
+    return accepted_runqueue_ns
+
+
+def _account_sched_rvh_joint(
+    joint: dict,
+    call_ns: int,
+    vendor_extension: dict,
+    root_sched_valid: bool,
+    root_runqueue_ns: int,
+    rvh_sched_valid: bool,
+    rvh_runqueue_ns: int,
+) -> None:
+    joint["record_count"] += 1
+    quality = joint["quality"]
+    if not root_sched_valid:
+        quality["root_scheduler_interval_unavailable"] += 1
+        return
+
+    if root_runqueue_ns == _SCHED_INVALID_RUNQUEUE_NS:
+        quality["root_runqueue_unavailable"] += 1
+
+    extension_valid = (
+        vendor_extension.get("present")
+        and vendor_extension.get("version") == _VENDOR_EXT_VERSION
+        and not vendor_extension.get("malformed")
+        and not vendor_extension.get("unknown_version")
+        and not vendor_extension.get("unknown_flags")
+        and not vendor_extension.get("rvh_flag_consistency_error")
+    )
+    rvh_wall_ns = _SCHED_INVALID_COMPONENT_NS
+    accepted_rvh_runqueue_ns = _SCHED_INVALID_RUNQUEUE_NS
+    if not extension_valid:
+        rvh_state = _RVH_JOINT_EXTENSION_UNRESOLVED
+        quality["extension_unresolved"] += 1
+    elif not vendor_extension.get("rvh_called"):
+        rvh_state = _RVH_JOINT_NOT_CALLED
+    elif vendor_extension.get("rvh_interval_ns") is None:
+        rvh_state = _RVH_JOINT_CALLED_INTERVAL_INVALID
+        quality["rvh_called_interval_invalid"] += 1
+    else:
+        rvh_state = _RVH_JOINT_CALLED_INTERVAL_VALID
+        rvh_wall_ns = vendor_extension["rvh_interval_ns"]
+        if rvh_wall_ns > call_ns:
+            rvh_state = _RVH_JOINT_CALLED_INTERVAL_INVALID
+            rvh_wall_ns = _SCHED_INVALID_COMPONENT_NS
+            quality["rvh_wall_exceeds_root_wall"] += 1
+        elif not rvh_sched_valid:
+            quality["rvh_scheduler_interval_unavailable"] += 1
+        elif rvh_runqueue_ns == _SCHED_INVALID_RUNQUEUE_NS:
+            quality["rvh_runqueue_unavailable"] += 1
+        else:
+            accepted_rvh_runqueue_ns = rvh_runqueue_ns
+            if (
+                root_runqueue_ns != _SCHED_INVALID_RUNQUEUE_NS
+                and accepted_rvh_runqueue_ns > root_runqueue_ns
+            ):
+                quality["rvh_runqueue_exceeds_root_runqueue"] += 1
+                accepted_rvh_runqueue_ns = _SCHED_INVALID_RUNQUEUE_NS
+
+    joint["root_wall_ns"].append(call_ns)
+    joint["root_runqueue_ns"].append(root_runqueue_ns)
+    joint["rvh_state"].append(rvh_state)
+    joint["rvh_wall_ns"].append(rvh_wall_ns)
+    joint["rvh_runqueue_ns"].append(accepted_rvh_runqueue_ns)
+
+
+def _account_sched_group(
+    record: tuple,
+    flags: int,
+    call_ns: int,
+    vendor_extension: dict,
+    group: dict,
+) -> None:
+    group["record_count"] += 1
+    root = group["phases"]["root_call"]
+    rvh = group["phases"].get("rvh_hook")
+    rvh_wall_ns = vendor_extension.get("rvh_interval_ns")
+
+    group["format_v3_records"] += 1
+    (
+        root_exec_ns,
+        root_run_delay_ns,
+        rvh_exec_ns,
+        rvh_run_delay_ns,
+        root_nvcsw,
+        root_nivcsw,
+        rvh_nvcsw,
+        rvh_nivcsw,
+        root_begin_cpu,
+        root_end_cpu,
+        rvh_begin_cpu,
+        rvh_end_cpu,
+    ) = record[35:47]
+
+    root_sched_valid = bool(flags & _F_SCHED_VALID)
+    root_runqueue_ns = _account_sched_phase(
+        root,
+        call_ns,
+        root_exec_ns,
+        root_run_delay_ns,
+        root_nvcsw,
+        root_nivcsw,
+        root_begin_cpu,
+        root_end_cpu,
+        root_sched_valid,
+        bool(flags & _F_RUN_DELAY_VALID),
+        bool(flags & _F_SCHED_COUNTER_OVERFLOW),
+    )
+
+    joint = group.get("root_rvh_joint")
+    if rvh is None:
+        if joint is not None:
+            _account_sched_rvh_joint(
+                joint,
+                call_ns,
+                vendor_extension,
+                root_sched_valid,
+                root_runqueue_ns,
+                False,
+                _SCHED_INVALID_RUNQUEUE_NS,
+            )
+        return
+    vendor_flags = vendor_extension.get("flags", 0)
+    rvh_sched_valid = bool(vendor_flags & _VENDOR_F_RVH_SCHED_VALID)
+    rvh_run_delay_valid = bool(
+        vendor_flags & _VENDOR_F_RVH_RUN_DELAY_VALID
+    )
+    rvh_counter_overflow = bool(
+        vendor_flags & _VENDOR_F_RVH_COUNTER_OVERFLOW
+    )
+    rvh_runqueue_ns = _SCHED_INVALID_RUNQUEUE_NS
+    if rvh_wall_ns is None:
+        if rvh_sched_valid or rvh_run_delay_valid or rvh_counter_overflow:
+            rvh["quality"]["sched_flags_without_valid_rvh_interval"] += 1
+    else:
+        rvh_runqueue_ns = _account_sched_phase(
+            rvh,
+            rvh_wall_ns,
+            rvh_exec_ns,
+            rvh_run_delay_ns,
+            rvh_nvcsw,
+            rvh_nivcsw,
+            rvh_begin_cpu,
+            rvh_end_cpu,
+            rvh_sched_valid,
+            rvh_run_delay_valid,
+            rvh_counter_overflow,
+        )
+    if joint is not None:
+        _account_sched_rvh_joint(
+            joint,
+            call_ns,
+            vendor_extension,
+            root_sched_valid,
+            root_runqueue_ns,
+            rvh_sched_valid,
+            rvh_runqueue_ns,
+        )
+
+
+def _account_sched(
+    record: tuple,
+    flags: int,
+    call_ns: int,
+    vendor_extension: dict,
+    combination: str,
+    data: dict,
+) -> None:
+    _account_sched_group(
+        record, flags, call_ns, vendor_extension, data
+    )
+    by_combination = data["by_path_combination"]
+    if combination not in by_combination:
+        by_combination[combination] = _new_sched_group(
+            "rvh_hook" in data["phases"]
+        )
+    _account_sched_group(
+        record,
+        flags,
+        call_ns,
+        vendor_extension,
+        by_combination[combination],
+    )
+
+
+def _sched_ratio_metric(phase: dict, component: str) -> dict:
+    metric = _ratio_metric(
+        phase["ratio_samples"][component],
+        phase["sched_valid"],
+        coverage_name="coverage_percent_of_sched_valid",
+        unit="percent_of_phase_wall",
+    )
+    component_sum = phase["ratio_component_sums_ns"][component]
+    wall_sum = phase["ratio_wall_sums_ns"][component]
+    metric["mean_of_record_ratios_percent"] = metric["average_percent"]
+    metric["aggregate_time_share_percent"] = round(
+        component_sum * 100.0 / wall_sum, 6
+    ) if wall_sum else 0.0
+    metric["aggregate_component_ms"] = round(
+        component_sum / 1_000_000.0, 6
+    )
+    metric["aggregate_paired_wall_ms"] = round(
+        wall_sum / 1_000_000.0, 6
+    )
+    return metric
+
+
+def _sched_tail_summary(
+    phase: dict,
+    threshold_ns: float,
+    comparison: str,
+) -> dict:
+    walls = phase["tail_wall_ns"]
+    component_values = {
+        "task_runtime": phase["tail_task_runtime_ns"],
+        "non_task_or_irq": phase["tail_non_task_ns"],
+        "runqueue_wait": phase["tail_runqueue_ns"],
+        "blocked_or_unaccounted": phase["tail_blocked_ns"],
+    }
+    switch_codes = phase["tail_switch_class"]
+    endpoint_cpu_changed_values = phase["tail_endpoint_cpu_changed"]
+    selected_count = 0
+    wall_total_ns = 0
+    component_counts = Counter()
+    component_totals_ns = Counter()
+    component_wall_totals_ns = Counter()
+    component_ratio_sums = Counter()
+    component_ratio_counts = Counter()
+    component_ge_50 = Counter()
+    component_ge_80 = Counter()
+    complete_count = 0
+    complete_wall_total_ns = 0
+    complete_component_totals_ns = Counter()
+    complete_component_ratio_sums = Counter()
+    complete_component_ratio_counts = Counter()
+    complete_dominant_counts = Counter()
+    complete_identity_mismatch = 0
+    complete_zero_wall = 0
+    context_counts = Counter()
+    endpoint_cpu_counts = Counter()
+
+    for index, wall_ns in enumerate(walls):
+        selected = (
+            wall_ns > threshold_ns
+            if comparison == "gt"
+            else wall_ns >= threshold_ns
+        )
+        if not selected:
+            continue
+        selected_count += 1
+        wall_total_ns += wall_ns
+
+        for component, values in component_values.items():
+            value_ns = values[index]
+            if value_ns == _SCHED_INVALID_COMPONENT_NS:
+                continue
+            component_counts[component] += 1
+            component_totals_ns[component] += value_ns
+            component_wall_totals_ns[component] += wall_ns
+            if wall_ns:
+                ratio = value_ns * 100.0 / wall_ns
+                component_ratio_sums[component] += ratio
+                component_ratio_counts[component] += 1
+                if ratio >= 50.0:
+                    component_ge_50[component] += 1
+                if ratio >= 80.0:
+                    component_ge_80[component] += 1
+
+        # E/R/B are directly comparable only on the same records for which
+        # all three components are valid.  This joint subset is the strict
+        # partition view; its aggregate shares should sum to the selected
+        # wall time (apart from zero-width samples and boundary quality).
+        partition_values = {
+            component: component_values[component][index]
+            for component in _SCHED_PARTITION_COMPONENTS
+        }
+        if all(
+            value_ns != _SCHED_INVALID_COMPONENT_NS
+            for value_ns in partition_values.values()
+        ):
+            complete_count += 1
+            complete_wall_total_ns += wall_ns
+            complete_sum_ns = 0
+            for component, value_ns in partition_values.items():
+                complete_component_totals_ns[component] += value_ns
+                complete_sum_ns += value_ns
+                if wall_ns:
+                    complete_component_ratio_sums[component] += (
+                        value_ns * 100.0 / wall_ns
+                    )
+                    complete_component_ratio_counts[component] += 1
+            if complete_sum_ns != wall_ns:
+                complete_identity_mismatch += 1
+            if not wall_ns:
+                complete_zero_wall += 1
+            max_value = max(partition_values.values())
+            winners = [
+                component
+                for component, value_ns in partition_values.items()
+                if value_ns == max_value
+            ]
+            complete_dominant_counts[
+                winners[0] if len(winners) == 1 else "tie"
+            ] += 1
+
+        switch_code = switch_codes[index]
+        if switch_code != _SCHED_INVALID_SWITCH_CLASS:
+            context_counts["valid"] += 1
+            context_counts[
+                _SCHED_SWITCH_CLASSES[switch_code]
+            ] += 1
+
+        endpoint_cpu_counts["valid"] += 1
+        if endpoint_cpu_changed_values[index]:
+            endpoint_cpu_counts["changed"] += 1
+        else:
+            endpoint_cpu_counts["same_cpu"] += 1
+
+    context_valid = context_counts["valid"]
+    endpoint_cpu_valid = endpoint_cpu_counts["valid"]
+    component_attribution = {}
+    for component in component_values:
+        count = component_counts[component]
+        ratio_count = component_ratio_counts[component]
+        total_ns = component_totals_ns[component]
+        paired_wall_ns = component_wall_totals_ns[component]
+        paired_share = round(
+            total_ns * 100.0 / paired_wall_ns, 6
+        ) if paired_wall_ns else 0.0
+        component_attribution[component] = {
+            "valid_count": count,
+            "coverage_percent_of_tail": _percentage(
+                count, selected_count
+            ),
+            "average_ms": round(
+                total_ns / count / 1_000_000.0, 6
+            ) if count else 0.0,
+            "total_ms": round(total_ns / 1_000_000.0, 6),
+            "mean_of_record_ratios_percent": round(
+                component_ratio_sums[component] / ratio_count, 6
+            ) if ratio_count else 0.0,
+            # Keep the established name as an alias, but make both possible
+            # denominators explicit.  The all-tail value is a lower bound when
+            # this component has invalid records.
+            "aggregate_time_share_percent": paired_share,
+            "aggregate_share_of_valid_paired_wall_percent": paired_share,
+            "aggregate_share_of_all_tail_wall_percent": round(
+                total_ns * 100.0 / wall_total_ns, 6
+            ) if wall_total_ns else 0.0,
+            "aggregate_paired_wall_ms": round(
+                paired_wall_ns / 1_000_000.0, 6
+            ),
+            "ge_50_percent_of_wall": {
+                "count": component_ge_50[component],
+                "percent_of_ratio_valid_records": _percentage(
+                    component_ge_50[component], ratio_count
+                ),
+            },
+            "ge_80_percent_of_wall": {
+                "count": component_ge_80[component],
+                "percent_of_ratio_valid_records": _percentage(
+                    component_ge_80[component], ratio_count
+                ),
+            },
+        }
+
+    return {
+        "threshold_ms": round(threshold_ns / 1_000_000.0, 6),
+        "comparison": ">" if comparison == "gt" else ">=",
+        "count": selected_count,
+        "percent_of_sched_wall_records": _percentage(
+            selected_count, len(walls)
+        ),
+        "wall_average_ms": round(
+            wall_total_ns / selected_count / 1_000_000.0, 6
+        ) if selected_count else 0.0,
+        "wall_total_ms": round(wall_total_ns / 1_000_000.0, 6),
+        "component_attribution": component_attribution,
+        "complete_decomposition": {
+            "valid_count": complete_count,
+            "coverage_percent_of_tail": _percentage(
+                complete_count, selected_count
+            ),
+            "wall_total_ms": round(
+                complete_wall_total_ns / 1_000_000.0, 6
+            ),
+            "component_totals_ms": {
+                component: round(
+                    complete_component_totals_ns[component] / 1_000_000.0,
+                    6,
+                )
+                for component in _SCHED_PARTITION_COMPONENTS
+            },
+            "aggregate_share_percent_of_complete_wall": {
+                component: round(
+                    complete_component_totals_ns[component]
+                    * 100.0
+                    / complete_wall_total_ns,
+                    6,
+                ) if complete_wall_total_ns else 0.0
+                for component in _SCHED_PARTITION_COMPONENTS
+            },
+            "mean_of_record_ratios_percent": {
+                component: round(
+                    complete_component_ratio_sums[component]
+                    / complete_component_ratio_counts[component],
+                    6,
+                ) if complete_component_ratio_counts[component] else 0.0
+                for component in _SCHED_PARTITION_COMPONENTS
+            },
+            "dominant_component_records": {
+                component: {
+                    "count": complete_dominant_counts[component],
+                    "percent_of_complete_records": _percentage(
+                        complete_dominant_counts[component], complete_count
+                    ),
+                }
+                for component in (*_SCHED_PARTITION_COMPONENTS, "tie")
+            },
+            "zero_wall_records": complete_zero_wall,
+            "identity_mismatch_records": complete_identity_mismatch,
+        },
+        "runqueue_attribution": component_attribution["runqueue_wait"],
+        "switch_class_attribution": {
+            "valid_count": context_valid,
+            "coverage_percent_of_tail": _percentage(
+                context_valid, selected_count
+            ),
+            "classes": {
+                name: {
+                    "count": context_counts[name],
+                    "percent_of_context_valid": _percentage(
+                        context_counts[name], context_valid
+                    ),
+                }
+                for name in _SCHED_SWITCH_CLASSES
+            },
+        },
+        "endpoint_cpu_change_attribution": {
+            "valid_count": endpoint_cpu_valid,
+            "changed": endpoint_cpu_counts["changed"],
+            "same_cpu": endpoint_cpu_counts["same_cpu"],
+            "changed_percent_of_valid": _percentage(
+                endpoint_cpu_counts["changed"], endpoint_cpu_valid
+            ),
+        },
+    }
+
+
+def _finalize_sched_tails(phase: dict) -> dict:
+    walls = sorted(phase["tail_wall_ns"])
+    result = {}
+    for threshold_ms in _SCHED_FIXED_TAIL_MS:
+        key = _tail_name(threshold_ms)
+        result[key] = _sched_tail_summary(
+            phase, threshold_ms * 1_000_000.0, "gt"
+        )
+    for percentile in _SCHED_DYNAMIC_TAIL_PERCENTILES:
+        # Match the ordinary percentile spelling used throughout the JSON:
+        # p99, p99_9, p99_99 (rather than the float representation p99_0).
+        percentile_text = (
+            str(int(percentile))
+            if float(percentile).is_integer()
+            else str(percentile).replace(".", "_")
+        )
+        key = f"ge_p{percentile_text}"
+        threshold_ns = _percentile(walls, percentile) if walls else 0.0
+        result[key] = _sched_tail_summary(
+            phase, threshold_ns, "ge"
+        )
+        result[key]["percentile"] = percentile
+    return result
+
+
+def _finalize_sched_phase(phase: dict) -> dict:
+    candidate_count = phase["candidate_records"]
+    sched_valid = phase["sched_valid"]
+    run_delay_valid = phase["run_delay_valid"]
+    latency = {}
+    for component in _SCHED_COMPONENTS:
+        base = candidate_count if component == "wall" else sched_valid
+        latency[component] = _latency_metric(
+            phase["samples"][component],
+            base,
+            coverage_name="coverage_percent_of_component_base",
+        )
+
+    ratios = {
+        component: _sched_ratio_metric(phase, component)
+        for component in _SCHED_RATIO_COMPONENTS
+    }
+    cs = phase["context_switches"]
+    context_valid = cs["valid_records"]
+    endpoint_cpu = phase["endpoint_cpu_change"]
+    endpoint_cpu_valid = endpoint_cpu["valid_records"]
+    return {
+        "candidate_records": candidate_count,
+        "sched_valid": {
+            "count": sched_valid,
+            "percent_of_candidates": _percentage(
+                sched_valid, candidate_count
+            ),
+        },
+        "run_delay_valid": {
+            "count": run_delay_valid,
+            "percent_of_sched_valid": _percentage(
+                run_delay_valid, sched_valid
+            ),
+        },
+        "latency": latency,
+        "ratio_of_wall": ratios,
+        "context_switches": {
+            "valid_count": context_valid,
+            "coverage_percent_of_sched_valid": _percentage(
+                context_valid, sched_valid
+            ),
+            "voluntary_total": cs["voluntary_total"],
+            "involuntary_total": cs["involuntary_total"],
+            "voluntary_avg_per_valid": round(
+                cs["voluntary_total"] / context_valid, 6
+            ) if context_valid else 0.0,
+            "involuntary_avg_per_valid": round(
+                cs["involuntary_total"] / context_valid, 6
+            ) if context_valid else 0.0,
+            "voluntary_histogram": {
+                bucket: cs[f"voluntary_{bucket}"]
+                for bucket in _SCHED_CS_BUCKETS
+            },
+            "involuntary_histogram": {
+                bucket: cs[f"involuntary_{bucket}"]
+                for bucket in _SCHED_CS_BUCKETS
+            },
+            "switch_class": {
+                name: {
+                    "count": cs[f"class_{name}"],
+                    "percent_of_context_valid": _percentage(
+                        cs[f"class_{name}"], context_valid
+                    ),
+                }
+                for name in _SCHED_SWITCH_CLASSES
+            },
+        },
+        "endpoint_cpu_change": {
+            "valid_count": endpoint_cpu_valid,
+            "changed": endpoint_cpu["changed"],
+            "same_cpu": endpoint_cpu["same_cpu"],
+            "changed_percent_of_valid": _percentage(
+                endpoint_cpu["changed"], endpoint_cpu_valid
+            ),
+        },
+        "tail_attribution": _finalize_sched_tails(phase),
+        "quality": _ordered_counter(phase["quality"]),
+    }
+
+
+def _new_sched_rvh_joint_view() -> dict:
+    return {
+        "records": 0,
+        "root_wall_total_ns": 0,
+        "root_runqueue_valid": 0,
+        "root_runqueue_total_ns": 0,
+        "state_counts": Counter(),
+        "rvh_runqueue_valid": 0,
+        "rvh_metric_valid": 0,
+        "rvh_metric_at_same_threshold": 0,
+        "resolved_records": 0,
+        "resolved_root_runqueue_ns": 0,
+        "inside_rvh_runqueue_ns": 0,
+        "outside_rvh_runqueue_ns": 0,
+        "unresolved_records": 0,
+        "unresolved_root_runqueue_ns": 0,
+        "zero_root_runqueue": 0,
+        "inside_ratio_samples": array("d"),
+        "contribution_buckets": Counter(),
+        "record_classification": Counter(),
+    }
