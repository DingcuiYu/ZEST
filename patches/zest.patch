+		/* Publish the descriptor only after all members have been selected.
+		 * valid_mask is temporarily used by the rollback path below to describe
+		 * exactly which cluster allocations succeeded. */
+		sie->zest_chunks[chunk].valid_mask = 0;
+		sie->zest_chunks[chunk].read_inflight = false;
+		sie->zest_chunks[chunk].release_pending = false;
+		for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++)
+			sie->zest_chunks[chunk].slots[i] = entries[i];
+		for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++) {
+			struct swap_cluster_info *ci;
+			slot = swp_offset(entries[i]);
+			ci = lock_cluster(si, slot);
+			if (!cluster_alloc_range(si, ci, slot, SWAP_HAS_CACHE, 0)) {
+				unlock_cluster(ci);
+				goto rollback_chunk;
+			}
+			unlock_cluster(ci);
+			allocated_mask |= 1u << i;
+			/* cluster_alloc_range() already updates the generic in-use and
+			 * availability accounting for this slot.  The global
+			 * nr_swap_pages charge was taken once for the complete eight-slot
+			 * descriptor and is returned only when the descriptor dies. */
+		}
+		sie->zest_chunks[chunk].valid_mask =
+			(1u << ZEST_SWAP_CHUNK_PAGES) - 1;
+		smp_wmb();
+		set_bit(chunk, sie->zest_chunk_alloc);
+		sie->zest_chunk_free--;
+		allocated = true;
+		spin_unlock(&si->lock);
+		if (!allocated)
+			atomic_long_add(ZEST_SWAP_CHUNK_PAGES, &nr_swap_pages);
+		return allocated;
+	no_chunk:
+		for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++)
+			entries[i].val = 0;
+		goto retry_account;
+	rollback_chunk:
+		/* Undo every successful cluster allocation before dropping the swap
+		 * device lock.  swap_range_free() also performs the descriptor-aware
+		 * capacity return exactly once (when the temporary valid_mask reaches
+		 * zero), so the eight pages charged above are fully refunded. */
+		sie->zest_chunks[chunk].valid_mask = allocated_mask;
+		for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++) {
+			struct swap_cluster_info *ci;
+
+			if (!(allocated_mask & (1u << i)))
+				continue;
+			slot = swp_offset(entries[i]);
+			ci = lock_cluster(si, slot);
+			if (READ_ONCE(si->swap_map[slot]) == SWAP_HAS_CACHE) {
+				WRITE_ONCE(si->swap_map[slot], 0);
+				dec_cluster_info_page(si, ci, 1);
+			}
+			unlock_cluster(ci);
+			swap_range_free(si, slot, 1);
+		}
+		if (!allocated_mask)
+			atomic_long_add(ZEST_SWAP_CHUNK_PAGES, &nr_swap_pages);
+		for (i = 0; i < ZEST_SWAP_CHUNK_PAGES; i++)
+			entries[i].val = 0;
+		spin_unlock(&si->lock);
+		return false;
+retry_account:
+		spin_unlock(&si->lock);
+		atomic_long_add(ZEST_SWAP_CHUNK_PAGES, &nr_swap_pages);
+		return false;
+	}
+out_unlock:
+	spin_unlock(&swap_avail_lock);
+	return false;
+}
