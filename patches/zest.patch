+	u64		chunk_member_cache_hits;
+	u64		chunk_member_bio_submitted;
+	u64		chunk_member_read_errors;
+	u64		chunk_read_from_wbuf;
+	u64		chunk_read_from_device;
+};
+void zest_gc_collect_stats(struct zest_gc_stats_sum *s);
+
