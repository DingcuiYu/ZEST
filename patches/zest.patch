+def _print_sched_rvh_joint_summary(joint: dict) -> None:
+    print(
+        "    [swapin/root_rvh_joint] "
+        f"records={joint['record_count']:,}, "
+        f"root_sched_valid={joint['root_scheduler_valid_records']:,}, "
+        f"root_runqueue_valid={joint['root_runqueue_valid_records']:,}"
+    )
+    for family_name, selector_label in (
+        ("root_wall_tails", "root-wall"),
+        ("root_runqueue_tails", "root-R"),
+    ):
+        for tail_name in (
+            "gt_1ms",
+            "gt_10ms",
+            "gt_100ms",
+            "ge_p99",
+            "ge_p99_9",
+            "ge_p99_99",
+        ):
+            tail = joint[family_name][tail_name]
+            all_view = tail["all_tail"]
+            all_decomp = all_view["runqueue_decomposition"]
+            all_share = all_decomp[
+                "share_percent_of_resolved_root_runqueue"
+            ]
+            all_bounds = all_decomp[
+                "bounds_percent_of_all_valid_root_runqueue"
+            ]
+            dominated = tail["scheduler_dominated"]
+            dominated_decomp = dominated["runqueue_decomposition"]
+            dominated_share = dominated_decomp[
+                "share_percent_of_resolved_root_runqueue"
+            ]
+            classes = dominated_decomp["record_classification"]
+            called = all_view["rvh_presence"]["called"]["count"]
+            rvh_same = all_view["rvh_metric_at_same_threshold"]
+            rvh_same_threshold = rvh_same["count"]
+            print(
+                f"      joint {selector_label:<9} {tail_name:<9} "
+                f"threshold={tail['threshold_ms']:.6f}ms "
+                f"root-tail={tail['root_tail_records']:,}/"
+                f"{tail['selector_population']:,} "
+                f"({tail['percent_of_selector_population']:.6f}%), "
+                f"RVH-called={called:,}, "
+                "RVH-same-threshold="
+                f"{rvh_same_threshold:,}/"
+                f"{rvh_same['valid_count']:,} valid "
+                f"({rvh_same['percent_of_rvh_metric_valid']:.6f}%), "
+                "all resolved-R(time)="
+                f"{all_decomp['resolved_time_coverage_percent_of_valid_root_runqueue']:.6f}%, "
+                "inside/outside="
+                f"{all_share['inside_rvh']:.6f}%/"
+                f"{all_share['outside_rvh']:.6f}%, "
+                "inside-bound="
+                f"{all_bounds['inside_rvh_lower']:.6f}%.."
+                f"{all_bounds['inside_rvh_upper']:.6f}%; "
+                f"sched-dom={dominated['records']:,}, "
+                "sched inside/outside="
+                f"{dominated_share['inside_rvh']:.6f}%/"
+                f"{dominated_share['outside_rvh']:.6f}%, "
+                "records RVH/outside/mixed/unresolved="
+                f"{classes['rvh_dominant']['count']:,}/"
+                f"{classes['outside_dominant']['count']:,}/"
+                f"{classes['mixed']['count']:,}/"
+                f"{classes['rvh_unresolved']['count']:,}"
+            )
+    if joint["quality"]:
+        print(
+            "      root/RVH joint quality: "
+            + ", ".join(
+                f"{name}={count:,}"
+                for name, count in joint["quality"].items()
+            )
+        )
