+	/* Latch the userspace-selected layout for the entire swapon transaction,
+	 * not only after zest_init publishes its singleton.  This applies to the
+	 * legacy layout too: otherwise a concurrent sysfs write could switch the
+	 * global mode between extent preparation and Zest attach, producing a
+	 * mixed legacy/chunk swapfile. */
+	sie->zest_layout_latched = true;
+	atomic_set(&zest_readahead_latched, 1);
+	return 0;
