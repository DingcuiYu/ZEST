+unsigned int f2fs_zest_blkaddr_to_dev_local(struct f2fs_sb_info *sbi,
+					    unsigned int blkaddr);
+
+/*
+ * zest3: auto-reserve an over-provisioning (OP) region by extending the
+ * swapfile inode with extra pinned, zoned sections (reuses the fallocate
+ * pinning path). The blocks live beyond the swap-visible size so mm never
+ * sees them. Reuse-aware (no-op if the inode already extends past
+ * @swap_blocks) and best-effort on ENOSPC. Block units are F2FS blocks.
+ * On return *out_start_lblk = @swap_blocks and *out_nr_blocks is the full
+ * OP region length (0 if none). Returns 0 on success (incl. best-effort
+ * partial / OP=0), negative errno only on hard failure with nothing reserved.
