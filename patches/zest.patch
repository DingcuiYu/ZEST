+		  "byte_range=[%llu,%llu) Byte "
+		  "range_size=%llu Byte (%llu KiB, %llu MiB, %llu GiB) "
+		  "total=%llu slots/%llu Byte (%llu KiB, %llu MiB, %llu GiB) "
+		  "chunks=%lu\n",
+		  si->type,
+		  first_good_slot, last_good_slot,
+		  (unsigned long long)legal_start_bytes,
+		  (unsigned long long)legal_end_bytes,
+		  (unsigned long long)legal_span_bytes,
+		  (unsigned long long)(legal_span_bytes >> 10),
+		  (unsigned long long)(legal_span_bytes >> 20),
+		  (unsigned long long)(legal_span_bytes >> 30),
+		  (unsigned long long)keep_slots,
+		  (unsigned long long)total_bytes,
+		  (unsigned long long)(total_bytes >> 10),
+		  (unsigned long long)(total_bytes >> 20),
+		  (unsigned long long)(total_bytes >> 30),
+		  nr_chunks);
+	return 0;
+}
