diff --git a/mm/swap_lifecycle_trace.c b/mm/swap_lifecycle_trace.c
new file mode 100644
index 0000000000000000000000000000000000000000..5f9804faae2e63ca432d5a88f073479e4d4a2071
--- /dev/null
+++ b/mm/swap_lifecycle_trace.c
@@ -0,0 +1,1297 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Swap-slot lifecycle tracer.
+ *
+ * Emits one fixed-size binary record per lifecycle event: slot allocation,
+ * swap-PTE installation (VMA bind), swap-out submission, swap-in fault,
+ * swap-in I/O, final release, and device discard.  Records are written to
+ * a vmalloc'ed buffer exposed through debugfs and paired offline.
+ *
+ * Design rules learned from the retired swap_sequence/swap_slot_lifetime
+ * tracers, which lost about half of all slot invalidations:
+ *
+ *  1. Emission never depends on per-slot metadata.  A FREE for a slot the
+ *     tracer never saw allocated (pre-session slot, metadata allocation
+ *     failure) is still logged, flagged SWAP_LC_F_NO_META, instead of being
+ *     silently dropped.
+ *  2. Stopping a session dumps an ALIVE record for every slot still
+ *     allocated, so lifetimes that span the session end are visible
+ *     instead of being discarded with the metadata cache.
+ *  3. A full record buffer stops record writes but not event counting:
+ *     the header keeps exact per-event totals so coverage can always be
+ *     computed offline.
+ *  4. Metadata uses a slab cache with GFP_ATOMIC (reserve access), because
+ *     these paths run exactly when the system is under reclaim pressure
+ *     and GFP_NOWAIT failures were a measurable loss source.
+ *  5. An ALLOC that finds stale metadata means the instrumentation itself
+ *     missed a FREE; it is flagged SWAP_LC_F_STALE_META and counted so
+ *     hook-coverage bugs are measurable rather than silent.
+ */
+
+#include <linux/atomic.h>
+#include <linux/build_bug.h>
+#include <linux/cred.h>
+#include <linux/debugfs.h>
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/ktime.h>
+#include <linux/limits.h>
+#include <linux/mm.h>
+#include <linux/mm_inline.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/oom.h>
+#include <linux/preempt.h>
+#include <linux/rcupdate.h>
+#include <linux/sched.h>
+#include <linux/sched/mm.h>
+#include <linux/seq_file.h>
+#include <linux/slab.h>
+#include <linux/smp.h>
+#include <linux/spinlock.h>
+#include <linux/stacktrace.h>
+#include <linux/string.h>
+#include <linux/swap.h>
+#include <linux/uaccess.h>
+#include <linux/uidgid.h>
+#include <linux/user_namespace.h>
+#include <linux/utsname.h>
+#include <linux/vmalloc.h>
+#include <linux/wait.h>
+#include <linux/xarray.h>
+
+#include "swap.h"
+#include "swap_lifecycle_trace.h"
+
+#define TRACE_DIR		"swap_lifecycle_trace"
+#define TRACE_DEFAULT_MB	256U
+#define TRACE_MIN_MB		1U
+#define TRACE_MAX_MB		4096U
+#define TRACE_VERSION		1U
+#define TRACE_HEADER_SIZE	256U
+#define TRACE_RECORD_SIZE	192U
+#define TRACE_EVENT_TYPES	8U
+
+struct swap_lc_log_header {
+	u8 magic[8];
+	u32 version;
+	u32 header_size;
+	u32 record_size;
+	u32 endian;
+	u64 buffer_bytes;
+	u64 capacity;
+	u64 records;
+	u64 session;
+	u64 start_ns;
+	u64 stop_ns;
+	u32 stopped_full;
+	u32 enabled;
+	/* indexed by event_type - 1 */
+	u64 event_count[TRACE_EVENT_TYPES];
+	u64 dropped_full;
+	u64 meta_nomem;
+	u64 stale_meta;
+	u64 free_no_meta;
+	char kernel_release[64];
+	u8 reserved[16];
+};
+
+struct swap_lc_record {
+	u64 seq;
+	u64 ts_ns;
+	u16 event_type;
+	u16 cpu;
+	u32 pid;
+	u32 tgid;
+	u32 uid;		/* current task's uid at the event */
+	u64 swap_entry;		/* swp_entry_t.val */
+	u64 address;		/* faulting/bound virtual address */
+	u64 vma_start;
+	u64 vma_end;
+	u64 mm_id;
+	u64 vm_flags;		/* raw vma->vm_flags */
+	u64 sector;		/* 512B LBA for SWAPOUT/SWAPIN_IO/DISCARD */
+	u32 nr_pages;
+	u32 flags;
+	u32 result;
+	u32 reason;
+	u32 page_state;
+	s32 oom_score_adj;	/* mm owner's score, not current's */
+	u32 owner_uid;		/* mm owner's uid, not current's */
+	u8 lru_gen_age;		/* MGLRU age at eviction, 0xff = invalid */
+	u8 vma_type;
+	u16 reserved;
+	char vma_name[SWAP_LIFECYCLE_VMA_NAME_LEN];
+};
+
+/* Enrichment state for a live slot, keyed by swp_entry_t.val. */
+struct swap_lc_meta {
+	u64 alloc_ns;
+	u64 mm_id;
+	u64 vma_start;
+	u64 vma_end;
+	u64 address;
+	u64 vm_flags;
+	u32 owner_uid;
+	s32 oom_score_adj;
+	u32 page_state;
+	u32 flags;
+	u32 release_reason;
+	u32 release_flags;
+	u32 nr_pages;
+	u8 lru_gen_age;
+	u8 vma_type;
+	u8 out_seen;
+	u8 pad;
+	char vma_name[SWAP_LIFECYCLE_VMA_NAME_LEN];
+};
+
+struct swap_lc_buffer {
+	void *memory;
+	unsigned long bytes;
+	u64 capacity;
+	u64 session;
+	u64 start_ns;
+	u64 stop_ns;
+	atomic64_t next_record ____cacheline_aligned_in_smp;
+	atomic64_t event_count[TRACE_EVENT_TYPES];
+	atomic64_t dropped_full;
+	atomic64_t meta_nomem;
+	atomic64_t stale_meta;
+	atomic64_t free_no_meta;
+	atomic_t full_reported;
+	bool stopped_full;
+	bool sealed;
+};
+
+struct swap_lc_reader {
+	struct swap_lc_buffer *buffer;
+	loff_t length;
+};
+
+static DEFINE_XARRAY(swap_lc_slots);
+static DEFINE_SPINLOCK(swap_lc_slots_lock);
+static DEFINE_MUTEX(swap_lc_control_lock);
+static DECLARE_WAIT_QUEUE_HEAD(swap_lc_active_wait);
+static atomic_t swap_lc_enabled ____cacheline_aligned_in_smp = ATOMIC_INIT(0);
+static atomic_t swap_lc_active ____cacheline_aligned_in_smp = ATOMIC_INIT(0);
+static atomic64_t swap_lc_next_session;
+static struct swap_lc_buffer __rcu *swap_lc_buffer;
+static struct kmem_cache *swap_lc_meta_cache __ro_after_init;
+static struct dentry *swap_lc_debugfs_root;
+static unsigned int swap_lc_buffer_mb = TRACE_DEFAULT_MB;
+static unsigned int swap_lc_readers;
+
+static_assert(sizeof(struct swap_lc_log_header) == TRACE_HEADER_SIZE);
+static_assert(sizeof(struct swap_lc_record) == TRACE_RECORD_SIZE);
+static_assert(offsetof(struct swap_lc_record, swap_entry) == 32);
+static_assert(offsetof(struct swap_lc_record, vm_flags) == 72);
+static_assert(offsetof(struct swap_lc_record, nr_pages) == 88);
+static_assert(offsetof(struct swap_lc_record, owner_uid) == 112);
+static_assert(offsetof(struct swap_lc_record, vma_name) == 120);
+static_assert(offsetof(struct swap_lc_log_header, event_count) == 80);
+static_assert(offsetof(struct swap_lc_log_header, kernel_release) == 176);
+
+static inline bool swap_lc_enabled_now(void)
+{
+	return atomic_read_acquire(&swap_lc_enabled);
+}
+
+static inline void swap_lc_active_put(void)
+{
+	if (atomic_dec_and_test(&swap_lc_active))
+		wake_up_all(&swap_lc_active_wait);
+}
+
+static inline struct swap_lc_record *swap_lc_record_at(
+		struct swap_lc_buffer *b, u64 i)
+{
+	return (struct swap_lc_record *)((u8 *)b->memory + TRACE_HEADER_SIZE +
+			i * TRACE_RECORD_SIZE);
+}
+
+/*
+ * Enter the fast path: returns the buffer with the active count held, or
+ * NULL.  The caller must call swap_lc_active_put() when non-NULL.
+ */
+static struct swap_lc_buffer *swap_lc_enter(void)
+{
+	struct swap_lc_buffer *b;
+
+	if (!swap_lc_enabled_now())
+		return NULL;
+	rcu_read_lock();
+	b = rcu_dereference(swap_lc_buffer);
+	if (!b || READ_ONCE(b->sealed)) {
+		rcu_read_unlock();
+		return NULL;
+	}
+	atomic_inc(&swap_lc_active);
+	/* Pair with the disable-side recheck before waiting for updaters. */
+	smp_mb__after_atomic();
+	if (!swap_lc_enabled_now() || READ_ONCE(b->sealed)) {
+		swap_lc_active_put();
+		rcu_read_unlock();
+		return NULL;
+	}
+	rcu_read_unlock();
+	return b;
+}
+
+static void swap_lc_owner_values(struct mm_struct *mm, u32 *uid, s32 *oom)
+{
+	struct task_struct *owner = NULL;
+
+	*uid = SWAP_LC_UNKNOWN_UID;
+	*oom = SWAP_LC_UNKNOWN_OOM;
+	rcu_read_lock();
+#ifdef CONFIG_MEMCG
+	owner = mm ? rcu_dereference(mm->owner) : NULL;
+#endif
+	if (!owner && mm && mm == current->mm)
+		owner = current;
+	if (owner) {
+		*uid = from_kuid_munged(&init_user_ns, task_uid(owner));
+		*oom = READ_ONCE(owner->signal->oom_score_adj);
+	}
+	rcu_read_unlock();
+}
+
+static bool swap_lc_name_contains(const char *name, const char *needle)
+{
+	size_t needle_len = strlen(needle);
+
+	while (*name) {
+		if (!strncasecmp(name, needle, needle_len))
+			return true;
+		name++;
+	}
+	return false;
+}
+
+static u8 swap_lc_vma_type_from_name(struct vm_area_struct *vma,
+		const char *name)
+{
+	if (vma->vm_file && !strncasecmp(name, "[file]", sizeof("[file]") - 1))
+		return SWAP_LC_VMA_FILE_BACKED;
+	if (name[0]) {
+		if (swap_lc_name_contains(name, "java") ||
+		    swap_lc_name_contains(name, "dalvik") ||
+		    swap_lc_name_contains(name, "art"))
+			return SWAP_LC_VMA_JAVA_HEAP;
+		if (swap_lc_name_contains(name, "heap"))
+			return SWAP_LC_VMA_HEAP;
+		if (swap_lc_name_contains(name, "stack"))
+			return SWAP_LC_VMA_STACK;
+		return SWAP_LC_VMA_NAMED_ANON;
+	}
+	if (vma_is_initial_heap(vma))
+		return SWAP_LC_VMA_HEAP;
+	if (vma_is_initial_stack(vma))
+		return SWAP_LC_VMA_STACK;
+	if (vma->vm_file)
+		return SWAP_LC_VMA_FILE_BACKED;
+	return SWAP_LC_VMA_UNNAMED_ANON;
+}
+
+/*
+ * Read the vma name and classification.  anon_vma_name() requires the
+ * mmap lock; VMA_BIND runs from reclaim's rmap walk which does not hold
+ * it, so a non-blocking read trylock is used there (mmap_locked=false).
+ * Returns false when the name could not be inspected.
+ */
+static bool swap_lc_vma_values(struct vm_area_struct *vma, u8 *type,
+		char *name, bool mmap_locked)
+{
+	bool took_mmap_lock = false;
+
+	*type = SWAP_LC_VMA_UNKNOWN;
+	name[0] = '\0';
+	if (!vma)
+		return false;
+
+#ifdef CONFIG_ANON_VMA_NAME
+	{
+		struct anon_vma_name *anon_name;
+
+		if (!mmap_locked) {
+			if (!mmap_read_trylock(vma->vm_mm))
+				return false;
+			took_mmap_lock = true;
+		}
+		anon_name = anon_vma_name(vma);
+		if (anon_name)
+			strscpy(name, anon_name->name,
+				SWAP_LIFECYCLE_VMA_NAME_LEN);
+	}
+#else
+	(void)mmap_locked;
+#endif
+	if (!name[0] && vma_is_initial_heap(vma))
+		strscpy(name, "[heap]", SWAP_LIFECYCLE_VMA_NAME_LEN);
+	else if (!name[0] && vma_is_initial_stack(vma))
+		strscpy(name, "[stack]", SWAP_LIFECYCLE_VMA_NAME_LEN);
+	else if (!name[0] && vma->vm_file)
+		strscpy(name, "[file]", SWAP_LIFECYCLE_VMA_NAME_LEN);
+	*type = swap_lc_vma_type_from_name(vma, name);
+	if (took_mmap_lock)
+		mmap_read_unlock(vma->vm_mm);
+	return true;
+}
+
+static u32 swap_lc_mapcount_bucket(int mapcount)
+{
+	if (mapcount <= 0)
+		return 0;
+	if (mapcount == 1)
+		return 1;
+	if (mapcount <= 3)
+		return 2;
+	return 3;
+}
+
+static u32 swap_lc_folio_state(struct folio *folio)
+{
+	u32 state = 0;
+
+	if (!folio)
+		return 0;
+	if (folio_test_anon(folio))
+		state |= SWAP_LC_PAGE_FOLIO_ANON;
+	if (folio_test_swapbacked(folio))
+		state |= SWAP_LC_PAGE_FOLIO_SWAPBACKED;
+	if (folio_test_referenced(folio))
+		state |= SWAP_LC_PAGE_FOLIO_REFERENCED;
+	if (folio_test_workingset(folio))
+		state |= SWAP_LC_PAGE_FOLIO_WORKINGSET;
+	if (folio_test_active(folio))
+		state |= SWAP_LC_PAGE_FOLIO_ACTIVE;
+	state |= swap_lc_mapcount_bucket(folio_mapcount(folio)) <<
+		SWAP_LC_PAGE_MAPCOUNT_SHIFT;
+	return state;
+}
+
+static u32 swap_lc_vma_state(struct vm_area_struct *vma)
+{
+	vm_flags_t vm_flags;
+	u32 state = 0;
+
+	if (!vma)
+		return 0;
+	vm_flags = READ_ONCE(vma->vm_flags);
+	if (READ_ONCE(vma->vm_file))
+		state |= SWAP_LC_PAGE_VMA_HAS_FILE;
+	if (vm_flags & VM_SHARED)
+		state |= SWAP_LC_PAGE_VMA_SHARED;
+	if (vm_flags & VM_SEQ_READ)
+		state |= SWAP_LC_PAGE_VMA_SEQ_READ;
+	if (vm_flags & VM_RAND_READ)
+		state |= SWAP_LC_PAGE_VMA_RAND_READ;
+	if (vm_flags & VM_EXEC)
+		state |= SWAP_LC_PAGE_VMA_EXEC;
+	if (vm_flags & VM_WRITE)
+		state |= SWAP_LC_PAGE_VMA_WRITE;
+	return state;
+}
+
+/*
+ * Conservative call-stack classification for free paths that did not
+ * provide a structured reason.  Captured addresses never leave the
+ * kernel; only the classification does.
+ */
+static u32 swap_lc_stack_release_reason(void)
+{
+#ifdef CONFIG_STACKTRACE
+	unsigned long entries[16];
+	unsigned int i, nr;
+
+	/* Some final range-free paths run outside task context. */
+	if (!in_task())
+		return SWAP_LC_RELEASE_NONE;
+	nr = stack_trace_save(entries, ARRAY_SIZE(entries), 1);
+	for (i = 0; i < nr; i++) {
+		if (entries[i] == (unsigned long)do_swap_page)
+			return SWAP_LC_RELEASE_SWAPIN_REF_ZERO;
+		if (entries[i] == (unsigned long)exit_mmap)
+			return SWAP_LC_RELEASE_PROCESS_EXIT;
+		if (entries[i] == (unsigned long)__oom_reap_task_mm)
+			return SWAP_LC_RELEASE_OOM_REAPER;
+	}
+#endif
+	return SWAP_LC_RELEASE_NONE;
+}
+
+static u32 swap_lc_resolve_release_reason(u32 explicit_reason, u32 *flags)
+{
+	u32 stack_reason = swap_lc_stack_release_reason();
+
+	if (explicit_reason != SWAP_LC_RELEASE_NONE &&
+	    explicit_reason != SWAP_LC_RELEASE_OTHER) {
+		if (stack_reason != SWAP_LC_RELEASE_NONE &&
+		    stack_reason != explicit_reason)
+			*flags |= SWAP_LC_F_REASON_CONFLICT;
+		return explicit_reason;
+	}
+	if (stack_reason != SWAP_LC_RELEASE_NONE)
+		return stack_reason;
+	return SWAP_LC_RELEASE_OTHER;
+}
+
+static bool swap_lc_meta_copy(swp_entry_t entry, struct swap_lc_meta *out)
+{
+	struct swap_lc_meta *m;
+	unsigned long irqflags;
+	bool found = false;
+
+	spin_lock_irqsave(&swap_lc_slots_lock, irqflags);
+	m = xa_load(&swap_lc_slots, entry.val);
+	if (m) {
+		*out = *m;
+		found = true;
+	}
+	spin_unlock_irqrestore(&swap_lc_slots_lock, irqflags);
+	return found;
+}
+
+/*
+ * Reserve a slot and fill the record.  Does not check the enabled state;
+ * callers either hold the active count (hooks) or have quiesced all
+ * hooks (the stop-time ALIVE dump).
+ */
+static void swap_lc_write_record(struct swap_lc_buffer *b, u16 type,
+		swp_entry_t entry, const struct swap_lc_meta *meta,
+		struct folio *folio, struct vm_area_struct *vma,
+		unsigned long address, u64 sector, u32 nr_pages, u32 flags,
+		u32 result, u32 reason, bool vma_mmap_locked)
+{
+	struct swap_lc_record *r;
+	u64 idx;
+
+	atomic64_inc(&b->event_count[type - 1]);
+	idx = atomic64_fetch_inc_relaxed(&b->next_record);
+	if (unlikely(idx >= b->capacity)) {
+		atomic64_inc(&b->dropped_full);
+		WRITE_ONCE(b->stopped_full, true);
+		if (atomic_cmpxchg(&b->full_reported, 0, 1) == 0)
+			pr_info("swap_lifecycle_trace: log full at %llu records; events are still counted but no longer recorded\n",
+				b->capacity);
+		return;
+	}
+
+	r = swap_lc_record_at(b, idx);
+	memset(r, 0, sizeof(*r));
+	r->seq = idx;
+	r->ts_ns = (type == SWAP_LC_EVENT_ALIVE && meta) ?
+		meta->alloc_ns : ktime_get_ns();
+	r->event_type = type;
+	preempt_disable();
+	r->cpu = (u16)raw_smp_processor_id();
+	preempt_enable();
+	r->pid = task_pid_nr(current);
+	r->tgid = task_tgid_nr(current);
+	r->uid = from_kuid_munged(&init_user_ns, current_uid());
+	r->swap_entry = entry.val;
+	r->sector = sector;
+	r->flags = flags;
+	r->result = result;
+	r->reason = reason;
+	r->owner_uid = SWAP_LC_UNKNOWN_UID;
+	r->oom_score_adj = SWAP_LC_UNKNOWN_OOM;
+	r->lru_gen_age = SWAP_LC_LRU_GEN_INVALID;
+
+	/* Start from the cached slot state, then let live sources override. */
+	if (meta) {
+		r->mm_id = meta->mm_id;
+		r->vma_start = meta->vma_start;
+		r->vma_end = meta->vma_end;
+		r->address = meta->address;
+		r->vm_flags = meta->vm_flags;
+		r->owner_uid = meta->owner_uid;
+		r->oom_score_adj = meta->oom_score_adj;
+		r->page_state = meta->page_state;
+		r->nr_pages = meta->nr_pages;
+		r->lru_gen_age = meta->lru_gen_age;
+		r->vma_type = meta->vma_type;
+		r->flags |= meta->flags;
+		strscpy(r->vma_name, meta->vma_name,
+			SWAP_LIFECYCLE_VMA_NAME_LEN);
+	}
+	if (folio) {
+		r->nr_pages = folio_nr_pages(folio);
+		r->page_state = (r->page_state & SWAP_LC_PAGE_VMA_MASK) |
+			swap_lc_folio_state(folio);
+	}
+	if (vma) {
+		u8 vma_type;
+
+		r->mm_id = (u64)(unsigned long)vma->vm_mm;
+		r->vma_start = vma->vm_start;
+		r->vma_end = vma->vm_end;
+		r->vm_flags = (u64)READ_ONCE(vma->vm_flags);
+		r->page_state = (r->page_state & ~SWAP_LC_PAGE_VMA_MASK) |
+			swap_lc_vma_state(vma);
+		swap_lc_owner_values(vma->vm_mm, &r->owner_uid,
+			&r->oom_score_adj);
+		if (swap_lc_vma_values(vma, &vma_type, r->vma_name,
+				vma_mmap_locked))
+			r->vma_type = vma_type;
+		else if (!meta)
+			r->flags |= SWAP_LC_F_VMA_UNKNOWN;
+	}
+	if (address || vma)
+		r->address = address;
+	if (nr_pages)
+		r->nr_pages = nr_pages;
+}
+
+static void swap_lc_emit(u16 type, swp_entry_t entry,
+		const struct swap_lc_meta *meta, struct folio *folio,
+		struct vm_area_struct *vma, unsigned long address,
+		u64 sector, u32 nr_pages, u32 flags, u32 result, u32 reason,
+		bool vma_mmap_locked)
+{
+	struct swap_lc_buffer *b = swap_lc_enter();
+
+	if (!b)
+		return;
+	swap_lc_write_record(b, type, entry, meta, folio, vma, address,
+		sector, nr_pages, flags, result, reason, vma_mmap_locked);
+	swap_lc_active_put();
+}
+
+void swap_lifecycle_trace_alloc(swp_entry_t entry, struct folio *folio,
+		unsigned int nr_pages, u32 result)
+{
+	struct swap_lc_buffer *b;
+	unsigned int i;
+
+	if (!entry.val)
+		return;
+	b = swap_lc_enter();
+	if (!b)
+		return;
+
+	for (i = 0; i < nr_pages; i++) {
+		swp_entry_t e = (swp_entry_t){ .val = entry.val + i };
+		struct swap_lc_meta *m, *old = NULL;
+		unsigned long irqflags;
+		u32 flags = 0;
+
+		m = kmem_cache_zalloc(swap_lc_meta_cache,
+				GFP_ATOMIC | __GFP_NOWARN);
+		if (m) {
+			m->alloc_ns = ktime_get_ns();
+			m->nr_pages = nr_pages;
+			m->page_state = swap_lc_folio_state(folio);
+			m->owner_uid = SWAP_LC_UNKNOWN_UID;
+			m->oom_score_adj = SWAP_LC_UNKNOWN_OOM;
+			m->lru_gen_age = SWAP_LC_LRU_GEN_INVALID;
+			spin_lock_irqsave(&swap_lc_slots_lock, irqflags);
+			old = xa_store(&swap_lc_slots, e.val, m, GFP_ATOMIC);
+			spin_unlock_irqrestore(&swap_lc_slots_lock, irqflags);
+			if (xa_is_err(old)) {
+				kmem_cache_free(swap_lc_meta_cache, m);
+				old = NULL;
+				m = NULL;
+			}
+		}
+		if (!m) {
+			atomic64_inc(&b->meta_nomem);
+			flags |= SWAP_LC_F_NO_META;
+		}
+		if (old) {
+			/* A FREE was missed for the previous owner. */
+			atomic64_inc(&b->stale_meta);
+			flags |= SWAP_LC_F_STALE_META;
+			kmem_cache_free(swap_lc_meta_cache, old);
+		}
+		swap_lc_write_record(b, SWAP_LC_EVENT_ALLOC, e, NULL, folio,
+			NULL, 0, 0, nr_pages, flags, result,
+			SWAP_LC_RELEASE_NONE, false);
+	}
+	swap_lc_active_put();
+}
+
+void swap_lifecycle_trace_set_lru_gen_age(swp_entry_t entry,
+		unsigned int nr_pages, int age)
+{
+	struct swap_lc_buffer *b;
+	unsigned long irqflags;
+	unsigned int i;
+	u8 age8;
+
+	if (!entry.val || age < 0)
+		return;
+	b = swap_lc_enter();
+	if (!b)
+		return;
+	age8 = min_t(int, age, SWAP_LC_LRU_GEN_AGE_MAX);
+	spin_lock_irqsave(&swap_lc_slots_lock, irqflags);
+	for (i = 0; i < nr_pages; i++) {
+		struct swap_lc_meta *m =
+			xa_load(&swap_lc_slots, entry.val + i);
+
+		if (m)
+			m->lru_gen_age = age8;
+	}
+	spin_unlock_irqrestore(&swap_lc_slots_lock, irqflags);
+	swap_lc_active_put();
+}
+
+void swap_lifecycle_trace_vma_bind(swp_entry_t entry,
+		struct vm_area_struct *vma, unsigned long address,
+		struct folio *folio, bool pte_young)
+{
+	struct swap_lc_buffer *b;
+	struct swap_lc_meta *m, *old;
+	struct swap_lc_meta snapshot;
+	unsigned long irqflags;
+	bool has_vma_identity;
+
+	if (!entry.val || !vma)
+		return;
+	b = swap_lc_enter();
+	if (!b)
+		return;
+
+	m = kmem_cache_zalloc(swap_lc_meta_cache, GFP_ATOMIC | __GFP_NOWARN);
+	if (!m) {
+		atomic64_inc(&b->meta_nomem);
+		/* Still emit the event itself, unenriched. */
+		swap_lc_write_record(b, SWAP_LC_EVENT_VMA_BIND, entry, NULL,
+			folio, vma, address, 0, 0,
+			SWAP_LC_F_NO_META | (pte_young ? SWAP_LC_F_PTE_YOUNG : 0),
+			0, SWAP_LC_RELEASE_NONE, false);
+		swap_lc_active_put();
+		return;
+	}
+	m->alloc_ns = ktime_get_ns();
+	m->mm_id = (u64)(unsigned long)vma->vm_mm;
+	m->vma_start = vma->vm_start;
+	m->vma_end = vma->vm_end;
+	m->address = address;
+	m->vm_flags = (u64)READ_ONCE(vma->vm_flags);
+	m->nr_pages = folio ? folio_nr_pages(folio) : 0;
+	m->page_state = swap_lc_folio_state(folio) | swap_lc_vma_state(vma);
+	m->lru_gen_age = SWAP_LC_LRU_GEN_INVALID;
+	if (pte_young)
+		m->flags |= SWAP_LC_F_PTE_YOUNG;
+	if (!swap_lc_vma_values(vma, &m->vma_type, m->vma_name, false))
+		m->flags |= SWAP_LC_F_VMA_UNKNOWN;
+	swap_lc_owner_values(vma->vm_mm, &m->owner_uid, &m->oom_score_adj);
+
+	spin_lock_irqsave(&swap_lc_slots_lock, irqflags);
+	old = xa_load(&swap_lc_slots, entry.val);
+	has_vma_identity = old && !(old->flags & SWAP_LC_F_VMA_UNKNOWN) &&
+		(old->mm_id || old->vma_start || old->vma_end ||
+		 old->vma_name[0]);
+	if (m->vma_type != SWAP_LC_VMA_UNKNOWN && has_vma_identity &&
+	    (old->mm_id != m->mm_id ||
+	     old->vma_start != m->vma_start ||
+	     old->vma_end != m->vma_end ||
+	     old->vma_type != m->vma_type ||
+	     strcmp(old->vma_name, m->vma_name)))
+		m->flags |= SWAP_LC_F_VMA_AMBIGUOUS;
+	if (old) {
+		m->alloc_ns = old->alloc_ns;
+		m->flags |= old->flags & SWAP_LC_F_VMA_AMBIGUOUS;
+		m->out_seen = old->out_seen;
+		m->release_reason = old->release_reason;
+		m->release_flags = old->release_flags;
+		if (old->lru_gen_age != SWAP_LC_LRU_GEN_INVALID)
+			m->lru_gen_age = old->lru_gen_age;
+		if (!m->nr_pages)
+			m->nr_pages = old->nr_pages;
+	}
+	snapshot = *m;
+	if (m->flags & SWAP_LC_F_VMA_AMBIGUOUS) {
+		/* Keep only what is unambiguous for later enrichment. */
+		m->mm_id = 0;
+		m->vma_start = 0;
+		m->vma_end = 0;
+		m->address = 0;
+		m->vm_flags = 0;
+		m->owner_uid = SWAP_LC_UNKNOWN_UID;
+		m->oom_score_adj = SWAP_LC_UNKNOWN_OOM;
+		m->vma_type = SWAP_LC_VMA_UNKNOWN;
+		m->vma_name[0] = '\0';
+		m->page_state &= ~SWAP_LC_PAGE_VMA_MASK;
+	}
+	old = xa_store(&swap_lc_slots, entry.val, m, GFP_ATOMIC);
+	spin_unlock_irqrestore(&swap_lc_slots_lock, irqflags);
+	if (xa_is_err(old)) {
+		kmem_cache_free(swap_lc_meta_cache, m);
+		atomic64_inc(&b->meta_nomem);
+	} else if (old && old != m) {
+		kmem_cache_free(swap_lc_meta_cache, old);
+	}
+	swap_lc_write_record(b, SWAP_LC_EVENT_VMA_BIND, entry, &snapshot,
+		folio, NULL, address, 0, 0, snapshot.flags, 0,
+		SWAP_LC_RELEASE_NONE, false);
+	swap_lc_active_put();
+}
+
+void swap_lifecycle_trace_swapout(struct folio *folio, swp_entry_t entry,
+		u64 sector, u32 flags, u32 result)
+{
+	struct swap_lc_buffer *b;
+	struct swap_lc_meta meta;
+	struct swap_lc_meta *m;
+	unsigned long irqflags;
+
+	if (!entry.val)
+		return;
+	b = swap_lc_enter();
+	if (!b)
+		return;
+
+	spin_lock_irqsave(&swap_lc_slots_lock, irqflags);
+	m = xa_load(&swap_lc_slots, entry.val);
+	if (m) {
+		if (result != SWAP_LC_RESULT_ERROR &&
+		    !(flags & SWAP_LC_F_SWAPOUT_FREED)) {
+			if (m->out_seen)
+				flags |= SWAP_LC_F_REWRITE;
+			m->out_seen = 1;
+		}
+		meta = *m;
+	}
+	spin_unlock_irqrestore(&swap_lc_slots_lock, irqflags);
+	if (!m)
+		flags |= SWAP_LC_F_NO_META;
+	swap_lc_write_record(b, SWAP_LC_EVENT_SWAPOUT, entry,
+		m ? &meta : NULL, folio, NULL, 0, sector, 0, flags, result,
+		SWAP_LC_RELEASE_NONE, false);
+	swap_lc_active_put();
+}
+
+void swap_lifecycle_trace_swapin_fault(swp_entry_t entry,
+		struct vm_area_struct *vma, unsigned long address,
+		struct folio *folio, u32 flags, u32 result, bool mmap_locked)
+{
+	struct swap_lc_meta meta;
+	bool found;
+
+	if (!entry.val)
+		return;
+	found = swap_lc_meta_copy(entry, &meta);
+	if (!found)
+		flags |= SWAP_LC_F_NO_META;
+	/*
+	 * Under FAULT_FLAG_VMA_LOCK only the per-VMA lock is held; the
+	 * name is then read via the non-blocking trylock fallback.
+	 */
+	swap_lc_emit(SWAP_LC_EVENT_SWAPIN_FAULT, entry, found ? &meta : NULL,
+		folio, vma, address, 0, 0, flags, result,
+		SWAP_LC_RELEASE_NONE, mmap_locked);
+}
+
+void swap_lifecycle_trace_swapin_io(struct folio *folio, swp_entry_t entry,
+		u64 sector, u32 flags)
+{
+	struct swap_lc_meta meta;
+	bool found;
+
+	if (!entry.val)
+		return;
+	found = swap_lc_meta_copy(entry, &meta);
+	if (!found)
+		flags |= SWAP_LC_F_NO_META;
+	swap_lc_emit(SWAP_LC_EVENT_SWAPIN_IO, entry, found ? &meta : NULL,
+		folio, NULL, 0, sector, 0, flags, SWAP_LC_RESULT_IO_SUBMITTED,
+		SWAP_LC_RELEASE_NONE, false);
+}
+
+void swap_lifecycle_trace_free(swp_entry_t entry, u32 reason)
+{
+	struct swap_lc_buffer *b;
+	struct swap_lc_meta *m;
+	unsigned long irqflags;
+	u32 flags = 0;
+
+	if (!entry.val)
+		return;
+	b = swap_lc_enter();
+	if (!b)
+		return;
+
+	spin_lock_irqsave(&swap_lc_slots_lock, irqflags);
+	m = xa_erase(&swap_lc_slots, entry.val);
+	spin_unlock_irqrestore(&swap_lc_slots_lock, irqflags);
+
+	if (m && m->release_reason) {
+		if (reason != SWAP_LC_RELEASE_NONE &&
+		    reason != SWAP_LC_RELEASE_OTHER &&
+		    reason != m->release_reason)
+			flags |= SWAP_LC_F_REASON_CONFLICT;
+		flags |= m->release_flags;
+		reason = m->release_reason;
+	} else {
+		reason = swap_lc_resolve_release_reason(reason, &flags);
+	}
+	if (!m) {
+		/* Old tracers dropped these silently; log and count them. */
+		atomic64_inc(&b->free_no_meta);
+		flags |= SWAP_LC_F_NO_META;
+	}
+	swap_lc_write_record(b, SWAP_LC_EVENT_FREE, entry, m, NULL, NULL, 0,
+		0, 0, flags, SWAP_LC_RESULT_FINAL_RELEASE, reason, false);
+	if (m)
+		kmem_cache_free(swap_lc_meta_cache, m);
+	swap_lc_active_put();
+}
+
+/*
+ * Remember why a slot is going away when the last map reference drops but
+ * a swapcache reference still pins it: the later cache-drop FREE should
+ * report the original cause (e.g. PROCESS_EXIT), not SWAPCACHE_DROP.
+ */
+void swap_lifecycle_trace_set_release_reason(swp_entry_t entry,
+		unsigned int nr_pages, u32 reason)
+{
+	struct swap_lc_buffer *b;
+	unsigned long irqflags;
+	unsigned int i;
+	u32 flags = 0;
+
+	if (!entry.val)
+		return;
+	if (reason == SWAP_LC_RELEASE_NONE || reason == SWAP_LC_RELEASE_OTHER)
+		return;
+	b = swap_lc_enter();
+	if (!b)
+		return;
+	reason = swap_lc_resolve_release_reason(reason, &flags);
+	spin_lock_irqsave(&swap_lc_slots_lock, irqflags);
+	for (i = 0; i < nr_pages; i++) {
+		struct swap_lc_meta *m =
+			xa_load(&swap_lc_slots, entry.val + i);
+
+		if (m) {
+			m->release_reason = reason;
+			m->release_flags = flags;
+		}
+	}
+	spin_unlock_irqrestore(&swap_lc_slots_lock, irqflags);
+	swap_lc_active_put();
+}
+
+void swap_lifecycle_trace_discard(unsigned int swap_type,
+		unsigned long start_offset, unsigned long nr_pages,
+		u64 sector)
+{
+	swp_entry_t entry = swp_entry(swap_type, start_offset);
+
+	swap_lc_emit(SWAP_LC_EVENT_DISCARD, entry, NULL, NULL, NULL, 0,
+		sector, nr_pages, 0, SWAP_LC_RESULT_OK, SWAP_LC_RELEASE_NONE,
+		false);
+}
+
+static void swap_lc_fill_header(struct swap_lc_buffer *b)
+{
+	struct swap_lc_log_header *h = b->memory;
+	unsigned int i;
+
+	h->records = min_t(u64, atomic64_read(&b->next_record), b->capacity);
+	for (i = 0; i < TRACE_EVENT_TYPES; i++)
+		h->event_count[i] = atomic64_read(&b->event_count[i]);
+	h->dropped_full = atomic64_read(&b->dropped_full);
+	h->meta_nomem = atomic64_read(&b->meta_nomem);
+	h->stale_meta = atomic64_read(&b->stale_meta);
+	h->free_no_meta = atomic64_read(&b->free_no_meta);
+	h->stop_ns = READ_ONCE(b->stop_ns);
+	h->stopped_full = READ_ONCE(b->stopped_full);
+	h->enabled = atomic_read(&swap_lc_enabled);
+}
+
+/*
+ * Stop tracing, dump ALIVE records for every still-tracked slot, release
+ * the metadata cache, and seal the header.  Caller holds the control lock.
+ */
+static void swap_lc_stop_and_drain(void)
+{
+	struct swap_lc_buffer *b;
+	struct swap_lc_meta *m;
+	unsigned long index;
+
+	atomic_set(&swap_lc_enabled, 0);
+	/* Prevent an in-flight updater from publishing after disable. */
+	smp_mb();
+	synchronize_rcu();
+	wait_event(swap_lc_active_wait, !atomic_read(&swap_lc_active));
+
+	b = rcu_dereference_protected(swap_lc_buffer,
+		lockdep_is_held(&swap_lc_control_lock));
+	xa_for_each(&swap_lc_slots, index, m) {
+		if (b && !READ_ONCE(b->sealed)) {
+			swp_entry_t e = (swp_entry_t){ .val = index };
+
+			/* ts_ns of an ALIVE record is the slot's alloc time. */
+			swap_lc_write_record(b, SWAP_LC_EVENT_ALIVE, e, m,
+				NULL, NULL, 0, 0, 0, m->flags,
+				SWAP_LC_RESULT_OK, m->release_reason, false);
+		}
+		xa_erase(&swap_lc_slots, index);
+		kmem_cache_free(swap_lc_meta_cache, m);
+	}
+	if (!b || READ_ONCE(b->sealed))
+		return;
+	if (!READ_ONCE(b->stop_ns))
+		WRITE_ONCE(b->stop_ns, ktime_get_ns());
+	swap_lc_fill_header(b);
+	WRITE_ONCE(b->sealed, true);
+}
+
+static struct swap_lc_buffer *swap_lc_alloc_buffer(unsigned int mb)
+{
+	struct swap_lc_buffer *b;
+	u64 bytes64 = (u64)mb << 20;
+	unsigned long bytes;
+	void *memory;
+
+	if (bytes64 > ULONG_MAX || bytes64 <= TRACE_HEADER_SIZE)
+		return ERR_PTR(-E2BIG);
+	bytes = bytes64;
+	b = kzalloc(sizeof(*b), GFP_KERNEL);
+	if (!b)
+		return ERR_PTR(-ENOMEM);
+	memory = __vmalloc(bytes, GFP_KERNEL | __GFP_NOWARN);
+	if (!memory) {
+		kfree(b);
+		return ERR_PTR(-ENOMEM);
+	}
+	b->memory = memory;
+	b->bytes = bytes;
+	b->capacity = (bytes - TRACE_HEADER_SIZE) / TRACE_RECORD_SIZE;
+	return b;
+}
+
+static void swap_lc_free_buffer(struct swap_lc_buffer *b)
+{
+	if (!b)
+		return;
+	vfree(b->memory);
+	kfree(b);
+}
+
+static void swap_lc_init_header(struct swap_lc_buffer *b)
+{
+	struct swap_lc_log_header *h = b->memory;
+
+	memset(h, 0, sizeof(*h));
+	memcpy(h->magic, "SWLC\0\0\0\0", 8);
+	h->version = TRACE_VERSION;
+	h->header_size = TRACE_HEADER_SIZE;
+	h->record_size = TRACE_RECORD_SIZE;
+	h->endian = 0x01020304;
+	h->buffer_bytes = b->bytes;
+	h->capacity = b->capacity;
+	h->session = b->session;
+	h->start_ns = b->start_ns;
+	h->enabled = 1;
+	strscpy(h->kernel_release, init_utsname()->release,
+		sizeof(h->kernel_release));
+}
+
+static int swap_lc_start(void)
+{
+	struct swap_lc_buffer *b;
+	unsigned int requested_mb;
+	u64 requested_bytes;
+	unsigned int i;
+	int ret = 0;
+
+	mutex_lock(&swap_lc_control_lock);
+	if (atomic_read(&swap_lc_enabled))
+		goto out_unlock;
+	if (swap_lc_readers) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	requested_mb = READ_ONCE(swap_lc_buffer_mb);
+	requested_bytes = (u64)requested_mb << 20;
+	swap_lc_stop_and_drain();
+	b = rcu_dereference_protected(swap_lc_buffer,
+		lockdep_is_held(&swap_lc_control_lock));
+	if (b && b->bytes != requested_bytes) {
+		/* Changing size requires an explicit reset first. */
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	if (!b) {
+		b = swap_lc_alloc_buffer(requested_mb);
+		if (IS_ERR(b)) {
+			ret = PTR_ERR(b);
+			pr_err("swap_lifecycle_trace: failed to allocate %u MiB log: %d\n",
+				requested_mb, ret);
+			goto out_unlock;
+		}
+		rcu_assign_pointer(swap_lc_buffer, b);
+	}
+
+	atomic64_set(&b->next_record, 0);
+	for (i = 0; i < TRACE_EVENT_TYPES; i++)
+		atomic64_set(&b->event_count[i], 0);
+	atomic64_set(&b->dropped_full, 0);
+	atomic64_set(&b->meta_nomem, 0);
+	atomic64_set(&b->stale_meta, 0);
+	atomic64_set(&b->free_no_meta, 0);
+	atomic_set(&b->full_reported, 0);
+	b->session = atomic64_inc_return(&swap_lc_next_session);
+	b->start_ns = ktime_get_ns();
+	b->stop_ns = 0;
+	b->stopped_full = false;
+	b->sealed = false;
+	swap_lc_init_header(b);
+	atomic_set_release(&swap_lc_enabled, 1);
+	pr_info("swap_lifecycle_trace: session=%llu started, buffer=%lu bytes, capacity=%llu records\n",
+		b->session, b->bytes, b->capacity);
+
+out_unlock:
+	mutex_unlock(&swap_lc_control_lock);
+	return ret;
+}
+
+static void swap_lc_stop(void)
+{
+	mutex_lock(&swap_lc_control_lock);
+	swap_lc_stop_and_drain();
+	mutex_unlock(&swap_lc_control_lock);
+}
+
+static ssize_t swap_lc_enable_read(struct file *file, char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	char value[4];
+	int len = scnprintf(value, sizeof(value), "%d\n",
+		atomic_read(&swap_lc_enabled));
+
+	return simple_read_from_buffer(buf, count, ppos, value, len);
+}
+
+static ssize_t swap_lc_enable_write(struct file *file, const char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	bool enable;
+	int ret = kstrtobool_from_user(buf, count, &enable);
+
+	if (ret)
+		return ret;
+	if (enable) {
+		ret = swap_lc_start();
+		if (ret)
+			return ret;
+	} else {
+		swap_lc_stop();
+	}
+	return count;
+}
+
+static const struct file_operations swap_lc_enable_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = swap_lc_enable_read,
+	.write = swap_lc_enable_write,
+	.llseek = default_llseek,
+};
+
+static ssize_t swap_lc_buffer_mb_read(struct file *file, char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	char value[24];
+	int len = scnprintf(value, sizeof(value), "%u\n",
+		READ_ONCE(swap_lc_buffer_mb));
+
+	return simple_read_from_buffer(buf, count, ppos, value, len);
+}
+
+static ssize_t swap_lc_buffer_mb_write(struct file *file,
+		const char __user *buf, size_t count, loff_t *ppos)
+{
+	struct swap_lc_buffer *b;
+	unsigned int mb;
+	int ret;
+
+	ret = kstrtouint_from_user(buf, count, 0, &mb);
+	if (ret)
+		return ret;
+	if (mb < TRACE_MIN_MB || mb > TRACE_MAX_MB)
+		return -ERANGE;
+	mutex_lock(&swap_lc_control_lock);
+	b = rcu_dereference_protected(swap_lc_buffer,
+		lockdep_is_held(&swap_lc_control_lock));
+	if (atomic_read(&swap_lc_enabled) || swap_lc_readers ||
+	    (b && b->bytes != ((u64)mb << 20)))
+		ret = -EBUSY;
+	else
+		WRITE_ONCE(swap_lc_buffer_mb, mb);
+	mutex_unlock(&swap_lc_control_lock);
+	return ret ? ret : count;
+}
+
+static const struct file_operations swap_lc_buffer_mb_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.read = swap_lc_buffer_mb_read,
+	.write = swap_lc_buffer_mb_write,
+	.llseek = default_llseek,
+};
+
+static ssize_t swap_lc_reset_write(struct file *file, const char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	struct swap_lc_buffer *b;
+	bool reset;
+	int ret = kstrtobool_from_user(buf, count, &reset);
+
+	if (ret)
+		return ret;
+	if (!reset)
+		return count;
+	mutex_lock(&swap_lc_control_lock);
+	if (swap_lc_readers) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	swap_lc_stop_and_drain();
+	b = rcu_dereference_protected(swap_lc_buffer,
+		lockdep_is_held(&swap_lc_control_lock));
+	RCU_INIT_POINTER(swap_lc_buffer, NULL);
+	swap_lc_free_buffer(b);
+	ret = 0;
+out_unlock:
+	mutex_unlock(&swap_lc_control_lock);
+	return ret ? ret : count;
+}
+
+static const struct file_operations swap_lc_reset_fops = {
+	.owner = THIS_MODULE,
+	.open = simple_open,
+	.write = swap_lc_reset_write,
+	.llseek = no_llseek,
+};
+
+static int swap_lc_log_open(struct inode *inode, struct file *file)
+{
+	struct swap_lc_reader *reader;
+	struct swap_lc_buffer *b;
+	u64 records;
+	int ret = 0;
+
+	mutex_lock(&swap_lc_control_lock);
+	if (atomic_read(&swap_lc_enabled)) {
+		ret = -EBUSY;
+		goto out_unlock;
+	}
+	swap_lc_stop_and_drain();
+	b = rcu_dereference_protected(swap_lc_buffer,
+		lockdep_is_held(&swap_lc_control_lock));
+	if (!b) {
+		ret = -ENODATA;
+		goto out_unlock;
+	}
+	swap_lc_readers++;
+	mutex_unlock(&swap_lc_control_lock);
+
+	reader = kzalloc(sizeof(*reader), GFP_KERNEL);
+	if (!reader) {
+		mutex_lock(&swap_lc_control_lock);
+		swap_lc_readers--;
+		mutex_unlock(&swap_lc_control_lock);
+		return -ENOMEM;
+	}
+	records = min_t(u64, atomic64_read(&b->next_record), b->capacity);
+	reader->buffer = b;
+	reader->length = TRACE_HEADER_SIZE + records * TRACE_RECORD_SIZE;
+	file->private_data = reader;
+	return 0;
+
+out_unlock:
+	mutex_unlock(&swap_lc_control_lock);
+	return ret;
+}
+
+static ssize_t swap_lc_log_read(struct file *file, char __user *buf,
+		size_t count, loff_t *ppos)
+{
+	struct swap_lc_reader *reader = file->private_data;
+
+	return simple_read_from_buffer(buf, count, ppos,
+		reader->buffer->memory, reader->length);
+}
+
+static int swap_lc_log_release(struct inode *inode, struct file *file)
+{
+	struct swap_lc_reader *reader = file->private_data;
+
+	kfree(reader);
+	mutex_lock(&swap_lc_control_lock);
+	WARN_ON_ONCE(!swap_lc_readers);
+	if (swap_lc_readers)
+		swap_lc_readers--;
+	mutex_unlock(&swap_lc_control_lock);
+	return 0;
+}
+
+static const struct file_operations swap_lc_log_fops = {
+	.owner = THIS_MODULE,
+	.open = swap_lc_log_open,
+	.read = swap_lc_log_read,
+	.release = swap_lc_log_release,
+	.llseek = default_llseek,
+};
+
+static int swap_lc_format_show(struct seq_file *m, void *unused)
+{
+	seq_printf(m, "magic=SWLC version=%u header_size=%u record_size=%u ",
+		TRACE_VERSION, TRACE_HEADER_SIZE, TRACE_RECORD_SIZE);
+	seq_puts(m, "endian=0x01020304\n");
+	seq_puts(m, "events: 1=ALLOC 2=VMA_BIND 3=SWAPOUT 4=SWAPIN_FAULT ");
+	seq_puts(m, "5=SWAPIN_IO 6=FREE 7=DISCARD 8=ALIVE\n");
+	seq_puts(m, "record fields: seq ts_ns event_type cpu pid tgid uid ");
+	seq_puts(m, "swap_entry address vma_start vma_end mm_id vm_flags ");
+	seq_puts(m, "sector nr_pages flags result reason page_state ");
+	seq_puts(m, "oom_score_adj owner_uid lru_gen_age vma_type vma_name\n");
+	seq_puts(m, "an ALIVE record's ts_ns is the slot's allocation time\n");
+	seq_puts(m, "header carries per-event totals; a full buffer stops ");
+	seq_puts(m, "records but not the totals\n");
+	seq_puts(m, "disable before reading log; reset releases the buffer\n");
+	return 0;
+}
+
+DEFINE_SHOW_ATTRIBUTE(swap_lc_format);
+
+static bool swap_lc_create_file(const char *name, umode_t mode,
+		const struct file_operations *fops)
+{
+	return !IS_ERR_OR_NULL(debugfs_create_file(name, mode,
+		swap_lc_debugfs_root, NULL, fops));
+}
+
+static int __init swap_lifecycle_trace_init(void)
+{
+	swap_lc_meta_cache = KMEM_CACHE(swap_lc_meta, 0);
+	if (!swap_lc_meta_cache) {
+		pr_err("swap_lifecycle_trace: metadata cache unavailable\n");
+		return 0;
+	}
+	swap_lc_debugfs_root = debugfs_create_dir(TRACE_DIR, NULL);
+	if (IS_ERR_OR_NULL(swap_lc_debugfs_root)) {
+		pr_warn("swap_lifecycle_trace: debugfs interface unavailable\n");
+		swap_lc_debugfs_root = NULL;
+		return 0;
+	}
+	if (swap_lc_create_file("enable", 0600, &swap_lc_enable_fops) &&
+	    swap_lc_create_file("buffer_size_mb", 0600,
+		&swap_lc_buffer_mb_fops) &&
+	    swap_lc_create_file("reset", 0200, &swap_lc_reset_fops) &&
+	    swap_lc_create_file("log", 0400, &swap_lc_log_fops) &&
+	    swap_lc_create_file("format", 0400, &swap_lc_format_fops))
+		return 0;
+	pr_err("swap_lifecycle_trace: failed to create complete debugfs interface\n");
+	debugfs_remove_recursive(swap_lc_debugfs_root);
+	swap_lc_debugfs_root = NULL;
+	return 0;
+}
+
+late_initcall(swap_lifecycle_trace_init);
