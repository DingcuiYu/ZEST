diff --git a/tools/testing/swap_lifecycle/analyze_swap_lifecycle.py b/tools/testing/swap_lifecycle/analyze_swap_lifecycle.py
new file mode 100644
index 0000000000000000000000000000000000000000..315317679381b845f99330206f6fa03f226b22d5
--- /dev/null
+++ b/tools/testing/swap_lifecycle/analyze_swap_lifecycle.py
@@ -0,0 +1,367 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0
+"""Parse and validate a swap_lifecycle_trace (SWLC) binary log.
+
+The tool has two jobs:
+
+1. Coverage validation ("did we lose FREEs?"): pair ALLOC/FREE/ALIVE
+   records per swap entry, cross-check the record stream against the
+   header's per-event totals, and report every loss class explicitly.
+   With the SWLC design the identity
+
+       ALLOC(OK) == FREE(with meta) + ALIVE
+
+   must hold exactly; any stale-meta count means a kernel free path is
+   not hooked.
+
+2. Lifecycle statistics: per-UID / per-vma-type slot lifetimes, release
+   reason histogram, MGLRU age distribution, swap-out/in/discard flow.
+
+Only Python 3 stdlib is required.
+"""
+
+import argparse
+import collections
+import csv
+import struct
+import sys
+
+HEADER_FMT = "<8s4I6Q2I8Q4Q64s16s"
+HEADER_SIZE = struct.calcsize(HEADER_FMT)
+RECORD_FMT = "<QQHHIIIQQQQQQQIIIIIiIBBH72s"
+RECORD_SIZE = struct.calcsize(RECORD_FMT)
+MAGIC = b"SWLC\x00\x00\x00\x00"
+
+EVENT_NAMES = {
+    1: "ALLOC",
+    2: "VMA_BIND",
+    3: "SWAPOUT",
+    4: "SWAPIN_FAULT",
+    5: "SWAPIN_IO",
+    6: "FREE",
+    7: "DISCARD",
+    8: "ALIVE",
+}
+
+RESULT_NAMES = {
+    0: "OK",
+    1: "CACHE_HIT",
+    2: "IO_SUBMITTED",
+    3: "NO_IO",
+    4: "RETRY",
+    5: "ERROR",
+    6: "ROLLBACK",
+    7: "FINAL_RELEASE",
+}
+
+REASON_NAMES = {
+    0: "NONE",
+    1: "SWAPIN_REF_ZERO",
+    2: "PROCESS_EXIT",
+    3: "OOM_REAPER",
+    4: "MUNMAP",
+    5: "MADV_DONTNEED",
+    6: "MADV_FREE",
+    7: "SWAPOFF",
+    8: "SWAPCACHE_RECLAIM",
+    9: "SWAPCACHE_DROP",
+    10: "ALLOC_ROLLBACK",
+    11: "KSM_OR_MIGRATION",
+    12: "ERROR_ROLLBACK",
+    13: "SHMEM_TRUNCATE",
+    14: "OTHER",
+}
+
+VMA_TYPE_NAMES = {
+    0: "unknown",
+    1: "java_heap",
+    2: "heap",
+    3: "stack",
+    4: "named_anon",
+    5: "unnamed_anon",
+    6: "file_backed",
+}
+
+F_REWRITE = 1 << 7
+F_NO_META = 1 << 12
+F_STALE_META = 1 << 13
+
+FLAG_NAMES = {
+    1 << 0: "CACHE_HIT",
+    1 << 1: "CACHE_MISS",
+    1 << 2: "MAJOR_FAULT",
+    1 << 3: "FAULT_RETRY",
+    1 << 4: "FAULT_ERROR",
+    1 << 5: "SYNCHRONOUS",
+    1 << 6: "READAHEAD",
+    1 << 7: "REWRITE",
+    1 << 8: "VMA_AMBIGUOUS",
+    1 << 9: "VMA_UNKNOWN",
+    1 << 10: "SWAPOUT_FREED",
+    1 << 11: "REASON_CONFLICT",
+    1 << 12: "NO_META",
+    1 << 13: "STALE_META",
+    1 << 14: "PTE_YOUNG",
+    1 << 15: "ZSWAP",
+    1 << 16: "FS_OPS",
+    1 << 17: "BDEV_SYNC",
+    1 << 18: "BDEV_ASYNC",
+}
+
+Header = collections.namedtuple(
+    "Header",
+    "magic version header_size record_size endian buffer_bytes capacity "
+    "records session start_ns stop_ns stopped_full enabled "
+    "count_alloc count_vma_bind count_swapout count_swapin_fault "
+    "count_swapin_io count_free count_discard count_alive "
+    "dropped_full meta_nomem stale_meta free_no_meta "
+    "kernel_release reserved",
+)
+
+Record = collections.namedtuple(
+    "Record",
+    "seq ts_ns event_type cpu pid tgid uid swap_entry address vma_start "
+    "vma_end mm_id vm_flags sector nr_pages flags result reason page_state "
+    "oom_score_adj owner_uid lru_gen_age vma_type reserved vma_name",
+)
+
+
+def parse_header(buf):
+    if len(buf) < HEADER_SIZE:
+        raise SystemExit("truncated header (%d bytes)" % len(buf))
+    h = Header._make(struct.unpack_from(HEADER_FMT, buf, 0))
+    if h.magic != MAGIC:
+        raise SystemExit("bad magic %r (not an SWLC log)" % h.magic)
+    if h.endian != 0x01020304:
+        raise SystemExit("endianness mismatch: 0x%x" % h.endian)
+    if h.record_size != RECORD_SIZE or h.header_size != HEADER_SIZE:
+        raise SystemExit(
+            "layout mismatch: header=%d record=%d (tool expects %d/%d)"
+            % (h.header_size, h.record_size, HEADER_SIZE, RECORD_SIZE))
+    return h
+
+
+def iter_records(buf, header):
+    end = min(len(buf),
+              header.header_size + header.records * header.record_size)
+    off = header.header_size
+    while off + RECORD_SIZE <= end:
+        r = Record._make(struct.unpack_from(RECORD_FMT, buf, off))
+        yield r._replace(vma_name=r.vma_name.split(b"\0", 1)[0].decode(
+            "utf-8", "replace"))
+        off += RECORD_SIZE
+
+
+def flag_names(flags):
+    names = [n for bit, n in sorted(FLAG_NAMES.items()) if flags & bit]
+    return "|".join(names) if names else "-"
+
+
+class Lifetime:
+    __slots__ = ("alloc_ns", "uid", "owner_uid", "vma_type", "lru_gen_age",
+                 "swapouts", "swapin_faults", "swapin_ios")
+
+    def __init__(self, alloc_ns, uid):
+        self.alloc_ns = alloc_ns
+        self.uid = uid
+        self.owner_uid = None
+        self.vma_type = 0
+        self.lru_gen_age = 0xFF
+        self.swapouts = 0
+        self.swapin_faults = 0
+        self.swapin_ios = 0
+
+
+def analyze(path, args):
+    with open(path, "rb") as f:
+        buf = f.read()
+    h = parse_header(buf)
+
+    print("== header ==")
+    print("session=%d capacity=%d records=%d stopped_full=%d enabled=%d"
+          % (h.session, h.capacity, h.records, h.stopped_full, h.enabled))
+    print("start_ns=%d stop_ns=%d duration_ms=%.1f"
+          % (h.start_ns, h.stop_ns, (h.stop_ns - h.start_ns) / 1e6
+             if h.stop_ns else 0.0))
+    print("kernel=%s" % h.kernel_release.split(b"\0", 1)[0].decode())
+    counters = {
+        "ALLOC": h.count_alloc, "VMA_BIND": h.count_vma_bind,
+        "SWAPOUT": h.count_swapout, "SWAPIN_FAULT": h.count_swapin_fault,
+        "SWAPIN_IO": h.count_swapin_io, "FREE": h.count_free,
+        "DISCARD": h.count_discard, "ALIVE": h.count_alive,
+    }
+    print("event totals (header): %s"
+          % " ".join("%s=%d" % kv for kv in counters.items()))
+    print("loss counters: dropped_full=%d meta_nomem=%d stale_meta=%d "
+          "free_no_meta=%d"
+          % (h.dropped_full, h.meta_nomem, h.stale_meta, h.free_no_meta))
+
+    # ---- pass over the record stream ----
+    rec_counts = collections.Counter()
+    open_slots = {}
+    closed = []           # (entry, Lifetime, free_ns, reason, flags)
+    frees_no_meta = 0     # pre-session or metadata-less releases
+    frees_with_meta = 0
+    alives = 0
+    stale_allocs = []     # (seq, entry) -> instrumentation gap evidence
+    realloc_open = []     # ALLOC while tracked-open in userspace pairing
+    reason_hist = collections.Counter()
+    age_hist = collections.Counter()
+    vma_type_out = collections.Counter()
+    discard_pages = 0
+    per_uid = collections.defaultdict(list)
+
+    for r in iter_records(buf, h):
+        name = EVENT_NAMES.get(r.event_type, "?%d" % r.event_type)
+        rec_counts[name] += 1
+
+        if r.event_type == 1:                     # ALLOC
+            if r.flags & F_STALE_META:
+                stale_allocs.append((r.seq, r.swap_entry))
+            if r.swap_entry in open_slots:
+                realloc_open.append((r.seq, r.swap_entry))
+            if r.result == 0:                     # OK (not rollback)
+                open_slots[r.swap_entry] = Lifetime(r.ts_ns, r.uid)
+        elif r.event_type == 2:                   # VMA_BIND
+            lt = open_slots.get(r.swap_entry)
+            if lt is not None:
+                lt.owner_uid = r.owner_uid
+                lt.vma_type = r.vma_type
+                if r.lru_gen_age != 0xFF:
+                    lt.lru_gen_age = r.lru_gen_age
+        elif r.event_type == 3:                   # SWAPOUT
+            lt = open_slots.get(r.swap_entry)
+            if lt is not None:
+                lt.swapouts += 1
+                if r.lru_gen_age != 0xFF:
+                    lt.lru_gen_age = r.lru_gen_age
+            if r.lru_gen_age != 0xFF:
+                age_hist[r.lru_gen_age] += 1
+            vma_type_out[VMA_TYPE_NAMES.get(r.vma_type, "?")] += 1
+        elif r.event_type == 4:                   # SWAPIN_FAULT
+            lt = open_slots.get(r.swap_entry)
+            if lt is not None:
+                lt.swapin_faults += 1
+        elif r.event_type == 5:                   # SWAPIN_IO
+            lt = open_slots.get(r.swap_entry)
+            if lt is not None:
+                lt.swapin_ios += 1
+        elif r.event_type == 6:                   # FREE
+            reason_hist[REASON_NAMES.get(r.reason, "?%d" % r.reason)] += 1
+            lt = open_slots.pop(r.swap_entry, None)
+            if r.flags & F_NO_META:
+                frees_no_meta += 1
+            else:
+                frees_with_meta += 1
+            if lt is not None:
+                closed.append((r.swap_entry, lt, r.ts_ns, r.reason, r.flags))
+                per_uid[lt.uid].append(r.ts_ns - lt.alloc_ns)
+        elif r.event_type == 7:                   # DISCARD
+            discard_pages += r.nr_pages
+        elif r.event_type == 8:                   # ALIVE
+            alives += 1
+            open_slots.pop(r.swap_entry, None)
+
+    print("\n== record stream ==")
+    print(" ".join("%s=%d" % kv for kv in sorted(rec_counts.items())))
+
+    # ---- coverage verdict ----
+    print("\n== coverage validation ==")
+    total_recorded = sum(rec_counts.values())
+    total_counted = sum(counters.values())
+    if h.dropped_full:
+        print("NOTE: buffer filled; %d events counted but not recorded "
+              "(records cover %.1f%% of events)"
+              % (h.dropped_full, 100.0 * total_recorded / total_counted
+                 if total_counted else 100.0))
+    else:
+        print("record stream is complete (no buffer overflow)")
+
+    ok_allocs = counters["ALLOC"] - reason_hist.get("ALLOC_ROLLBACK", 0)
+    print("header identity: ALLOC(OK-ish)=%d vs FREE(meta)+ALIVE=%d+%d=%d"
+          % (ok_allocs, h.count_free - h.free_no_meta, h.count_alive,
+             h.count_free - h.free_no_meta + h.count_alive))
+    print("frees for pre-session/untracked slots (expected early in a "
+          "session): %d" % frees_no_meta)
+    if h.stale_meta or stale_allocs:
+        print("!! stale_meta=%d: a kernel free path is NOT hooked - "
+              "first offenders: %s"
+              % (h.stale_meta,
+                 ["0x%x" % e for _, e in stale_allocs[:10]]))
+    else:
+        print("no stale metadata: every reallocated slot saw its FREE "
+              "(the old tracer's 50%% loss class is closed)")
+    if realloc_open:
+        print("!! %d re-ALLOCs while open in stream pairing, e.g. %s"
+              % (len(realloc_open),
+                 ["0x%x" % e for _, e in realloc_open[:10]]))
+    leaked = len(open_slots)
+    if leaked:
+        print("!! %d slots opened in stream but neither freed nor "
+              "reported ALIVE (dropped records?)" % leaked)
+
+    # ---- statistics ----
+    print("\n== statistics ==")
+    print("closed lifetimes: %d, still-alive at stop: %d" %
+          (len(closed), alives))
+    if closed:
+        lifetimes = sorted(ns for _, lt, end_ns, _, _ in closed
+                           for ns in (end_ns - lt.alloc_ns,))
+        mid = lifetimes[len(lifetimes) // 2]
+        print("lifetime ms: min=%.2f p50=%.2f p90=%.2f max=%.2f"
+              % (lifetimes[0] / 1e6, mid / 1e6,
+                 lifetimes[int(len(lifetimes) * 0.9)] / 1e6,
+                 lifetimes[-1] / 1e6))
+    print("release reasons: %s"
+          % " ".join("%s=%d" % kv for kv in reason_hist.most_common()))
+    if age_hist:
+        print("MGLRU age at swap-out: %s"
+              % " ".join("gen%d=%d" % kv for kv in sorted(age_hist.items())))
+    if vma_type_out:
+        print("swap-out vma types: %s"
+              % " ".join("%s=%d" % kv for kv in vma_type_out.most_common()))
+    if discard_pages:
+        print("discarded: %d pages (%.1f MiB)"
+              % (discard_pages, discard_pages * 4096 / 1048576))
+
+    if args.summary_csv:
+        with open(args.summary_csv, "w", newline="") as f:
+            w = csv.writer(f)
+            w.writerow(["uid", "closed_slots", "avg_lifetime_ns"])
+            for uid in sorted(per_uid):
+                vals = per_uid[uid]
+                w.writerow([uid, len(vals), sum(vals) // len(vals)])
+        print("per-uid summary written to %s" % args.summary_csv)
+
+    if args.dump:
+        print("\n== dump ==")
+        for r in iter_records(buf, h):
+            print("%8d %14d %-12s entry=0x%-12x addr=0x%-12x uid=%d "
+                  "owner=%d oom=%d pages=%d gen=%s type=%s res=%s rea=%s "
+                  "sec=%d flags=%s name=%s"
+                  % (r.seq, r.ts_ns,
+                     EVENT_NAMES.get(r.event_type, "?"), r.swap_entry,
+                     r.address, r.uid,
+                     r.owner_uid if r.owner_uid != 0xFFFFFFFF else -1,
+                     r.oom_score_adj if r.oom_score_adj != -(1 << 31)
+                     else 9999,
+                     r.nr_pages,
+                     r.lru_gen_age if r.lru_gen_age != 0xFF else "-",
+                     VMA_TYPE_NAMES.get(r.vma_type, "?"),
+                     RESULT_NAMES.get(r.result, "?"),
+                     REASON_NAMES.get(r.reason, "?"),
+                     r.sector, flag_names(r.flags), r.vma_name))
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__)
+    ap.add_argument("log", help="raw log from debugfs swap_lifecycle_trace/log")
+    ap.add_argument("--summary-csv", help="write per-uid lifetime CSV")
+    ap.add_argument("--dump", action="store_true",
+                    help="print every record")
+    args = ap.parse_args()
+    analyze(args.log, args)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
