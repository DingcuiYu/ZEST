+
+#define SWAP_LIFECYCLE_VMA_NAME_LEN	72
+
+/*
+ * Every hook below emits its record unconditionally while tracing is
+ * enabled.  Unlike the retired swap_sequence/swap_slot_lifetime tracers,
+ * emission never depends on whether per-slot metadata is present: a FREE
+ * for a slot allocated before the session started, or whose metadata
+ * allocation failed, is still logged (flagged SWAP_LC_F_NO_META) instead
+ * of being silently swallowed.
+ */
+enum swap_lifecycle_event_type {
+	SWAP_LC_EVENT_ALLOC = 1,	/* folio_alloc_swap() charged a slot */
+	SWAP_LC_EVENT_VMA_BIND = 2,	/* try_to_unmap_one() installed swap PTE */
+	SWAP_LC_EVENT_SWAPOUT = 3,	/* swap_writepage()/__swap_writepage() */
+	SWAP_LC_EVENT_SWAPIN_FAULT = 4,	/* do_swap_page() */
+	SWAP_LC_EVENT_SWAPIN_IO = 5,	/* swap_readpage(), incl. readahead */
+	SWAP_LC_EVENT_FREE = 6,		/* final swap reference released */
+	SWAP_LC_EVENT_DISCARD = 7,	/* cluster discard issued to device */
+	SWAP_LC_EVENT_ALIVE = 8,	/* still-allocated slot at session stop */
+};
+
+enum swap_lifecycle_result {
+	SWAP_LC_RESULT_OK = 0,
+	SWAP_LC_RESULT_CACHE_HIT,
+	SWAP_LC_RESULT_IO_SUBMITTED,
+	SWAP_LC_RESULT_NO_IO,
+	SWAP_LC_RESULT_RETRY,
+	SWAP_LC_RESULT_ERROR,
+	SWAP_LC_RESULT_ROLLBACK,
+	SWAP_LC_RESULT_FINAL_RELEASE,
+};
+
+/* Why the final reference to a swap slot went away. */
+enum swap_lifecycle_release_reason {
+	SWAP_LC_RELEASE_NONE = 0,
+	SWAP_LC_RELEASE_SWAPIN_REF_ZERO = 1,	/* freed by successful swap-in */
+	SWAP_LC_RELEASE_PROCESS_EXIT = 2,	/* exit_mmap() teardown */
+	SWAP_LC_RELEASE_OOM_REAPER = 3,
+	SWAP_LC_RELEASE_MUNMAP = 4,		/* non-exit unmap/zap */
+	SWAP_LC_RELEASE_MADV_DONTNEED = 5,
+	SWAP_LC_RELEASE_MADV_FREE = 6,
+	SWAP_LC_RELEASE_SWAPOFF = 7,
+	SWAP_LC_RELEASE_SWAPCACHE_RECLAIM = 8,	/* swap-full/mlock shrink of swapcache */
+	SWAP_LC_RELEASE_SWAPCACHE_DROP = 9,	/* swapcache held the last reference */
+	SWAP_LC_RELEASE_ALLOC_ROLLBACK = 10,	/* memcg charge/add-to-cache failed */
+	SWAP_LC_RELEASE_KSM_OR_MIGRATION = 11,
+	SWAP_LC_RELEASE_ERROR_ROLLBACK = 12,	/* try_to_unmap() unwinding */
+	SWAP_LC_RELEASE_SHMEM_TRUNCATE = 13,
+	SWAP_LC_RELEASE_OTHER = 14,
+};
+
+enum swap_lifecycle_flag {
+	SWAP_LC_F_CACHE_HIT = 1U << 0,
+	SWAP_LC_F_CACHE_MISS = 1U << 1,
+	SWAP_LC_F_MAJOR_FAULT = 1U << 2,
+	SWAP_LC_F_FAULT_RETRY = 1U << 3,
+	SWAP_LC_F_FAULT_ERROR = 1U << 4,
+	SWAP_LC_F_SYNCHRONOUS = 1U << 5,
+	SWAP_LC_F_READAHEAD = 1U << 6,
+	/* This slot saw more than one SWAPOUT while allocated. */
+	SWAP_LC_F_REWRITE = 1U << 7,
+	SWAP_LC_F_VMA_AMBIGUOUS = 1U << 8,
+	SWAP_LC_F_VMA_UNKNOWN = 1U << 9,
+	/* swap_writepage() found the folio already stale and freed the slot. */
+	SWAP_LC_F_SWAPOUT_FREED = 1U << 10,
+	/* Explicit reason and stack classification disagreed. */
+	SWAP_LC_F_REASON_CONFLICT = 1U << 11,
+	/* No per-slot metadata (pre-session slot or metadata alloc failure). */
+	SWAP_LC_F_NO_META = 1U << 12,
+	/* ALLOC found leftover metadata: instrumentation missed a FREE. */
+	SWAP_LC_F_STALE_META = 1U << 13,
+	SWAP_LC_F_PTE_YOUNG = 1U << 14,
+	SWAP_LC_F_ZSWAP = 1U << 15,
+	SWAP_LC_F_FS_OPS = 1U << 16,
+	SWAP_LC_F_BDEV_SYNC = 1U << 17,
+	SWAP_LC_F_BDEV_ASYNC = 1U << 18,
+};
+
+enum swap_lifecycle_vma_type {
+	SWAP_LC_VMA_UNKNOWN = 0,
+	SWAP_LC_VMA_JAVA_HEAP = 1,
+	SWAP_LC_VMA_HEAP = 2,
+	SWAP_LC_VMA_STACK = 3,
+	SWAP_LC_VMA_NAMED_ANON = 4,
+	SWAP_LC_VMA_UNNAMED_ANON = 5,
+	SWAP_LC_VMA_FILE_BACKED = 6,
+};
+
+/* Folio/VMA snapshot bits stored in the record's page_state field. */
+enum swap_lifecycle_page_state {
+	SWAP_LC_PAGE_FOLIO_ANON = 1U << 0,
+	SWAP_LC_PAGE_FOLIO_SWAPBACKED = 1U << 1,
+	SWAP_LC_PAGE_VMA_HAS_FILE = 1U << 2,
+	SWAP_LC_PAGE_VMA_SHARED = 1U << 3,
+	SWAP_LC_PAGE_FOLIO_REFERENCED = 1U << 4,
+	SWAP_LC_PAGE_FOLIO_WORKINGSET = 1U << 5,
+	SWAP_LC_PAGE_FOLIO_ACTIVE = 1U << 6,
+	SWAP_LC_PAGE_VMA_SEQ_READ = 1U << 12,
+	SWAP_LC_PAGE_VMA_RAND_READ = 1U << 13,
+	SWAP_LC_PAGE_VMA_EXEC = 1U << 14,
+	SWAP_LC_PAGE_VMA_WRITE = 1U << 15,
+};
+
+#define SWAP_LC_PAGE_MAPCOUNT_SHIFT	16
+#define SWAP_LC_PAGE_MAPCOUNT_MASK	(3U << 16)
+#define SWAP_LC_PAGE_VMA_MASK \
+	(SWAP_LC_PAGE_VMA_HAS_FILE | SWAP_LC_PAGE_VMA_SHARED | \
+	 SWAP_LC_PAGE_VMA_SEQ_READ | SWAP_LC_PAGE_VMA_RAND_READ | \
+	 SWAP_LC_PAGE_VMA_EXEC | SWAP_LC_PAGE_VMA_WRITE)
+
+#define SWAP_LC_LRU_GEN_INVALID		0xFFU
+#define SWAP_LC_LRU_GEN_AGE_MAX		0xFEU
